        </ns0:cit>
        <ns0:sense>
          <ns0:def>(British spelling, medicine) Blood; presence in blood (of a substance denoted by an affixed combining form); state or condition of the blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>an</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to; an adjectival suffix appended to various words, often nouns, to make an adjective form. (Often added to words of Latin origin, but also used with words of other origins. When a word ends in a, -n is used instead.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ance</ns0:orth>
        <ns0:pron>/-əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancia</ns0:quote>
          <ns0:quote>anza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Added to a verb to form a noun indicating a process or action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ane</ns0:orth>
        <ns0:pron>/eɪn/</ns0:pron>
