        <ns0:pron>/-ˌeːs/</ns0:pron>
        <ns0:pron>/-ˌeːz/</ns0:pron>
        <ns0:pron>/-ˌæɪs/</ns0:pron>
        <ns0:pron>/-ˌæɪz/</ns0:pron>
