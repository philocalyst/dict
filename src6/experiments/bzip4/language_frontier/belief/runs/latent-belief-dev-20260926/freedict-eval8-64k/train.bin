        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to form the names of rocks and minerals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>logical</ns0:orth>
      </ns0:form>
