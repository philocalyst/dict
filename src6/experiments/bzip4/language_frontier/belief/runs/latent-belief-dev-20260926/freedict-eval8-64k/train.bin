      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>loquio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(forming nouns) speaking, speech</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ly</ns0:orth>
        <ns0:pron>/li/</ns0:pron>
        <ns0:pron>[li]</ns0:pron>
        <ns0:pron>[liː]</ns0:pron>
        <ns0:pron>[lɪ]</ns0:pron>
        <ns0:pron>[ɫiː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to form adjectives from nouns, the adjectives having the sense of "behaving like, or having a nature typical of what is denoted by the noun" Similar in meaning to -like but most often paired with animate nouns.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mente</ns0:quote>
          <ns0:quote> lo</ns0:quote>
          <ns0:quote>e manera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to form adverbs from adjectives and nouns.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
