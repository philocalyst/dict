        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>le</ns0:orth>
        <ns0:pron>/l̩/</ns0:pron>
        <ns0:pron>/əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A frequentative suffix of verbs, indicating repetition or continuousness:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>less</ns0:orth>
        <ns0:pron>/ləs/</ns0:pron>
        <ns0:pron>/lɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>in</ns0:quote>
          <ns0:quote>es-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lacking (something); without (something). Added usually to a noun to form an adjective signifying a lack of that noun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>like</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
