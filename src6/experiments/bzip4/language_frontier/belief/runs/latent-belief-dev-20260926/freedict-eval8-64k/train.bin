        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lógico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to form adjectival forms of nouns ending in -logy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>logist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>loga</ns0:quote>
          <ns0:quote>logo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who studies or is an expert in the related -logy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>logy</ns0:orth>
        <ns0:pron>/ləd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>logía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A branch of learning; a study of a particular subject.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
