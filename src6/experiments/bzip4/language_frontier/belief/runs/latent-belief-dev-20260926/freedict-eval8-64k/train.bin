          <ns0:quote>ito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>small, immature, miniature</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>lite</ns0:orth>
        <ns0:pron>/-ˌlaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
