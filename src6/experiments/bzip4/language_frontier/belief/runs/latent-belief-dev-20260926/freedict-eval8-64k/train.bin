      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Variant of -an, usually with differentiation (germane, humane, urbane), but sometimes alone (mundane).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
