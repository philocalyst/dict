      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lgo</ns0:quote>
          <ns0:quote>uasi-</ns0:quote>
          <ns0:quote>ropio de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resembling, having some of the characteristics of (used to form adjectives from nouns).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
