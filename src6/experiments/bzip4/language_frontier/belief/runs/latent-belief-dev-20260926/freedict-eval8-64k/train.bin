          <ns0:quote>mancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(fantasy) Variety of magic, especially that controlling or related to a specific element, substance, or theme.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>mania</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>suffix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
