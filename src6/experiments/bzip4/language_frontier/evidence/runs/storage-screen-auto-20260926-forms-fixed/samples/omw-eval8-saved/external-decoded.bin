    <synsets><Synset id="omw-ja-00018577-r" ili="i18249" partOfSpeech="r" members="omw-ja-すっかり-00018577-r omw-ja-まったく-00018577-r omw-ja-とんと-00018577-r omw-ja-ふつに-00018577-r omw-ja-ほんに-00018577-r omw-ja-まるで-00018577-r omw-ja-丸で-00018577-r omw-ja-何とも-00018577-r omw-ja-何共-00018577-r omw-ja-全く-00018577-r omw-ja-完全に-00018577-r omw-ja-本に-00018577-r omw-ja-殆-00018577-r omw-ja-頓と-00018577-r">
