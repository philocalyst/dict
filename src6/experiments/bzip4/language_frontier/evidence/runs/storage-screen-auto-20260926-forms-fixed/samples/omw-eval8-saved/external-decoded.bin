    <Synset id="omw-ja-01382086-a" ili="i7530" partOfSpeech="a" members="omw-ja-おっきい-01382086-a omw-ja-でっかい-01382086-a omw-ja-でかい-01382086-a omw-ja-偉い-01382086-a omw-ja-大きい-01382086-a omw-ja-大き-01382086-a omw-ja-大-01382086-a omw-ja-太い-01382086-a omw-ja-広い-01382086-a">
