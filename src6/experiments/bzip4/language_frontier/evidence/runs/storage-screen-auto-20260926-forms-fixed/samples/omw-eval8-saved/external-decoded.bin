    <synsets><Synset id="omw-ja-00064787-a" ili="i340" partOfSpeech="a" members="omw-ja-よろしい-00064787-a omw-ja-グッド-00064787-a omw-ja-いい-00064787-a omw-ja-よい-00064787-a omw-ja-グー-00064787-a omw-ja-善い-00064787-a omw-ja-善様-00064787-a omw-ja-好ましい-00064787-a omw-ja-好い-00064787-a omw-ja-好様-00064787-a omw-ja-宜しい-00064787-a omw-ja-有意義-00064787-a omw-ja-有益-00064787-a">
