    <synsets><Synset id="omw-ja-00106182-a" ili="i562" partOfSpeech="a" members="omw-ja-おっきい-00106182-a omw-ja-でっかい-00106182-a omw-ja-でかい-00106182-a omw-ja-大きい-00106182-a omw-ja-豊か-00106182-a omw-ja-豊-00106182-a">
