    <Synset id="omw-ja-00144405-r" ili="i19110" partOfSpeech="r" members="omw-ja-ちょっくら-00144405-r omw-ja-ちょっくり-00144405-r omw-ja-しばらく-00144405-r omw-ja-ちょいと-00144405-r omw-ja-ちょっと-00144405-r omw-ja-とばかり-00144405-r omw-ja-ちいと-00144405-r omw-ja-ちと-00144405-r omw-ja-一寸-00144405-r omw-ja-些と-00144405-r omw-ja-暫く-00144405-r omw-ja-暫時-00144405-r omw-ja-鳥渡-00144405-r">
