    <synsets><Synset id="omw-ja-00040152-n" ili="i35622" partOfSpeech="n" members="omw-ja-交流-00040152-n">
      <Definition>相互作用</Definition>
      <Definition>（特に情報）をやりとりする、または交換する活動</Definition>
    </Synset>
