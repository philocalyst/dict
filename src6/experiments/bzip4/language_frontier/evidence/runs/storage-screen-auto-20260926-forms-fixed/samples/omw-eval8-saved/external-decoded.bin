      <Example>重い罰金</Example>
      <Example>酷い死亡事故</Example>
      <Example>酷い損失</Example>
      <Example>酷い雨降り</Example>
      <Example>交通渋滞</Example>
    </Synset>
    <Synset id="omw-ja-01204557-a" ili="i6586" partOfSpeech="a" members="omw-ja-おっきい-01204557-a omw-ja-でっかい-01204557-a omw-ja-でかい-01204557-a omw-ja-大きい-01204557-a omw-ja-高い-01204557-a">
      <Definition>比較的すごくまたは特定の上昇または上向きの延長のあるまたはそのような状態の</Definition>
      <Example>高い山</Example>
      <Example>高い天井</Example>
      <Example>高い建物</Example>
      <Example>広い額</Example>
      <Example>高い斜面</Example>
      <Example>高さ1フィート</Example>
    </Synset>
    <Synset id="omw-ja-01210854-a" ili="i6627" partOfSpeech="a" members="omw-ja-おっきい-01210854-a omw-ja-でっかい-01210854-a omw-ja-でかい-01210854-a omw-ja-大きい-01210854-a omw-ja-高い-01210854-a omw-ja-高度-01210854-a omw-ja-高等-01210854-a omw-ja-高級-01210854-a">
      <Definition>程度、強度、または量で普通より大きい</Definition>
      <Example>高温</Example>
      <Example>高価</Example>
      <Example>彼の経歴の頂点</Example>
      <Example>高いリスク</Example>
      <Example>高い望みを持つ</Example>
      <Example>その川の水かさが上がっている</Example>
      <Example>彼は自分を高く評価している</Example>
    </Synset>
    <Synset id="omw-ja-01276872-a" ili="i6972" partOfSpeech="a" members="omw-ja-おっきい-01276872-a omw-ja-でっかい-01276872-a omw-ja-でかい-01276872-a omw-ja-大---01276872-a omw-ja-大きい-01276872-a omw-ja-大事-01276872-a omw-ja-意義深い-01276872-a omw-ja-重要-01276872-a">
