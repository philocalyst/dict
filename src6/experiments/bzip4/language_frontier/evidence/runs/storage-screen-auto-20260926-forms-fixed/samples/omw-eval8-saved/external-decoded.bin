      <Example>吐き気がする</Example>
      <Example>怪我をする</Example>
      <Example>好意を持つ</Example>
    </Synset>
    <Synset id="omw-ja-02110552-v" ili="i32313" partOfSpeech="v" members="omw-ja-感じる-02110552-v omw-ja-感ずる-02110552-v omw-ja-感じ取る-02110552-v omw-ja-感取-plus-する-02110552-v omw-ja-覚える-02110552-v">
