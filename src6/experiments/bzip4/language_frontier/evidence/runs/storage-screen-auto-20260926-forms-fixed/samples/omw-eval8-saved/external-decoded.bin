      <Example>結果に大いに関係がある</Example>
    </Synset>
    <Synset id="omw-ja-02163307-a" ili="i11885" partOfSpeech="a" members="omw-ja-おっきい-02163307-a omw-ja-主要-02163307-a omw-ja-大きい-02163307-a omw-ja-大事-02163307-a omw-ja-重要-02163307-a">
