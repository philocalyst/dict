      <Example>弱体な財政状態の中で</Example>
    </Synset>
    <Synset id="omw-ja-05768252-n" ili="i67205" partOfSpeech="n" members="omw-ja-ヴィジョン-05768252-n omw-ja-ありさま-05768252-n omw-ja-イメージ-05768252-n omw-ja-ビジョン-05768252-n omw-ja-夢幻-05768252-n omw-ja-幻-05768252-n omw-ja-幻影-05768252-n omw-ja-空想-05768252-n">
      <Definition>はっきりとした心の中の像</Definition>
