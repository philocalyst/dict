    </Synset>
    <Synset id="omw-ja-15228378-n" ili="i117260" partOfSpeech="n" members="omw-ja-刻限-15228378-n omw-ja-時刻-15228378-n omw-ja-時剋-15228378-n omw-ja-時間-15228378-n">
      <Definition>時間</Definition>
