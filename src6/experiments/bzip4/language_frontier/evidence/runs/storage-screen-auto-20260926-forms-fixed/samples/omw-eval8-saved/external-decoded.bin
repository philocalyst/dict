    <Synset id="omw-ja-01535246-v" ili="i29407" partOfSpeech="v" members="omw-ja-洗う-01535246-v omw-ja-洗滌-plus-する-01535246-v omw-ja-洗濯-plus-する-01535246-v omw-ja-浄める-01535246-v">
