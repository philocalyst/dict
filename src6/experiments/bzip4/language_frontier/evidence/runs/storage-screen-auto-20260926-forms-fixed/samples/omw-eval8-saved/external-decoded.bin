    </Synset>
    <Synset id="omw-ja-15269513-n" ili="i117490" partOfSpeech="n" members="omw-ja-時間-15269513-n omw-ja-期間-15269513-n omw-ja-間-15269513-n omw-ja-間隔-15269513-n omw-ja-隔たり-15269513-n">
