    </Synset>
    <Synset id="omw-ja-01532589-v" ili="i29395" partOfSpeech="v" members="omw-ja-掃除-plus-する-01532589-v omw-ja-洒掃-plus-する-01532589-v omw-ja-洗う-01532589-v omw-ja-洗浄-plus-する-01532589-v omw-ja-洗滌-plus-する-01532589-v omw-ja-浄める-01532589-v omw-ja-浄化-plus-する-01532589-v omw-ja-浚う-01532589-v omw-ja-清める-01532589-v omw-ja-清掃-plus-する-01532589-v omw-ja-渫う-01532589-v omw-ja-灑掃-plus-する-01532589-v">
