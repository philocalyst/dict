    <synsets><Synset id="omw-ja-00036178-v" ili="i21946" partOfSpeech="v" members="omw-ja-洗う-00036178-v">
      <Definition>なめることで洗うこと（それ自体を、またはもう一つの動物を）</Definition>
      <Example>猫は、1日の間に数回か洗う</Example>
    </Synset>
    <Synset id="omw-ja-00036362-v" ili="i21947" partOfSpeech="v" members="omw-ja-ゆすぐ-00036362-v omw-ja-水洗-plus-する-00036362-v omw-ja-洒ぐ-00036362-v omw-ja-洗う-00036362-v omw-ja-洗浄-plus-する-00036362-v omw-ja-洗滌-plus-する-00036362-v omw-ja-洗濯-plus-する-00036362-v omw-ja-滌ぐ-00036362-v omw-ja-濯ぐ-00036362-v omw-ja-研ぐ-00036362-v">
