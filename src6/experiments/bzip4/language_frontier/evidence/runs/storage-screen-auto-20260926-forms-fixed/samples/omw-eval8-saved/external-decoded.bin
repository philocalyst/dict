    <Synset id="omw-ja-00690305-v" ili="i25164" partOfSpeech="v" members="omw-ja-思う-00690305-v omw-ja-想う-00690305-v omw-ja-感じる-00690305-v omw-ja-感ずる-00690305-v omw-ja-感じ取る-00690305-v omw-ja-感取-plus-する-00690305-v omw-ja-自覚-plus-する-00690305-v">
