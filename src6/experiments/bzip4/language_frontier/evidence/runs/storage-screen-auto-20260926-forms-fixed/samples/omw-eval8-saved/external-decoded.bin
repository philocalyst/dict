    <Synset id="omw-ja-00497061-v" ili="i24194" partOfSpeech="v" members="omw-ja-アップ-plus-する-00497061-v omw-ja-上げる-00497061-v omw-ja-増やす-00497061-v omw-ja-引き上げる-00497061-v omw-ja-引上げる-00497061-v omw-ja-引き揚げる-00497061-v omw-ja-押し上げる-00497061-v omw-ja-押上げる-00497061-v omw-ja-繰り上げる-00497061-v omw-ja-繰上げる-00497061-v omw-ja-高める-00497061-v">
