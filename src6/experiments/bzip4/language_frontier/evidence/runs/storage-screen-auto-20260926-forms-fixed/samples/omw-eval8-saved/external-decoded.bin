    <Synset id="omw-ja-02093305-a" ili="i11470" partOfSpeech="a" members="omw-ja-セキュア-02093305-a omw-ja-大丈夫-02093305-a omw-ja-安全-02093305-a omw-ja-安心-02093305-a omw-ja-安泰-02093305-a omw-ja-心丈夫-02093305-a omw-ja-無事-02093305-a omw-ja-確か-02093305-a">
