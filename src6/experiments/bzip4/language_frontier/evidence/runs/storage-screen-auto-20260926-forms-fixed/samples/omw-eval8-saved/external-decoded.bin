    </Synset>
    <Synset id="omw-ja-01278818-a" ili="i6981" partOfSpeech="a" members="omw-ja-おっきい-01278818-a omw-ja-偉大-01278818-a omw-ja-大いなる-01278818-a omw-ja-大きい-01278818-a omw-ja-貴い-01278818-a">
