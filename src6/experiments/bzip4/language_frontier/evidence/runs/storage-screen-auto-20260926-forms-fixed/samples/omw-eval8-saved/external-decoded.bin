    </Synset>
    <Synset id="omw-ja-00660971-v" ili="i25031" partOfSpeech="v" members="omw-ja-価値づける-00660971-v omw-ja-価値付ける-00660971-v omw-ja-見る-00660971-v omw-ja-評する-00660971-v omw-ja-評価-plus-する-00660971-v omw-ja-評定-plus-する-00660971-v">
