    </Synset>
    <Synset id="omw-ja-01554412-a" ili="i8533" partOfSpeech="a" members="omw-ja-大きい-01554412-a">
      <Definition>数え切れない量の</Definition>
      <Example>言うに言えない苦しみ</Example>
    </Synset>
    <Synset id="omw-ja-01677433-a" ili="i9189" partOfSpeech="a" members="omw-ja-めちゃめちゃ-01677433-a omw-ja-おっきい-01677433-a omw-ja-どえらい-01677433-a omw-ja-すごい-01677433-a omw-ja-ど偉い-01677433-a omw-ja-偉い-01677433-a omw-ja-凄い-01677433-a omw-ja-大きい-01677433-a omw-ja-巨なる-01677433-a omw-ja-目茶目茶-01677433-a omw-ja-莫大-01677433-a omw-ja-著しい-01677433-a omw-ja-豪い-01677433-a omw-ja-重大-01677433-a">
