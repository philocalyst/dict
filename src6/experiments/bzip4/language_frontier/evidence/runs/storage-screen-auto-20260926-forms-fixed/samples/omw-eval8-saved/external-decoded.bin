    <Synset id="omw-ja-01716619-v" ili="i30327" partOfSpeech="v" members="omw-ja-プレー-plus-する-01716619-v omw-ja-努める-01716619-v omw-ja-務める-01716619-v omw-ja-勤める-01716619-v omw-ja-引く-01716619-v omw-ja-弾く-01716619-v omw-ja-戯れる-01716619-v omw-ja-掛ける-01716619-v omw-ja-曳く-01716619-v omw-ja-架ける-01716619-v omw-ja-演じる-01716619-v omw-ja-演ずる-01716619-v omw-ja-為る-01716619-v omw-ja-牽く-01716619-v">
