    <synsets><Synset id="omw-ja-00047317-v" ili="i22006" partOfSpeech="v" members="omw-ja-為る-00047317-v omw-ja-見る-00047317-v omw-ja-試みる-00047317-v omw-ja-試す-00047317-v">
