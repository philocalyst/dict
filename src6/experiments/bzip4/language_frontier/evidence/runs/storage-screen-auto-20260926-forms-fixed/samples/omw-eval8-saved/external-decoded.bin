    <Synset id="omw-ja-00356926-a" ili="i1981" partOfSpeech="a" members="omw-ja-固有-00356926-a omw-ja-特徴ある-00356926-a omw-ja-特徴的-00356926-a omw-ja-特有-00356926-a omw-ja-独特-00356926-a omw-ja-独自-00356926-a">
