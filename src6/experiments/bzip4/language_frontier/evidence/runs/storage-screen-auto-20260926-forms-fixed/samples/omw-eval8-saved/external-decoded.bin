      <Lemma writtenForm="ともあれかくもあれ" partOfSpeech="r" />
      <Sense id="omw-ja-ともあれかくもあれ-00026571-r" synset="omw-ja-00026571-r" />
      <Sense id="omw-ja-ともあれかくもあれ-00029037-r" synset="omw-ja-00029037-r" />
