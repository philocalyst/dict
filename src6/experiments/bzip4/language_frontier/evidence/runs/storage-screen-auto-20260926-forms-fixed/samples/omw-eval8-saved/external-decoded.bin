      <Example>魅力的で、好ましい若者</Example>
    </Synset>
    <Synset id="omw-ja-01586342-a" ili="i8695" partOfSpeech="a" members="omw-ja-きれい-01586342-a omw-ja-すてき-01586342-a omw-ja-ナイス-01586342-a omw-ja-いい-01586342-a omw-ja-よい-01586342-a omw-ja-可愛い-01586342-a omw-ja-善い-01586342-a omw-ja-好いたらしい-01586342-a omw-ja-好ましい-01586342-a omw-ja-好い-01586342-a omw-ja-心地よい-01586342-a omw-ja-快い-01586342-a omw-ja-旨味しい-01586342-a omw-ja-素適-01586342-a omw-ja-綺麗-01586342-a omw-ja-美味しい-01586342-a omw-ja-良い-01586342-a omw-ja-麗しい-01586342-a">
