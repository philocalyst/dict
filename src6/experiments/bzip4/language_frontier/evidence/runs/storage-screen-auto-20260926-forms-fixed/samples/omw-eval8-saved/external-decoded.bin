      <Example>多額</Example>
      <Example>大きい（または大きい）納屋</Example>
      <Example>大家族</Example>
      <Example>大企業</Example>
      <Example>大きな支出</Example>
      <Example>多数の新聞</Example>
      <Example>科学者の大きいグループ</Example>
    </Synset>
    <Synset id="omw-ja-01383394-a" ili="i7531" partOfSpeech="a" members="omw-ja-たくさん-01383394-a omw-ja-充分-01383394-a omw-ja-十分-01383394-a omw-ja-可也-01383394-a omw-ja-可成-01383394-a omw-ja-多額-01383394-a omw-ja-大きい-01383394-a omw-ja-大形-01383394-a omw-ja-沢山-01383394-a omw-ja-潤沢-01383394-a omw-ja-豊富-01383394-a">
      <Definition>かなり大きい</Definition>
      <Example>かなりの財産</Example>
      <Example>ゆったりとしたウエストライン</Example>
      <Example>十分な規模の</Example>
    </Synset>
    <Synset id="omw-ja-01384438-a" ili="i7539" partOfSpeech="a" members="omw-ja-大きい-01384438-a omw-ja-嵩高い-01384438-a omw-ja-嵩高-01384438-a omw-ja-かさ高い-01384438-a omw-ja-かさ高-01384438-a">
