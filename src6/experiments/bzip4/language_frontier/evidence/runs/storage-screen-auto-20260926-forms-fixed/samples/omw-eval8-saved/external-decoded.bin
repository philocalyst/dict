    <Synset id="omw-ja-14411981-n" ili="i112742" partOfSpeech="n" members="omw-ja-承認-14411981-n omw-ja-認定-14411981-n omw-ja-認容-14411981-n omw-ja-認知-14411981-n omw-ja-認識-14411981-n">
