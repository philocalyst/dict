      <Example>私の気力を奮い立たせる</Example>
      <Example>彼の自我を鼓舞する</Example>
    </Synset>
    <Synset id="omw-ja-01514126-v" ili="i29293" partOfSpeech="v" members="omw-ja-ピッチング-plus-する-01514126-v omw-ja-投球-plus-する-01514126-v omw-ja-据えつける-01514126-v omw-ja-据え付ける-01514126-v omw-ja-立てる-01514126-v omw-ja-組み立てる-01514126-v omw-ja-起こす-01514126-v">
