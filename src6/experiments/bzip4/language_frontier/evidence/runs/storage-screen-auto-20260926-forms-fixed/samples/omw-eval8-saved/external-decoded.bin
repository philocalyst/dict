    <Synset id="omw-ja-00106821-a" ili="i565" partOfSpeech="a" members="omw-ja-不十分-00106821-a omw-ja-乏しい-00106821-a omw-ja-お寒い-00106821-a omw-ja-寡少-00106821-a omw-ja-尠少-00106821-a omw-ja-御寒い-00106821-a omw-ja-手うす-00106821-a omw-ja-手薄い-00106821-a omw-ja-手薄-00106821-a omw-ja-からっ穴-00106821-a omw-ja-空っけつ-00106821-a omw-ja-空っ穴-00106821-a omw-ja-薄い-00106821-a omw-ja-貧しい-00106821-a omw-ja-貧小-00106821-a omw-ja-貧弱-00106821-a omw-ja-鮮少-00106821-a">
