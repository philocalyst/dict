      <Example>主要な貢献</Example>
      <Example>大幅な改善</Example>
      <Example>伝統からの大きな変革</Example>
      <Example>大きな誤解</Example>
    </Synset>
    <Synset id="omw-ja-01533806-a" ili="i8422" partOfSpeech="a" members="omw-ja-おどろおどろしい-01533806-a omw-ja-ぎょうさん-01533806-a omw-ja-オーバー-01533806-a omw-ja-事々しい-01533806-a omw-ja-事事しい-01533806-a omw-ja-仰々しい-01533806-a omw-ja-仰仰しい-01533806-a omw-ja-仰山-01533806-a omw-ja-喋々しい-01533806-a omw-ja-喋喋しい-01533806-a omw-ja-大きい-01533806-a omw-ja-大げさ-01533806-a omw-ja-大仰-01533806-a omw-ja-大層らしい-01533806-a omw-ja-大層-01533806-a omw-ja-大袈裟-01533806-a omw-ja-物々しい-01533806-a omw-ja-物物しい-01533806-a omw-ja-誇大-01533806-a">
