    <Synset id="omw-ja-01129337-v" ili="i27249" partOfSpeech="v" members="omw-ja-ガード-plus-する-01129337-v omw-ja-守る-01129337-v omw-ja-守備-plus-する-01129337-v omw-ja-守護-plus-する-01129337-v omw-ja-差し固める-01129337-v omw-ja-後見-plus-する-01129337-v omw-ja-心くばり-plus-する-01129337-v omw-ja-心配り-plus-する-01129337-v omw-ja-用心-plus-する-01129337-v omw-ja-監視-plus-する-01129337-v omw-ja-看守-plus-する-01129337-v omw-ja-見る-01129337-v omw-ja-見守る-01129337-v omw-ja-見張る-01129337-v omw-ja-視る-01129337-v omw-ja-警備-plus-する-01129337-v omw-ja-警固-plus-する-01129337-v omw-ja-警守-plus-する-01129337-v omw-ja-警戒-plus-する-01129337-v omw-ja-警衛-plus-する-01129337-v omw-ja-警護-plus-する-01129337-v omw-ja-護る-01129337-v omw-ja-護衛-plus-する-01129337-v omw-ja-防備-plus-する-01129337-v omw-ja-防衛-plus-する-01129337-v omw-ja-防護-plus-する-01129337-v">
