    </Synset>
    <Synset id="omw-ja-01226875-v" ili="i27758" partOfSpeech="v" members="omw-ja-捜る-01226875-v omw-ja-掘りさげる-01226875-v omw-ja-掘り下げる-01226875-v omw-ja-掘下げる-01226875-v omw-ja-洗う-01226875-v">
