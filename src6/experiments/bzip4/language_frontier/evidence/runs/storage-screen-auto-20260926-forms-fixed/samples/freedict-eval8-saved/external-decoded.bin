        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>premiar</ns0:quote>
          <ns0:quote>galardonar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To determine; to make or grant an award.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>premiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give (an award).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, British, education) (in an examination) To give marks for a correct answer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
