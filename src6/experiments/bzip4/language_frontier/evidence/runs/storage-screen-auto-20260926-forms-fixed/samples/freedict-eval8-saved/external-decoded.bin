          <ns0:quote>gaélico escocés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Gaelic language of Scotland, spoken primarily in the northern and western parts of the country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
