    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Generation X</ns0:orth>
        <ns0:pron>/ˌdʒɛnəɹeɪʃn̩ ˈɛks/</ns0:pron>
        <ns0:pron>/ˌdʒɛnəˌɹeɪʃən ˈɛks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>generación X</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(specifically) The generation of people born after the baby boom that followed World War II, especially those born from the mid 1960s to early 1980s, sometimes characterized as cynical, disaffected, lacking direction in life, and unwilling to take part fully in society.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Generation Y</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>generación Y</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The generation of people born between the early 1980s and mid-1990s following Generation X.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Generation Z</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>generación Z</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The generation of people born between the mid-late 1990s and early 2010s, following Generation Y, typically defined as beginning with births in 1997 and ending with births in 2012.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
