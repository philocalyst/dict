      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Indianápolis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city of Indiana, United States and the county seat of Marion County, with which the city is consolidated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>índico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to or denoting the group of Indo-European languages comprising Sanskrit and the modern Indian languages which are its descendants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indies</ns0:orth>
        <ns0:pron>/ˈɪndiz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Indias</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The Western Hemisphere, during the early period of European colonization and exploration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
