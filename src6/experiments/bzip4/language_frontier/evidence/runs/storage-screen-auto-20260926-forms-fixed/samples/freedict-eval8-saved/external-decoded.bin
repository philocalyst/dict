      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>slavista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A specialist in the Slavic languages, literature or culture.</ns0:def>
        </ns0:sense>
