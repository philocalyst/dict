      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nave</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wing of a building, notably in a church separated from the nave proper by piers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A clear path/passage through rows of seating.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A clear corridor in a supermarket with shelves on both sides containing goods for sale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>paso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any path through an otherwise obstructed space.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
