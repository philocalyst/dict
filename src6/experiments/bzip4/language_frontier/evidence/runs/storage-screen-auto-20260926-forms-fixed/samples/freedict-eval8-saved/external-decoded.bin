        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiracist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirracista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to racism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiracist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirracista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who opposes racism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiradar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirradar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) Preventing detection by radar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antireligious</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirreligioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antirepressive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirepresivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) Opposed to repression; working against repression.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiretroviral</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirretroviral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) That combats infection by retroviruses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antirevolutionary</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antirrevolucionario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposing a sociopolitical revolution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiriot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antidisturbios</ns0:quote>
          <ns0:quote>antimotines</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Serving to counteract rioting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiscience</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticiencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to science and scientific progress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antisecular</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisecular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sociology, religion) Opposing what is secular.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antisense</ns0:orth>
        <ns0:pron>/ˌæntaɪˈsɛns/</ns0:pron>
        <ns0:pron>/ˌæntiˈsɛns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisentido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetics) The strand of nucleic acid complementary to a strand which codes for an RNA or protein.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiseptic</ns0:orth>
        <ns0:pron>/ˌæntiˈsɛptɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiséptico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to antisepsis, or the use of antiseptics.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Capable of preventing microbial infection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aséptico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Very clean; aseptic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiseptic</ns0:orth>
        <ns0:pron>/ˌæntiˈsɛptɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiséptico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) Any substance that inhibits the growth and reproduction of microorganisms. Generally includes only those that are used on living objects (as opposed to disinfectants) and aren't transported by the lymphatic system to destroy bacteria in the body (as opposed to antibiotics).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiseptically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisépticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an antiseptic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiserum</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisuero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A serum prepared from human or animal sources containing antibodies able to counter certain diseases or toxins.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiskid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antideslizante</ns0:quote>
          <ns0:quote>anti-patinaje</ns0:quote>
          <ns0:quote>antiderrapante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Designed to increase friction, and thereby reduce the possibility of skid. (of a surface)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antislavism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antieslavismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Antislavic sentiment, in general: negative attitude towards Slavic peoples.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antislip</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiderrapante</ns0:quote>
          <ns0:quote>antideslizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Preventing slipping.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antismoking</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitabaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposing or prohibiting smoking, particularly the smoking of tobacco</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antisocial</ns0:orth>
        <ns0:pron>/ˌæntaɪˈsoʊʃəl/</ns0:pron>
        <ns0:pron>/ˌæntiˈsoʊʃəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisocial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Unwilling or unable to cooperate and associate normally with other people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antisocial personality disorder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno antisocial de la personalidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) A personality disorder marked by antisocial behavior, a pervasive pattern of disregard for and violation of the rights of others that begins in childhood or early adolescence and continues into adulthood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antispace</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiespacio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A space or region that violates the norms or conventions of spaces.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antispam</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antispam</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet) Countering spam (unwanted electronic mail).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antispast</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antispasto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(prosody) A metrical foot composed of an iambus and a trochee</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antistatic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiestático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agent or substance that prevents the buildup of static electricity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antistress</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiestrés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Countering stress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antisymbolic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisimbólico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antisymmetric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisimétrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set theory, order theory, of a binary relation R on a set S) Having the property that, for any two distinct elements of S, at least one is not related to the other via R; equivalently, having the property that, for any x, y ∈ S, if both xRy and yRx then x=y.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(linear algebra, of certain mathematical objects) Whose sign changes on the application of a matrix transpose or some generalisation thereof:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitaurine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitaurino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Inhibiting or counteracting taurine</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiterrorism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiterrorismo</ns0:quote>
          <ns0:quote>contraterrorismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law enforcement, military, often, attributive) Activity aiming at opposing or preventing terrorism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiterrorist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiterrorista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Preventing or counteracting terrorism, or reducing the threat from terrorism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitetanic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitetánico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmacology) Countering tetanus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitheft</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiatraco</ns0:quote>
          <ns0:quote>antirrobo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Against or preventing from being stolen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitheism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiteísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The categorical opposition to the belief in any and all deities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitheist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiteísta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An active opponent of the belief in the existence of a god or gods.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antithesis</ns0:orth>
        <ns0:pron>/ænˈtɪ.θə.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antítesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A proposition that is the diametric opposite of some other proposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antithetical</ns0:orth>
        <ns0:pron>/ˌæntɪˈθɛtɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to antithesis, or opposition of words and sentiments; containing, or of the nature of, antithesis; contrasted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antithrombin</ns0:orth>
        <ns0:pron>/ˌæntaɪˈθɹɒmbɪn/</ns0:pron>
        <ns0:pron>/ˌæntɪˈθɹɒmbɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitrombina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small molecule that inactivates several enzymes of the coagulation system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antithyroid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitiroideos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) Reducing the production or effects of thyroid hormones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitoxic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitóxico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(immunology) That counteracts a toxin or poison.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitoxin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitoxina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A medicine able to neutralize a toxin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitrust</ns0:orth>
        <ns0:pron>/ˌæntiˈtɹʌst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimonopolio</ns0:quote>
          <ns0:quote>antimonopolista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Opposed to or against the establishment or existence of trusts (monopolies), usually referring to legislation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antitrypsin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitripsina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein) Any of a class of serum proteins that inhibit trypsin and similar proteolytic enzymes</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiunion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisindicato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) Opposed to, or discouraging the formation of, trade unions</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiutopian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiutópico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, philosophy) Opposing utopian values.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiviolence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiviolencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law enforcement, sociology) Acting against or opposing violence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiviral</ns0:orth>
        <ns0:pron>/æntiˈvaɪɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antivírico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Inhibiting the growth and reproduction of a virus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antivirus</ns0:quote>
          <ns0:quote>antivírico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) Eliminating or inhibiting the action of a computer virus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antivirus</ns0:orth>
        <ns0:pron>/ˈantɪvʌɪrəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antivirus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A piece of software that is used to detect, delete and or neutralize computer-based viruses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiwork</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiempleo</ns0:quote>
          <ns0:quote>antitrabajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposing work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiworker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitrabajador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) Opposing workers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiworm</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vermicida</ns0:quote>
          <ns0:quote>vermífugo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) Countering or preventing worms (self-replicating programs).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiwrinkle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiarrugas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dermatology) Counteracting wrinkles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antler</ns0:orth>
        <ns0:pron>/ˈænt.lə/</ns0:pron>
        <ns0:pron>/ˈænt.lɚ/</ns0:pron>
        <ns0:pron>/ˈænʔ.lɚ/</ns0:pron>
        <ns0:pron>/ˈænʔ.ɫɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cornamenta</ns0:quote>
          <ns0:quote>astamenta</ns0:quote>
          <ns0:quote>caramera</ns0:quote>
          <ns0:quote>cornadura</ns0:quote>
          <ns0:quote>cuerna</ns0:quote>
          <ns0:quote>encornadura</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antlion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hormiga león</ns0:quote>
          <ns0:quote>mirmelóntido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various species of insects, many of them nocturnal, in the family Myrmeleontidae. The adults superficially resemble the unrelated damselflies. The larvae bury themselves in sand below a cone-shaped pit in which they trap insects such as ants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fórmico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, resembling, characteristic of, or pertaining to ants; formic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antonomasia</ns0:orth>
        <ns0:pron>/ænˌtɒnəʊˈmeɪzɪə/</ns0:pron>
        <ns0:pron>/ˌæntənəʊˈmeɪzɪə/</ns0:pron>
        <ns0:pron>/ˌæntənəˈmeɪʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antonomasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) The substitution of an epithet or title in place of a proper noun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antonym</ns0:orth>
        <ns0:pron>/ˈæn.təˌnɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(semantics) A word which has the opposite meaning of another word.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antonymous</ns0:orth>
        <ns0:pron>/ænt.əˈnɪm.ʌs/</ns0:pron>
        <ns0:pron>/ænˈtɑnɪməs/</ns0:pron>
        <ns0:pron>/ænˈtɒn.ɪ.məs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Synonym of antonymic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antonymy</ns0:orth>
        <ns0:pron>/ˈæntə.nɪm.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antonimia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(semantics) The semantic relation between antonyms; the quality of being antonymous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antrectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antrectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) The removal (resection) of part of the stomach, often combined with a vagotomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antrorse</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antrorso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Curved or pointed forward or upward.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antrum</ns0:orth>
        <ns0:pron>/ˈæn.tɹəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A bodily cavity, especially one having bony walls, especially one in the sinuses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ants in one's pants</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>(ser) (un) puro nervio</ns0:quote>
          <ns0:quote>culo inquieto</ns0:quote>
          <ns0:quote>hormigas en la cola</ns0:quote>
          <ns0:quote>ser culo de mal asiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) The condition of being agitated and constantly fidgeting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antshrike</ns0:orth>
        <ns0:pron>/ˈæntˌʃɹaɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batará</ns0:quote>
          <ns0:quote>hormiguero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several passerine bird species of various genera in the antbird (Thamnophilidae) family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antsy</ns0:orth>
        <ns0:pron>/ˈæn.tsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inquieto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) Restless, apprehensive and fidgety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anuran</ns0:orth>
        <ns0:pron>/æ-/</ns0:pron>
        <ns0:pron>/əˈn(j)ʊɹən/</ns0:pron>
        <ns0:pron>/əˈnjʊəɹ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(batrachology) Of or relating to the order Anura.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anuran</ns0:orth>
        <ns0:pron>/æ-/</ns0:pron>
        <ns0:pron>/əˈn(j)ʊɹən/</ns0:pron>
        <ns0:pron>/əˈnjʊəɹ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(batrachology) Any amphibian of the order Anura; a frog, a toad.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anuria</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A condition in which the kidneys do not produce urine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anus</ns0:orth>
        <ns0:pron>/ˈeɪ.nəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ano</ns0:quote>
          <ns0:quote>mufle</ns0:quote>
          <ns0:quote>nai</ns0:quote>
          <ns0:quote>sisiflís</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The orifice of the rectum in most mammals, teleost fish, and many invertebrates, through which feces and flatus are ejected.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anvil</ns0:orth>
        <ns0:pron>/ˈæn.vəl/</ns0:pron>
        <ns0:pron>/ˈæn.vɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>yunque</ns0:quote>
          <ns0:quote>bigornia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A heavy iron block used in the blacksmithing trade as a surface upon which metal can be struck and shaped.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>yunque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(skeleton) The incus bone in the middle ear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anxiety</ns0:orth>
        <ns0:pron>/ˌæŋ(ɡ)ˈzaɪ.ə.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansiedad</ns0:quote>
          <ns0:quote>zozobra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unpleasant state of mental uneasiness, nervousness, apprehension and obsession or concern about some uncertain event.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inquietud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An uneasy or distressing desire (for something). Endeavor (to please).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansiedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A state of restlessness and agitation, often accompanied by a distressing sense of oppression or tightness in the stomach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anxiety disorder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno de ansiedad</ns0:quote>
          <ns0:quote>neurosis de ansiedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A disorder characterised by excessive anxiety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anxiogenic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansiógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Causing anxiety, or pertaining to the causing of anxiety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anxiolytic</ns0:orth>
        <ns0:pron>/ˌeɪŋziəˈlɪtɪk/</ns0:pron>
        <ns0:pron>/ˌæŋksiəˈlɪtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansiolítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A drug prescribed for the treatment of symptoms of anxiety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anxious</ns0:orth>
        <ns0:pron>/ˈeɪŋ(k).ʃəs/</ns0:pron>
        <ns0:pron>/ˈæŋ(k).ʃəs/</ns0:pron>
        <ns0:pron>/ˈæŋ(k)ʃəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>incómodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Nervous and worried.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansioso</ns0:quote>
          <ns0:quote>inquieto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a feeling of anxiety or disquietude; extremely concerned, especially about something that will happen in the future or that is unknown.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansioso</ns0:quote>
          <ns0:quote>deseoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Earnestly desirous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anxiously</ns0:orth>
        <ns0:pron>/ˈæŋ(k).ʃəs.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansiosamente</ns0:quote>
          <ns0:quote>con ansiedad</ns0:quote>
          <ns0:quote>con inquietud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an anxious manner; with painful uncertainty; solicitously.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any</ns0:orth>
        <ns0:pron>/ˈæni/</ns0:pron>
        <ns0:pron>/ˈɛni/</ns0:pron>
        <ns0:pron>/ˈɛnɪ/</ns0:pron>
        <ns0:pron>/ˈɪni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To even the slightest extent, at all.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any</ns0:orth>
        <ns0:pron>/ˈæni/</ns0:pron>
        <ns0:pron>/ˈɛni/</ns0:pron>
        <ns0:pron>/ˈɛnɪ/</ns0:pron>
        <ns0:pron>/ˈɪni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>determiner</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alguno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(negative polarity item, or, interrogative, chiefly with plural or uncountable nouns) One at all; at least one; at least one kind of; some; a positive quantity of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cualquiera</ns0:quote>
          <ns0:quote>cualquier</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A/an, each or some, no matter its/their identity or nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any</ns0:orth>
        <ns0:pron>/ˈæni/</ns0:pron>
        <ns0:pron>/ˈɛni/</ns0:pron>
        <ns0:pron>/ˈɛnɪ/</ns0:pron>
        <ns0:pron>/ˈɪni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cualquier</ns0:quote>
          <ns0:quote>cualquiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any thing(s) or person(s).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any hole's a goal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en tiempos de guerra cualquier agujero es trinchera</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any minute now</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de un momento a otro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Very soon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any more</ns0:orth>
        <ns0:pron>/ˌæ.niˈmoːɹ/</ns0:pron>
        <ns0:pron>/ˌæ.niˈmɔːɹ/</ns0:pron>
        <ns0:pron>/ˌɛ.niˈmo(ː)ɹ/</ns0:pron>
        <ns0:pron>/ˌɛ.niˈmoə/</ns0:pron>
        <ns0:pron>/ˌɛ.niˈmɔɹ/</ns0:pron>
        <ns0:pron>/ˌɛ.niˈmɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya</ns0:quote>
          <ns0:quote>ya más</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(in negative or interrogative constructions) From a given time onwards; longer, again.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>any port in a storm</ns0:orth>
        <ns0:pron>/ɛni ˈpɔɹt‿ɪn‿ə ˈstɔɹm/</ns0:pron>
        <ns0:pron>/ɛni ˈpɔːt‿ɪn‿ə ˈstɔːm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agarrarse a un clavo ardiendo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) One should accept any passable option when time is of the essence in an adverse situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anybody</ns0:orth>
        <ns0:pron>/ˈɛn.i.bɑd.i/</ns0:pron>
        <ns0:pron>/ˈɛn.i.bɒd.i/</ns0:pron>
        <ns0:pron>/ˈɛn.i.bə.di/</ns0:pron>
        <ns0:pron>/ˈɛn.i.bʌ.di/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alguien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A person of some consideration or standing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
