      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>doncella</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) A lady's maid. [mid 17th–19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abigeat</ns0:orth>
