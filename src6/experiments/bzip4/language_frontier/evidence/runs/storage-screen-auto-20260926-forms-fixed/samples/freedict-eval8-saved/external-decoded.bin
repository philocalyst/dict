          <ns0:quote>calientabanquillo</ns0:quote>
          <ns0:quote>calientabanquillos</ns0:quote>
          <ns0:quote>chupabanquillo</ns0:quote>
          <ns0:quote>chupabanquillos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports, colloquial) A player who rarely or never gets to play in the games or matches, and is most often a substitute.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benchmark</ns0:orth>
        <ns0:pron>/ˈbɛn(t)ʃmɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acotación referencial</ns0:quote>
          <ns0:quote>cota de referencia</ns0:quote>
          <ns0:quote>estándar de comparación</ns0:quote>
          <ns0:quote>marca comparativa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A standard by which something is evaluated or measured.</ns0:def>
