        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autista</ns0:quote>
          <ns0:quote>autístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having autism, or pertaining to autism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autistic</ns0:orth>
        <ns0:pron>/ɑˈtɪs.tɪk/</ns0:pron>
        <ns0:pron>/ɔːˈtɪs.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who has autism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autistic spectrum disorder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno del espectro autista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Any disorder characterised by symptoms associated with autism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auto da fe</ns0:orth>
        <ns0:pron>/ˈaʊtəʊ də ˈfeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auto de fe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The public execution of those sentences, often by burning at the stake.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auto insurance</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>seguro automotor</ns0:quote>
          <ns0:quote>seguro automotriz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) Insurance purchased by the owner of a vehicle to cover losses due to traffic accidents or theft: car insurance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auto racing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automovilismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(motor racing) Any of various sports in which automobiles (motor cars) are raced, either around a track, on roads or across country</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auto rickshaw</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
