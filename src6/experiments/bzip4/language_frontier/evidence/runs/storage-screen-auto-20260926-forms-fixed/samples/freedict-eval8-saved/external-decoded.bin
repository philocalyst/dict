          <ns0:quote>bueno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Satisfactory, reasonably good; not exceptional.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
