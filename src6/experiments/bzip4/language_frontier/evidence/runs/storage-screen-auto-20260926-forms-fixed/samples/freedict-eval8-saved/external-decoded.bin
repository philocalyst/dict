        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Goofy</ns0:quote>
          <ns0:quote>Tribilín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Disney character: a slow-witted anthropomorphic dog with a goofy laugh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Google</ns0:orth>
        <ns0:pron>/ˈɡuː.ɡəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Google</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, trademark) Google Search, a search engine operated by the company of the same name; the most popular search engine and most-visited website worldwide.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gorbachev</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gorbachov</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transliteration of the Russian surname Горбачёв (Gorbačóv).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gordian knot</ns0:orth>
        <ns0:pron>/ˈɡoʊɹdɪən ˈnɑt/</ns0:pron>
        <ns0:pron>/ˈɡɔːdɪən ˈnɒt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nudo gordiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The legendary knot tied to a pole near the temple of Zeus in Gordium.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) Any intricate and complex problem having a simple solution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gordias</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gordias</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The name of at least two members of the royal house of Phrygia, the best-known of which was reputedly the founder of the Phrygian capital city Gordium, the maker of the legendary Gordian knot, and the father of the legendary king Midas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gorgias</ns0:orth>
        <ns0:pron>/ˈɡɔɹd͡ʒi.əs/</ns0:pron>
      </ns0:form>
