          <ns0:quote>arriero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(South America) A person who transports goods using pack animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
