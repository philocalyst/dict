      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>transformada de Laplace</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) an integral transform of positive real function f(t) to a complex function F(s); given by:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
