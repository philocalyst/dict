      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maoísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The philosophy espoused by Chinese leader Mao Zedong, a form of Marxism-Leninism that focuses on the peasantry as the revolutionary vanguard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
