        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo sed</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually) I need something to drink (e.g., water).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(more generally) I need something, or want something a lot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
