          <ns0:quote>barista</ns0:quote>
          <ns0:quote>bartender</ns0:quote>
          <ns0:quote>barténder</ns0:quote>
          <ns0:quote>cantinero</ns0:quote>
          <ns0:quote>coctelero</ns0:quote>
