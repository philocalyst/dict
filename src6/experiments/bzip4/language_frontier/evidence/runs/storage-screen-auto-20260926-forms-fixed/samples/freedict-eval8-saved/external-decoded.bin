      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absurdamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an absurd fashion. [First attested in the mid 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To an extreme degree. [First attested in the mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
