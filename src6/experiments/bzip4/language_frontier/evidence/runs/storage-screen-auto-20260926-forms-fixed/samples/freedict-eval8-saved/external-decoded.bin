        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banco de prensa</ns0:quote>
          <ns0:quote>prensa de banco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(weightlifting) An exercise performed by pressing the weight of a barbell away from one's body while lying on a bench.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
