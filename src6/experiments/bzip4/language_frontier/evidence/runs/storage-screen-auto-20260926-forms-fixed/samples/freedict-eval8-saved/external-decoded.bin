    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dirac delta function</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>función delta de Dirac</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) A function of one real argument, whose value is zero when the argument is nonzero, and whose integral is one over any interval that includes zero.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dirichlet energy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>energía de Dirichlet</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(analysis, functional analysis, Fourier analysis) A quadratic functional which, given a real function defined on an open subset of ℝn, yields a real number that is a measure of how variable said function is.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
