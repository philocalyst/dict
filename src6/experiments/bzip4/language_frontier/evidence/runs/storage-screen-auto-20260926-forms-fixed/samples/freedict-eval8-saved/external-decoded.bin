      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Monte Mayón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The most active volcano in the Philippines, located in Albay province and known for its almost perfect cone shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
