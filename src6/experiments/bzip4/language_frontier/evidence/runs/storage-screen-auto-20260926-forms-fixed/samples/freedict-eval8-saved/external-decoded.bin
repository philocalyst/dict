        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest of the autonomous communities of Spain, in the central north of the country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
