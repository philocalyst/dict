          <ns0:def>Relating or belonging to air; high in air; aerial.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Open to a free current of air; exposed to the air; breezy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
