      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cartagena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Murcia, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cartagena</ns0:quote>
          <ns0:quote>Cartagena de Indias</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in northern Colombia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Cartagenan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cartagenero</ns0:quote>
          <ns0:quote>cartaginés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from or relating to the city of Cartagena, Murcia, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cartagenero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from or relating to the city of Cartagena, Bolívar department, Colombia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
