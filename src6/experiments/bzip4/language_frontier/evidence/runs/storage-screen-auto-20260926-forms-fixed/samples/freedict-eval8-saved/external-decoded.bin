        </ns0:cit>
        <ns0:sense>
          <ns0:def>Quotations from Chairman Mao Tse-tung, a book widely distributed in Communist China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
