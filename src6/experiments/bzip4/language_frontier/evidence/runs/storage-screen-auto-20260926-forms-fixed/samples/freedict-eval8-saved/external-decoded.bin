          <ns0:quote>acetaldehído</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A colourless organic compound, CH3CHO, occurring widely in nature and being produced on a large scale in industry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
