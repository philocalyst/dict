        <ns0:pron>/ˈɔ.toʊˌmeɪt/</ns0:pron>
        <ns0:pron>/ˈɔ.təˌmeɪt/</ns0:pron>
        <ns0:pron>/ˈɔː.tə.meɪt/</ns0:pron>
        <ns0:pron>[ˈoː.ɾə.mæɪt]</ns0:pron>
        <ns0:pron>[ˈɑ.ɾoʊˌmeɪt]</ns0:pron>
        <ns0:pron>[ˈɑ.ɾəˌmeɪt]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾoʊˌmeɪt]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾəˌmeɪt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automatizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To replace or enhance human labor with machines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automated</ns0:orth>
        <ns0:pron>/ˈɑ.toʊˌmeɪ.tɪd/</ns0:pron>
        <ns0:pron>/ˈɑ.təmeɪtɪd/</ns0:pron>
        <ns0:pron>/ˈɔ.toʊˌmeɪ.tɪd/</ns0:pron>
        <ns0:pron>/ˈɔ.təmeɪtɪd/</ns0:pron>
        <ns0:pron>/ˈɔːtəmeɪtɪd/</ns0:pron>
        <ns0:pron>[ˈɑ.ɾoʊˌmeɪ.ɾɪd]</ns0:pron>
        <ns0:pron>[ˈɑ.ɾəˌmeɪ.ɾɪd]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾoʊˌmeɪ.ɾɪd]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾəˌmeɪ.ɾɪd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automatizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Made automatic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automated machine learning</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprendizaje automático automatizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(artificial intelligence) A field of study concerned with the design and development of algorithms and techniques of automating the end-to-end process of machine learning and artificial intelligence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automated teller machine</ns0:orth>
        <ns0:pron>/ˈɔːtəmeɪtɪd ˈtɛlə(ɹ) məˈʃiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cajero automático</ns0:quote>
          <ns0:quote>redbanc</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(banking) A device that provides bank customers with cash withdrawal and other services without the need for a human teller.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automatic</ns0:orth>
        <ns0:pron>/ˈɔː.ʈə.məʈ.ɪk/</ns0:pron>
        <ns0:pron>/ˈɔː.ʈəˌmaʈ.ɪk/</ns0:pron>
        <ns0:pron>/ˌoː.təˈmæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌɑː.təˈmæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌɔː.təˈmæt.ɪk/</ns0:pron>
        <ns0:pron>[ˌɑː.ɾəˈmæɾ.ɪk]</ns0:pron>
        <ns0:pron>[ˌɔː.ɾəˈmæɾ.ɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of operating without external control or intervention.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Done out of habit or without conscious thought.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of a firearm such as a machine gun) Firing continuously as long as the trigger is pressed until ammunition is exhausted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automatic</ns0:orth>
        <ns0:pron>/ˈɔː.ʈə.məʈ.ɪk/</ns0:pron>
        <ns0:pron>/ˈɔː.ʈəˌmaʈ.ɪk/</ns0:pron>
        <ns0:pron>/ˌoː.təˈmæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌɑː.təˈmæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌɔː.təˈmæt.ɪk/</ns0:pron>
        <ns0:pron>[ˌɑː.ɾəˈmæɾ.ɪk]</ns0:pron>
        <ns0:pron>[ˌɔː.ɾəˈmæɾ.ɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A car with an automatic transmission; the transmission itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>semi-automática</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A semi-automatic pistol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automatic rifle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fusil automático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, weaponry) A rifle that loads itself either from a belt or magazine; a machine gun. (Compare fully automatic rifles vs. semi-automatic rifles.) [19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automatic transmission</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>transmisión automática</ns0:quote>
          <ns0:quote>caja automática</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(automotive) A vehicle transmission which shifts gears automatically in response to vehicle speed and/or load, and does not require any driver input to manually change gears under normal driving conditions; an automatic gearbox.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automatically</ns0:orth>
        <ns0:pron>/ˈɔːtəʊˌmæt.ɪ.k(ə.)li/</ns0:pron>
        <ns0:pron>/ˈɔːtəˌmæt.ɪ.k(ə.)i/</ns0:pron>
        <ns0:pron>/ˌɑː.təˈmæt.ɪ.k(ə.)li/</ns0:pron>
        <ns0:pron>/ˌɔː.təˈmæt.ɪ.k(ə.)li/</ns0:pron>
        <ns0:pron>[ˌɑː.ɾəˈmæɾ.ɪ.k(ə.)li]</ns0:pron>
        <ns0:pron>[ˌɔː.ɾəˈmæɾ.ɪ.k(ə.)li]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automáticamente</ns0:quote>
          <ns0:quote>solo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an automatic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automaticity</ns0:orth>
        <ns0:pron>/ˌɔːtəʊməˈtɪsɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automaticidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ability to do things without occupying the mind with the low level details required.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automation</ns0:orth>
        <ns0:pron>/ˌoː.təˈmæɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌɑː.təˈmeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌɔ.təˈmeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌɔː.təˈmeɪ.ʃən/</ns0:pron>
        <ns0:pron>[ˌɑː.ɾəˈmeɪ.ʃən]</ns0:pron>
        <ns0:pron>[ˌɔ.ɾəˈmeɪ.ʃən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automatización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of converting the controlling of a machine or device to a more automatic system, such as computer or electronic controls.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automatism</ns0:orth>
        <ns0:pron>/ɔːˈtɒmətɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automatismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The doctrine that animals are automata, operating according to mechanical laws.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automaton</ns0:orth>
        <ns0:pron>/ɔːˈtɒmətən/</ns0:pron>
        <ns0:pron>/ɔːˈtɒməˌtɒn/</ns0:pron>
        <ns0:pron>/əˈtɑməˌtɑn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autómata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A machine or robot designed to follow a precise sequence of instructions.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person who acts like a machine or robot, often defined as having a monotonous lifestyle and lacking in emotion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A formal system, such as a finite-state machine or cellular automaton.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A toy in the form of a mechanical figure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automobile</ns0:orth>
        <ns0:pron>/ˈɑː.tə.məˈbil/</ns0:pron>
        <ns0:pron>/ˈɑː.tə.məˌbil/</ns0:pron>
        <ns0:pron>/ˈɑː.təˈmoʊ.bil/</ns0:pron>
        <ns0:pron>/ˈɔʈo.mɵˈbajl/</ns0:pron>
        <ns0:pron>/ˈɔː.tə.məˌbil/</ns0:pron>
        <ns0:pron>/ˈɔː.tə.məˌbiːl/</ns0:pron>
        <ns0:pron>/ˌɔː.tə.məˈbil/</ns0:pron>
        <ns0:pron>/ˌɔː.təˈmoʊ.bil/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automóvil</ns0:quote>
          <ns0:quote>coche</ns0:quote>
          <ns0:quote>carro</ns0:quote>
          <ns0:quote>auto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada, Philippines, AU, NZ) A type of motor vehicle designed to move on the ground under its own stored power and intended to carry a driver, a small number of additional passengers, and a very limited amount of other load.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automorphism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automorfismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) An isomorphism of a mathematical object or system of objects onto itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automotive</ns0:orth>
        <ns0:pron>/ˌoːtəˈmɐʉ.tɪv/</ns0:pron>
        <ns0:pron>/ˌoːtəˈməʉ.tɪv/</ns0:pron>
        <ns0:pron>/ˌɑtəˈmoʊtɪv/</ns0:pron>
        <ns0:pron>/ˌɒtəˈmoʊtɪv/</ns0:pron>
        <ns0:pron>/ˌɔtəˈmoʊtɪv/</ns0:pron>
        <ns0:pron>/ˌɔːtəˈməʊtɪv/</ns0:pron>
        <ns0:pron>[ˌoːtəˈmɐʉ.ɾɪv]</ns0:pron>
        <ns0:pron>[ˌoːtəˈməʉ.ɾɪv]</ns0:pron>
        <ns0:pron>[ˌɑɾəˈmoʊɾɪv]</ns0:pron>
        <ns0:pron>[ˌɒɾəˈmoʊɾɪv]</ns0:pron>
        <ns0:pron>[ˌɔɾəˈmoʊɾɪv]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automotor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the ability to move by itself; self-propelled or self-propelling.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automotor</ns0:quote>
          <ns0:quote>automovilístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to motor vehicles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automotive industry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automoción</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomic nervous system</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sistema nervioso autónomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neuroanatomy) In humans and other vertebrates, the part of the nervous system that regulates the involuntary activity of the heart, intestines and glands. These activities include digestion, respiration, perspiration, metabolism, and the modulation of blood pressure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>movimiento autónomo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomous</ns0:orth>
        <ns0:pron>/ɑˈtɑnəməs/</ns0:pron>
        <ns0:pron>/ɔˈtɑnəməs/</ns0:pron>
        <ns0:pron>/ɔːˈtɒnəməs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autónomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Self-governing. Intelligent, sentient, self-aware, thinking, feeling, governing independently.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Acting on one's own or independently; of a child, acting without being governed by parental or guardian rules.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomous community</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comunidad autónoma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the seventeen self-governing first-level political subdivisions of Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomous sensory meridian response</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respuesta sensorial meridiana autónoma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A frisson characterized by a tingling sensation on the skin that typically begins on the scalp and moves down the back of the neck and upper spine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomous vehicle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vehículo autónomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A vehicle that uses mechatronics, artificial intelligence and a multi-agent system to assist its human operator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomously</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autónomamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an autonomous or self-governing manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autonomy</ns0:orth>
        <ns0:pron>/ɑˈtɑ.nə.mi/</ns0:pron>
        <ns0:pron>/ɔˈtɑ.nə.mi/</ns0:pron>
        <ns0:pron>/ɔːˈtɒn.ə.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autonomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(government, countable) A self-governing country or region.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(philosophy, uncountable) The capacity to make an informed, uncoerced decision.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autophagy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autofagia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cytology) The process of self-digestion by a cell through the action of enzymes originating within the same cell, and often a defensive or self-preservation measure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autopilot</ns0:orth>
        <ns0:pron>/ˈɑtoʊˌpaɪlət/</ns0:pron>
        <ns0:pron>/ˈɔtoʊˌpaɪlət/</ns0:pron>
        <ns0:pron>/ˈɔːtəʊˌpaɪlət/</ns0:pron>
        <ns0:pron>[ˈɑ.ɾoʊˌpaɪlət]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾoʊˌpaɪlət]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>piloto automático</ns0:quote>
          <ns0:quote>autopiloto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation, nautical) A mechanical, electrical, or hydraulic system used to guide a vehicle without assistance from a human being.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoplasty</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoplastia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, surgery, dated) The process of artificially repairing lesions by taking a piece of healthy tissue, as from a neighboring part, to supply the deficiency caused by disease or wounds. In present-day contexts likelier to be called autotransplantation or autografting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autopsy</ns0:orth>
        <ns0:pron>/ˈɑtɑpsi/</ns0:pron>
        <ns0:pron>/ˈɔtɑpsi/</ns0:pron>
        <ns0:pron>/ˈɔːtɒpsiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autopsia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dissection performed on a cadaver to find possible cause(s) of death.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoradiography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autorradiografía</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoregulation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autorregulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any of several physiological processes in which an inhibitory feedback system counteracts change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autosexuality</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autosexualidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sexual attraction toward oneself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autosomal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autosómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to autosomes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autosome</ns0:orth>
        <ns0:pron>/ˈɑtəzoʊm/</ns0:pron>
        <ns0:pron>/ˈɔtəˌsoʊm/</ns0:pron>
        <ns0:pron>/ˈɔːtəsəʊm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autosoma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetics) Any chromosome other than sex chromosomes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autosuggestion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autosugestión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology, uncountable) The practice of suggesting thoughts to oneself, as in autohypnosis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(psychology, countable) An instance of suggesting a thought to oneself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autotelic</ns0:orth>
        <ns0:pron>/ˈɔːtəˌtɛlɪk/</ns0:pron>
        <ns0:pron>/ˌɔːtəˈtɛlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autotélico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology, of an activity, process, person or personality) Containing its own meaning or purpose; deriving meaning and purpose from within.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autotomy</ns0:orth>
        <ns0:pron>/ɔːˈtɒtəmi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autotomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, _, zoology) The spontaneous removal of a limb, tail etc, especially by some invertebrates as a self-defense mechanism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autotroph</ns0:orth>
        <ns0:pron>/ˈɔtəˌtɹoʊf/</ns0:pron>
        <ns0:pron>/ˈɔːtə(ʊ)tɹəʊf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autótrofo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecology) Any organism that can synthesize its food from inorganic substances, using heat or light as a source of energy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autotrophic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autótrofo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autotrophy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autotrofia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The synthesis of food from inorganic substances, using heat or light as a source of energy</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autumn</ns0:orth>
        <ns0:pron>/ˈɑtəm/</ns0:pron>
        <ns0:pron>/ˈɔtəm/</ns0:pron>
        <ns0:pron>/ˈɔːtəm/</ns0:pron>
        <ns0:pron>[ˈɑɾm̩]</ns0:pron>
        <ns0:pron>[ˈɑɾɪ̈m]</ns0:pron>
        <ns0:pron>[ˈɔɾm̩]</ns0:pron>
        <ns0:pron>[ˈɔɾɪ̈m]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>otoño</ns0:quote>
          <ns0:quote>otoñada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Traditionally the third of the four seasons, when deciduous trees lose their leaves, and temperatures and daylight hours decrease; typically regarded as spanning the months of September, October, and November in the Northern Hemisphere, and the months of March, April and May in the Southern Hemisphere.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(fashion) A person with relatively dark hair and a warm skin tone, seen as best suited to certain colours in clothing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autumnal</ns0:orth>
        <ns0:pron>/ɔˈtʌmnəɫ/</ns0:pron>
        <ns0:pron>/ɔːˈtʌmnəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>otoñal</ns0:quote>
          <ns0:quote>autumnal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to autumn.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autumnal equinox</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>equinoccio otoñal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) The moment when the sun appears to cross the celestial equator while tilting away from the observer, taking place in September in the northern hemisphere and March in the southern hemisphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auxiliary</ns0:orth>
        <ns0:pron>/ɑɡˈzɪl.((j)ə).ɹi/</ns0:pron>
