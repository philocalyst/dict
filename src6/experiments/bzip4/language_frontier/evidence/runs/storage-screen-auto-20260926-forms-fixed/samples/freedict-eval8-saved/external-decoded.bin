      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>E/S</ns0:quote>
          <ns0:quote>entrada-salida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, electrical engineering) Abbreviation of input/output.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
