      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mozart</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from German; (music) used specifically of Wolfgang Amadeus Mozart (1756–1791), a prolific and influential composer of the Classical period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
