      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Grez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from French.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A commune of Oise department, in northern France.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A village in the municipality of Urraúl Bajo, Navarre, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Grim Reaper</ns0:orth>
        <ns0:pron>/ˈɡɹɪm ˈɹi.pɚ/</ns0:pron>
        <ns0:pron>/ˈɡɹɪm ˈɹiː.pə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calaca</ns0:quote>
          <ns0:quote>descarnada</ns0:quote>
          <ns0:quote>huesuda</ns0:quote>
          <ns0:quote>muerte</ns0:quote>
          <ns0:quote>parca</ns0:quote>
          <ns0:quote>pelona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
