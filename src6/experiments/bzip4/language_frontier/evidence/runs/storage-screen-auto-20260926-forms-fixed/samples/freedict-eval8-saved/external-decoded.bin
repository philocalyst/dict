        <ns0:pron>/ˈvɛltˌʃmɛːts/</ns0:pron>
        <ns0:pron>/ˈvɛltˌʃmɝts/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>weltschmerz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An apathetic or pessimistic view of life; depression concerning or discomfort with the human condition or state of the world; mal du siècle, world-weariness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
