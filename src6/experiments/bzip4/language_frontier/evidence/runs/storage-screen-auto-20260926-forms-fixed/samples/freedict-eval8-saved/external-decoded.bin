      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ecuación diofantina</ns0:quote>
          <ns0:quote>ecuación diofántica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(number theory) A polynomial equation whose variables are only permitted to assume integer values.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
