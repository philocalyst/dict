          <ns0:quote>Nacianzo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A town in the ancient region of Cappadocia, near the modern village of Bekarlar in Gülağaç District, Aksaray Province, Turkey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nazify</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nazificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
