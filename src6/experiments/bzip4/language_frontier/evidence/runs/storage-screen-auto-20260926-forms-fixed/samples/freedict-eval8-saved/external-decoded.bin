        <ns0:sense>
          <ns0:def>(uncommon, informal) A person from Vatican City.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
