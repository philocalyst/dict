        <ns0:pron>/ˈɒd.i.oʊ/</ns0:pron>
        <ns0:pron>/ˈɔ.di.oʊ/</ns0:pron>
        <ns0:pron>/ˈɔː.di.əʊ/</ns0:pron>
        <ns0:pron>[ˈɑ.ɾi.oʊ]</ns0:pron>
        <ns0:pron>[ˈɒɾ.i.oʊ]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾi.oʊ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de audio</ns0:quote>
          <ns0:quote>de sonido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Focused on audible sound, as opposed to sight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audio</ns0:orth>
        <ns0:pron>/ˈoː.di.ɐʉ/</ns0:pron>
        <ns0:pron>/ˈoː.di.əʉ/</ns0:pron>
        <ns0:pron>/ˈɑ.di.oʊ/</ns0:pron>
        <ns0:pron>/ˈɒd.i.oʊ/</ns0:pron>
        <ns0:pron>/ˈɔ.di.oʊ/</ns0:pron>
        <ns0:pron>/ˈɔː.di.əʊ/</ns0:pron>
