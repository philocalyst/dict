      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Vela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A spring constellation of the northern sky, said to resemble the sails of a ship. Until 1763, it was part of a larger constellation, Argo Navis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Velcro</ns0:orth>
        <ns0:pron>/ˈvɛlkɹoʊ/</ns0:pron>
        <ns0:pron>/ˈvɛlkɹəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>velcro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fastener consisting of two strips of fabric, one covered with minute fiber hooks and the other with tiny fiber loops, which stick strongly together but can be pulled apart.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
