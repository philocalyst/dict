        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town and municipality of Gipuzkoa, Basque Country, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Herod</ns0:orth>
        <ns0:pron>/ˈhɛɹəd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Herodes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of any of a number of members of the Herodian dynasty who ruled in the Roman province of Judea, most notably Herod the Great, who ordered the Massacre of the Innocents, or Herod Antipas, his son, who met Jesus during his Passion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Herodotus</ns0:orth>
        <ns0:pron>/həˈɹɑːdətəs/</ns0:pron>
        <ns0:pron>/həˈɹɒdətəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Heródoto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient historian who lived from 484 to 425 BC.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Herostratus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eróstrato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>an Ancient Greek arsonist who destroyed the Temple of Artemis, one of the Seven Wonders of the Ancient World, in order to become famous</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hertzsprung-Russell diagram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diagrama de Hertzsprung-Russell</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A graphic representation of the absolute magnitude of stars against their color (or surface temperature), which shows the main sequence of stars plus the white dwarfs and red giants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hesiod</ns0:orth>
        <ns0:pron>/ˈhiː.si.əd/</ns0:pron>
        <ns0:pron>/ˈhɛs.i.əd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hesíodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ancient Greek poet and rhapsodist of the 8th century BCE, known as the first author of didactic verse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hesperides</ns0:orth>
        <ns0:pron>/hɛˈspɛɹɪdiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hespérides</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A group of nymphs who tend a blissful garden filled with trees that grew golden apples in a far western corner of the world, located in Libya or the Atlas Mountains in North Africa at the edge of the encircling Oceanus; they are said to be the daughters of Hesperus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
