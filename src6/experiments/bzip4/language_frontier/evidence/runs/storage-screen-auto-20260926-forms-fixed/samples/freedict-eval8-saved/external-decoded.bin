      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barrena</ns0:quote>
          <ns0:quote>taladro</ns0:quote>
          <ns0:quote>barreno</ns0:quote>
          <ns0:quote>taladrador</ns0:quote>
          <ns0:quote>berbiquí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A carpenter's tool for boring holes longer than those bored by a gimlet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barrena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
