      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asimilación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of assimilating or the state of being assimilated.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(phonology) A sound change process by which the phonetics of a speech segment becomes more like that of another segment in a word (or at a word boundary), so that a change of phoneme occurs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
