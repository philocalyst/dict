        <ns0:pron>/ˈaftə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæfde̞ɹ/</ns0:pron>
        <ns0:pron>/ˈæftəɹ/</ns0:pron>
        <ns0:pron>/ˈætə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈɐːftə/</ns0:pron>
        <ns0:pron>/ˈɑːftə/</ns0:pron>
        <ns0:pron>/ˈɑːtə(ɹ)/</ns0:pron>
        <ns0:pron>[ˈäftɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Behind; later in time; following.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>after</ns0:orth>
        <ns0:pron>/ˈaftə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæfde̞ɹ/</ns0:pron>
        <ns0:pron>/ˈæftəɹ/</ns0:pron>
        <ns0:pron>/ˈætə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈɐːftə/</ns0:pron>
        <ns0:pron>/ˈɑːftə/</ns0:pron>
        <ns0:pron>/ˈɑːtə(ɹ)/</ns0:pron>
        <ns0:pron>[ˈäftɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Signifies that the action of the clause it starts takes place before the action of the other clause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>after</ns0:orth>
        <ns0:pron>/ˈaftə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæfde̞ɹ/</ns0:pron>
        <ns0:pron>/ˈæftəɹ/</ns0:pron>
        <ns0:pron>/ˈætə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈɐːftə/</ns0:pron>
        <ns0:pron>/ˈɑːftə/</ns0:pron>
        <ns0:pron>/ˈɑːtə(ɹ)/</ns0:pron>
        <ns0:pron>[ˈäftɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>debido a</ns0:quote>
          <ns0:quote>por causa de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Irish, Newfoundland, usually, preceded by a form of be, followed by an -ing form of a verb) Used to indicate recent completion of an activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tras</ns0:quote>
          <ns0:quote>después de</ns0:quote>
          <ns0:quote>en pos de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Subsequently to; following in time; later than.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tras</ns0:quote>
          <ns0:quote>detrás de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Behind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tras</ns0:quote>
          <ns0:quote>detrás de</ns0:quote>
          <ns0:quote>en pos de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In pursuit of, seeking.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a pesar de</ns0:quote>
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In allusion to, in imitation of; following or referencing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después de</ns0:quote>
          <ns0:quote>después</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Below, often next below, in importance or rank.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>after all</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después de todo</ns0:quote>
          <ns0:quote>al fin y al cabo</ns0:quote>
          <ns0:quote>al final</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) anyway, in any case; indicates a statement is true regardless of other considerations; used to reinforce or explain a point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después de todo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) in the end, however; used in referring to something that was believed to be the case, but is not; or to an outcome that is not what was expected or predicted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>after dark</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después de anochecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>After nightfall; at night.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>after the fact</ns0:orth>
        <ns0:pron>/ˌæftɚ ðə ˈfækt/</ns0:pron>
        <ns0:pron>/ˌɑːftə ðə ˈfækt/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a toro pasado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Too late; after something is finished or final.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>after-party</ns0:orth>
        <ns0:pron>/ˈæftɚˌpɑɹti/</ns0:pron>
        <ns0:pron>/ˈɑːftəpɑːti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>after</ns0:quote>
          <ns0:quote>posfiesta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A party that happens after an official, often public, party or event.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterbirth</ns0:orth>
        <ns0:pron>/ˈæf.tɚ.bɚθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alumbramiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The placenta and other material expelled via the birth canal following childbirth or parturition in mammals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterbrain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mielencéfalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A posterior subdivision of the hindbrain; the myelencephalon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterburner</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>postquemador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) A device in a jet engine which injects fuel into the exhaust system to increase the thrust.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterburning</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>postcombustión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) The injection of extra fuel into a jet engine downstream of the turbines in order to achieve extra thrust.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftercare</ns0:orth>
        <ns0:pron>/ˈæf-/</ns0:pron>
        <ns0:pron>/ˈæf.təɹ.kɛɹ/</ns0:pron>
        <ns0:pron>/ˈɑːf.tə(ɹ).kɛə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afección posterótica</ns0:quote>
          <ns0:quote>cariño postsexual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(BDSM) Tender affection and physical care given to a partner after an activity, usually to serve as a transition between the activity and whatever follows it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftereffect</ns0:orth>
        <ns0:pron>/ˈæftəɹ.əˌfɛkt/</ns0:pron>
        <ns0:pron>/ˈɑːftəɹ.ɪˌfɛkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consecuencia</ns0:quote>
          <ns0:quote>efecto</ns0:quote>
          <ns0:quote>secuela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any delayed effect; an effect which is not immediately manifested.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterglow</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>resplandor crepuscular</ns0:quote>
          <ns0:quote>arrebol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The glow seen in the sky after sunset.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sensación de bienestar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The mildly euphoric feeling experienced after a pleasurable experience, especially after an orgasm or drug-induced high.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterimage</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>imagen remanente</ns0:quote>
          <ns0:quote>imagen residual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An image which persists or remains in negative after the original stimulation has ended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterlife</ns0:orth>
        <ns0:pron>/ˈæftɚˌlaɪf/</ns0:pron>
        <ns0:pron>/ˈɑːftəˌlaɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más allá</ns0:quote>
          <ns0:quote>inframundo</ns0:quote>
          <ns0:quote>ultratumba</ns0:quote>
          <ns0:quote>acullá</ns0:quote>
          <ns0:quote>lo de allá</ns0:quote>
          <ns0:quote>orco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A conscious existence after death; a supernatural life that follows one's natural life, in some worldviews.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftermarket</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>poatmercado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftermath</ns0:orth>
        <ns0:pron>/ˈæf.təˌmæθ/</ns0:pron>
        <ns0:pron>/ˈæf.tɚˌmæθ/</ns0:pron>
        <ns0:pron>/ˈɑːf.təˌmæθ/</ns0:pron>
        <ns0:pron>/ˈɑːf.təˌmɑːθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consecuencias</ns0:quote>
          <ns0:quote>resultados</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which happens after, that which follows, usually of strongly negative connotation in most contexts, implying a preceding catastrophe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afternoon</ns0:orth>
        <ns0:pron>/af.təɾˈnʉːn/</ns0:pron>
        <ns0:pron>/ˌæf.tɚˈnun/</ns0:pron>
        <ns0:pron>/ˌɑːf.təˈnuːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tarde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The part of the day from noon or lunchtime until sunset, evening, or suppertime or 6pm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterpain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entuertos</ns0:quote>
          <ns0:quote>tuertos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, often in the plural) Pain of uterine contractions experienced after childbirth (especially after passage of the placenta).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftersale</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>postventa</ns0:quote>
          <ns0:quote>posventa</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftershock</ns0:orth>
        <ns0:pron>/ˈæftɜɹʃɔk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>réplica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(seismology) An earthquake that follows in the same vicinity as another, usually larger, earthquake (the "mainshock").</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aftertaste</ns0:orth>
        <ns0:pron>/ˈæftɚˌteɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>regusto</ns0:quote>
          <ns0:quote>resabio</ns0:quote>
          <ns0:quote>retrogusto</ns0:quote>
          <ns0:quote>gustillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The persistence of the taste of something no longer present.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterthought</ns0:orth>
        <ns0:pron>/ˈæft.ɚ.θɔt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coletilla</ns0:quote>
          <ns0:quote>idea tardía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A reflection after an act; a later or subsequent thought, action, or expedient.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>idea tarda</ns0:quote>
          <ns0:quote>ocurrencia tardía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something additional to the original plan or concept.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afterwards</ns0:orth>
        <ns0:pron>/ˈæf.tɚ.wɚdz/</ns0:pron>
        <ns0:pron>/ˈɑːftə.wədz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después</ns0:quote>
          <ns0:quote>consecuentemente</ns0:quote>
          <ns0:quote>en seguida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(temporal location) At a later or succeeding time; after that;</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>again</ns0:orth>
        <ns0:pron>/eɪˈɡeɪn/</ns0:pron>
        <ns0:pron>/əˈɡeɪn/</ns0:pron>
        <ns0:pron>/əˈɡɛn/</ns0:pron>
        <ns0:pron>[əˈɡɪn]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de nuevo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Back (to a former place or state). [from 11thc.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Tell me again, say again; used in asking a question to which one may have already received an answer that one cannot remember.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de nuevo</ns0:quote>
          <ns0:quote>otra vez</ns0:quote>
          <ns0:quote>nuevamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used metalinguistically, with the repetition being in the discussion, or in the linguistic or pragmatic context of the discussion, rather than in the subject of discussion. [from 16thc.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>again and again</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>una y otra vez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Repeatedly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>against</ns0:orth>
        <ns0:pron>/əˈɡeɪnst/</ns0:pron>
        <ns0:pron>/əˈɡɛnst/</ns0:pron>
        <ns0:pron>/əˈɡɛnst/&lt;a:UK&gt;</ns0:pron>
        <ns0:pron>[əˈɡeə̯nst]</ns0:pron>
        <ns0:pron>[əˈɡɛːnst]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a contrary direction to.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>In exchange for.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>As protection from.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Hollywood) To be paid now in contrast to the following amount to be paid later under specified circumstances, usually that a movie is made or has started filming.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra</ns0:quote>
          <ns0:quote>al opósito</ns0:quote>
          <ns0:quote>en contra</ns0:quote>
          <ns0:quote>en pugna</ns0:quote>
          <ns0:quote>enfrente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In physical opposition to; in collision with.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cerca de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Close to, alongside.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra</ns0:quote>
          <ns0:quote>frente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In front of; before (a background).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
          <ns0:quote>sobre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As a charge on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>against all odds</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra viento y marea</ns0:quote>
          <ns0:quote>contra todo pronóstico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Despite seemingly insurmountable opposition or probability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>against nature</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra natura</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>against the clock</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra el reloj</ns0:quote>
          <ns0:quote>contra reloj</ns0:quote>
          <ns0:quote>contrarreloj</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In a time-restricted manner, to meet a deadline, hurriedly, timed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>against the grain</ns0:orth>
        <ns0:pron>/əˈɡɛnst ðə ɡɹeɪn/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a contracorriente</ns0:quote>
          <ns0:quote>contramano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Contrary to what is expected; especially, of behavior different from what society expects.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agalactia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agalactia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) The failure of a mother (human or otherwise) to produce sufficient milk following birth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agalactic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agaláctico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agalactous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agalacto</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agami</ns0:orth>
        <ns0:pron>/ˈæɡəmi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agamí</ns0:quote>
          <ns0:quote>trompetero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) A South American bird, Psophia crepitans, allied to the cranes, and easily domesticated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aganglionic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agangliónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physiology) Without ganglia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agapanthus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agapanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any member of the genus Agapanthus of flowering plants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agape</ns0:orth>
        <ns0:pron>/əˈɡeɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>boquiabierto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a state of astonishment, wonder, expectation, or eager attention; as with mouth hanging open.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agape</ns0:orth>
        <ns0:pron>/əˈɡɑː.peɪ/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɑˌpeɪ/</ns0:pron>
        <ns0:pron>/ˈæɡ.ə.pi/</ns0:pron>
        <ns0:pron>/ˈæɡ.əˌpeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ágape</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, Christianity) The love of God for mankind, or the benevolent love of Christians for others.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A love feast, especially one held in the early Christian Church in connection with the Eucharist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agar</ns0:orth>
        <ns0:pron>/ˈeɪ.ɡɑː/</ns0:pron>
        <ns0:pron>/ˈeɪ.ɡə/</ns0:pron>
        <ns0:pron>/ˈeɪˌɡɑɹ/</ns0:pron>
        <ns0:pron>/ˈæ.ɡɚ/</ns0:pron>
        <ns0:pron>/ˈɑˌɡɑɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agaragar</ns0:quote>
          <ns0:quote>agar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gelatinous material obtained from red algae, especially Gracilaria species, used as a bacterial culture medium, in electrophoresis and as a food additive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agaric</ns0:orth>
        <ns0:pron>/əˈɡæɹɪk/</ns0:pron>
        <ns0:pron>/əˈɡɑːɹɪk/</ns0:pron>
        <ns0:pron>/ˈæɡəɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agárico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various fungi, principally of the order Agaricales, having fruiting bodies consisting of umbrella-like caps, on stalks, with numerous gills beneath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agarwood</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agáloco</ns0:quote>
          <ns0:quote>áloe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Heartwood from trees of genus Aquilaria, especially Aquilaria malaccensis (syn. A. agallocha), infected with mold (Phialophora parasitica), which produce an aromatic resin in response to this infestation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agate</ns0:orth>
        <ns0:pron>/ˈæɡ.ət/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ágata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable, mineral) A semitransparent, uncrystallized silicate mineral and semiprecious stone, presenting various tints in the same specimen, with colors delicately arranged and often curved in parallel alternating dark and light stripes or bands, or blended in clouds; various authorities call it a variety of chalcedony, a variety of quartz, or a combination of the two.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, US, _, printing, dated) The size of type between pearl and nonpareil, standardized as 5+1⁄2-point.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(slang, usually, in the plural) A testicle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agate glass</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vidrio ágata</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agathodaemon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agatodemonio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A benevolent spirit, as opposed to a cacodemon (an evil daemon).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agave</ns0:orth>
        <ns0:pron>/əˈɡeɪviː/</ns0:pron>
        <ns0:pron>/əˈɡɑːveɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agave</ns0:quote>
          <ns0:quote>maguey</ns0:quote>
          <ns0:quote>pita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any plant in the large, variable genus Agave: succulent plants, commonly armed with formidable prickles; they flower at maturity after several years, and generally die thereafter; large species, such as the maguey or century plant, (Agave americana), produce gigantic inflorescences. Several are of economic importance as sources of fibre such as sisal, and alcoholic beverages such as tequila.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>age</ns0:orth>
        <ns0:pron>/eɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tercera edad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The state of being old; the latter part of life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>años</ns0:quote>
          <ns0:quote>edad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Any particular stage of life.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Lifespan, lifetime; the total time that some being is alive from birth to death (or some category of beings, on average).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mayoría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Maturity; especially, the time of life at which one attains full personal rights and capacities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edad</ns0:quote>
          <ns0:quote>era</ns0:quote>
          <ns0:quote>época</ns0:quote>
          <ns0:quote>evo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A particular period of time in history, as distinguished from others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrology) One of the twelve divisions of a Great Year, equal to roughly 2000 years and governed by one of the zodiacal signs; a Platonic month.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>generación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncommon, possibly, dated) A generation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edad</ns0:quote>
          <ns0:quote>edades</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, hyperbole) A long time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edad</ns0:quote>
          <ns0:quote>era</ns0:quote>
          <ns0:quote>época</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, poker) The entitlement of the player to the left of the dealer to pass the first round in betting, and then to come in last or stay out; also, the player holding this position; the eldest hand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>age</ns0:orth>
        <ns0:pron>/eɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>envejecerse</ns0:quote>
          <ns0:quote>envejecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To grow aged; to become old or older; to show marks of age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>envejecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to grow old; to impart the characteristics of age to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>age gap</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A difference in ages between two or more people, especially in the context of romantic or sexual relationships.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>age group</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grupo etario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A demographic grouping based on age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>age of consent</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edad de consentimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The age at which a person is legally considered to be mature enough to engage willingly in sexual intercourse, so that it is not a crime for someone else to have sex with the person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>age of majority</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mayoría de edad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The age at which the rights and privileges of an adult are legally granted or recognized; i.e.; the age where a person ceases to be a minor legally and becomes a legal adult.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aged</ns0:orth>
        <ns0:pron>/eɪdʒd/</ns0:pron>
        <ns0:pron>/ˈeɪ.dʒɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anciano</ns0:quote>
          <ns0:quote>viejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Old.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mostly, non-US) Having the age of.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having undergone the improving effects of time; matured.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ageism</ns0:orth>
        <ns0:pron>/ˈeɪd͡ʒ.ɪz.əm/</ns0:pron>
        <ns0:pron>/ˈeɪd͡ʒ.ɪzm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edadismo</ns0:quote>
          <ns0:quote>edatismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The treating of a person or people, especially older people, differently from others based on assumptions, prejudices or/and stereotypes relating to their age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ageless</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eterno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(relative to future) Continuing infinitely or indefinitely.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>siempre joven</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Always appearing youthful; never seeming to age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agency</ns0:orth>
        <ns0:pron>/ˈeɪ.d͡ʒən.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albedrío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capacity, condition, or state of acting or of exerting power.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sociology, philosophy, psychology) The capacity of individuals to act independently and to make their own free choices.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The office or function of an agent; also, the relationship between a principal and that person's agent.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A department or other administrative unit of a government; also, the office or headquarters of, or the district administered by, such unit of government.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agencia</ns0:quote>
          <ns0:quote>oficina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An establishment engaged in doing business for another; also, the place of business or the district of such an agency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agenda</ns0:orth>
        <ns0:pron>/əˈd͡ʒɛn.də/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plan</ns0:quote>
          <ns0:quote>programa</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>orden del día</ns0:quote>
          <ns0:quote>agenda</ns0:quote>
          <ns0:quote>balotario</ns0:quote>
          <ns0:quote>temario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A list of matters to be taken up (as at a meeting).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agenda</ns0:quote>
          <ns0:quote>memorando</ns0:quote>
          <ns0:quote>memorándum</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A notebook used to organize and maintain such plans or lists, an agenda book, an agenda planner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agender</ns0:orth>
        <ns0:pron>/eɪˈdʒɛndɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agénero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without an associated gender (in any sense); not having a particular gender.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agenesis</ns0:orth>
        <ns0:pron>/eɪˈd͡ʒɛnəsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agenesia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Any imperfect development of the body, or any anomaly of organization</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agent</ns0:orth>
        <ns0:pron>/ˈeɪ.d͡ʒənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agente</ns0:quote>
          <ns0:quote>gendarme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who acts for, or in the place of, another (the principal), by that person's authority; someone entrusted to act on behalf of or in behalf of another, such as to transact business for them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who works for an intelligence agency: whether an officer or employee thereof or anyone else who agrees to help their efforts (for ideology, for money, as blackmailee, or otherwise).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An active power or cause or substance; something (e.g. biological, chemical, thermal, etc.) that has the power to produce an effect.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing) In the client-server model, the part of the system that performs information preparation and exchange on behalf of a client or server. Especially in the phrase “intelligent agent” it implies some kind of autonomous process which can communicate with other agents to perform some collective task on behalf of one or more humans.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) The participant of a situation that carries out the action in this situation, e.g. "the boy" in the sentences "The boy kicked the ball" and "The ball was kicked by the boy".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agent noun</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nombre de agente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A noun that denotes an agent (human or nonhuman) that performs the action denoted by the verb from which the noun is derived, such as "rider" derived from "to ride", or "cutter" derived from "to cut".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agent provocateur</ns0:orth>
        <ns0:pron>/ˈeɪ.dʒənt ˌpɹəʊ.vɒk.æ.tʊə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agente provocador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who secretly disrupts a group's activities from within the group, particularly by encouraging or committing illegal acts to discredit the group or expose them to prosecution; an instigator, troublemaker.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agentive</ns0:orth>
        <ns0:pron>/əˈd͡ʒɛntɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agentivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) Indicating an agent or agency (as -er in lexicographer).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ageusia</ns0:orth>
        <ns0:pron>/æˈɡjuːzɪə/</ns0:pron>
        <ns0:pron>/æˈɡjuːʒə/</ns0:pron>
        <ns0:pron>/əˈɡjuːzɪə/</ns0:pron>
        <ns0:pron>/əˈɡjuːʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ageusia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Absence of the sense of taste.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Partial or complete loss of the sense of taste.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ageym</ns0:orth>
        <ns0:pron>/əˈjɛm/</ns0:pron>
        <ns0:pron>/əˈɡɛm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Geordie, Northern England) Opposite to; in opposition to; contrary to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agglomeration</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aglomeración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of collecting in a mass; a heaping together.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>State of being collected in a mass; a mass; cluster.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geography) An extended city area comprising the built-up area of a central city and any suburbs linked by continuous urban area.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agglutination</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aglutinación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of uniting by glue or other tenacious substance; the state of being thus united; adhesion of parts.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(linguistics) Combination in which root words are united with little or no change of form or loss of meaning. See agglutinative.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The clumping together of red blood cells or bacteria, usually in response to a particular antibody.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agglutinative</ns0:orth>
        <ns0:pron>/əˈɡluːtɪnətɪv/</ns0:pron>
        <ns0:pron>[əˈɡɫut̚nəɾɪv]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aglutinante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) Having words derived by combining parts, each with a separate meaning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggrandize</ns0:orth>
        <ns0:pron>/əˈɡɹændaɪ̯z/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>engrandecer</ns0:quote>
          <ns0:quote>enaltecer</ns0:quote>
          <ns0:quote>encumbrar</ns0:quote>
          <ns0:quote>ennoblecer</ns0:quote>
          <ns0:quote>ensalzar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make great or greater in power, rank, honor, or wealth (applied to persons, countries, etc.).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggrandizement</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>engrandecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of aggrandizing, or the state of being aggrandized or exalted in power, rank, honor, or wealth; exaltation; enlargement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggravate</ns0:orth>
        <ns0:pron>/ˈæɡ.ɹə.veɪ̯t/&lt;q:verb&gt;</ns0:pron>
        <ns0:pron>/ˈæɡɹəvət/&lt;q:adjective&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agravar</ns0:quote>
          <ns0:quote>empeorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make (an offence) worse or more severe; to increase in offensiveness or heinousness. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>exasperar</ns0:quote>
          <ns0:quote>irritar</ns0:quote>
          <ns0:quote>sublevar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, rare) To give extra weight or intensity to; to exaggerate, to magnify. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggravation</ns0:orth>
        <ns0:pron>/ˌæɡɹəˈveɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agravio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of aggravating, or making worse; used of evils, natural or moral; the act of increasing in severity or heinousness; something additional to a crime or wrong and enhancing its guilt or injurious consequences.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agravante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extrinsic circumstance or accident which increases the guilt of a crime or the misery of a calamity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggregate</ns0:orth>
        <ns0:pron>/ˈæɡ.ɹɪ.ɡət/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɹɪˌɡeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregado</ns0:quote>
          <ns0:quote>conjunto</ns0:quote>
          <ns0:quote>sumado</ns0:quote>
          <ns0:quote>total</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Formed by a collection of particulars into a whole mass or sum; collective; combined; added up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregado</ns0:quote>
          <ns0:quote>conglomerado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Consisting or formed of smaller objects or parts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggregate</ns0:orth>
        <ns0:pron>/ˈæɡ.ɹɪ.ɡət/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɹɪˌɡeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregado</ns0:quote>
          <ns0:quote>conjunto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mass, assemblage, or sum of particulars; something consisting of elements but considered as a whole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mass formed by the union of homogeneous particles; – in distinction from a compound, formed by the union of heterogeneous particles.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Buddhism) Any of the five attributes that constitute the sentient being.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A mechanical mixture of more than one phase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>global</ns0:quote>
          <ns0:quote>resultado global</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) The total score in a set of games between teams or competitors, usually the combination of the home and away scores.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggregate</ns0:orth>
        <ns0:pron>/ˈæɡ.ɹɪ.ɡət/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɹɪˌɡeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregar</ns0:quote>
          <ns0:quote>allegar</ns0:quote>
          <ns0:quote>juntar</ns0:quote>
          <ns0:quote>sumar</ns0:quote>
          <ns0:quote>yuntar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To bring together; to collect into a mass or sum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggregate fruit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conocarpo</ns0:quote>
          <ns0:quote>eterio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A fruit that develops from the fusion of more than one carpel within a single flower, as for instance, a raspberry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggression</ns0:orth>
        <ns0:pron>/əˈɡɹɛʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of initiating hostilities or invasion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The practice or habit of launching attacks.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Hostile or destructive behavior or actions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggressive</ns0:orth>
        <ns0:pron>/əˈɡɹɛs.ɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characterized by aggression; highly combative; prone to behave in a way that involves attacking (especially if unjustly) or arguing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(pathology, of a tumour or disease) That spreads quickly or extensively; virulent; malignant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggressively</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresivamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an aggressive manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggressiveness</ns0:orth>
        <ns0:pron>/əˈɡrɛsɪvnɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresividad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The state or quality of being aggressive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggressor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresor</ns0:quote>
          <ns0:quote>agresora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The person or country that first attacks or makes an aggression; that begins hostility or a quarrel; an assailant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggrieved</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>herido</ns0:quote>
          <ns0:quote>ofendido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Angry or resentful due to unjust treatment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aggro</ns0:orth>
        <ns0:pron>/ˈæɡ.ɹoʊ/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɹəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agravar</ns0:quote>
          <ns0:quote>irritar</ns0:quote>
          <ns0:quote>provocar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(gaming, transitive) To cause (a non-player character) to become aggressive towards the player's character.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aghast</ns0:orth>
        <ns0:pron>/əˈɡast/</ns0:pron>
        <ns0:pron>/əˈɡæst/</ns0:pron>
        <ns0:pron>/əˈɡɑːst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aterrado</ns0:quote>
          <ns0:quote>espantado</ns0:quote>
          <ns0:quote>horrorizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Terrified; struck with amazement; showing signs of terror or horror.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agile</ns0:orth>
        <ns0:pron>/ˈæd͡ʒ.aɪl/</ns0:pron>
        <ns0:pron>/ˈæd͡ʒ.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ágil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the faculty of quick motion in the limbs; apt or ready to move.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agile gibbon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gibón ágil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A primate of species Hylobates agilis, in the Hylobatidae or gibbon family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agilely</ns0:orth>
        <ns0:pron>/ˈæd͡ʒ.aɪl.li/</ns0:pron>
        <ns0:pron>/ˈæd͡ʒ.ə.li/</ns0:pron>
        <ns0:pron>/ˈæd͡ʒ.əl.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ágilmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an agile manner; with agility.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agility</ns0:orth>
        <ns0:pron>/əˈd͡ʒɪl.ə.ti/</ns0:pron>
        <ns0:pron>/əˈd͡ʒɪl.ɪ.ti/</ns0:pron>
        <ns0:pron>[əˈd͡ʒɪl.ə.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality of being agile; the power of moving the limbs quickly and easily; quickness of motion</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aging</ns0:orth>
        <ns0:pron>/ˈeɪ.d͡ʒɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>senescente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Becoming elderly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aging</ns0:orth>
        <ns0:pron>/ˈeɪ.d͡ʒɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>envejecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of becoming older or more mature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agio</ns0:orth>
        <ns0:pron>/ˈæ.d͡ʒiˌoʊ/</ns0:pron>
        <ns0:pron>/ˈæ.d͡ʒoʊ/</ns0:pron>
        <ns0:pron>/ˈɑː.d͡ʒoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(economics, finance) The premium or percentage on a better sort of money when it is given in exchange for an inferior sort. The premium or discount on foreign bills of exchange is sometimes called agio.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agitate</ns0:orth>
        <ns0:pron>/ˈæ.d͡ʒɪ.teɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alborotar</ns0:quote>
          <ns0:quote>campañear por</ns0:quote>
          <ns0:quote>fomentar</ns0:quote>
          <ns0:quote>hacer campaña por</ns0:quote>
          <ns0:quote>perturbar</ns0:quote>
          <ns0:quote>provocar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agitar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to move with a violent, irregular action; to shake. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agitated</ns0:orth>
        <ns0:pron>/ˈæd͡ʒɪteɪtɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alborotado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Angry, annoyed, bothered or worked up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agitation</ns0:orth>
        <ns0:pron>/ad͡ʒ.ɪˈteɪ.ʃ(ə)n/</ns0:pron>
        <ns0:pron>/æ.d͡ʒɪˈteɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agitación</ns0:quote>
          <ns0:quote>desasosiego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of agitating, or the state of being agitated; the state of being disrupted with violence, or with irregular action; commotion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inquietud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A disturbance of personal tranquillity; disturbance of someone's peace of mind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agitator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agitador</ns0:quote>
          <ns0:quote>agitadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who agitates; one who stirs up or excites others, for example political reformers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnate</ns0:orth>
        <ns0:pron>/ˈæɡneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Related to someone by male connections or on the paternal side of the family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnate</ns0:orth>
        <ns0:pron>/ˈæɡneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A relative whose relation is traced only through male members of the family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnathan</ns0:orth>
        <ns0:pron>/æɡˈnæθ.ən/</ns0:pron>
        <ns0:pron>/ˈæɡ.nə.θən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) A member of the superclass Agnatha of jawless vertebrates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnatic</ns0:orth>
        <ns0:pron>/æɡˈnætɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of the male bloodline; patrilineal</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>consanguinity by a line of males only, as distinguished from cognation</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnolotti</ns0:orth>
        <ns0:pron>/ˌanjəˈlɒtɪ/</ns0:pron>
        <ns0:pron>/ˌænjəˈlɑti/</ns0:pron>
        <ns0:pron>/ˌɑnjəˈlɑti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>añoloti</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of square or rectangular ravioli from Piedmont made from a small sheet of pasta folded up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnomen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnombre</ns0:quote>
          <ns0:quote>agnomento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An additional cognomen given, as an honour, to a Roman citizen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnostic</ns0:orth>
        <ns0:pron>/aɡˈnɒstɪk/</ns0:pron>
        <ns0:pron>/æɡˈnɑstɪk/</ns0:pron>
        <ns0:pron>/æɡˈnɔstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnóstico</ns0:quote>
          <ns0:quote>agnóstica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to agnosticism or its adherents.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnostic</ns0:orth>
        <ns0:pron>/aɡˈnɒstɪk/</ns0:pron>
        <ns0:pron>/æɡˈnɑstɪk/</ns0:pron>
        <ns0:pron>/æɡˈnɔstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnóstico</ns0:quote>
          <ns0:quote>agnóstica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who holds to a form of agnosticism, especially uncertainty of the existence of a deity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnosticism</ns0:orth>
        <ns0:pron>/æɡˈnɑstɪsɪzəm/</ns0:pron>
        <ns0:pron>/æɡˈnɒstɪsɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnosticismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The view that the existence of God or of all deities is unknown, unknowable, unproven, or unprovable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agnotology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agnotología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of culturally-induced ignorance or doubt, particularly the publication of inaccurate or misleading scientific data.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ago</ns0:orth>
        <ns0:pron>/əˈɡoʊ/</ns0:pron>
        <ns0:pron>/əˈɡəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>postposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hace</ns0:quote>
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>ha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Before now, before the present time</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agog</ns0:orth>
        <ns0:pron>/əˈɡɑɡ/</ns0:pron>
        <ns0:pron>/əˈɡɒɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>curioso</ns0:quote>
          <ns0:quote>ansioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In eager desire, eager, astir.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agonize</ns0:orth>
        <ns0:pron>/ˈæɡ.ə.naɪz/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɪ.naɪz/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɪ.nɑez/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agonizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To writhe with agony; to suffer violent anguish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agonizing</ns0:orth>
        <ns0:pron>/ˈæɡ.ə.naɪ.zɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agonizante</ns0:quote>
          <ns0:quote>angustioso</ns0:quote>
          <ns0:quote>terrible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing physical or mental agony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agony</ns0:orth>
        <ns0:pron>/əˈɡoni/</ns0:pron>
        <ns0:pron>/ˈaɡɵni/</ns0:pron>
        <ns0:pron>/ˈæɡ.ə.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agonía</ns0:quote>
          <ns0:quote>angustia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Extreme pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agonía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Dated) Violent contest or striving.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The last struggle of life; death struggle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agora</ns0:orth>
        <ns0:pron>/ˈæ.ɡə.ɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ágora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place for gathering.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A marketplace, especially in Classical Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agoraphobia</ns0:orth>
        <ns0:pron>/əˌɡoː.ɹəˈfəʉ.biː.ə/</ns0:pron>
        <ns0:pron>/əˌɡɔɹ.əˈfoʊ.bi.ə/</ns0:pron>
        <ns0:pron>/əˌɡɔː.ɹəˈfəʊ.bi.ə/</ns0:pron>
        <ns0:pron>/ˌæɡ.ə.ɹəˈfəʊ.bi.ə/</ns0:pron>
        <ns0:pron>/ˌæɡ.ɚ.əˈfoʊ.bi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agorafobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fear of wide open spaces, crowds, or uncontrolled social conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agoraphobic</ns0:orth>
        <ns0:pron>/əˌɡɔɹ.əˈfoʊ.bɪk/</ns0:pron>
        <ns0:pron>/əˌɡɔː.ɹəˈfəʊ.bɪk/</ns0:pron>
        <ns0:pron>/ˌæɡ.ə.ɹəˈfəʊ.bɪk/</ns0:pron>
        <ns0:pron>/ˌæɡ.ɚ.əˈfoʊ.bɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agorafóbico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to or suffering from agoraphobia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agorism</ns0:orth>
        <ns0:pron>/ˈæ.ɡəˌɹɪzm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agorismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) A revolutionary political philosophy that advocates the creation of a voluntaryist society by means of counter-economics (i.e. black market).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agouti</ns0:orth>
        <ns0:pron>/əˈɡuːti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agutí</ns0:quote>
          <ns0:quote>cotuza</ns0:quote>
          <ns0:quote>ñeque</ns0:quote>
          <ns0:quote>añuje</ns0:quote>
          <ns0:quote>guatusa</ns0:quote>
          <ns0:quote>jochi colorado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rodent of the genus Dasyprocta, similar in appearance to a guinea pig but having longer legs, mainly native to Central and South America.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrammatism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agramatismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The inability to form sentences by virtue of a brain disorder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agranulocytosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agranulocitosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) An acute condition involving a severe and dangerous leukopenia, particularly of neutrophils, causing a neutropenia in the circulating blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrarian</ns0:orth>
        <ns0:pron>/əˈɡɹɛ(ə)ɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to, the ownership, tenure and cultivation of land.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrarianism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrarismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A social and political philosophy that advocates an equitable distribution of land.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agree</ns0:orth>
        <ns0:pron>/əˈɡɹi/</ns0:pron>
        <ns0:pron>/əˈɡɹiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estar de acuerdo</ns0:quote>
          <ns0:quote>concordar</ns0:quote>
          <ns0:quote>acordar</ns0:quote>
          <ns0:quote>coincidir</ns0:quote>
          <ns0:quote>concurrir</ns0:quote>
          <ns0:quote>ponerse acorde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To be in harmony about an opinion, statement, or action; to have a consistent idea between two or more people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceder</ns0:quote>
          <ns0:quote>concordar</ns0:quote>
          <ns0:quote>aceptar</ns0:quote>
          <ns0:quote>apalabrar</ns0:quote>
          <ns0:quote>asentir</ns0:quote>
          <ns0:quote>concertar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To make a stipulation by way of settling differences or determining a price; to exchange promises; to come to terms or to a common resolve; to promise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coincidir</ns0:quote>
          <ns0:quote>concordar</ns0:quote>
          <ns0:quote>corresponder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To resemble; to coincide; to correspond; to tally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concordar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, grammar) To correspond to (another word) in a grammatical category, such as gender, number, case, or person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agree to disagree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acordar discrepar</ns0:quote>
          <ns0:quote>concordar discordar</ns0:quote>
          <ns0:quote>concurrir en descordar</ns0:quote>
          <ns0:quote>convenir en desconvenir</ns0:quote>
          <ns0:quote>para ti la perra gorda</ns0:quote>
          <ns0:quote>ponerse acorde con estar desacorde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, of two persons or other parties) To accept each other's opinions and cease arguing; to peacefully acknowledge that an agreement will not be reached.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agree with</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comulgar con</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreeable</ns0:orth>
        <ns0:pron>/əˈɡɹiəbəl/</ns0:pron>
        <ns0:pron>/əˈɡɹiːəbəl/</ns0:pron>
        <ns0:pron>/əˈɡɹɪbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agradable</ns0:quote>
          <ns0:quote>lisonjero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pleasant to the senses or the mind; pleasing, satisfying, palatable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dispuesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Willing; ready to agree or consent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conforme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Agreeing or suitable; followed by to, or rarely by with.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreeableness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) A personality trait characterized by the adjectives kind, sympathetic, cooperative, warm and considerate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreeably</ns0:orth>
        <ns0:pron>/əˈɡɹiːəbli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agradablemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an agreeable or pleasing manner</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreed</ns0:orth>
        <ns0:pron>/əˈɡɹid/</ns0:pron>
        <ns0:pron>/əˈɡɹiːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de acuerdo</ns0:quote>
          <ns0:quote>concuerdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates agreement on the part of the speaker.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreement</ns0:orth>
        <ns0:pron>/əˈɡɹiːmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuerdo</ns0:quote>
          <ns0:quote>pacto</ns0:quote>
          <ns0:quote>convenio</ns0:quote>
          <ns0:quote>concordata</ns0:quote>
          <ns0:quote>concordato</ns0:quote>
          <ns0:quote>tratado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An understanding between entities to follow a specific course of conduct.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuerdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A state whereby several parties share a view or opinion; the state of not contradicting one another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuerdo</ns0:quote>
          <ns0:quote>convenio</ns0:quote>
          <ns0:quote>contrato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, legal) A legally binding contract enforceable in a court of law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concordancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, linguistics, grammar) Rules that exist in many languages that force some parts of a sentence to be used or inflected differently depending on certain attributes of other parts.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete, chiefly, _, in the plural) An agreeable quality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreement as to succession</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pacto sucesorio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agreement in principle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principio de acuerdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A legally enforceable, but incompletely specified, agreement between parties that identifies the fundamental terms that are intended to be or are agreed upon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agribusiness</ns0:orth>
        <ns0:pron>/-nɪs/</ns0:pron>
        <ns0:pron>/ˈæɡɹɪˌbɪznəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agronegocio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Business (especially big business) connected to agriculture, either owning or operating large-scale farms, or catering to those who do. [from 1950s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A business or group of businesses engaged in agriculture, particularly if using modern farming techniques in the process.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agricultural</ns0:orth>
        <ns0:pron>/ˌæɡɹɪˈkʌltjʊəɹəl/</ns0:pron>
        <ns0:pron>/ˌæɡɹɪˈkʌlt͡ʃəɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrícola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to agriculture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agriculturalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrarismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any ideology that promotes agriculture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agriculture</ns0:orth>
        <ns0:pron>/əɡˈrɪkəltʃə(r)/</ns0:pron>
        <ns0:pron>/ˈeɪɡɹɪˌkʌlt͡ʃɚ/</ns0:pron>
        <ns0:pron>/ˈæɡɹɪˌkʌltʃɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agricultura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The art or science of cultivating the ground, including the harvesting of crops, and the rearing and management of livestock.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agriculturist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agricultor</ns0:quote>
          <ns0:quote>agricultora</ns0:quote>
          <ns0:quote>agrícola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who practices agriculture, a farmer, a gardener.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrícola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expert in agriculture who advises farmers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agriculturize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agriculturizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To convert (land) for agricultural use.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To convert (a community) to use agriculture (rather than hunting and gathering, or industry, etc).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrimi</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>kri-kri</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of goat with long horns that curl back, native to Crete, subspecies Capra hircus cretica, sometimes Capra aegagrus cretica et al.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrimony</ns0:orth>
        <ns0:pron>/ˈæɡ.ɹɪ.mən.i/</ns0:pron>
        <ns0:pron>/ˈæɡ.ɹɪˌmoʊ.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrimonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several perennial herbaceous plants, of the genus Agrimonia, that have spikes of yellow flowers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agritourism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroturismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of tourism in which tourists stay in farms or agricultural villages, either to experience farm life, or as a base for exploring the countryside</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agro-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agro-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>agriculture</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agro-environmental</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroambiental</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrobiology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrobiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The science of plant life and nutrition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrobiotechnology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrobiotecnología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The application of biotechnology to agriculture</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrochemical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroquímico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to agrochemistry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrochemistry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroquímica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) The branch of chemistry related to agriculture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agroclimatic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroclimático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to the connection between agriculture and climate</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agroecological</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroecológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to agroecology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agroecology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroecología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The agricultural ecology</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrofuel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrocombustible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any biofuel produced by agricultural means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agroindustrial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroindustrial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to both agriculture and industry, or to agricultural industry (agroindustry), or to industrial agriculture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agroindustry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agroindustria</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrology</ns0:orth>
        <ns0:pron>/əˈɡɹɑləd͡ʒi/</ns0:pron>
        <ns0:pron>/əˈɡɹɒlədʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) A subdiscipline of agronomy (the science of utilizing animals, plants, and soils) and of soil science which addresses the influence of edaphic (soil-related) conditions on crop production for optimizing it. [from mid 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agronomic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agronómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to agronomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agronomist</ns0:orth>
        <ns0:pron>/əˈɡɹɑːnəmɪst/</ns0:pron>
        <ns0:pron>/əˈɡɹɒnəmɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrónomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A scientist whose speciality is agronomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agronomy</ns0:orth>
        <ns0:pron>/əˈɡɹɑːnəmi/</ns0:pron>
        <ns0:pron>/əˈɡɹɒnəmi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agronomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The science of utilizing plants, animals and soils for food, fuel, feed, and fiber and more. To do this effectively and sustainably, agronomy encompasses work in the areas of plant genetics, plant physiology, meteorology, animal sciences and soil science.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrotechnical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agrotécnico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to agrotechnology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aground</ns0:orth>
        <ns0:pron>/əˈɡɹaʊnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encallado</ns0:quote>
          <ns0:quote>varado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical, of a normally floating craft) Resting on the bottom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>agrypnia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>insomnia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychiatry, pathology) Persistent loss of sleep; insomnia; sleeplessness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ague</ns0:orth>
        <ns0:pron>/ˈeɪ.ɡju/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fiebre intermitente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) An intermittent fever, attended by alternate cold and hot fits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escalofrío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A chill, or state of shaking, as with cold.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aha</ns0:orth>
        <ns0:pron>/ɑːhɑː/</ns0:pron>
        <ns0:pron>[ɑˈhɑ]</ns0:pron>
        <ns0:pron>[əˈhɑ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ajá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An exclamation of understanding, realization, invention, or recognition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ahead</ns0:orth>
        <ns0:pron>/əˈhɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelante</ns0:quote>
          <ns0:quote>al frente de</ns0:quote>
          <ns0:quote>delante de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At or towards the front; in the direction one is facing or moving.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ahead of one's time</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelantado a su época</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In advance of concurrent commonly accepted ideas; showing characteristics of changes yet to be.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ahistorical</ns0:orth>
        <ns0:pron>/ˌeɪhɪˈstɔɹɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ahistórico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lacking historical perspective or context.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ahoy</ns0:orth>
        <ns0:pron>/əˈhɔɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la vista</ns0:quote>
          <ns0:quote>ah</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) Used to hail a ship, a boat or a person, or to attract attention.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aibohphobia</ns0:orth>
        <ns0:pron>/aɪ.bəʊˈfəʊ.bi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aibofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(humorous, nonce) An irrational fear of palindromes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aid</ns0:orth>
        <ns0:pron>/eɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ayuda</ns0:quote>
          <ns0:quote>auxilio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Help; assistance; succor, relief.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistente</ns0:quote>
          <ns0:quote>ayudante</ns0:quote>
          <ns0:quote>recurso</ns0:quote>
          <ns0:quote>remedio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Something which helps; a material source of help.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aid</ns0:orth>
        <ns0:pron>/eɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ayudar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To provide support to; to further the progress of; to help; to assist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aide-de-camp</ns0:orth>
        <ns0:pron>/ˌeɪd dɪ ˈkæmp/</ns0:pron>
        <ns0:pron>/ˌeɪd dɪ ˈkɒmp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edecán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A military officer who serves as an adjutant to a higher-ranking officer, prince or other high political dignitary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aide-mémoire</ns0:orth>
        <ns0:pron>/ˌeɪd.mɛmˈwɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pro memoria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A memory aid; a reminder or memorandum, especially a book or document serving this purpose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aiglet</ns0:orth>
        <ns0:pron>/ˈeɪ.ɡlɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetato</ns0:quote>
          <ns0:quote>herrete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tip, originally of metal and often decorative, on a ribbon or cord that makes lacing two parts of a garment or garments together easier, as in corset lacings, "points" (lacing hose or trousers to jacket or doublet) or sleeves to a bodice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aiguillette</ns0:orth>
        <ns0:pron>/ˌeɪɡwɪˈlɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cordón</ns0:quote>
          <ns0:quote>cordón militar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ornamental braided cord with decorative metal tips worn on uniforms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ail</ns0:orth>
        <ns0:pron>/eɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfermedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) An ailment; trouble; illness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ail</ns0:orth>
        <ns0:pron>/eɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afligir</ns0:quote>
          <ns0:quote>aquejar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to suffer; to trouble, afflict. (Now chiefly in interrogative or indefinite constructions.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>padecer</ns0:quote>
          <ns0:quote>adolecer</ns0:quote>
          <ns0:quote>afligir</ns0:quote>
          <ns0:quote>aquejar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To be ill; to suffer; to be troubled.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ailanthus</ns0:orth>
        <ns0:pron>/ˌeɪˈlænθəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ailanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several deciduous Asiatic trees of the genus Ailanthus, including the tree of heaven.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aileron</ns0:orth>
        <ns0:pron>/ˈeɪləɹɑn/</ns0:pron>
        <ns0:pron>/ˈeɪləɹɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alerón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The hinged part on the trailing edge of an airplane wing, used to control longitudinal turns.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ailing</ns0:orth>
        <ns0:pron>/ˈeɪ.lɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfermo</ns0:quote>
          <ns0:quote>achacoso</ns0:quote>
          <ns0:quote>enfermito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sickly; sick; ill; unwell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ailment</ns0:orth>
        <ns0:pron>/ˈeɪlmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfermedad</ns0:quote>
          <ns0:quote>achaque</ns0:quote>
          <ns0:quote>alifafe</ns0:quote>
          <ns0:quote>dolama</ns0:quote>
          <ns0:quote>dolencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something which ails one; a disease; sickness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ailuro-</ns0:orth>
        <ns0:pron>/aɪˈljʊəɹə-/</ns0:pron>
        <ns0:pron>/aɪˈlʊɹə-/</ns0:pron>
        <ns0:pron>/eɪˈlʊɹə-/</ns0:pron>
        <ns0:pron>/ˌaɪljʊəɹə-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeluro-</ns0:quote>
          <ns0:quote>ailuro-</ns0:quote>
          <ns0:quote>eluro-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Cat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ailurophobia</ns0:orth>
        <ns0:pron>/aɪˌlʊɹəˈfoʊbi.ə/</ns0:pron>
        <ns0:pron>/eɪˌlʊɹəˈfoʊbi.ə/</ns0:pron>
        <ns0:pron>/ˌaɪljʊəɹəˈfəʊbɪ.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ailurofobia</ns0:quote>
          <ns0:quote>elurofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An irrational fear or hatred of cats or other felines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aim</ns0:orth>
        <ns0:pron>/eɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puntería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The pointing of a weapon, as a gun, a dart, or an arrow, or object, in the line of direction with the object intended to be struck; the line of fire; the direction of anything, such as a spear, a blow, a discourse, a remark, towards a particular point or object, with a view to strike or affect it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>objetivo</ns0:quote>
          <ns0:quote>meta</ns0:quote>
          <ns0:quote>finalidad</ns0:quote>
          <ns0:quote>intención</ns0:quote>
          <ns0:quote>pretensión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The point intended to be hit, or object intended to be attained or affected.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Intention or goal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aim</ns0:orth>
        <ns0:pron>/eɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apuntar</ns0:quote>
          <ns0:quote>abocar</ns0:quote>
          <ns0:quote>destinar</ns0:quote>
          <ns0:quote>dirigir</ns0:quote>
          <ns0:quote>encaminar</ns0:quote>
          <ns0:quote>enfocar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To direct the intention or purpose; to attempt the accomplishment of a purpose; to try to gain; to endeavor;—followed by at, or by an infinitive</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apuntar</ns0:quote>
          <ns0:quote>abocar</ns0:quote>
          <ns0:quote>asestar</ns0:quote>
          <ns0:quote>baraustar</ns0:quote>
          <ns0:quote>dirigir</ns0:quote>
          <ns0:quote>encarar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To direct or point (e.g. a weapon), at a particular object; to direct, as a missile, an act, or a proceeding, at, to, or against an object</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aimless</ns0:orth>
        <ns0:pron>/ˈeɪm.ləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin objetivo</ns0:quote>
          <ns0:quote>sin objeto</ns0:quote>
          <ns0:quote>sin propósito</ns0:quote>
          <ns0:quote>sin rumbo</ns0:quote>
          <ns0:quote>sin rumbo fijo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without aim, purpose, or direction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aimlessly</ns0:orth>
        <ns0:pron>/ˈeɪmləsli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin objetivo</ns0:quote>
          <ns0:quote>sin objeto</ns0:quote>
          <ns0:quote>sin propósito</ns0:quote>
          <ns0:quote>sin rumbo</ns0:quote>
          <ns0:quote>sin rumbo fijo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without an aim, purpose or direction; in an aimless manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aioli</ns0:orth>
        <ns0:pron>/(ˌ)aɪˈoʊli/</ns0:pron>
        <ns0:pron>/(ˌ)eɪˈoʊ-/</ns0:pron>
        <ns0:pron>/aɪˈəʊlɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ajiaceite</ns0:quote>
          <ns0:quote>alioli</ns0:quote>
          <ns0:quote>ajoaceite</ns0:quote>
          <ns0:quote>ajolio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of sauce made from garlic and olive oil, often with egg and lemon juice and similar to mayonnaise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air</ns0:orth>
        <ns0:pron>/eə/</ns0:pron>
        <ns0:pron>/eɹ/</ns0:pron>
        <ns0:pron>/eː/</ns0:pron>
        <ns0:pron>/iə/</ns0:pron>
        <ns0:pron>/ɛə/</ns0:pron>
        <ns0:pron>/ɛɹ/</ns0:pron>
        <ns0:pron>/ɜː(ɹ)/</ns0:pron>
        <ns0:pron>[ɛɚ]</ns0:pron>
        <ns0:pron>[ɛː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, philosophy, alchemy) One of the four elements of the ancient Greeks and Romans.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, loosely) The substance of the atmosphere on a planet other than Earth.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, usually, with the) The apparently open space above the ground which this substance fills, (historical) formerly thought to be limited by the firmament but (meteorology) now considered to be surrounded by the near-vacuum of outer space.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aria</ns0:quote>
          <ns0:quote>aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A melody or song, especially a solo; an aria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ningún objecto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Nothing; absence of anything.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air</ns0:orth>
        <ns0:pron>/eə/</ns0:pron>
        <ns0:pron>/eɹ/</ns0:pron>
        <ns0:pron>/eː/</ns0:pron>
        <ns0:pron>/iə/</ns0:pron>
        <ns0:pron>/ɛə/</ns0:pron>
        <ns0:pron>/ɛɹ/</ns0:pron>
        <ns0:pron>/ɜː(ɹ)/</ns0:pron>
        <ns0:pron>[ɛɚ]</ns0:pron>
        <ns0:pron>[ɛː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>airear</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventilar</ns0:quote>
          <ns0:quote>ventear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To let fresh air into (a room or a building), to ventilate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retransmitir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To be broadcast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air base</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base aérea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) A military airport, providing housing and support for aircraft and personnel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air bed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colchoneta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bed that is inflated with air; typically used as a portable, temporary bed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air compressor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compresor</ns0:quote>
          <ns0:quote>compresor de aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A machine for generating compressed air, typically for use by air-powered tools or paint sprayers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air conditioner</ns0:orth>
        <ns0:pron>/ˈɛə kənˌdɪʃn̩ə/</ns0:pron>
        <ns0:pron>/ˈɛɹ kənˌdɪʃ(ə)nɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>climatizador</ns0:quote>
          <ns0:quote>aire acondicionado</ns0:quote>
          <ns0:quote>acondicionador de aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A machine that is used to control temperature and humidity in an enclosed space.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air conditioning</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aire acondicionado</ns0:quote>
          <ns0:quote>climatización</ns0:quote>
          <ns0:quote>acondicionamiento aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of temperature and humidity produced by an air conditioner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>climatización</ns0:quote>
          <ns0:quote>aire acondicionado</ns0:quote>
          <ns0:quote>climatizador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An air conditioner or system of air conditioners.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air defense</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>defensa antiaérea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, weaponry) The use of systems, equipment, and personnel to prevent or reduce the impact of an attack by enemy aircraft or missiles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air force</ns0:orth>
        <ns0:pron>/ˈɛə(ɹ) ˌfɔː(ɹ)s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuerza aérea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A branch of the military mainly devoted to air warfare, as opposed to (land) army and (sea) navy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air freshener</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambientador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of many forms of device containing substances that neutralize or mask unpleasant odours.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air fryer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>freidora de aire</ns0:quote>
          <ns0:quote>freidora aérea</ns0:quote>
          <ns0:quote>freidora neumática</ns0:quote>
          <ns0:quote>freidora sin aceite</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small countertop convection oven.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air hole</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espiráculo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hole in any surface that allows air or other gases to pass, especially an opening in the surface of a frozen lake etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corriente</ns0:quote>
          <ns0:quote>descendente</ns0:quote>
          <ns0:quote>región</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An air pocket.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respiradero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The blowhole of a whale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air one's dirty laundry in public</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sacar los trapitos al sol</ns0:quote>
          <ns0:quote>sacar los trapos sucios a la colada</ns0:quote>
          <ns0:quote>sacar todos los trapos a relucir</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>airear</ns0:quote>
          <ns0:quote>ventear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To expose to air; to leave open or spread out, as to allow odor or moisture to dissipate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air pistol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pistola de aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pistol that propels a pellet or other projectile by using compressed gas, rather than an explosion of gunpowder or other means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air pocket</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>(región de) corriente descendente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A local region of low atmospheric pressure, or a local downward current; especially one that causes an aircraft to lose height suddenly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air pollution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contaminación ambiente</ns0:quote>
          <ns0:quote>contaminación atmosférica</ns0:quote>
          <ns0:quote>polución del aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The contamination of the atmosphere by noxious gases and particulates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air pump</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bomba de aire</ns0:quote>
          <ns0:quote>hinchador</ns0:quote>
          <ns0:quote>inflador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pump that moves air either into or out of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air purifier</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>exhaustor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device used to remove contaminants from the air.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air quote</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comillas aéreas</ns0:quote>
          <ns0:quote>comillas dactilares</ns0:quote>
          <ns0:quote>entre comillas</ns0:quote>
          <ns0:quote>entre comillas con los dedos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A typically two-handed gesture resembling quotation marks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air rifle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rifle de aire</ns0:quote>
          <ns0:quote>rifle pneumático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rifle that propels a pellet or other projectile by using compressed gas, rather than an explosion of gunpowder or other means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air supremacy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>superioridad aérea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a war, the most favorable state of control of the air: air superiority so complete that the opposing air force is incapable of effective interference.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air ticket</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasaje de avión</ns0:quote>
          <ns0:quote>pasaje de vuelo</ns0:quote>
          <ns0:quote>pasaje aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A document issued at time of payment for an airfare, entitling the holder to travel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air traffic control</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>control de tráfico aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A system designed to give assistance to aircraft, to prevent collisions and to manage aircraft flow.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air traffic controller</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>controlador de tráfico aéreo</ns0:quote>
          <ns0:quote>controlador de tránsito aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who operates an air traffic control system, to expedite the safe flow of aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air transport</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>transporte aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The transport of people and/or cargo by air</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air vent</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bufarda</ns0:quote>
          <ns0:quote>ducto</ns0:quote>
          <ns0:quote>orificio</ns0:quote>
          <ns0:quote>rejilla</ns0:quote>
          <ns0:quote>rejilla de ventilación</ns0:quote>
          <ns0:quote>rejilla ventiladora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An opening, possibly covered by a grate or grill, possibly ducted, that allows air to circulate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>purgador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device or valve that allows to air to be evacuated from a radiator or pipe in a heating system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air-condition</ns0:orth>
        <ns0:pron>/ˈɛə kənˌdɪʃn̩/</ns0:pron>
        <ns0:pron>/ˈɛɹ kənˌdɪʃ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>climatizar</ns0:quote>
          <ns0:quote>condicionar con el aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To mechanically cool a space or an entire structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air-dry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>seco al aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That is free of moisture to the degree possible by exposure to; naturally dried.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>air-raid shelter</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>refugio antiaéreo</ns0:quote>
          <ns0:quote>refugio antibombas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A structure, often a reinforced underground shelter designed to give protection against air raids.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airan</ns0:orth>
        <ns0:pron>/ˈaɪ.ɹɑn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ayran</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Turkish cold drink made from yoghurt and water with salt and sometimes herbs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airbag</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>airbag</ns0:quote>
          <ns0:quote>bolsa de aire</ns0:quote>
          <ns0:quote>bolsa aérea</ns0:quote>
          <ns0:quote>bolsa neumática</ns0:quote>
          <ns0:quote>erbag</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(automotive) A protective system in automobiles in which when a crash occurs, a bag containing nitrogen, formed by the explosive decomposition of sodium azide, quickly inflates in front of the driver or passenger, preventing injury to the head. Side air bags, including the back seat passengers, also prevent injury.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airboat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hidrodeslizador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A flat-bottomed boat driven by an in-air propeller and used in shallow water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airborne</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerotransportado</ns0:quote>
          <ns0:quote>transportado por el aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In or carried by the air.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>volando</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In flight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airbridge</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puente aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The route and aircraft used to deliver material by an airlift.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airbrush</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerógrafo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A miniature, handheld paint sprayer, powered by compressed air or other gas, used for delicate, artistic painting, or sometimes retouching of photographs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airbus</ns0:orth>
        <ns0:pron>/ˈeɹ.bʌs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerobús</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A subsonic jet airliner, especially a wide-bodied one.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aircraft</ns0:orth>
        <ns0:pron>/ˈɛə.kɹɑːft/</ns0:pron>
        <ns0:pron>/ˈɛəɹ.kɹæft/</ns0:pron>
        <ns0:pron>/ˈɛː.kɹɑːft/</ns0:pron>
        <ns0:pron>/ˈɛːɹ.kɹæft/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeronave</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A vehicle capable of atmospheric flight due to interaction with the air, such as buoyancy or lift.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aircraft carrier</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>portaaviones</ns0:quote>
          <ns0:quote>portaviones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A warship designed to carry aircraft, serving as a seagoing air base, with a deck on which aircraft can be launched and landed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airdrop</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entrega aérea</ns0:quote>
          <ns0:quote>entrega por paracaídas</ns0:quote>
          <ns0:quote>lanzamiento aéreo</ns0:quote>
          <ns0:quote>lanzamiento en paracaídas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of delivering goods, equipment, or personnel by dropping them from an aircraft in flight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airfield</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeródromo</ns0:quote>
          <ns0:quote>aeroparque</ns0:quote>
          <ns0:quote>campo de aviación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) An open field designated for the taking off and landing of aircraft, but which, unlike an airport, does not necessarily have terminals or paved runways.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airfoil</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perfil</ns0:quote>
          <ns0:quote>perfil aerodinámico</ns0:quote>
          <ns0:quote>perfil alar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A structure shaped to produce lift when moving in air.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airhead</ns0:orth>
        <ns0:pron>/ˈɛɹˌ(h)ɛd/</ns0:pron>
        <ns0:pron>/ˈɛːhɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cabeza de chorlito</ns0:quote>
          <ns0:quote>burro</ns0:quote>
          <ns0:quote>cabeza hueca</ns0:quote>
          <ns0:quote>chorlito</ns0:quote>
          <ns0:quote>estúpido</ns0:quote>
          <ns0:quote>tontón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(originally, US, informal, derogatory) A foolish, silly, or unintelligent person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airlift</ns0:orth>
        <ns0:pron>/ˈɛə.lɪft/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puente aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The transportation of troops, civilians or supplies by air, especially in an emergency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airline</ns0:orth>
        <ns0:pron>/ˈɛəˌlaɪn/</ns0:pron>
        <ns0:pron>/ˈɛɹˌlaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerolínea</ns0:quote>
          <ns0:quote>compañía aérea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A company that flies airplanes to transport people and goods.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airliner</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avión de pasajeros</ns0:quote>
          <ns0:quote>avión de línea</ns0:quote>
          <ns0:quote>aerobús</ns0:quote>
          <ns0:quote>avión lineal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A passenger-carrying aircraft, especially one of a fleet operated by an airline.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airmail</ns0:orth>
        <ns0:pron>/ˈɛə.meɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>correo aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The system of conveying mail using aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airman</ns0:orth>
        <ns0:pron>/ˈɛə.mən/</ns0:pron>
        <ns0:pron>/ˈɛɹ.mən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviador</ns0:quote>
          <ns0:quote>aviadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pilot of an aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airmass</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>masa de aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, meteorology) a widespread body of air, the properties of which can be identified as: (a) having been established while that air was situated over a particular region of the Earth's surface (airmass source region) and (b) undergoing specific modifications while in transit away from the source region. An air mass is often defined as a widespread body of air that is approximately homogeneous in its horizontal extent, particularly with reference to temperature and moisture distribution; in addition, the vertical temperature and moisture variations are approximately the same over its horizontal extent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airplane</ns0:orth>
        <ns0:pron>/ˈɛəˌpleɪ̯n/</ns0:pron>
        <ns0:pron>/ˈɛɹˌpleɪ̯n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avión</ns0:quote>
          <ns0:quote>aeroplano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US, Canada, Philippines) A powered heavier-than-air aircraft with fixed wings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airplane mode</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>modo avión</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airport</ns0:orth>
        <ns0:pron>/ˈa(r).po(r)ʈ/</ns0:pron>
        <ns0:pron>/ˈɛə.pɔːt/</ns0:pron>
        <ns0:pron>/ˈɛɹ.pɔɹt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeropuerto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An airfield (an area designated for the takeoff and landing of aircraft), including one or more runways and (for commercial airports) one or more passenger terminals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airscrew</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hélice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The propeller of an aircraft; the prop.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airshaft</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conducto de ventilación</ns0:quote>
          <ns0:quote>foso de ventilación</ns0:quote>
          <ns0:quote>pozo de ventilación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A vertical (or near vertical) opening (shaft) running from a courtyard to the sky, thus allowing air to circulate to high-rise apartments or offices.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airspace</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espacio aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, aviation) A specified portion of the atmosphere, especially that under the technical aviation control and/or jurisdiction of a particular state over which territory (and territorial waters) it lies.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(aviation) that part of the sky designated for the sole use of aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airstrip</ns0:orth>
        <ns0:pron>/ˈɛə(ɹ)stɹɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pista de aterrizaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An aircraft landing field, usually with one runway and only basic facilities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airtight</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hermético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Impermeable to air or other gases.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>airtime</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tiempo en antena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The duration during which a radio or television program (or part of one) is transmitted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tiempo aire</ns0:quote>
          <ns0:quote>tiempo facturable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The chargeable use of a mobile phone, either in minutes or in units dependent on the use or traffic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
