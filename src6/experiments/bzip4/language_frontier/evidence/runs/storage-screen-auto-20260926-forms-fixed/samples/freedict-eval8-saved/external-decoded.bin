        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>península de Chukchi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula in northeastern Russia, bordered by the Chukchi Sea to the north, the Bering Sea to the south, and the Bering Strait to the east; part of the Chukotka Autonomous Okrug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
