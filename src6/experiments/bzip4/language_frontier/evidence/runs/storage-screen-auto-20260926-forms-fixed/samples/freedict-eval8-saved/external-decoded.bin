      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indonesio</ns0:quote>
          <ns0:quote>indonesia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A person living in or coming from Indonesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indonesio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The common language spoken in Indonesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indra</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
