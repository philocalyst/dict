    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nigerian scam</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estafa nigeriana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet) An attempt to defraud by sending out large numbers of emails, each stating that the recipient is entitled to receive a large amount of money, but will need to supply banking account details, or to send payment for fees, before the payment can be passed on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
