        <ns0:pron>[ˈɪʔ.li]</ns0:pron>
        <ns0:pron>[ˈɪʔəli]</ns0:pron>
        <ns0:pron>[ˈɪθ̠əli]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
