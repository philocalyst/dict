        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acíclico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry, physical chemistry) Not cyclic; having an open chain structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
