      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arquitectónico</ns0:quote>
          <ns0:quote>arquitectural</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to architecture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>architecture</ns0:orth>
        <ns0:pron>/ˈɑɹ.kɪˌtɛk.t͡ʃɚ/</ns0:pron>
