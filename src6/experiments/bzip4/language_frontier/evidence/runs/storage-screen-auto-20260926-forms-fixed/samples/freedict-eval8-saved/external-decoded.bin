        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Federal Democrática de Nepal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Nepal: a country in South Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Federal District</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Distrito Federal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An administrative division of Brazil; located in the Center West Region of Brazil and containing the country's capital Brasilia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Federal Republic of Germany</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Federal de Alemania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(1990–today) Official name of Germany: a country in Central Europe, reunified with the former East Germany.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Federal Republic of Nigeria</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Federal de Nigeria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Nigeria: a country in West Africa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Federative Republic of Brazil</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Federativa del Brasil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Brazil: a country in South America.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fediverse</ns0:orth>
        <ns0:pron>/ˈfe.dəˌvøːs/</ns0:pron>
        <ns0:pron>/ˈfɛ.dɪˌvɜɹs/</ns0:pron>
        <ns0:pron>/ˈfɛ.dɪˌvɜːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
