      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Atlántico Norte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The portion of the Atlantic Ocean that lies primarily between North America and the northeast coast of South America to the east, and Europe and the northwest coast of Africa to the west.</ns0:def>
