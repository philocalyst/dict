    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hebrew</ns0:orth>
        <ns0:pron>/ˈhiːbɹuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hebreo</ns0:quote>
          <ns0:quote>hebrea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A member or descendant of a Semitic people claiming descent from Abraham, Isaac, and Jacob.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A descendant of the biblical Patriarch Eber.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The Semitic language spoken by the Hebrew people.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The writing system used in Hebrew language.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, colloquial) Unintelligible speech or writing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hebrew Bible</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Biblia hebrea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Abrahamism) The sacred texts of Judaism, consisting of the Law (Torah), the Prophets, and the Hagiographa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hebrews</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hebreos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) The nineteenth book of the New Testament of the Bible, the epistle to the Hebrews.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hebrides</ns0:orth>
        <ns0:pron>/ˈhɛbɹədiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hébridas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The islands off the west coast of Scotland, divided into the Inner Hebrides and the Outer Hebrides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hebron</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hebrón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A minor city in Morton County, North Dakota; named for the city in Palestine.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An unincorporated community in Pleasants County, West Virginia; named for the city in Palestine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hecate</ns0:orth>
        <ns0:pron>/ˈhɛkəti/</ns0:pron>
        <ns0:pron>/ˈhɛkɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hécate</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A powerful goddess of magic, crossroads, fire, light, the moon, and the underworld. Her Roman counterpart is Trivia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hecatoncheires</ns0:orth>
        <ns0:pron>/ˌhɛkətɒŋˈkaɪɹiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hecatónquiros</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) Three monstrous giants of enormous size and strength, each with fifty heads and one hundred arms, who were offspring of Uranus by Gaia, whom Zeus freed from captivity and who in return aided the Olympians in the Titanomachy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hector</ns0:orth>
        <ns0:pron>/ˈhɛktə/</ns0:pron>
        <ns0:pron>/ˈhɛktɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Héctor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology, Roman mythology) A Trojan hero in Homer's Iliad.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hecuba</ns0:orth>
        <ns0:pron>/ˈhɛkjʊbə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hécuba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) the wife of King Priam of Troy, the mother of Hector, Paris and Cassandra</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hedwig</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eduvigis</ns0:quote>
          <ns0:quote>Eduviges</ns0:quote>
          <ns0:quote>Heduviges</ns0:quote>
          <ns0:quote>Heduvigis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hegel</ns0:orth>
        <ns0:pron>/ˈheɪɡəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hegel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from German, notably borne by the German philosopher Georg Wilhelm Friedrich Hegel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hegelian</ns0:orth>
        <ns0:pron>/heɪˈɡeɪlɪən/</ns0:pron>
        <ns0:pron>/heɪˈɡiːlɪən/</ns0:pron>
        <ns0:pron>/həˈɡeɪli.ən/</ns0:pron>
        <ns0:pron>/hɪˈɡiːlɪən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hegeliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy) Of or pertaining to the philosophical system of Georg Wilhelm Friedrich Hegel (1770–1831).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Heideggerian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>heideggeriano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to German philosopher Martin Heidegger (1889-1976) or his works.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Heidelberg</ns0:orth>
        <ns0:pron>/ˈhaɪdəlbɜːɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Heidelberg</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and urban district of Baden-Württemberg, Germany; the administrative seat of Rhein-Neckar-Kreis district, Baden-Württemberg.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Heimlich maneuver</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maniobra de Heimlich</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(emergency medicine) A first aid procedure used to treat choking. The patient is lifted from behind, squeezing their diaphragm to expel air and thereby dislodging an obstruction in the windpipe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Heisenberg uncertainty principle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principio de indeterminación de Heisenberg</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, quantum mechanics) The principle that there is an absolute limit on the combined accuracy of certain pairs of simultaneous, related measurements, especially that of the position and momentum of a particle. Originally posited as a problem of measurement, it was soon refined as an inherent property of the universe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hejaz</ns0:orth>
        <ns0:pron>/hɪˈdʒɑːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hiyaz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mountainous geographic area in northwest Saudi Arabia which gave rise to early Islam and which contains the sites of many holy places.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion, Norse mythology) The goddess of the realm of the unheroic dead, a daughter of Loki by the jotun Angrboða.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Helen</ns0:orth>
        <ns0:pron>/ˈhɛlən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Helena</ns0:quote>
          <ns0:quote>Elena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The daughter of Zeus and Leda, considered to be the most beautiful woman in the world; her abduction by Paris brought about the Trojan War.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Elena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Heliogabalus</ns0:orth>
        <ns0:pron>/ˌhiː.li.oʊˈɡæb.ə.ləs/</ns0:pron>
        <ns0:pron>/ˌhiː.li.əʊˈɡæb.ə.ləs/</ns0:pron>
        <ns0:pron>/ˌhiː.li.əˈɡæb.ə.ləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Heliogábalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Synonym of Elagabalus (“Roman emperor, noted for decadence, eccentricity, femininity, and disregard for Roman religious traditions and sexual taboos”).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Helios</ns0:orth>
        <ns0:pron>/ˈhiːliɒs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Helios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The god of the Sun; son of Hyperion and Theia, brother of Selene and Eos, father of Phaeton amongst others. His Roman counterpart is Sol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Helle</ns0:orth>
        <ns0:pron>/ˈhɛli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hele</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A daughter of king Athamas, who, together with her brother Phrixus, fled from their stepmother Ino to Colchis on a golden ram. On their way, she fell from its back and was drowned in the strait called, after her, Hellespont.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellen</ns0:orth>
        <ns0:pron>/ˈhɛlən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Heleno</ns0:quote>
          <ns0:quote>Helén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) the mythological patriarch of the Hellenes, the son of Deucalion (or sometimes Zeus) and Pyrrha, brother of Amphictyon and father of Aeolus, Xuthus, and Dorus</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellenic</ns0:orth>
        <ns0:pron>/həˈlɛnɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>helénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the ancient Greek culture and civilization before the Hellenistic period.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or relating to Hellas (Greece) or the Hellenes (Greeks).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellenic Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Helénica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Greece: a country in Southeast Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellenisation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>helenización</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellenism</ns0:orth>
        <ns0:pron>/ˈhɛlənɪzm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>helenismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the characteristics of ancient Greek culture, civilization, principles and ideals, including humanism, reason, the pursuit of knowledge and the arts, moderation and civic responsibility.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The admiration for and adoption of ancient Greek culture, ideas and civilization.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellenist</ns0:orth>
        <ns0:pron>/ˈhɛl.ə.nɪst/</ns0:pron>
        <ns0:pron>/ˈhɛl.ɪ.nɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>helenista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A specialist in the study of Greek language, literature, culture, or history, or an admirer of the Greek culture and civilization.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person who adopted the Greek customs, language and culture during the Hellenistic period, especially a Hellenized Jew.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hellenistic</ns0:orth>
        <ns0:pron>/ˌheləˈnɪstɪk/</ns0:pron>
        <ns0:pron>/ˌhɛləˈnɪstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>helenístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the period of the Greek culture, history, or art after the death of Alexander the Great (323 B.C.) to the defeat of Cleopatra and Mark Antony by Octavian (31 B.C.) – though this end-point is often debated, and can range from 146BC to 330AD [*].</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or relating to a Hellenist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
