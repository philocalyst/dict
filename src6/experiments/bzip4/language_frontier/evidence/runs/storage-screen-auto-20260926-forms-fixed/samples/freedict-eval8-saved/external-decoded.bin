        <ns0:pron>/ˌlænzəˈrɒti/</ns0:pron>
        <ns0:pron>/ˌlɑnzəˈroʊteɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lanzarote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island of the Canary Islands, with capital Arrecife.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lao</ns0:orth>
        <ns0:pron>/laʊ/</ns0:pron>
