        <ns0:pron>/ˌæbˌnɚˈmæl.ət.i/</ns0:pron>
        <ns0:pron>/ˌæbˌnɚˈmæl.ɪt.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anormalidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being abnormal; variation; irregularity. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
