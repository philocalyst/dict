    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beleaguer</ns0:orth>
        <ns0:pron>/bəˈliː.ɡə/</ns0:pron>
        <ns0:pron>/bɪˈli.ɡɚ/</ns0:pron>
        <ns0:pron>/bɪˈliː.ɡə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asediar</ns0:quote>
          <ns0:quote>sitiar</ns0:quote>
          <ns0:quote>cercar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To besiege; to surround with troops.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hostigar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To vex, harass, or beset.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beleaguered</ns0:orth>
        <ns0:pron>/bɪˈliːɡəd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asediado</ns0:quote>
          <ns0:quote>sitiado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Besieged; surrounded by enemy troops.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuciado</ns0:quote>
          <ns0:quote>hostigado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) Beset by trouble or difficulty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belfry</ns0:orth>
        <ns0:pron>/ˈbɛlfɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campanario</ns0:quote>
          <ns0:quote>campanil</ns0:quote>
          <ns0:quote>clochel</ns0:quote>
          <ns0:quote>espadaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A tower or steeple typically containing bells, especially as part of a church.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architecture) A part of a large tower or steeple, specifically for containing bells.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belie</ns0:orth>
        <ns0:pron>/biˈlaɪ/</ns0:pron>
        <ns0:pron>/bəˈlaɪ/</ns0:pron>
        <ns0:pron>/bɪˈlaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calumniar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To tell lies about. [from 13th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, rare) To fill with lies; to lie to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malrepresentar</ns0:quote>
          <ns0:quote>representar mal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give a false representation of. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desmentir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To contradict, to show (something) to be false. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belief</ns0:orth>
        <ns0:pron>/bəˈliːf/</ns0:pron>
        <ns0:pron>/bɪˈliːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Mental acceptance of a claim as true.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Something believed.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The quality or state of believing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(in the plural) One's religious or moral convictions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creencia</ns0:quote>
          <ns0:quote>fe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Religious faith.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believability</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>credibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being believable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believable</ns0:orth>
        <ns0:pron>/bɪˈliːvəbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creíble</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being believed; credible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believably</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creíblemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a believable way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believe</ns0:orth>
        <ns0:pron>/bi-/</ns0:pron>
        <ns0:pron>/bə-/</ns0:pron>
        <ns0:pron>/bɪˈliv/</ns0:pron>
        <ns0:pron>/bɪˈliːv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To accept as true, particularly without absolute certainty (i.e., as opposed to knowing).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To accept that someone is telling the truth.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To ascribe existence to.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To believe that (something) is right or desirable.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To have confidence in the ability or power of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creer</ns0:quote>
          <ns0:quote>tener fe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To have religious faith; to believe in a greater truth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believe it or not</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aunque usted no lo crea</ns0:quote>
          <ns0:quote>lo creas o no</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) This may be surprising, but it's true.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believe one's ears</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dar crédito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom, chiefly in the negative) To believe that something which one hears is truly the case.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believe one's eyes</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dar crédito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom, chiefly in the negative) To believe that something which one directly sees is truly the case.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>believer</ns0:orth>
        <ns0:pron>/bɪˈlivɚ/</ns0:pron>
        <ns0:pron>/bɪˈliːvə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creyente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who believes; especially regarding religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belittle</ns0:orth>
        <ns0:pron>/bɪˈlɪt.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disminuir</ns0:quote>
          <ns0:quote>empequeñecer</ns0:quote>
          <ns0:quote>menospreciar</ns0:quote>
          <ns0:quote>minimizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To knowingly say that something is smaller or less important than it actually is, especially as a way of showing contempt or deprecation. [from 1782]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell</ns0:orth>
        <ns0:pron>/bɛl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campana</ns0:quote>
          <ns0:quote>campanilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(percussion instrument) A percussive instrument made of metal or other hard material, typically but not always in the shape of an inverted cup with a flared rim, which resonates when struck.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pabellón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The flared end of a brass or woodwind instrument.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architecture) The part of the capital of a column included between the abacus and neck molding; also used for the naked core of nearly cylindrical shape, assumed to exist within the leafage of a capital.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell curve</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campana de Gauss</ns0:quote>
          <ns0:quote>curva de campana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(probability theory) The bell-shaped curve that is typical of the normal distribution. [from 1919]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell pepper</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pimiento</ns0:quote>
          <ns0:quote>morrón</ns0:quote>
          <ns0:quote>pimentón</ns0:quote>
          <ns0:quote>ají dulce</ns0:quote>
          <ns0:quote>chiltoma</ns0:quote>
          <ns0:quote>locote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(North America, Philippines) Any of several bell-shaped varieties of Capsicum annuum, an edible, sweet, generally mild (not spicy) fruit, originating in the New World.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell ringer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campanero</ns0:quote>
          <ns0:quote>campanera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person, especially one of a group, who rings bells.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell the cat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ponerle el cascabel al gato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To undertake a dangerous action in the service of a group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell tower</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campanario</ns0:quote>
          <ns0:quote>campanil</ns0:quote>
          <ns0:quote>clochel</ns0:quote>
          <ns0:quote>espadaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tower in which a bell (or set of bells) is hung; a belfry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell-bottomed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acampanado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to a style of pants in which the end of each pantleg flares out dramatically from the knee downward, like the mouth of a bell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell-bottoms</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pantalones acampanados</ns0:quote>
          <ns0:quote>pantalones de campana</ns0:quote>
          <ns0:quote>pantalones de pata de elefante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(plurale tantum) Pants that are flared from the knee downwards, a characteristic style of the 1970s.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell-end</ns0:orth>
        <ns0:pron>/ˈbɛlɛnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>capullo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK, Ireland, , slang, vulgar) The glans penis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bell-gable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espadaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) An element crowning the upper end of the wall of a church and in which a bell is hung, usually in lieu of a campanile or bell tower.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellboy</ns0:orth>
        <ns0:pron>/ˈbɛlˌbɔɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>botones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A male worker, usually at a hotel, who carries luggage and runs errands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellflower</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campanilla</ns0:quote>
          <ns0:quote>campánula</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any flowering plants in the genus Campanula.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Flowering plants in the genera, Campanulastrum, Codonopsis, or Platycodon, in the family Campanulaceae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellgirl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>botones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A female bellhop.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellicism</ns0:orth>
        <ns0:pron>/ˈbɛlɪsɪzm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>belicismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An inclination to war; warlike policy or behaviour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellicose</ns0:orth>
        <ns0:pron>/ˈbɛləkoʊs/</ns0:pron>
        <ns0:pron>/ˈbɛlɪkoʊs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>belicoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Warlike in nature; aggressive; hostile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellicosity</ns0:orth>
        <ns0:pron>/ˌbɛlɪˈkɒsəti/</ns0:pron>
        <ns0:pron>/ˌbɛlɪˈkɒsɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>belicosidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The characteristic of being bellicose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belligerence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beligerancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being belligerent; aggressive inclination to war. [1804]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belligerent</ns0:orth>
        <ns0:pron>/bəˈlɪdʒ.(ə).ɹənt/</ns0:pron>
        <ns0:pron>/bəˈlɪd͡ʒ.ə.ɹənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beligerante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Engaged in warfare, warring.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bélico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Eager to go to war, warlike.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or pertaining to war.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batallaroso</ns0:quote>
          <ns0:quote>belicoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) Aggressively hostile, eager to fight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belligerent</ns0:orth>
        <ns0:pron>/bəˈlɪdʒ.(ə).ɹənt/</ns0:pron>
        <ns0:pron>/bəˈlɪd͡ʒ.ə.ɹənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beligerante</ns0:quote>
          <ns0:quote>partes beligerantes</ns0:quote>
          <ns0:quote>partes enfrentadas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state or other armed participant in warfare</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellow</ns0:orth>
        <ns0:pron>/ˈbɛloʊ/</ns0:pron>
        <ns0:pron>/ˈbɛləʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>berrido</ns0:quote>
          <ns0:quote>bramido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The deep roar of a large animal, or any similar loud noise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellow</ns0:orth>
        <ns0:pron>/ˈbɛloʊ/</ns0:pron>
        <ns0:pron>/ˈbɛləʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>berrear</ns0:quote>
          <ns0:quote>bramar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make a loud, deep, hollow noise like the roar of an angry bull.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bramar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To shout in a deep voice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellows</ns0:orth>
        <ns0:pron>/ˈbɛl.oʊz/</ns0:pron>
        <ns0:pron>/ˈbɛl.əs/</ns0:pron>
        <ns0:pron>/ˈbɛl.əʊz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuelle</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device for delivering pressurized air in a controlled quantity to a controlled location. At its most simple terms a bellows is a container which is deformable in such a way as to alter its volume which has an outlet or outlets where one wishes to blow air.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bells and whistles</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ful equipo</ns0:quote>
          <ns0:quote>ful extras</ns0:quote>
          <ns0:quote>lujos y accesorios</ns0:quote>
          <ns0:quote>ringorrangos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Extra features added for show rather than function; fancy additions or features.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bellwether</ns0:orth>
        <ns0:pron>/ˈbɛlwɛðə/</ns0:pron>
        <ns0:pron>/ˈbɛlwɛðɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
