    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assimilate</ns0:orth>
        <ns0:pron>/əˈsɪm.ɪ.leɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asimilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To incorporate nutrients into the body, especially after digestion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To absorb (a person or people) into a community or culture.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, rare, used with "to" or "with") To liken, compare to something similar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
