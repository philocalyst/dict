        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calendario juliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The calendar which was used in the western world before the present-day Gregorian calendar. The Julian calendar differed in having all multiple-of-4 years as leap years.</ns0:def>
