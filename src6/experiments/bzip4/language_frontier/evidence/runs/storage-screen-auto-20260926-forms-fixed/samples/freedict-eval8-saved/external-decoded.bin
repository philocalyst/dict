    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>OK</ns0:orth>
        <ns0:pron>/əˈkeɪ/</ns0:pron>
        <ns0:pron>/ˌoʊˈkeɪ/</ns0:pron>
        <ns0:pron>/ˌəʊˈkeɪ/</ns0:pron>
      </ns0:form>
