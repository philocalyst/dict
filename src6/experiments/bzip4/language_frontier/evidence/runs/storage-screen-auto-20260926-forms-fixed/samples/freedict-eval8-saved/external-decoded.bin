    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hubble constant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley de Hubble</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A number that expresses the rate of expansion of the universe; the velocity at which a distant object is receding from the Earth divided by its distance; its reciprocal determines the age of the universe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
