          <ns0:quote>calvorota</ns0:quote>
          <ns0:quote>pelado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person with little or no head hair. (This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
