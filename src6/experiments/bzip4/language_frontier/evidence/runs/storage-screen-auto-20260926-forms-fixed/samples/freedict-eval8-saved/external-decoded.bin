          <ns0:def>A municipality in the comarca of Vallès Oriental, Barcelona, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marx</ns0:orth>
        <ns0:pron>/mɑɹks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Marx</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from German</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or influenced by the 19th-century philosopher Karl Marx and his political and economic theories; now often distinguished from Marxist by the nuance that one does not necessarily adhere to Marxism itself. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxism</ns0:orth>
        <ns0:pron>/ˈmɑɹksɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The socialist and communist philosophy and political program founded by Karl Marx and Friedrich Engels.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(primarily, _, Western, often, _, derogatory, colloquial) Any left-wing ideology, government regulations, or policies promoting a welfare state, nationalisation, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxism-Leninism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxismo-leninismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, communism) A communist ideological stream that emerged as the mainstream tendency amongst the Communist parties in the 1920s as it was adopted as the ideological foundation of the Communist International during Stalin's era, and was later adopted by the People's Republic of China, Cuba, Vietnam, and several other nations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxism-Leninism-Maoism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxismo-leninismo-maoísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, communism) A communist ideological stream which seeks to synthesize Marxism-Leninism and Maoism and which proponents believe is the highest stage of Marxism. It was systematized by the Communist Party of Peru (Shining Path) and developed by the Revolutionary Internationalist Movement and its adherent parties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxist</ns0:orth>
        <ns0:pron>/ˈmɑːksɪst/</ns0:pron>
        <ns0:pron>/ˈmɑːɹksɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Following the ideals of Marxism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxist</ns0:orth>
        <ns0:pron>/ˈmɑːksɪst/</ns0:pron>
        <ns0:pron>/ˈmɑːɹksɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One that believes in or follows the ideals of Marxism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxist-Leninist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marxista-leninista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Marxism-Leninism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Marxist-Leninist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
