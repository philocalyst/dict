        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eurasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest and most populous landmass on Earth, a supercontinent consisting of Europe and Asia; sometimes also including neighboring islands. [1881]</ns0:def>
