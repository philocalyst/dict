        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticapitalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
