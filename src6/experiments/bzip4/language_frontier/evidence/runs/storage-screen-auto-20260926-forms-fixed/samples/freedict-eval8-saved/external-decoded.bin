        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town and rural district of Baden-Württemberg.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lughnasadh</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>festival de las primeras frutas</ns0:quote>
          <ns0:quote>lúnasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Gaelic/Celtic holiday celebrated on the full moon nearest the midpoint between the summer solstice and autumnal equinox, during the time of the harvesting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
