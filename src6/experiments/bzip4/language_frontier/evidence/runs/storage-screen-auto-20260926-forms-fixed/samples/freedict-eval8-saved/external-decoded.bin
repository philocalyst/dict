          <ns0:quote>inmaduro</ns0:quote>
          <ns0:quote>mancebo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension, of a male) Not having reached puberty or manhood; youthful.</ns0:def>
        </ns0:sense>
