      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rematable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be or worthy of being auctioned, especially for a substantial amount of money; aesthetically pleasing or desirable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auctioneer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pregonero</ns0:quote>
          <ns0:quote>rematador</ns0:quote>
          <ns0:quote>subastador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An individual who conducts an auction on behalf of a vendor, accepting bids to find the best price for the vendor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auctioneer</ns0:orth>
