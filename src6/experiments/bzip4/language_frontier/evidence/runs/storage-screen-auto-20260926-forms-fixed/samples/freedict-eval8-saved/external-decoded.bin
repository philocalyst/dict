          <ns0:quote>Upsala</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and municipality in eastern central Sweden; the fourth largest city of the country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ural Mountains</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Urales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A range of mountains in Russia that stretch from the Arctic to the Caspian Sea; traditionally, the border between Europe and Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ural owl</ns0:orth>
      </ns0:form>
