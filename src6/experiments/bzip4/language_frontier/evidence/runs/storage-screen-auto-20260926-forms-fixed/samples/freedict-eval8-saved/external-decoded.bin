          <ns0:quote>licra</ns0:quote>
          <ns0:quote>lycra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A type of synthetic elastic fabric and fibre (spandex) used for tight-fitting garments, such as swimming costumes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
