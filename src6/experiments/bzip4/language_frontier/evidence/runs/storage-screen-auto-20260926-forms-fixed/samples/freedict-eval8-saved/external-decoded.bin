      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Francesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of France: a country in Western Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French Republican Calendar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calendario republicano francés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The republican calendar used for twelve years in revolutionary France (from late 1793 to 1805).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French Revolution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Revolución francesa</ns0:quote>
          <ns0:quote>Revolución Francesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A period in France of radical social and political upheaval which saw the country change from a monarchy (the Ancien Régime) to a republic (1789–1799).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French Southern and Antarctic Lands</ns0:orth>
