      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogacía</ns0:quote>
          <ns0:quote>jurisprudencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The office or profession of an attorney.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attract</ns0:orth>
        <ns0:pron>/əˈtɹækt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atraer</ns0:quote>
          <ns0:quote>llamar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pull toward without touching.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To draw by moral, emotional or sexual influence; to engage or fix, as the mind, attention, etc.; to invite or allure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>llamar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To incur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attract attention</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacerse notar</ns0:quote>
          <ns0:quote>llamar la atención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attraction</ns0:orth>
        <ns0:pron>/əˈtɹækʃn̩/</ns0:pron>
        <ns0:pron>[əˈtɹækʃ(ɪ̈)n]</ns0:pron>
        <ns0:pron>[əˈt͡ʃɹækʃ(ɪ̈)n]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The tendency to attract.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The feeling of being attracted (to something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attractive</ns0:orth>
        <ns0:pron>/əˈtɹæktɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atractivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing attraction; having the quality of attracting by inherent force.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having the power of charming or alluring by agreeable qualities; enticing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atractivo</ns0:quote>
          <ns0:quote>atrayente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pleasing or appealing to the senses, especially of a potential romantic partner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attractively</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hermosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an attractive manner; with the power of attracting or drawing to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attractiveness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atractividad</ns0:quote>
          <ns0:quote>atractivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The state of being attractive or engaging.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attractor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atractor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, physics) A set of points or states to which a dynamical system evolves after a long enough time. That is, points that get close enough to the attractor remain close even if slightly disturbed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attributable</ns0:orth>
        <ns0:pron>/əˈtɹɪbjuːtəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atribuible</ns0:quote>
          <ns0:quote>imputable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being attributed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attribute</ns0:orth>
        <ns0:pron>/əˈtɹɪb.(j)ət/</ns0:pron>
        <ns0:pron>/əˈtɹɪb.juːt/</ns0:pron>
        <ns0:pron>/əˈtɹɪbˌjut/</ns0:pron>
        <ns0:pron>/ˈæt.ɹɪ.bjuːt/</ns0:pron>
        <ns0:pron>/ˈæt.ɹɪˌbjut/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atributo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A characteristic or quality of a thing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) A word that qualifies a noun.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing, object-oriented programming) An option or setting belonging to some object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attribute</ns0:orth>
        <ns0:pron>/əˈtɹɪb.(j)ət/</ns0:pron>
        <ns0:pron>/əˈtɹɪb.juːt/</ns0:pron>
        <ns0:pron>/əˈtɹɪbˌjut/</ns0:pron>
        <ns0:pron>/ˈæt.ɹɪ.bjuːt/</ns0:pron>
        <ns0:pron>/ˈæt.ɹɪˌbjut/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atribuir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To associate ownership or authorship of (something) to someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attribution</ns0:orth>
        <ns0:pron>/ˌæ.tɹɪˈbju.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atribución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of attributing something.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An explicit or formal acknowledgment of ownership or authorship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attributive</ns0:orth>
        <ns0:pron>/əˈtɹɪ.bju.tɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atributivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Attributing; characterized by attributing; effecting attribution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attributive adjective</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adjetivo atributivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) An adjective that modifies the head of the noun phrase in which it occurs; an adjective that precedes the word or phrase it modifies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attrition</ns0:orth>
        <ns0:pron>/əˈtɹɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Grinding down or wearing away by friction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desgaste dental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dentistry) The wearing of teeth due to their grinding.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deserción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sciences) The loss of participants during an experiment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(theology) Imperfect contrition or remorse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attune</ns0:orth>
        <ns0:pron>/əˈt(j)un/</ns0:pron>
        <ns0:pron>/əˈtjuːn/</ns0:pron>
        <ns0:pron>/əˈt͜ʃuːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptar</ns0:quote>
          <ns0:quote>adecuar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, figurative) To bring into harmony or accord.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attuned</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afinado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a musical instrument) Tuned to the correct pitch.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>armonizado</ns0:quote>
          <ns0:quote>harmonizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Brought into harmony; harmonized.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en sintonía</ns0:quote>
          <ns0:quote>sintonizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having been changed to fit in with a particular context or to be in sync with a phenomenon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atypical</ns0:orth>
        <ns0:pron>/eɪˈtɪp.ɪ.kəl/</ns0:pron>
