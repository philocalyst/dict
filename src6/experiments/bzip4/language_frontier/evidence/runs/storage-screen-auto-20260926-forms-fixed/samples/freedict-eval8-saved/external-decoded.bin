          <ns0:quote>Día de la Madre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada) A day in honor of one's mother on the second Sunday in May in the United States and Canada.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
