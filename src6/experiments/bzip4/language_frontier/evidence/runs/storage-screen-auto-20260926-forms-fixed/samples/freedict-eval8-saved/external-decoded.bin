        <ns0:pron>/vɪˈniːʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>veneciano</ns0:quote>
          <ns0:quote>veneciana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or inhabitant of the city of Venice or surrounding province, Veneto region, northeastern Italy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venetian</ns0:orth>
        <ns0:pron>/vəˈniʃən/</ns0:pron>
        <ns0:pron>/vɪˈniːʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>véneto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
