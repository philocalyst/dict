    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Klinefelter syndrome</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>síndrome de Klinefelter</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A genetic condition in which a person is born with two X chromosomes and one Y chromosome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Klingon</ns0:orth>
        <ns0:pron>/ˈkliŋɑn/</ns0:pron>
        <ns0:pron>/ˈklɪŋɑn/</ns0:pron>
        <ns0:pron>/ˈklɪŋɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>klingon</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An artificial language created by Marc Okrand for the film Star Trek II: The Wrath of Khan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Klingonist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>klingonista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A specialist or speaker of the Klingon language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Klyazma</ns0:orth>
        <ns0:pron>/kliˈazmə/</ns0:pron>
        <ns0:pron>/ˈkljazmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Kliazma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river wholly within Russia, originating near Solnechnogorsk (Moscow Oblast) in the Moscow Uplands, whence it flows into and through Vladimir Oblast, approximately delineating its border with Ivanovo Oblast from near Repniki to near Mstyora, before returning to Vladimir’s interior, and thereafter approximately delineating its border with Nizhny Novgorod Oblast from near the point at which the river is bridged by the Volga Highway (E22) to its confluence with the Oka, whereof it forms a left tributary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Knights Templar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caballeros templarios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A chiefly military order of medieval knights that existed for nearly two centuries during the Crusades</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any of several branches of Freemasonry that claim descent from the medieval order.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Knossos</ns0:orth>
        <ns0:pron>/ˈ(k)nɔs.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>knossos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient city and archaeological site in the island of Crete, in modern Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kochi</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Kochi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city of Kōchi Prefecture, Japan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kodiak bear</ns0:orth>
        <ns0:pron>/ˈkoʊdiˌæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oso Kodiak</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest brown bear, Ursus arctos middendorffi, found on Kodiak Island off the south coast of Alaska, United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Koine</ns0:orth>
        <ns0:pron>/kɔɪˈneɪ/</ns0:pron>
        <ns0:pron>/ˈkɔɪneɪ/</ns0:pron>
        <ns0:pron>/ˈkɔɪniː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>koiné</ns0:quote>
          <ns0:quote>coiné</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The “common” Greek language that developed and flourished between 300 B.C.E. and 300 C.E. (the time of the Roman Empire), and from which Modern Greek descended. It was based on the Attic and Ionian dialects of Ancient Greek.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kokrajhar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Kokrajhar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town in Assam, India.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A district of Assam, India.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kolkata</ns0:orth>
        <ns0:pron>/-ʈa/&lt;q:spelling pronunciation&gt;</ns0:pron>
        <ns0:pron>/kolˈkaːt̪a/</ns0:pron>
        <ns0:pron>/kolˈkɑtə/</ns0:pron>
        <ns0:pron>/kɒlˈkɑːtə/</ns0:pron>
        <ns0:pron>/kɔːlˈkɑːtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Calcuta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city of West Bengal, India, formerly known in English as Calcutta.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kolmogorov space</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espacio de Kolmogórov</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(topology) A topological space for which any pair of distinct points are also topologically distinct, i.e., there is an open set which contains one of the points but not the other one.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kolonai</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Colonas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) a city in ancient Greece</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kolyma</ns0:orth>
        <ns0:pron>/kəlɪˈma/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Kolymá</ns0:quote>
          <ns0:quote>río Kolymá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river in the far north-eastern area of Russia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Komi</ns0:orth>
        <ns0:pron>/ˈkoʊmi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>komi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Finno-Ugric language currently spoken by 200,000 to 400,000 people, depending on source and definition of "speaker", in northeastern European part of Russia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Komodo dragon</ns0:orth>
        <ns0:pron>/kəˈmoʊdoʊ ˈdɹæɡən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dragón de Komodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the endangered species Varanus komodoensis of monitor lizards native to certain Indonesian islands east of Java, the world's largest lizard, growing to 10 feet or 3 meters, known for its ability to kill prey with its septic saliva.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Komondor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>komondor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large Hungarian breed of livestock guard dog with a long, corded coat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Komotini</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Komotini</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Thrace, northeastern Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Komsomol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Komsomol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Young Communist League, the former youth wing of the Communist Party of the Soviet Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Komsomolsk</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Komsomolsk</ns0:quote>
          <ns0:quote>Komsomolsk del Amur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Khabarovsk Krai, Russia, on the Amur river; in full, Komsomolsk-na-Amure or Komsomolsk-on-Amur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Konami Code</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>código Konami</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(video games) The cheat code "↑↑↓↓←→←→BA", usable in multiple video games.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Konstanz</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Constanza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and district in Baden-Württemberg, south Germany, on Lake Constance, and on the border with Switzerland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
