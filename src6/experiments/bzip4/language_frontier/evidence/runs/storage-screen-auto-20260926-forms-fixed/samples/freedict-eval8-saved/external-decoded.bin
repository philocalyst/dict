      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dislike of Europe or its culture or inhabitants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
