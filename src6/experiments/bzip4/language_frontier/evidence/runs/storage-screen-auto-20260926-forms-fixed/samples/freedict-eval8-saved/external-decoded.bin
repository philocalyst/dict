    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autobus</ns0:orth>
        <ns0:pron>/ˈɑtoʊˌbʌs/</ns0:pron>
        <ns0:pron>/ˈɔtoʊˌbʌs/</ns0:pron>
        <ns0:pron>/ˈɔːtə(ʊ)bʌs/</ns0:pron>
