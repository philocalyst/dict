        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Greece, its people, its language, or its culture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
