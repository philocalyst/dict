      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cisjordania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Palestinian territory on the west bank of the Jordan river, claimed by and under the partial administration of State of Palestine, and illegally occupied by Israel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
