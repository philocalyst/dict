        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acupuntor</ns0:quote>
          <ns0:quote>acupunturista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A healthcare professional who is qualified or professionally engaged in the practice of acupuncture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acutance</ns0:orth>
        <ns0:pron>/əˈkjutn̩(t)s/</ns0:pron>
        <ns0:pron>/əˈkjuːt(ə)n(t)s/</ns0:pron>
        <ns0:pron>[-ɾn̩(t)s]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acutancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An instance of the edge contrast or sharpness in an image.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acute</ns0:orth>
        <ns0:pron>/əˈkjut/</ns0:pron>
        <ns0:pron>/əˈkjuːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agudo</ns0:quote>
          <ns0:quote>perspicaz</ns0:quote>
          <ns0:quote>sagaz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Intense; sensitive; sharp.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grave</ns0:quote>
          <ns0:quote>agudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Urgent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry, of an angle) Less than 90 degrees.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geometry, of a triangle) Having all three interior angles measuring less than 90 degrees.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) Of an abnormal condition of recent or sudden onset, in contrast to delayed onset; this sense does not imply severity, unlike the common usage.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) Of a short-lived condition, in contrast to a chronic condition; this sense also does not imply severity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(orthography, postpositive) Of a letter of the alphabet, having an acute accent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acute abdomen</ns0:orth>
        <ns0:pron>/əˈkjut æbˈdoʊ.mən/</ns0:pron>
        <ns0:pron>/əˈkjut ˈæb.də.mən/</ns0:pron>
        <ns0:pron>/əˈkjuːt æbˈdəʊ.mən/</ns0:pron>
        <ns0:pron>/əˈkjuːt ˈæb.də.mən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abdomen agudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A condition of the abdomen which is indicated by an acute onset of severe pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acute accent</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acento agudo</ns0:quote>
          <ns0:quote>tilde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(orthography) : A diacritical mark ( ´ ) that can be placed above a number of letters in many languages of the Latin, Greek and Cyrillic writing systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acute angle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ángulo agudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) An angle greater than 0 degrees and less than 90 degrees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acute triangle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
