      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Felicidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Felix</ns0:orth>
        <ns0:pron>/ˈfiːlɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Félix</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A generic name given to a cat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fenian</ns0:orth>
        <ns0:pron>/ˈfi.ne.ɪn/</ns0:pron>
        <ns0:pron>/ˈfi.ni.ən/</ns0:pron>
        <ns0:pron>/ˈfi.njən/</ns0:pron>
        <ns0:pron>/ˈfi.njɪn/</ns0:pron>
        <ns0:pron>/ˈfiː.ni.ən/</ns0:pron>
        <ns0:pron>/ˈfiː.njən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>feniana</ns0:quote>
          <ns0:quote>feniano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(also, UK) A member of an organization opposing British rule in Ireland, especially the Fenian Brotherhood and Irish Republican Brotherhood which were active in the late 19th and early 20th centuries; (generally) an Irish nationalist or republican.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fennicize</ns0:orth>
