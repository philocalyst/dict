      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fiesta de los Faroles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A festival marking the end of the Chinese New Year period, celebrated on the fifteenth day of the first month in the Chinese calendar when the first full moon of the year is seen (in February or early March).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lanzarote</ns0:orth>
