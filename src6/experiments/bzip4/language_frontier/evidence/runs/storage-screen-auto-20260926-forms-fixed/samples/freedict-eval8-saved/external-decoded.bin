          <ns0:quote>maquiavélico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Attempting to achieve goals by cunning, scheming, and unscrupulous methods, especially in politics.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Related to the philosophical system of Niccolò Machiavelli.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
