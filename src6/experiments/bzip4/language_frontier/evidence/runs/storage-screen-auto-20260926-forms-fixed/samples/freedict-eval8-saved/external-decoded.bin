        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fogata de brujos</ns0:quote>
          <ns0:quote>fuego compacto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bonfire, any large outdoor fire (for example those used in a funeral pyre, or in witches' rituals).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baleful</ns0:orth>
        <ns0:pron>/ˈbeɪl.fəl/</ns0:pron>
