      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>texto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(printing, dated) A size of type between pica (12 point) and great primer (18 point), standardized as 14-point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>English</ns0:orth>
        <ns0:pron>/ɪŋˈɡlɪʃ/</ns0:pron>
        <ns0:pron>/ˈɪŋ(ɡ)lɪʃ/</ns0:pron>
        <ns0:pron>/ˈɪŋɡləʃ/</ns0:pron>
        <ns0:pron>/ˈɪŋɡəlɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inglés</ns0:quote>
          <ns0:quote>inglesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language that developed in England and is now spoken in the British Isles, the Commonwealth of Nations, North America, and many other parts of the world.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>English Channel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canal de la Mancha</ns0:quote>
          <ns0:quote>Canal de la Mancha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The arm of the Atlantic Ocean that separates the British Isles from northern France, and joins the North Sea to the Atlantic Ocean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>English studies</ns0:orth>
