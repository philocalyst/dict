      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adjetivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Applying to methods of enforcement and rules of procedure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adjective</ns0:orth>
        <ns0:pron>/ə(ɖ)ˈdʒɛkʈɪv/</ns0:pron>
