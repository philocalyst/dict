    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mapocho River</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Río Mapocho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A significant river running from the foothills of the Andes Mountains through Santiago, Chile and eventually to the Pacific Ocean as the Maipo River which it merges into at Pudahuel.</ns0:def>
        </ns0:sense>
