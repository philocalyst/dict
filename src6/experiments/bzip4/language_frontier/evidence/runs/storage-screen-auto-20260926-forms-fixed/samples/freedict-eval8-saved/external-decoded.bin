      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mandaluyong</ns0:quote>
          <ns0:quote>San Felipe Neri</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An independent city in Metro Manila, Philippines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mandarin</ns0:orth>
        <ns0:pron>/mæn.dəˈɹɪn/</ns0:pron>
        <ns0:pron>/ˈmæn.d(ə).ɹɪn/</ns0:pron>
        <ns0:pron>/ˈmæn.də.ɹɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mandarín</ns0:quote>
          <ns0:quote>chino mandarín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Standard Mandarin, an official language of China and Taiwan, and one of four official languages in Singapore; Putonghua, Guoyu or Huayu.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mandatory Palestine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Palestina Mandataria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A geopolitical entity under British administration, originally consisting of contemporary Israel, Judea and Samaria (the West Bank),, and the Gaza Strip which existed from 1920 to 1948.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
