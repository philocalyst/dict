        <ns0:pron>/ˌɑːtʃˈdaɪ.ə.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archidiócesis</ns0:quote>
          <ns0:quote>arzobispado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A group of dioceses administered by an archbishop</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
