    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>State of the Union</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el Discurso del Estado de la Unión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US politics) The State of the Union address, an annual event in which a president of the United States reports the status of the country, normally to a joint session of the United States Congress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
