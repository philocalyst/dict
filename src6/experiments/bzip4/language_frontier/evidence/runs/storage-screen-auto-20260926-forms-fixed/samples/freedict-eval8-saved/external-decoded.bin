          <ns0:quote>Femenino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) Clipping of women's team (used in club names, as in [Club Name] Women)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wonder Woman</ns0:orth>
        <ns0:pron>/ˈwʌndə ˈwʊmən/</ns0:pron>
