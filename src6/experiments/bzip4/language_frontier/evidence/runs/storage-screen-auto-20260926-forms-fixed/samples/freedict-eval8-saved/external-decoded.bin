      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>funesto</ns0:quote>
          <ns0:quote>torvo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Portending evil; ominous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baler</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>empacador</ns0:quote>
          <ns0:quote>empacadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A machine for creating bales, e.g., of hay or cotton.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>empacador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who creates bales, either by operating or feeding such a machine, or by creating the bales by hand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balk</ns0:orth>
        <ns0:pron>/bɑk/</ns0:pron>
        <ns0:pron>/bɔk/</ns0:pron>
        <ns0:pron>/bɔːk/</ns0:pron>
        <ns0:pron>/bɔːlk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>viga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Beam, crossbeam; squared timber; a tie beam of a house, stretching from wall to wall, especially when laid so as to form a loft, "the balks".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball</ns0:orth>
        <ns0:pron>/baːl/</ns0:pron>
        <ns0:pron>/bɑl/</ns0:pron>
        <ns0:pron>/bɔl/</ns0:pron>
        <ns0:pron>/bɔːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cojón</ns0:quote>
          <ns0:quote>huevo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bola</ns0:quote>
          <ns0:quote>esfera</ns0:quote>
          <ns0:quote>pelota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A solid or hollow sphere, or roughly spherical mass.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ovillo</ns0:quote>
          <ns0:quote>bola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A quantity of string, thread, etc., wound into a spherical shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baile</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A formal dance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esfera</ns0:quote>
          <ns0:quote>círculo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) The set of points in a metric space of any number of dimensions lying within a given distance (the radius) of a given point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bala</ns0:quote>
          <ns0:quote>bola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ballistics, firearms) A solid, spherical nonexplosive missile for a cannon, rifle, gun, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bola</ns0:quote>
          <ns0:quote>bola mala</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(baseball, countable) A pitch that falls outside of the strike zone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pelota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cricket, countable) A single delivery by the bowler, six of which make up an over.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tirada</ns0:quote>
          <ns0:quote>bola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pinball, countable) An opportunity to launch the pinball into play.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agallas</ns0:quote>
          <ns0:quote>huevos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(in the plural) Courage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pelota</ns0:quote>
          <ns0:quote>balón</ns0:quote>
          <ns0:quote>bola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(printing, historical) A leather-covered cushion, fastened to a handle called a ballstock; formerly used by printers for inking the form, then superseded by the roller.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball</ns0:orth>
        <ns0:pron>/baːl/</ns0:pron>
        <ns0:pron>/bɑl/</ns0:pron>
        <ns0:pron>/bɔl/</ns0:pron>
        <ns0:pron>/bɔːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coger con</ns0:quote>
          <ns0:quote>follar con</ns0:quote>
          <ns0:quote>tirarse a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, , intransitive, US, vulgar) To have sexual intercourse (with).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball bearing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cojinete</ns0:quote>
          <ns0:quote>rodamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(engineering) A bearing assembly which uses spherical bearing balls as the rolling elements.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball boy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recogepelotas</ns0:quote>
          <ns0:quote>recogebolas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) A person, usually male, responsible for retrieving balls from the area of play, and returning them to the players.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball gag</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mordaza de bola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(BDSM) A gag with a rubber or silicone sphere that is strapped into the mouth behind the teeth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball game</ns0:orth>
        <ns0:pron>/ˈbɔːl ˌɡeɪm/</ns0:pron>
      </ns0:form>
