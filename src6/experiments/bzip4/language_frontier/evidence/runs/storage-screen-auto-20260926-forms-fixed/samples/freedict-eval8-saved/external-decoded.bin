      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ciudad Prohibida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A palace of the Ming dynasty and Qing dynasty located in Dongcheng district, Beijing, China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fordism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fordismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An economic and social system based on industrial mass production, where the worker is paid relatively high wages in order to buy in large quantity the products turned out in mass production.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
