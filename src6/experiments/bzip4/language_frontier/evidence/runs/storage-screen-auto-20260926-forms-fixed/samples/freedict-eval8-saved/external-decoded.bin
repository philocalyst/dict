        <ns0:pron>[bɑ]</ns0:pron>
        <ns0:pron>[bɑː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balido</ns0:quote>
          <ns0:quote>be</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(onomatopoeia) The characteristic cry or bleating of a sheep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baa</ns0:orth>
        <ns0:pron>[bæ]</ns0:pron>
        <ns0:pron>[bæ̰ˀæ̰ˀæ̰ˀæ̰ˀ]</ns0:pron>
        <ns0:pron>[bæ̰ː]</ns0:pron>
        <ns0:pron>[bɑ]</ns0:pron>
        <ns0:pron>[bɑː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make the characteristic cry of a sheep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baba ganoush</ns0:orth>
        <ns0:pron>/ˌbɑbə ɡəˈnuʃ/</ns0:pron>
        <ns0:pron>/ˌbɑːbə ɡəˈnuːʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baba ganush</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Middle Eastern dish made from a purée of roasted aubergine (eggplant), garlic, and tahini, often eaten as a dip with bread.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babalawo</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>babalao</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In Yoruba culture, a priest of Ifa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babble</ns0:orth>
        <ns0:pron>/ˈbæb.(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>charla</ns0:quote>
          <ns0:quote>parloteo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Idle talk; senseless prattle</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balbuceo</ns0:quote>
          <ns0:quote>jerigonza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Inarticulate speech; constant or confused murmur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gorjeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sound like that of water gently flowing around obstructions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babble</ns0:orth>
        <ns0:pron>/ˈbæb.(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>farfullar</ns0:quote>
          <ns0:quote>mascullar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To utter words indistinctly or unintelligibly; to utter inarticulate sounds</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>charlar</ns0:quote>
          <ns0:quote>chacharear</ns0:quote>
          <ns0:quote>charlatanear</ns0:quote>
          <ns0:quote>parlotear</ns0:quote>
          <ns0:quote>charlotear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To talk too much; to chatter; to prattle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>murmurar</ns0:quote>
          <ns0:quote>susurrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To make a continuous murmuring noise, like shallow water running over stones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babbler</ns0:orth>
        <ns0:pron>[ˈbæb(ə)lə(ɹ)]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balbuceador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who babbles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babbling</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balbuceo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) sounds produced by infant during the babbling period</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babe in arms</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>niño de pecho</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babesiosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>babesiasis</ns0:quote>
          <ns0:quote>babesiosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Any of several malaria-like parasitic diseases in humans and other animals caused by Babesia, a genus of protozoa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babirusa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>babirusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any mammal in the genus Babyrousa in the pig family Suidae, in which the upper tusk grows upward.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baboon</ns0:orth>
        <ns0:pron>/bəˈbuːn/</ns0:pron>
        <ns0:pron>/ˌbæˈbuːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>babuino</ns0:quote>
          <ns0:quote>babón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Old World monkey of the genus Papio, having dog-like muzzles and large canine teeth, cheek pouches, a short tail, and naked callosities on the buttocks. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(colloquial, derogatory) A foolish or boorish person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babouche</ns0:orth>
        <ns0:pron>/bəˈbuːʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>babucha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Turkish or Moroccan slipper having no heel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babushka</ns0:orth>
        <ns0:pron>/bəˈbuːʃ.kə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anciana</ns0:quote>
          <ns0:quote>mujer vieja</ns0:quote>
          <ns0:quote>señora mayor</ns0:quote>
          <ns0:quote>vieja</ns0:quote>
          <ns0:quote>viejecita</ns0:quote>
          <ns0:quote>viejita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Eastern European old woman. [from 1830s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby</ns0:orth>
        <ns0:pron>/ˈbeɪ̯.bi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bebé</ns0:quote>
          <ns0:quote>nene</ns0:quote>
          <ns0:quote>guagua</ns0:quote>
          <ns0:quote>bebe</ns0:quote>
          <ns0:quote>niña</ns0:quote>
          <ns0:quote>niño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very young human, particularly from birth to a couple of years old or until walking is fully mastered.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A very young human, even if not yet born.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benjamín</ns0:quote>
          <ns0:quote>benjamina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The lastborn of a family; the youngest sibling, irrespective of age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nene</ns0:quote>
          <ns0:quote>nena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A form of address to a person considered to be attractive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby boom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baby-boom</ns0:quote>
          <ns0:quote>explosión de natalidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(singulare tantum) The increase in the birth rate following the return of servicemen at the end of World War II.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby boomer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baby boomer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, capitalized) A person born in the postwar years (generally considered in the United States and other Allied countries as between 1946 and the early 1960s), when there was a marked increase in birthrates throughout the Western world following the return of servicemen at the end of World War II.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby bottle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biberón</ns0:quote>
          <ns0:quote>mamadera</ns0:quote>
          <ns0:quote>bibi</ns0:quote>
          <ns0:quote>bibí</ns0:quote>
          <ns0:quote>chupón</ns0:quote>
          <ns0:quote>mamila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bottle equipped with a teat, used for bottlefeeding infants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby boy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chiquito</ns0:quote>
          <ns0:quote>niño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very young male human being, from birth to a couple of years old.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby face</ns0:orth>
        <ns0:pron>/ˈbeɪbi ˌfeɪs/</ns0:pron>
        <ns0:pron>/ˈbeɪbɪ feɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lampiño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, derogatory) A person having such a face, especially a young man having a beardless appearance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>técnica</ns0:quote>
          <ns0:quote>técnico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(professional wrestling, slang) A headlining wrestler with a persona embodying heroic or virtuous traits and who is regarded as a "good guy", especially one who is handsome and well-conditioned.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby food</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comida de bébé</ns0:quote>
          <ns0:quote>papilla</ns0:quote>
          <ns0:quote>potito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A food designed for babies, usually of very soft consistency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby grand piano</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colín</ns0:quote>
          <ns0:quote>piano de media cola</ns0:quote>
          <ns0:quote>piano de un cuarto de cola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small grand piano.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby shower</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baby shower</ns0:quote>
          <ns0:quote>fiesta de pañales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A party celebrating the pending or recent birth of a child, involving guests giving gifts (typically babycare items) to the parent(s).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby step</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasito infantil</ns0:quote>
          <ns0:quote>paso pequeño</ns0:quote>
          <ns0:quote>pequeño paso</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby talk</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maternés</ns0:quote>
          <ns0:quote>lenguaje infantil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) The form of speech used by adults in talking to very young children.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby walker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tacataca</ns0:quote>
          <ns0:quote>tacatá</ns0:quote>
          <ns0:quote>andadera</ns0:quote>
          <ns0:quote>pollera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device in which a baby sits in a harness within a wheeled frame that supports it whilst walking.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby's breath</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nube</ns0:quote>
          <ns0:quote>velo de novia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A genus, Gypsophila, of about 100 species of flowering plants in the family Caryophyllaceae, native to Europe, Asia and north Africa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baby's tears</ns0:orth>
        <ns0:pron>/ˌbeɪbiz ˈtɪəz/</ns0:pron>
        <ns0:pron>/ˌbeɪbiz ˈtɪəɹz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colchón de novia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various plants having parts (such as leaves or spots on leaves, petals, etc.) resembling teardrops; specifically, angel's tears (Soleirolia soleirolii), a plant in the nettle family grown as a green, mossy ground cover.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babyish</ns0:orth>
        <ns0:pron>/ˈbeɪbiɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>infantil</ns0:quote>
          <ns0:quote>pueril</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Like or suitable for a baby or a young child; childish</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babysit</ns0:orth>
        <ns0:pron>/ˈbeɪ.bi.sɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuidar de los niños</ns0:quote>
          <ns0:quote>hacer de canguro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To watch or tend someone else's child for a period of time, often for money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>babysitter</ns0:orth>
        <ns0:pron>/ˈbeɪbiˌsɪtɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canguro</ns0:quote>
          <ns0:quote>niñera</ns0:quote>
          <ns0:quote>china</ns0:quote>
          <ns0:quote>niñero</ns0:quote>
          <ns0:quote>aña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who cares for one or more babies or children for a short period of time in place of their legal guardians.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacanora</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacanora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Mexican alcoholic beverage distilled from agave plants, made in the state of Sonora.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baccalaureate</ns0:orth>
        <ns0:pron>/bækəˈlɔːɹɪət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bachillerato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A high school completion exam and qualification awarded in many countries (e.g. Finland, France, Moldova, Romania), designed to enable students to go on to higher education.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baccarat</ns0:orth>
        <ns0:pron>/bɑːkəˈɹɑː/</ns0:pron>
        <ns0:pron>/ˈbækəɹæt/</ns0:pron>
        <ns0:pron>/ˈbækəɹɑː/</ns0:pron>
        <ns0:pron>/ˈbɑːkəɹɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacará</ns0:quote>
          <ns0:quote>bacarrá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(card games) A card game resembling chemin de fer with many forms - usually entailing the player(s) betting against two or three hands dealt - also bearing some similarities to blackjack.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacchanal</ns0:orth>
        <ns0:pron>/ˈbækənəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacanal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to Bacchus or his festival.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Engaged in drunken revels; drunken and riotous or noisy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacchanal</ns0:orth>
        <ns0:pron>/ˈbækənəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacanal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Drunken revelry; an orgy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacchic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>báquico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Bacchus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bachata</ns0:orth>
        <ns0:pron>/bəˈt͡ʃɑːtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bachata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A genre of music originating in the Dominican Republic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bachelor</ns0:orth>
        <ns0:pron>/ˈbæt͡ʃ.lɚ/</ns0:pron>
        <ns0:pron>/ˈbæt͡ʃ.ə.lə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbæt͡ʃ.ə.lɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bachiller</ns0:quote>
          <ns0:quote>licenciatura</ns0:quote>
          <ns0:quote>título de grado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first or lowest academical degree conferred by universities and colleges; a bachelor's degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bachiller</ns0:quote>
          <ns0:quote>licenciado</ns0:quote>
          <ns0:quote>título de grado</ns0:quote>
          <ns0:quote>licenciatura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who has achieved a bachelor's degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>solterón</ns0:quote>
          <ns0:quote>soltero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) An unmarried woman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bachelor party</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despedida de soltero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada, South Africa) A party held for a man who is about to be married, normally attended only by male friends and relatives.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bachelor's degree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>licenciatura</ns0:quote>
          <ns0:quote>bachillerato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first or lowest academic degree conferred by universities and colleges.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bachelorette party</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despedida de soltera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada) A party held for a woman who is about to be married.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacillary</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to a bacillus</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacillophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacilofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fear of microbes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bacillus</ns0:orth>
        <ns0:pron>/bæˈsɪl.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various rod-shaped, spore-forming aerobic bacteria in the genus Bacillus, some of which cause disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back</ns0:orth>
        <ns0:pron>/bæk/</ns0:pron>
        <ns0:pron>[-k̚]</ns0:pron>
        <ns0:pron>[-ˀk]</ns0:pron>
        <ns0:pron>[bak]</ns0:pron>
        <ns0:pron>[bax]</ns0:pron>
        <ns0:pron>[bäk]</ns0:pron>
        <ns0:pron>[bæk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anterior</ns0:quote>
          <ns0:quote>atrasado</ns0:quote>
          <ns0:quote>viejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not current.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apartado</ns0:quote>
          <ns0:quote>arrinconado</ns0:quote>
          <ns0:quote>distante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Situated away from the main or most frequented areas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>posterior</ns0:quote>
          <ns0:quote>trasero</ns0:quote>
          <ns0:quote>atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(comparable, phonetics) Pronounced with the highest part of the body of the tongue toward the back of the mouth, near the soft palate (most often describing a vowel).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back</ns0:orth>
        <ns0:pron>/bæk/</ns0:pron>
        <ns0:pron>[-k̚]</ns0:pron>
        <ns0:pron>[-ˀk]</ns0:pron>
        <ns0:pron>[bak]</ns0:pron>
        <ns0:pron>[bax]</ns0:pron>
        <ns0:pron>[bäk]</ns0:pron>
        <ns0:pron>[bæk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de vuelta</ns0:quote>
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>de regreso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) To or in a previous condition or place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>arredro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Away from the front or from an edge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back</ns0:orth>
        <ns0:pron>/bæk/</ns0:pron>
        <ns0:pron>[-k̚]</ns0:pron>
        <ns0:pron>[-ˀk]</ns0:pron>
        <ns0:pron>[bak]</ns0:pron>
        <ns0:pron>[bax]</ns0:pron>
        <ns0:pron>[bäk]</ns0:pron>
        <ns0:pron>[bæk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espalda</ns0:quote>
          <ns0:quote>dorso</ns0:quote>
          <ns0:quote>envés</ns0:quote>
          <ns0:quote>reverso</ns0:quote>
          <ns0:quote>lomo</ns0:quote>
          <ns0:quote>fondo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The rear of the body, especially the part between the neck and the end of the spine and opposite the chest and belly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>defensa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) In some team sports, a position behind most players on the team.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondo</ns0:quote>
          <ns0:quote>parte de atrás</ns0:quote>
          <ns0:quote>trasero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which is farthest away from the front.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>revés</ns0:quote>
          <ns0:quote>envés</ns0:quote>
          <ns0:quote>reverso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The reverse side; the side that is not normally seen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back</ns0:orth>
        <ns0:pron>/bæk/</ns0:pron>
        <ns0:pron>[-k̚]</ns0:pron>
        <ns0:pron>[-ˀk]</ns0:pron>
        <ns0:pron>[bak]</ns0:pron>
        <ns0:pron>[bax]</ns0:pron>
        <ns0:pron>[bäk]</ns0:pron>
        <ns0:pron>[bæk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respaldar</ns0:quote>
          <ns0:quote>sostener</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To support.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>retroceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical, of the wind) To change direction contrary to the normal pattern; that is, to shift anticlockwise in the northern hemisphere, or clockwise in the southern hemisphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back and forth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de acá para allá</ns0:quote>
          <ns0:quote>de ceca en meca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From one place to another and back again.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back cover</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contraportada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The cover on the opposite side of the front cover of a book, magazine, etc; back of the book; associated with sports pages in publications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back door</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puerta trasera</ns0:quote>
          <ns0:quote>puerta de atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A subsidiary entrance to a building or house at its rear, normally away from the street.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back down</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>echarse atrás</ns0:quote>
          <ns0:quote>recular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, transitive) To make (someone) take a less aggressive position.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back end</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dorsal</ns0:quote>
          <ns0:quote>motor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) That part of a hardware or software system that is farthest from the user; the internals rather than the user interface.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back fire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contrafuego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small, controlled fire set in the path of a larger uncontrolled fire, in order to limit the spread of the large fire by removing its fuel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deflagración de escape</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An explosion produced either by a running internal combustion engine that occurs in the air intake or exhaust system rather than inside the combustion chamber or unburned fuel or hydrocarbons ignited somewhere in the exhaust system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back in the day</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en aquellos tiempos</ns0:quote>
          <ns0:quote>entonces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(temporal location, idiomatic, informal) In the distant past; especially, at a time fondly remembered (the good old days).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back of beyond</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quinto pino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, British, Irish, Canadian, and, Australian, informal) A very remote place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back off</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literally) To move backwards away from something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dar marcha atrás</ns0:quote>
          <ns0:quote>desdecirse</ns0:quote>
          <ns0:quote>echarse atrás</ns0:quote>
          <ns0:quote>echarse para atrás</ns0:quote>
          <ns0:quote>retractarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To withdraw from something one has agreed to do.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back pass</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cesión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(soccer) An intentional pass to the goalkeeper by a teammate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back pocket</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bolsillo trasero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pocket found on the back of a pair of trousers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back seat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asiento trasero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the seats in the rear of a vehicle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>segundón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, especially in the expression take a back seat) A lesser or inferior position; a position of deliberate noninvolvement, in which decision-making or leadership is left to others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back street</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>callejuela</ns0:quote>
          <ns0:quote>callejón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A usually small and narrow street or alley, especially one in inferior or poorer parts of a city, away from the centre.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back substitution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sustitución regresiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(combinatorics) A method of solving recurrence relations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back to front</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al revés</ns0:quote>
          <ns0:quote>prepóstero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Reversed, with the back now at the front.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back to front</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al revés</ns0:quote>
          <ns0:quote>prepósteramente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Turned so that the back is now at the front; the wrong way around.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back to square one</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de vuelta a la casilla de salida</ns0:quote>
          <ns0:quote>volver a la casilla de salida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Located back at the start, as after a dead end or failure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back to square one</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de vuelta a la casilla de salida</ns0:quote>
          <ns0:quote>foja cero</ns0:quote>
          <ns0:quote>fojas cero</ns0:quote>
          <ns0:quote>volver a la casilla de salida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Back to the start, as after a dead end or failure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back up</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroceder</ns0:quote>
          <ns0:quote>ciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, intransitive) To move backwards, especially for a vehicle to do so.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respaldar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, intransitive, cricket) For a fielder to position himself behind the wicket (relative to a team-mate who is throwing the ball at the wicket) so as to stop the ball, and prevent overthrows.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back vowel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vocal posterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics) Any vowel sound produced in the back of the mouth, such as /uː/ in rule or /əʊ/ in pole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back-formation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>derivación regresiva</ns0:quote>
          <ns0:quote>derivado regresivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, linguistics) The process by which a new word is formed from an older word by interpreting the former as a derivative of the latter, often by removing a morpheme (real or perceived) from the older word, such as the verb burgle, formed by removing -ar (perceived as an agent-noun suffix) from burglar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>back-to-back</ns0:orth>
        <ns0:pron>/ˌbæk.təˈbæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consecutivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sequential or consecutive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espaldera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a house) Having a party wall at the rear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backache</ns0:orth>
        <ns0:pron>/ˈbækeɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dolor de espalda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any pain or ache in the back.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backbite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calumniar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make spiteful slanderous or defamatory statements about someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backbone</ns0:orth>
        <ns0:pron>/ˈbækˌboʊn/</ns0:pron>
        <ns0:pron>/ˈbækˌbəʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espina dorsal</ns0:quote>
          <ns0:quote>columna vertebral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) The series of vertebrae, separated by disks, that encloses and protects the spinal cord, and runs down the middle of the back in vertebrate animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>columna vertebral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, figuratively) Any fundamental support, structure, or infrastructure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carácter</ns0:quote>
          <ns0:quote>coraje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, figuratively) Courage, fortitude, or strength.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backcountry</ns0:orth>
        <ns0:pron>/ˈbækˌkʌntɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andurrial</ns0:quote>
          <ns0:quote>andurriales</ns0:quote>
          <ns0:quote>vericueto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A remote region; countryside that is relatively inaccessible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backdam</ns0:orth>
        <ns0:pron>/ˈbækdæm/</ns0:pron>
        <ns0:pron>/ˈbækˌdæm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conuco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Guyana) A region of rural, undeveloped land, especially on the outskirts of a farm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backdrop</ns0:orth>
        <ns0:pron>/ˈbæk.dɹɑp/</ns0:pron>
        <ns0:pron>/ˈbæk.dɹɒp/</ns0:pron>
        <ns0:pron>[ˈbæk.dɹɑp]</ns0:pron>
        <ns0:pron>[ˈbæk.d͡ʒɹɑp]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bambalina</ns0:quote>
          <ns0:quote>decorado</ns0:quote>
          <ns0:quote>telón de fondo</ns0:quote>
          <ns0:quote>telón de foro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A decorated cloth hung at the back of a stage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decorado</ns0:quote>
          <ns0:quote>fondo</ns0:quote>
          <ns0:quote>lejanía</ns0:quote>
          <ns0:quote>lontananza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An image that serves as a visual background.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backfill</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atibar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backfire</ns0:orth>
        <ns0:pron>/bækˈfaɪə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbækfaɪə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbækfaɪə(ɹ)/&lt;q:noun&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>petardear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a reciprocating engine, intransitive) To experience a premature ignition of fuel or an ignition of exhaust gases, making a popping sound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jugar una mala pasada</ns0:quote>
          <ns0:quote>salir el tiro por la culata</ns0:quote>
          <ns0:quote>tener contraefecto</ns0:quote>
          <ns0:quote>tener efecto retroactivo</ns0:quote>
          <ns0:quote>tener el efecto contrario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, transitive) To fail in a manner that brings down further misfortune.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backgammon</ns0:orth>
        <ns0:pron>/ˈbæk.ɡæm.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>backgammon</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A board game for two players in which each has 15 stones which move between 24 triangular points according to the roll of a pair of dice; the object is to move all of one's pieces around, and bear them off the board.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>background</ns0:orth>
        <ns0:pron>/ˈba(k)ɡɾɑwɳɖ/&lt;a:Indic&gt;</ns0:pron>
        <ns0:pron>/ˈbæk(ɡ)ɹaʊnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>origen</ns0:quote>
          <ns0:quote>formación</ns0:quote>
          <ns0:quote>procedencia</ns0:quote>
          <ns0:quote>proveniencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One's social heritage, or previous life; what one did in the past.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondo</ns0:quote>
          <ns0:quote>trasfondo</ns0:quote>
          <ns0:quote>lejanía</ns0:quote>
          <ns0:quote>lontananza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A part of the picture that depicts scenery to the rear or behind the main subject; context.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antecedente</ns0:quote>
          <ns0:quote>fondo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Information relevant to the current situation about past events; history.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>segundo plano</ns0:quote>
          <ns0:quote>fondo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A less important feature of scenery (as opposed to foreground).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondo</ns0:quote>
          <ns0:quote>fondo de pantalla</ns0:quote>
          <ns0:quote>segundo plano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A type of activity on a computer that is not normally visible to the user.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>background check</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>verificación de antecedentes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(business, law) A report on a person’s legal and criminal personal history.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>background music</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>música de fondo</ns0:quote>
          <ns0:quote>hilo musical</ns0:quote>
          <ns0:quote>música fondal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any music played in a public space whose main function is to create an atmosphere suitable to a specific occasion, rather than to be listened to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backhand</ns0:orth>
        <ns0:pron>/ˈbækhænd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>revés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(tennis, and, other, racquet sports) A stroke made across the chest from the off-hand side to the racquet hand side; a stroke during which the back of the hand faces the shot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backhanded compliment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>crítica velada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) An insult disguised as a compliment; a compliment which can be interpreted as an insult.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backhander</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>torniscón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surfing) A surfer who approaches a swell with the wave behind them ("on their backhand") rather than facing the wave ("on their forehand").</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backhoe</ns0:orth>
        <ns0:pron>/ˈbæk.həʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cargadora mixta</ns0:quote>
          <ns0:quote>excavadora mixta</ns0:quote>
          <ns0:quote>pala mixta</ns0:quote>
          <ns0:quote>retrocargadora</ns0:quote>
          <ns0:quote>retroexcavadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US, Canada, Australia) Ellipsis of backhoe loader: A multi-purpose tractor with a front-mounted loading bucket and a rear-mounted digging bucket. The tractor combines a front-end loader/loader (component) and an excavator/digger (component).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backkick</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coz</ns0:quote>
          <ns0:quote>taina</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backlash</ns0:orth>
        <ns0:pron>/ˈbækˌlæʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>holgura</ns0:quote>
          <ns0:quote>huelgo</ns0:quote>
          <ns0:quote>juego</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contragolpe</ns0:quote>
          <ns0:quote>reacción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literal) A suddenly reversed or backward motion, such as of a rope or elastic band when it snaps under tension.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contragolpe</ns0:quote>
          <ns0:quote>oposición</ns0:quote>
          <ns0:quote>reacción clamorosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) A negative reaction, objection or outcry, especially of a violent or abrupt nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backlight</ns0:orth>
        <ns0:pron>/ˈbæk.laɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contraluz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A spotlight that illuminates a photographic subject from behind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroiluminación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A light attached to an LCD display.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backlight</ns0:orth>
        <ns0:pron>/ˈbæk.laɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroiluminar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To illuminate something from behind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backlink</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroenlace</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet) A hyperlink to a webpage from an external website.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backlit</ns0:orth>
        <ns0:pron>/ˈbækˌlɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroiluminado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lit or illuminated from behind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backlog</ns0:orth>
        <ns0:pron>/ˈbæk.lɒɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondo</ns0:quote>
          <ns0:quote>reserva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A reserve source or supply.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acumulación</ns0:quote>
          <ns0:quote>acúmulo</ns0:quote>
          <ns0:quote>atrasos</ns0:quote>
          <ns0:quote>cartera de pedidos</ns0:quote>
          <ns0:quote>comulación</ns0:quote>
          <ns0:quote>cumulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An accumulation or buildup, especially of unfilled orders, unconsumed products or unfinished work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backpack</ns0:orth>
        <ns0:pron>/ˈbæk.pæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mochila</ns0:quote>
          <ns0:quote>bolsón</ns0:quote>
          <ns0:quote>morral</ns0:quote>
          <ns0:quote>bolso</ns0:quote>
          <ns0:quote>bulto</ns0:quote>
          <ns0:quote>macuto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A knapsack, sometimes mounted on a light frame, but always supported by straps, worn on a person’s back for the purpose of carrying things, especially when hiking, or on a student's back when carrying books.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backpack</ns0:orth>
        <ns0:pron>/ˈbæk.pæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mochilear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To hike and camp overnight in backcountry with one's gear carried in a backpack.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, rare) To place or carry (an item or items) in a backpack.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backpacker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mochilero</ns0:quote>
          <ns0:quote>mochilera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A traveler whose luggage consists of a backpack; especially, such a traveler who uses hostels, public transport, and other inexpensive services.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backpacking</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mochileo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>hiking and camping overnight in backcountry with one's gear carried in a backpack.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backpedal</ns0:orth>
        <ns0:pron>/ˈbækˌpɛdəɫ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retropedalear</ns0:quote>
          <ns0:quote>contrapedalear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To pedal backwards on a bicycle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroceder</ns0:quote>
          <ns0:quote>cejar</ns0:quote>
          <ns0:quote>ciar</ns0:quote>
          <ns0:quote>recejar</ns0:quote>
          <ns0:quote>recular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To step backwards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desdecirse</ns0:quote>
          <ns0:quote>recular</ns0:quote>
          <ns0:quote>retractarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, idiomatic) To distance oneself from an earlier claim or statement; back off from an idea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backport</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corregir retroactivamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To retroactively supply (to a previous version of a software product) a fix, or a new feature, at the same time or after supplying it to the current version.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To retroactively supply (a fix or a new feature) to a previous version of a software product at the same time or after supplying it to the current version.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backrest</ns0:orth>
        <ns0:pron>/ˈbækˌɹɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respaldo</ns0:quote>
          <ns0:quote>espaldar</ns0:quote>
          <ns0:quote>respaldar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The back piece of a chair, used to support the sitter's back.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backronym</ns0:orth>
        <ns0:pron>/ˈbæk.ɹəˌnɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroacrónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A word that is originally not an acronym but is turned into one by devising a full form for it, sometimes as a folk etymology, sometimes as a contrived acronym to name a new organization, proposal, or other entity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backroom</ns0:orth>
        <ns0:pron>/ˈbækˌɹum/</ns0:pron>
        <ns0:pron>/ˈbækˌɹuːm/</ns0:pron>
        <ns0:pron>/ˈbækˌɹʊm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apartado</ns0:quote>
          <ns0:quote>rebotica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A room near the rear of a premises.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backsaw</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>serrucho de costilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A handsaw that has a reinforcement along its back edge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backscratch</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pastelear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(business, politics, slang) To engage in a reciprocal beneficial action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backscratcher</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rascador de espaldas</ns0:quote>
          <ns0:quote>rascaespalda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A long slender rod with a rake-like device on one end, sometimes in the form of a human hand, designed to let a person scratch their own back.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backside</ns0:orth>
        <ns0:pron>/ˈbækˌsaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lado posterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The back side of an estate: the backyard and outbuildings behind a main house, especially (UK, _, dialect, euphemism) an outhouse.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The back side of anything, the part opposite its front, particularly:</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trasero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(euphemism) A person's buttocks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backsie</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>palinodia</ns0:quote>
          <ns0:quote>recantación</ns0:quote>
          <ns0:quote>retractación</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backslang</ns0:orth>
        <ns0:pron>/ˈbækslæŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vesre</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backslash</ns0:orth>
        <ns0:pron>/ˈbækˌslæʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra inversa</ns0:quote>
          <ns0:quote>barra invertida</ns0:quote>
          <ns0:quote>barra oblicua inversa</ns0:quote>
          <ns0:quote>barra revertida</ns0:quote>
          <ns0:quote>contrabarra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The punctuation mark \.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backspace</ns0:orth>
        <ns0:pron>/ˈbækˌspeɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroceso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The key on a typewriter that moves the head one position backwards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>borrar</ns0:quote>
          <ns0:quote>retroceso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A keyboard key used for removing a character behind the cursor, and moving the cursor one position backwards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backsplash</ns0:orth>
        <ns0:pron>/ˈbækˌsplæʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salpicadero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A vertical covering on a wall rising above a countertop or other work surface to protect the wall from spills and to decorate the wall.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backstabber</ns0:orth>
        <ns0:pron>/ˈbækˌstæbɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mosca muerta</ns0:quote>
          <ns0:quote>mosquita muerta</ns0:quote>
          <ns0:quote>traidor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A traitor or hypocrite, such as a co-worker or friend assumed trustworthy but who figuratively attacks when one's back is turned.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backstitch</ns0:orth>
        <ns0:pron>/ˈbækˌstɪt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pespunte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sewing) A type of sewing stitch where the stitch goes backwards on the top side of the fabric and doubles forward on the bottom, coming out farther in front, then repeats. The backstitch is a very tight and secure stitch, and also looks very neat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backstitch</ns0:orth>
        <ns0:pron>/ˈbækˌstɪt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pespuntar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To sew with a backstitch.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backstory</ns0:orth>
        <ns0:pron>/ˈbækˌstɔɹi/</ns0:pron>
        <ns0:pron>/ˈbækˌstɔːɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>historia de fondo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The previous experiences and life of a person, specifically (narratology, especially in, _, film, television) a character in a dramatic work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backstroke</ns0:orth>
        <ns0:pron>/ˈbækˌstɹoʊk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estilo espalda</ns0:quote>
          <ns0:quote>dorso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(swimming) A stroke swum lying on one's back, while rotating both arms through the water as to propel the swimmer backwards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backswimmer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>garapito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various aquatic insects, of the family Notonectidae, that swim on their backs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backtrack</ns0:orth>
        <ns0:pron>/ˈbæk.tɹæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroceso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the act of backtracking</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backtrack</ns0:orth>
        <ns0:pron>/ˈbæk.tɹæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retroceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To retrace one's steps.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>repasar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To repeat or review work already done.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backtracking</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vuelta atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computer science) The act of building all possible solutions to a problem incrementally, abandoning any candidate solution if it cannot lead to a valid solution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backup</ns0:orth>
        <ns0:pron>/ˈbækˌʌp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reserva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Standby, reserve or extra.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backup</ns0:orth>
        <ns0:pron>/ˈbækˌʌp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reserva</ns0:quote>
          <ns0:quote>respaldo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A reserve or substitute.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>copia de reserva</ns0:quote>
          <ns0:quote>copia de respaldo</ns0:quote>
          <ns0:quote>copia de seguridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A copy of a file or record, stored separately from the original, that can be used to recover the original if it is damaged or destroyed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backward</ns0:orth>
        <ns0:pron>/ˈbæk.wə(ɹ)d/</ns0:pron>
        <ns0:pron>/ˈbækwɚd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a contrapelo</ns0:quote>
          <ns0:quote>carca</ns0:quote>
          <ns0:quote>hacia atrás</ns0:quote>
          <ns0:quote>invertido</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticuado</ns0:quote>
          <ns0:quote>desactualizado</ns0:quote>
          <ns0:quote>pasado de moda</ns0:quote>
          <ns0:quote>retrógrado</ns0:quote>
          <ns0:quote>trasnochado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Situated toward or at the rear of something.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chess) Of a pawn, further behind than pawns of the same colour on adjacent files and unable to be moved forward safely.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retrógrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Acting or moving in the direction opposite to the usual direction of movement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrasado</ns0:quote>
          <ns0:quote>rezagado</ns0:quote>
          <ns0:quote>subdesarrollado</ns0:quote>
          <ns0:quote>tercermundista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of a culture, country, practice etc., undeveloped or unsophisticated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backward</ns0:orth>
        <ns0:pron>/ˈbæk.wə(ɹ)d/</ns0:pron>
        <ns0:pron>/ˈbækwɚd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>hacia atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a direction opposite to the usual direction of movement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backward compatibility</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retrocompatibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(software) Capability of interoperating with older systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backward compatible</ns0:orth>
        <ns0:pron>/ˌbækwɚdkəmˈpætəb(ə)l/</ns0:pron>
        <ns0:pron>[ˌbækwɚdkəmˈpæɾəb(ə)l]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retrocompatible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(software) Capable of interoperating with older systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>backwater</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pueblucho</ns0:quote>
          <ns0:quote>villorrio</ns0:quote>
