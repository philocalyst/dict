        <ns0:sense>
          <ns0:def>A member of an ancient West Germanic tribe that lived at the eastern North Sea coast and south of it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sajón</ns0:quote>
          <ns0:quote>sajona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or inhabitant of Saxony, Germany.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Saxony</ns0:orth>
        <ns0:pron>/ˈsæksəni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sajonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of modern Germany, located in the east, far from historical Saxon lands. Official name: Free State of Saxony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Saxony-Anhalt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sajonia-Anhalt</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of the component states of Germany according to the current administrative division of the nation. Its capital is Magdeburg.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Saône</ns0:orth>
        <ns0:pron>/soʊn/</ns0:pron>
        <ns0:pron>/səʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Saona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river in France that flows into the Rhone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scandinavia</ns0:orth>
        <ns0:pron>/skændɪˈneɪvi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escandinavia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region of Northern Europe, consisting of Denmark, Norway, and Sweden collectively and sometimes Finland, Iceland, Åland and the Faroe Islands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scandinavian</ns0:orth>
        <ns0:pron>/ˌskændɪˈneɪvi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escandinavo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a language) Of or relating to the North Germanic family of languages to which Swedish, Norwegian (Bokmål, Nynorsk), Danish, Icelandic, and Faeroese belong.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scandinavian</ns0:orth>
        <ns0:pron>/ˌskændɪˈneɪvi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escandinavo</ns0:quote>
          <ns0:quote>escandinava</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone from Scandinavia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scandinavian Peninsula</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escandinavia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula comprising the mainlands of Norway and Sweden, and the northwestern part of Finland (compared to Fennoscandia which comprises all the three countries Norway, Sweden and Finland); the largest peninsula in Europe (with an area of three-quarter million square kilometres).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scania</ns0:orth>
        <ns0:pron>/ˈskæni.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A former province, historical region, and peninsula in Sweden, roughly coterminous with Skåne County and occupying the southern tip of the Scandinavian Peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scarborough Shoal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Bajo de Masinloc</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A shoal in the South China Sea, including South Rock, etc..</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scheherazade</ns0:orth>
        <ns0:pron>/ʃəˈhɛɹəzɑd/</ns0:pron>
        <ns0:pron>/ʃəˌhɛɹəˈzɑːd(ə)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Scheherezade</ns0:quote>
          <ns0:quote>Scheherezada</ns0:quote>
          <ns0:quote>Sherazade</ns0:quote>
          <ns0:quote>Sherezade</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scheldt</ns0:orth>
        <ns0:pron>/skɛlt/</ns0:pron>
        <ns0:pron>/ʃɛlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escalda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river flowing through France, Belgium and the Netherlands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schengen Area</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espacio de Schengen</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(European politics) The group of European countries that have signed the Schengen Agreement, abolishing border controls between each other.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schlegel diagram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diagrama de Schlegel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) A projection of a polytope from n-dimensional space to n-1 dimensions through a point beyond one of its faces; especially such a projection (itself represented in 2 dimensions) of a 3- or 4-dimensional polytope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schlemm's canal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canal de Schlemm</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) a circular channel in the eye that collects aqueous humour from the anterior chamber and delivers it into the bloodstream; if it is blocked, a glaucoma results</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schleswig-Holstein</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Schleswig-Holstein</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of the component states of Germany according to the current administrative division of the nation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schneider</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sastre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from German [in turn originating as an occupation] meaning "tailor".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schrödinger's cat</ns0:orth>
        <ns0:pron>/ˌʃɹoʊdɪŋɚz ˈkæt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gato de Schrödinger</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The thought experiment which was devised by Erwin Schrödinger, is usually considered a paradox, involves a Schrödinger's cat and is typically supposed to be analysed from the point of view of quantum mechanics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schuko</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Schuko</ns0:quote>
          <ns0:quote>schuko</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(attributive) A type of electrical socket (or plug), consisting of two round holes (or pins) with ground contacts on top and bottom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Schumann</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Schumann</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scientologist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ciencióloga</ns0:quote>
          <ns0:quote>cienciólogo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of Scientology, whether belonging to the "official" Church of Scientology or being outside in the so-called Free Zone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scientology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cienciología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A belief system with certain religious aspects, developed in 1952, focused on the teachings of L. Ron Hubbard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scorpio</ns0:orth>
        <ns0:pron>/ˈskɔːpɪəʊ/</ns0:pron>
        <ns0:pron>/ˈskɔːɹpɪoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escorpiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone with a Scorpio star sign</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scorpio</ns0:orth>
        <ns0:pron>/ˈskɔːpɪəʊ/</ns0:pron>
        <ns0:pron>/ˈskɔːɹpɪoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escorpio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrology) The zodiac sign for the scorpion, ruled by Mars and covering October 23 - November 22 (tropical astrology) or November 16 - December 15 (sidereal astrology).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scorpius</ns0:orth>
        <ns0:pron>/ˈskɔːpɪəs/</ns0:pron>
        <ns0:pron>/ˈskɔːɹpɪəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escorpión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A constellation of the zodiac, roughly shaped like a scorpion. Its brightest star is the red giant Antares.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scot</ns0:orth>
        <ns0:pron>/ˈskɑt/</ns0:pron>
        <ns0:pron>/ˈskɒt/</ns0:pron>
        <ns0:pron>/ˈskɔʔ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escocés</ns0:quote>
          <ns0:quote>escocesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person born in or native to Scotland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scotch</ns0:orth>
        <ns0:pron>/skɑt͡ʃ/</ns0:pron>
        <ns0:pron>/skɒt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escoceses</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) The people of Scotland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scotch hands</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manos escocesas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Butter beaters; large wooden spatulas used when making butter, made out of sycamore wood, or metal, used for shaping the butter into bricks and for other miscellaneous manipulation. One side of the paddle will have ribs or be fluted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scotland</ns0:orth>
        <ns0:pron>/ˈskɑt.lənd/</ns0:pron>
        <ns0:pron>/ˈskɒt.lənd/</ns0:pron>
        <ns0:pron>/ˈskɔʔ.lənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escocia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A constituent country of the United Kingdom, located in northwest Europe to the north of England.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scots</ns0:orth>
        <ns0:pron>/skɒts/</ns0:pron>
        <ns0:pron>/ˈskɔts/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escocés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Germanic language closely related to English and descended from northern dialects of Middle English, spoken in parts of Scotland, now especially in the northeastern and southern regions of the country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Scots pine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pino albar</ns0:quote>
          <ns0:quote>pino silvestre</ns0:quote>
          <ns0:quote>pino de Valsaín</ns0:quote>
          <ns0:quote>pino rojo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pinus sylvestris, an evergreen of wide distribution in Eurasia in northern or mountainous areas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
