        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pastafarismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A parody religion centered around the Flying Spaghetti Monster, a creator deity who resembles spaghetti and meatballs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
