        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Muay thai</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(martial arts) A sport practiced in Thailand which is similar to boxing but also allows strikes with the shins, feet, elbows, and knees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mudéjar</ns0:orth>
      </ns0:form>
