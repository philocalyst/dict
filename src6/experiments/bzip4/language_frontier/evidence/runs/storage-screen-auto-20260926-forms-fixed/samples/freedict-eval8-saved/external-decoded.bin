        <ns0:pron>/ɔɡˈzɪl.i.ɛɹ.i/</ns0:pron>
        <ns0:pron>/ɔːkˈsɪl-/</ns0:pron>
        <ns0:pron>/ɔːɡˈzɪl.(j)ə.ɹi/</ns0:pron>
        <ns0:pron>/ɔːɡˈzɪl.i.ə.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxiliar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Supplementary or subsidiary.</ns0:def>
        </ns0:sense>
