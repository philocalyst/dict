        <ns0:pron>/ˈɡɹinwɪt͡ʃ/</ns0:pron>
        <ns0:pron>/ˈɡɹɛnɪt͡ʃ/</ns0:pron>
        <ns0:pron>/ˈɡɹɪn-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Greenwich</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A royal borough in Greater London, which includes the town.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A town on the south bank of the River Thames in south-east Greater London, England, through which the prime meridian passes (OS grid ref TQ3877).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
