        <ns0:pron>/ˈæ.sɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acil</ns0:quote>
          <ns0:quote>acilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any of class of organic radicals, RCO-, formed by the removal of a hydroxyl group from a carboxylic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acylation</ns0:orth>
        <ns0:pron>/ˌeɪsɪˈleɪʃən/</ns0:pron>
