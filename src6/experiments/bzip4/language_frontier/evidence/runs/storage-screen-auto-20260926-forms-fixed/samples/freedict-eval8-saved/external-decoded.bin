    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aorist</ns0:orth>
        <ns0:pron>/ˈeɪ.ə.ɹɪst/</ns0:pron>
        <ns0:pron>/ˈɛə.ɹɪst/</ns0:pron>
        <ns0:pron>/ˈɛəɹɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aoristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) Of or pertaining to a verb in the aorist aspect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aorist</ns0:orth>
        <ns0:pron>/ˈeɪ.ə.ɹɪst/</ns0:pron>
        <ns0:pron>/ˈɛə.ɹɪst/</ns0:pron>
        <ns0:pron>/ˈɛəɹɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aoristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A verb paradigm found in certain languages, usually an unmarked form or one that expresses the perfective or aorist aspect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aorist aspect</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aoristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A temporal feature of the verb which denotes the speaker's standpoint of the event described by the verb, as from outside of the event and seeing it as a completed whole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aorta</ns0:orth>
        <ns0:pron>/eɪˈɔɹtə/</ns0:pron>
        <ns0:pron>/eɪˈɔːtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aorta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The great artery which carries the blood from the heart to all parts of the body except the lungs; the main trunk of the arterial system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
