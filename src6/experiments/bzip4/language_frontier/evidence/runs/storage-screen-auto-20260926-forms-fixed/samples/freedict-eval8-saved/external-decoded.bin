      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Catamarca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province in northwestern Argentina.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Catanzaro</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Catanzaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city and province of Calabria, Italy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Catch-22</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>problema circular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) A difficult situation from which there is no escape because it involves mutually conflicting or dependent conditions.</ns0:def>
        </ns0:sense>
