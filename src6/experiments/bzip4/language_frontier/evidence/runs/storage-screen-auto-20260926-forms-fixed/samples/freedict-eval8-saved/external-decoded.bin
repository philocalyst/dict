        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sea of Japan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar del Japón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marginal sea between Japan, Sakhalin, the Asian continent, and Jeju Island.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sea of Marmara</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar de Mármara</ns0:quote>
          <ns0:quote>Mar de Mármara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A deep inland sea in north-western Turkey connecting the Black Sea to the Aegean Sea via the straits of Bosphorus and Dardanelles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sea of Okhotsk</ns0:orth>
        <ns0:pron>/ˌsiː əv əˈxɒtsk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar de Ojotsk</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sea between the Kamchatka Peninsula on the east, the Kuril Islands on the southeast, the island of Hokkaidō to the far south, the island of Sakhalin along the west, and a long stretch of eastern Siberian coast along the west and north.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sealand</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Principado de Sealand</ns0:quote>
          <ns0:quote>Sealand</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hamlet and community in Flintshire, Wales, close to Chester in England (OS grid ref SJ3568). It is on land reclaimed from the sea on the Chester side of the River Dee.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sean</ns0:orth>
        <ns0:pron>/ʃɔːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Juan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Seattle</ns0:orth>
        <ns0:pron>/siˈætl̩/</ns0:pron>
        <ns0:pron>[-ɾɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Seattle</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A seaport and the largest city in Washington, United States, and the county seat of King County.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Seax-Wicca</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wicca sajona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A denomination of Wicca blended with modernized Anglo-Saxon paganism, founded by Raymond Buckland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sebastia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sebastia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A village in Nablus Governorate, West Bank, Palestine; the former capital of the Kingdom of Israel; formerly, Samaria (archeological site).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sebastian</ns0:orth>
        <ns0:pron>/səˈbæst͡ʃən/</ns0:pron>
        <ns0:pron>/sɪˈbæs.tʃən/</ns0:pron>
        <ns0:pron>/sɪˈbæsti.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sebastián</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Second Spanish Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Segunda República Española</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former country, the name for a leftist state in Europe and Africa that existed from 1931 to 1939.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Second World</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>segundo mundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Those countries aligned with the East during the Cold War, particularly in contrast to those aligned with the West (First World).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Segorbe</ns0:orth>
        <ns0:pron>/sɛˈɡɔːbeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
