        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metrology) A standard set of units of measurement for use in scientific literature worldwide. The newest and most widespread version of the metric system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International Women's Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>8M</ns0:quote>
          <ns0:quote>día internacional de la mujer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A holiday celebrated on March 8, with a focus on women's liberation, rights, class struggle, and femininity in general.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Internationale</ns0:orth>
