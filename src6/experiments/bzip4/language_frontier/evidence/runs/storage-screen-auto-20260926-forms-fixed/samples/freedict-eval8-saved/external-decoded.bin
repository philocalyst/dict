      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archivero</ns0:quote>
          <ns0:quote>archivista</ns0:quote>
          <ns0:quote>archivera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is in charge of, or performs the task of creating, collecting, cataloguing and organising archives.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archlute</ns0:orth>
      </ns0:form>
