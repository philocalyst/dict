      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>equilibrio de Nash</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(game theory) The set of choices of players' strategies for which no player can benefit by changing his or her strategy assuming that the other players keep theirs unchanged.</ns0:def>
