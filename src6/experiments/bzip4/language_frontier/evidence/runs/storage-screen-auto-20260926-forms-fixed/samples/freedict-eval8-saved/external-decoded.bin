    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mass</ns0:orth>
        <ns0:pron>/ˈmæs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>misa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Roman Catholic Church) The principal liturgical service of the Church, encompassing both a scripture service (Liturgy of the Word) and a eucharistic service (Liturgy of the Eucharist), which includes the consecration and oblation (offering) of the host and wine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
