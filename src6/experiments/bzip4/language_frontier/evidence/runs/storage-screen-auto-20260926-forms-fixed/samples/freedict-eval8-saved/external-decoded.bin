      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pancho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A moon in Uranus, Solar System.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Franco-</ns0:orth>
        <ns0:pron>/ˈfɹæŋ.koʊ/</ns0:pron>
