        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>hairstyle characterized by tightly curled locks and a rounded shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afrobeat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afrobeat</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music genre) Music that combines West African musical styles (such as traditional Yoruba music and highlife) with American funk, jazz, and soul influences, with a focus on chanted vocals, complex intersecting rhythms, and percussion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
