          <ns0:quote>monaguillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A boy serving as an acolyte in certain forms of Christianity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altar wine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
