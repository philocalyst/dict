      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azurita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A blue vitreous mineral; a basic hydrated copper carbonate, with the chemical formula Cu2+3(CO3)2(OH)2, used since antiquity as a blue pigment or ores to extract metallic copper.</ns0:def>
