      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archienemigo</ns0:quote>
          <ns0:quote>mayor enemigo</ns0:quote>
          <ns0:quote>peor enemigo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A principal enemy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archeologically</ns0:orth>
      </ns0:form>
