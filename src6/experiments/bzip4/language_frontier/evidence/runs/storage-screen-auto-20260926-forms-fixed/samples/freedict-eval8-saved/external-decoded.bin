        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manchuriano</ns0:quote>
          <ns0:quote>manchuriana</ns0:quote>
          <ns0:quote>manchurianas</ns0:quote>
          <ns0:quote>manchurianos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An inhabitant of Manchuria, especially one who is not of Han Chinese origin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mancunian</ns0:orth>
