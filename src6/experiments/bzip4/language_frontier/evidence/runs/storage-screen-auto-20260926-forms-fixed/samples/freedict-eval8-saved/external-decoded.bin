      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balánico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to the glans penis or to the glans clitoridis</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
