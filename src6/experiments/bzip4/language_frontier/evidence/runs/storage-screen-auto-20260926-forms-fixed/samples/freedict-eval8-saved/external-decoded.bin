        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated, euphemistic) Syphilis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French honeysuckle</ns0:orth>
      </ns0:form>
