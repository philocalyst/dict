          <ns0:quote>cuarto Reich</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hypothetical resurrection of Nazi Germany (Third Reich).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fourth World</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuarto mundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Hopi religion) Synonym of Túwaquachi.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(informal, derogatory, attributive) A notional standard of living or level of development lower than that in the stereotyped Third World.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fourth of July</ns0:orth>
        <ns0:pron>/-d͡ʒu-/</ns0:pron>
        <ns0:pron>/ˌfɔɹθ‿əv d͡ʒəˈlaɪ/</ns0:pron>
        <ns0:pron>/ˌfɔːθ‿əv d͡ʒʊˈlaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cuatro de julio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The national holiday of Independence Day in the United States, celebrated on the fourth day in July to mark the anniversary of the signing of the Declaration of Independence from Great Britain in 1776.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
