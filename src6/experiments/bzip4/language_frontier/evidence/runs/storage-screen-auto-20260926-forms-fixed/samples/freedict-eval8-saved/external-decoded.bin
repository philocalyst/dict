      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>semejante</ns0:quote>
          <ns0:quote>afín</ns0:quote>
          <ns0:quote>análogo</ns0:quote>
          <ns0:quote>consanguíneo</ns0:quote>
          <ns0:quote>emparentado</ns0:quote>
          <ns0:quote>parejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
