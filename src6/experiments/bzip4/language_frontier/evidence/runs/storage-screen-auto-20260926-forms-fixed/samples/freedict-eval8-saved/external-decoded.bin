      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambulatorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or adapted to walking.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) Performed on or involving an outpatient.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambulatory</ns0:orth>
        <ns0:pron>/-bjʊ-/</ns0:pron>
        <ns0:pron>/ˈam.bjə.ləˌtoɹ.i/</ns0:pron>
        <ns0:pron>/ˌæm.bjəˈleɪ.tɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deambulatorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The round walkway encircling the altar in many cathedrals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambulophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambulofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fear of walking or standing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambush</ns0:orth>
        <ns0:pron>/ˈæm.bʊʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encerrona</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calada</ns0:quote>
          <ns0:quote>emboscada</ns0:quote>
          <ns0:quote>zalagarda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of concealing oneself and lying in wait to attack or kill by surprise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>emboscada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An attack launched from a concealed position.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambush</ns0:orth>
        <ns0:pron>/ˈæm.bʊʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>emboscar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To station in ambush with a view to surprise an enemy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To attack by ambush; to waylay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ameban</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amebiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or resembling an amoeba.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amelia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amelia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The congenital absence of one or more limbs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ameliorate</ns0:orth>
        <ns0:pron>/əˈmiːli.əɹeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make better, or improve, something perceived to be in a negative condition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amelioration</ns0:orth>
        <ns0:pron>/əˌmiːliəˈɹeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejora</ns0:quote>
          <ns0:quote>mejoramiento</ns0:quote>
          <ns0:quote>mejoría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of making better.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An improvement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amelogenin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amelogenina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A protein found in the enamel of teeth</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amen</ns0:orth>
        <ns0:pron>/(ˌ)eɪˈmɛn/</ns0:pron>
        <ns0:pron>/(ˌ)ɑːˈmɛn/</ns0:pron>
        <ns0:pron>/ˈeɪmɛn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At the end of religious prayers: so be it.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(colloquial) Used to indicate emphatic agreement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amenable</ns0:orth>
        <ns0:pron>/əˈmin.ə.bəl/</ns0:pron>
        <ns0:pron>/əˈmiːnəbəl/</ns0:pron>
        <ns0:pron>/əˈmɛn.ə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>receptivo</ns0:quote>
          <ns0:quote>susceptible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Willing to respond to persuasion or suggestions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agradable</ns0:quote>
          <ns0:quote>dócil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Liable to be brought to account, to a charge or claim; responsible; accountable; answerable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amend</ns0:orth>
        <ns0:pron>/əˈmɛnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejorar</ns0:quote>
          <ns0:quote>corregir</ns0:quote>
          <ns0:quote>emendar</ns0:quote>
          <ns0:quote>remendar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make better; improve.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To become better.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete, intransitive) To be healed, to be cured, to recover (from an illness).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enmendar</ns0:quote>
          <ns0:quote>emendar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make a formal alteration (in legislation, a report, etc.) by adding, deleting, or rephrasing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amendable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enmendable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being amended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amendment</ns0:orth>
        <ns0:pron>/əˈmɛndmənt/</ns0:pron>
        <ns0:pron>/ʌˈmɛnd.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enmienda</ns0:quote>
          <ns0:quote>enmendación</ns0:quote>
          <ns0:quote>enmendadura</ns0:quote>
          <ns0:quote>enmendamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In public bodies, any alteration made or proposed to be made in a bill or motion that adds, changes, substitutes, or omits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enmienda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which is added; that which is used to increase or supplement something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amends</ns0:orth>
        <ns0:pron>/əˈmɛndz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compensación</ns0:quote>
          <ns0:quote>desagravio</ns0:quote>
          <ns0:quote>reparación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Compensation for an injury or loss; recompense; reparation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amenity</ns0:orth>
        <ns0:pron>/əˈmiːnəti/</ns0:pron>
        <ns0:pron>/əˈmɛnəti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comodidad</ns0:quote>
          <ns0:quote>amenidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pleasantness.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A thing or circumstance that is welcome and makes life a little easier or more pleasant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>infraestructura</ns0:quote>
          <ns0:quote>instalación</ns0:quote>
          <ns0:quote>servicio</ns0:quote>
          <ns0:quote>servicio público</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cartography) A unit pertaining to the infrastructure of a community, such as a public toilet, a postbox, a library, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amenorrhoea</ns0:orth>
        <ns0:pron>/əˌmɛnəˈɹiːə/</ns0:pron>
