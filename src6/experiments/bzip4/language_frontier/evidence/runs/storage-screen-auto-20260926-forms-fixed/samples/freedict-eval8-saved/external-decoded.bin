      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pluvioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The fifth month of the French Republican Calendar, from January 20, 21 or 22 to February 18, 19 or 20.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
