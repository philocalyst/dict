        <ns0:pron>/ˈsʊni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>suní</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Belonging or relating to the branch of Islam based on the Qur'an, the Kutub al-Sittah (the hadiths which record the Sunnah) and that places emphasis on the Sahabah.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
