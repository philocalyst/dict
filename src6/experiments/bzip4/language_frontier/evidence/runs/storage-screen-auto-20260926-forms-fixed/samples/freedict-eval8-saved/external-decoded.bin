      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salomonense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Somebody from the Solomon Islands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Solomon Islands</ns0:orth>
        <ns0:pron>/ˈsɑ.lə.mən ˈaɪ.ləndz/</ns0:pron>
        <ns0:pron>/ˈsɒl.ə.mən ˈaɪ.ləndz/</ns0:pron>
        <ns0:pron>/ˈsɒləmən ˈaɪləndz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Islas Salomón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country consisting of the majority of the Solomon Islands archipelago in Melanesia, in Oceania, as well as the Santa Cruz Islands. Official name: Solomon Islands. Capital and largest city: Honiara.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Solon</ns0:orth>
        <ns0:pron>/ˈsoʊlən/</ns0:pron>
