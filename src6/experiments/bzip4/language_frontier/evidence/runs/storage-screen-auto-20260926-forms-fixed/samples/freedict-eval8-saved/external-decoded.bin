        <ns0:pron>/pɛˈtɹɑɹkɪzəm/</ns0:pron>
        <ns0:pron>/pɪˈtɹɑːkɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>petrarquismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The literary style of Petrarch.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
