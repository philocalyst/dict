      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Silicon Valley</ns0:quote>
          <ns0:quote>Valle del Silicio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Originally, the region of the San Francisco Bay Area in which there were a high number of industries producing silicon chips; later extended to mean the entire concentration of high-tech businesses in this area.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
