          <ns0:quote>eurófoba</ns0:quote>
          <ns0:quote>eurófobo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who dislikes Europe or the European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
