        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basilisco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(heraldiccharge) A type of dragon used in heraldry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any tree-dwelling lizard of the genus Basiliscus: the basilisk lizard.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(artillery) A type of large brass cannon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basin</ns0:orth>
        <ns0:pron>/ˈbeɪs(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lavabo</ns0:quote>
          <ns0:quote>lavamanos</ns0:quote>
          <ns0:quote>jofaina</ns0:quote>
          <ns0:quote>palangana</ns0:quote>
          <ns0:quote>pileta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wide bowl for washing, sometimes affixed to a wall.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) An area of land from which water drains into a common outlet; drainage basin.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geography) A shallow depression in a rock formation, such as an area of down-folded rock that has accumulated a thick layer of sediments, or an area scooped out by water erosion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basionym</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basiónimo</ns0:quote>
          <ns0:quote>basónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, taxonomy) An earlier valid scientific name of a species that has since been renamed and from which the new name is partially derived.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basis</ns0:orth>
