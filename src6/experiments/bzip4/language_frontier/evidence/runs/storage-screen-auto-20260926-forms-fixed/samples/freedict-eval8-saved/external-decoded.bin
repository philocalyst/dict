      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>menonista</ns0:quote>
          <ns0:quote>menonita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
