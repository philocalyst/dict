        <ns0:orth>acene</ns0:orth>
        <ns0:pron>/ˈeɪsiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceno</ns0:quote>
          <ns0:quote>poliaceno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any polycyclic aromatic hydrocarbon containing a rectilinear arrangement of fused benzene rings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
