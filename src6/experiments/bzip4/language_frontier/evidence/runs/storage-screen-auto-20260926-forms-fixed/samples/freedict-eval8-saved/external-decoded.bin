        <ns0:pron>/ˈzuːluː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zulú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
