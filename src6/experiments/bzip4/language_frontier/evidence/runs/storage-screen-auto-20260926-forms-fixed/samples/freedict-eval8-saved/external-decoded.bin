        <ns0:pron>/əˈbɔlɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abolir</ns0:quote>
          <ns0:quote>abrogar</ns0:quote>
          <ns0:quote>quitar</ns0:quote>
          <ns0:quote>suprimir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To end a law, system, institution, custom or practice. [First attested from around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>destrozar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) To put an end to or destroy, as a physical object; to wipe out. [First attested from around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
