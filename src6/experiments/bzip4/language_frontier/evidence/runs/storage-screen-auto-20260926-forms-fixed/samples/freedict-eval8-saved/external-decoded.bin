      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistir</ns0:quote>
          <ns0:quote>ayudar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To help.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) To help compensate for what is missing with the help of a medical technique or therapy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) To make a pass that leads directly towards scoring.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
