      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arzobispo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A senior bishop who is in charge of an archdiocese, and presides over a group of dioceses called a province (in Catholicism, Eastern Orthodoxy, Anglicanism, etc.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
