    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Italian</ns0:orth>
        <ns0:pron>/aɪˈtæliən/</ns0:pron>
        <ns0:pron>/ɪˈtæliən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>italiano</ns0:quote>
          <ns0:quote>italiana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to Italy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Pertaining to its people or their cultures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>italiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to their language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Italian</ns0:orth>
        <ns0:pron>/aɪˈtæliən/</ns0:pron>
        <ns0:pron>/ɪˈtæliən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>italiano</ns0:quote>
          <ns0:quote>italiana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An inhabitant of Italy, or a person of Italian descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>italiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The official language of Italy, also spoken in San Marino, the Vatican, and parts of Argentina, Slovenia and Switzerland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Italian Peninsula</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>península Apenina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large peninsula in Southern Europe protruding into the Mediterranean Sea and shaped like a boot. The mountain range of Apennines runs across it from north to south. Occupied almost entirely by Italy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
