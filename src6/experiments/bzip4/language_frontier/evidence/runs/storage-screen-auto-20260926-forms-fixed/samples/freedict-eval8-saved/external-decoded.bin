        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acimut</ns0:quote>
          <ns0:quote>azimut</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An arc of the horizon intercepted between the meridian of the place and a vertical circle passing through the center of any object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
