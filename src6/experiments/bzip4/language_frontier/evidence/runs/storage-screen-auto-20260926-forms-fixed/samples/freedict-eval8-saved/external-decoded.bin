        <ns0:sense>
          <ns0:def>(historical) A former province in southeastern France, centred on Grenoble.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Davao City</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dávao</ns0:quote>
          <ns0:quote>Nueva Vergara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An independent city, the largest city in Davao del Sur, Philippines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Davao Region</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Región de Davao</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A region of the Philippines. Capital: Davao City.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>David</ns0:orth>
        <ns0:pron>/ˈdeɪvəd/</ns0:pron>
        <ns0:pron>/ˈdeɪvɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>David</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The second king of Judah and Israel, the successor of King Saul in the Hebrew Bible; the son of Jesse and the father of Nathan and King Solomon.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(rare) A en given name, often combined with a feminine middle name (e.g. David Ann).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Davidic</ns0:orth>
        <ns0:pron>/dəˈvɪdɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>davídico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) Of, or relating to the Biblical King David and his descendants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Davos</ns0:orth>
        <ns0:pron>/ˈdævɒs/&lt;a:UK&gt;&lt;ref:{{cite-web|author=Geoff Lindsey|author2=Péter Szigetvári|work=CUBE|url=http://seas3.elte.hu/cube/index.pl?s=davos|year=2013–}}&gt;</ns0:pron>
        <ns0:pron>/ˈdɑːvoʊs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Davos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mountain resort and municipality in Grisons, Switzerland, host of the World Economic Forum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>foro de Davos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metonymy) An annual meeting of business leaders, major politicians, economists, and other celebrities hosted by the World Economic Forum in the town of Davos, Switzerland at the end of January.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dead Sea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar Muerto</ns0:quote>
          <ns0:quote>Mar Muerto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lake in the Middle East in Palestine and Jordan, noted for high salinity and for its banks being the lowest land-based elevation on Earth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Death</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>muerte</ns0:quote>
          <ns0:quote>Muerte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The personification of death, often a skeleton with a scythe, and one of the four horsemen of the apocalypse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Death Valley</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Valle de la Muerte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A valley in eastern California, remarkable for being the lowest-elevated place in North America, and the hottest place on Earth during summer.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A national park in California and Nevada that includes said valley.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Debaltseve</ns0:orth>
        <ns0:pron>/dɛˈbaltsɛveɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Debáltseve</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the administrative centre of Debaltseve urban hromada, Horlivka Raion, Donetsk Oblast, Ukraine, founded as a railway station in 1878, controlled by the Donetsk People’s Republic since the conclusion of the Battle of Debaltseve in February 2015.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Deborah</ns0:orth>
        <ns0:pron>/ˈdɛb(ə)ɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Débora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) A judge of Israel.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biblical character) A nurse of Rebecca.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name, popular from the 1940s to the 1970s, first in the USA, then in the UK.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Decalogue</ns0:orth>
        <ns0:pron>/ˈdɛkəlɒɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decálogo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any set of rules that have the weight of authority</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Decameron</ns0:orth>
        <ns0:pron>/dɪˈkaməɹən/</ns0:pron>
        <ns0:pron>/dɪˈkæməɹɑn/</ns0:pron>
        <ns0:pron>/dɪˈkæməɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Decamerón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A collection of 100 short stories by Italian author Giovanni Boccaccio, probably begun in 1350 and finished in 1353.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>December</ns0:orth>
        <ns0:pron>/dɪˈsɛm.bɚ/</ns0:pron>
        <ns0:pron>/dɪˈsɛmbə/</ns0:pron>
        <ns0:pron>/dɪˈzɛmbə/</ns0:pron>
        <ns0:pron>/ɖɪsəmˈbɜ(r)/</ns0:pron>
        <ns0:pron>/ɖɪˈsɛmbə(r)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diciembre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The twelfth and last month of the Gregorian calendar, following November and preceding the January of the following year, containing the southern solstice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Decembrist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decembrista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>According to or derived from the politics or philosophy of the Decembrists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Decembrist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decembrista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A participant in, or sympathizer with, the Decembrist revolt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Deep South</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sur profundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of cultural and geographic subregions in the American South, typically consisting of Georgia, Florida, South Carolina, Alabama, Mississippi, Louisiana, and Texas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Deepika</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Deepika</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Deimos</ns0:orth>
        <ns0:pron>/ˈdaɪməs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Deimos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) A son of Ares (Latin: Mars), god of terror.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) The outermost natural satellite of Mars.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delaware</ns0:orth>
        <ns0:pron>/ˈdɛləweə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈdɛləwɛɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Delaware</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first state of the United States. Capital: Dover. Largest city: Wilmington.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A river in the United States that flows from northeast Kansas into the Kansas River.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delete</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>suprimir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A key that may be pressed to delete something (such as text or files) from a computer. The key also erases text from left to right, unlike the backspace key.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delhi</ns0:orth>
        <ns0:pron>/dɪlˈ(h)iː/</ns0:pron>
        <ns0:pron>/ˈdɛl.(h)i/</ns0:pron>
        <ns0:pron>/ˈdɛl.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Delhi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A megacity and union territory of India, containing the national capital New Delhi.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delhi Sultanate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sultanato de Delhi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Islamic empire based in Delhi from 1206 to 1526 that stretched over large parts of the Indian subcontinent, ruled over by five successive dynasties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delicias de Concepción</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Delicias de Concepción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town in Morazán department, El Salvador.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delilah</ns0:orth>
        <ns0:pron>/dɪˈlaɪlə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dalila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The mistress of Samson who betrayed him to the Philistines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delphi</ns0:orth>
        <ns0:pron>/ˈdɛlfi/</ns0:pron>
        <ns0:pron>[ˈdɛɫfi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Delfos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city of ancient Greece, the site of the Delphic oracle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delphic</ns0:orth>
        <ns0:pron>/ˈdɛlfɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>délfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Delphi or its oracles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Delphinus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Delphinus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A small summer constellation of the northern sky, said to resemble a dolphin. It lies between the constellations Cygnus and Aquila.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Deluge</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diluvio universal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Abrahamic, _, religion) The flood taking place in the story of Noah found in the Bible (Genesis) and Qur'an.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Demeter</ns0:orth>
        <ns0:pron>/dəˈmiːtəɹ/</ns0:pron>
        <ns0:pron>/dɪˈmiːtə/</ns0:pron>
        <ns0:pron>/ˈdɛmɪtəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Deméter</ns0:quote>
          <ns0:quote>Demetra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The goddess of the fertility of the Earth and harvests, protector of marriage and social order; daughter of Cronos and Rhea, mother to Persephone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Demetrius</ns0:orth>
        <ns0:pron>/dɪˈmiːtɹɪəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Demetrio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
