    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eurocentrism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurocentrismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The practice of viewing the world from a European perspective, with an implied belief, either consciously or subconsciously, in the preeminence of European culture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eurocommunism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurocomunismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ideological trend within various Western European communist parties in the 1970s and 1980s; a form of communism less aligned with Soviet communism and allegedly more relevant to Western European social conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eurocommunist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurocomunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A supporter of Eurocommunism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eurocommunistic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurocomunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to or characteristic of Eurocommunism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eurogroup</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurogrupo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(European politics) The informal body composed of the finance ministers of the countries in the Eurozone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eurolinguistics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eurolingüística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) A young branch of linguistics which deals with questions on the languages of Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Euromaidan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Euromaidán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A series of antigovernment protests in Ukraine that started in November 2013.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Europa</ns0:orth>
        <ns0:pron>/jʊˈɹoʊpə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Europa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) Several characters, most notably a Phoenician princess abducted to Crete by Zeus.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) A moon in Jupiter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Europe</ns0:orth>
        <ns0:pron>/ˈjoː.ɹəp/</ns0:pron>
        <ns0:pron>/ˈjurop/</ns0:pron>
        <ns0:pron>/ˈjurəp/</ns0:pron>
        <ns0:pron>/ˈjɔː.ɹəp/</ns0:pron>
        <ns0:pron>/ˈjɝ.əp/</ns0:pron>
        <ns0:pron>/ˈjʉə.ɹəp/</ns0:pron>
        <ns0:pron>/ˈjʊə.ɹəp/</ns0:pron>
        <ns0:pron>/ˈjʊɚ.əp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Europa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A continent located west of Asia (separated by the Urals), north of Africa and east of the Atlantic Ocean.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A political entity; the European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European</ns0:orth>
        <ns0:pron>/(ˌ)jʊə.ɹəˈpiː.ən/</ns0:pron>
        <ns0:pron>/(ˌ)jʊə.ɹəˈpɪ.ən/</ns0:pron>
        <ns0:pron>/juˈropɪjən/</ns0:pron>
        <ns0:pron>/ˌjɝ.əˈpi.ən/</ns0:pron>
        <ns0:pron>/ˌjʊɚ.əˈpi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>europeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Related to Europe.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Related to the European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European</ns0:orth>
        <ns0:pron>/(ˌ)jʊə.ɹəˈpiː.ən/</ns0:pron>
        <ns0:pron>/(ˌ)jʊə.ɹəˈpɪ.ən/</ns0:pron>
        <ns0:pron>/juˈropɪjən/</ns0:pron>
        <ns0:pron>/ˌjɝ.əˈpi.ən/</ns0:pron>
        <ns0:pron>/ˌjʊɚ.əˈpi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>europeo</ns0:quote>
          <ns0:quote>europea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person living or originating from Europe.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person who resides within the European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European Central Bank</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Banco Central Europeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Central bank for the European Union, administering the monetary policy of the 17 EU Eurozone member states.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European Commission</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Comisión Europea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The executive branch of the European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European Council</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Consejo Europeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>an institution of the European Union (EU) charged with defining the EU's overall political direction and priorities, that comprises the heads of state or government of the member states, along with the President of the European Council and the President of the European Commission</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European Economic Area</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Espacio Económico Europeo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European Parliament</ns0:orth>
        <ns0:pron>/jʊˈroʊpiən ˈpɑrləmənt/</ns0:pron>
        <ns0:pron>/jʊˈrəʊpiən ˈpɑːrləmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Parlamento Europeo</ns0:quote>
          <ns0:quote>Cámara Europea</ns0:quote>
          <ns0:quote>Eurocámara</ns0:quote>
          <ns0:quote>Europarlamento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) A legislative chamber of the European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European Union</ns0:orth>
        <ns0:pron>/ˌjɔːɹəˈpiːən ˈjuːnjən/</ns0:pron>
        <ns0:pron>/ˌjɝɹəˈpi.ən ˈjunjən/</ns0:pron>
        <ns0:pron>/ˌjʊəɹəˈpiːən ˈjuːnjən/</ns0:pron>
        <ns0:pron>/ˌjʊɹəˈpiən ˈjunjən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Unión Europea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A supranational organisation, consisting of 27 member states, created in the 1950s to bring the nations of Europe into closer economic and political connection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>European bison</ns0:orth>
