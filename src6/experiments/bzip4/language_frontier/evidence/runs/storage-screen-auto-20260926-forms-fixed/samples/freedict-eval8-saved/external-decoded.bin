        <ns0:sense>
          <ns0:def>A region of the Occitania region, France, approximately coterminous with Pyrénées-Orientales, that was once a part of Catalonia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rovaniemi</ns0:orth>
        <ns0:pron>/ˈɹəʊvənɪəmɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rovaniemi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and municipality in Lapland, Finland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Roxana</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Roxana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The wife of Alexander the Great.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Royal Navy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Marina Real</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, nautical) The naval warfare force of the United Kingdom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rube Goldberg machine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Máquina de Rube Goldberg</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A comical, overcomplicated machine which performs a simple task.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rubicon</ns0:orth>
        <ns0:pron>/-k(ə)n/</ns0:pron>
        <ns0:pron>/ˈɹubəˌkɑn/</ns0:pron>
        <ns0:pron>/ˈɹuːbɪkɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rubicón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A small river in northeastern Italy which flowed into the Adriatic Sea marking the boundary between the Roman province of Gaul and the Roman heartland. Its crossing by Julius Caesar in 49 B.C.E. began a civil war.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rubik's cube</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cubo de Rubik</ns0:quote>
          <ns0:quote>cubo mágico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mechanical puzzle in the shape of a cube, all sides able to be rotated, each side divided into 9 squares, the moving pieces allowing the cube to be rearranged. The goal is to get the colored squares aligned so that each side of the cube is the same color.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rubio</ns0:orth>
        <ns0:pron>/ˈɹubioʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rubio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from Spanish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rudolph</ns0:orth>
        <ns0:pron>/ˈɹuːdɒ(l)f/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rodolfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rudolph the Red-Nosed Reindeer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rodolfo el reno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A legendary reindeer with a nose that glows red, the subject of a comic Christmas song; often added among Santa Claus's reindeer as the leading one.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rudolphine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rudolfino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to Rudolf II, Holy Roman Emperor (1552–1612). [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rumelia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rumelia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former region comprising the territories of the Ottoman Empire in Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rumpelstiltskin</ns0:orth>
        <ns0:pron>/ˌɹʌmpəlˈstɪltskɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>El enano saltarín</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rupelian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rupeliense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, paleontology) A subdivision of the Oligocene epoch.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ruritanian</ns0:orth>
        <ns0:pron>/ˌɹʊə.ɹɪˈteɪ.ni.ən/</ns0:pron>
        <ns0:pron>/ˌɹʊɹ.ɪˈteɪ.ni.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quimérico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or having the characteristics of adventure, romance, and intrigue, as in works of romantic fiction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Rus</ns0:orth>
        <ns0:pron>/ɹuːs/</ns0:pron>
        <ns0:pron>/ɹʌs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A people made up of Scandinavian warrior merchants who travelled Eastern European river-roads from the eighth century, and whose settlements around Novgorod, Kiev/Kyiv and the Volga and Dnieper/Dnipro gave rise to the Rus' principalities. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rutenia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Kievan Rus, the medieval East Slavic state established by these same warrior merchants in the 9th century, whose capital was in Kiev.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ruscism</ns0:orth>
        <ns0:pron>/ˈɹʌʃɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ruscismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, neologism, slang, derogatory) Russian fascism, Russianism, Great Russian chauvinism; the ideology of Russia, seen as fascism or as fascist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russia</ns0:orth>
        <ns0:pron>/ˈɹʊ.ʃɐ/</ns0:pron>
        <ns0:pron>/ˈɹʌ.ʃɐ/</ns0:pron>
        <ns0:pron>/ˈɹʌʃə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rusia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transcontinental country in Eastern Europe and North Asia. Official name: Russian Federation. Capital and largest city: Moscow. It borders the Pacific and Arctic Oceans and the Baltic, Black, and Caspian Seas. Part of the Soviet Union from 1917 through 1991.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian</ns0:orth>
        <ns0:pron>/ˈɹʌʃ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ruso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Russia or Russians.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or pertaining to the Russian language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian</ns0:orth>
        <ns0:pron>/ˈɹʌʃ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ruso</ns0:quote>
          <ns0:quote>rusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An ethnic Russian; a member of the East Slavic ethnic group which is native to, and constitutes the majority of the population of, Russia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, obsolete) A person from the Soviet Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ruso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The Russian language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian Blue</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azul ruso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) A domestic cat of a breed with dense silver to grey fur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian Empire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Imperio ruso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The Russian state from 1721 to 1917.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian Far East</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lejano Oriente de Rusia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the Russian part of the East Asia, between Lake Baikal in Eastern Siberia and the Pacific Ocean</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian Federation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Federación Rusa</ns0:quote>
          <ns0:quote>Federación de Rusia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Russia: a transcontinental country in Eastern Europe and North Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian Orthodox Church</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iglesia ortodoxa rusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of the autocephalous Eastern Orthodox Christian churches.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian Soviet Federative Socialist Republic</ns0:orth>
        <ns0:pron>/ˈɹɐʃən ˈsɐʉviːət fedəɹətɪv ˈsɐʉʃəɫɪst ɹəˈpɐbɫɪk/</ns0:pron>
        <ns0:pron>/ˈɹʌʃən ˈsoʊvjət ˈfɛdɚˌɹeɪtɪv ˈsoʊʃəlɪst ɹəˈpʌblɪk/</ns0:pron>
        <ns0:pron>/ˈɹʌʃən ˈsɒvi.ət ˈfɛd(ə)ɹətɪv ˈsəʊʃəlɪst ɹɪˈpʌblɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Socialista Federativa Soviética de Rusia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The official name for modern-day Russia under the Communist Party from 1936 to 1991 (from 1918 to 1937, according to the Constitution of the RSFSR, called the Russian Socialist Federative Soviet Republic). Part of the USSR from 1922 to 1991.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian doll</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matrioska</ns0:quote>
          <ns0:quote>muñeca rusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of a set of hollow nesting dolls, usually wooden and decorated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian dressing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliño ruso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An American salad dressing, a spiced blend of mayonnaise and ketchup.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian roulette</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ruleta rusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, games) A deadly game in which a person loads a single bullet in the cylinder of a revolver, spins the cylinder so that the bullet's location is unknown, points the muzzle at his/her head, and pulls the trigger. In its most lethal form, played by multiple participants each of whom takes a turn until the weapon discharges.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russian-speaking</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hablando rusa</ns0:quote>
          <ns0:quote>hablando ruso</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Russianism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
