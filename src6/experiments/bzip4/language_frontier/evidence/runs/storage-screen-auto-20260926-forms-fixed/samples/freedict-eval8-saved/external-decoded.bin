          <ns0:quote>cristalera</ns0:quote>
          <ns0:quote>puerta ventana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) An outside door with glass panes, serving as a window and a door</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Frenchification</ns0:orth>
      </ns0:form>
