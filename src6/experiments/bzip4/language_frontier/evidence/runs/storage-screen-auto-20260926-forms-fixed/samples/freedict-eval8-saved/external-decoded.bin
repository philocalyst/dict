      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>urdu</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Modern Standard Urdu, an Indo-Aryan language with native speakers mainly in Pakistan and North India. It is a standardized and Persianized version of Hindustani.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
