      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>punto de Lagrange</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrophysics, orbital mechanics) A point in an orbital configuration of a two-body system where a small object affected only by gravity can theoretically be stationary relative to the two larger objects.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
