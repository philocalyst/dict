      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rajastán</ns0:quote>
          <ns0:quote>Rayastán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state in northwestern India, created in 1949 and replacing the former province of Rajputana. Capital: Jaipur. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
