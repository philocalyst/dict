        <ns0:pron>/ˌvɛn.ɪˈzweɪ.lə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Venezuela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in South America. Official name: Bolivarian Republic of Venezuela. Capital and largest city: Caracas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venezuelan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venezolano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Venezuela or the Venezuelan people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venezuelan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venezolano</ns0:quote>
          <ns0:quote>venezolana</ns0:quote>
          <ns0:quote>veneco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from Venezuela or of Venezuelan descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venezuelan equine encephalitis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encefalitis equina venezolana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mosquito-borne viral disease of equine species, also transmissible to humans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venice</ns0:orth>
        <ns0:pron>/ˈvɛnɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Venecia</ns0:quote>
          <ns0:quote>República de Venecia</ns0:quote>
          <ns0:quote>Serenísima República de Venecia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A port city and comune, the capital of the Metropolitan City of Venice and the region of Veneto, Italy; former capital of an independent republic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Venecia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A metropolitan city of Veneto, established in 2015; in full, the Metropolitan City of Venice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República de Venecia</ns0:quote>
          <ns0:quote>Serenísima República de Venecia</ns0:quote>
          <ns0:quote>Venecia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former province of Veneto.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical) A former polity in Europe, a republic and colonial empire around the Adriatic and eastern Mediterranean from CE 697 to 1797 with its capital at Venice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venmo</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bizumear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, informal) To use the Venmo peer-to-peer mobile payment system, originally principally for splitting bills such as for food, drinks, entertainment, and transportation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(ditransitive, informal) To transfer money to someone using the Venmo peer-to-peer mobile payment system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venn diagram</ns0:orth>
        <ns0:pron>/ˈvɛn ˌdaɪəɡɹæm/</ns0:pron>
        <ns0:pron>/ˈvɛn ˌdaɪɡɹæm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diagrama de Venn</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set theory) A diagram representing some sets by contours of closed shapes, such as circles or ellipses (and sometimes also the universal set as a rectangle enclosing all of these shapes), and indicating the relationships between the sets: by overlapping the shapes to show that the corresponding sets have a non-empty intersection, and by possibly (but not necessarily) enclosing all of the sets (which are proper subsets of the universal set) within a universal set (represented typically by a rectangle); such that the total number of simply connected regions is 2^n, where n is the number of depicted sets which are proper subsets of the universal set.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ventôse</ns0:orth>
        <ns0:pron>/vɑnˈtoʊz/</ns0:pron>
        <ns0:pron>/vɒ̃ˈtəʊz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The sixth month of the French Republican Calendar, from February 19, 20 or 21 to March 20 or 21.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venus</ns0:orth>
        <ns0:pron>/ˈvinəs/</ns0:pron>
        <ns0:pron>/ˈviːnəs/</ns0:pron>
        <ns0:pron>[ˈvinɪ̈s]</ns0:pron>
        <ns0:pron>[ˈvɛ.nɐs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Venus</ns0:quote>
