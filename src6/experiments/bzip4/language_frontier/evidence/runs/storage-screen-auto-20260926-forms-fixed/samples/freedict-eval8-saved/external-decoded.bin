      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mensa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A summer constellation of the southern sky, originally named after Table Mountain in South Africa. It lies between the constellations of Hydrus and Volans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
