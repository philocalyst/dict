        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>azoic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Destitute of any vestige of organic life, or at least of animal life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
