      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinturón</ns0:quote>
          <ns0:quote>cinturón de seguridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A band used as a restraint for safety purposes, such as a seat belt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>correa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A band that is used in a machine to help transfer motion or power.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golpe</ns0:quote>
          <ns0:quote>golpear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A powerful blow, often made with a fist or heavy object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinta</ns0:quote>
          <ns0:quote>cinturón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, capitalized) A geographical region known for a particular product, feature or demographic (Corn Belt, Bible Belt, Black Belt, Green Belt).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinturón</ns0:quote>
          <ns0:quote>correa</ns0:quote>
          <ns0:quote>cinto</ns0:quote>
          <ns0:quote>faja</ns0:quote>
          <ns0:quote>cincho</ns0:quote>
          <ns0:quote>pretina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(baseball) The part of the strike zone at the height of the batter's waist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
