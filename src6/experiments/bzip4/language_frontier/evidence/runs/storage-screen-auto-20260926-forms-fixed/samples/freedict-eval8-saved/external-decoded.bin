        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Leandro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The lover of Hero who swam every night across the Hellespont to meet her, and finally was drowned.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name, also of a Spanish sixth century saint.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
