        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acerbo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) Sour, bitter, and harsh to the taste, such as unripe fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acerbic</ns0:orth>
        <ns0:pron>/əˈsərbɪk/</ns0:pron>
        <ns0:pron>/əˈsɜː(ɹ)bɪk/</ns0:pron>
      </ns0:form>
