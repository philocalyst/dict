          <ns0:quote>Isla Príncipe Eduardo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province in eastern Canada. Capital: Charlottetown.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
