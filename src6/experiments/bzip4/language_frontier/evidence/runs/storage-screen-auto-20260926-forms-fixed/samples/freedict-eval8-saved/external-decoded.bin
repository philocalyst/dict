        <ns0:pron>/ˌtaɪfəˈnɑməki/</ns0:pron>
        <ns0:pron>/ˌtaɪfəˈnɒməki/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tifonomaquia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The battle between Zeus and the fearsome monster Typhon</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Tyrannosaurus rex</ns0:orth>
        <ns0:pron>/taɪˌɹænəˈsɔːɹəs ˈɹɛks/</ns0:pron>
        <ns0:pron>/təˌɹænəˈsɔːɹəs ˈɹɛks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tiranosaurio rex</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A giant carnivorous theropod dinosaur from the Cretaceous period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Tyre</ns0:orth>
        <ns0:pron>/ˈtaɪə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tiro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Lebanon, a major port on the Levantine Sea that was a city-state in Phoenicia in antiquity and the capital of the Kingdom of Jerusalem during the Middle Ages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
