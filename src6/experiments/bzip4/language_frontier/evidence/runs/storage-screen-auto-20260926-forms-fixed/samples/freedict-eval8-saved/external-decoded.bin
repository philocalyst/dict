      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspereza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality of having a rough or uneven surface; roughness, unevenness; (countable, chiefly, in the plural) a protruding or rough area or point on a surface; a protrusion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspereza</ns0:quote>
          <ns0:quote>asperidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality of being harsh or severe in the way one behaves or speaks toward another person; (countable, chiefly, in the plural) a deeply hostile or resentful feeling; an animosity, a hatred.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspermia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspermia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of infertility associated with a failure to produce semen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspersion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calumnia</ns0:quote>
          <ns0:quote>desdoro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An attack on somebody's reputation or good name, often in the phrase to cast aspersions upon…. [from late 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphalt</ns0:orth>
        <ns0:pron>/ˈæsfælt/</ns0:pron>
        <ns0:pron>/ˈæsfɑlt/</ns0:pron>
        <ns0:pron>/ˈæsfɒlt/</ns0:pron>
        <ns0:pron>/ˈæsfɔlt/</ns0:pron>
        <ns0:pron>/ˈæsfɔːlt/</ns0:pron>
        <ns0:pron>/ˈæsfəlt/</ns0:pron>
        <ns0:pron>/ˈæʃ-/</ns0:pron>
        <ns0:pron>/ˈæʃfɑlt/</ns0:pron>
        <ns0:pron>/ˈæʃfɔlt/</ns0:pron>
        <ns0:pron>/ˈæʃfɛlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfalto</ns0:quote>
          <ns0:quote>chapapote</ns0:quote>
          <ns0:quote>chapopote</ns0:quote>
          <ns0:quote>neme</ns0:quote>
          <ns0:quote>pisasfalto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sticky, black to brown and highly viscous liquid or semi-solid, composed almost entirely of bitumen with small mineral particles, that is present in most crude petroleums and in some natural deposits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>garujo bituminoso</ns0:quote>
          <ns0:quote>hormigón asfáltico</ns0:quote>
          <ns0:quote>asfalto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ellipsis of asphalt concrete, a hard ground covering used for roads and walkways.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphalt</ns0:orth>
        <ns0:pron>/ˈæsfælt/</ns0:pron>
        <ns0:pron>/ˈæsfɑlt/</ns0:pron>
        <ns0:pron>/ˈæsfɒlt/</ns0:pron>
        <ns0:pron>/ˈæsfɔlt/</ns0:pron>
        <ns0:pron>/ˈæsfɔːlt/</ns0:pron>
        <ns0:pron>/ˈæsfəlt/</ns0:pron>
        <ns0:pron>/ˈæʃ-/</ns0:pron>
        <ns0:pron>/ˈæʃfɑlt/</ns0:pron>
        <ns0:pron>/ˈæʃfɔlt/</ns0:pron>
        <ns0:pron>/ˈæʃfɛlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfaltar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pave with asphalt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphalt concrete</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>garujo asfáltico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphalt jungle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jungla de asfalto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) A city or urban area, where the landscape is covered by pavement and the environment is alienating and unsafe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphaltene</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfalteno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of the dark organic constituents of crude oils and bitumen that are soluble in aromatic solvents but not in aliphatic ones; they are polycyclic aromatic compounds (composed of fused benzene rings) with aliphatic side chains</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphaltic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfáltico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resembling, containing, or relating to asphalt or bitumen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphodel</ns0:orth>
        <ns0:pron>/ˈæsfədɛl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gamón</ns0:quote>
          <ns0:quote>asfódelo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the flowering plants of the family Asphodelaceae, especially Asphodelus ramosus and Asphodelus albus; the flower of these plants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphyxia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfixia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Loss of consciousness due to the body's inability to deliver oxygen to its tissues, either by the breathing of air lacking oxygen or by the inability of the blood to carry oxygen.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine, obsolete) A condition in which an extreme decrease in the concentration of oxygen in the body leads to loss of consciousness or death. Replaced in the mid-20th century by the more specific terms anoxia, hypoxia, hypoxemia and hypercapnia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphyxiate</ns0:orth>
        <ns0:pron>/əsˈfɪksieɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfixiar</ns0:quote>
          <ns0:quote>sofocar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To smother or suffocate someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfixiarse</ns0:quote>
          <ns0:quote>sofocarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To be smothered or suffocated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asphyxiation</ns0:orth>
        <ns0:pron>/æsfɪksiˈeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asfixia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Death due to lack of oxygen.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An acute lack of oxygen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspic</ns0:orth>
        <ns0:pron>/ˈæspɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>áspic</ns0:quote>
          <ns0:quote>queso de cabeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A meat or fish jelly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspie</ns0:orth>
        <ns0:pron>/ˈæspi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, endearing, autism, somewhat, dated) An Aspergerian: a person with Asperger’s syndrome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirant</ns0:orth>
        <ns0:pron>/ɐsˈpaɪɹɐnt/</ns0:pron>
        <ns0:pron>/ˈæspəɹənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who aspires (for high office, etc.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirate</ns0:orth>
        <ns0:pron>/ˈæs.pə.ɹeɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pə.ɹɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pəɹ.eɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pəɹ.ət/</ns0:pron>
        <ns0:pron>/ˈæs.pɪ.ɹeɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pɪ.ɹət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspiración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) The puff of air accompanying the release of a plosive or fricative consonant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) A sound produced by such a puff of air.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirate</ns0:orth>
        <ns0:pron>/ˈæs.pə.ɹeɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pə.ɹɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pəɹ.eɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pəɹ.ət/</ns0:pron>
        <ns0:pron>/ˈæs.pɪ.ɹeɪt/</ns0:pron>
        <ns0:pron>/ˈæs.pɪ.ɹət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirar</ns0:quote>
          <ns0:quote>chupar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To remove a liquid or gas by means of suction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirar</ns0:quote>
          <ns0:quote>inhalar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To inhale so as to draw something other than air into one's lungs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive, linguistics) To produce an audible puff of breath, especially following a consonant, such as the letter "h" at the beginning of house or hat in standard English.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirated</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics) Pronounced with an audible breath, a brief expulsion of air at the end of the sound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirated h</ns0:orth>
        <ns0:pron>/ˈæspəɹeɪ̯tɪd eɪ̯tʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>h aspirada</ns0:quote>
          <ns0:quote>hache aspirada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(French phonology) In the French language, usage of the letter h at the start of a word which does not allow liaison with a preceding consonant or elision of a preceding schwa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspiration</ns0:orth>
        <ns0:pron>/ˌæspəˈɹeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspiración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of aspiring or ardently desiring; an ardent wish or desire, chiefly after what is elevated or spiritual (with common adjunct adpositions being to and of).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The action of aspirating.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(phonetics) A burst of air that follows the release of some consonants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pump which draws gas through a liquid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspire</ns0:orth>
        <ns0:pron>/əˈspaɪə(ɹ)/</ns0:pron>
        <ns0:pron>/əˈspaɪɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirar</ns0:quote>
          <ns0:quote>ambicionar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To have a strong desire or ambition to achieve something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspirin</ns0:orth>
        <ns0:pron>/ˈæsp(ɪ)ɹɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspirina</ns0:quote>
          <ns0:quote>aspirinar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, carboxylic acid, pharmaceutical drug) an analgesic drug, acetylsalicylic acid</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asplenia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asplenia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, medicine) Absence of normal function of the spleen, from any cause:</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology, medicine) Physiological absence of splenic function; either substantial or total splenic dysfunction; splenic nonfunction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ass</ns0:orth>
        <ns0:pron>/æs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asno</ns0:quote>
          <ns0:quote>burro</ns0:quote>
          <ns0:quote>jumento</ns0:quote>
          <ns0:quote>pollino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several species of horse-like animals, especially Equus asinus, the domesticated of which are used as beasts of burden.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>culo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, and, uncountable) The buttocks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>burro</ns0:quote>
          <ns0:quote>capullo</ns0:quote>
          <ns0:quote>idiota</ns0:quote>
          <ns0:quote>imbécil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, vulgar, _, through, _, confusion, _) A stupid or jerky (inconsiderate, etc) person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>polvo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(synecdochically, uncountable) Sex; a person to have sex with; with vulgar emphasis on their corporeality (their body) over their personhood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ass-backwards</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a tuertas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, colloquial) In a hopelessly misguided manner; in a manner contrary to what is normal, expected, or logical.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ass-licker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chupamedias</ns0:quote>
          <ns0:quote>lameculos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, vulgar, slang) Someone who succumbs to authority, doing whatever authority figures ask and attempting to please them in every possible way; (by extension) any contemptible person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lameculos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, vulgar, slang) Someone who performs anilingus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assail</ns0:orth>
        <ns0:pron>/əˈseɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asaltar</ns0:quote>
          <ns0:quote>atacar</ns0:quote>
          <ns0:quote>aturdir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attack with harsh words or violent force (also figuratively).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assailant</ns0:orth>
        <ns0:pron>/əˈseɪlənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asaltante</ns0:quote>
          <ns0:quote>atacante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who attacks or assails another violently, or criminally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assassin</ns0:orth>
        <ns0:pron>/əˈsæsɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asesino</ns0:quote>
          <ns0:quote>asesina</ns0:quote>
          <ns0:quote>magnicida</ns0:quote>
          <ns0:quote>sicario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who intentionally kills a person, especially a professional who kills a public or political figure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asesino</ns0:quote>
          <ns0:quote>asesina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any ruthless killer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assassinate</ns0:orth>
        <ns0:pron>/əˈsæs(ə)nˌeɪt/</ns0:pron>
        <ns0:pron>/əˈsæsɪneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asesinar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To murder someone, especially an important person, by a sudden or obscure attack, especially for ideological or political reasons. [from 17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figuratively) To harm, ruin, or defame severely or destroy by treachery, slander, libel, or obscure attack.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assassination</ns0:orth>
        <ns0:pron>/əˌsæs.ɪˈneɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asesinato</ns0:quote>
          <ns0:quote>magnicidio</ns0:quote>
          <ns0:quote>sicariato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The murder of a person, especially for political reasons or for personal gain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assault</ns0:orth>
        <ns0:pron>/əˈsɑlt/</ns0:pron>
        <ns0:pron>/əˈsɒlt/</ns0:pron>
        <ns0:pron>/əˈsɔlt/</ns0:pron>
        <ns0:pron>/əˈsɔːlt/</ns0:pron>
        <ns0:pron>/əˈsʌlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asalto</ns0:quote>
          <ns0:quote>agresión</ns0:quote>
          <ns0:quote>ataque</ns0:quote>
          <ns0:quote>acometimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A violent onset or attack with physical means, for example blows, weapons, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assault</ns0:orth>
        <ns0:pron>/əˈsɑlt/</ns0:pron>
        <ns0:pron>/əˈsɒlt/</ns0:pron>
        <ns0:pron>/əˈsɔlt/</ns0:pron>
        <ns0:pron>/əˈsɔːlt/</ns0:pron>
        <ns0:pron>/əˈsʌlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agredir</ns0:quote>
          <ns0:quote>atacar</ns0:quote>
          <ns0:quote>asaltar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attack, physically or figuratively; to assail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assault rifle</ns0:orth>
        <ns0:pron>/əˈsɑlt ˈɹaɪfəl/</ns0:pron>
        <ns0:pron>/əˈsɒlt ˈɹaɪfəl/</ns0:pron>
        <ns0:pron>/əˈsɔlt ˈɹaɪfəl/</ns0:pron>
        <ns0:pron>/əˈsɔːlt ˈɹaɪfəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fusil de asalto</ns0:quote>
          <ns0:quote>rifle de asalto</ns0:quote>
          <ns0:quote>fusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A military select-fire rifle or carbine that fires a shortened rifle caliber round or lower-power smaller-calibre round, from a high-capacity magazine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assay</ns0:orth>
        <ns0:pron>/əˈseɪ/</ns0:pron>
        <ns0:pron>/ˈæseɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ensayo</ns0:quote>
          <ns0:quote>intento</ns0:quote>
          <ns0:quote>prueba</ns0:quote>
          <ns0:quote>ensaye</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Trial, attempt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ensayo</ns0:quote>
          <ns0:quote>ensay</ns0:quote>
          <ns0:quote>ensaye</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of ascertaining the proportion of a particular metal in an ore or alloy; especially, the determination of the proportion of gold or silver in bullion or coin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assay</ns0:orth>
        <ns0:pron>/əˈseɪ/</ns0:pron>
        <ns0:pron>/ˈæseɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>probar, tratar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, intransitive) To try, attempt (to do something). [14th–19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analizar</ns0:quote>
          <ns0:quote>aquilatar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To analyze or estimate the composition or value of (a metal, ore etc.). [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assegai</ns0:orth>
        <ns0:pron>/ˈæsəɡaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azagaya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A slim hardwood spear or javelin with an iron tip, especially those used by Bantu peoples of Southern Africa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assemble</ns0:orth>
        <ns0:pron>/əˈsɛm.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>montar</ns0:quote>
          <ns0:quote>ensamblar</ns0:quote>
          <ns0:quote>construir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reunir</ns0:quote>
          <ns0:quote>juntar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ergative) To gather as a group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assembly</ns0:orth>
        <ns0:pron>/əˈsɛmb.li/</ns0:pron>
        <ns0:pron>/əˈsɛmb.lɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ensamblaje</ns0:quote>
          <ns0:quote>montaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of putting together a set of pieces, fragments, or elements.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asamblea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A congregation of people in one place for a purpose.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(politics) A legislative body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ensamblador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) Ellipsis of assembly language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assembly language</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lenguaje ensamblador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computer languages) A programming language in which the source code of programs is composed of mnemonic instructions, each of which corresponds directly to a machine instruction for a particular processor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assembly line</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea de montaje</ns0:quote>
          <ns0:quote>cadena de ensambladura</ns0:quote>
          <ns0:quote>línea de ensamblaje</ns0:quote>
          <ns0:quote>línea ensambladora</ns0:quote>
          <ns0:quote>línea ensamblante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(manufacturing) A system of workers and machinery in which a product is assembled in a series of consecutive operations; typically the product is conveyed by a continuously moving belt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assent</ns0:orth>
        <ns0:pron>/əˈsɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asentimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Agreement; act of agreeing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assent</ns0:orth>
        <ns0:pron>/əˈsɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asentir</ns0:quote>
          <ns0:quote>consentir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To agree to a proposal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assert</ns0:orth>
        <ns0:pron>/əˈsɜːt/</ns0:pron>
        <ns0:pron>/əˈsɝt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>confirmar</ns0:quote>
          <ns0:quote>ejercer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To use or exercise and thereby prove the existence of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reafirmar</ns0:quote>
          <ns0:quote>sostener</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To maintain or defend, as a cause or a claim, by words or measures; to vindicate a claim or title to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmar</ns0:quote>
          <ns0:quote>asegurar</ns0:quote>
          <ns0:quote>asertar</ns0:quote>
          <ns0:quote>aseverar</ns0:quote>
          <ns0:quote>encender</ns0:quote>
          <ns0:quote>habilitar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(reflexive) To insist on the legitimacy of one's rights, opinion, etc; not to allow oneself to be dismissed; to ensure that one is taken into consideration; to make oneself respected; to be assertive. See assert oneself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assertion</ns0:orth>
        <ns0:pron>/əˈsɜɹʃən/</ns0:pron>
        <ns0:pron>/əˈsɜːʃən/</ns0:pron>
        <ns0:pron>[əˈsɝʃn̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
