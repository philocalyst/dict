          <ns0:quote>uno del montón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person or animal who competed in a race but did not win.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
