        <ns0:pron>/əˈsɛtəlˌin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetileno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lamp powered by acetylene, particularly a motor vehicle headlight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetylglucosamine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetilglucosamina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) An amide derivative of glucose that forms part of the peptidoglycan of bacterial cell walls</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
