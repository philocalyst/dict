    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apatheism</ns0:orth>
        <ns0:pron>/ˌæpəˈθi.ɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apateísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion) Apathy towards the existence of a god; belief that the question of the existence of a god is unimportant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apathetic</ns0:orth>
        <ns0:pron>/ˌæpəˈθɛtɪk/</ns0:pron>
        <ns0:pron>[ˌæpəˈθɛɾɪ̈k]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apático</ns0:quote>
          <ns0:quote>desganado</ns0:quote>
          <ns0:quote>indiferente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Void of feeling; not susceptible of deep emotion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apathetically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apáticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an apathetic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apathy</ns0:orth>
        <ns0:pron>/ˈæ.pə.θi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apatía</ns0:quote>
          <ns0:quote>displicencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lack of emotion or motivation; lack of interest or enthusiasm towards something; disinterest (in something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apatite</ns0:orth>
        <ns0:pron>/ˈæpətaɪt/</ns0:pron>
        <ns0:pron>/ˈæpəˌtaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apatita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A calcium fluoride phosphate of variable composition, sometimes used in the manufacture of fertilizer, as a gemstone, and (in powdered form) as a pigment, and also produced biologically in bones and teeth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ape</ns0:orth>
        <ns0:pron>/eɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>simio</ns0:quote>
          <ns0:quote>hominoide</ns0:quote>
          <ns0:quote>hominoideo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A primate of the superfamily Hominoidea, generally larger than monkeys and distinguished from them by having no tail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mono</ns0:quote>
          <ns0:quote>simio</ns0:quote>
          <ns0:quote>primate</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(derogatory) An uncivilized person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ape</ns0:orth>
        <ns0:pron>/eɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>monear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To behave like an ape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>imitar</ns0:quote>
          <ns0:quote>arremedar</ns0:quote>
          <ns0:quote>remedar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To imitate or mimic, particularly to imitate poorly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apeirogon</ns0:orth>
        <ns0:pron>/əˈpeɪ̯ɹɵɡɑn/</ns0:pron>
        <ns0:pron>/əˈpiːɹɵɡɑn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apeirógono</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aperiodic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aperiódico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, stochastic processes, of a state) for which any return to it may occur at irregular times; not periodic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aperture</ns0:orth>
        <ns0:pron>/ˈap.ə.tjʊə/</ns0:pron>
        <ns0:pron>/ˈap.ə.t͡ʃə/</ns0:pron>
        <ns0:pron>/ˈæp.ɚ.t͡ʃɚ/</ns0:pron>
        <ns0:pron>/ˈæp.ɚˌtjʊɹ/</ns0:pron>
        <ns0:pron>/ˈæp.ɚˌtʊɹ/</ns0:pron>
        <ns0:pron>/ˈæp.ɚˌt͡ʃʊɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abertura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small or narrow opening, gap, slit, or hole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apertura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy, photography) The diameter of such a hole which restricts the width of the lightpath through the whole system. For a telescope, this is the diameter of the objective lens.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apex</ns0:orth>
        <ns0:pron>/ˈeɪ.pɛks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ápice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The end of a leaf, petal or similar organ opposed to the end where it is attached to its support.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chiefly, anatomy) The pointed fine end of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ápice</ns0:quote>
          <ns0:quote>cima</ns0:quote>
          <ns0:quote>sumidad</ns0:quote>
          <ns0:quote>ápex</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The highest or the greatest part of something, especially forming a point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ápice</ns0:quote>
          <ns0:quote>cúspide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The highest point in a plane or solid figure, relative to a base line or plane.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apogeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) The moment of greatest success, expansion, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apex predator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>superdepredador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An animal atop the food chain, preying on another animals, and not itself preyed upon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphagia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afagia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The condition of difficulty in swallowing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphanitic</ns0:orth>
        <ns0:pron>/ˌæf.əˈnɪt.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afanítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, petrology) Pertaining to aphanites, igneous rocks composed of microscopic mineral crystals (fine grains too small to be visible to the naked eye.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphantasia</ns0:orth>
        <ns0:pron>/ˌeɪ.fænˈteɪ.zɪ.ə/</ns0:pron>
        <ns0:pron>/ˌeɪ.fænˈteɪ.ʒə/</ns0:pron>
        <ns0:pron>/ˌeɪˌfænˈteɪ.zi.ə/</ns0:pron>
        <ns0:pron>/ˌeɪˌfænˈteɪ.ʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afantasía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, psychology) A condition where one does not possess a functioning "mind's eye" and cannot visualize imagery. [from 2015]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphasia</ns0:orth>
        <ns0:pron>/əˈfeɪzɪə/</ns0:pron>
        <ns0:pron>/əˈfeɪʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A partial or total loss of language skills due to brain damage. Usually, damage to the left perisylvian region, including Broca's area and Wernicke's area, causes aphasia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphasic</ns0:orth>
        <ns0:pron>/əˈfeɪzək/</ns0:pron>
        <ns0:pron>/əˈfeɪ̯zɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afásico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(speech pathology) Affected by, or pertaining to, aphasia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphelion</ns0:orth>
        <ns0:pron>/æpˈhi.li.ən/</ns0:pron>
        <ns0:pron>/æpˈhil.jən/</ns0:pron>
        <ns0:pron>/æpˈhiː.lɪ.ən/</ns0:pron>
        <ns0:pron>/əˈfi.li.ən/</ns0:pron>
        <ns0:pron>/əˈfil.jən/</ns0:pron>
        <ns0:pron>/əˈfiː.lɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afelio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy, also, figuratively) The point in the elliptical orbit of a comet, planet, or other astronomical object, where it is farthest from the Sun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphemia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afemia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of aphasia in which the ability to speak is lost or severely impaired.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apheresis</ns0:orth>
        <ns0:pron>/əˈfɛɹəsɪs/</ns0:pron>
        <ns0:pron>/əˈfɪəɹɪsɪs/</ns0:pron>
        <ns0:pron>/ˌæfəˈɹisɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aféresis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics, linguistics, prosody) Elision, suppression, or complete loss of a letter or sound (syllable) from the beginning of a word, such as the development of special from especial.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphesis</ns0:orth>
        <ns0:pron>/ˈæ.fə.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aféresis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics, linguistics, prosody) The loss of the initial unstressed vowel of a word.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphid</ns0:orth>
        <ns0:pron>/ˈeɪ.fɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pulgón</ns0:quote>
          <ns0:quote>áfido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sap-sucking insect pest of the superfamily Aphidoidea; an aphidian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphonia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afonía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Loss of voice; the inability to speak.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphonic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or exhibiting aphonia; unable to speak.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphorism</ns0:orth>
        <ns0:pron>/ˈæf.ə.ɹɪ.zəm/</ns0:pron>
        <ns0:pron>[ˈæf.ə.ɹɪ.zm̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aforismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A concise, terse, laconic, or memorable expression of a general truth or principle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphoristic</ns0:orth>
        <ns0:pron>/æfəˈɹɪstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aforístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or containing aphorisms, epigrams, or maxims; gnomic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphotic</ns0:orth>
        <ns0:pron>/eɪˈfoʊtɪk/</ns0:pron>
        <ns0:pron>/eɪˈfəʊtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afótica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having no light, especially no sunlight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphrodisiac</ns0:orth>
        <ns0:pron>/æf.ɹoʊˈdi.zi.æk/</ns0:pron>
        <ns0:pron>/æf.ɹoʊˈdɪ.zi.æk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afrodisiaco</ns0:quote>
          <ns0:quote>afrodisíaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Arousing or intensifying sexual desire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphrodisiac</ns0:orth>
        <ns0:pron>/æf.ɹoʊˈdi.zi.æk/</ns0:pron>
        <ns0:pron>/æf.ɹoʊˈdɪ.zi.æk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afrodisiaco</ns0:quote>
          <ns0:quote>afrodisíaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something, generally a food or drug, having such an effect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphthous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aftoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Of, or relating to aphtha.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aphthous ulcer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afta</ns0:quote>
          <ns0:quote>llaga bucal</ns0:quote>
          <ns0:quote>úlcera aftosa</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apian</ns0:orth>
        <ns0:pron>/ˈeɪpi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>api-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to bees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apiary</ns0:orth>
        <ns0:pron>/ˈeɪ.pi.ə.ɹi/</ns0:pron>
        <ns0:pron>/ˈeɪ.pi.ɛɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colmenar</ns0:quote>
          <ns0:quote>apiario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place where bees and their hives are kept.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apical</ns0:orth>
        <ns0:pron>/ˈeɪpɪkəl/</ns0:pron>
        <ns0:pron>/ˈæpɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apical</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics, phonology, of a sound) Produced with the tip of the tongue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apical</ns0:orth>
        <ns0:pron>/ˈeɪpɪkəl/</ns0:pron>
        <ns0:pron>/ˈæpɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apical</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics) A sound produced by obstructing the air passage with the tip of the tongue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apicoectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apicectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) An endodontic surgical procedure whereby a tooth's root tip is removed and a root end cavity is prepared and filled with a biocompatible material</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apicoplast</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apicoplasto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(microbiology) A relict, non-photosynthetic plastid found in most of the Apicomplexa, proposed to have evolved via secondary endosymbiosis and surrounded by four membranes within the outermost part of the endomembrane system</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apiculus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apículo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mycology) The part of a spore which attaches to the sterigmata at the end of a basidium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apiece</ns0:orth>
        <ns0:pron>/əˈpis/</ns0:pron>
        <ns0:pron>/əˈpiːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cada uno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Each by itself; for or to each one.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Maine) An undetermined distance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aplenty</ns0:orth>
        <ns0:pron>/əˈplɛnti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en abundancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(postpositive) In a generous or overlarge quantity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aplenty</ns0:orth>
        <ns0:pron>/əˈplɛnti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a porrillo</ns0:quote>
          <ns0:quote>a tutiplén</ns0:quote>
          <ns0:quote>para dar y tomar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Enough or more than enough.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aplomb</ns0:orth>
        <ns0:pron>/əˈplɒm/</ns0:pron>
        <ns0:pron>/əˈplʌm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Self-confidence; poise; composure.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(ballet) The apparent elegance and precision exhibited by a confident, accomplished dancer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apnea</ns0:orth>
        <ns0:pron>/ˈæp.ni.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apnea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The cessation of breathing, most often in reference to transient instances thereof during sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocalypse</ns0:orth>
        <ns0:pron>/əˈpɑkəlɪps/</ns0:pron>
        <ns0:pron>/əˈpɒkəlɪps/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocalipsis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A revealing, especially a prophecy of, or the unfolding of, supernatural events. [from 14th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A huge disaster; a cataclysmic event; destruction or ruin of large scope and scale. [from 19th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Christianity) The unveiling of events prophesied in the Revelation; the second coming and the end of life on Earth; global destruction. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocalyptic</ns0:orth>
        <ns0:pron>/əˈpɒ.kə.lɪp.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocalíptico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to an apocalypse:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocarotenal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocarotenal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A carotenoid found in spinach and citrus fruits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocarpous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocarpo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Having carpels that are not joined</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocopate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocopado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Shortened by apocope; lacking a final sound or syllable</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocopate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocopar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) To shorten using apocope; to remove the final sound or syllable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocope</ns0:orth>
        <ns0:pron>/əˈpɑ.kə.pi/</ns0:pron>
        <ns0:pron>/əˈpɒ.kə.pi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apócope</ns0:quote>
          <ns0:quote>apócopa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(loosely) The loss or omission of a sound or syllable from the end of a word.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocopic</ns0:orth>
        <ns0:pron>/æpəˈkɒpɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apocópico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) Of or pertaining to apocope; lacking a final sound or syllable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocrypha</ns0:orth>
        <ns0:pron>/əˈpɒk.ɹə.fə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apócrifo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something, as a writing, that is of doubtful authorship or authority (formerly also used attributively).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocryphal</ns0:orth>
        <ns0:pron>/əˈpɑːkɹəfəl/</ns0:pron>
        <ns0:pron>/əˈpɑːkɹɪfəl/</ns0:pron>
        <ns0:pron>/əˈpɒkɹəfəl/</ns0:pron>
        <ns0:pron>/əˈpɒkɹɪfəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apócrifo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) Of, or pertaining to, the Apocrypha.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) Of dubious veracity; of questionable accuracy or truthfulness; anecdotal or in the nature of an urban legend.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apocryphally</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apócrifamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an apocryphal manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apodeictic</ns0:orth>
        <ns0:pron>/ˌapəˈdaɪk.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apodíctico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(logic) Of the characteristic feature of a proposition that is necessary (or impossible): perfectly certain (or inconceivable) or incontrovertibly true (or false); self-evident.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apoferritin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoferritina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) Part of the ferritin that is not combined with iron</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apogamy</ns0:orth>
        <ns0:pron>/əˈpɒɡəmɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apogamia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Asexual reproduction of a fully formed plant directly from a bud.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apogee</ns0:orth>
        <ns0:pron>/ˈæp.ə.d͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apogeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) The point, in an orbit about the Earth, that is farthest from the Earth: the apoapsis of an Earth orbiter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apograph</ns0:orth>
        <ns0:pron>/ˈæpəɡɹɑːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apógrafo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(textual criticism) A copy or transcript of a manuscript (called the antigraph).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apolipoprotein</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apolipoproteína</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein) Any polypeptide or protein that can serve as an apoprotein by binding with a lipid to form a lipoprotein.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apolitically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoliticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Done without political affiliation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apologetic</ns0:orth>
        <ns0:pron>/əˌpɑləˈd͡ʒɛtɪk/</ns0:pron>
        <ns0:pron>/əˌpɒləˈdʒɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apologético</ns0:quote>
          <ns0:quote>arrepentido</ns0:quote>
          <ns0:quote>disculpante</ns0:quote>
          <ns0:quote>disculpatorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the character of apology; regretfully excusing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apologético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Defending by words or arguments; said or written in defense.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apologetically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disculpándose</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an apologetic manner; by way of defense, apology or excuse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apologetics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apologética</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The field of study concerned with the systematic defense of a position, or of religious or occult doctrines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apologist</ns0:orth>
        <ns0:pron>/əˈpɒl.ə.d͡ʒɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apologeta</ns0:quote>
          <ns0:quote>apologista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually) One who speaks or writes in defense of a faith, a cause, or an institution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apologize</ns0:orth>
        <ns0:pron>/əˈpɑləd͡ʒaɪz/</ns0:pron>
        <ns0:pron>/əˈpɒləd͡ʒaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disculparse</ns0:quote>
          <ns0:quote>pedir disculpas</ns0:quote>
          <ns0:quote>pedir perdón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, often followed by “for”) To make an apology or excuse; to acknowledge some fault or offense, with expression of regret for it, by way of amends</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, dated) To make an apologia or defense; to act as apologist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apologue</ns0:orth>
        <ns0:pron>/ˈæpəlɒɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apólogo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A short story with a moral, often involving talking animals or objects; a fable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apology</ns0:orth>
        <ns0:pron>/əˈpɑ.lə.d͡ʒi/</ns0:pron>
        <ns0:pron>/əˈpɒl.ə.d͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disculpa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expression of remorse or regret for having said or done something that harmed another: an instance of apologizing (saying that one is sorry).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apología</ns0:quote>
          <ns0:quote>disculpa</ns0:quote>
          <ns0:quote>excusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A formal justification, defence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aponeurosis</ns0:orth>
        <ns0:pron>/ˌap.ə.njʊˈɹəʊ.sɪs/</ns0:pron>
        <ns0:pron>/ˌæp.ə.nʊˈɹoʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aponeurosis</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apophasis</ns0:orth>
        <ns0:pron>/əˈpɑf.ə.sɪs/</ns0:pron>
        <ns0:pron>/əˈpɒf.ə.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>paralipsis</ns0:quote>
          <ns0:quote>preterición</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apophenia</ns0:orth>
        <ns0:pron>/æpəˈfiːni.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apofenia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) The perception of or belief in connectedness among unrelated phenomena.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apophysis</ns0:orth>
        <ns0:pron>/əˈpɑfɪsɪs/</ns0:pron>
        <ns0:pron>/əˈpɒfɪsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apófisis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A natural outgrowth, swelling or enlargement, usually of an organism; a protuberance on a bone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apoplectic</ns0:orth>
        <ns0:pron>/ˌæp.əˈplɛk.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apopléjico</ns0:quote>
          <ns0:quote>apoplético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Of or relating to apoplexy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apoplexy</ns0:orth>
        <ns0:pron>/ˈæp.ə.plɛk.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoplejía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(symptom) Gross hemorrhage into a cavity or into the substance of an organ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apoprotein</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoproteína</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein) The polypeptide part of a conjugated protein; for example, an apolipoprotein plus a lipid particle yields a lipoprotein.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apoptosis</ns0:orth>
        <ns0:pron>/ˌapɒpˈtəʊsɪs/</ns0:pron>
        <ns0:pron>/ˌæ.pəˈtoʊ.sɪs/</ns0:pron>
        <ns0:pron>/ˌæpəpˈtoʊsəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoptosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, cytology) A process of programmed cell death by which cells undergo an ordered sequence of events which leads to death of the cell, as occurs during growth and development of the organism, as a part of normal cell aging, or as a response to cellular injury. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aporia</ns0:orth>
        <ns0:pron>/əˈpɔɹiə/</ns0:pron>
        <ns0:pron>/əˈpɔːɹɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aporía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) An expression of deliberation with oneself regarding uncertainty or doubt as to how to proceed.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(philosophy, post-structuralism) An insoluble contradiction, especially in a text's meaning; a logical impasse suggested by a text or speaker.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aporophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aporofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) The fear of poverty or poor people; antipathy toward them both.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aposematism</ns0:orth>
        <ns0:pron>/-pə-/</ns0:pron>
        <ns0:pron>/ˌæpoʊsɪˈmætɪz(ə)m/</ns0:pron>
        <ns0:pron>/ˌæpə(ʊ)sɪˈmætɪz(ə)m/</ns0:pron>
        <ns0:pron>[-ɾɪ-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aposematismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, chiefly, zoology) An adaptation, especially a form of coloration, that warns off potential predators.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aposiopesis</ns0:orth>
        <ns0:pron>/ˌæpəsaɪəˈpiːsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reticencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) An abrupt breaking-off in speech, often indicated in print using an ellipsis (…) or an em dash (—).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostasy</ns0:orth>
        <ns0:pron>/əˈpɑs.tə.si/</ns0:pron>
        <ns0:pron>/əˈpɒ.stə.si/</ns0:pron>
        <ns0:pron>/əˈpɔs.tə.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostasía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The renunciation of a belief or set of beliefs.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Specifically, the renunciation of one's religion or faith.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostate</ns0:orth>
        <ns0:pron>/əˈpɑs.-/</ns0:pron>
        <ns0:pron>/əˈpɒs.teɪt/</ns0:pron>
        <ns0:pron>/əˈpɒs.tət/</ns0:pron>
        <ns0:pron>/əˈpɔs.teɪt/</ns0:pron>
        <ns0:pron>/əˈpɔs.tət/</ns0:pron>
        <ns0:pron>/əˈpɔs.tɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apóstata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, religion) A person who has renounced a religion or faith.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostatize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostatar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To give up or renounce one's position or belief.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostille</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A special certification established in 1961 for certifying foreign documents.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostle</ns0:orth>
        <ns0:pron>/əˈpɑsl̩/</ns0:pron>
        <ns0:pron>/əˈpɒs(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apóstol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A missionary, or leader of a religious mission, especially one in the early Christian Church (but see Apostle).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A top-ranking ecclesiastical official in the twelve seat administrative council of The Church of Jesus Christ of Latter-day Saints.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostleship</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostolado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The position, post, or duty of being an apostle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolado</ns0:orth>
        <ns0:pron>/əˌpɑstəˈlɑdoʊ/</ns0:pron>
        <ns0:pron>/əˌpɒstəˈlɑːdəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostolado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostolado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The office, or responsibilities of an apostle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolic</ns0:orth>
        <ns0:pron>/ˌæp.əˈstɑːl.ɪk/</ns0:pron>
        <ns0:pron>/ˌæp.əˈstɒl.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) Pertaining to apostles or their practice or teaching; pertaining to the apostles (of early Christianity) or their teachings.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>According to the doctrines of the apostles; delivered or taught by the apostles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolic constitution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>constitución apostólica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Roman Catholicism) The most solemn form of legislation issued by the pope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolic letter</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carta apostólica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Roman Catholicism) An ecclesiastical letter issued by the pope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolic succession</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sucesión apostólica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The unbroken chain of consecrations by laying on of hands from the Apostles of Jesus Christ to the bishops, and from to bishop to bishop through the ages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostolicity</ns0:orth>
        <ns0:pron>/əˌpɒstəˈlɪsɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostolicidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The quality of being apostolic, notably of preserving authenticity within the mission and tradition of the Christian church as founded by Jesus Christ and his twelve original Apostles, through their representatives and successors in the papacy and episcopate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apostrophe</ns0:orth>
        <ns0:pron>/əˈpɑs.tɹə.fi/</ns0:pron>
        <ns0:pron>/əˈpɒs.tɹə.fi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apóstrofo</ns0:quote>
          <ns0:quote>apóstrofe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(orthography) The text character ’, which serves as a punctuation mark in various languages and as a diacritical mark in certain rare contexts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apóstrofe</ns0:quote>
          <ns0:quote>apóstrofo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) A sudden exclamatory piece of dialogue addressed to someone or something, especially absent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apotemnophilia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apotemnofilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) A compulsion to become, or appear to be, an amputee.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apothecary</ns0:orth>
        <ns0:pron>/əˈpɑθəˌkɛəɹi/</ns0:pron>
        <ns0:pron>/əˈpɒθəkəɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoteca</ns0:quote>
          <ns0:quote>apotecario</ns0:quote>
          <ns0:quote>apoticario</ns0:quote>
          <ns0:quote>botica</ns0:quote>
          <ns0:quote>boticario</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apothecium</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apotecio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(lichenology, mycology) A type of fructification of some ascomycete fungi, forming cyst structures of various shapes. Often the fungal components of lichens have this sort of fertile structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apothegm</ns0:orth>
        <ns0:pron>/ˈæ.pə.θɛm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apotegma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A short, witty, instructive saying; an aphorism or maxim. [from mid-16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apothem</ns0:orth>
        <ns0:pron>/ˈæp.ə.θɛm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apotema</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The perpendicular distance from the center of a circle to a chord of the same circle.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geometry) The distance from the center of a regular polygon perpendicular to one of its sides (a special case of the above).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apotheosis</ns0:orth>
        <ns0:pron>/əˌpɑ.θiˈoʊ.sɪs/</ns0:pron>
        <ns0:pron>/əˌpɒθ.iːˈəʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoteosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Glorification, exaltation; crediting someone or something with extraordinary power or status.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apotropaism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apotropismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion, mysticism) The use of ritual or other magical means (including charms and/or incantations) to avert evil or bad luck.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>app</ns0:orth>
        <ns0:pron>/æp/</ns0:pron>
        <ns0:pron>[æʔp̚]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>app</ns0:quote>
          <ns0:quote>apli</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, mobile phones) An application (program), especially a small one designed for a mobile device.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appall</ns0:orth>
        <ns0:pron>/əˈpɔːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consternar</ns0:quote>
          <ns0:quote>abrumar</ns0:quote>
          <ns0:quote>apabullar</ns0:quote>
          <ns0:quote>horrorizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, obsolete) To grow faint; to become weak; to become dismayed or discouraged.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appalled</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apabullado</ns0:quote>
          <ns0:quote>consternado</ns0:quote>
          <ns0:quote>escandalizado</ns0:quote>
          <ns0:quote>horrorizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Shocked, horrified by something unpleasant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appalling</ns0:orth>
        <ns0:pron>/əˈpɔːlɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>horrible</ns0:quote>
          <ns0:quote>abrumador</ns0:quote>
          <ns0:quote>apabullado</ns0:quote>
          <ns0:quote>apabullador</ns0:quote>
          <ns0:quote>apabullante</ns0:quote>
          <ns0:quote>asombroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Horrifying and astonishing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Extremely unfavorable; terrible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparatchik</ns0:orth>
        <ns0:pron>/æpəˈɹæt͡ʃɪk/</ns0:pron>
        <ns0:pron>/ɑːpəˈɹɑːt͡ʃɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apparatchik</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A member of the Soviet apparat; a Communist bureaucrat or agent. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparatar</ns0:quote>
          <ns0:quote>hacer aparecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(fantasy, intransitive) To appear magically; to teleport to or from a place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparatus</ns0:orth>
        <ns0:pron>/əˈparətəs/</ns0:pron>
        <ns0:pron>/ʔɐp.pɐˈɾaː.t̪ʊs/</ns0:pron>
        <ns0:pron>/ˌæp.əˈɹeɪ.təs/</ns0:pron>
        <ns0:pron>/ˌæp.əˈɹæt.əs/</ns0:pron>
        <ns0:pron>/ˌæp.əˈɹɑː.təs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparato</ns0:quote>
          <ns0:quote>equipo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A complex machine or instrument.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparato</ns0:quote>
          <ns0:quote>aparataje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(collective) An assortment of tools and instruments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparel</ns0:orth>
        <ns0:pron>/əˈpæ.ɹəl/</ns0:pron>
        <ns0:pron>/əˈpæɹəl/</ns0:pron>
        <ns0:pron>/əˈpɛ.ɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atavío</ns0:quote>
          <ns0:quote>ropa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Clothing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparent</ns0:orth>
        <ns0:pron>/əˈpæɹ.ənt/</ns0:pron>
        <ns0:pron>/əˈpɛɹ.ənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>visible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being seen, or easily seen; open to view; visible to the eye; within sight or view.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evidente</ns0:quote>
          <ns0:quote>claro</ns0:quote>
          <ns0:quote>manifiesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Clear or manifest to the understanding; plain; evident; obvious; known; palpable; indubitable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparente</ns0:quote>
          <ns0:quote>aparencial</ns0:quote>
          <ns0:quote>apariencial</ns0:quote>
          <ns0:quote>ostensible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Appearing to the eye or mind (distinguished from, but not necessarily opposed to, true or real); seeming.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparently</ns0:orth>
        <ns0:pron>/əˈpæɹ.ənt.li/</ns0:pron>
        <ns0:pron>/əˈpæɹ.ənt.liː/</ns0:pron>
        <ns0:pron>/əˈpɛɹ.ənt.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dizque</ns0:quote>
          <ns0:quote>presuntamente</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evidentemente</ns0:quote>
          <ns0:quote>obviamente</ns0:quote>
          <ns0:quote>por lo visto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) Plainly; clearly; manifestly; evidently.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparentemente</ns0:quote>
          <ns0:quote>por lo visto</ns0:quote>
          <ns0:quote>al parecer</ns0:quote>
          <ns0:quote>según parece</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Seemingly; in appearance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apparition</ns0:orth>
        <ns0:pron>/ˌæp.əɹˈɪʃn̩/</ns0:pron>
        <ns0:pron>/ˌæp.ɚˈɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæp.ɚˈɪʃ.n̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An act of becoming visible; appearance; visibility.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparición</ns0:quote>
          <ns0:quote>jugarreta</ns0:quote>
          <ns0:quote>pora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unexpected, wonderful, or preternatural appearance; especially, one by a ghost, phantom, or suchlike; the entity itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appeal</ns0:orth>
        <ns0:pron>/əˈpil/</ns0:pron>
        <ns0:pron>/əˈpiːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atractivo</ns0:quote>
          <ns0:quote>aliciente</ns0:quote>
          <ns0:quote>atracción</ns0:quote>
          <ns0:quote>tener tilín</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelación</ns0:quote>
          <ns0:quote>recurso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An application to a superior court or judge for a decision or order by an inferior court or judge to be reviewed and overturned.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelación</ns0:quote>
          <ns0:quote>petición</ns0:quote>
          <ns0:quote>postura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A call to a person or an authority for a decision, help, or proof; an entreaty, an invocation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recurso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) A call to, or the use of, a principle or quality for purposes of persuasion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appeal</ns0:orth>
        <ns0:pron>/əˈpil/</ns0:pron>
        <ns0:pron>/əˈpiːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apetecer</ns0:quote>
          <ns0:quote>agradar</ns0:quote>
          <ns0:quote>atraer</ns0:quote>
          <ns0:quote>gustar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) Often followed by against (the inferior court's decision) or to (the superior court): to apply to a superior court or judge for a decision or order by an inferior court or judge to be reviewed and overturned.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To call upon a person or an authority to corroborate a statement, to decide a controverted question, or to vindicate one's rights; to entreat, to invoke.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appealing</ns0:orth>
        <ns0:pron>/əˈpi.lɪŋ/</ns0:pron>
        <ns0:pron>/əˈpiː.lɪŋ/</ns0:pron>
        <ns0:pron>/ʌˈpi.əl.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrayente</ns0:quote>
          <ns0:quote>halagüeño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having appeal; attractive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appear</ns0:orth>
        <ns0:pron>/əˈpiːɹ/</ns0:pron>
        <ns0:pron>/əˈpɪə/</ns0:pron>
        <ns0:pron>/əˈpɪɹ/</ns0:pron>
        <ns0:pron>[əˈpʰɪɹ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparecer</ns0:quote>
          <ns0:quote>aparir</ns0:quote>
          <ns0:quote>figurar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To come or be in sight; to be in view; to become visible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To come before the public.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To become visible to the apprehension of the mind; to be known as a subject of observation or comprehension, or as a thing proved; to be obvious or manifest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comparecer</ns0:quote>
          <ns0:quote>aparecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To stand in presence of some authority, tribunal, or superior person, to answer a charge, plead a cause, etc.; to present oneself as a party or advocate before a court, or as a person to be tried.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>parecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, copulative) To seem; to have a certain semblance; to look.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appearance</ns0:orth>
        <ns0:pron>/əˈpiɹ.əns/</ns0:pron>
        <ns0:pron>/əˈpɪə.ɹəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comparecencia</ns0:quote>
          <ns0:quote>aparición</ns0:quote>
          <ns0:quote>aparecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of appearing or coming into sight; the act of becoming visible to the eye.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A thing seen; a phenomenon; an apparition.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of appearing in a particular place, or in society, a company, or any proceedings; a coming before the public in a particular character.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apariencia</ns0:quote>
          <ns0:quote>aspecto</ns0:quote>
          <ns0:quote>aire</ns0:quote>
          <ns0:quote>cariz</ns0:quote>
          <ns0:quote>estampa</ns0:quote>
          <ns0:quote>hechura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) An instance of someone coming into a court of law to be part of a trial, lawsuit or other proceeding, either in person or represented by an attorney or such like; a court appearance</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appearances are deceptive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>las apariencias engañan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>It is not possible to judge a person's character from their outward appearance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appease</ns0:orth>
        <ns0:pron>/əˈpiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calmar</ns0:quote>
          <ns0:quote>apaciguar</ns0:quote>
          <ns0:quote>aplacar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make quiet; to calm; to reduce to a state of peace; to dispel (anger or hatred).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appeasement</ns0:orth>
        <ns0:pron>/əˈpiːz.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apaciguamiento</ns0:quote>
          <ns0:quote>aplacamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being appeased; the policy of giving in to demands in order to preserve the peace.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appellant</ns0:orth>
        <ns0:pron>/əˈpɛln̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law) a litigant or party that is making an appeal in court</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appellate</ns0:orth>
        <ns0:pron>/əˈpɛlət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelacional</ns0:quote>
          <ns0:quote>apelatorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That can be (legally) appealed to, especially of a court that hears appeals of decisions by a lower court.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appellate court</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tribunal de apelación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A court having jurisdiction to hear appeals and review a lower court's decisions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appellativization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelativización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) The process of a proper name becoming a common noun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>append</ns0:orth>
        <ns0:pron>/əˈpɛnd/</ns0:pron>
        <ns0:pron>/ʌˈpɛnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregar</ns0:quote>
          <ns0:quote>añadir</ns0:quote>
          <ns0:quote>adjuntar</ns0:quote>
          <ns0:quote>apostillar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To add, as an accessory to the principal thing; to annex</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appendage</ns0:orth>
        <ns0:pron>/əˈpɛndɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extremidad</ns0:quote>
          <ns0:quote>miembro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An external body part that projects from the body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A natural prolongation or projection from a part of any organism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>añadidura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A part that is joined to something larger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appendectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apendicectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) The surgical procedure for the removal of the vermiform appendix.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appendiceal</ns0:orth>
        <ns0:pron>/əˌpɛndəˈsiəl/&lt;qq:proscribed&gt;</ns0:pron>
        <ns0:pron>/ˈdɪʃəl/</ns0:pron>
        <ns0:pron>/ˌæpənˈdɪsiəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apendicular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Of or pertaining to the appendix.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appendicitis</ns0:orth>
        <ns0:pron>/əˈpɛnd.ɪ.saɪt.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apendicitis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) inflammation of the vermiform appendix</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appendix</ns0:orth>
        <ns0:pron>/əˈpɛn.dɪks/</ns0:pron>
        <ns0:pron>/əˈpɪn.dɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apéndice</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apperception</ns0:orth>
        <ns0:pron>/ˌæpəˈsɛpʃən/</ns0:pron>
        <ns0:pron>/ˌæpɚˈsɛpʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apercepción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, psychology, and, philosophy, especially Kantianism) The mind's perception of itself as the subject or actor in its own states, unifying past and present experiences; self-consciousness, perception that reflects upon itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appetite</ns0:orth>
        <ns0:pron>/ˈæpəˌtaɪt/</ns0:pron>
        <ns0:pron>/ˈæpɪtaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apetito</ns0:quote>
          <ns0:quote>ganas</ns0:quote>
          <ns0:quote>deseo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The desire for some personal gratification, either of the body or of the mind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appetite comes with eating</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el apetito viene comiendo</ns0:quote>
          <ns0:quote>el comer y el rascar, todo es empezar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) Starting an activity increases one's desire to continue it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appetizer</ns0:orth>
        <ns0:pron>/ˈæpɪˌtaɪzə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreboca</ns0:quote>
          <ns0:quote>aperitivo</ns0:quote>
          <ns0:quote>tapa</ns0:quote>
          <ns0:quote>antojito</ns0:quote>
          <ns0:quote>boca</ns0:quote>
          <ns0:quote>bocadito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small, light, and usually savory first course in a meal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appetizing</ns0:orth>
        <ns0:pron>/ˈæp.ə.taɪz.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apetitoso</ns0:quote>
          <ns0:quote>apetecedor</ns0:quote>
          <ns0:quote>apetecible</ns0:quote>
          <ns0:quote>apetitivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That appeals to, or stimulates the appetite.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applaud</ns0:orth>
        <ns0:pron>/əˈplɑd/</ns0:pron>
        <ns0:pron>/əˈplɔd/</ns0:pron>
        <ns0:pron>/əˈplɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplaudir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, intransitive) To express approval (of something) by clapping the hands.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, intransitive) To praise, or express approval for something or someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applause</ns0:orth>
        <ns0:pron>/əˈplɑz/</ns0:pron>
        <ns0:pron>/əˈplɔz/</ns0:pron>
        <ns0:pron>/əˈplɔːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplauso</ns0:quote>
          <ns0:quote>aplausos</ns0:quote>
          <ns0:quote>palmas</ns0:quote>
          <ns0:quote>plauso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of applauding; approbation and praise publicly expressed by the clapping of hands, stamping or tapping of the feet, acclamation, huzzas, or other means; marked commendation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple</ns0:orth>
        <ns0:pron>/ˈapəl/</ns0:pron>
        <ns0:pron>/ˈapɪl/</ns0:pron>
        <ns0:pron>/ˈæp.l̩/</ns0:pron>
        <ns0:pron>/ˈɑpɪl/</ns0:pron>
        <ns0:pron>[-ɘl ~ -ɘɭ]</ns0:pron>
        <ns0:pron>[ɛːpɐl]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manzana</ns0:quote>
          <ns0:quote>poma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tree of the genus Malus; especially Malus domestica which is cultivated for its edible fruit; the apple tree. [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple blossom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>flor de manzano</ns0:quote>
          <ns0:quote>flor del manzano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The flower of an apple tree that will eventually turn into an apple.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple bobbing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>morder la manzana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A game, popular at Halloween, in which players try to pick up apples out of a large basin of water, using only their mouths.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple cake</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pastel de manzana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of cake containing sliced apples.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple cider vinegar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vinagre de sidra de manzana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A vinegar, made from cider or apple must along with yeast and bacteria, that has been matured in wooden barrels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple juice</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zumo de manzana</ns0:quote>
          <ns0:quote>jugo de manzana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) Filtered and pasteurized juice of apples, as opposed to apple cider and hard cider.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple mint</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>yerba buena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Mentha × villosa (M. spicata × M. suaveolens)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple of Sodom</ns0:orth>
        <ns0:pron>/ˈæp(ə)l əv ˈsɑdəm/</ns0:pron>
        <ns0:pron>/ˈæp(ə)l əv ˈsɒdəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algodón de seda</ns0:quote>
          <ns0:quote>flor de seda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mudar (Calotropis procera), a flowering plant, found from northern Africa to southeast Asia, which bears poisonous fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple of discord</ns0:orth>
        <ns0:pron>/ˈæp(ə)l əv ˈdɪskɔɹd/</ns0:pron>
        <ns0:pron>/ˈæp(ə)l əv ˈdɪskɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manzana de la discordia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An object or topic which sows anger and dissension; something which causes argument, rivalry, or strife.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple of someone's eye</ns0:orth>
        <ns0:pron>/ˌæp(ə)l‿əv sʌmwʌnz ˈaɪ/</ns0:pron>
        <ns0:pron>/ˌæpl̩‿əv sʌmwʌnz ˈaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>niña de sus ojos</ns0:quote>
          <ns0:quote>ojito derecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) The object of somebody's affections; a person (or sometimes a thing) that someone strongly prefers; a favorite, a loved one.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple pear</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pera asiática</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pyrus pyrifolia, the tree that bears this fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple pie</ns0:orth>
        <ns0:pron>/ˌæp.əlˈpaɪ/</ns0:pron>
        <ns0:pron>/ˌæp.əlˈpɑɪ/</ns0:pron>
        <ns0:pron>[ˌæp.ɫ̩ˈpaɪ]</ns0:pron>
        <ns0:pron>[ˌæp.ɫ̩ˈpɑɪ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tarta de manzana</ns0:quote>
          <ns0:quote>pastel de manzana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pie or tart made with a filling of cooked apples.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple sauce</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compota de manzanas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK spelling) A culinary dish prepared by pureeing cooked apples.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple tree</ns0:orth>
        <ns0:pron>/ˈæpl̩ tɹi/</ns0:pron>
        <ns0:pron>/ˈæpl̩ tɹiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manzano</ns0:quote>
          <ns0:quote>melo</ns0:quote>
          <ns0:quote>pomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Any tree that bears apples, principally Malus domestica but also certain wild species.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple wine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sidra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An alcoholic beverage made from apples; cider.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apple-green</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>verde manzana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of an apple-green (noun sense) colour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apples and oranges</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>peras y manzanas</ns0:quote>
          <ns0:quote>no hay punto de comparación</ns0:quote>
          <ns0:quote>patatas y apichus</ns0:quote>
          <ns0:quote>peras con manzanas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) A comparison of items that, however categorically similar, is inapt; an incompatible analogy, or the items so compared; a disanalogy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appliance</ns0:orth>
        <ns0:pron>/əˈplaɪ.əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparato</ns0:quote>
          <ns0:quote>electrodoméstico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A non-manual apparatus or device, powered electrically or by another small motor, used in homes to perform domestic functions (household appliance) and/or in offices.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparato</ns0:quote>
          <ns0:quote>enseres</ns0:quote>
          <ns0:quote>implemento</ns0:quote>
          <ns0:quote>instrumento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An implement, an instrument or apparatus designed (or at least used) as a means to a specific end, especially:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applicability</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The degree to which a thing is applicable; relevancy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applicable</ns0:orth>
        <ns0:pron>/əˈplɪkəbəl/</ns0:pron>
        <ns0:pron>/ˈæplɪkəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicable</ns0:quote>
          <ns0:quote>aplicadero</ns0:quote>
          <ns0:quote>pertinente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Suitable for application, relevant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applicant</ns0:orth>
        <ns0:pron>/ˈæp.lə.kɪnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>peticionario</ns0:quote>
          <ns0:quote>solicitante</ns0:quote>
          <ns0:quote>postulante</ns0:quote>
          <ns0:quote>candidato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who applies for something; one who makes a request; a petitioner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>application</ns0:orth>
        <ns0:pron>/əplɪˈkeʃən/</ns0:pron>
        <ns0:pron>/ˈaplɪkeʃən/</ns0:pron>
        <ns0:pron>/ˌæplɨˈkeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of physically applying or laying on.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of applying as a means; the employment of means to accomplish an end; specific use.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of directing or referring something to a particular case, to discover or illustrate agreement or disagreement, fitness, or correspondence.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing) A computer program or the set of software that the end user perceives as a single entity as a tool for a well-defined purpose. (Also called: application program; application software.)</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of requesting, claiming, or petitioning something.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(comptheory) The substitution of a specific value for the parameter in the abstraction, in lambda calculus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>solicitud</ns0:quote>
          <ns0:quote>aplicación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A verbal or written request for assistance or employment or admission to a school, course or similar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>application programming interface</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>interfaz de programación de aplicaciones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, programming) A set of routines, protocols, and tools for building software applications, which makes it possible for software components to interact with one another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applicator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tool or device used to apply a fluid or semi-fluid substance to a surface.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A tubular device to insert a tampon into the vagina.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applied</ns0:orth>
        <ns0:pron>/əˈplaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Put into practical use.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applied mathematics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matemáticas aplicadas</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applied science</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ciencia aplicada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(science) Science as applied to practical problems (applications), such as engineering and the advancement of technology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applique</ns0:orth>
        <ns0:pron>/əˈpliː.keɪ/</ns0:pron>
        <ns0:pron>/ˈæ.plɪ.keɪ/</ns0:pron>
        <ns0:pron>/ˌæ.plɪˈkeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplique</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(arts) A decorative design made by cutting pieces of material and applying them to the surface of another for decoration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>applique</ns0:orth>
        <ns0:pron>/əˈpliː.keɪ/</ns0:pron>
        <ns0:pron>/ˈæ.plɪ.keɪ/</ns0:pron>
        <ns0:pron>/ˌæ.plɪˈkeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decorar con apliques</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, arts) To decorate something in this way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apply</ns0:orth>
        <ns0:pron>/əˈplaɪ/</ns0:pron>
        <ns0:pron>[əˈplaɪ]</ns0:pron>
        <ns0:pron>[əˈplɑj]</ns0:pron>
        <ns0:pron>[əˈplɑɪ]</ns0:pron>
        <ns0:pron>[əˈpləj]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To lay or place; to put (one thing to another)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicar</ns0:quote>
          <ns0:quote>utilizar</ns0:quote>
          <ns0:quote>aplicarse</ns0:quote>
          <ns0:quote>convenir</ns0:quote>
          <ns0:quote>cuadrar</ns0:quote>
          <ns0:quote>emplear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put to use; to use or employ for a particular purpose, or in a particular case</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aplicarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put closely; to join; to engage and employ diligently or with attention.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(reflexive) To work diligently and attentively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dirigirse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, usually, reflexive) To address oneself; to refer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>solicitar</ns0:quote>
          <ns0:quote>postular</ns0:quote>
          <ns0:quote>presentarse</ns0:quote>
          <ns0:quote>aplicar</ns0:quote>
          <ns0:quote>optar</ns0:quote>
          <ns0:quote>postularse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To submit oneself as a candidate (with the adposition "to" or "at" designating the recipient of the submission, and the adposition "for" designating the position).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appoint</ns0:orth>
        <ns0:pron>/əˈpɔɪnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>designar</ns0:quote>
          <ns0:quote>equipar</ns0:quote>
          <ns0:quote>nombrar</ns0:quote>
          <ns0:quote>nombrar a dedo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To furnish or equip (a place) completely; to provide with all the equipment or furnishings necessary; to fit out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fijar</ns0:quote>
          <ns0:quote>determinar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete, transitive) To fix with power or firmness by decree or command; to ordain or establish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appointee</ns0:orth>
        <ns0:pron>/əˌpɔɪnˈtiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>persona designada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a person who is appointed</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appointment</ns0:orth>
        <ns0:pron>/əˈpɔɪnt.mɛnt/</ns0:pron>
        <ns0:pron>/əˈpɔɪnt.mɪnt/</ns0:pron>
        <ns0:pron>[əˈpʰɔɪ̯nʔmɪnʔ]</ns0:pron>
        <ns0:pron>[əˈpʰɔɪ̯̃ʔmɪnʔ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nombramiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of appointing a person to hold an office or to have a position of trust</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being appointed to a service or office; an office to which one is appointed</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compromiso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Stipulation; agreement; the act of fixing by mutual agreement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nombramiento</ns0:quote>
          <ns0:quote>cita</ns0:quote>
          <ns0:quote>apoinmen</ns0:quote>
          <ns0:quote>appointment</ns0:quote>
          <ns0:quote>apuntamento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(government) The assignment of a person by an official to perform a duty, such as a presidential appointment of a judge to a court.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apportion</ns0:orth>
        <ns0:pron>/əˈpɔɹʃən/</ns0:pron>
        <ns0:pron>/əˈpɔːʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>distribuir</ns0:quote>
          <ns0:quote>repartir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To divide and distribute portions of a whole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apportionment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reparto</ns0:quote>
          <ns0:quote>aporcionamiento</ns0:quote>
          <ns0:quote>distribución</ns0:quote>
          <ns0:quote>prorrateo</ns0:quote>
          <ns0:quote>racionamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) The distribution of members of the House of Representatives according to the population of the various states.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apposite</ns0:orth>
        <ns0:pron>/əˈpɑ.zɪt/</ns0:pron>
        <ns0:pron>/əˈpɒz.ɪt/</ns0:pron>
        <ns0:pron>/ˈæp.ə.zɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apropiado</ns0:quote>
          <ns0:quote>oportuno</ns0:quote>
          <ns0:quote>pertinente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Strikingly appropriate or relevant; well suited to the circumstance or in relation to something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apposition</ns0:orth>
        <ns0:pron>/ˌæpəˈzɪʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aposición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A construction in which one noun or noun phrase is placed with another as an explanatory equivalent, both of them having the same syntactic function in the sentence.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology) The growth of successive layers of a cell wall.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appraisal</ns0:orth>
        <ns0:pron>/əˈpɹeɪzəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aforamiento</ns0:quote>
          <ns0:quote>justipreciación</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appraise</ns0:orth>
        <ns0:pron>/əˈpɹeɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aforar</ns0:quote>
          <ns0:quote>justipreciar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appraiser</ns0:orth>
        <ns0:pron>/əˈpɹeɪz.ə(ɹ)/</ns0:pron>
        <ns0:pron>/əˈpɹeɪz.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tasador</ns0:quote>
          <ns0:quote>tasadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who performs appraisals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appreciable</ns0:orth>
        <ns0:pron>/əˈpɹiːʃəbl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apreciable</ns0:quote>
          <ns0:quote>considerable</ns0:quote>
          <ns0:quote>sensible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually) Both detectable#Adjective and at least modestly substantial#Adjective: large enough to be estimated and to be of practical relevance#Noun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appreciate</ns0:orth>
        <ns0:pron>/əˈpɹiː.si.eɪt/</ns0:pron>
        <ns0:pron>/əˈpɹiː.ʃi.eɪt/</ns0:pron>
        <ns0:pron>/əˈpɹɪʃ.i.eɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apreciar</ns0:quote>
          <ns0:quote>agradecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be grateful or thankful for.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>valorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To view as valuable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comprender</ns0:quote>
          <ns0:quote>hacerse cargo de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be fully conscious of; understand; be aware of; detect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aumentar su valor</ns0:quote>
          <ns0:quote>avalorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, transitive) To increase in value.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appreciation</ns0:orth>
        <ns0:pron>/əˌpɹiː.ʃiˈeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apreciación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rise in value.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appreciative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apreciativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Showing appreciation or gratitude.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appreciator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apreciador</ns0:quote>
          <ns0:quote>apreciadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who appreciates a given thing, especially:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprehend</ns0:orth>
        <ns0:pron>/ˌæpɹɪˈhend/</ns0:pron>
        <ns0:pron>/ˌæpɹɪˈhɛnd/</ns0:pron>
        <ns0:pron>/ˌɛpɹəˈhend/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprehender</ns0:quote>
          <ns0:quote>comprender</ns0:quote>
          <ns0:quote>entender</ns0:quote>
          <ns0:quote>captar</ns0:quote>
          <ns0:quote>capturar</ns0:quote>
          <ns0:quote>coger</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To take hold of (something) with understanding; to conceive (something) in the mind; to become cognizant of; to understand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detener</ns0:quote>
          <ns0:quote>aprehender</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law enforcement) To seize or take (a person) by legal process; to arrest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>temer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To anticipate (something, usually unpleasant); especially, to anticipate (something) with anxiety, dread, or fear; to dread, to fear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprehensible</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprehensible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary) Which can be apprehended (usually in the sense of being understood).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprehension</ns0:orth>
        <ns0:pron>/æp.ɹiˈhɛn.ʃən/</ns0:pron>
        <ns0:pron>/æp.ɹɪˈhɛn.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arresto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The act of seizing or taking by legal process; arrest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprensión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anticipation, especially of unfavorable things such as dread or fear or the prospect of something unpleasant in the future.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprehensive</ns0:orth>
        <ns0:pron>/ˌæpɹɪˈhɛnsɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inquieto</ns0:quote>
          <ns0:quote>aprensivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anticipating something with anxiety, fear, or doubt; reluctant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprehensivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Perceptive; quick to learn; capable of understanding using one's intellect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprentice</ns0:orth>
        <ns0:pron>/əˈpɹɛntɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprendiz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A trainee, especially in a skilled trade.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprenticeship</ns0:orth>
        <ns0:pron>/əˈpɹɛn.tɪs.ʃɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprendizaje</ns0:quote>
          <ns0:quote>tiempo como aprendiz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition of, or the time served by, an apprentice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>formación profesional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The system by which a person learning a craft or trade is instructed by a master for a set time under set conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appressed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adpreso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, mycology) Closely flattened down.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apprise</ns0:orth>
        <ns0:pron>/əˈpɹaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avisar</ns0:quote>
          <ns0:quote>informar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make (someone or oneself) aware of some information; to inform, to notify.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approach</ns0:orth>
        <ns0:pron>/əˈpɹoʊt͡ʃ/</ns0:pron>
        <ns0:pron>/əˈpɹəʊt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acercamiento</ns0:quote>
          <ns0:quote>aproximación</ns0:quote>
          <ns0:quote>llegada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(also, figuratively) An act of drawing near in place or time; an advancing or coming near.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(also, figuratively) An avenue, passage, or way by which a building or place can be approached; an access.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfoque</ns0:quote>
          <ns0:quote>planteamiento</ns0:quote>
          <ns0:quote>abordaje</ns0:quote>
          <ns0:quote>talante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A manner of making (a policy) or solving (a problem, etc.).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acercamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) An opportunity of drawing near; access.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aproximación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation, also, attributively) The way an aircraft comes in to land at an airport.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approach</ns0:orth>
        <ns0:pron>/əˈpɹoʊt͡ʃ/</ns0:pron>
        <ns0:pron>/əˈpɹəʊt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abordar</ns0:quote>
          <ns0:quote>acometer</ns0:quote>
          <ns0:quote>entablar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acercar</ns0:quote>
          <ns0:quote>avecinar</ns0:quote>
          <ns0:quote>aproximarse</ns0:quote>
          <ns0:quote>dirigirse a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To come or go near, in place or time; to move toward; to advance nearer; to draw nigh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aproximar</ns0:quote>
          <ns0:quote>acercarse</ns0:quote>
          <ns0:quote>aproximarse</ns0:quote>
          <ns0:quote>avecinarse</ns0:quote>
          <ns0:quote>plantear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive, figuratively) Used intransitively, followed by to: to draw near (to someone or something); to make advances; to approximate or become almost equal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plantear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To bring up or propose to (someone) an idea, question, request, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approachable</ns0:orth>
        <ns0:pron>/əˈpɹoʊ.t͡ʃə.bəl/</ns0:pron>
        <ns0:pron>/əˈpɹəʉ.t͡ʃə.bəl/</ns0:pron>
        <ns0:pron>/əˈpɹəʊ.t͡ʃə.bəl/</ns0:pron>
        <ns0:pron>[əˈpɹoʊ.t͡ʃə.bl̩]</ns0:pron>
        <ns0:pron>[əˈpɹəʉ.t͡ʃə.bl̩]</ns0:pron>
        <ns0:pron>[əˈpɹəʊ.t͡ʃə.bl̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesible</ns0:quote>
          <ns0:quote>abordable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Easily approached; easy to talk to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approaching</ns0:orth>
        <ns0:pron>/əˈpɹoʊt͡ʃɪŋ/</ns0:pron>
        <ns0:pron>/əˈpɹəʊt͡ʃɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acercador</ns0:quote>
          <ns0:quote>acercante</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approbation</ns0:orth>
        <ns0:pron>/ˌæp.ɹoʊˈbeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæp.ɹəʊˈbeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæp.ɹəˈbeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprobación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of approving; an assenting to the propriety of a thing with some degree of pleasure or satisfaction; approval, sanction, commendation or official recognition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appropriate</ns0:orth>
        <ns0:pron>/əˈpɹoʊ.pɹi.ət/</ns0:pron>
        <ns0:pron>/əˈpɹoʊ.pɹi.ɪt/</ns0:pron>
        <ns0:pron>/əˈpɹəʊ.pɹi.ət/</ns0:pron>
        <ns0:pron>/əˈpɹəʊ.pɹi.ɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apropiado</ns0:quote>
          <ns0:quote>adecuado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Suitable or fit; proper; felicitous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apropiado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Set apart for a particular use or person; reserved.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appropriate</ns0:orth>
        <ns0:pron>/əˈpɹoʊ.pɹi.eɪt/</ns0:pron>
        <ns0:pron>/əˈpɹəʊ.pɹi.eɪt/</ns0:pron>
        <ns0:pron>/əˈpɾɔpɾɪeʈ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adueñarse</ns0:quote>
          <ns0:quote>designar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To set apart for, or assign to, a particular person or use, especially in exclusion of all others; with to or for.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appropriately</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apropiadamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an appropriate manner; properly; suitably.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appropriateness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>idoneidad</ns0:quote>
          <ns0:quote>pertinencia</ns0:quote>
          <ns0:quote>propiedad</ns0:quote>
          <ns0:quote>propriedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality or condition of being appropriate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appropriation</ns0:orth>
        <ns0:pron>/əˌpɹoʊpɹiˈeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apropiación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An act or instance of appropriating.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>crédito de gasto presupuestario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Public funds set aside for a specific purpose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approval</ns0:orth>
        <ns0:pron>/əˈpɹuvəl/</ns0:pron>
        <ns0:pron>/əˈpɹuːvəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprobación</ns0:quote>
          <ns0:quote>beneplácito</ns0:quote>
          <ns0:quote>venia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expression granting permission; an indication of agreement with a proposal; an acknowledgement that a person, thing, or event meets requirements.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approve</ns0:orth>
        <ns0:pron>/əˈpɹuːv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprobar</ns0:quote>
          <ns0:quote>sancionar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To officially sanction; to ratify; to confirm; to set as satisfactory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ver con buenos ojos</ns0:quote>
          <ns0:quote>aprobar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To regard as good; to commend; to be pleased with; to think well of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprobar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To make proof of; to demonstrate; to prove or show practically.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, followed by "of") To consider worthy (to); to be pleased (with); to accept.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approved</ns0:orth>
        <ns0:pron>/əˈpɹuːvd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprobado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having received approval.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approvingly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con aprobación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>in an approving manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approx.</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprox.</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Abbreviation of approximately.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approximate</ns0:orth>
        <ns0:pron>/əˈpɹɑk.sə.mət/</ns0:pron>
        <ns0:pron>/əˈpɹɑk.sɪ.mət/</ns0:pron>
        <ns0:pron>/əˈpɹɒk.sɪ.mət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aproximado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Approaching; proximate; nearly resembling.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Nearing correctness; nearly exact; not perfectly accurate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approximate</ns0:orth>
        <ns0:pron>/əˈpɹɑk.sə.meɪt/</ns0:pron>
        <ns0:pron>/əˈpɹɒk.sɪ.meɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acercarse</ns0:quote>
          <ns0:quote>aproximarse</ns0:quote>
          <ns0:quote>estimar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To come near to; to approach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acercar</ns0:quote>
          <ns0:quote>avanzar</ns0:quote>
          <ns0:quote>estrechar</ns0:quote>
          <ns0:quote>juntar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To carry or advance near; to cause to approach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approximately</ns0:orth>
        <ns0:pron>/əˈpɹɑk.sɪ.mət.li/</ns0:pron>
        <ns0:pron>/əˈpɹɒk.sɪ.mət.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aproximadamente</ns0:quote>
          <ns0:quote>a eso de</ns0:quote>
          <ns0:quote>más o menos</ns0:quote>
          <ns0:quote>a aqueso de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Imprecise but close to in quantity or amount.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>approximation</ns0:orth>
        <ns0:pron>/əˌpɹɑk.sɪˈmeɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌpɹɒk.səˈmæɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌpɹɒk.sɪˈmeɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌpɹɔk.sɪˈmæɪ.ʃən/</ns0:pron>
        <ns0:pron>[əˌpɹɑk.sɪˈmeɪ.ʃn̩]</ns0:pron>
        <ns0:pron>[əˌpɹɒk.sɪˈmeɪ.ʃn̩]</ns0:pron>
        <ns0:pron>[əˌpɹɔk.sɪˈmæɪ.ʃn̩]</ns0:pron>
        <ns0:pron>[əˌpɹɔ̟k.səˈmæɪ.ʃn̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aproximación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) An imprecise solution or result that is adequate for a defined purpose.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(linguistics) The act of producing a near-simulation of the pronunciation of a foreign language for a loanword therefrom, or any given pronunciation resulting from that act.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>appurtenance</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparejos</ns0:quote>
          <ns0:quote>pertrechos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(in the plural) Equipment used for some specific task; gear. [from late 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apraxia</ns0:orth>
        <ns0:pron>/əˈpɹæksɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apraxia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neurology) Total or partial loss of the ability to perform coordinated movements or manipulate objects in the absence of motor or sensory impairment; specifically, a disorder of motor planning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apricate</ns0:orth>
        <ns0:pron>/ˈæpɹikeɪt/</ns0:pron>
        <ns0:pron>/ˈæpɹɪkeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asolearse</ns0:quote>
          <ns0:quote>lagartear</ns0:quote>
          <ns0:quote>solearse</ns0:quote>
          <ns0:quote>tomar sol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, rare) To bask in the sun.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, also, figuratively, rare) To disinfect and freshen by exposing to the sun; to sun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apricot</ns0:orth>
        <ns0:pron>/æepɹɪˈkɒt/</ns0:pron>
        <ns0:pron>/æepɹɪˈkɔt/</ns0:pron>
        <ns0:pron>/ˈeɪ.pɹɪ.kɑt/</ns0:pron>
        <ns0:pron>/ˈeɪ.pɹɪ.kɒt/</ns0:pron>
        <ns0:pron>/ˈæp.ɹɪ.kɑt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>damasco</ns0:quote>
          <ns0:quote>albaricoquero</ns0:quote>
          <ns0:quote>albarcoquero</ns0:quote>
          <ns0:quote>alberchiguero</ns0:quote>
          <ns0:quote>albercoquero</ns0:quote>
          <ns0:quote>albergero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The apricot tree, Prunus armeniaca.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albaricoque</ns0:quote>
          <ns0:quote>chabacano</ns0:quote>
          <ns0:quote>albérchigo</ns0:quote>
          <ns0:quote>albercoque</ns0:quote>
          <ns0:quote>albarcoque</ns0:quote>
          <ns0:quote>alberge</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pale yellow-orange colour, like that of an apricot fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apron</ns0:orth>
        <ns0:pron>/ˈeɪ.pəɹn/&lt;q:obsolete&gt;&lt;ref:{{R:Jespersen MEGoHP|I|9.72|275}}&gt;</ns0:pron>
        <ns0:pron>/ˈeɪ.pɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>delantal</ns0:quote>
          <ns0:quote>mandil</ns0:quote>
          <ns0:quote>excusalí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The loading, parking or roadway area immediately beside a railway station or marine terminal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apronym</ns0:orth>
        <ns0:pron>/ˈæp.ɹə.nɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apropónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An acronym or backronym that spells out another word or phrase relating to the meaning of the phrase that it abbreviates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apropos</ns0:orth>
        <ns0:pron>/ˌæp.ɹəˈpoʊ/</ns0:pron>
        <ns0:pron>/ˌæp.ɹəˈpəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a propósito</ns0:quote>
          <ns0:quote>oportuno</ns0:quote>
          <ns0:quote>pertinente</ns0:quote>
          <ns0:quote>propositivo</ns0:quote>
          <ns0:quote>relevante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of an appropriate or pertinent nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apropos</ns0:orth>
        <ns0:pron>/ˌæp.ɹəˈpoʊ/</ns0:pron>
        <ns0:pron>/ˌæp.ɹəˈpəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a propósito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>By the way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apropos</ns0:orth>
        <ns0:pron>/ˌæp.ɹəˈpoʊ/</ns0:pron>
        <ns0:pron>/ˌæp.ɹəˈpəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a propósito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Regarding, concerning, in regard to, on the subject of:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apropos of nothing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprovechando que el Pisuerga pasa por Valladolid</ns0:quote>
          <ns0:quote>de la nada</ns0:quote>
          <ns0:quote>sin venir a cuento</ns0:quote>
          <ns0:quote>sin venir al caso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without reference to anything.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apse</ns0:orth>
        <ns0:pron>/æps/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ábside</ns0:quote>
          <ns0:quote>ábsida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A semicircular projection from a building, especially the rounded east end of a church that contains the altar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apsis</ns0:orth>
        <ns0:pron>/ˈæpsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ápside</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) Either of the points in the elliptical orbit of a planet, comet, or moon where it is closest or furthest from the body it orbits; examples are perihelion, aphelion, perigee, and apogee</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apt</ns0:orth>
        <ns0:pron>/æpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apto</ns0:quote>
          <ns0:quote>acertado</ns0:quote>
          <ns0:quote>apropiado</ns0:quote>
          <ns0:quote>oportuno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Suitable; appropriate; fit or fitted; suited.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aptitude</ns0:orth>
        <ns0:pron>/ˈæptɪˌtjuːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aptitud</ns0:quote>
          <ns0:quote>capacidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Natural ability to acquire knowledge or skill.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conveniencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition of being suitable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aptly</ns0:orth>
        <ns0:pron>/ˈæp(t).li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acertadamente</ns0:quote>
          <ns0:quote>aptamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an apt or suitable manner; fittingly; appropriately; suitably</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apyrexia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apirexia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The absence or an intermission during a bout of fever.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>apéritif</ns0:orth>
        <ns0:pron>/ɑːˌpɛɹɪˈtiːf/</ns0:pron>
        <ns0:pron>/əˌpɛɹɪˈtiːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aperitivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An alcoholic drink served before a meal as an appetiser.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aqua regia</ns0:orth>
        <ns0:pron>/ˈɑː.kwə ˈɹeɪ.ɡi.ə/</ns0:pron>
        <ns0:pron>/ˌækwə ˈɹiː.ʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agua regia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound, archaic) A mixture of three parts concentrated hydrochloric acid to one part concentrated nitric acid, named for its ability to dissolve gold.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquaculture</ns0:orth>
        <ns0:pron>/ˈækwəˌkʌlt͡ʃə/</ns0:pron>
