        <ns0:pron>[ˈpʰoʊ̯kɪmɒn]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pokémon</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pocket monster; a fictional creature from the universe of the Pokémon franchise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Poland</ns0:orth>
        <ns0:pron>/ˈpoɫ.ənd/</ns0:pron>
        <ns0:pron>/ˈpoʊ.lənd/</ns0:pron>
        <ns0:pron>/ˈpəʊ.lənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Polonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in Central Europe. Official name: Republic of Poland. Capital and largest city: Warsaw.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polari</ns0:orth>
        <ns0:pron>/pəˈlɑːri/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>polari</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cant used in the London fishmarkets, in the British theatre, and by the gay community in Britain, attested since at least the 19th century and popularised in the 1950s and 1960s by the camp characters Julian and Sandy in the popular BBC radio show Round the Horne.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polaris</ns0:orth>
        <ns0:pron>/poʊˈlɑɹɪs/</ns0:pron>
        <ns0:pron>/poʊˈlɛɹɪs/</ns0:pron>
        <ns0:pron>[poˈleɹ.ɪs]</ns0:pron>
        <ns0:pron>[poˈlɑɹ.ɪs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Polaris</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(star) α Ursae Minoris, a trinary star in the constellation Ursa Minor located near the north celestial pole for the last 1500 years.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pole</ns0:orth>
        <ns0:pron>/pol/</ns0:pron>
        <ns0:pron>/poʊl/</ns0:pron>
        <ns0:pron>/pɐʉl/</ns0:pron>
        <ns0:pron>/pəʊl/</ns0:pron>
        <ns0:pron>[pʰoəɫ]</ns0:pron>
        <ns0:pron>[pʰoɫ]</ns0:pron>
        <ns0:pron>[pʰoʊɫ]</ns0:pron>
        <ns0:pron>[pʰɒʊɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>polaco</ns0:quote>
          <ns0:quote>polaca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from Poland or of Polish descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish</ns0:orth>
        <ns0:pron>/ˈpoʊlɪʃ/</ns0:pron>
        <ns0:pron>/ˈpəʊlɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>polaco</ns0:quote>
          <ns0:quote>polonés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from or native to Poland, or relating to the Polish language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish</ns0:orth>
        <ns0:pron>/ˈpoʊlɪʃ/</ns0:pron>
        <ns0:pron>/ˈpəʊlɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>polaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language spoken in Poland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish Orthodox Church</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iglesia ortodoxa polaca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An autocephalous Eastern Orthodox church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish People's Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Popular de Polonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Former official name of Poland: a country in Central Europe; used from 1952 to 1989 when it was a one-party, Marxist-Leninist state; officially known as the Republic of Poland from 1947 to 1952, but under the same form of government.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish notation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>notación polaca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(arithmetic, logic) A notation for arithmetic (and logical) formulae in which operations (respectively, quantifiers and operands) are written immediately before their operands, used to avoid the need for parentheses; for example, 3 * (4 + 7) is written as * 3 + 4 7 and A AND B is written as AND A B.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish space</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espacio polaco</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Polish-Lithuanian Commonwealth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
