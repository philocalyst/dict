      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archiduque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The son or male-line grandson of an emperor of the Austro-Hungarian Empire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archegonium</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arquegonio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A multicellular reproductive structure that contains a large, non-motile gamete (egg cell), and within which an embryo will develop.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
