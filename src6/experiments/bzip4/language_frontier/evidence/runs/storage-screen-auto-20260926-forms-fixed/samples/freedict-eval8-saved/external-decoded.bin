        </ns0:cit>
        <ns0:sense>
          <ns0:def>(book of the bible) A book of the Jewish Tanakh, divided into two Books of Chronicles in the Christian Bible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
