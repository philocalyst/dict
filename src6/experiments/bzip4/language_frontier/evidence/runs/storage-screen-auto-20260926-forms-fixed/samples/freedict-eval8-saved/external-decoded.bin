        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Peter Pan syndrome</ns0:orth>
        <ns0:pron>/piːtə pan ˈsɪndɹəʊm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>síndrome de Peter Pan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) The supposed psychological phenomenon of immaturity among some men, who, like the fictional character, remain childish or childlike and fail to assume appropriate adult social roles and responsibilities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
