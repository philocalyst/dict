      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zorro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fictional character, a daring and mysterious avenger, created in 1919 by pulp writer Johnston McCulley.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zouave</ns0:orth>
        <ns0:pron>/zuˈɑv/</ns0:pron>
        <ns0:pron>/zuːˈɑːv/</ns0:pron>
        <ns0:pron>/zwɑv/</ns0:pron>
        <ns0:pron>/zwɑːv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zuavo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, historical) One of a body of soldiers in the French service, originally Kabyle, but now composed of Frenchmen who wear the Kabyle dress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
