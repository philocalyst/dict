      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dari</ns0:orth>
        <ns0:pron>/ˈdɑːɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dari</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The variety of the Persian language that is chiefly used in Afghanistan, contrasted with varieties spoken elsewhere such as Iranian Persian or Tajik.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical, now less common) A variety of Middle Persian which served as the court language of the late Sasanian Empire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darius</ns0:orth>
        <ns0:pron>/dəˈɹaɪ.əs/</ns0:pron>
        <ns0:pron>/ˈdæɹi.əs/</ns0:pron>
        <ns0:pron>/ˈdɑɹi.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Darío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several kings in Achaemenid dynasty of Persia, 6th to 4th century BCE.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darién Gap</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tapón del Darién</ns0:quote>
          <ns0:quote>región del Darién</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dark Ages</ns0:orth>
        <ns0:pron>/ˈdɑːˌkeɪd͡ʒɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Edad Oscura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(see usage notes) The period of European history encompassing (roughly) 476–1000 CE.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dark Enlightenment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ilustración Oscura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The neo-reactionary movement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darth Vader</ns0:orth>
        <ns0:pron>/ˈdɑː(ɹ)θ ˈveɪ.də(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Darth Vader</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Darth Vader, a villain of the science-fantasy film series Star Wars.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darwin Award</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Premio Darwin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(jocular) One of the international honours awarded to people who supposedly help to improve the human gene pool by removing themselves from it in a spectacularly stupid manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darwin's fox</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zorro chilote</ns0:quote>
          <ns0:quote>zorro de Darwin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fox-like South American canid of species Lycalopex fulvipes, found predominantly on Chiloé.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darwin's rhea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ñandú petizo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small rhea, Rhea pennata, found from Patagonia to the high Andes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darwinian</ns0:orth>
        <ns0:pron>/dɑɹˈwɪ.ni.ən/</ns0:pron>
        <ns0:pron>/dɑːˈwɪ.ni.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darwiniano</ns0:quote>
          <ns0:quote>darwinista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the scientific views advanced by the English biologist, geologist, and naturalist Charles Darwin, especially his theory that living organisms evolve through the natural selection of inherited variations that increase organisms' ability to compete, survive, and reproduce.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darwiniano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Darwin, the capital city of the Northern Territory, Australia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darwinian</ns0:orth>
        <ns0:pron>/dɑɹˈwɪ.ni.ən/</ns0:pron>
        <ns0:pron>/dɑːˈwɪ.ni.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darwiniano</ns0:quote>
          <ns0:quote>darwinista</ns0:quote>
          <ns0:quote>darwiniana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An adherent of Charles Darwin's theory of the origin of species, or of Darwinism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darwiniana</ns0:quote>
          <ns0:quote>darwiniano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or resident of Darwin in the Northern Territory, Australia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Darwinism</ns0:orth>
        <ns0:pron>/ˈdɑːwɪnɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darwinismo</ns0:quote>
          <ns0:quote>darvinismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The principles of natural selection set out in Charles Darwin's On the Origin of Species (1859), more strictly defined by August Weismann and developed by other authors into a central part of the modern evolutionary synthesis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dasher</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alegre</ns0:quote>
          <ns0:quote>Brioso</ns0:quote>
          <ns0:quote>Enérgico</ns0:quote>
          <ns0:quote>Jactancioso</ns0:quote>
          <ns0:quote>Presuntuoso</ns0:quote>
          <ns0:quote>Vondín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first reindeer of Santa Claus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Datong</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Datong</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A prefecture-level city of Shanxi, China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dauphiné</ns0:orth>
        <ns0:pron>/dəʊfɪˈneɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
