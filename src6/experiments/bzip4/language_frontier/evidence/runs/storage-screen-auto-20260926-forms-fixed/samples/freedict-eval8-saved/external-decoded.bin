          <ns0:quote>Simónides</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(c. 556 BCE – 468 BCE) Ancient Greek lyric poet from the island of Ceos.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Simplified Chinese</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chino simplificado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Chinese written using the forms of Chinese characters introduced by the People's Republic of China as script reform. The characters are simplified (with a reduced number of strokes, etc.) compared to their pre-reform shapes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
