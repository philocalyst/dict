      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calvicie</ns0:quote>
          <ns0:quote>calvatrueno</ns0:quote>
          <ns0:quote>calvez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition or state of being (or becoming) bald.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baldric</ns0:orth>
        <ns0:pron>/ˈbɑl-/</ns0:pron>
