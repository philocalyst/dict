        <ns0:pron>/ˈvɔlf.ɡɑŋ/</ns0:pron>
        <ns0:pron>/ˈwʊlf.ɡæŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wolfgang</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A German en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
