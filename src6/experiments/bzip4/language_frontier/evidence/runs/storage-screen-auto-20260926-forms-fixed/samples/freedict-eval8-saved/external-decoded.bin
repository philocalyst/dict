      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bañador</ns0:quote>
          <ns0:quote>bañadora</ns0:quote>
          <ns0:quote>bañista</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathhouse</ns0:orth>
        <ns0:pron>/ˈbæθˌhaʊs/</ns0:pron>
      </ns0:form>
