      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abominable hombre de las nieves</ns0:quote>
          <ns0:quote>abominable homínido níveo</ns0:quote>
