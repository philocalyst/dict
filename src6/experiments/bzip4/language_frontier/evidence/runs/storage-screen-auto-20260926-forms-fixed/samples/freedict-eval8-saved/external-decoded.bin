        <ns0:orth>Dante</ns0:orth>
        <ns0:pron>/ˈdænteɪ/</ns0:pron>
        <ns0:pron>/ˈdænti/</ns0:pron>
        <ns0:pron>/ˈdɑnteɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, presumably in honor of the poet Dante Alighieri.</ns0:def>
        </ns0:sense>
