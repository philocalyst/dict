      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excepción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Without exception; excluding nothing else of the same kind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bar shot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>palanqueta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, historical) A double-headed shot, consisting of a bar, with a ball or half ball at each end; formerly used for destroying the masts or rigging in naval combat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bar-crested antshrike</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batará crestibarrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A passerine bird of species Thamnophilus multistriatus, in the antbird family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bar-tailed godwit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguja colipinta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wader, of species Limosa lapponica, a type of godwit, of the Scolopacidae family</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barb</ns0:orth>
        <ns0:pron>/bɑː(ɹ)b/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lengüeta</ns0:quote>
          <ns0:quote>pincho</ns0:quote>
          <ns0:quote>púa</ns0:quote>
          <ns0:quote>puya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The point that stands backward in an arrow, fishhook, etc., to prevent it from being easily extracted. Hence: Anything which stands out with a sharp point obliquely or crosswise to something else.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pulla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A hurtful or disparaging remark.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ornithology) One of the many side branches of a feather, which collectively constitute the vane.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbarian</ns0:orth>
        <ns0:pron>/bɑɹˈbɛəɹ.i.ən/</ns0:pron>
        <ns0:pron>/bɑː(ɹ)ˈbɛə.ɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bárbaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to people, countries, or customs perceived as uncivilized or inferior.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbarian</ns0:orth>
        <ns0:pron>/bɑɹˈbɛəɹ.i.ən/</ns0:pron>
        <ns0:pron>/bɑː(ɹ)ˈbɛə.ɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bárbaro</ns0:quote>
          <ns0:quote>bárbara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An uncivilized or uncultured person, originally compared to the hellenistic Greco-Roman civilisation; usually associated with senseless violence and self-harm or other such shows of brute force and lack of mental faculty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbaric</ns0:orth>
        <ns0:pron>/bɑː(ɹ)ˈbæɹɪk/</ns0:pron>
        <ns0:pron>/bɑː(ɹ)ˈbɛɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bárbaro</ns0:quote>
          <ns0:quote>barbárico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of or relating to a barbarian; uncivilized, uncultured or uncouth</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbarisation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbarización</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbarism</ns0:orth>
        <ns0:pron>/ˈbɑɹbəˈɹɪzm̩/</ns0:pron>
        <ns0:pron>/ˈbɑː(ɹ)bəɹɪz(ə)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbarismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A barbaric act.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An error in language use within a single word, such as a mispronunciation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbarize</ns0:orth>
        <ns0:pron>/ˈbɑː(ɹ)bəɹaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbarizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to become savage or uncultured.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbecue</ns0:orth>
        <ns0:pron>/ˈbɑɹbə-/</ns0:pron>
        <ns0:pron>/ˈbɑɹbɪˌkju/</ns0:pron>
        <ns0:pron>/ˈbɑːbɪˌkjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbacoa</ns0:quote>
          <ns0:quote>asador</ns0:quote>
          <ns0:quote>parrilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fireplace or pit for grilling food, typically used outdoors and traditionally employing hot charcoal as the heating medium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbacoa</ns0:quote>
          <ns0:quote>parrillada</ns0:quote>
          <ns0:quote>asado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A meal or event highlighted by food cooked in such an apparatus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbecue</ns0:orth>
        <ns0:pron>/ˈbɑɹbə-/</ns0:pron>
        <ns0:pron>/ˈbɑɹbɪˌkju/</ns0:pron>
        <ns0:pron>/ˈbɑːbɪˌkjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asar</ns0:quote>
          <ns0:quote>rostizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, intransitive) To cook food on a barbecue; to smoke food over indirect heat from high-smoke fuels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbecue sauce</ns0:orth>
        <ns0:pron>/- sɔːs/</ns0:pron>
        <ns0:pron>/ˈbɑːbɪkjuː sɔːs/</ns0:pron>
        <ns0:pron>/ˈbɑːɹbəkjuː sɑːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salsa barbacoa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fruity, tangy, usually brown sauce, typically consisting of a vinegar or tomato base with spices and sweeteners, used as a basting sauce, marinade, or condiment, especially for barbecued meat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbed wire</ns0:orth>
        <ns0:pron>/bɑɹbd waɪəɹ/</ns0:pron>
        <ns0:pron>[ˈbɑɹbd ˈwa.jɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alambre de púas</ns0:quote>
          <ns0:quote>alambre de espino</ns0:quote>
          <ns0:quote>alambre de espinas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Twisted strands of steel wire, often coated with zinc, having barbs evenly spaced along them; used to construct agricultural and military fences.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbel</ns0:orth>
        <ns0:pron>/ˈbɑːbəl/</ns0:pron>
        <ns0:pron>/ˈbɑːɹbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Whisker-like sensory organs, located around the mouth of certain fish, including catfish, carp, goatfish, sturgeon, and some types of shark.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbell</ns0:orth>
        <ns0:pron>/ˈbɑɹˌbɛl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra</ns0:quote>
          <ns0:quote>haltera</ns0:quote>
          <ns0:quote>barra con pesas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wide steel bar with premeasured weights affixed to either end, with the central span open for the hands of the weightlifter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barber</ns0:orth>
        <ns0:pron>/ˈbɑɹ.bɚ/</ns0:pron>
        <ns0:pron>/ˈbɑː.bə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbero</ns0:quote>
          <ns0:quote>peluquero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person whose profession is cutting the hair and beards of usually male customers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barberry</ns0:orth>
        <ns0:pron>/ˈbɑɹbɛɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agracejo</ns0:quote>
          <ns0:quote>alarguez</ns0:quote>
          <ns0:quote>calafate</ns0:quote>
          <ns0:quote>michay</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbershop</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbería</ns0:quote>
          <ns0:quote>peluquería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) The place of business of a barber; a store where a person (usually a male) can go to get a haircut.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barbet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
