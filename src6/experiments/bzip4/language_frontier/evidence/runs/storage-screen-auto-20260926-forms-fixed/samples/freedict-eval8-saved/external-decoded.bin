        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>torrejas</ns0:quote>
          <ns0:quote>torrijas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(culinary) Food prepared by dipping bread into egg batter and frying.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French window</ns0:orth>
      </ns0:form>
