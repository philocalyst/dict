    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Priabonian</ns0:orth>
        <ns0:pron>/ˌpɹaɪ.əˈboʊ.ni.ən/</ns0:pron>
