        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any ester or salt of acetic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetic</ns0:orth>
        <ns0:pron>/əˈsiːtɪk/</ns0:pron>
        <ns0:pron>/əˈsɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Of, pertaining to, or producing vinegar.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(organic chemistry) Of or pertaining to acetic acid or its derivatives.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido acético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carboxylic acid, fatty acid) A clear colourless organic acid, CH3COOH, formed by the bacterial oxidation of ethanol through acetic fermentation; it is used as a solvent and has very many industrial applications; it is the major acidic component of vinegar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
