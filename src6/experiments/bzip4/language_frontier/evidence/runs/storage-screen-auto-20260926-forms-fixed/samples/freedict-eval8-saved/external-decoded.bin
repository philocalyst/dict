          <ns0:quote>serbio</ns0:quote>
          <ns0:quote>servio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Serbia and Serbians.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or pertaining to Serbian language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
