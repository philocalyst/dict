          <ns0:quote>nadería</ns0:quote>
          <ns0:quote>nimiedad</ns0:quote>
          <ns0:quote>pequeñez</ns0:quote>
          <ns0:quote>minucia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
