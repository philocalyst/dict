          <ns0:quote>tasa metabólica basal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physiology) The amount of energy expended while at rest in a neutrally temperate environment, in the post-absorptive state.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basalt</ns0:orth>
        <ns0:pron>/bəˈsɑlt/</ns0:pron>
        <ns0:pron>/bəˈsɔlt/</ns0:pron>
        <ns0:pron>/ˈbeɪˌsɑlt/</ns0:pron>
        <ns0:pron>/ˈbeɪˌsɔlt/</ns0:pron>
        <ns0:pron>/ˈbæs.ɑlt/</ns0:pron>
        <ns0:pron>/ˈbæs.ɒlt/</ns0:pron>
        <ns0:pron>/ˈbæs.ɔlt/</ns0:pron>
        <ns0:pron>/ˈbæs.ɔːlt/</ns0:pron>
        <ns0:pron>/ˈbæs.əlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basalto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A hard mafic igneous rock of varied mineral content; volcanic in origin, which makes up much of the Earth's oceanic crust.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
