        <ns0:sense>
          <ns0:def>(chiefly, poetic, Greek mythology) Of or relating to the river Lethe, one of the four rivers of Hades. Those who drank from it experienced complete forgetfulness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
