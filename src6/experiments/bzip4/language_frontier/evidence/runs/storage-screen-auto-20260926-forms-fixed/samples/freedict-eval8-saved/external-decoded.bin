        <ns0:orth>amiss</ns0:orth>
        <ns0:pron>/əˈmɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estar mal</ns0:quote>
          <ns0:quote>fuera de lugar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, predicative) Wrong; faulty; out of order; improper or otherwise incorrect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
