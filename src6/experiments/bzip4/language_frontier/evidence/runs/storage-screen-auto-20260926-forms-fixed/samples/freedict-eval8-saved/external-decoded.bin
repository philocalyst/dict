        </ns0:cit>
        <ns0:sense>
          <ns0:def>A natural region between the French departments of Loiret, Loir-et-Cher and Cher, in Centre-Val de Loire, France.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Solomon</ns0:orth>
        <ns0:pron>/ˈsɑləmən/</ns0:pron>
        <ns0:pron>/ˈsɒləmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Salomón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Biblical character) In the Old Testament and Qur'an, a king of Israel famous for his wisdom; father of King Rehoboam and the son of King David.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
