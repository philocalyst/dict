      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Talía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The Muse of comedy and idyllic poetry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Greek god) One of the three Graces/Charites.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thames</ns0:orth>
        <ns0:pron>/tɛmz/</ns0:pron>
        <ns0:pron>/θeɪmz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Támesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(with the) A river in the U.S. State of Connecticut flowing 24 km (15 mi.) past New London to Long Island Sound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thanatos</ns0:orth>
        <ns0:pron>/ˈθænəˌtɑs/</ns0:pron>
