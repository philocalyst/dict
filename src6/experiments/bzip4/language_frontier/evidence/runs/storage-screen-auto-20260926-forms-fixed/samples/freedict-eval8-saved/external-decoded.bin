        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Extremadura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An autonomous community in western Spain. Capital: Mérida.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Extremaduran</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extremeño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from or relating to Extremadura, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Extremaduran</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extremeño</ns0:quote>
          <ns0:quote>extremeña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or inhabitant of Extremadura, Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Extremaduran</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extremeño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language of Extremadura.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ezekiel</ns0:orth>
        <ns0:pron>/ɪˈziːkiəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ezequiel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A book of the Old Testament of the Bible.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biblical character) A prophet mentioned in the Bible and in the Quran.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name of biblical origin. First used by Puritans in the 17th century; rare today.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ezra</ns0:orth>
        <ns0:pron>/ˈɛzɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Esdras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(book of the bible) The fifteenth book of the Old Testament and a book of the Hebrew Tanakh.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biblical character) A Jewish high priest from the fifth century BC.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name of biblical origin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>F major</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fa mayor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The major key with the notes F, G, A, B♭, C, D, E, the key signature of which has one flat.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) The major chord with a root of F.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>F-flat major</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fa bemol mayor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The theoretical major key with F-flat as its tonic and the notes F♭, G♭, A♭, B♭♭, C♭, D♭, and E♭.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>F-sharp major</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fa sostenido mayor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The major key with the notes F♯, G♯, A♯, B, C♯, D♯, and E♯, the key signature of which has six sharps.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FAQ</ns0:orth>
        <ns0:pron>/fæk/</ns0:pron>
        <ns0:pron>/ˈfʌkjuː/</ns0:pron>
        <ns0:pron>/ˌɛf.eɪˈkjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>FAQ</ns0:quote>
          <ns0:quote>PUF</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(internet) A list of questions said to be frequently asked, and their answers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FARC</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>FARC</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Revolutionary Armed Forces of Colombia, a Marxist-Leninist guerrilla group involved in the continuing Colombian conflict starting in 1964.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FBI</ns0:orth>
        <ns0:pron>/ˈɛf.biː.aɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>FBI</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, police) Initialism of Federal Bureau of Investigation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FC</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>CF</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of football club (usually for association football (soccer)).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FCB</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>FCB</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(soccer) Initialism of FC Barcelona, a famous Spanish sports club from Barcelona, best known for its football (soccer) section; from Catalan FCB (“Futbol Club Barcelona”).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FDI</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>IED</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of foreign direct investment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FML</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puta vida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet slang, text messaging, vulgar) Initialism of fuck my life (expressing despairing annoyance).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FRG</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>RFA</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of Federal Republic of Germany.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>FYROM</ns0:orth>
        <ns0:pron>/fɪɹəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ARYM</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Acronym of former Yugoslav Republic of Macedonia, former long form of North Macedonia: a country in Southeast Europe on the Balkan Peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fabian</ns0:orth>
        <ns0:pron>/ˈfe.bi.ən/</ns0:pron>
        <ns0:pron>/ˈfeɪ.bi.ən/</ns0:pron>
        <ns0:pron>/ˈfeɪ.biː.ən/</ns0:pron>
        <ns0:pron>/ˈfeː.biː.an/</ns0:pron>
        <ns0:pron>/ˈfæɪ.biː.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fabián</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fabius</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fabio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, of historical use in English.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Facebook</ns0:orth>
        <ns0:pron>/ˈfeɪs.bʊk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Facebook</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(trademark) A social-networking website where users can find acquaintances or friends, exchange messages, and post updates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Facebook</ns0:orth>
        <ns0:pron>/ˈfeɪs.bʊk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>facebookear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To use the social-networking site Facebook.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fahrenheit</ns0:orth>
        <ns0:pron>/ˈfæɹənhaɪt/</ns0:pron>
        <ns0:pron>/ˈfɑːɹənhaɪt/</ns0:pron>
        <ns0:pron>/ˈfɛɹənhaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fahrenheit</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Describing a temperature scale originally defined as having 0°F as the lowest temperature obtainable with a mixture of ice and salt, and 96°F as the temperature of the human body, and now defined with 32°F equal to 0°C, and each degree Fahrenheit equal to 5/9 of a degree Celsius or 5/9 kelvin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Falkland Islander</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malvinense</ns0:quote>
          <ns0:quote>malvinés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from the Falkland Islands or of descent of the Falkland Islands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Falkland Islands</ns0:orth>
        <ns0:pron>/ˈfɒlklənd ˌaɪləndz/</ns0:pron>
        <ns0:pron>/ˈfɔːklənd ˌaɪləndz/</ns0:pron>
        <ns0:pron>/ˈfɔːlklənd ˌaɪləndz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islas Malvinas</ns0:quote>
          <ns0:quote>Islas Malvinas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An archipelago and overseas territory of the United Kingdom, located in the South Atlantic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Falkland Islands wolf</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guará</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A warrah, an extinct canid of species †Dusicyon australis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Falklands War</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Guerra de las Malvinas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A conflict between Argentina and the United Kingdom over sovereignty of the Falkland Islands and South Georgia and the South Sandwich Islands (South Georgia and South Sandwich Islands), waged between March and June of 1982.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fallopian tube</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trompa de Falopio</ns0:quote>
          <ns0:quote>oviducto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Either of the two ducts through which ova pass from the ovaries to the uterus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Famennian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fameniense</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Far East</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Extremo Oriente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) A geographical region of Asia, consisting of East Asia (Korea, Japan, China, the Russian Far East, etc.) and Southeast Asia, taken as a whole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faraday cage</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jaula de Faraday</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any conductive surrounding, idealized or practical, used to interrupt the transmission of electromagnetic energy or electrostatic discharge across it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faroe Islands</ns0:orth>
        <ns0:pron>/ˈfɛəɹəʊ ˌaɪləndz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Islas Feroe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An archipelago and self-governing autonomous territory of Denmark, in the North Atlantic Ocean between Scotland and Iceland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faroese</ns0:orth>
        <ns0:pron>/fæɹoʊˈiz/</ns0:pron>
        <ns0:pron>/ˌfɛ(ə)ɹoʊˈiz/</ns0:pron>
        <ns0:pron>/ˌfɛəɹəʊˈiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>faroés</ns0:quote>
          <ns0:quote>feroés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the Faroe Islands, Faroese people or language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faroese</ns0:orth>
        <ns0:pron>/fæɹoʊˈiz/</ns0:pron>
        <ns0:pron>/ˌfɛ(ə)ɹoʊˈiz/</ns0:pron>
        <ns0:pron>/ˌfɛəɹəʊˈiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>feroés</ns0:quote>
          <ns0:quote>feroesa</ns0:quote>
          <ns0:quote>faroesa</ns0:quote>
          <ns0:quote>faroés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, in the plural) A person from the Faroe Islands; a Faroe Islander.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faroese</ns0:orth>
        <ns0:pron>/fæɹoʊˈiz/</ns0:pron>
        <ns0:pron>/ˌfɛ(ə)ɹoʊˈiz/</ns0:pron>
        <ns0:pron>/ˌfɛəɹəʊˈiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>feroés</ns0:quote>
          <ns0:quote>faroés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language of the Faroe Islands, closely related to Icelandic, and more distantly to Danish, Norwegian, and Swedish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faroish</ns0:orth>
        <ns0:pron>/ˈfɛəɹəʊɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>faroés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the Faroe Islands, Faroish people or the Faroish language; Faroese.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fata Morgana</ns0:orth>
        <ns0:pron>/ˌfɑtə mɔɹˈɡɑnə/</ns0:pron>
        <ns0:pron>/ˌfɑːtə mɔːˈɡɑːnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fata Morgana</ns0:quote>
          <ns0:quote>fatamorgana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of mirage seen just above the horizon, caused by a temperature inversion in the atmosphere, in which multiple upright and inverted images of a distant object appear to be stacked on top of each other in a highly distorted fashion; especially one seen at sea, and particularly in the Strait of Messina.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fatah</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fatah</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A major Palestinian political party and the largest faction of the Palestine Liberation Organization (PLO).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Father</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>padre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) One of the chief ecclesiastical authorities of the first centuries after Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Father</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Padre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Wicca) One of the triune gods of the Horned God in Wicca, representing a man, younger than the elderly Sage and older than the boyish Master.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Father Time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Padre Tiempo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A personification of time as an old man, usually carrying an hourglass.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Father's Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día del Padre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A holiday in celebration of fatherhood, or to honor fathers, celebrated on the third Sunday of June in most of the world's countries. See Wikipedia:Father's Day:Dates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fatima</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fátima</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Islam) A daughter of the prophet Muhammad, the wife of Ali.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faustian</ns0:orth>
        <ns0:pron>/ˈfaʊstiən/</ns0:pron>
        <ns0:pron>/ˈfaʊstɪən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fáustico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Faust, especially in the sense of being willing to abandon one's principles or values in order to pursue knowledge, wealth or other benefits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Faustian bargain</ns0:orth>
        <ns0:pron>/-ɡɪn/</ns0:pron>
        <ns0:pron>/ˈfaʊstiən ˈbɑːɹɡən/</ns0:pron>
        <ns0:pron>/ˈfaʊstɪən ˈbɑːɡən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pacto fáustico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) An agreement in which a person abandons his or her spiritual values or moral principles in order to obtain knowledge, wealth or other benefits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fayum</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fayún</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Feast of Our Lady of the Rosary</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fiesta de Nuestra Señora del Rosario</ns0:quote>
          <ns0:quote>fiesta del Virgen del Rosario</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>February</ns0:orth>
        <ns0:pron>/fɪbrəˈwari/</ns0:pron>
        <ns0:pron>/j/</ns0:pron>
        <ns0:pron>/ɹi/</ns0:pron>
        <ns0:pron>/ɹə.ɹi/</ns0:pron>
        <ns0:pron>/ˈfɛb.j(ʊ.)ə.ɹi/</ns0:pron>
        <ns0:pron>/ˈfɛb.juˌɛ(ə)ɹi/</ns0:pron>
        <ns0:pron>/ˈfɛb.ɹi/</ns0:pron>
        <ns0:pron>/ˈfɛb.ɹuˌɛɹi/</ns0:pron>
        <ns0:pron>/ˈfɛb.ɹə.ɹi/</ns0:pron>
        <ns0:pron>/ˈfɛb.ɹʊ.ə.ɹi/</ns0:pron>
        <ns0:pron>/ˈfɛbrə(wə)ri/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>febrero</ns0:quote>
          <ns0:quote>hebrero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The short month following January and preceding March in the Roman, Julian, and Gregorian calendars, used in all three calendars for intercalation or addition of leap days.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>February fill-dike</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>febrero, cebadero</ns0:quote>
          <ns0:quote>lluvioso febrero, año cebadero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rural appellation for the month of February, when rain or melting snow fills dykes with water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Federal Democratic Republic of Nepal</ns0:orth>
      </ns0:form>
