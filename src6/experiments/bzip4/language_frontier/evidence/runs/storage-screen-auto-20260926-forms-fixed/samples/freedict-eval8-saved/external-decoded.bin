        <ns0:pron>/mɪˈzɝ.ə/</ns0:pron>
        <ns0:pron>/mɪˈzʊəɹi/</ns0:pron>
        <ns0:pron>/mɪˈzʊɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Misuri</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state in the Midwestern region of the United States. Capital: Jefferson City. Largest city: Kansas City.</ns0:def>
