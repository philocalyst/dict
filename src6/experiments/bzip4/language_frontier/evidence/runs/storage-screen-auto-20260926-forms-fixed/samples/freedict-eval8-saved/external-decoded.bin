      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>madianita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of an ancient northern Arabian people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Midwest</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>medio oeste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The area of the contiguous United States contained in the central third of the country, especially the states of Illinois, Indiana, Iowa, Michigan, Minnesota, Ohio, Wisconsin, North Dakota, South Dakota, Nebraska, and Kansas, sometimes inclusive of Missouri and Kentucky.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
