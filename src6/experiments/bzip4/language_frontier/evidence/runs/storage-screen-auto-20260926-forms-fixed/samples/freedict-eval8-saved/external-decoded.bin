        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Enkidu</ns0:orth>
        <ns0:pron>/ˈɛn.kɪ.du/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Enkidu</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Companion of Gilgamesh in the poem Epic of Gilgamesh from ancient Mesopotamia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Enlightenment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ilustración</ns0:quote>
          <ns0:quote>Iluminismo</ns0:quote>
          <ns0:quote>el Siglo de las Luces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) A 17th- and 18th-century European intellectual movement emphasizing rationalism. The period during which it flourished is called the Age of Enlightenment or Age of Reason.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
