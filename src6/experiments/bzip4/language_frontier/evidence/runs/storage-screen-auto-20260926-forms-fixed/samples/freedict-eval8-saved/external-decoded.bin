      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anything</ns0:orth>
        <ns0:pron>/ˈæn.i.θɪŋ/</ns0:pron>
        <ns0:pron>/ˈɛn.i.θɪŋ/</ns0:pron>
        <ns0:pron>/ˈɛn.ɪ.θɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cualquier cosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any object, act, state, event, or fact whatsoever; a thing of any kind; something or other.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
