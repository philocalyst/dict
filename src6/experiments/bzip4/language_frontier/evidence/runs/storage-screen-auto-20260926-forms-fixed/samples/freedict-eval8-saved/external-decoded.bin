        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ciclamor</ns0:quote>
          <ns0:quote>árbol de Judas</ns0:quote>
          <ns0:quote>árbol del amor</ns0:quote>
          <ns0:quote>arjorán</ns0:quote>
          <ns0:quote>algarrobo loco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small deciduous tree, Cercis siliquastrum, noted for its prolific display of deep-pink flowers in spring.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jude</ns0:orth>
