        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Guria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A region of Georgia, in the western part of the country, bordered by the eastern end of the Black Sea with Ozurgeti as its regional capital.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
