        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Domingo de Pasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fifth Sunday in Lent, the second Sunday before Easter, the first day in Passiontide.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Passionist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasionista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a Roman Catholic religious institute with a special emphasis on the Passion of Jesus Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Passover</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pésaj</ns0:quote>
          <ns0:quote>pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The one-day Biblical feast or festival (not a holy day) that begins at twilight at the beginning of the fourteenth day of the first month (Abib 14 / Nisan 14), during which the first-born sons of the Israelites were passed over while those of the Egyptians were killed; this feast day is then immediately followed by the seven-day Feast of Unleavened Bread (Nisan 15 to 21; the first and seventh days are holy days or annual or yearly Sabbaths).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
