        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basílica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A Christian church building having a nave with a semicircular apse, side aisles, a narthex and a clerestory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basilisk</ns0:orth>
