    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'm a Christian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy cristiana</ns0:quote>
          <ns0:quote>soy cristiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
