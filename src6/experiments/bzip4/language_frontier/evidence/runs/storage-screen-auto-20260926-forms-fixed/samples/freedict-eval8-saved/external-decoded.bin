      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estados Pontificios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A country in southern Europe that existed until 1870, comprising the territories of Italy (and some enclaves in France) over which the pope was the ruler in a civil as well as a spiritual sense.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
