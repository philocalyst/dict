        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atípico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not conforming to the normal type.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>au contraire</ns0:orth>
        <ns0:pron>/oʊ ˌkɑnˈtɹɛ(ə)ɹ/</ns0:pron>
        <ns0:pron>/oʊ ˌkɔnˈtɹɛ(ə)ɹ/</ns0:pron>
        <ns0:pron>/ɔ-/</ns0:pron>
        <ns0:pron>/əʊ ˈkɒntɹɛː(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al contrario</ns0:quote>
          <ns0:quote>en contra</ns0:quote>
          <ns0:quote>en contrario</ns0:quote>
          <ns0:quote>por el contrario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, humorous, emphatic) On the contrary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>au pair</ns0:orth>
        <ns0:pron>/oʊ ˈpɛ(ə)ɹ/</ns0:pron>
        <ns0:pron>/əʊ ˈpɛə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de au pair</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person (especially a young woman) working in such a way; now specifically, a foreign worker who helps a host family with childcare, housework, or both while staying as a guest with a host family, and generally receives a small allowance (or pocket money). [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
