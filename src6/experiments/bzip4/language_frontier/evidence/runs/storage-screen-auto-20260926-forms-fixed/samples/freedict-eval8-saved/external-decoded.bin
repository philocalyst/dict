      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vendo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a Slavic people from the borders of Germany and Poland; a Sorb; a Kashub.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wernicke's area</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>área de Wernicke</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The posterior section of the superior temporal gyrus in the dominant cerebral hemisphere, one of two parts of the cerebral cortex linked with speech (the other being Broca's area).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
