        <ns0:pron>[ˈɔɾə-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autobús</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(road transport, dated) A motorbus, as opposed to earlier horse-drawn buses.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension, cycle racing) A large group of cyclists who have fallen behind the peloton in a race.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocastration</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocastración</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocatalysis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocatálisis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) catalysis of a reaction by one of its products</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocephalous</ns0:orth>
        <ns0:pron>/ɔːtə(ʊ)ˈsɛfələs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocéfalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity, of a church) Fully independent of the authority of any other church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocephaly</ns0:orth>
        <ns0:pron>/ˌɔːtəˈsɛfəli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocefalia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The condition where a church's leaders have severed ties to a larger body and thus no longer report to a higher authority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autochthon</ns0:orth>
        <ns0:pron>/ɑˈtɑkˌθɑn/</ns0:pron>
        <ns0:pron>/ɑˈtɑkθ(ə)n/</ns0:pron>
        <ns0:pron>/ɔˈtɑkˌθɑn/</ns0:pron>
        <ns0:pron>/ɔˈtɑkθ(ə)n/</ns0:pron>
        <ns0:pron>/ɔːˈtɒkθ(ə)n/</ns0:pron>
        <ns0:pron>/ɔːˈtɒkθɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autóctono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(formal) The earliest inhabitant of an area; an indigenous person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autochthonous</ns0:orth>
        <ns0:pron>/ɑˈtɑkθənəs/</ns0:pron>
        <ns0:pron>/ɔˈtɑkθənəs/</ns0:pron>
        <ns0:pron>/ɔːˈtɒkθənəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autóctono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Native to the place where found; indigenous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoclave</ns0:orth>
        <ns0:pron>/ˈɑt.oʊˌkleɪv/</ns0:pron>
        <ns0:pron>/ˈɑt.əˌkleɪv/</ns0:pron>
        <ns0:pron>/ˈɔt.oʊˌkleɪv/</ns0:pron>
        <ns0:pron>/ˈɔt.əˌkleɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoclave</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strong, pressurized, heated vessel, as for laboratory experiments, sterilization, cooking or mineral processing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocomplete</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocompletado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A software feature that predicts the rest of a word a user is typing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocomplete</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocompletar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) To complete automatically.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoconfirm</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoconfirmar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To automatically confirm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoconfirmed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoconfirmado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Automatically confirmed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocoup</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autogolpe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A coup d'état in which a nation's leader, despite having come to power through legal means, dissolves or renders powerless the national legislature and unlawfully assumes extraordinary powers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocracy</ns0:orth>
        <ns0:pron>/ɔːˈtɒkɹəsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocracia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A form of government in which unlimited power is held by a single individual.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocrat</ns0:orth>
        <ns0:pron>/ˈɔːtəkɹæt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autócrata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An absolute ruler with infinite power.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autocratic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autocrático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to autocracy or to an autocrat; absolute; holding independent and arbitrary powers of government.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(pejorative) Of or pertaining to the manner of an autocrat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autodidact</ns0:orth>
        <ns0:pron>/ˌɔːtoʊˈdaɪdækt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autodidacta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A self-taught person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoerotism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoerotismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sexual activity involving oneself, including masturbation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autofiction</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoficción</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autofocus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autofoco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(electronics, photography) A feature of some cameras and other optical systems that allows a correct focus on the subject to be obtained automatically</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autogenous</ns0:orth>
        <ns0:pron>/ɔːˈtɒd͡ʒɪnəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Produced independently of an external cause or influence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autognosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autognosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Self-knowledge; the understanding of one's character and peculiarities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autograph</ns0:orth>
        <ns0:pron>/ˈɑtəɡɹæf/</ns0:pron>
        <ns0:pron>/ˈɔtəɡɹæf/</ns0:pron>
        <ns0:pron>/ˈɔːtəɡɹɑːf/</ns0:pron>
        <ns0:pron>[ˈɑɾəɡɹæf]</ns0:pron>
        <ns0:pron>[ˈɔɾəɡɹæf]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autógrafo</ns0:quote>
          <ns0:quote>firma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person’s own handwriting, especially the signature of a famous or admired person.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension, colloquial) A person's signature used as a mark of formal approval.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autograph</ns0:orth>
        <ns0:pron>/ˈɑtəɡɹæf/</ns0:pron>
        <ns0:pron>/ˈɔtəɡɹæf/</ns0:pron>
        <ns0:pron>/ˈɔːtəɡɹɑːf/</ns0:pron>
        <ns0:pron>[ˈɑɾəɡɹæf]</ns0:pron>
        <ns0:pron>[ˈɔɾəɡɹæf]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autografiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To sign, or write one’s name or signature on a book, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autografiar</ns0:quote>
          <ns0:quote>manuscribir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To write something in one's own handwriting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autogynephilia</ns0:orth>
        <ns0:pron>/ˌɑ.toʊˌɡaɪ.nəˈfɪ.li.ə/</ns0:pron>
        <ns0:pron>/ˌɔ.toʊˌɡaɪ.nəˈfɪ.li.ə/</ns0:pron>
        <ns0:pron>/ˌɔː.təʊˌɡaɪ.nəˈfɪ.li.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoginofilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In Blanchard's transsexualism typology, the supposed paraphilic tendency of a male person to be sexually aroused by the thought of being a female, sometimes framed as a form of gender identity disorder or transvestic fetishism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoignition temperature</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>temperatura de autoignición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The lowest temperature at which combustion will occur spontaneously under specific conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoimmune</ns0:orth>
        <ns0:pron>/ˌɔːtəʊɪˈmjuːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoinmune</ns0:quote>
          <ns0:quote>autoinmunitario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, immunology) Of or pertaining to autoimmunity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoimmunity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoinmunidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, immunology) The condition where one's immune system attacks one's own tissues, i.e., an autoimmune disorder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoinjector</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoinyector</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A medical device designed to deliver a single dose of a particular, typically life-saving, drug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autological</ns0:orth>
        <ns0:pron>/ˌɑːtoʊˈlɑːd͡ʒɪkəl/</ns0:pron>
        <ns0:pron>/ˌɑːtəˈlɑːd͡ʒɪkəl/</ns0:pron>
        <ns0:pron>/ˌɔː.təʊˈlɒ.dʒɪ.kəl/</ns0:pron>
        <ns0:pron>/ˌɔː.təˈlɒ.dʒɪ.kəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar, of a word, phrase, or especially an adjective) Possessing the property it describes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autolysis</ns0:orth>
        <ns0:pron>/əˈtɑ.ləˌsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autolisis</ns0:quote>
          <ns0:quote>autólisis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, cytology) The destruction of an organism's cells by enzymes produced by the organism itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automagical</ns0:orth>
        <ns0:pron>/ˈɑtoʊˈmæd͡ʒɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automágico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, technology, informal) Automatic, but with an apparent element of magic. Commonly referring to complex technical processes hidden from the view of users or operators, resulting in technology that "just works".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automagically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>automágicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an automagical manner; happening seemingly without effort.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>automate</ns0:orth>
