      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awfully</ns0:orth>
        <ns0:pron>/ˈɑfəli/</ns0:pron>
        <ns0:pron>/ˈɔfəli/</ns0:pron>
        <ns0:pron>/ˈɔːfli/</ns0:pron>
        <ns0:pron>/ˈɔːfəli/</ns0:pron>
        <ns0:pron>/ˈɔːfʊli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) In a manner inspiring awe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awhile</ns0:orth>
        <ns0:pron>/əˈwaɪl/</ns0:pron>
        <ns0:pron>/əˈʍaɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algún tiempo</ns0:quote>
          <ns0:quote>un rato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>For some time; for a short time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awkward</ns0:orth>
        <ns0:pron>/ˈoːkwəd/</ns0:pron>
        <ns0:pron>/ˈɑkwɚd/</ns0:pron>
        <ns0:pron>/ˈɔkwɚd/</ns0:pron>
        <ns0:pron>/ˈɔːkwəd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desgarbado</ns0:quote>
          <ns0:quote>desgarbilado</ns0:quote>
          <ns0:quote>premioso</ns0:quote>
          <ns0:quote>tímido</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>torpe</ns0:quote>
          <ns0:quote>desmañado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lacking dexterity in the use of the hands, or of instruments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embarazoso</ns0:quote>
          <ns0:quote>delicado</ns0:quote>
          <ns0:quote>dificultoso</ns0:quote>
          <ns0:quote>incómodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not easily managed or effected; embarrassing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atravesado</ns0:quote>
          <ns0:quote>difícil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Perverse; adverse; difficult to handle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awkwardly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>torpemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an awkward manner; with discomfort or lack of coordination.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awkwardness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>torpeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being awkward; clumsiness; unskillfulness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awl</ns0:orth>
        <ns0:pron>/ɑl/</ns0:pron>
        <ns0:pron>/ɔl/</ns0:pron>
        <ns0:pron>/ɔːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lezna</ns0:quote>
          <ns0:quote>lesna</ns0:quote>
          <ns0:quote>punzón</ns0:quote>
          <ns0:quote>alesna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pointed instrument for piercing small holes, as in leather or wood; used by shoemakers, saddlers, cabinetmakers, etc. The blade is differently shaped and pointed for different uses, as in the brad awl, saddler's awl, shoemaker's awl, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awn</ns0:orth>
        <ns0:pron>/ɔːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The bristle or beard of barley, oats, grasses, etc., or any similar bristlelike appendage; arista.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awning</ns0:orth>
        <ns0:pron>/ˈɑnɪŋ/</ns0:pron>
        <ns0:pron>/ˈɔnɪŋ/</ns0:pron>
        <ns0:pron>/ˈɔːnɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>toldo</ns0:quote>
          <ns0:quote>cobertizo</ns0:quote>
          <ns0:quote>marquesina</ns0:quote>
          <ns0:quote>marquesa</ns0:quote>
          <ns0:quote>tejaroz</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awry</ns0:orth>
        <ns0:pron>/əˈɹaɪ/</ns0:pron>
        <ns0:pron>/əˈɹɑɪ/</ns0:pron>
        <ns0:pron>/ˈɔː.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>torcido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Turned or twisted toward one side; crooked, distorted, out of place; wry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative) Wrong or distorted; perverse, amiss, off course</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awry</ns0:orth>
        <ns0:pron>/əˈɹaɪ/</ns0:pron>
        <ns0:pron>/əˈɹɑɪ/</ns0:pron>
        <ns0:pron>/ˈɔː.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oblicuamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Obliquely, crookedly; askew.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inadecuadamente</ns0:quote>
          <ns0:quote>mal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Perversely, improperly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axe</ns0:orth>
        <ns0:pron>/æks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>facha</ns0:quote>
          <ns0:quote>machado</ns0:quote>
          <ns0:quote>segur</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient weapon consisting of a head that has one or two blades and a long handle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axial</ns0:orth>
        <ns0:pron>/ˈæk.si.əl/</ns0:pron>
        <ns0:pron>/ˈæk.sɪ.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axial</ns0:quote>
          <ns0:quote>axil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Belonging to the axis of the body, or to the axis of any appendage or organ</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axial vector</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vector axial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, physics) a pseudovector</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axil</ns0:orth>
        <ns0:pron>/ˈæk.səl/</ns0:pron>
        <ns0:pron>/ˈæk.sɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The angle or point of divergence between the upper side of a branch, leaf, or petiole, and the stem or branch from which it springs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axillary</ns0:orth>
        <ns0:pron>/ækˈsɪləɹi/</ns0:pron>
        <ns0:pron>/ˈæksɪlɛɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the axilla or armpit.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(botany) Situated in, or rising from, an axil; relating to an axil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axinite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axinita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A borosilicate of aluminum, iron, and lime, commonly found in glassy, brown crystals with acute edges.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axiological</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axiológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to value theory, the philosophical field of axiology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axiology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, philosophy) The study of value(s), as regards origin, nature, functions, types, and interrelations; value theory.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The particular value-theory of a philosopher, school of thought, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axiom</ns0:orth>
        <ns0:pron>/ˈak.sɪ.əm/</ns0:pron>
        <ns0:pron>/ˈæk.si.əm/</ns0:pron>
        <ns0:pron>/ˈæk.ʃəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axioma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy) A seemingly self-evident or necessary truth which is based on assumption; a principle or proposition which cannot actually be proved or disproved.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(logic, mathematics, proof theory) A fundamental assumption that serves as a basis for deduction of theorems; a postulate (sometimes distinguished from postulates as being universally applicable, whereas postulates are particular to a certain science or context).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An established principle in some artistic practice or science that is universally received.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axiomatic</ns0:orth>
        <ns0:pron>/ˌæk.si.əˈmæt.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axiomático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Self-evident or unquestionable. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) Relating to or containing axioms. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axiomatically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axiomáticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>By the use of axioms; in the form of an axiom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A hypothetical subatomic particle postulated to resolve certain symmetry problems concerning the strong nuclear force.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axis</ns0:orth>
        <ns0:pron>/ˈæksəs/</ns0:pron>
        <ns0:pron>/ˈæksɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) An imaginary line around which an object spins (an axis of rotation) or is symmetrically arranged (an axis of symmetry).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) A fixed one-dimensional figure, such as a line or arc, with an origin and orientation and such that its points are in one-to-one correspondence with a set of numbers; an axis forms part of the basis of a space or is used to position and locate data in a graph (a coordinate axis)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>axis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(skeleton) The second cervical vertebra of the spine</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axis of evil</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eje del mal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of states accused by George W. Bush of sponsoring terrorism and seeking weapons of mass destruction, originally defined as Iran, Iraq, and North Korea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axis of symmetry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eje de simetría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) Any of one or more lines about which a geometric figure is symmetric</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>axle</ns0:orth>
        <ns0:pron>/ˈæksəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The pin or spindle on which a wheel revolves, or which revolves with a wheel.</ns0:def>
        </ns0:sense>
        <ns0:sense>
