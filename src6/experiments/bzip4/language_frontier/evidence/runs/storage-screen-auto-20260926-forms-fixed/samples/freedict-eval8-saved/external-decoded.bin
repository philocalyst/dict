      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Urmía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A salt lake northwestern Iran, near Turkey.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A city in Iran, the seat of Urmia County's Central District and the capital of West Azerbaijan Province, on the shore of the lake of the same name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ursa Major</ns0:orth>
        <ns0:pron>/ˌɝsə ˈmeɪdʒɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Osa Mayor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A large circumpolar constellation of the northern sky, said to resemble a bear. It includes the familiar asterism the Big Dipper and the stars Mizar, Dubhe, and Alkaid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ursa Minor</ns0:orth>
        <ns0:pron>/ˌɝsə ˈmaɪnɚ/</ns0:pron>
      </ns0:form>
