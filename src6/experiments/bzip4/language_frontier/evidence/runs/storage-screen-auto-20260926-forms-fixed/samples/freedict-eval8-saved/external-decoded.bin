      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acantita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A mineral form of silver sulfide, Ag2S, that is a major ore of silver, that forms slender prisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acanthocephalan</ns0:orth>
        <ns0:pron>/əˌkæn.θoʊˈsɛf.ə.lən/</ns0:pron>
