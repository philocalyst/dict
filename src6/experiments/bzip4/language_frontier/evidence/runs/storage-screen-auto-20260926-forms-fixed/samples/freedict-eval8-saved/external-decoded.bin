        <ns0:sense>
          <ns0:def>A city in central North Macedonia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>HD 75898 b, an exoplanet approximately 2.71 times the mass of Jupiter in the Stribor system, ~255 ly from Earth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
