        <ns0:orth>bass</ns0:orth>
        <ns0:pron>/beɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A low spectrum of sound tones.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A section of a musical group that produces low-pitched sound, lower than the baritone and tenor.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>One who sings in the bass range.</ns0:def>
        </ns0:sense>
        <ns0:sense>
