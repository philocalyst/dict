      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>leprechaunismo</ns0:quote>
          <ns0:quote>síndrome de Donohue</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetic disorder) A rare, severe genetic disorder resulting in elfin facial features and an impaired insulin receptor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Doppler effect</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>efecto Doppler</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The apparent change in frequency or wavelength of a wave that is perceived by an observer moving relative to the source of the waves.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
