      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aromaterapia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(alternative medicine) The use of selected fragrances in lotions and inhalants in an effort to affect mood and promote health.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
