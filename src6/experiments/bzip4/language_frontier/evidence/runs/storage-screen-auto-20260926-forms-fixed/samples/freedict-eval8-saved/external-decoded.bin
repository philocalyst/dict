      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Windhoek</ns0:quote>
          <ns0:quote>Vinjuc</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the capital city of Namibia.</ns0:def>
        </ns0:sense>
