        <ns0:pron>/ˈɹæɡ.nəˌɹɒk/</ns0:pron>
        <ns0:pron>/ˈɹæɡ.nəˌɹɔk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ragnarok</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Norse mythology) A series of future events culminating in a battle, fought between the Æsir and einherjar on one side, and the forces of Surtr, Loki, and Loki's children on the other, in which all of creation is burned down and almost all life is extinguished.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
