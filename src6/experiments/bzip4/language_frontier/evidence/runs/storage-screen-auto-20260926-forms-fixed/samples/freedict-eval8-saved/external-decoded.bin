      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altercación</ns0:quote>
          <ns0:quote>altercado</ns0:quote>
          <ns0:quote>disputa</ns0:quote>
          <ns0:quote>alteración</ns0:quote>
          <ns0:quote>disensión</ns0:quote>
          <ns0:quote>rifirrafe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
