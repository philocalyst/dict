        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christ</ns0:orth>
        <ns0:pron>/kɹaɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The anointed one, the savior predicted by the Old Testament.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cristo</ns0:quote>
          <ns0:quote>Jesucristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A title given to Jesus of Nazareth, seen as the fulfiller of the messianic prophecy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
