        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>francesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A French woman; a woman of French ancestry, descent or citizenship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Frenchy</ns0:orth>
        <ns0:pron>/ˈfɹɛnt͡ʃi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>franchute</ns0:quote>
          <ns0:quote>gabacho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, sometimes, derogatory) A native or resident of France, or a francophone, or a person of French lineage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Freudian</ns0:orth>
        <ns0:pron>/ˈfɹɔɪ.di.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>freudiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to or influenced by the Austrian neurologist Sigmund Freud (1856-1939).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Freudian</ns0:orth>
        <ns0:pron>/ˈfɹɔɪ.di.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>freudiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of Freud or his methods.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Freudian slip</ns0:orth>
        <ns0:pron>/ˌfɹɔɪdi.ən ˈslɪp/</ns0:pron>
        <ns0:pron>/ˌfɹɔɪdɪ.ən ˈslɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acto fallido</ns0:quote>
          <ns0:quote>desliz freudiano</ns0:quote>
          <ns0:quote>lapsus revelador</ns0:quote>
          <ns0:quote>parapraxis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) A mistake in speech or action in which a person supposedly shows their true subconscious desires.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Friday</ns0:orth>
        <ns0:pron>/-di/</ns0:pron>
        <ns0:pron>/-ˌdi/</ns0:pron>
        <ns0:pron>/ˈfɹaɪdeɪ/</ns0:pron>
        <ns0:pron>/ˈfɹaɪˌdeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el viernes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada, informal in UK) On Friday.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Friday</ns0:orth>
        <ns0:pron>/-di/</ns0:pron>
        <ns0:pron>/-ˌdi/</ns0:pron>
        <ns0:pron>/ˈfɹaɪdeɪ/</ns0:pron>
        <ns0:pron>/ˈfɹaɪˌdeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>viernes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sixth day of the week in many religious traditions, and the fifth day of the week in systems using the ISO 8601 norm; the Muslim Sabbath; it follows Thursday and precedes Saturday.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Friday the thirteenth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Viernes 13</ns0:quote>
          <ns0:quote>martes trece</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A particular date combination that occurs when the thirteenth day of a month falls on a Friday, and which is considered unlucky in some cultures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Friesland</ns0:orth>
        <ns0:pron>/fɹiːzlænd/</ns0:pron>
        <ns0:pron>/ˈfɹiːzlənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Frisia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province of the Netherlands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Frimaire</ns0:orth>
        <ns0:pron>/fɹiˈmɛəɹ/</ns0:pron>
        <ns0:pron>/fɹɪˈmɛː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
