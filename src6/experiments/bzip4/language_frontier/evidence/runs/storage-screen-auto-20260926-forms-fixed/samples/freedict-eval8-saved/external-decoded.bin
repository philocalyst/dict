      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>presbiteriano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person belonging to a church in the tradition of Presbyterianism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Presbyterianism</ns0:orth>
      </ns0:form>
