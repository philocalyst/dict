        <ns0:orth>Loch Ness monster</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>monstruo del lago Ness</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cryptozoology) A large creature believed by some to inhabit Loch Ness in Scotland. It is said to have a long neck and one or more humps that protrude from the water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
