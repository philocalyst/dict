      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Francisco</ns0:quote>
          <ns0:quote>Paco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
