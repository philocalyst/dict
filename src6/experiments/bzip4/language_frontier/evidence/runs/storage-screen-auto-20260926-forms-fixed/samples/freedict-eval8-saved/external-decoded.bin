      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mercado navideño</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmas present</ns0:orth>
        <ns0:pron>/ˈkɹɪsməs ˌpɹɛzənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguilando</ns0:quote>
          <ns0:quote>aguinaldo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmas season</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Navidades</ns0:quote>
          <ns0:quote>temporada navideña</ns0:quote>
          <ns0:quote>época navideña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Christmastide, Yuletide; the Twelve Days of Christmas, starting on Christmas Day and ending on Epiphany, January 6.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmas time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tiempo navideño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Christmas season.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmas tree</ns0:orth>
        <ns0:pron>/ˈkɹɪsməs tɹiː/</ns0:pron>
        <ns0:pron>/ˈkɹɪsməs ˌtɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>árbol de Navidad</ns0:quote>
          <ns0:quote>humisha</ns0:quote>
          <ns0:quote>árbol navideño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An evergreen tree (usually a conifer), or an artificial tree made to resemble this, which is typically decorated with lights and ornaments and often an angel or star at its tip, and used as a decoration during the Christmas holiday season.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmassy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>navideño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resembling or having feelings of Christmas; festive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmastime</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Navidades</ns0:quote>
          <ns0:quote>natividad</ns0:quote>
          <ns0:quote>navidades</ns0:quote>
          <ns0:quote>época navideña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Christmas season; Christmastide; yuletide</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christological</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cristológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(theology) Of or pertaining to Christology</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christology</ns0:orth>
        <ns0:pron>/kɹɪˈstɒləd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cristología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A field of study within Christian theology which is concerned with the nature of Jesus Christ, particularly with how the divine and human are related in his person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
