    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lantern Festival</ns0:orth>
        <ns0:pron>/ˌlæn(t)ɚn ˈfɛstəv(ə)l/</ns0:pron>
