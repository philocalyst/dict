        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ingusetio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a Nakh people of the northeastern Caucasus, now mostly Sunni Muslim and resident in the Russian republic of Ingushetia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ingush</ns0:orth>
      </ns0:form>
