        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Leningrad</ns0:orth>
        <ns0:pron>/ˈlɛn.ənˌɡræd/</ns0:pron>
        <ns0:pron>/ˈlɛn.ənˌɡrɑd/</ns0:pron>
        <ns0:pron>/ˈlɛn.ɪnˌɡræd/</ns0:pron>
        <ns0:pron>/ˈlɛn.ɪnˌɡrɑd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Leningrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Former name of Saint Petersburg: a major city in Russia, from the time of Lenin's death in 1924 until 1991.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>óblast de Leningrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An oblast of Russia, which surrounds, but no longer contains, Saint Petersburg, its former administrative centre.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Leninism</ns0:orth>
        <ns0:pron>/ˈlɛnɪnɪzm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>leninismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A political ideology developed by Vladimir Lenin that proposes the establishment of the dictatorship of the proletariat led by a revolutionary vanguard party, as the political prelude to the establishment of communism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Leninist</ns0:orth>
        <ns0:pron>/ˈlɛnənɪst/</ns0:pron>
        <ns0:pron>/ˈlɛnɪnɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>leninista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who follows or supports Lenin or the philosophy of Leninism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lent</ns0:orth>
        <ns0:pron>/lɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cuaresma</ns0:quote>
          <ns0:quote>cuaresma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A period of the ecclesiastical year preceding Easter, traditionally involving temporary abstention from certain foods and pleasures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Leo</ns0:orth>
        <ns0:pron>/ˈliːoʊ/</ns0:pron>
        <ns0:pron>/ˈliːəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>León</ns0:quote>
          <ns0:quote>Leo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, borne by numerous saints and 14 popes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Leo</ns0:quote>
          <ns0:quote>León</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zodiac constellations) A constellation of the zodiac, shaped approximately like a lion and containing the stars Regulus and Denebola.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Leo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrology) The zodiac sign for the Lion, ruled by the Sun and covering July 23 - August 22 (tropical astrology) or August 16 - September 15 (sidereal astrology).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
