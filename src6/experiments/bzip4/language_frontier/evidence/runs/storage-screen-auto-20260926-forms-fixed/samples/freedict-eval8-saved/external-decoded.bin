      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arrogancia</ns0:quote>
          <ns0:quote>soberbia</ns0:quote>
          <ns0:quote>altanería</ns0:quote>
          <ns0:quote>altivez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being arrogant; a type of extreme or foolish pride in which someone feels much superior to another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrogant</ns0:orth>
        <ns0:pron>/ˈæɹəɡənt/</ns0:pron>
        <ns0:pron>/ˈɛɹəɡənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arrogante</ns0:quote>
          <ns0:quote>creído</ns0:quote>
          <ns0:quote>presumido</ns0:quote>
          <ns0:quote>altivo</ns0:quote>
          <ns0:quote>altanero</ns0:quote>
          <ns0:quote>comemierda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having excessive pride in oneself, often with contempt or disrespect for others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrogantly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arrogantemente</ns0:quote>
          <ns0:quote>a caballazo</ns0:quote>
          <ns0:quote>al caballazo</ns0:quote>
          <ns0:quote>prepotentemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an arrogant manner; with undue pride or self-importance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
