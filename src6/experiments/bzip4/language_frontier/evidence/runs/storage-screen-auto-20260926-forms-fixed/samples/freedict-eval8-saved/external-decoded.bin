        <ns0:pron>/ˈbaskɛt/</ns0:pron>
        <ns0:pron>/ˈbaskɪt/</ns0:pron>
        <ns0:pron>/ˈbaːskət/</ns0:pron>
        <ns0:pron>/ˈbæskət/</ns0:pron>
        <ns0:pron>/ˈbæskɪt/</ns0:pron>
        <ns0:pron>/ˈbɑːskɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cesta</ns0:quote>
          <ns0:quote>canasta</ns0:quote>
          <ns0:quote>cesto</ns0:quote>
          <ns0:quote>escripia</ns0:quote>
          <ns0:quote>escriño</ns0:quote>
          <ns0:quote>escusabaraja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lightweight container, generally round, open at the top, and tapering toward the bottom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canasta</ns0:quote>
          <ns0:quote>cesta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(basketball) A circular hoop, from which a net is suspended, which is the goal through which the players try to throw the ball.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(basketball) The act of putting the ball through the basket, thereby scoring points.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A dance movement in some line dances, where men put their arms round the women's lower backs, and the women put their arms over the men's shoulders, and the group (usually of four, any more is difficult) spins round, which should result in the women's feet leaving the ground.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
