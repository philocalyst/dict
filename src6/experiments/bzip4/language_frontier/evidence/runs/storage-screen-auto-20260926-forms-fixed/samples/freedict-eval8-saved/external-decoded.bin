        <ns0:sense>
          <ns0:def>A large plain that occupies most of northern Italy south of the Alps, surrounding the river Po.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
