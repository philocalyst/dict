      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Las Cabras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Chile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Las Vegas</ns0:orth>
        <ns0:pron>/lɑs ˈveɪɡəs/</ns0:pron>
        <ns0:pron>/lɒs ˈveɪɡəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Las Vegas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the county seat of San Miguel County, New Mexico, United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Las Vueltas</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Las Vueltas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town in Chalatenango department, El Salvador.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Last Judgment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Juicio Final</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The judgement day.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Last Supper</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Última Cena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The Passover meal that Jesus ate with his disciples on the night before his death.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lata</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lata</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Late Antiquity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Antigüedad tardía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) The period of Mediterranean and Eurasian history from around the 3rd to the 7th centuries CE, marked especially by the transition from the Roman and Persian Empires to the Middle Ages and the Islamic and Byzantine civilizations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Late Latin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latín tardío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The form of the Latin language used between the 2nd/3rd and 6th centuries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Late Middle Ages</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Baja Edad Media</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) The period of European history between the High Middle Ages and the Early Modern period, c. 1300 to 1500 CE.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lateran</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Letrán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A church and palace in Rome; used attributively to describe several councils and treaties</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin</ns0:orth>
        <ns0:pron>/ˈlæt.ɪn/</ns0:pron>
        <ns0:pron>[ˈlæt.ən]</ns0:pron>
        <ns0:pron>[ˈlæʔ.ən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latino</ns0:quote>
          <ns0:quote>latín</ns0:quote>
          <ns0:quote>romano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Latin: the language spoken in ancient Rome and other cities of Latium.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or relating to the script of the language spoken in ancient Rome and many modern alphabets.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latino</ns0:quote>
          <ns0:quote>romano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the customs and people descended from the ancient Romans and their Empire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latino</ns0:quote>
          <ns0:quote>latinoamericano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or from Latin America or of Latin American culture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin</ns0:orth>
        <ns0:pron>/ˈlæt.ɪn/</ns0:pron>
        <ns0:pron>[ˈlæt.ən]</ns0:pron>
        <ns0:pron>[ˈlæʔ.ən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>romano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A person native to ancient Rome or its Empire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from one of the modern European countries (including Italy, Spain etc.) whose language is descended from Latin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin</ns0:orth>
        <ns0:pron>/ˈlæt.ɪn/</ns0:pron>
        <ns0:pron>[ˈlæt.ən]</ns0:pron>
        <ns0:pron>[ˈlæʔ.ən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latín</ns0:quote>
          <ns0:quote>latino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The language of the ancient Romans, other Latins and of the Roman Catholic church, especially Classical Latin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin America</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>América Latina</ns0:quote>
          <ns0:quote>Latinoamérica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(most often) A continental region consisting of those parts of the Americas located south of the United States where Spanish or Portuguese is predominantly spoken; sometimes including areas speaking French or French-based creoles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin American</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinoamericano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Latin America, its people, or its culture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin American</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinoamericano</ns0:quote>
          <ns0:quote>latinoamericana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or inhabitant of Latin America, or of such descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin Church</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iglesia latina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Catholicism) One of the 24 particular churches (sui juris) in full communion with the Holy See and the rest of the Catholic Church which uses the Latin liturgical rites.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin alphabet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabeto latino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The 26-letter alphabet consisting of the following letters (presented in majuscule and minuscule pairs):</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latin square</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuadrado latino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) An n-by-n arrangement of n different integers such that each row, each column and each of the two diagonals contains each of the integers once and once only.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latinate</ns0:orth>
        <ns0:pron>/ˈlætɪnət/</ns0:pron>
        <ns0:pron>[ˈlæʔənəʔ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinista</ns0:quote>
          <ns0:quote>latinizante</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latinism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any word or phrase borrowed from Latin, or suggestive of Latin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latinist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A scholar who studies the Latin language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latinity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, countable) The quality of a particular person's Latin speech or writing; the Latin language, as an area of study or interest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latinization</ns0:orth>
        <ns0:pron>/ˌlæt.ɪ.naɪˈzeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of Latinizing, of making Latin; including translating into Latin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latinize</ns0:orth>
        <ns0:pron>/ˈlæt.ə.naɪz/</ns0:pron>
        <ns0:pron>/ˈlæt.ən.aɪz/</ns0:pron>
        <ns0:pron>/ˈlæt.ɪ.naɪz/</ns0:pron>
        <ns0:pron>/ˈlæt.ɪn.aɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To translate something into the Latin language; or make a word similar in appearance or form to a Latin word.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latino</ns0:orth>
        <ns0:pron>/læ-/</ns0:pron>
        <ns0:pron>/lɑː/</ns0:pron>
        <ns0:pron>/ləˈtinoʊ/</ns0:pron>
        <ns0:pron>/ləˈtiːnəʊ/</ns0:pron>
        <ns0:pron>[la̠ˈt̪ino̞]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latinoamericano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US) A person, especially and usually (interpreted as) a male, from Latin America, a Hispanic person. (Compare Latina.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Latino-Faliscan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latino-falisco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Latin and Faliscan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
