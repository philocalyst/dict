          <ns0:quote>lamaísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The body of Buddhist religious doctrine and institutions characteristic of Tibet, Mongolia, Tuva, Bhutan, Kalmykia, Buryatia and certain regions of the Himalayas, including northern Nepal, and India.</ns0:def>
        </ns0:sense>
      </ns0:sense>
