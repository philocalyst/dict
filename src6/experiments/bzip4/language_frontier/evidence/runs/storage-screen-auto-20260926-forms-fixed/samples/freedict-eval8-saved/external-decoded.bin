          <ns0:quote>caso benefactivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammatical case) A case used to indicate beneficiary, or the receiver of the benefit, roughly corresponding to English prepositions such as for, for the benefit of, in the interests of, intended for, or on behalf of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
