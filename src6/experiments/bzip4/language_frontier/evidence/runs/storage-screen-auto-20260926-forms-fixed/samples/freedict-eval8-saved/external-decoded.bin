        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Memnón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) An Ethiopian king and son of Tithonus and Eos. Considered a great warrior, he fought on the side of Troy and was killed by Achilles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
