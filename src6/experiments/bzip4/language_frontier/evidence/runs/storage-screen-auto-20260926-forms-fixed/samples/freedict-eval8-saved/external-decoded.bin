    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Vulcan</ns0:orth>
        <ns0:pron>/ˈvʌlkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Vulcano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Roman god) The god of volcanoes and fire, especially the forge, also the patron of all craftsmen, especially blacksmiths. The Roman counterpart of Hephaestus.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy, historical) A hypothetical planet proposed in the 19th century to exist in an orbit between Mercury and the Sun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
