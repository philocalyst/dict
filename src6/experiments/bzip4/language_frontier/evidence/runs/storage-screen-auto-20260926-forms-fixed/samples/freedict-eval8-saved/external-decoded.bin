        <ns0:pron>/ðə ˈhæɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>La Haya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the capital of South Holland, Netherlands; the administrative capital of the Netherlands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
