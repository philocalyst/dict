    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judah</ns0:orth>
        <ns0:pron>/ˈd͡ʒuː.də/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Judá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The fourth son of Jacob, by his wife Leah; the father of Perez.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biblical) A traditional region and ancient kingdom (c. 930 — 586 BCE) in the Land of Israel in modern Israel and Palestine; the southern Israelite kingdom which continued to be ruled by the Davidic dynasty after Solomon's death and the breakup of the united monarchy, with the northern portion keeping the name Israel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judaic</ns0:orth>
        <ns0:pron>/d͡ʒuˈdeɪ̯.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judaico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the Jews, their culture or their religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judaism</ns0:orth>
        <ns0:pron>/d͡ʒuˈdeɪˌɪz.əm/</ns0:pron>
        <ns0:pron>/ˈd͡ʒuː.deɪˌɪz.əm/</ns0:pron>
        <ns0:pron>/ˈd͡ʒuː.diˌɪz.əm/</ns0:pron>
        <ns0:pron>/ˈd͡ʒuː.dəˌɪz.əm/</ns0:pron>
        <ns0:pron>/ˈd͡ʒuːˌdeɪ.ɪz.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judaísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Abrahamic religion tracing its origin to the Hebrew people of the ancient Middle East, as documented in their religious writings, the Tanakh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judaize</ns0:orth>
        <ns0:pron>/ˈd͡ʒuːdeɪˌaɪz/</ns0:pron>
        <ns0:pron>/ˈd͡ʒuːdiˌaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judaizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To impose Jewish beliefs or customs on someone; to convert to Judaism; to make Jewish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judas</ns0:orth>
        <ns0:pron>/ˈd͡ʒuːdəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judas</ns0:quote>
          <ns0:quote>Judas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A traitor; a person not to be trusted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judas</ns0:orth>
        <ns0:pron>/ˈd͡ʒuːdəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Judas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) Judas Iscariot, one of the twelve original Apostles of Jesus, known for his role in Jesus' betrayal into the hands of Roman authorities.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biblical, archaic) Alternative form of Jude, the penultimate book of the Bible and its ascribed author, Jude the Apostle (Judas Thaddaeus).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judas Iscariot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Judas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A betrayer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judas Iscariot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Judas Iscariote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) One of the twelve disciples of Jesus in the New Testament, who betrayed Jesus into the hands of the chief priests for 30 pieces of silver.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judas cradle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuna de Judas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A purported torture device invented in Spain in the 16th century by the Spanish Inquisition by which the suspended victim’s orifice, usually the anus, was slowly impaled on and stretched by the pyramidal tip of the seat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Judas kiss</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beso de Judas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any act of treachery under the guise of kindness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
