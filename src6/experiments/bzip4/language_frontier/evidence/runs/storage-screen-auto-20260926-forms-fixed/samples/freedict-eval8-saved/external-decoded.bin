    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Poincaré disk</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disco de Poincaré</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The hyperbolic plane, viewed as a disk so that Euclidean circles and lines Euclidean-perpendicular to the disk's surface are hyperbolic lines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
