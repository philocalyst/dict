        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hábilmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an able manner; with great ability. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abnegate</ns0:orth>
        <ns0:pron>/ˈæb.ni.ɡeɪt/</ns0:pron>
