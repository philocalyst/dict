          <ns0:quote>wasap</ns0:quote>
          <ns0:quote>whatsapp</ns0:quote>
          <ns0:quote>wásap</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A message sent via WhatsApp.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>WhatsApp</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guasapear</ns0:quote>
          <ns0:quote>wasapear</ns0:quote>
          <ns0:quote>whatsappear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To contact (someone) via WhatsApp.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wheel of Fortune</ns0:orth>
        <ns0:pron>/-t͡ʃən/</ns0:pron>
        <ns0:pron>/ˌwil‿əv ˈfoɹt͡ʃun/</ns0:pron>
        <ns0:pron>/ˌwiːl‿əv ˈfɔːt͡ʃuːn/</ns0:pron>
        <ns0:pron>/ˌʍil-/</ns0:pron>
        <ns0:pron>/ˌʍiːl-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rota Fortunae</ns0:quote>
          <ns0:quote>Rueda de la Fortuna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mythology, philosophy) The mythological wheel turned randomly by Fortuna, the Roman goddess of fate, fortune, and luck, to determine people's fortunes which were thus unpredictable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>la rueda de la fortuna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(tarot) A tarot card with an image of Fortuna's wheel (sense 1), generally the tenth of 22 trumps of the major arcana in most tarot decks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>White Army</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ejército Blanco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, military) a collation of anti-Bolshevik armed groups that fought the Red Army during the Russian Civil War</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>White House</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Casa Blanca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) The official home and workplace of the President of the United States of America.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(US, metonym) The US presidency and its administration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>White Russian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ruso blanco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cocktail consisting of coffee liqueur, vodka, and milk.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical) A White Guardist, a Russian who did not support the Socialists in the Revolution in 1917 and the Russian Civil War (1917–1923), and afterwards (e.g. as a White émigré).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>White Sea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar Blanco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sea to the northwest of Russia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>White's thrush</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zorzal de White</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A thrush found mainly in eastern Asia and Siberia and rare vagrant to western Europe, of species Zoothera aurea (or formerly, sometimes of subspecies Zoothera dauma aurea).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Whitsunday</ns0:orth>
        <ns0:pron>/wɪtˈsʌndeɪ/</ns0:pron>
        <ns0:pron>/wɪtˈsʌndi/</ns0:pron>
        <ns0:pron>/ʍ-/</ns0:pron>
        <ns0:pron>/ˈʍɪtsəndeɪ/</ns0:pron>
        <ns0:pron>/ˈʍɪtsəndɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pentecostés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The Sunday on which the feast or festival of Pentecost falls, seven weeks after Easter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wi-Fi</ns0:orth>
        <ns0:pron>/ˈwajfaj/</ns0:pron>
        <ns0:pron>/ˈwajpaj/</ns0:pron>
        <ns0:pron>/ˈwaɪ.faɪ/</ns0:pron>
        <ns0:pron>[ˈwaɪ̯.faɪ̯]</ns0:pron>
        <ns0:pron>[ˈwaɪ̯.paɪ̯]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wifi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(networking, uncountable) Any of several standards for short-range wireless data transmission (IEEE 802.11).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wicca</ns0:orth>
        <ns0:pron>/ˈwɪkə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wicca</ns0:quote>
          <ns0:quote>brujería</ns0:quote>
          <ns0:quote>hechicería</ns0:quote>
          <ns0:quote>magia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A neopagan religion that was first popularized by books written in 1949, 1954, and 1959 by Englishman Gerald Gardner, involving the worship of a horned male god and a moon goddess, the observance of eight Sabbats, and the performance of various rituals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wiccan</ns0:orth>
        <ns0:pron>/ˈwɪkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wiccano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the neo-pagan religion of Wicca.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wiccan</ns0:orth>
        <ns0:pron>/ˈwɪkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>brujo</ns0:quote>
          <ns0:quote>hechicera</ns0:quote>
          <ns0:quote>hechizero</ns0:quote>
          <ns0:quote>mago</ns0:quote>
          <ns0:quote>wiccano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of Wicca.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wiccaphobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wiccafobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fear or hatred of Wicca or Wiccans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wii</ns0:orth>
        <ns0:pron>/wiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wii</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(video games) A video game system released worldwide by Nintendo in 2006, noted for its unique motion-based control system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wiimote</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wiimote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(video games, informal) The Wii Remote, the primary controller for the Nintendo Wii game console, noted for its motion-sensing capabilities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>WikiProject</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wikiproyecto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(WMF) A group of editors who work together on improving the coverage of a particular topic on a wiki, especially on Wikipedia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wikidata</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wikidata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A free-content, multilingual, online knowledge base and wiki run by the Wikimedia Foundation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wikiholic</ns0:orth>
        <ns0:pron>/ˌwɪkɪˈhɒlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wikihólica</ns0:quote>
          <ns0:quote>wikihólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(wiki) Someone who is addicted to editing Wikipedia or another wiki.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wikipedia</ns0:orth>
        <ns0:pron>/ˌwɪ.kiˈpidi.ə/</ns0:pron>
        <ns0:pron>/ˌwɪ.kɪˈpiːdɪə/</ns0:pron>
        <ns0:pron>/ˌwɪkəˈpidi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wikipedia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A free-content, multilingual, online encyclopedia and wiki run by the Wikimedia Foundation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wikipedian</ns0:orth>
        <ns0:pron>/wɪ.kɪˈpiː.dɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wikipédico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Wikipedia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wikipedian</ns0:orth>
        <ns0:pron>/wɪ.kɪˈpiː.dɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wikipedista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(WMF) A person who contributes to Wikipedia, especially a regular contributor well versed in the ways of the website.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wiktionarian</ns0:orth>
        <ns0:pron>/ˈwɪk.tʃəˌnɛ.ɹi.ən/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃə.nə.ɹi.ən/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃən.ɹi.ən/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃəˌnɛ.ɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wikcionarista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Wikimedia jargon) A person who contributes to Wiktionary, especially a regular contributor well versed in the ways of the site.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wiktionary</ns0:orth>
        <ns0:pron>/ˈwɪk.tʃəˌnɛɹ.i/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃə.nə.ɹi/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃə.nə.ɹiː/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃən.ɹi/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃəˌnɛ.ɹi/</ns0:pron>
        <ns0:pron>/ˈwɪk.ʃəˌnɛɹ.i/</ns0:pron>
        <ns0:pron>/ˈʋɪk.ʃə.nɛ.ri/</ns0:pron>
        <ns0:pron>/ˈʋɪkʃ.nə.ri/</ns0:pron>
        <ns0:pron>[ˈwikʃ.nə.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wikcionario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A particular version of this dictionary project, written in a certain language, such as the English-language Wiktionary (often known simply as the English Wiktionary).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wild Hunt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cacería salvaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ghostly hunt that rides across the sky, common to English, German and Scandinavian folklore.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wild West</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lejano Oeste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The western United States during the 19th-century era of settlement, commonly believed to be lawless and unruly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wilfred</ns0:orth>
        <ns0:pron>/ˈwɪlfɹɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wilfredo</ns0:quote>
