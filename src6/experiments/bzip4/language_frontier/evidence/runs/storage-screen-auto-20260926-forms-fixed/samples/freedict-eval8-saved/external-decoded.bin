      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) Pertaining to abortion; miscarrying; abortive. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortionist</ns0:orth>
        <ns0:pron>/əˈbɔɹ.ʃə.nɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortera</ns0:quote>
          <ns0:quote>abortero</ns0:quote>
          <ns0:quote>abortista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, sometimes, offensive) A person who performs abortions, especially illegally or secretly. [from 1844]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, derogatory) A person who advocates for or supports the legality of abortion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortive</ns0:orth>
        <ns0:pron>/əˈbɔɹ.tɪv/</ns0:pron>
        <ns0:pron>/əˈbɔː.tɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Produced by abortion; born prematurely and therefore unnatural. [c. 1400–mid 1700s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine, pharmaceutical effect, rare) Causing abortion; abortifacient.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fracasado</ns0:quote>
          <ns0:quote>frustrado</ns0:quote>
          <ns0:quote>malogrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Coming to nothing; failing in its effect. [from late 1500s].</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortive</ns0:orth>
        <ns0:pron>/əˈbɔɹ.tɪv/</ns0:pron>
        <ns0:pron>/əˈbɔː.tɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Someone or something born or brought forth prematurely; an abortion. [Attested from around (1150 to 1350) until the mid 18th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete) A medicine that causes abortion, an abortifacient.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abound</ns0:orth>
        <ns0:pron>/əˈbaʊnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundar</ns0:quote>
          <ns0:quote>ser abundante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To be full to overflowing; to bristle. [First attested from around (1350 to 1470).]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To be present or available in large numbers or quantities; to be plentiful. [First attested from around (1350 to 1470).]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To be copiously supplied. [with in or with ‘something’]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about</ns0:orth>
        <ns0:pron>/əˈbaʊ̯t/</ns0:pron>
        <ns0:pron>/əˈbuːt/</ns0:pron>
        <ns0:pron>/əˈbɛʊ̯/</ns0:pron>
        <ns0:pron>/əˈbɛʊ̯t/</ns0:pron>
        <ns0:pron>[əˈboʊ̯t]</ns0:pron>
        <ns0:pron>[əˈbɐʊ̯t]</ns0:pron>
        <ns0:pron>[əˈbɛʊ̯t]</ns0:pron>
        <ns0:pron>[əˈbɛʊ̯ʔ]</ns0:pron>
        <ns0:pron>[əˈbɵu̯t]</ns0:pron>
        <ns0:pron>[əˈbʌʊ̯t]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alrededor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On all sides, or in every or any direction from a point; around. [from before 1150]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Here and there; around; in one place and another; up and down. [from before 1150]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(archaic) In circuit or circumference; circularly. [from ca. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alrededor de</ns0:quote>
          <ns0:quote>rondar</ns0:quote>
          <ns0:quote>unos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Nearly; approximately; with close correspondence in quality, manner, degree, quantity, or time; almost. [from before 1150]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alrededor de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Near; in the vicinity. [from ca. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about</ns0:orth>
        <ns0:pron>/əˈbaʊ̯t/</ns0:pron>
        <ns0:pron>/əˈbuːt/</ns0:pron>
        <ns0:pron>/əˈbɛʊ̯/</ns0:pron>
        <ns0:pron>/əˈbɛʊ̯t/</ns0:pron>
        <ns0:pron>[əˈboʊ̯t]</ns0:pron>
        <ns0:pron>[əˈbɐʊ̯t]</ns0:pron>
        <ns0:pron>[əˈbɛʊ̯t]</ns0:pron>
        <ns0:pron>[əˈbɛʊ̯ʔ]</ns0:pron>
        <ns0:pron>[əˈbɵu̯t]</ns0:pron>
        <ns0:pron>[əˈbʌʊ̯t]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alrededor</ns0:quote>
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a circle around; all round; on every side of; on the outside of; around. [from before 1150]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encima de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Over or upon different parts of; through or over in various directions; here and there in; to and fro in; throughout. [from ca. 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a punto de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(with present participle, obsolete, or, dialect) On the point or verge of.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative) On or near (one's person); attached as an attribute to; in the makeup of, or at the command of. [from ca. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sobre</ns0:quote>
          <ns0:quote>acerca de</ns0:quote>
          <ns0:quote>a propósito de</ns0:quote>
          <ns0:quote>con lo de</ns0:quote>
          <ns0:quote>de</ns0:quote>
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Concerning; with regard to; on account of; on the subject of. [from ca. 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sobre</ns0:quote>
          <ns0:quote>acerca de</ns0:quote>
          <ns0:quote>a propósito de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Concerned or occupied with; engaged in; intent on. [from ca. 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cerca de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Within or in the immediate neighborhood of; in contiguity or proximity to; near, as to place. [from ca. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya era hora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, often, sarcastic) Far past the desired time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al fin</ns0:quote>
          <ns0:quote>es hora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Close to the right time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about to</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a punto de</ns0:quote>
          <ns0:quote>en punto de</ns0:quote>
          <ns0:quote>estar para</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, with infinitive verb) Indicates something that will happen very soon; indicates action that is imminent; ready to; went to</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about-face</ns0:orth>
        <ns0:pron>/əˈbaʊtˌfeɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>media vuelta</ns0:quote>
          <ns0:quote>cambio de rumbo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) An abrupt turn to face the opposite direction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>media vuelta</ns0:quote>
          <ns0:quote>cambio de rumbo</ns0:quote>
          <ns0:quote>virazón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) A reversal in direction; a reversal of attitude or opinion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about-face</ns0:orth>
        <ns0:pron>/əˈbaʊtˌfeɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dar la media vuelta</ns0:quote>
          <ns0:quote>darse media vuelta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To turn 180 degrees to face the opposite direction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cambiar de rumbo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To change opinion or attitude drastically.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>about-turn</ns0:orth>
        <ns0:pron>/əˈbaʊt tɚn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>giro radical</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Total reversal of opinion or attitude [First attested in the mid 20th century.].</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above</ns0:orth>
        <ns0:pron>/əˈbʌv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arriba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Higher in the same page; earlier in the order as far as writing products go. [first attested before 1150.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arriba</ns0:quote>
          <ns0:quote>asuso</ns0:quote>
          <ns0:quote>suso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a higher place; upstairs; farther upstream. [first attested around 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above</ns0:orth>
        <ns0:pron>/əˈbʌv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encima</ns0:quote>
          <ns0:quote>eclipsar, hacer sombra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Physically over; on top of; worn on top of, said of clothing. [first attested before 1150.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sobre</ns0:quote>
          <ns0:quote>encima de</ns0:quote>
          <ns0:quote>arriba</ns0:quote>
          <ns0:quote>asuso</ns0:quote>
          <ns0:quote>suso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In or to a higher place; higher than; on or over the upper surface. [first attested before 1150]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más al norte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Farther north than. [first attested before 1150]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuera de alcance</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Rising; appearing out of reach height-wise. [first attested around 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>además de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Higher than; superior to in any respect; surpassing; higher in measure, degree, volume, or pitch, etc. than; out of reach; not exposed to; not likely to be affected by; incapable of negative actions or thoughts. [first attested around 1150–1350]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Scotland) In addition to; besides. [first attested around 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más en rango</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Higher in rank, status, or position. [first attested around 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sobre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Surpassing in number or quantity; more than. [first attested around 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a preferencia de</ns0:quote>
          <ns0:quote>además de</ns0:quote>
          <ns0:quote>muy orgulloso[a], al revés</ns0:quote>
          <ns0:quote>sobrepasar, superar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Too proud to stoop to; averse to; disinclined towards;</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más allá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Beyond; on the other side.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above all</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sobre todo</ns0:quote>
          <ns0:quote>por encima de todo</ns0:quote>
          <ns0:quote>ante todo</ns0:quote>
          <ns0:quote>más que nada</ns0:quote>
          <ns0:quote>máxime</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of prime importance; before anything else; especially.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above average</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por encima de la media</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Better than average.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above the curve</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelantado de su época</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above the law</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por encima de la ley</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Exempt from the laws that apply to everyone else.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above-board</ns0:orth>
        <ns0:pron>/əˈbʌvˌbɔɹd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>legítimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In open sight; without trick, concealment, or deception. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>above-mentioned</ns0:orth>
        <ns0:pron>/əˈbʌvˌmɛnʃn̩d/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antedicho</ns0:quote>
          <ns0:quote>sobredicho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Mentioned or named before; aforesaid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abracadabra</ns0:orth>
        <ns0:pron>/ˌæbɹəkəˈdæbɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abracadabra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to indicate that a magic trick or other illusion has been performed. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrade</ns0:orth>
        <ns0:pron>/əˈbɹeɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desgastar</ns0:quote>
          <ns0:quote>escoriar</ns0:quote>
          <ns0:quote>legrar</ns0:quote>
          <ns0:quote>raer</ns0:quote>
          <ns0:quote>raspar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To rub or wear off; erode. [First attested in the late 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrasion</ns0:orth>
        <ns0:pron>/əˈbɹeɪ.ʒn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrasión</ns0:quote>
          <ns0:quote>raedura</ns0:quote>
          <ns0:quote>rasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abrading, wearing, or rubbing off; the wearing away by friction. [First attested in the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrasión</ns0:quote>
          <ns0:quote>erosión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) The effect of mechanical erosion of rock, especially a river bed, by rock fragments scratching and scraping it. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrasión</ns0:quote>
          <ns0:quote>rasguño</ns0:quote>
          <ns0:quote>raspadura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A superficial wound caused by scraping; an area of skin where the cells on the surface have been scraped or worn away. [First attested in the mid 20th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrasive</ns0:orth>
        <ns0:pron>/əˈbɹeɪ.sɪv/</ns0:pron>
        <ns0:pron>/əˈbɹeɪ.zɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrasivo</ns0:quote>
          <ns0:quote>alisador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Producing abrasion; rough enough to wear away the outer surface. [First attested in 1805.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>brusco</ns0:quote>
          <ns0:quote>irritante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Being rough and coarse in manner or disposition; overly aggressive and causing irritation. [First attested in 1925.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrasive</ns0:orth>
        <ns0:pron>/əˈbɹeɪ.sɪv/</ns0:pron>
        <ns0:pron>/əˈbɹeɪ.zɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrasivo</ns0:quote>
          <ns0:quote>alisador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hard inorganic substance or material consisting in powder or granule form such as sandpaper, pumice, or emery, used for cleaning, smoothing, or polishing. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrasively</ns0:orth>
        <ns0:pron>/əˈbɹeɪ.sɪv.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desabridamente</ns0:quote>
          <ns0:quote>ásperamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an abrasive manner; in a rude and unkind manner; acting in a way that may hurt other people's feelings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abreast</ns0:orth>
        <ns0:pron>/əˈbɹɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de lado a lado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Side by side and facing forward. [First attested from around (1350 to 1470.)]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al corriente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Informed, well-informed, familiar, acquainted. [First attested in the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abridge</ns0:orth>
        <ns0:pron>/əˈbɹɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>privar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To deprive; to cut off. [First attested around 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviar</ns0:quote>
          <ns0:quote>compendiar</ns0:quote>
          <ns0:quote>condensar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make shorter; to shorten in duration or extent. [First attested around 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviar</ns0:quote>
          <ns0:quote>resumir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To shorten or contract by using fewer words, yet retaining the sense; to epitomize; to condense. [First attested in 1384] [First attested around 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abridged</ns0:orth>
        <ns0:pron>/əˈbɹɪd͡ʒd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Cut or shortened, especially of a literary work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abridgment</ns0:orth>
        <ns0:pron>/əˈbɹɪd͡ʒ.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviación</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compendio</ns0:quote>
          <ns0:quote>versión abreviada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) An epitome or compend, as of a book; a shortened or abridged form; an abbreviation. [First attested from around (1350 to 1470).]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abroad</ns0:orth>
        <ns0:pron>/əˈbɹɑd/</ns0:pron>
        <ns0:pron>/əˈbɹɔd/</ns0:pron>
        <ns0:pron>/əˈbɹɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a extranjis</ns0:quote>
          <ns0:quote>al extranjero</ns0:quote>
          <ns0:quote>en el exterior</ns0:quote>
          <ns0:quote>en el extranjero</ns0:quote>
          <ns0:quote>en extranjis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Beyond the bounds of a country; in foreign countries. [from 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en todas direcciones</ns0:quote>
          <ns0:quote>por todas partes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) At large; widely; broadly; over a wide space. [from 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al exterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Without a certain confine; outside the house; away from one's abode. [from 1150–1350)]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abroad</ns0:orth>
        <ns0:pron>/əˈbɹɑd/</ns0:pron>
        <ns0:pron>/əˈbɹɔd/</ns0:pron>
        <ns0:pron>/əˈbɹɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el extranjero</ns0:quote>
          <ns0:quote>extranjis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare, Scotland) Countries or lands abroad. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrogable</ns0:orth>
        <ns0:pron>/ˈæb.ɹə.ɡə.bl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrogable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>capable of being abrogated. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrogate</ns0:orth>
        <ns0:pron>/ˈæ.bɹə.ɡeɪt/</ns0:pron>
        <ns0:pron>/ˈæ.bɹə.ɡət/</ns0:pron>
        <ns0:pron>/ˈæb.ɹoʊˌɡeɪt/</ns0:pron>
        <ns0:pron>/ˈæb.ɹəʊ.ɡeɪt/</ns0:pron>
        <ns0:pron>/ˈæb.ɹəˌɡeɪt/</ns0:pron>
        <ns0:pron>/ˈæb.ɹəˌɡət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrogar</ns0:quote>
          <ns0:quote>derogar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, law) To annul (as a law, decree, ordinance, etc.) by an authoritative act; to abolish by the authority of the maker or their successor; to repeal.[First attested in the early 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrogation</ns0:orth>
        <ns0:pron>/ˌæb.ɹəˈɡeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæb.ɹəˈɡæɪ.ʃən/</ns0:pron>
        <ns0:pron>[ˌæb.ɹəˈɡeɪ.ʃn̩]</ns0:pron>
        <ns0:pron>[ˌæb.ɹəˈɡæɪ.ʃn̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrogación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abrogating.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abrupt</ns0:orth>
        <ns0:pron>/æbˈɹʌpt/</ns0:pron>
        <ns0:pron>/əˈbɹʌpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrupto</ns0:quote>
          <ns0:quote>súbito</ns0:quote>
          <ns0:quote>repentino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without notice to prepare the mind for the event; sudden; hasty; unceremonious. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrupto</ns0:quote>
          <ns0:quote>brusco</ns0:quote>
          <ns0:quote>cortante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Curt in manner. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrupto</ns0:quote>
          <ns0:quote>brusco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having sudden transitions from one subject or state to another; unconnected; disjointed. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Extremely steep or craggy as if broken up; precipitous. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrupto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Suddenly terminating, as if cut off; truncate. [First attested in the early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abruptly</ns0:orth>
        <ns0:pron>/əˈbɹʌp.li/</ns0:pron>
        <ns0:pron>/əˈbɹʌpt.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abruptamente</ns0:quote>
          <ns0:quote>precipitadamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an abrupt manner; without giving notice, or without the usual forms; suddenly; precipitously. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abscess</ns0:orth>
        <ns0:pron>/ˈæbsɛs/</ns0:pron>
        <ns0:pron>/ˈæbsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absceso</ns0:quote>
          <ns0:quote>flemón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A cavity caused by tissue destruction, usually because of infection, filled with pus and surrounded by inflamed tissue. [First attested in the mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abscess</ns0:orth>
        <ns0:pron>/ˈæbsɛs/</ns0:pron>
        <ns0:pron>/ˈæbsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To form a pus-filled cavity, typically from an infection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abscisic acid</ns0:orth>
        <ns0:pron>/ˌæbˈsɪs.ɪk ˈæ.sɪd/</ns0:pron>
        <ns0:pron>/ˌæbˈsɪz.ɪk ˈæ.sɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido abscísico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(hormone) A terpenoid best known as a plant hormone that inhibits seed germination and was once thought to be important in abscission.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abscissa</ns0:orth>
        <ns0:pron>/æbˈsɪs.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abscisa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The first of the two terms by which a point is referred to, in a system of fixed rectilinear coordinate (Cartesian coordinate) axes. [First attested in the late 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abscission</ns0:orth>
        <ns0:pron>/æbˈsɪ.ʃn̩/</ns0:pron>
        <ns0:pron>/æbˈsɪ.ʒn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abscisión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of cutting off.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abscond</ns0:orth>
        <ns0:pron>/əbˈskɑnd/</ns0:pron>
        <ns0:pron>/əbˈskɒnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evadir</ns0:quote>
          <ns0:quote>fugar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To flee, often secretly; to steal away. [From mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absconderse</ns0:quote>
          <ns0:quote>asconderse</ns0:quote>
          <ns0:quote>esconderse</ns0:quote>
          <ns0:quote>fugarse</ns0:quote>
          <ns0:quote>huir(se)</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To hide, to be in hiding or concealment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absence</ns0:orth>
        <ns0:pron>/æbˈsɒns/</ns0:pron>
        <ns0:pron>/ˈæb.s(ə)n̩s/</ns0:pron>
        <ns0:pron>/ˈæb.s(ə)n̩ts/</ns0:pron>
        <ns0:pron>/ˈæb.sn̩ts/</ns0:pron>
        <ns0:pron>/ˈæbsɒns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausencia</ns0:quote>
          <ns0:quote>absencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of being away or withdrawn from a place or from companionship</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Inattention to things present; abstraction (of mind). [First attested in the early 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Failure to be present where one is expected, wanted, or needed; nonattendance; deficiency. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausencia</ns0:quote>
          <ns0:quote>falta</ns0:quote>
          <ns0:quote>absencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lack; deficiency; non-existence. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausencia</ns0:quote>
          <ns0:quote>ausencia de hierro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(fencing) Lack of contact between blades.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absence makes the heart grow fonder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>la ausencia hace crecer el cariño</ns0:quote>
          <ns0:quote>nadie sabe lo que tiene hasta que lo pierde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) One feels more love or affection for those one loves when parted from them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absence seizure</ns0:orth>
        <ns0:pron>/ˈæb.sn̩s ˈsi.ʒɚ/</ns0:pron>
        <ns0:pron>/ˈæb.sn̩ts ˈsi.ʒɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>crisis de ausencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A type of seizure indicative of petit mal epilepsy. Brief seizure lasting up to 30 seconds involving vacantness and lack of awareness, possibly including twitching; not including spasm or unconsciousness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absent</ns0:orth>
        <ns0:pron>/ˈæb.sn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausente</ns0:quote>
          <ns0:quote>absente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Being away from a place; withdrawn from a place; existing but not present; (sometimes) missing. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(not comparable) Not existing. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausente</ns0:quote>
          <ns0:quote>absente</ns0:quote>
          <ns0:quote>distraído</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(comparable) Inattentive to what is passing; absent-minded; preoccupied. [First attested in the early 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absent</ns0:orth>
        <ns0:pron>/æbˈsɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausentarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, obsolete) Stay away; withdraw. [Attested from around 1350 to 1470 until the late 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absent-minded</ns0:orth>
        <ns0:pron>/ˌæb.sn̩tˈmaɪn.dɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>distraído</ns0:quote>
          <ns0:quote>despistado</ns0:quote>
          <ns0:quote>desatento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Absent in mind; often preoccupied; forgetful or careless due to distraction; easily distracted. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absent-mindedly</ns0:orth>
        <ns0:pron>/ˌæb.sn̩tˈmaɪn.dɪd.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>distraídamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(manner) Preoccupiedly; in an absent-minded manner. [First attested in the late 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absent-mindedness</ns0:orth>
        <ns0:pron>/ˌæb.sn̩tˈmaɪn.dɪd.nəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despiste</ns0:quote>
          <ns0:quote>abstracción</ns0:quote>
          <ns0:quote>descuido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The characteristic or state of being easily distracted or preoccupied. [First attested in the late 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absentee</ns0:orth>
        <ns0:pron>/ˌæb.sn̩ˈti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ausente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law) A person who is absent from their residence and usual environment, and has not been seen or heard from for some period of time, so that it is unknown whether they are still alive, for the purpose of civil law dealing with the management of property etc. in such cases.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person who is absent from his or her employment, school, post, duty, etc. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(attributive) Designating something whose owner, person responsible, etc. is absent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absenteeism</ns0:orth>
        <ns0:pron>/æb.sənˈtiːˌɪz.m̩/</ns0:pron>
        <ns0:pron>/ˌæb.sənˈtiˌɪz.m̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absentismo</ns0:quote>
          <ns0:quote>ausentismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being absent, especially frequently or without good reason; the practice of an absentee. [First attested in the early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absinthe</ns0:orth>
        <ns0:pron>/ˈæb.sænθ/</ns0:pron>
        <ns0:pron>/ˈæb.sæ̃θ/</ns0:pron>
        <ns0:pron>/ˈæb.sɪnθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ajenjo</ns0:quote>
          <ns0:quote>absenta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The herb absinthium Artemisia absinthium (grande wormwood); essence of wormwood. [from 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ajenjo</ns0:quote>
          <ns0:quote>absintio</ns0:quote>
          <ns0:quote>absenta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A distilled, highly alcoholic, anise-flavored liquor originally made from grande wormwood, anise, and other herbs. [from mid 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absinthin</ns0:orth>
        <ns0:pron>/ˈæbˌsɪn.θɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absintina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The principal compound found in wormwood (Artemisia absinthium), having a bitter taste: C15H20O4</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute</ns0:orth>
        <ns0:pron>/absəˈl(j)uːt/</ns0:pron>
        <ns0:pron>/absəˈlɪʊ̯t/</ns0:pron>
        <ns0:pron>/æb.səˈluːt/</ns0:pron>
        <ns0:pron>/əbzəˈl(j)uʈ/</ns0:pron>
        <ns0:pron>/ˈab-/</ns0:pron>
        <ns0:pron>/ˈabsə(ˌ)l(j)uːt/</ns0:pron>
        <ns0:pron>/ˈabzəl(j)uʈ/</ns0:pron>
        <ns0:pron>/ˈap.sə.lʉwt/</ns0:pron>
        <ns0:pron>/ˈæb.sə.ljuːt/</ns0:pron>
        <ns0:pron>/ˈæb.sə.luːt/</ns0:pron>
        <ns0:pron>/ˈæb.səˌlut/</ns0:pron>
        <ns0:pron>/ˈæp-/</ns0:pron>
        <ns0:pron>/ˌæb.səˈlut/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Free of restrictions, limitations, qualifications or conditions; unconditional. [first attested in the late 1400s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Characteristic of an absolutist ruler: domineering, peremptory. [first attested in the mid 1500s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Pure, free from mixture or adulteration; unmixed. [first attested in the mid 1500s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(especially, philosophy) Fundamental, ultimate, intrinsic; not relative; independent of references or relations to other things or standards. [first attested in the late 1700s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) Not immediately dependent on the other parts of the sentence; not in a syntactical relation with other parts of a text, or qualifying the text as a whole rather than any single word in it, like "it being over" in "it being over, she left". [first attested around 1350 to 1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>completo</ns0:quote>
          <ns0:quote>pleno</ns0:quote>
          <ns0:quote>absoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Free from imperfection, perfect, complete; especially, perfectly embodying a quality in its essential characteristics or to its highest degree. [first attested around 1400]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute humidity</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut hjuˈmɪd.ɪ.ti/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut hjuˈmɪd.ɪ.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>humedad assoluta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(meteorology) In a system of moist air, the ratio of the mass of water vapor present to the volume occupied by the mixture, that is, the density of the water vapor component. Absolute humidity is usually expressed in grams of water vapor per cubic meter or, in engineering practice, in grains per cubic foot. Because this measure of atmospheric humidity is not conservative with respect to adiabatic expansion or compression, it is not commonly used by meteorologists. (Also called vapor concentration and vapor density). See relative humidity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute majority</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut məˈd͡ʒɑɹ.ɪ.ti/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut məˈd͡ʒɑɹ.ɪ.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mayoría absoluta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A true numerical majority, more than 50% of the items being counted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute monarchy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>monarquía absoluta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The rule of such a monarch, as a form of government.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute pressure</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut ˈpɹɜ.ʃɚ/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut ˈpɹɜ.ʃɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>presión absoluta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, meteorology) Total pressure in a fluid equivalent to the sum of the gage and the atmospheric pressures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute space</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut speɪs/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut speɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espacio absoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The Newtonian concept of an unchanging and unchangeable reference system of spatial (and temporal) coordinates that is the same for all observers</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute superlative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>superlativo absoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In Greek: one of the degrees of comparison in an adjective that stresses an exceptional property without making a direct comparison, its closest equivalent in English being a most important letter, a very high mountain or absolutely pure water. It is formed by adding the suffix -τατος (declined) to the adjective's nominative, neuter singular.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute temperature</ns0:orth>
        <ns0:pron>/ˈtɜmp.ə.ɹə.tjɚ/</ns0:pron>
        <ns0:pron>/ˈtɜmp.ə.ɹə.t͡ʃɚ/</ns0:pron>
        <ns0:pron>/ˈtɜmp.ə.ɹə.t͡ʃʊɹ/</ns0:pron>
        <ns0:pron>/ˈtɜmp.ɹə.tjʊɹ/</ns0:pron>
        <ns0:pron>/ˈtɜmp.ɹə.t͡ʃɚ/</ns0:pron>
        <ns0:pron>/ˈtɜmp.ɹə.t͡ʃʊɹ/</ns0:pron>
        <ns0:pron>/ˈæb.səˌlut /</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>temperatura absoluta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Thermodynamic temperature; temperature measured on an absolute scale such as the Kelvin scale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute time</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut taɪm/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut taɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tiempo absoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The Newtonian concept of an unchanging and unchangeable reference system of time (and spatial) coordinates that is the same for all observers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute value</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut ˈvæl.ju/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut ˈvæl.ju/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>valor absoluto</ns0:quote>
          <ns0:quote>módulo</ns0:quote>
          <ns0:quote>magnitud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) For a complex number a+bi, the principal square root of the sum of the squares of its real and imaginary parts, \sqrt{a^2+b^2}. Denoted by vertical bars</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>\, |.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolute zero</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut ˈzi.ɹoʊ/</ns0:pron>
        <ns0:pron>/ˌæb.səˈljut ˈzi.ɹoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cero absoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The coldest possible temperature, equivalent to zero on the Kelvin scale, or approximately −273.15 °C, −459.67 °F; a total absence of heat; the temperature at which the motion of all molecules would cease. [First attested in the early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutely</ns0:orth>
        <ns0:pron>/ab-/</ns0:pron>
        <ns0:pron>/ˈap.səˌlʉʊt.lɪi/</ns0:pron>
        <ns0:pron>/ˈæb.səˌl(j)uːt.li/</ns0:pron>
        <ns0:pron>/ˈæb.səˌlut.li/</ns0:pron>
        <ns0:pron>/ˌap.səˈlʉʊt.lɪi/</ns0:pron>
        <ns0:pron>/ˌæb.səˈl(j)uːt.li/</ns0:pron>
        <ns0:pron>/ˌæb.səˈlut.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolutamente</ns0:quote>
          <ns0:quote>totalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an absolute or unconditional manner; utterly, positively, wholly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutely convergent</ns0:orth>
        <ns0:pron>/ˈæb.səˌlut.li kənˈvɚ.d͡ʒn̩t/</ns0:pron>
        <ns0:pron>/ˌæb.səˈlut.li kənˈvɚ.d͡ʒn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolutamente convergente</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolution</ns0:orth>
        <ns0:pron>/æb.səˈljuː.ʃn̩/</ns0:pron>
        <ns0:pron>/ˌæb.səˈl(j)u.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecclesiastical) An absolving of sins from ecclesiastical penalties by an authority. [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The form of words by which a penitent is absolved. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An absolving, or setting free from guilt, sin, or penalty; forgiveness of an offense. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(civil, _, legal, obsolete) An acquittal, or sentence of a judge declaring an accused person innocent. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutism</ns0:orth>
        <ns0:pron>/ˈæb.sə.ljuː.tɪz.m̩/</ns0:pron>
        <ns0:pron>/ˈæb.sə.luː.tɪz.m̩/</ns0:pron>
        <ns0:pron>/ˈæb.səˌljuˌtɪz.m̩/</ns0:pron>
        <ns0:pron>/ˈæb.səˌluˌtɪz.m̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolutismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(political science, sociology) The principles or practice of absolute or arbitrary government; Synonym of despotism. [First attested in the early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutist</ns0:orth>
        <ns0:pron>/ˈæb.səˌljuː.tɪst/</ns0:pron>
        <ns0:pron>/ˈæb.səˌlu.tɪst/</ns0:pron>
        <ns0:pron>/ˈæb.səˌluː.tɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolutista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to absolutism; arbitrary; despotic; uncompromising. [from mid 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutist</ns0:orth>
        <ns0:pron>/ˈæb.səˌljuː.tɪst/</ns0:pron>
        <ns0:pron>/ˈæb.səˌlu.tɪst/</ns0:pron>
        <ns0:pron>/ˈæb.səˌluː.tɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolutista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is in favor of an absolute or autocratic government. [from mid 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutive case</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caso absolutivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammatical case) case used to indicate the patient or experiencer of a verb’s action. The absolutive case is used to mark the subject of an intransitive verb, as well as the object of a transitive verb (inasmuch as they are codified in the English nominative-accusative system). Some languages that employ the absolutive case include Abkhaz, Basque, Chechen, Dyirbal, Hindi, Inuktitut, Hiligaynon, and Yup'ik.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolutory</ns0:orth>
        <ns0:pron>/æbˈsɑl.jəˌtɔɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolutorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Serving to absolve; absolving; giving absolution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absolve</ns0:orth>
        <ns0:pron>/-ˈsɑlv/</ns0:pron>
        <ns0:pron>/-ˈsɔlv/</ns0:pron>
        <ns0:pron>/-ˈzɔlv/</ns0:pron>
        <ns0:pron>/æbˈzɑlv/</ns0:pron>
        <ns0:pron>/əbˈ-/</ns0:pron>
        <ns0:pron>/əbˈzɒlv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolver</ns0:quote>
          <ns0:quote>exculpar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To set free, release or discharge (from obligations, debts, responsibility etc.). [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolver</ns0:quote>
          <ns0:quote>exonerar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pronounce free from or give absolution for a penalty, blame, or guilt. [First attested in the mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorb</ns0:orth>
        <ns0:pron>/æbˈsɔɹb/</ns0:pron>
        <ns0:pron>/æbˈzɔɹb/</ns0:pron>
        <ns0:pron>/əbˈsɔɹb/</ns0:pron>
        <ns0:pron>/əbˈsɔːb/</ns0:pron>
        <ns0:pron>/əbˈzɔɹb/</ns0:pron>
        <ns0:pron>/əbˈzɔːb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorber</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To include so that it no longer has separate existence; to overwhelm; to cause to disappear as if by swallowing up; to incorporate; to assimilate; to take in and use up. [first attested c. 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To suck up; to drink in; to imbibe, like a sponge or as the lacteals of the body; to chemically take in. [first attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorbable</ns0:orth>
        <ns0:pron>/əbˈsɔɹb.ə.bl̩/</ns0:pron>
        <ns0:pron>/əbˈzɔɹb.ə.bl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorbible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being absorbed or swallowed up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorbed</ns0:orth>
        <ns0:pron>/æbˈsɔɹbd/</ns0:pron>
        <ns0:pron>/æbˈzɔɹbd/</ns0:pron>
        <ns0:pron>/əbˈsɔɹbd/</ns0:pron>
        <ns0:pron>/əbˈzɔɹbd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorto</ns0:quote>
          <ns0:quote>ensimismado</ns0:quote>
          <ns0:quote>absorbido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fully occupied with one's thoughts; engrossed. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorbido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That has been taken in, engulfed, imbibed, or assimilated. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorbency</ns0:orth>
        <ns0:pron>/æbˈsɔɹ.bn̩.si/</ns0:pron>
        <ns0:pron>/æbˈzɔɹ.bn̩.si/</ns0:pron>
        <ns0:pron>/əbˈsɔɹ.bn̩.si/</ns0:pron>
        <ns0:pron>/əbˈzɔɹ.bn̩.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorbencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being absorbent.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) The ratio of the absorbance or optical density of a substance to that of a similar body of pure solvent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorbent</ns0:orth>
        <ns0:pron>/æbˈsɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/æbˈzɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈsɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈsɔː.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈzɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈzɔː.bn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorbente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the ability or tendency to absorb; able to soak up liquid easily; absorptive. [First attested in the early 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorbent</ns0:orth>
        <ns0:pron>/æbˈsɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/æbˈzɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈsɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈsɔː.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈzɔɹ.bn̩t/</ns0:pron>
        <ns0:pron>/əbˈzɔː.bn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorbente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anything which absorbs. [First attested in the early 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorbing</ns0:orth>
        <ns0:pron>/æbˈsɔɹ.bɪŋ/</ns0:pron>
        <ns0:pron>/æbˈzɔɹ.bɪŋ/</ns0:pron>
        <ns0:pron>/əbˈsɔɹ.bɪŋ/</ns0:pron>
        <ns0:pron>/əbˈsɔː.bɪŋ/</ns0:pron>
        <ns0:pron>/əbˈzɔɹ.bɪŋ/</ns0:pron>
        <ns0:pron>/əbˈzɔː.bɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorbente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Engrossing, that sustains someone's interest. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorption</ns0:orth>
        <ns0:pron>/æbˈsɔɹp.ʃn̩/</ns0:pron>
        <ns0:pron>/æbˈzɔɹp.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈsɔɹp.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈsɔːp.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈzɔɹp.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈzɔːp.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absorción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of absorbing or of being absorbed as,</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physical chemistry, physics) the imbibing or reception by molecular or chemical action, of radiant energy; the process of being neutrons being absorbed by the nucleus; interception. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physiology) in living organisms, the process by which the materials of growth and nutrition are absorbed and conveyed to the tissues and organs; taking in by various means, such as by osmosis. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concentración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Entire engrossment or occupation of the mind. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorption spectroscopy</ns0:orth>
      </ns0:form>
