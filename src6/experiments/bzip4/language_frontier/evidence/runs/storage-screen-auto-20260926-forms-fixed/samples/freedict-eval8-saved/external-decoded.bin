          <ns0:quote>OACI</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Acronym of w:International Civil Aviation Organization, a United Nations agency headquartered in Montreal, Canada.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ICAO spelling alphabet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabeto radiofónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ICAO radiotelephony spelling alphabet of the International Civil Aviation Organization. This alphabet assigns names to letters of the alphabet for clearer enunciation (and for the same reason pronounces the numeral 9 as "niner"):</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
