      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoyo</ns0:quote>
          <ns0:quote>soporte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of a beam, column, or other device, carrying weight or load.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bearing</ns0:orth>
        <ns0:pron>/ˈbɛə̯ɹɪŋ/</ns0:pron>
        <ns0:pron>/ˈbɛɹɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cojinete</ns0:quote>
          <ns0:quote>rodamiento</ns0:quote>
          <ns0:quote>rumbo</ns0:quote>
          <ns0:quote>acimut</ns0:quote>
          <ns0:quote>balero</ns0:quote>
          <ns0:quote>balero de rodamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mechanical engineering) A mechanical device that supports another part or reduces friction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rumbo</ns0:quote>
          <ns0:quote>acimut</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(navigation, nautical) The horizontal angle between the direction of an object and another object, or between it and that of true north; a heading or direction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>importancia</ns0:quote>
          <ns0:quote>incumbencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relevance; a relationship or connection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportamiento</ns0:quote>
          <ns0:quote>comporte</ns0:quote>
          <ns0:quote>conducta</ns0:quote>
          <ns0:quote>porte</ns0:quote>
          <ns0:quote>proceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One's posture, demeanor, or manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bearish</ns0:orth>
