          <ns0:quote>Alemania Federal</ns0:quote>
          <ns0:quote>Alemania del Oeste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, 1949–1990) A former country in Central Europe, distinguished from the German Democratic Republic, commonly known as East Germany. Official name: Federal Republic of Germany.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
