      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benevolencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Disposition to do good.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benevolent</ns0:orth>
        <ns0:pron>/bəˈnɛvələnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benevolente</ns0:quote>
          <ns0:quote>benévolo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a disposition to do good.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benevolently</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benévolamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a benevolent manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benight</ns0:orth>
        <ns0:pron>/bə-/</ns0:pron>
        <ns0:pron>/bɪˈnaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oscurecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To darken; to shroud or obscure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benign</ns0:orth>
        <ns0:pron>/bɪˈnaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benigno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Kind; gentle; mild.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) Not posing any serious threat to health; not particularly aggressive or recurrent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
