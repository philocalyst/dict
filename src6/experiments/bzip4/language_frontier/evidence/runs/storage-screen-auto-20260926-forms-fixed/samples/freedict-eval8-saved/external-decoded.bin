        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arreglo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A particular way in which items are organized.</ns0:def>
        </ns0:sense>
        <ns0:sense>
