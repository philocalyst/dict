      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chuvasio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From, or pertaining to, Chuvashia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Chuvash</ns0:orth>
        <ns0:pron>/t͡ʃʊˈvɑːʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chuvasio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone from, or pertaining to Chuvashia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Chuvash</ns0:orth>
        <ns0:pron>/t͡ʃʊˈvɑːʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chuvasio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agglutinative language of the Bolgar branch of the Turkic language family and is spoken west of the Ural mountains in central Russia. Chuvash is the native language of the Chuvash people and an official language of Chuvashia. It is spoken by about two million people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
