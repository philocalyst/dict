      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>punta de flecha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The pointed part of an arrow (the weapon).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The pointed part of an arrow (the symbol).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrowroot</ns0:orth>
        <ns0:pron>/ˈæɹoʊˌɹut/</ns0:pron>
        <ns0:pron>/ˈæɹə(ʊ)ɹuːt/</ns0:pron>
        <ns0:pron>/ˈɛɹoʊˌɹut/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maranta</ns0:quote>
          <ns0:quote>sagú</ns0:quote>
          <ns0:quote>planta obediente</ns0:quote>
          <ns0:quote>guapo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) Maranta arundinacea from the Marantaceae family, a large perennial herb native to the Caribbean area with green leaves about 15 centimeters long. [from late 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almidón de guapo</ns0:quote>
          <ns0:quote>almidón de maranta</ns0:quote>
          <ns0:quote>almidón de planta obediente</ns0:quote>
          <ns0:quote>almidón de sagú</ns0:quote>
          <ns0:quote>sagú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A starchy substance obtained from the rhizomes of an arrowroot plant used as a thickener.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrowslit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspillera</ns0:quote>
          <ns0:quote>tronera</ns0:quote>
          <ns0:quote>ballestera</ns0:quote>
          <ns0:quote>buhedera</ns0:quote>
          <ns0:quote>saetera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A slit, as in a castle wall, through which arrows can be fired.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrowword</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autodefinido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A kind of crossword puzzle with the clues written in the grid, accompanied by arrows that indicate the position and direction of the answers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arroyo</ns0:orth>
        <ns0:pron>/əˈɹɔɪ.oʊ/</ns0:pron>
        <ns0:pron>/əˈɹɔɪ.əʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arroyo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dry creek or streambed, a gulch which temporarily or seasonally fills and flows (after sufficient rain).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any watercourse; any rivulet (whether it flows year-round or only seasonally).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsehole</ns0:orth>
        <ns0:pron>/ˈɑː(ɹ)s.hoʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gilipollas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Commonwealth, mildly, vulgar, offensive, or, derogatory) An inconsiderate, mean-spirited, or otherwise contemptible person. (Less offensive than fucker or cunt.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenal</ns0:orth>
        <ns0:pron>/ˈɐːsnəl/</ns0:pron>
        <ns0:pron>/ˈɐːsənəl/</ns0:pron>
        <ns0:pron>/ˈɑɹsnəl/</ns0:pron>
        <ns0:pron>/ˈɑɹsənəl/</ns0:pron>
        <ns0:pron>/ˈɑːsnəl/</ns0:pron>
        <ns0:pron>/ˈɑːsənəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arsenal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A military establishment for the storing, development, manufacturing, testing, or repairing of arms, ammunition, and other war materiel; an armoury.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A stock of weapons, especially all the weapons that a nation possesses.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A store or supply of anything.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenate</ns0:orth>
        <ns0:pron>/-nɪt/</ns0:pron>
        <ns0:pron>/ˈɑɹs(ə)ˌneɪt/</ns0:pron>
        <ns0:pron>/ˈɑɹsnət/</ns0:pron>
        <ns0:pron>/ˈɑɹsənət/</ns0:pron>
        <ns0:pron>/ˈɑːsneɪt/</ns0:pron>
        <ns0:pron>/ˈɑːsn̩eɪt/</ns0:pron>
        <ns0:pron>/ˈɑːsɪneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arseniato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any salt or ester of arsenic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenic</ns0:orth>
        <ns0:pron>/ɑɹˈsɛnɪk/</ns0:pron>
        <ns0:pron>/ɑː(ɹ)ˈsɛnɪk/</ns0:pron>
        <ns0:pron>/ˈɑɹsənɪk/</ns0:pron>
        <ns0:pron>/ˈɑː(ɹ).sə.nɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arsénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A toxic grey brittle nonmetallic chemical element (symbol As) with an atomic number of 33.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trióxido de arsénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Arsenic trioxide.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenic trioxide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trióxido de arsénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) An industrially important and highly toxic oxide of arsenic that occurs as the mineral claudetite; formula As2O3 (though in liquid, gaseous and some solid forms it has molecules of the form As4O6).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenical copper</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cobre arsenical</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenide</ns0:orth>
        <ns0:pron>/ˈaɹsəˌnaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arseniuro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ion that is an arsenic atom with three extra electrons and charge −3.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A compound with arsenic in oxidation state −3.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arseniferous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arsenífero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) Containing or producing arsenic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsenopyrite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arsenopirita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A silvery-grey ore of arsenic, a mixed arsenide and sulfide of iron, FeAsS.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsine</ns0:orth>
        <ns0:pron>/ˈɑː(ɹ)saɪn/</ns0:pron>
        <ns0:pron>/ˈɑː(ɹ)siːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arsina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound, uncountable) A compound of arsenic and hydrogen, AsH3, a colorless and exceedingly poisonous gas, having an odor like garlic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arson</ns0:orth>
        <ns0:pron>/ˈɑɹsən/</ns0:pron>
        <ns0:pron>/ˈɑːsən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>incendio provocado</ns0:quote>
          <ns0:quote>delito de incendio</ns0:quote>
          <ns0:quote>incendio premeditado</ns0:quote>
          <ns0:quote>crimen incendiario</ns0:quote>
          <ns0:quote>incendio criminal</ns0:quote>
          <ns0:quote>incendio intencional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The crime of deliberately starting a fire with intent to cause damage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arsonist</ns0:orth>
        <ns0:pron>/ˈɑɹsənəst/</ns0:pron>
        <ns0:pron>/ˈɑːsənɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>incendiario</ns0:quote>
          <ns0:quote>pirómano</ns0:quote>
          <ns0:quote>incendiaria</ns0:quote>
          <ns0:quote>pirómana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who has committed the act of arson, or illegally setting fire to property.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art</ns0:orth>
        <ns0:pron>/ɐːt/</ns0:pron>
        <ns0:pron>/ɑɹt/</ns0:pron>
        <ns0:pron>/ɑːt/</ns0:pron>
        <ns0:pron>[-tsʰ]</ns0:pron>
        <ns0:pron>[-ɻ-]</ns0:pron>
        <ns0:pron>[aːt]</ns0:pron>
        <ns0:pron>[äːt]</ns0:pron>
        <ns0:pron>[äˑɹt]</ns0:pron>
        <ns0:pron>[ɐɹt]</ns0:pron>
        <ns0:pron>[ɑːtʰ]</ns0:pron>
        <ns0:pron>[ɑːʔ]</ns0:pron>
        <ns0:pron>[ɑˑɻt]</ns0:pron>
        <ns0:pron>[ɑ̈ɹt]</ns0:pron>
        <ns0:pron>[ɒət]</ns0:pron>
        <ns0:pron>[ɒɹt]</ns0:pron>
        <ns0:pron>[ɒːt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The conscious production or arrangement of sounds, colours, forms, movements, or other elements in a manner that affects the senses and emotions, usually specifically the production of the beautiful in a graphic or plastic medium.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Skillful creative activity, usually with an aesthetic focus.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The study and the product of these processes.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) Aesthetic value.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) Artwork.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A field or category of art, such as painting, sculpture, music, ballet, or literature.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Skill that is attained by study, practice, or observation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, dated) Contrivance, scheming, manipulation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art dealer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>marchante</ns0:quote>
          <ns0:quote>marchante de arte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(This entry is a translation hub.) A person who buys and sells works of art</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art for art's sake</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arte por el arte</ns0:quote>
          <ns0:quote>el arte por el arte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(arts, slogan) Art with no function; whose only purpose is beauty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art gallery</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>galería de arte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A room, a group of rooms, or other space where works of art are placed on display, possibly for sale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art historian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>historiador del arte</ns0:quote>
          <ns0:quote>historiadora del arte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expert in art history.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art of war</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arte de la guerra</ns0:quote>
          <ns0:quote>guerrería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The numerous strategies and tactics available to military leaders during combat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>art therapy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arteterapia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The use of creative activities related to the visual arts to improve physical, mental, emotional, or spiritual well-being.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artemisia</ns0:orth>
        <ns0:pron>/ˌɑɹ.təˈmɪ.zi.ə/</ns0:pron>
        <ns0:pron>/ˌɑː.tɪˈmɪ.zɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altamisa</ns0:quote>
          <ns0:quote>artemisa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of many aromatic flowering plants of the genus Artemisia, including wormwood, sagebrush, and tarragon, often used as traditional medicine, oral contraceptive and flavoring.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artemisinin</ns0:orth>
        <ns0:pron>/ˌɑɹ.təˈmɪs.n̩.ɪn/</ns0:pron>
        <ns0:pron>/ˌɑː.tɪˈmiː.sɪn.ɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artemisina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound, pharmaceutical drug) An antimalarial drug derived from the sweet wormwood shrub, Artemisia annua, found as the active ingredient in traditional Chinese medical herbal treatment for malaria, chemically a sesquiterpene lactone - C15H22O5.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arterial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arterial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to an artery.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arterial road</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calle arterial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A major thoroughfare, particularly one used to provide a large capacity for travelling some distance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arteriosclerosis</ns0:orth>
        <ns0:pron>/ɑɹˌtɪɹioʊskləˈroʊsəs/</ns0:pron>
        <ns0:pron>/ɑːˌtɪəɹɪəʊskləˈrəʊsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arteriosclerosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Hardening, narrowing or loss of elasticity in arteries or blood vessels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arteritis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arteritis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The inflammation of arterial walls, often due to infection or an autoimmune response.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artery</ns0:orth>
        <ns0:pron>/ˈɑɹ.təɹ.i/</ns0:pron>
        <ns0:pron>/ˈɑː.tə.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arteria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Any of the muscular- and elastic-walled blood vessels forming part of the circulation system by which blood is conveyed away from the heart regardless of its oxygenation status; see pulmonary artery.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transport) A major transit corridor in a system of roads, rivers, or railway lines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artesian</ns0:orth>
        <ns0:pron>/ɑɹˈtiʒən/</ns0:pron>
        <ns0:pron>/ɑːˈtiːʒən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artesiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a water supply) Rising to the surface under its own hydrostatic pressure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artesian well</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pozo artesiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An aquifer in which water rises to the surface under its own hydrostatic pressure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artful</ns0:orth>
        <ns0:pron>/ˈɑɹtf(ə)l/</ns0:pron>
        <ns0:pron>/ˈɑːtf(ʊ)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diestro</ns0:quote>
          <ns0:quote>habiloso</ns0:quote>
          <ns0:quote>hábil</ns0:quote>
          <ns0:quote>ingenioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Exhibiting or using much art or skill; dexterous; skilful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artero</ns0:quote>
          <ns0:quote>astuto</ns0:quote>
          <ns0:quote>ladino</ns0:quote>
          <ns0:quote>taimado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(especially) Skilful at using dishonest or unfair means to achieve a purpose; crafty, cunning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artfully</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con arte</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthritic</ns0:orth>
        <ns0:pron>/ɑː(ɹ)θˈɹɪtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Of, or affected by arthritis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthritis</ns0:orth>
        <ns0:pron>/aːˈθɹ(ɑ)ɪtɪs/</ns0:pron>
        <ns0:pron>/ɐːˈθɹ(ɑ)ɪtɪs/</ns0:pron>
        <ns0:pron>/ɑɹˈθɹ(a)ɪtɪs/</ns0:pron>
        <ns0:pron>/ɑːˈθɹ(a)ɪtɪs/</ns0:pron>
        <ns0:pron>[ɑɹˈθɹ(a)ɪɾɪs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artritis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Inflammation of a joint or joints causing pain and/or disability, swelling and stiffness, and due to various causes such as infection, trauma, degenerative changes or metabolic disorders: any of several disease entities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthro-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artro-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, medicine) articulation = joint (as for example in arthroplasty#Noun).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthrocentesis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrocentesis</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthrodesis</ns0:orth>
        <ns0:pron>/aɹθˈɹɒdɪsɪs/</ns0:pron>
        <ns0:pron>/ˌaɹθɹoʊˈdiːsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrodesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, surgery) The surgical fusion of a joint between two or more bones so that the joint can no longer move; artificial ankylosis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthrogryposis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrogriposis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, teratology) The permanent fixation of a joint in a contracted position.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthrology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The branch of anatomy dealing with the joints</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthrometer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A device for measuring the arc or range of mobility of a joint.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthropathy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artropatía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Any of several diseases of a joint.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthroplasty</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artroplastia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) The surgical repair of a joint, or creation of an artificial joint, such as a hip replacement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthropod</ns0:orth>
        <ns0:pron>/ˈɑːθɹəpɒd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artrópodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An invertebrate animal of the phylum Arthropoda, characterized by a chitinous exoskeleton and multiple jointed appendages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthroscope</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artroscopio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A form of endoscope used in arthroscopy</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthroscopic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artroscópico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Of or pertaining to arthroscopy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arthroscopy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artroscopia</ns0:quote>
          <ns0:quote>artroscopía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the examination of the interior of a joint (such as the knee) using an arthroscope</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artichoke</ns0:orth>
        <ns0:pron>/ˈɑɹ.tɪˌtʃoʊk/</ns0:pron>
        <ns0:pron>/ˈɑː.tɪˌtʃəʊk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcachofa</ns0:quote>
          <ns0:quote>alcachofera</ns0:quote>
          <ns0:quote>alcaucil</ns0:quote>
          <ns0:quote>arcacil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A plant related to the thistle with enlarged flower heads eaten as a vegetable while immature, Cynara cardunculus var. scolymus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artichoke bottom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondo de alcachofa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The edible fleshy receptacle at the bottom of an artichoke flower.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>article</ns0:orth>
        <ns0:pron>/ˈɑɹtəkl̩/</ns0:pron>
        <ns0:pron>/ˈɑɹtɪkəl/</ns0:pron>
        <ns0:pron>/ˈɑːtɪkl̩/</ns0:pron>
        <ns0:pron>[ˈɑ(ː)ɹɾɨkɫ̩]</ns0:pron>
        <ns0:pron>[ˈɑːtʰɪkʰəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artículo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A piece of nonfiction writing such as a story, report, opinion piece, or entry in a newspaper, magazine, journal, encyclopedia, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An object, a member of a group or class.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) A part of speech that indicates, specifies and limits a noun (a, an, or the in English). In some languages the article may appear as an ending (e.g. definite article in Swedish) or there may be none (e.g. Russian, Pashto).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A section of a legal document, bylaws, etc. or, in the plural, the entire document seen as a collection of these.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articled clerk</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) An apprentice in law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articular</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Of, at, or relating to the joints of the body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulate</ns0:orth>
        <ns0:pron>/ɑː(ɹ)ˈtɪk.jʊ.leɪt/</ns0:pron>
        <ns0:pron>/ɑː(ɹ)ˈtɪk.jʊ.lət/</ns0:pron>
        <ns0:pron>/ɑːɹˈtɪk.jə.leɪt/</ns0:pron>
        <ns0:pron>/ɑːɹˈtɪk.jə.lət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>claro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Clear; effective.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>elocuente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Speaking in a clear and effective manner; having both good articulation and good elocution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articulado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Expressed in articles or in separate items or particulars.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulate</ns0:orth>
        <ns0:pron>/ɑː(ɹ)ˈtɪk.jʊ.leɪt/</ns0:pron>
        <ns0:pron>/ɑː(ɹ)ˈtɪk.jʊ.lət/</ns0:pron>
        <ns0:pron>/ɑːɹˈtɪk.jə.leɪt/</ns0:pron>
        <ns0:pron>/ɑːɹˈtɪk.jə.lət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articular</ns0:quote>
          <ns0:quote>vocalizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To speak clearly; to enunciate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articularse</ns0:quote>
          <ns0:quote>articular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, intransitive) To form a joint or connect by joints.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulated bus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autobús articulado</ns0:quote>
          <ns0:quote>autobús oruga</ns0:quote>
          <ns0:quote>bus articulado</ns0:quote>
          <ns0:quote>bus oruga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bus fitted with a joint, which is covered by an accordion-shaped weatherproofing, to increase its manoeuvrability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulately</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articuladamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an articulate manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulateness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>elocuencia</ns0:quote>
          <ns0:quote>fluidez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being articulate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulation</ns0:orth>
        <ns0:pron>/ɑɹˌtɪk.jəˈleɪ.ʃən/</ns0:pron>
        <ns0:pron>/ɑːˌtɪk.jəˈleɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, or, uncountable) A joint or the collection of joints at which something is articulated, or hinged, for bending.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A manner or method by which elements of a system are connected.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articulación</ns0:quote>
          <ns0:quote>pronunciación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality, clarity, or sharpness of speech; the movement within the mouth that allows for those things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articulador</ns0:quote>
          <ns0:quote>articulativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Serving to articulate or express something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>articulatory</ns0:orth>
        <ns0:pron>/ɑː(ɹ)ˈtɪk.jə.lə.t(ə.)ɹɪ/</ns0:pron>
        <ns0:pron>/ɑːɹˈtɪk.jə.ləˌtɔɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>articulatorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonology) Of or pertaining to articulation; phonetic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artifact</ns0:orth>
        <ns0:pron>/ˈɑɹtɪfækt/</ns0:pron>
        <ns0:pron>/ˈɑːtɪfækt/</ns0:pron>
        <ns0:pron>[-ɾə-]</ns0:pron>
        <ns0:pron>[-ɾɪ-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artefacto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An object made or shaped by human hand or labor.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Something viewed as a product of human agency or conception rather than an inherent element.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A finding or structure in an experiment or investigation that is not a true feature of the object under observation, but is a result of external action, the test arrangement, or an experimental error.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(archaeology) An object, such as a tool, ornament, or weapon of archaeological or historical interest, especially such an object found at an archaeological excavation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(software engineering) Ellipsis of build artifact.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artifice</ns0:orth>
        <ns0:pron>/ˈɑː(ɹ)tɪfɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artificio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A crafty but underhanded deception.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificer</ns0:orth>
        <ns0:pron>/ɑɹtɪˈfɪsɚ/&lt;a:US&gt;</ns0:pron>
        <ns0:pron>/ɑɹˈtɪfəsɚ/&lt;a:US&gt;</ns0:pron>
        <ns0:pron>/ɑːˈtɪfɪsə/&lt;a:UK&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artífice</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>armero</ns0:quote>
          <ns0:quote>artificiero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the military who specializes in manufacturing and repairing weapon systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificial</ns0:orth>
        <ns0:pron>/ˌɑː(ɹ).təˈfɪʃ.əl/</ns0:pron>
        <ns0:pron>[ˌɑːtɪˈfɪʃl]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artificial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Man-made; made by humans; of artifice.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Not natural or normal: imposed arbitrarily or without regard to the specifics or normal circumstances of a person, a situation, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(taxonomy) Based on characteristics useful for identification, without regard for the formal differences used in classification.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(bridge) Conveying some meaning other than the actual contents of one's hand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificial insemination</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inseminación artificial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, medicine) The introduction of semen into the uterus or cervix of a female by a means other than copulation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificial intelligence</ns0:orth>
        <ns0:pron>/ˌaɹ.təˈfɪʃ.əl ɪnˈtɛl.ə.d͡ʒəns/</ns0:pron>
        <ns0:pron>/ˌaːʳ.ʈiˈfɪʃ.al ɪnˈʈɛl.i.d͡ʒens/</ns0:pron>
        <ns0:pron>/ˌɐː.təˈfəʃ.əl ənˈtel.ə.d͡ʒəns/</ns0:pron>
        <ns0:pron>/ˌɐː.təˈfɪʃ.əl ɪnˈtel.ə.d͡ʒəns/</ns0:pron>
        <ns0:pron>/ˌɑɹ.təˈfɪʃ.əl ɪnˈtɛl.ə.d͡ʒəns/</ns0:pron>
        <ns0:pron>/ˌɑː.təˈfɪʃ.əl ɪnˈtɛl.ə.d͡ʒəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inteligencia artificial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Intelligence exhibited by an artificial (nonnatural, humanmade) entity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computer science) The branch of computer science dealing with the reproduction or mimicking of human-level intelligence, self-awareness, knowledge, conscience, and thought in computer programs.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The essential quality of a machine which thinks in a manner similar to or on the same general level as a real human being.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificial selection</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>selección artificial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(evolutionary theory) Intervention by humans in the breeding of plants or animals in order to preserve selected genetic traits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificial tear</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lágrima artificial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lubricant eyedrops used to treat the dryness and irritation associated with deficient tear production in keratoconjunctivitis sicca.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificial turf</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>césped artificial</ns0:quote>
          <ns0:quote>césped sintético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An artificial grass surface made to resemble real grass, often used for sports fields.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artificially</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artificialmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an artificial manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artillery</ns0:orth>
        <ns0:pron>/ɑɹˈtɪləɹi/</ns0:pron>
        <ns0:pron>/ɑːˈtɪləɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artillería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An army unit that uses such weapons, or a military formation using projectile weapons, such as archers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artilleryman</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artillero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) A soldier enlisted in an artillery unit or who uses artillery.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artisan</ns0:orth>
        <ns0:pron>/ˈɑɹtɪsən/</ns0:pron>
        <ns0:pron>/ˈɑɹtɪzən/</ns0:pron>
        <ns0:pron>/ˈɑː(ɹ)tɪzæn/</ns0:pron>
        <ns0:pron>/ˈɑː(ɹ)tɪzən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artesano</ns0:quote>
          <ns0:quote>menestral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A skilled manual worker who uses tools and machinery in a particular craft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artisanally</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artesanalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an artisanal manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artist</ns0:orth>
        <ns0:pron>/ˈɑɹ.tɪst/</ns0:pron>
        <ns0:pron>/ˈɑːtɪst/</ns0:pron>
        <ns0:pron>[ˈɑɹ.ɾɪst]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who creates art as an occupation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person who creates art.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(often, in combination) A person who is skilled at some activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artistic</ns0:orth>
        <ns0:pron>/ɑɹˈtɪstɪk/</ns0:pron>
        <ns0:pron>/ɑːˈtɪstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having or revealing creative skill.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Relating to or characteristic of art or artists.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Aesthetically pleasing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artistic licence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>licencia artística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any departure from convention or from factual accuracy taken by an artist to achieve a desired effect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artistically</ns0:orth>
        <ns0:pron>/ɑː(ɹ)ˈtɪstɪkli/</ns0:pron>
        <ns0:pron>/ɑː(ɹ)ˈtɪstɪkəli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>artísticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an artistic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artless</ns0:orth>
        <ns0:pron>/ˈɑɹt.lɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cándido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having or displaying no guile, cunning, or deceit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>natural</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Free of artificiality; natural.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artlessness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>candidez</ns0:quote>
          <ns0:quote>ingenuidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the state or quality of being artless</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inocencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the state or quality of being innocent; naïveté</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arts and crafts</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manualidades</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>All the handicrafts based upon making decorative and useful things manually.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>artwork</ns0:orth>
        <ns0:pron>/ˈɑɹtˌwɝk/</ns0:pron>
        <ns0:pron>/ˈɑːtˌwɜːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>obra de arte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A painting, drawing, sculpture or other piece of creative, visual art.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arty</ns0:orth>
        <ns0:pron>/ˈɑː(ɹ)ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pretenciosamente artístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, derogatory) Pretending to artistic worth; high-flown.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arugula</ns0:orth>
        <ns0:pron>/əˈɹuɡələ/</ns0:pron>
        <ns0:pron>/əˈɹʊɡələ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rúcula</ns0:quote>
          <ns0:quote>oruga</ns0:quote>
          <ns0:quote>jaramago</ns0:quote>
          <ns0:quote>roqueta</ns0:quote>
          <ns0:quote>ruca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A yellowish-flowered Mediterranean herb of the mustard family with flavoured leaves, often eaten in salads, that has a distinct, peppery flavor, of three species:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arum</ns0:orth>
        <ns0:pron>/ˈɛ(ə)ɹəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aro</ns0:quote>
          <ns0:quote>sarrillo</ns0:quote>
          <ns0:quote>yaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A flower or plant in the genus Arum</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arum lily</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several flowering plants, of the family Araceae, but especially Zantedeschia aethiopica, the calla lily that has a showy white spathe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aryballos</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aríbalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small Ancient Greek flask used to hold perfume or oil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aryl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any univalent organic radical derived from an aromatic hydrocarbon by removing a hydrogen atom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arytenoid</ns0:orth>
        <ns0:pron>/əˈɹɪt.n̩ˌɔɪd/</ns0:pron>
        <ns0:pron>/ˌaɹ.ɪˈtiː.nɔɪd/</ns0:pron>
        <ns0:pron>/ˌæɹ.əˈtiˌnɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aritenoides</ns0:quote>
          <ns0:quote>cartílago aritenoides</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Ellipsis of arytenoid cartilage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arête</ns0:orth>
        <ns0:pron>/əˈɹeɪt/</ns0:pron>
        <ns0:pron>/əˈɹɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) A very thin ridge of rock.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as</ns0:orth>
        <ns0:pron>/æz/</ns0:pron>
        <ns0:pron>/əz/</ns0:pron>
        <ns0:pron>[az]</ns0:pron>
        <ns0:pron>[æz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>que</ns0:quote>
          <ns0:quote>al tiempo que</ns0:quote>
          <ns0:quote>igual de</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mientras</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>a medida en que</ns0:quote>
          <ns0:quote>as</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To such an extent or degree; to the same extent or degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>ya que</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
          <ns0:quote>debido a que</ns0:quote>
          <ns0:quote>a medida en que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Considered to be, in relation to something else; in the relation (specified).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>as</ns0:quote>
          <ns0:quote>cual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(formal, somewhat, dated) For example; for instance. (Compare such as.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as</ns0:orth>
        <ns0:pron>/æz/</ns0:pron>
        <ns0:pron>/əz/</ns0:pron>
        <ns0:pron>[az]</ns0:pron>
        <ns0:pron>[æz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>as</ns0:quote>
          <ns0:quote>cuan</ns0:quote>
          <ns0:quote>tan ... como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the (same) way or manner that; to the (same) degree that.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mientras</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>a medida en que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At the same time that, during the same time when: while.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya que</ns0:quote>
          <ns0:quote>como</ns0:quote>
          <ns0:quote>debido a que</ns0:quote>
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Being that, considering that, because, since.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>cual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Introducing a comparison with a hypothetical state (+ subjunctive, or with the verb elided): as though, as if. [to 19th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law) used before a preposition to clarify that the prepositional phrase restricts the meaning of the sentence; specifically.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as</ns0:orth>
        <ns0:pron>/ˈæs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>ya que</ns0:quote>
          <ns0:quote>debido a que</ns0:quote>
          <ns0:quote>cual</ns0:quote>
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(unit of weight) A libra.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>ya que</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>mientras</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(numismatics, Ancient Rome) Any of several coins of Rome, coined in bronze or later copper; or the equivalent value.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as</ns0:orth>
        <ns0:pron>/æz/</ns0:pron>
        <ns0:pron>/əz/</ns0:pron>
        <ns0:pron>[az]</ns0:pron>
        <ns0:pron>[æz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>ya que</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>mientras</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Introducing a basis of comparison, with an object in the objective case.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>mientras</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
          <ns0:quote>a medida en que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the role of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como</ns0:quote>
          <ns0:quote>mientras</ns0:quote>
          <ns0:quote>a medida que</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
          <ns0:quote>cuando</ns0:quote>
          <ns0:quote>a medida en que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the form of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as God intended</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como Dios manda</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as I live and breathe</ns0:orth>
        <ns0:pron>/æz aɪ lɪv ænd bɹið/</ns0:pron>
        <ns0:pron>/æz aɪ lɪv ænd bɹiːð/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en carne y hueso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Used to declare the truth of a statement with emphasis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como que vivo y respiro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Used to express surprise at an experience one is witnessing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as a consequence of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a consecuencia de</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as a matter of fact</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de hecho</ns0:quote>
          <ns0:quote>a decir verdad</ns0:quote>
          <ns0:quote>como cuestión de hecho</ns0:quote>
          <ns0:quote>como una cuestión de hecho</ns0:quote>
          <ns0:quote>en verdad</ns0:quote>
          <ns0:quote>por cierto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(adverbial) Actually, in fact.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as a result</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en consecuencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(conjunctive) Consequently; thus; therefore; hence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as a result of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como resultado de</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as a rule</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por regla general</ns0:quote>
          <ns0:quote>normalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In general; most often.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as a whole</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en conjunto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) Used to relate to all the parts of something: altogether, on the whole</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as above, so below</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como arriba, así abajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(occultism) What happens on a higher level of reality also happens on lower levels; the microcosm and macrocosm behave alike.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as far as</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hasta donde</ns0:quote>
          <ns0:quote>tan lejos como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To the degree or extent that.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(proscribed) Used without any completion, usually to imply "to the degree or extent that ... is/are concerned".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as far as</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con lo que respecta a</ns0:quote>
          <ns0:quote>en cuanto a</ns0:quote>
          <ns0:quote>en lo que respecta a</ns0:quote>
          <ns0:quote>en materia de</ns0:quote>
          <ns0:quote>por lo que respecta a</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as far as I'm concerned</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cuanto incumbe a mí</ns0:quote>
          <ns0:quote>en lo que me concierne</ns0:quote>
          <ns0:quote>hasta donde me atañe a mí</ns0:quote>
          <ns0:quote>hasta donde yo sé</ns0:quote>
          <ns0:quote>por lo que a mí respecta</ns0:quote>
          <ns0:quote>por mí</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as far as one knows</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a mi parecer</ns0:quote>
          <ns0:quote>hasta donde yo sé</ns0:quote>
          <ns0:quote>para mí</ns0:quote>
          <ns0:quote>por lo que sepa</ns0:quote>
          <ns0:quote>que yo sepa</ns0:quote>
          <ns0:quote>según creo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To the best of one's knowledge, as far as someone knows or possible information to be gathered about the topic, subject, aspect, or situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as far as the eye can see</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hasta donde alcanza la vista</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as follows</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como sigue</ns0:quote>
          <ns0:quote>así</ns0:quote>
          <ns0:quote>de la siguiente manera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the manner described hereafter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as for</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cuanto a</ns0:quote>
          <ns0:quote>en lo tocante a</ns0:quote>
          <ns0:quote>para</ns0:quote>
          <ns0:quote>respecto a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Regarding; about; concerning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as fuck</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>del culo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(postpositive, slang, vulgar, simile) To a great extent or degree; very, extremely, incredibly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as if</ns0:orth>
        <ns0:pron>/əz‿ˈɪf/</ns0:pron>
        <ns0:pron>/ˌæz‿ˈɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como si</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As though; in a manner suggesting.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>In mimicry of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as if</ns0:orth>
        <ns0:pron>/əz‿ˈɪf/</ns0:pron>
        <ns0:pron>/ˌæz‿ˈɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómo no</ns0:quote>
          <ns0:quote>sí cómo no</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Indicates that the speaker deems something highly unlikely.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as if by magic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por arte de magia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a very surprising or seemingly impossible way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as if there were no tomorrow</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como si no hubiera un mañana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To an excessive degree, oftentimes with little to no regard to future consequences; desperately; recklessly or wantonly; frantically; very quickly or very much.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as in</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>es decir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, conjunctive) In the sense of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as is</ns0:orth>
        <ns0:pron>/æzˈɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tal cual</ns0:quote>
          <ns0:quote>como está</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, of an object) as it is; in its present state or condition, especially as a contractual condition of sale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as it happens</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin ir más lejos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) By coincidence, incidentally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as it is</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tal cual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the actual circumstances (and often contrary to expectations).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as it stands</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como están las cosas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the current state or circumstance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as it were</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>digamos</ns0:quote>
          <ns0:quote>por así decirlo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to indicate that a word or statement is perhaps not exact though practically right; as if it were so.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as long as</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con tal que</ns0:quote>
          <ns0:quote>siempre y cuando</ns0:quote>
          <ns0:quote>con tal de que</ns0:quote>
          <ns0:quote>siempre que</ns0:quote>
          <ns0:quote>tanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Provided that, if, assuming (depending upon some condition or requirement).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mientras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) For the entire duration that; while; since.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as much as</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>igual que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to say that two things are equal in amount or degree</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tanto como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to say that an amount is as large as another amount</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aunque más</ns0:quote>
          <ns0:quote>por mucho que</ns0:quote>
          <ns0:quote>por más que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Even though; despite the fact that; much as.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as much as possible</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo lo posible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As much as is possible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a partir de</ns0:quote>
          <ns0:quote>desde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) At or by a specified time, with the implication that the said condition will be true from that time onward.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as one man</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como un solo hombre</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as opposed to</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a diferencia de</ns0:quote>
          <ns0:quote>en contraposición a</ns0:quote>
          <ns0:quote>en oposición a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>in contrast to, rather than, instead of; particularly used in defining a concept by providing an example that does not fall inside the concept.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as per</ns0:orth>
        <ns0:pron>/ˌæz ˈpɜː/</ns0:pron>
        <ns0:pron>/ˌæz ˈpɝ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acorde a</ns0:quote>
          <ns0:quote>conforme</ns0:quote>
          <ns0:quote>conformemente</ns0:quote>
          <ns0:quote>de acuerdo</ns0:quote>
          <ns0:quote>según</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as quickly as possible</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo más rápido posible</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as regards</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cuanto a</ns0:quote>
          <ns0:quote>en lo tocante a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>regarding, concerning</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as soon as</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cuanto</ns0:quote>
          <ns0:quote>tan pronto como</ns0:quote>
          <ns0:quote>apenas</ns0:quote>
          <ns0:quote>ni bien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At the moment when; immediately (after); instantly; directly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as soon as possible</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuanto antes</ns0:quote>
          <ns0:quote>lo antes posible</ns0:quote>
          <ns0:quote>a la brevedad</ns0:quote>
          <ns0:quote>a la mayor brevedad</ns0:quote>
          <ns0:quote>lo más rápido posible</ns0:quote>
          <ns0:quote>tan pronto como sea posible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As soon as is possible; at one's earliest convenience; at the earliest possible time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as such</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como tal</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as the crow flies</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a vuelo de pájaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In a straight line distance between two locations, as opposed to the road distance or over land distance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as the saying goes</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como dice el dicho</ns0:quote>
          <ns0:quote>es un decir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used before or after saying an apt proverb, adage, cliché etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as though</ns0:orth>
        <ns0:pron>/əzˈðəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como si</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As to suggest the idea that; as if, as would be true if.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as to</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cuanto a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>With reference or regard to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cuanto a</ns0:quote>
          <ns0:quote>según</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>According to; in a manner conforming or corresponding to; in proportion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as usual</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como de costumbre</ns0:quote>
          <ns0:quote>como es habitual</ns0:quote>
          <ns0:quote>como es usual</ns0:quote>
          <ns0:quote>como siempre</ns0:quote>
          <ns0:quote>para variar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As is usually the case.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as well</ns0:orth>
        <ns0:pron>/æzwɛl/</ns0:pron>
        <ns0:pron>/æzˈwɛl/</ns0:pron>
        <ns0:pron>/əzˈwɛl/</ns0:pron>
        <ns0:pron>[æˑzˈwɛːɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>también</ns0:quote>
          <ns0:quote>además</ns0:quote>
          <ns0:quote>ansimismo</ns0:quote>
          <ns0:quote>asimismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In addition; also.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as well as</ns0:orth>
        <ns0:pron>/əz ˈwɛl æz/</ns0:pron>
        <ns0:pron>/əz ˈwɛl əz/</ns0:pron>
        <ns0:pron>/əˈzwɛlz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>así como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>And, in addition; not forgetting</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as well as</ns0:orth>
        <ns0:pron>/əz ˈwɛl æz/</ns0:pron>
        <ns0:pron>/əz ˈwɛl əz/</ns0:pron>
        <ns0:pron>/əˈzwɛlz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>así como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In addition to; further to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as yet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aún</ns0:quote>
          <ns0:quote>hasta ahora</ns0:quote>
          <ns0:quote>hasta la fecha</ns0:quote>
          <ns0:quote>todavía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Up to the present.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as you know</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como ustedes saben</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) as it is already known.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as you like</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como quieras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Expressing unenthusiastic consent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as you sow, so shall you reap</ns0:orth>
        <ns0:pron>/əz‿ju ˈsoʊ soʊ‿ʃəl‿ju ˈɹip/</ns0:pron>
        <ns0:pron>/əz‿ju ˈsəʊ səʊ‿ʃəl‿ju ˈɹiːp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo que siembras, cosechas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The consequences of one's actions to oneself are in proportion to one's good or bad intentions towards others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>as you wish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como desee</ns0:quote>
          <ns0:quote>como quiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A formal expression of agreement to something, especially with the connotation that one does not really agree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asafoetida</ns0:orth>
        <ns0:pron>/ˌæsəˈfɛtɪdə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asafétida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A resinous gum from the stem and roots of Ferula species such as Ferula foetida and Ferula assa-foetida, having a strong, unpleasant smell, with culinary and medical uses. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asana</ns0:orth>
        <ns0:pron>/ˈɑːsənə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A body position, typically associated with the practice of yoga.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asbestos</ns0:orth>
        <ns0:pron>/æsˈbɛs.tɒs/</ns0:pron>
        <ns0:pron>/æsˈbɛs.təs/</ns0:pron>
        <ns0:pron>/æzˈbɛs.təs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asbesto</ns0:quote>
          <ns0:quote>amianto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) Any of several fibrous mineral forms of magnesium silicate, used for fireproofing, electrical insulation, building materials, brake linings, chemical filters, suits, fireman's gloves, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asbestosis</ns0:orth>
        <ns0:pron>/ˈæs.bɛsˌtəʊ.sɪs/</ns0:pron>
        <ns0:pron>/ˌæs.bɛsˈtoʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asbestosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A chronic, inflammatory lung disease caused by long-term, heavy exposure to asbestos.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascaridole</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascaridol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A bicyclic monoterpene peroxide found in plants of the Chenopodium genus; it is explosive</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascend</ns0:orth>
        <ns0:pron>/əˈsɛnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascender</ns0:quote>
          <ns0:quote>subir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To move upward, to fly, to soar.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To slope in an upward direction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascendancy</ns0:orth>
        <ns0:pron>/əˈsɛndənsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascendencia</ns0:quote>
          <ns0:quote>ascendiente</ns0:quote>
          <ns0:quote>influencia</ns0:quote>
          <ns0:quote>predominio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being in the ascendant; dominant control, supremacy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascension</ns0:orth>
        <ns0:pron>/əˈsɛnʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascensión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of ascending; an ascent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascent</ns0:orth>
        <ns0:pron>/əˈsent/</ns0:pron>
        <ns0:pron>/əˈsɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascenso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of ascending; a motion upwards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>elevación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An eminence, hill, or high place.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The degree of elevation of an object, or the angle it makes with a horizontal line; inclination; gradient; steepness</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascertain</ns0:orth>
        <ns0:pron>/ˌæsəˈteɪn/</ns0:pron>
        <ns0:pron>/ˌæsəˈtæɪn/</ns0:pron>
        <ns0:pron>/ˌæsɚˈteɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acertar</ns0:quote>
          <ns0:quote>averiguar</ns0:quote>
          <ns0:quote>definir</ns0:quote>
          <ns0:quote>determinar</ns0:quote>
          <ns0:quote>establecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To find out definitely; to discover or establish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascertainable</ns0:orth>
        <ns0:pron>/ˌæsəˈteɪnəbl̩/</ns0:pron>
        <ns0:pron>/ˌæsɚˈteɪnəbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>averiguable</ns0:quote>
          <ns0:quote>determinable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be ascertained.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascetic</ns0:orth>
        <ns0:pron>/əˈsɛ.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to ascetics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascetic</ns0:orth>
        <ns0:pron>/əˈsɛ.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asceta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is devoted to the practice of self-denial, either through seclusion or stringent abstinence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asceticism</ns0:orth>
        <ns0:pron>/əˈsɛt.əˌsɪz.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascetismo</ns0:quote>
          <ns0:quote>ascética</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The principles and practices of an ascetic; extreme self-denial and austerity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascidian</ns0:orth>
        <ns0:pron>/əˈsɪdi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascidia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any member of the class Ascidiacea (the sea squirts)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascites</ns0:orth>
        <ns0:pron>/əˈsaɪtiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascitis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) An accumulation of fluid in the peritoneal cavity, frequently symptomatic of liver disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascocarp</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascocarpo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mycology) The sporocarp of an ascomycete, typically bowl-shaped.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascomycete</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascomiceto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mycology) Any fungus of the phylum Ascomycota, characterized by the production of a sac, or ascus, which contains non-motile spores.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascorbate</ns0:orth>
        <ns0:pron>/əsˈkɔː(ɹ)beɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascorbato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any salt or ester of ascorbic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascorbic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascórbico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to ascorbic acid or its derivatives.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascorbic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido ascórbico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(vitamin) A white crystalline organic compound, C6H8O6, found in citrus fruits and many vegetables; it is an antioxidant and an efficient scavenger of free radicals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascribable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atribuible</ns0:quote>
          <ns0:quote>imputable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be ascribed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascribe</ns0:orth>
        <ns0:pron>/əˈskɹaɪb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atribuir</ns0:quote>
          <ns0:quote>adscribir</ns0:quote>
          <ns0:quote>arrogar</ns0:quote>
          <ns0:quote>imputar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attribute (a cause or characteristic) to someone or something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atribuir</ns0:quote>
          <ns0:quote>adscribir</ns0:quote>
          <ns0:quote>arrogar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attribute (a book, painting, or any other work of art or literature) to a writer or creator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascription</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adscripción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act, or an instance, of ascribing a quality, characteristic, quotation, artistic work, or other thing to someone or something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ascriptive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adscriptivo</ns0:quote>
          <ns0:quote>adscripto</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aseity</ns0:orth>
        <ns0:pron>/əˈsiː.ɪ.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aseidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metaphysics, theology) Usually ascribed to deity: the attribute of being entirely self-derived, in contrast to being derived from or dependent on another; the quality of having within oneself the entire reason for one's being; utter independent self-existence and self-sustenance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aseptic</ns0:orth>
        <ns0:pron>/əˈsɛptɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aséptico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Free of disease-causing microbes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asexual</ns0:orth>
        <ns0:pron>/eɪˈsɛk.sjuː.əl/</ns0:pron>
        <ns0:pron>/eɪˈsɛk.ʃu.əl/</ns0:pron>
        <ns0:pron>/eɪˈsɛk.ʃuː.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asexual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(especially, of a person) Not experiencing sexual attraction; lacking interest in or desire for sex.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology) Without sexual action; reproducing by some other method than sex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asexual</ns0:orth>
        <ns0:pron>/eɪˈsɛk.sjuː.əl/</ns0:pron>
        <ns0:pron>/eɪˈsɛk.ʃu.əl/</ns0:pron>
        <ns0:pron>/eɪˈsɛk.ʃuː.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asexual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who does not experience sexual attraction; a person who lacks interest in or desire for sex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asexual reproduction</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reproducción asexual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any form of reproduction that involves neither meiosis nor fusion of gametes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asexuality</ns0:orth>
        <ns0:pron>/ˌeɪ.sɛk.sjuːˈæ.lɪ.ti/</ns0:pron>
        <ns0:pron>/ˌeɪ.sɛk.ʃuˈæ.lə.ti/</ns0:pron>
        <ns0:pron>/ˌeɪ.sɛk.ʃuːˈæ.lɪ.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asexualidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of experiencing little or no sexual attraction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asexually</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asexualmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an asexual manner; without having sex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ash</ns0:orth>
        <ns0:pron>/æʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fresno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The wood of this tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ceniza</ns0:quote>
          <ns0:quote>favila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gray color, similar to that of the remains of a fire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ash grove</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fresneda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ash tree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fresno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tree of the genus Fraxinus, with compound leaves and a tough, flexible wood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashamed</ns0:orth>
        <ns0:pron>/əˈʃeɪmd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avergonzado</ns0:quote>
          <ns0:quote>apenado</ns0:quote>
          <ns0:quote>abochornado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, of someone in trouble and undergoing punishment for doing something wrong) Feeling shame or guilt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashen</ns0:orth>
        <ns0:pron>/ˈæʃ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ceniciento</ns0:quote>
          <ns0:quote>pálido</ns0:quote>
          <ns0:quote>lívido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ash-colored; pale; anemic</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashlar</ns0:orth>
        <ns0:pron>/ˈæʃlə/</ns0:pron>
        <ns0:pron>/ˈæʃlɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sillar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, historical) A stone intended for hurling by means of a catapult or similar device.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashore</ns0:orth>
        <ns0:pron>/əˈʃo(ː)ɹ/</ns0:pron>
        <ns0:pron>/əˈʃoə/</ns0:pron>
        <ns0:pron>/əˈʃɔɹ/</ns0:pron>
        <ns0:pron>/əˈʃɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en tierra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) On the land as opposed to onboard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashtray</ns0:orth>
        <ns0:pron>/ˈæʃ.tɹeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cenicero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A receptacle for ash and butts from cigarettes and cigars.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashy</ns0:orth>
        <ns0:pron>/ˈæʃi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ceniciento</ns0:quote>
          <ns0:quote>cinéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resembling ashes (especially in colour); (of a person’s complexion) unusually pale as a result of strong emotion, illness, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ashy-headed goose</ns0:orth>
        <ns0:pron>/ˈæ.ʃi ˈhɛ.dəd ˈɡus/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cauquén cabecigrís</ns0:quote>
          <ns0:quote>cauquén cabeza gris</ns0:quote>
          <ns0:quote>cauquén real</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the species Chloephaga poliocephala of waterfowl of southern Chile and Argentina, which have gray heads and orange forebodies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aside</ns0:orth>
        <ns0:pron>/əˈsaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a un lado</ns0:quote>
          <ns0:quote>aparte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To or on one side so as to be out of the way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aside</ns0:orth>
        <ns0:pron>/əˈsaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An incidental remark to a person next to one made discreetly but not in private, audible only to that person. (theatre) A brief comment by a character addressing the audience, unheard by other characters.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aside from</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>excluding; with the exception of</ns0:def>
