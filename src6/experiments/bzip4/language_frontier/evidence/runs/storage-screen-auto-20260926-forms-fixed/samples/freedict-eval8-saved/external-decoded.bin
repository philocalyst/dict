      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Henoch</ns0:quote>
          <ns0:quote>Enoc</ns0:quote>
        </ns0:cit>
        <ns0:sense>
