      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>blanco roto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A creamy white colour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiquity</ns0:orth>
        <ns0:pron>/ænˈtɪk.wə.ti/</ns0:pron>
        <ns0:pron>/ænˈtɪk.wɪ.ti/</ns0:pron>
        <ns0:pron>/ˈaɳʈɪkwɪʈi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antigüedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ancient times; faraway history; former ages.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The people of ancient times.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(often, constructed as an uncountable plural) A relic or monument of ancient times, such as a coin, a statue, etc.; an ancient institution.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The state of being ancient or of ancient lineage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antirabies</ns0:orth>
