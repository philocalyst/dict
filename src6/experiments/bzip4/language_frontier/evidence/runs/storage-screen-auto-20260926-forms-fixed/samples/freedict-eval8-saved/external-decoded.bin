      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Raquel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) Younger daughter of Laban, sister to Leah, and second wife of Jacob.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
