    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Laozi</ns0:orth>
        <ns0:pron>/-zi/</ns0:pron>
        <ns0:pron>/-ziː/</ns0:pron>
        <ns0:pron>/ˈlaʊ.t͡sz̩/</ns0:pron>
        <ns0:pron>/ˈlaʊdzə/</ns0:pron>
        <ns0:pron>/ˈlaʊtzə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
