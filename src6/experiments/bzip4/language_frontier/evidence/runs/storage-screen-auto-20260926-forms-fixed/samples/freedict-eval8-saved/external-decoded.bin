      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arciforme</ns0:quote>
          <ns0:quote>arcuado</ns0:quote>
          <ns0:quote>arcuato</ns0:quote>
          <ns0:quote>arqueado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>curved into the shape of a bow.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
