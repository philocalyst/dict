      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>peronista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A supporter of Juan Perón and/or Eva Perón and/or their regime.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An adherent of modern-day Peronism, including any of the political parties that identify themselves as such.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
