      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nejapa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town in San Salvador department, El Salvador.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nemean</ns0:orth>
        <ns0:pron>/nɪˈmiːən/</ns0:pron>
        <ns0:pron>/ˈnimi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nemeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Nemea, ancient site in the Peloponnese in Greece, associated with certain myths.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nemean Lion</ns0:orth>
        <ns0:pron>/ˌnimi.ən ˈlai.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>León de Nemea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A mythical lion of ancient Nemea that was invulnerable to attack by weapons and was slain by Hercules as one of his labours.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nemesis</ns0:orth>
        <ns0:pron>/ˈnɛməsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Némesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The goddess of divine retribution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nenets</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nenezos</ns0:quote>
          <ns0:quote>nénets</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a people who live in the extreme northwest of Russia; a Samoyed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nenets</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nenezo</ns0:quote>
          <ns0:quote>nenets</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Samoyedic languages spoken by these people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neo-Renaissance</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neorrenacimiento</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neogrammarian</ns0:orth>
        <ns0:pron>/ˌni.oʊ.ɡɹəˈmɛɹi.ən/</ns0:pron>
        <ns0:pron>/ˌniː.əʊ.ɡɹəˈmɛəɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neogramático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics, historical) A member or follower of a 19th-century school of German linguists who first advanced the theory of regular sound change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neolithic</ns0:orth>
        <ns0:pron>/ˌni.oʊˈlɪθ.ɪk/</ns0:pron>
        <ns0:pron>/ˌni.əʊˈlɪθ.ɪk/</ns0:pron>
        <ns0:pron>/ˌni.əˈlɪθ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neolítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the New Stone Age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neolithic</ns0:orth>
        <ns0:pron>/ˌni.oʊˈlɪθ.ɪk/</ns0:pron>
        <ns0:pron>/ˌni.əʊˈlɪθ.ɪk/</ns0:pron>
        <ns0:pron>/ˌni.əˈlɪθ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neolítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The period of prehistory from circa 8500 to 4500 BCE.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neoplatonist</ns0:orth>
        <ns0:pron>/niːə(ʊ)ˈpleɪtənɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neoplatónica</ns0:quote>
          <ns0:quote>neoplatónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy) A member of the philosophical school of Neoplatonism. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nepal</ns0:orth>
        <ns0:pron>/nəˈpɑl/</ns0:pron>
        <ns0:pron>/nəˈpɔl/</ns0:pron>
        <ns0:pron>/nɪˈpoːl/</ns0:pron>
        <ns0:pron>/nɪˈpɔːl/</ns0:pron>
        <ns0:pron>/ˈnepɑl/&lt;a:Indic&gt;</ns0:pron>
        <ns0:pron>/ˈneɪpɑl/</ns0:pron>
        <ns0:pron>[nəˈpʰɑɫ]</ns0:pron>
        <ns0:pron>[nəˈpʰɔ̞ɫ]</ns0:pron>
        <ns0:pron>[nɪˈpʰoːɫ]</ns0:pron>
        <ns0:pron>[nɪˈpʰɔ̝ːɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nepal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in South Asia, located between China and India. Official name: Federal Democratic Republic of Nepal. Capital and largest city: Kathmandu.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nepali</ns0:orth>
        <ns0:pron>/nəˈpɑːli/</ns0:pron>
        <ns0:pron>/nəˈpɔːli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nepalés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Nepal, the Nepali people or the Nepali language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nepali</ns0:orth>
        <ns0:pron>/nəˈpɑːli/</ns0:pron>
        <ns0:pron>/nəˈpɔːli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nepalés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a person from Nepal or of Nepali descent</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nepali</ns0:orth>
        <ns0:pron>/nəˈpɑːli/</ns0:pron>
        <ns0:pron>/nəˈpɔːli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nepalés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>an Indo-Aryan language used primarily by the people of Nepal</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nephite</ns0:orth>
        <ns0:pron>/ˈniːfaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nefita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Mormonism) A member of the group of descendants of Lehi's son Nephi who supposedly lived in the Americas from around 600 BC until 385 AD when the Lamanites wiped them out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neptune</ns0:orth>
        <ns0:pron>/ˈneptʃʉːn/</ns0:pron>
        <ns0:pron>/ˈnɛptjuːn/</ns0:pron>
        <ns0:pron>/ˈnɛptuːn/</ns0:pron>
        <ns0:pron>/ˈnɛptʃuːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Neptuno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) The eighth planet in our solar system, represented in astronomy and astrology by ♆.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Roman mythology) The god of the ocean and of earthquakes, equivalent to Poseidon in Greek mythology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neptunian</ns0:orth>
        <ns0:pron>/-ˈtʃuː-/</ns0:pron>
        <ns0:pron>/nɛpˈt(j)u.ni.ən/</ns0:pron>
        <ns0:pron>/nɛpˈtjuː.nɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neptuniano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrology) Pertaining to the astrological influence of the planet Neptune.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) Of or pertaining to the planet Neptune.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Neptunist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neptunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A proponent of Neptunism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nereid</ns0:orth>
        <ns0:pron>/ˈnɪəɹiɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nereida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) Any one of the fifty sea-nymphs who were daughters of the sea-god Nereus and attendants upon Poseidon (Neptune), and were represented as riding on sea horses, sometimes in human form and sometimes with the tail of a fish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nereus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nereo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nero</ns0:orth>
        <ns0:pron>/ˈniːroʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nerón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Roman Emperor from 54 to 68, and the last Emperor of the Julio-Claudian dynasty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nestor</ns0:orth>
        <ns0:pron>/ˈnɛstə/</ns0:pron>
        <ns0:pron>/ˈnɛstɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Néstor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, rare in English.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nestorian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nestoriano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, pejorative) Relating to teachings or to the followers of Nestorius.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nestorian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nestoriano</ns0:quote>
          <ns0:quote>nestoriana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, pejorative) A perceived follower of Nestorius in the fourth and fifth centuries. A member of a Nestorian church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nestorianism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nestorianismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The Christological doctrine ascribed to Nestorius, condemned as heretical by the Council of Ephesus but later also ascribed to the Church of the East, holding that within Christ there are two distinct hypostases, divine and human.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
