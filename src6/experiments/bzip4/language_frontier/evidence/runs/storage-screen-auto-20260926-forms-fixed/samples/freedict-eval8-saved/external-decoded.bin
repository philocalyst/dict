        <ns0:pron>/ˈməʊzɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Moisés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The pharaonic patriarch who led the enslaved Hebrews out of Egypt, the brother of Aaron and Miriam described in the Book of Exodus and the Quran.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A surname transferred from the given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
