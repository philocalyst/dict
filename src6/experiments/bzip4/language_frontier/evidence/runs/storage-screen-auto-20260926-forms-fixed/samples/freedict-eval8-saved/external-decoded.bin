        <ns0:pron>/ˈsəʊlɒn/</ns0:pron>
        <ns0:pron>/ˈsəʊlən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Solón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient Athenian statesman and lawgiver, one of the Seven Sages (c.630-c.560 BC).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
