    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jewry</ns0:orth>
        <ns0:pron>/ˈd͡ʒuːɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Jewish people considered collectively. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judería</ns0:quote>
          <ns0:quote>pueblo judío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The quarter of a town or city inhabited either partially or exclusively by Jews; historically, its main buildings were the synagogue, the ritual bath or mikve, the kosher-oriented butchery and bakery, etc. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
