        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en cualquier momento</ns0:quote>
          <ns0:quote>cuando sea</ns0:quote>
          <ns0:quote>sea cuando sea</ns0:quote>
          <ns0:quote>siempre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At any time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anyway</ns0:orth>
        <ns0:pron>/ˈɛniweɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en fin</ns0:quote>
          <ns0:quote>pero bueno</ns0:quote>
          <ns0:quote>pues nada</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de todas formas</ns0:quote>
          <ns0:quote>de todos modos</ns0:quote>
          <ns0:quote>de todas maneras</ns0:quote>
          <ns0:quote>a pesar de todo</ns0:quote>
          <ns0:quote>aun así</ns0:quote>
          <ns0:quote>comoquiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(conjunctive) Regardless; anyhow. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>"bueno, por lo menos"</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to indicate that a statement explains or supports a previous statement. See anyhow and at least. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de alguna forma</ns0:quote>
          <ns0:quote>de alguna manera</ns0:quote>
          <ns0:quote>de cualquier modo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) In any way. [16th–19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
