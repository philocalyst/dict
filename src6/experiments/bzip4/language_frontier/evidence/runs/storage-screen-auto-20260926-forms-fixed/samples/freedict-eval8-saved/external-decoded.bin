        <ns0:pron>/tɪˈbɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tíbet</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region in Central Asia (mostly in China), the homeland of the Tibetan people, covering much of the Tibetan Plateau.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical) A former country in East Asia that existed from 1912 until its annexation by China in 1951.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
