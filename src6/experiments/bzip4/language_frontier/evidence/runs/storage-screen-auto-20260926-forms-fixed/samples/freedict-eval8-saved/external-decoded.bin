    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Manichaean</ns0:orth>
        <ns0:pron>/ˌmænɪˈkiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maniqueo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) Of or relating to a worldview of distinct good and evil, especially to the exclusion of other possible categories.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Manichaean</ns0:orth>
        <ns0:pron>/ˌmænɪˈkiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maniqueo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of Manichaeism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Manichaeism</ns0:orth>
        <ns0:pron>/mænɪˈkiːɪz(ə)m/&lt;ref:{{R:OED|manichaeism}}&gt;</ns0:pron>
        <ns0:pron>/ˈmænɪkiːɪz(ə)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maniqueísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion) A syncretic, dualistic religion that combines elements of Zoroastrian, Christian, and Gnostic thought, founded by the Iranian prophet Mani in the 3rd century AD.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
