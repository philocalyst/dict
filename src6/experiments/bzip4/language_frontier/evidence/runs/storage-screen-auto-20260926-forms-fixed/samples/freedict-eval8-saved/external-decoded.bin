        <ns0:pron>/ɪˌtæljənaɪˈzeɪʃən/</ns0:pron>
        <ns0:pron>/ɪˌtæljənəˈzeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>italianización</ns0:quote>
        </ns0:cit>
