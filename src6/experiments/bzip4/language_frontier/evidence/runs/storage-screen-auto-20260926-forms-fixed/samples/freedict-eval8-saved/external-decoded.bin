        <ns0:pron>/əˈvɛn.t͡ʃəˌɹin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venturina</ns0:quote>
          <ns0:quote>aventurina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral, by extension) A variety of translucent quartz, spangled throughout with scales of yellow mica.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avenue</ns0:orth>
        <ns0:pron>/əvənˈju/</ns0:pron>
        <ns0:pron>/ˈæv.əˌn(j)u/</ns0:pron>
        <ns0:pron>/ˈæv.əˌnjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avenida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The principal walk or approach to a house which is withdrawn from the road, especially, such approach bordered on each side by trees; any broad passageway thus bordered.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>camino</ns0:quote>
          <ns0:quote>vía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A method or means by which something may be accomplished.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aver</ns0:orth>
        <ns0:pron>/əˈvɜː/</ns0:pron>
        <ns0:pron>/əˈvɝ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asegurar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To assert the truth of (something); to affirm (something) with confidence; to declare (something) in a positive manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>average</ns0:orth>
        <ns0:pron>/ˈæv(ə)ɹɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Constituting or relating to the average.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>promedio</ns0:quote>
          <ns0:quote>mediocre</ns0:quote>
          <ns0:quote>ni fu ni fa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Neither very good nor very bad; rated somewhere in the middle of all others in the same category.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>común</ns0:quote>
          <ns0:quote>corriente</ns0:quote>
          <ns0:quote>común y corriente</ns0:quote>
          <ns0:quote>ordinario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Typical.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>average</ns0:orth>
        <ns0:pron>/ˈæv(ə)ɹɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>promedio</ns0:quote>
          <ns0:quote>media</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) The arithmetic mean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
