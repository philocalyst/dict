      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mercurio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) The first planet in the Solar system with the closest orbit to the Sun, named after the god; represented by ☿.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Roman god) The Roman god associated with speed, sometimes used as a messenger, wearing winged sandals; the Roman counterpart of the Greek god Hermes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
