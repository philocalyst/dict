      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Occidente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The western world; i.e. Western Europe, the US and Canada (sometimes includes Latin America), and Australia and New Zealand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>West Africa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>África Occidental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region comprising the western portion of Africa, spanning 16 countries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>West Asia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Asia Occidental</ns0:quote>
          <ns0:quote>Asia del Oeste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The westernmost geographic region of Asia, which includes Anatolia, the Arabian Peninsula, Iran, the Levant, Mesopotamia, the Sinai Peninsula, and Transcaucasia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
