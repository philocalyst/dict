      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>himalayo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the Himalayas.</ns0:def>
        </ns0:sense>
