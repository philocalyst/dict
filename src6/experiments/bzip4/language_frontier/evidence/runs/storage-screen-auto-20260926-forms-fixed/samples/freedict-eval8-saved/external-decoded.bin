      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Septimania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The western region of the Roman province of Gallia Narbonensis (modern-day south France) that passed under the control of the Visigoths in 462, when it was ceded to their king, Theodoric II.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
