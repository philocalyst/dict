        </ns0:cit>
        <ns0:sense>
          <ns0:def>That inhibits the physiological action of acetylcholine at a receptor site.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antichresis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticresis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(civil law) An agreement by which a debtor gives a creditor the use of real property to be able to pay interest and principal of the debt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antichretic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticrético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(civil law) of or relating to an antichresis</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antichrist</ns0:orth>
        <ns0:pron>/ˈantiˌkɹaɪst/</ns0:pron>
        <ns0:pron>/ˈæntaɪˌkɹaɪst/</ns0:pron>
        <ns0:pron>/ˈæntiˌkɹaɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who works against the teachings of Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticipate</ns0:orth>
        <ns0:pron>/ænˈtɪs.ə.peɪt/</ns0:pron>
        <ns0:pron>/ænˈtɪs.ɪ.peɪt/</ns0:pron>
        <ns0:pron>/ænˈtɪs.ɪ.pæɪt/</ns0:pron>
        <ns0:pron>/ˈæɳʈɪsɪˌpeʈ/</ns0:pron>
        <ns0:pron>[ɛənˈtɪs.ə.peɪt]</ns0:pron>
        <ns0:pron>[ɛənˈtɪs.ɪ.peɪt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticiparse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To act before (someone), especially to prevent an action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticipar</ns0:quote>
          <ns0:quote>prever</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To know of (something) before it happens; to expect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticipation</ns0:orth>
        <ns0:pron>/ænˌtɪs.ə.pæɪ.ʃən/</ns0:pron>
        <ns0:pron>/ænˌtɪs.əˈpeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ænˌtɪs.ɪˈpeɪ.ʃən/</ns0:pron>
        <ns0:pron>[ɛənˌtɪs.əˈpeɪ.ʃən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticipación</ns0:quote>
          <ns0:quote>anticipamiento</ns0:quote>
          <ns0:quote>previsión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of anticipating, taking up, placing, or considering something beforehand, or before the proper time in natural order.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticipación</ns0:quote>
          <ns0:quote>expectación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The eagerness associated with waiting for something to occur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticipatory</ns0:orth>
        <ns0:pron>/anˈtɪsɪpət(ə)ɹi/</ns0:pron>
        <ns0:pron>/anˈtɪsɪˌpeɪtəɹi/</ns0:pron>
        <ns0:pron>/anˌtɪsɪˈpeɪtəɹi/</ns0:pron>
        <ns0:pron>/ænˌtɪsəpəˈtɔri/</ns0:pron>
        <ns0:pron>/ˌantɪˈsɪpət(ə)ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en anticipación</ns0:quote>
          <ns0:quote>en previsión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characterized by anticipation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticlerical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticlerical</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to political influence of clerics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticlimactic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticlimático</ns0:quote>
          <ns0:quote>decepcionante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lacking climax, disappointing or ironically insignificant following of impressive foreshadowing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticlimax</ns0:orth>
        <ns0:pron>/ˈæn.taɪˌklaɪ.mæks/</ns0:pron>
        <ns0:pron>/ˈæn.tiˌklaɪ.mæks/</ns0:pron>
        <ns0:pron>[ˈæ.ɾ̃iˌklaɪ.mæks]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticlímax</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) An abrupt descent (either deliberate or unintentional) from the dignity of the idea which the speaker or writer appeared to be aiming for.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticlinal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticlinal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Inclining or dipping in opposite directions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticline</ns0:orth>
        <ns0:pron>/ˈæntiklaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticlinal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) A fold with strata sloping downwards on each side.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticlockwise</ns0:orth>
        <ns0:pron>/ˌæn.tiˈklɑkˌwaɪz/</ns0:pron>
        <ns0:pron>/ˌæn.tiˈklɒk.waɪz/</ns0:pron>
        <ns0:pron>/ˌæn.tiˈklɔk.wɑɪz/</ns0:pron>
        <ns0:pron>/ˌæn.tɪˈklɑkˌwaɪz/</ns0:pron>
        <ns0:pron>/ˌænˌtaɪˈklɑkˌwaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihorario</ns0:quote>
          <ns0:quote>contrario a las manecillas del reloj</ns0:quote>
          <ns0:quote>levógiro</ns0:quote>
          <ns0:quote>sinistrorso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK, Ireland, Commonwealth, of movement) In a circular fashion so as to be moving to the left at the top of the circle and to the right at the bottom (when viewed from the front), in the opposite direction to the hands of an analog clock.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticlockwise</ns0:orth>
        <ns0:pron>/ˌæn.tiˈklɑkˌwaɪz/</ns0:pron>
        <ns0:pron>/ˌæn.tiˈklɒk.waɪz/</ns0:pron>
        <ns0:pron>/ˌæn.tiˈklɔk.wɑɪz/</ns0:pron>
        <ns0:pron>/ˌæn.tɪˈklɑkˌwaɪz/</ns0:pron>
        <ns0:pron>/ˌænˌtaɪˈklɑkˌwaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihorariamente</ns0:quote>
          <ns0:quote>en sentido antihorario</ns0:quote>
          <ns0:quote>en sentido contrario a las agujas del reloj</ns0:quote>
          <ns0:quote>en sentido contrario a las manecillas del reloj</ns0:quote>
          <ns0:quote>en sentido contrario al reloj</ns0:quote>
          <ns0:quote>levógiramente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Commonwealth, UK, Ireland) In an anticlockwise fashion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticoagulant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticoagulante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That prevents coagulation, that stops blood from clotting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticoagulant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticoagulante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A substance that prevents coagulation (stops blood from clotting); especially, any of a group of pharmaceutical drugs that reduce the clotting speed or affinity of the blood by any of several mechanisms (e.g., inhibiting platelet function, inhibiting clotting factor (protein) production or function, increasing antithrombin function).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticoagulation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticoagulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Treatment to prevent coagulation of blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticodon</ns0:orth>
        <ns0:pron>/ˌæntaɪ-/</ns0:pron>
        <ns0:pron>/ˌæntiˈkəʊdɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticodón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetics) A sequence of three nucleotides in transfer RNA that binds to the complementary triplet (codon) in messenger RNA to specify an amino acid during protein synthesis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticolonial</ns0:orth>
        <ns0:pron>/ˌænt.aɪ.kəˈloʊn.i.əl/</ns0:pron>
        <ns0:pron>/ˌænt.i.kəˈloʊn.i.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticolonial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) Opposing colonialism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticolonialism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticolonialismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) The movement that opposes colonialism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticommunism</ns0:orth>
        <ns0:pron>/æntɪˈkɒmjʊnɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticomunismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposition to communism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticommunist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticomunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to the tenets of communism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticommunist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticomunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is opposed to the tenets of communism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticommutative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticonmutativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) Of an operator * for which a * b = − (b * a)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticonstitutional</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticonstitucional</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticonstitutionally</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticonstitucionalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) In an anticonstitutional manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticorruption</ns0:orth>
        <ns0:pron>/ˌæntiːkəˈɹʌpʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticorrupción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to or combating corruption</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticrisis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticrisis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) Intended to prevent or counter a crisis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anticultural</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticultural</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposing mainstream culture or culture in general.</ns0:def>
