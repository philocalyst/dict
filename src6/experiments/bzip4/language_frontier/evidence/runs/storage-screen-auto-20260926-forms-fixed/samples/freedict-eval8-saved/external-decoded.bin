        <ns0:pron>/əˌkænt.θəˈsɛf.ə.lən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acantocéfalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of parasitic intestinal worms comprising the phylum Acanthocephala. [First attested late 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acanthosis</ns0:orth>
        <ns0:pron>/æˌkænˈθoʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acantosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A benign abnormal thickening of the stratum spinosum, or prickle cell, layer of the epidermis.[First attested in the late 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acanthus</ns0:orth>
        <ns0:pron>/əˈkæn.θəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the genus Acanthus of herbaceous prickly plants with toothed leaves, (family Acanthaceae, order Lamiales (formerly Scrophulariales)) found in the south of Europe, Asia Minor, and India. [from mid 16th century]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architectural element) An ornament resembling the foliage or leaves of Acanthus spinosus, used in the capitals of the Corinthian and composite orders. [from mid 18th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acarbose</ns0:orth>
        <ns0:pron>/eɪˈkɑɹˌboʊs/</ns0:pron>
