        <ns0:pron>/bɪəd/</ns0:pron>
        <ns0:pron>/bɪɹd/</ns0:pron>
        <ns0:pron>[bɪːd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, obsolete) To grow hair on the chin and jaw.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mortificar</ns0:quote>
          <ns0:quote>provocar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To boldly and bravely oppose or confront, often to the chagrin of the one being bearded.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
