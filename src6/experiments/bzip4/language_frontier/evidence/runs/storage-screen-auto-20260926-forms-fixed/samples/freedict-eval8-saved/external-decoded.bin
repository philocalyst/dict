        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carbonero de Carp</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Melaniparus carpi, a small bird of the tit family Paridae</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Carpathians</ns0:orth>
