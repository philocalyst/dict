        <ns0:pron>/ˈɑɹkɪtaɪp/</ns0:pron>
        <ns0:pron>/ˈɑːkɪtaɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arquetipo</ns0:quote>
          <ns0:quote>exponente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An original model of which all other similar concepts, objects, or persons are merely copied, derivative, emulated, or patterned; a prototype. [from mid 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
