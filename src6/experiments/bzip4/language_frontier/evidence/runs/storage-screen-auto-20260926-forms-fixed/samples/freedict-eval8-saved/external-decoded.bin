        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Osa Menor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A circumpolar constellation of the northern sky, said to resemble a bear. It includes the familiar asterism of the Little Dipper and, as part of it, the northern pole star Polaris, as well as Kochab.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
