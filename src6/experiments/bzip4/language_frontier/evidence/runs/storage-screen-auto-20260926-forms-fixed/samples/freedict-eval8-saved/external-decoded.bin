      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A colourless, volatile, flammable liquid ketone, (CH3)2CO, used as a solvent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetonitrile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetonitrilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The simplest organic cyanide or nitrile, CH3CN, formally derived from acetic acid</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetyl</ns0:orth>
        <ns0:pron>/əˈsiːtaɪl/</ns0:pron>
        <ns0:pron>/əˈsiːtɪl/</ns0:pron>
        <ns0:pron>/ˈæsətɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetilo</ns0:quote>
          <ns0:quote>acetil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) The univalent radical CH3CO- derived from acetic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
