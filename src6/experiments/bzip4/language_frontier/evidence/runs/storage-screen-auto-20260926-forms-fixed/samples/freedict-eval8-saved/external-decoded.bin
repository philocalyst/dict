      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islas Carolinas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A widely scattered archipelago of tiny islands in the western Pacific Ocean, to the north of New Guinea, politically divided between the Federated States of Micronesia and Palau.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
