        </ns0:cit>
        <ns0:sense>
          <ns0:def>An autonomous region of China, south of Mongolia, with closely related native Mongolian population, mostly north of the Great Wall. Capital: Hohhot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
