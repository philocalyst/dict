      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Regiones Occidentales</ns0:quote>
          <ns0:quote>Regiones del Oeste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A geographic region of Central Asia, west of ancient China's Jade Gate along the Silk Road; sometimes including parts of the Indian subcontinent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
