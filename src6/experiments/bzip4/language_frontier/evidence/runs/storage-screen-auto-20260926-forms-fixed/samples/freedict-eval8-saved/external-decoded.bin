      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cristadelfiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a particular nontrinitarian Christian denomination founded in the mid-19th century.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
