        <ns0:pron>/əˌvɑntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˈæ.vn̩t.ɡɑːd/</ns0:pron>
        <ns0:pron>/ˌæ.vɑntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌæ.vɑ̃ˈɡɑːd/</ns0:pron>
        <ns0:pron>/ˌæˌvɑ̃ˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌɑˌvæntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌɑˌvɑntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌɑˌvɑ̃ˈɡɑɹd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vanguardista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Innovative and pioneering, especially when extremely or obviously so.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avant-garde</ns0:orth>
        <ns0:pron>/æˈvɑ̃.ɡɑːd/</ns0:pron>
        <ns0:pron>/æˈvɑ̃t.ɡɑːd/</ns0:pron>
        <ns0:pron>/əˌvæntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/əˌvɑntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˈæ.vn̩t.ɡɑːd/</ns0:pron>
        <ns0:pron>/ˌæ.vɑntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌæ.vɑ̃ˈɡɑːd/</ns0:pron>
        <ns0:pron>/ˌæˌvɑ̃ˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌɑˌvæntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌɑˌvɑntˈɡɑɹd/</ns0:pron>
        <ns0:pron>/ˌɑˌvɑ̃ˈɡɑɹd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vanguardia</ns0:quote>
          <ns0:quote>anteguardia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) The vanguard of an army or other force.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vanguardia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any group of people who invent or promote new techniques or concepts, especially in the arts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avarice</ns0:orth>
        <ns0:pron>/ˈævəɹəs/</ns0:pron>
        <ns0:pron>/ˈævəɹɪs/</ns0:pron>
        <ns0:pron>/ˈævɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>codicia</ns0:quote>
          <ns0:quote>avaricia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Excessive or inordinate desire of gain; greed for wealth</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avaricious</ns0:orth>
        <ns0:pron>/ˌævəˈɹɪʃəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>codicioso</ns0:quote>
          <ns0:quote>avaricioso</ns0:quote>
          <ns0:quote>avariento</ns0:quote>
          <ns0:quote>avaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Actuated by avarice; extremely greedy for wealth or material gain; immoderately desirous of accumulating property.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avascular</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avascular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Lacking blood vessels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avatar</ns0:orth>
        <ns0:pron>/-θɑː(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæv.ə.tɑɹ/</ns0:pron>
        <ns0:pron>/ˈæv.ə.tɑː(ɹ)/</ns0:pron>
        <ns0:pron>/ˈəv(ə)t̪ɑr/</ns0:pron>
        <ns0:pron>/ˈʌv(ə)θɑːɹ/</ns0:pron>
        <ns0:pron>/ˌæv.əˈtɑː(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avatar</ns0:quote>
          <ns0:quote>emblema</ns0:quote>
          <ns0:quote>encarnación</ns0:quote>
          <ns0:quote>materialización</ns0:quote>
          <ns0:quote>personificación</ns0:quote>
          <ns0:quote>símbolo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(internet, video games) A complex and dynamic digital representation of a person or being in the form of a digital model, used online as a simulation or emulation of a person, or as a person's online alter ego, in a virtual world, virtual chat room, or metaverse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avenge</ns0:orth>
        <ns0:pron>/əˈvɛnd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vengar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To take vengeance (for); to exact satisfaction for by punishing the injuring party; to vindicate by inflicting pain or evil on a wrongdoer.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To treat revengefully; to wreak vengeance on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avenger</ns0:orth>
        <ns0:pron>/əˈvɛndʒə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vengador</ns0:quote>
          <ns0:quote>vengadora</ns0:quote>
          <ns0:quote>desfacedor de entuertos</ns0:quote>
          <ns0:quote>deshacedor de agravios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who avenges or vindicates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aventurine</ns0:orth>
        <ns0:pron>/əˈvɛn.tjʊə.ɹɪn/</ns0:pron>
