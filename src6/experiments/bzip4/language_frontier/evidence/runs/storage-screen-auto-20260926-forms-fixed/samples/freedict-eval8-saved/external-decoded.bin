        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cloruro de etanoilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The acyl chloride of acetic acid, CH3COCl</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetylcholine</ns0:orth>
        <ns0:pron>/əˌsitəlˈkoʊlin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetilcolina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neurotransmitter) A neurotransmitter in humans and other animals. It is an ester of acetic acid and choline with chemical formula CH3COOCH2CH2N+(CH3)3.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetylcholinesterase</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetilcolinesterasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(enzyme) An enzyme that catalyzes the hydrolysis of the neurotransmitter acetylcholine into choline and acetic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetylcysteine</ns0:orth>
        <ns0:pron>/əˌsi.tl̩ˈsɪ.stəˌin/</ns0:pron>
        <ns0:pron>/ˌas.ɪ.tɪlˈsɪ.stɪ.iːn/</ns0:pron>
        <ns0:pron>/ˌas.ɪ.tʌɪlˈsɪ.steɪn/</ns0:pron>
        <ns0:pron>/ˌas.ɪ.tʌɪlˈsɪ.stɪ.iːn/</ns0:pron>
        <ns0:pron>/ˌæs.ət.l̩ˈsɪ.stəˌin/</ns0:pron>
        <ns0:pron>/ˌæs.əˌtilˈsɪ.stəˌin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetilcisteína</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound, pharmaceutical drug) An acetylated form of the amino acid cysteine (trademark Mucomyst), which is an antioxidant used as a mucolytic agent and in the treatment of paracetamol poisoning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
