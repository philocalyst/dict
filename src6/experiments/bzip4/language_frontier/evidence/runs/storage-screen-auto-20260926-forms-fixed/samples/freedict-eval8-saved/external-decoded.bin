      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborigen</ns0:quote>
          <ns0:quote>indígena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>First according to historical or scientific records; original; indigenous; primitive. [First attested in the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aborigine</ns0:orth>
