          <ns0:quote>África Central</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A core geographic region of Africa which includes Burundi, the Central African Republic, Chad, the Republic of the Congo, and Rwanda, and often Angola and the Democratic Republic of the Congo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
