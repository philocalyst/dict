        <ns0:pron>/ˌɪndəˈniːʒən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indonesio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Indonesia or its people or language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
