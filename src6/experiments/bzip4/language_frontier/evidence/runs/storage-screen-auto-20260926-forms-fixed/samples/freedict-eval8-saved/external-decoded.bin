          <ns0:quote>Imperio mogol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Persianate empire centered in North India from 1526 to 1857; succeeded by the British East India Company.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
