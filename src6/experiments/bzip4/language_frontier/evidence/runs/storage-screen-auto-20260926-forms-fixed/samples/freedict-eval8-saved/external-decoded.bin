      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wolof</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A West African people, mostly in Senegal.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The language traditionally spoken by those people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wolverhampton</ns0:orth>
