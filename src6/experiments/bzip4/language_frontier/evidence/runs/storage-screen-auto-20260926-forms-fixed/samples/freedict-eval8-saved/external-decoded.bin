    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auxiliary</ns0:orth>
        <ns0:pron>/ɑɡˈzɪl.((j)ə).ɹi/</ns0:pron>
        <ns0:pron>/ɑɡˈzɪl.i.ɛɹ.i/</ns0:pron>
        <ns0:pron>/ɔɡˈzɪl.((j)ə).ɹi/</ns0:pron>
        <ns0:pron>/ɔɡˈzɪl.i.ɛɹ.i/</ns0:pron>
        <ns0:pron>/ɔːkˈsɪl-/</ns0:pron>
        <ns0:pron>/ɔːɡˈzɪl.(j)ə.ɹi/</ns0:pron>
        <ns0:pron>/ɔːɡˈzɪl.i.ə.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxiliar</ns0:quote>
          <ns0:quote>ayudante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person or group that acts in an auxiliary manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auxiliary language</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxilengua</ns0:quote>
          <ns0:quote>lengua auxiliar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ellipsis of international auxiliary language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auxiliary verb</ns0:orth>
        <ns0:pron>/ɔːɡˈzɪljəɹi ˈvɜː(ɹ)b/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>verbo auxiliar</ns0:quote>
          <ns0:quote>auxiliar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A verb that accompanies the main verb in a clause in order to make distinctions in tense, mood, voice or aspect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auxin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, hormone) A class of plant growth substance (often called phytohormones or plant hormones) which play an essential role in coordination of many growth and behavioral processes in the plant life cycle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auxology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The study of growth</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avail</ns0:orth>
        <ns0:pron>/əˈveɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprovechar</ns0:quote>
          <ns0:quote>servir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To be of use or advantage; to answer or serve the purpose; to have strength, force, or efficacy sufficient to accomplish the object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>availability</ns0:orth>
        <ns0:pron>/əˌveɪ.ləˈbɪl.ɪ.ti/</ns0:pron>
        <ns0:pron>[əˌveɪ.ləˈbɪl.ɪ.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disponibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, uncountable) The quality of being available.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>available</ns0:orth>
        <ns0:pron>/əv(ɛ)ˈlebəl/</ns0:pron>
        <ns0:pron>/əˈveɪ.lə.bəl/</ns0:pron>
        <ns0:pron>/əˈvɛjləbɪl/</ns0:pron>
        <ns0:pron>[əˈveɪ.lə.bl̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disponible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Such as one may avail oneself of; capable of being used for the accomplishment of a purpose.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Readily obtainable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aval</ns0:orth>
      </ns0:form>
