        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gran Ducado de Lituania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former duchy in Eastern Europe from the 13th century until 1795, encompassing at its maximum the territory of modern-day Lithuania and Belarus, a large part of Ukraine, and small parts of Russia and Poland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
