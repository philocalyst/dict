      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Larisa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in north-central Greece, the capital of Thessaly.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A city in western Asia Minor, close to the ancient Greek city of Smyrna and to present-day Menemen, Turkey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
