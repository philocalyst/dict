      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>montenegrino</ns0:quote>
          <ns0:quote>montenegrina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) a person from Montenegro (country)</ns0:def>
        </ns0:sense>
