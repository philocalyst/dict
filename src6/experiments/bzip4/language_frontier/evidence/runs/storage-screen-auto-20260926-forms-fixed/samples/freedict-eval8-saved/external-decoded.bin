      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Vaucluse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A commune of Doubs department, Bourgogne-Franche-Comté, France.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
