        <ns0:pron>/ˈbɑk.lə.və/</ns0:pron>
        <ns0:pron>/ˈbɑk.ləˌvɑː/</ns0:pron>
        <ns0:pron>/ˌbɑk.ləˈvɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baclava</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sweet pastry found in many cuisines of the Middle East and the Balkans, made of chopped nuts layered with phyllo pastry. [since c. 1650; modern spelling since 1800s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
