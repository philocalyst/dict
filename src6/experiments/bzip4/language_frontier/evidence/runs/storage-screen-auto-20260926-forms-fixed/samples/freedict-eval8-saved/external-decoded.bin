        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Reino de Dinamarca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Denmark or the Danish Realm: a country consisting of metropolitan Denmark ("Denmark proper") in Western Europe as well as the Faroe Islands in the North Atlantic and Greenland off the coast of North America.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
