        <ns0:pron>[ˈbeɪ̯(ə)ɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bala</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rounded bundle or package of goods in a cloth cover, and corded for storage or transportation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A measurement of paper equal to 10 reams.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
