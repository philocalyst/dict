    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>YHWH</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Yahvé</ns0:quote>
          <ns0:quote>Jehová</ns0:quote>
          <ns0:quote>Yahweh</ns0:quote>
          <ns0:quote>Yavé</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Known as the "Tetragrammaton", the four Hebrew letters יהוה which are transliterated into the Latin alphabet as YHWH (also IHVH, JHVH, or YHVH). Usually vowels are added to produce the spelling Jehovah, Yehovah or Yahweh (Jahaveh, Jahve, Jahveh, Jahweh, Yahve, Yahveh, Yahwe).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
