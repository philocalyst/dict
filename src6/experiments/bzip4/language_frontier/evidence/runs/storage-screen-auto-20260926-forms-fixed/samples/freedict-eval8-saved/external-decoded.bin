        <ns0:pron>/ad ˌɪn.fəˈnəi.təm/</ns0:pron>
        <ns0:pron>/ad ˌɪn.fəˈnʌi.təm/</ns0:pron>
        <ns0:pron>/æd ˌɪn.fəˈnaɪ.təm/</ns0:pron>
        <ns0:pron>/æd ˌɪn.fəˈnɑɪ.təm/</ns0:pron>
        <ns0:pron>/æd ˌɪn.fəˈnʌɪ.təm/</ns0:pron>
        <ns0:pron>/æɖ ˌin.fiˈnaj.ʈəm/</ns0:pron>
        <ns0:pron>/ɛd ˌən.fəˈnaɪ.təm/</ns0:pron>
