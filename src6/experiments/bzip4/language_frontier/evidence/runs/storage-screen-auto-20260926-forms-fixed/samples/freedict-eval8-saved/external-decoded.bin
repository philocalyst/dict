          <ns0:quote>río Pequeño Colorado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tributary of the Colorado in Arizona, United States, providing the principal drainage from the Painted Desert region.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
