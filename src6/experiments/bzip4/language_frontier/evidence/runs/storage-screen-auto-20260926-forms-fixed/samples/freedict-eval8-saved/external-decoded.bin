        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to basalt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bascinet</ns0:orth>
        <ns0:pron>/ˈbæsɪˌnɛt/</ns0:pron>
        <ns0:pron>/ˌbæsɪˈnɛt/</ns0:pron>
