          <ns0:quote>mosaico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to Moses, or the writings and traditions attributed to him. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
