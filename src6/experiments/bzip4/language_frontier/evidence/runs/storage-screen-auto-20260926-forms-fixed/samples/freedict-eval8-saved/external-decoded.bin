      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Raków</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A settlement founded in the Sandomierz Voivodeship of Lesser Poland in 1569 as the centre of the Polish Brethren, the site of the Racovian Academy 1602–1638 and of the publication of the Racovian Catechism in 1605; formerly a town until 1869, it is now a village of the Republic of Poland and the seat of the gmina wiejska (rural commune) of the same name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
