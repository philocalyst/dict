    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Norfolk Island pine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>araucaria excelsa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Araucaria heterophylla (synonym Araucaria excelsa), a conifer endemic to Norfolk Island, but grown as an ornamental tree in mild climates and as a container plant indoors worldwide.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Norma</ns0:orth>
      </ns0:form>
