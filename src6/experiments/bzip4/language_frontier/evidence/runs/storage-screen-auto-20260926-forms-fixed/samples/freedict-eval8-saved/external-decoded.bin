      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alteración</ns0:quote>
          <ns0:quote>cambio</ns0:quote>
          <ns0:quote>modificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of altering or making different.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alteración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being altered; a change made in the form or nature of a thing; a changed condition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
