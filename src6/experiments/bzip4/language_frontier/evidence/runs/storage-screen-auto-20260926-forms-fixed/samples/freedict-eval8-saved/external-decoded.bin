      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sinemuriense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, paleontology) A subdivision of the Jurassic period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
