      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To manage or supervise the conduct, performance or execution of; to govern or regulate the parameters for the conduct, performance or execution of; to work in an administrative capacity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perfundir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, medicine) To give (a drug, to a patient), be it orally or by any other means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administrar</ns0:quote>
          <ns0:quote>perfundir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, medicine) To cause (a patient, human or animal) to ingest (a drug), either by openly offering or through deceit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>administration</ns0:orth>
        <ns0:pron>/ədˌmɪnəˈstɹeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The act of administering; government of public affairs; the service rendered, or duties assumed, in conducting affairs; the conducting of any office or employment; direction.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, government, politics) The executive part of government; the persons collectively who are entrusted with the execution of laws and the superintendence of public affairs; the chief magistrate and his cabinet or council; or the council, or ministry, alone, as in Great Britain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>administrative</ns0:orth>
        <ns0:pron>/ədˈmɪn.əˌstɹeɪ.tɪv/</ns0:pron>
        <ns0:pron>/ədˈmɪn.ɪ.stɹə.tɪv/</ns0:pron>
        <ns0:pron>[ədˈmɪn.əˌstɹeɪ.ɾɪv]</ns0:pron>
        <ns0:pron>[ədˈmɪn.ɪ.st̠ɹ̠̊˔ʷə.tʰɪv]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administrativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to administering or administration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>administrative court</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tribunal administrativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law) In many civil law jurisdictions, a specialized court separate from the ordinary court system in charge of reviewing decisions made by public authorities under administrative law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>administratively</ns0:orth>
        <ns0:pron>/ədˈmɪnɪstɹətɪvli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administrativamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an administrative manner, or for purposes of administration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>administrator</ns0:orth>
        <ns0:pron>/ədˈmɪnɪstɹeɪtə/</ns0:pron>
        <ns0:pron>/ədˈmɪnɪstɹeɪtɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administrador</ns0:quote>
          <ns0:quote>administradora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who administers affairs; one who directs, manages, executes, or dispenses, whether in civil, judicial, political, or ecclesiastical affairs; a manager.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>administrador</ns0:quote>
          <ns0:quote>albacea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A person who manages or settles the estate of an intestate, or of a testator when there is no competent executor; one to whom the right of administration has been committed by competent authority</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admirable</ns0:orth>
        <ns0:pron>/ædˈmaɪ.ɹə.bəl/</ns0:pron>
        <ns0:pron>/ˈæd.məɹ.ə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admirable</ns0:quote>
          <ns0:quote>loable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Deserving of the highest esteem or admiration; estimable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admirably</ns0:orth>
        <ns0:pron>/ˈæd.mə.ɹə.bli/</ns0:pron>
        <ns0:pron>/ˈæd.mɪɹ.ə.bli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admirablemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To an admirable degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiral</ns0:orth>
        <ns0:pron>/ˈædməɹl/</ns0:pron>
        <ns0:pron>/ˈædməɹəl/</ns0:pron>
        <ns0:pron>/ˈædmɚəl/</ns0:pron>
        <ns0:pron>/ˈædmɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almirante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) The appointed commander of a navy, regardless of formal title. [1440]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(military) A high rank in the British and American Navies, NATO grade OF-9, equivalent ranks in other navies, in coast guards, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(zoology) Any of several species of nymphalid butterflies of the genera Kaniska, Limenitis and Vanessa. [1799]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiral of the fleet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Capitán General de la Armada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, UK) The highest rank in the Royal Navy and other Commonwealth navies, NATO grade OF-10, currently only ceremonial.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiralty</ns0:orth>
        <ns0:pron>/ˈæd.mɪ.ɹəl.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almirantazgo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) The office or jurisdiction of an admiral.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiralty law</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>derecho de la navegación</ns0:quote>
          <ns0:quote>derecho marítimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The area of law that deals with ships at sea and the rights of sailors, passengers, and owners of cargo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiration</ns0:orth>
        <ns0:pron>/ˌæd.məˈɹeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admiración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A positive emotion including wonder and approbation; the regarding of another as being wonderful</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admire</ns0:orth>
        <ns0:pron>/ədˈmaɪə/</ns0:pron>
        <ns0:pron>/ədˈmaɪɹ/</ns0:pron>
        <ns0:pron>/ədˈmʌɪɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admirar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To regard with wonder and delight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admirer</ns0:orth>
        <ns0:pron>/ædˈmaɪ.ɹɚ/</ns0:pron>
        <ns0:pron>/ədˈmaɪ.ɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admirador</ns0:quote>
          <ns0:quote>admiradora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who admires.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiring</ns0:orth>
        <ns0:pron>/ædˈmaɪ.ɚ.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admirativo</ns0:quote>
          <ns0:quote>admirador</ns0:quote>
          <ns0:quote>de admiración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Feeling or showing admiration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admiringly</ns0:orth>
        <ns0:pron>/ədˈmaɪɹɪŋli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con admiración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an admiring manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admissible</ns0:orth>
        <ns0:pron>/ədˈmɪsəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptable</ns0:quote>
          <ns0:quote>admisible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable or deserving to be admitted, accepted or allowed; allowable, permissible, acceptable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admission</ns0:orth>
        <ns0:pron>/ædˈmɪʃ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admisión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or practice of admitting.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Permission to enter, or the entrance itself; admittance; entrance; access</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admisión</ns0:quote>
          <ns0:quote>confesión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Acquiescence or concurrence in a statement made by another, and distinguishable from a confession in that an admission presupposes prior inquiry by another, but a confession may be made without such inquiry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admit</ns0:orth>
        <ns0:pron>/ədˈmɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admitir</ns0:quote>
          <ns0:quote>dar entrada</ns0:quote>
          <ns0:quote>ingresar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To allow to enter; to grant entrance (to), whether into a place, into the mind, or into consideration</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dejar entrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To allow (someone) to enter a profession or to enjoy a privilege; to recognize as qualified for a franchise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admitir</ns0:quote>
          <ns0:quote>reconocer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, or, intransitive) To concede as true; to acknowledge or assent to, as an allegation which it is impossible to deny (+ to).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>permitir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be capable of; to permit. In this sense, "of" may be used after the verb, or may be omitted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admittance</ns0:orth>
        <ns0:pron>/ədˈmɪt.n̩s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admisión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of admitting.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(British, legal) The act of giving possession of a copyhold estate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admisión</ns0:quote>
          <ns0:quote>entrada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Permission to enter, the power or right of entrance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admitancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The reciprocal of impedance</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admittedly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admitidamente</ns0:quote>
          <ns0:quote>es cierto que</ns0:quote>
          <ns0:quote>hay que admitir que</ns0:quote>
          <ns0:quote>la verdad es que</ns0:quote>
          <ns0:quote>lo cierto es que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(conjunctive) Signals a concession followed by a counterpoint usually headed by but.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admixture</ns0:orth>
        <ns0:pron>/ædˈmɪkst͡ʃɚ/</ns0:pron>
        <ns0:pron>/ədˈmɪkst͡ʃɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adición</ns0:quote>
          <ns0:quote>admixtión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instance of admixing, a mixing in of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mezcla</ns0:quote>
          <ns0:quote>admixtión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mixture, in some contexts:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admonish</ns0:orth>
        <ns0:pron>/ædˈmɑn.ɪʃ/</ns0:pron>
        <ns0:pron>/ədˈmɒn.ɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amonestar</ns0:quote>
          <ns0:quote>reprender</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To inform or notify of a fault; to rebuke in a serious tone; to tell off.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admonition</ns0:orth>
        <ns0:pron>/ˌædməˈnɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admonición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rebuke by an authority that one has erred and should not persist in their actions; a reprimand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>admonitory</ns0:orth>
        <ns0:pron>/ædˈmɑnɪˌtɔɹi/</ns0:pron>
        <ns0:pron>/ədˈmɑnɪˌtɔɹi/</ns0:pron>
        <ns0:pron>/ədˈmɒnɪtəɹi/</ns0:pron>
        <ns0:pron>/ədˈmɒnɪtɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admonitorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an admonition; serving to reprove, warn or advise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adnate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adnato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, mycology) Linked or fused to a structure of a type different from itself; for example, attachment of a stamen to a petal is adnate, while attachment of a stamen to another stamen is connate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adnation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adnación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The fusion of different floral verticils or sets of organs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adnexal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anexial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Of, or relating to the adnexa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adobe</ns0:orth>
        <ns0:pron>/əˈdoʊ.bi/</ns0:pron>
        <ns0:pron>/əˈdəʊ.bi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adobe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unburnt brick dried in the sun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>casa de adobe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A house made of adobe brick.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adobo</ns0:orth>
        <ns0:pron>/əˈdoʊboʊ/</ns0:pron>
        <ns0:pron>/ʔaˈdobo/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adobo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Philippine dish in which pork or chicken is slowly cooked in a sauce including soy sauce, vinegar, and crushed garlic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adolescence</ns0:orth>
        <ns0:pron>/ˌædəˈlɛsəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adolescencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The transitional period of physical and psychological development between childhood and maturity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adolescent</ns0:orth>
        <ns0:pron>/əˈɖoləsəɳʈ/</ns0:pron>
        <ns0:pron>/ˌædəˈlɛsənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adolescente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or at the age of adolescence; at the stage between being a child and an adult.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adolescent</ns0:orth>
        <ns0:pron>/əˈɖoləsəɳʈ/</ns0:pron>
        <ns0:pron>/ˌædəˈlɛsənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adolescente</ns0:quote>
          <ns0:quote>chica</ns0:quote>
          <ns0:quote>chico</ns0:quote>
          <ns0:quote>muchacha</ns0:quote>
          <ns0:quote>muchacho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is in adolescence; someone who has reached puberty but is not yet an adult.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adopt</ns0:orth>
        <ns0:pron>/əˈdɑpt/</ns0:pron>
        <ns0:pron>/əˈdɒpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoptar</ns0:quote>
          <ns0:quote>ahijar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To take (a child, heir, friend, citizen, etc.) by choice into a relationship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoptar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To take or receive as one's own what is not so naturally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoptable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoptable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be adopted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoptee</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoptada</ns0:quote>
          <ns0:quote>adoptado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adopter</ns0:orth>
        <ns0:pron>/əˈdɑp.tɚ/</ns0:pron>
        <ns0:pron>/əˈdɒp.tə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoptador</ns0:quote>
          <ns0:quote>adoptante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>one who adopts</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoption</ns0:orth>
        <ns0:pron>/əˈdɑp.ʃən/</ns0:pron>
        <ns0:pron>/əˈdɒp.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adopción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being adopted; the acceptance of a child of other parents as if he or she were one's own child.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The choosing and making that to be one's own which originally was not so; acceptance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoptive</ns0:orth>
        <ns0:pron>/əˈdɒptɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoptivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Related through adoption.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoptive father</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>padre adoptivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A man who has adopted a child, as opposed to a biological father.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoptive mother</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>madre adoptiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A woman who has adopted a child, as opposed to a biological mother.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adorable</ns0:orth>
        <ns0:pron>/əˈdoɹ.əˌbəl/</ns0:pron>
        <ns0:pron>/əˈdɔːɹəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adorable</ns0:quote>
          <ns0:quote>encantador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Befitting of being adored; cute or loveable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adoration</ns0:orth>
        <ns0:pron>/ˌæ.dəˈɹeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adoración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, religion) An act of religious worship.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) Admiration or esteem.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The act of adoring; loving devotion or fascination.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adore</ns0:orth>
        <ns0:pron>/əˈdo(ː)ɹ/</ns0:pron>
        <ns0:pron>/əˈdoə̯/</ns0:pron>
        <ns0:pron>/əˈdoɹ/</ns0:pron>
        <ns0:pron>/əˈdɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To worship.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To love with one's entire heart and soul; regard with deep respect and affection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adorer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adorador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who adores.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adorn</ns0:orth>
        <ns0:pron>/əˈdɔɹn/</ns0:pron>
        <ns0:pron>/əˈdɔː(ɹ)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adornar</ns0:quote>
          <ns0:quote>ornar</ns0:quote>
          <ns0:quote>engalanar</ns0:quote>
          <ns0:quote>enchular</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adornment</ns0:orth>
        <ns0:pron>/əˈdɔːnm(ə)nt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adorno</ns0:quote>
          <ns0:quote>decoración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A decoration; that which adorns.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adposition</ns0:orth>
        <ns0:pron>/ˈæd.pəˌzɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adposición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) An element that combines syntactically with a phrase and indicates how that phrase should be interpreted in the surrounding context; a preposition or postposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adrenal</ns0:orth>
        <ns0:pron>/æˈdɹiːnəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adrenal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the adrenal glands (suprarenal glands), their secretions, or the function derived therefrom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adrenal gland</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>glándula suprarrenal</ns0:quote>
          <ns0:quote>glándula adrenal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) In mammals, either of a pair of complex endocrine glands, situated above each kidney, secreting hormones which control the heart rate, blood pressure, and metabolism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adrenalectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adrenalectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) The removal of one or both adrenal glands, usually advised for patients with tumours in those glands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adrenaline</ns0:orth>
        <ns0:pron>/əˈdɹɛnəlɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adrenalina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
