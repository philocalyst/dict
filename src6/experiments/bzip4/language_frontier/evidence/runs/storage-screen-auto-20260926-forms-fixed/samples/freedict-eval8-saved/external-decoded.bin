        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abnegación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A denial; a renunciation; denial of desire or self-interest. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abnormal</ns0:orth>
        <ns0:pron>/əbˈnɔɹ.ml̩/</ns0:pron>
