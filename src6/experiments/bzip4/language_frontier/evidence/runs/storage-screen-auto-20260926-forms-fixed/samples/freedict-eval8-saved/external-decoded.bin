        <ns0:pron>/mænˈkju.ni.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mancuniana</ns0:quote>
          <ns0:quote>mancuniano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person raised or living in the city of Manchester, England, in the United Kingdom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mandaean</ns0:orth>
        <ns0:pron>/mænˈdiː.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mandea</ns0:quote>
          <ns0:quote>mandeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion) A believer in, or follower of, Mandaeism</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mandaeism</ns0:orth>
        <ns0:pron>/mænˈdeɪ.ɪzəm/</ns0:pron>
        <ns0:pron>/ˈmændeɪ.ɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mandeísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A monotheistic religion of the Iraq region with a strongly dualistic and gnostic worldview, whose adherents (the Mandaeans) revere Adam and other Biblical figures, especially John the Baptist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
