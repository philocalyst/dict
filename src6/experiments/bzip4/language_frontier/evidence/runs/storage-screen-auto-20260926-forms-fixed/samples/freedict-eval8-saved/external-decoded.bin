        <ns0:pron>/ˈluːwi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luvita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of or pertaining to Luwian language or its speakers</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luwian</ns0:orth>
        <ns0:pron>/ˈluːi.ən/</ns0:pron>
        <ns0:pron>/ˈluːwi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luvita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of an ancient Anatolian people related to the Hittites.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luwian</ns0:orth>
        <ns0:pron>/ˈluːi.ən/</ns0:pron>
        <ns0:pron>/ˈluːwi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luvita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>an extinct language of the Anatolian branch of the Indo-European language family, spoken in the 2nd millennium BC and recorded in both hieroglyphic and cuneiform scripts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luxembourg</ns0:orth>
        <ns0:pron>/ˈlʊk.sɛm.bɔ˞ɡ/</ns0:pron>
        <ns0:pron>/ˈlʊk.sɛm.bɝɡ/</ns0:pron>
        <ns0:pron>/ˈlʌk.səm.bɜːɡ/</ns0:pron>
        <ns0:pron>/ˈlʌk.səm.bɝɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Luxemburgo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small country in Western Europe. Official name: Grand Duchy of Luxembourg. Capital and largest city: Luxembourg.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A province of Wallonia, Belgium.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The capital city of Luxembourg.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>One of the twelve cantons of the country of Luxembourg, which includes its capital city.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luxembourger</ns0:orth>
        <ns0:pron>/ˈlʌksəmˌbɜːɡə/</ns0:pron>
        <ns0:pron>/ˈlʌksəmˌbɝɡɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luxemburgués</ns0:quote>
          <ns0:quote>luxemburguesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from the independent Grand Duchy of Luxembourg or of Luxembourgish descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luxembourgish</ns0:orth>
        <ns0:pron>/ˈlʌksəmˌbɜːɡɪʃ/</ns0:pron>
        <ns0:pron>/ˈlʌksəmˌbɝɡɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luxemburgués</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Luxembourg or its people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luxembourgish</ns0:orth>
        <ns0:pron>/ˈlʌksəmˌbɜːɡɪʃ/</ns0:pron>
        <ns0:pron>/ˈlʌksəmˌbɝɡɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luxemburgués</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Germanic language spoken in Luxembourg and, traditionally, around the city of Arlon (Belgium); originally included in the Moselle Franconian group of High German dialects, but now usually regarded as a separate language due to its standardisation and official use in the state of Luxembourg.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luxemburgism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luxemburguismo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luzon</ns0:orth>
        <ns0:pron>/lʊˈzon̪/</ns0:pron>
        <ns0:pron>/ˈluˌzɔn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
