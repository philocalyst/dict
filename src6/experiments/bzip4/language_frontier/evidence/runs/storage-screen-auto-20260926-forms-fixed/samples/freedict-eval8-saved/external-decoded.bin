    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Creutzfeldt-Jakob disease</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfermedad de Creutzfeldt-Jakob</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease, neurology) A rare, progressive, fatal disease of the nervous system, characterized by dementia and loss of muscle control. It is a prion disease, apparently transmissible from animals to humans by eating infected tissue, as well as from tissue interchanges among humans (e.g. corneal transplants, blood transfusions).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
