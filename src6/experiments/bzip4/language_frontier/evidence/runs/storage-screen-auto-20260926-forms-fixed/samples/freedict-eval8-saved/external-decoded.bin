          <ns0:quote>suicidio asistido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A suicide with the assistance of another individual; especially the suicide of a terminally ill person with the assistance of a physician.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>associate</ns0:orth>
        <ns0:pron>/əˈsoʊsi.ət/</ns0:pron>
        <ns0:pron>/əˈsoʊsi.ɪt/</ns0:pron>
        <ns0:pron>/əˈsoʊsieɪt/</ns0:pron>
        <ns0:pron>/əˈsoʊʃi.ət/</ns0:pron>
        <ns0:pron>/əˈsoʊʃi.ɪt/</ns0:pron>
        <ns0:pron>/əˈsoʊʃieɪt/</ns0:pron>
        <ns0:pron>/əˈsəʊsi.ət/</ns0:pron>
        <ns0:pron>/əˈsəʊsieɪt/</ns0:pron>
        <ns0:pron>/əˈsəʊʃi.ət/</ns0:pron>
        <ns0:pron>/əˈsəʊʃieɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asociado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person united with another or others in an act, enterprise, or business; a partner or employee.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A member of an institution or society who is granted only partial status or privileges.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compañero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A companion; a comrade.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>associate</ns0:orth>
        <ns0:pron>/əˈsoʊsi.ət/</ns0:pron>
        <ns0:pron>/əˈsoʊsi.ɪt/</ns0:pron>
        <ns0:pron>/əˈsoʊsieɪt/</ns0:pron>
        <ns0:pron>/əˈsoʊʃi.ət/</ns0:pron>
        <ns0:pron>/əˈsoʊʃi.ɪt/</ns0:pron>
        <ns0:pron>/əˈsoʊʃieɪt/</ns0:pron>
        <ns0:pron>/əˈsəʊsi.ət/</ns0:pron>
        <ns0:pron>/əˈsəʊsieɪt/</ns0:pron>
        <ns0:pron>/əˈsəʊʃi.ət/</ns0:pron>
        <ns0:pron>/əˈsəʊʃieɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asociar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To join in or form a league, union, or association.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To connect or join together; combine.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To connect evidentially, or in the mind or imagination.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternar</ns0:quote>
          <ns0:quote>codearse</ns0:quote>
          <ns0:quote>frecuentar</ns0:quote>
          <ns0:quote>relacionarse</ns0:quote>
          <ns0:quote>tratar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To spend time socially; keep company.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asociarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, with with) To join as a partner, ally, or friend.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>associate's degree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bachillerato</ns0:quote>
          <ns0:quote>diplomatura</ns0:quote>
          <ns0:quote>grado de asociado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada) An academic degree awarded after the equivalent of approximately two years of college education, usually by a community college.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>association</ns0:orth>
        <ns0:pron>/əˌsoʊsiˈeɪʃən/</ns0:pron>
        <ns0:pron>/əˌsoʊʃiˈeɪʃən/</ns0:pron>
        <ns0:pron>/əˌsəʊsiˈeɪʃn̩/</ns0:pron>
        <ns0:pron>/əˌsəʊʃiˈeɪʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asociación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The act of associating.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The state of being associated; a connection to or an affiliation with something.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A group of persons associated for a common purpose; an organization; society.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>association football</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fútbol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ball game played between two teams of eleven players, each attempting to win by scoring more goals than their opponent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>association of ideas</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asociación de ideas</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>associative</ns0:orth>
        <ns0:pron>/əˈsoʊ.si.ə.tɪv/</ns0:pron>
        <ns0:pron>/əˈsoʊ.ʃi.ə.tɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asociativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra, of a binary operator *) Such that, for any operands a, b and c, (a * b) * c = a * (b * c); (of a ring, etc.) whose multiplication operation is associative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assonance</ns0:orth>
        <ns0:pron>/ˈæsənəns/</ns0:pron>
        <ns0:pron>/ˈɛsɘnɘns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asonancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(prosody) The repetition of similar or identical vowel sounds (though with different consonants), usually in literature or poetry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assonant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asonante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(prosody) Characterized by assonance; having successive similar vowel sounds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assort</ns0:orth>
        <ns0:pron>/əˈsɔɹt/</ns0:pron>
        <ns0:pron>/əˈsɔːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>clasificar</ns0:quote>
          <ns0:quote>ordenar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To sort or arrange according to characteristic or class.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assortativity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asortatividad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) The extent to which nodes of a graph link to others of the same degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assorted</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>surtido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Composed of a number of different kinds or types; mixed; miscellaneous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assortment</ns0:orth>
        <ns0:pron>/əˈsɔːtmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>surtido</ns0:quote>
          <ns0:quote>colección</ns0:quote>
          <ns0:quote>variedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A collection of varying but related items.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assuage</ns0:orth>
        <ns0:pron>/əˈsweɪd͡ʒ/</ns0:pron>
        <ns0:pron>/əˈswɑʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliviar</ns0:quote>
          <ns0:quote>calmar</ns0:quote>
          <ns0:quote>mitigar</ns0:quote>
          <ns0:quote>satisfacer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To lessen the intensity of, to mitigate or relieve (hunger, emotion, pain, etc.).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calmar</ns0:quote>
          <ns0:quote>apaciguar</ns0:quote>
          <ns0:quote>sosegar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pacify or soothe (someone).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assume</ns0:orth>
        <ns0:pron>/əˈsjuːm/</ns0:pron>
        <ns0:pron>/əˈsuːm/</ns0:pron>
        <ns0:pron>/əˈzuːm/</ns0:pron>
        <ns0:pron>/əˈʃuːm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>suponer</ns0:quote>
          <ns0:quote>dar por sentado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To authenticate by means of belief; to surmise; to suppose to be true, especially without proof</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asumir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To take on a position, duty or form</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To adopt (an idea or cause)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assumed</ns0:orth>
        <ns0:pron>/əˈsjuːmd/</ns0:pron>
        <ns0:pron>/əˈsuːmd/</ns0:pron>
        <ns0:pron>/əˈzuːmd/</ns0:pron>
        <ns0:pron>/əˈʃuːmd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fingido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used in a manner intended to deceive; pretended; simulated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>supuesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Supposed or presumed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assumption</ns0:orth>
        <ns0:pron>/əˈsʌm(p).ʃ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asunción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of assuming, or taking to or upon oneself; the act of taking up or adopting.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A festival in honor of the ascent of the Virgin Mary into heaven, celebrated on 15 August.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>suposición</ns0:quote>
          <ns0:quote>presunción</ns0:quote>
          <ns0:quote>presuposición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of taking for granted, or supposing a thing without proof; a supposition; an unwarrantable claim.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The thing supposed; a postulate, or proposition assumed; a supposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asunción</ns0:quote>
          <ns0:quote>ascensión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The taking of a person up into heaven.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assurance</ns0:orth>
        <ns0:pron>/əˈʃɔːɹəns/</ns0:pron>
        <ns0:pron>/əˈʃɝəns/</ns0:pron>
        <ns0:pron>/əˈʃʊəɹəns/</ns0:pron>
        <ns0:pron>/əˈʃʊɹəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>certeza</ns0:quote>
          <ns0:quote>aplomo</ns0:quote>
          <ns0:quote>aseguranza</ns0:quote>
          <ns0:quote>confianza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being assured; total confidence or trust; a lack of doubt; certainty; guarantee.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>certidumbre</ns0:quote>
          <ns0:quote>confianza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Firmness of mind; undoubting steadiness; intrepidity, courage, or self-confidence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>promesa</ns0:quote>
          <ns0:quote>aseguración</ns0:quote>
          <ns0:quote>garantía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(insurance) Insurance; a contract for the payment of a sum on occasion of a certain event, as loss or death. Assurance is used in relation to life contingencies, and insurance in relation to other contingencies. It is called temporary assurance, in the time within which the contingent event must happen is limited.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>assure</ns0:orth>
        <ns0:pron>/əˈʃɔː(ɹ)/</ns0:pron>
        <ns0:pron>/əˈʃɝ/</ns0:pron>
        <ns0:pron>/əˈʃʊə(ɹ)/</ns0:pron>
        <ns0:pron>/əˈʃʊɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asegurar</ns0:quote>
          <ns0:quote>afianzar</ns0:quote>
          <ns0:quote>segurar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make sure and secure; ensure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asegurar</ns0:quote>
          <ns0:quote>afiar</ns0:quote>
          <ns0:quote>afiuciar</ns0:quote>
          <ns0:quote>afuciar</ns0:quote>
          <ns0:quote>avalar</ns0:quote>
          <ns0:quote>cerciorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, followed by that or of) To give (someone) confidence in the trustworthiness of (something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astatine</ns0:orth>
        <ns0:pron>/ˈastətiːn/</ns0:pron>
        <ns0:pron>/ˈæstəˌtin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astato</ns0:quote>
          <ns0:quote>ástato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A highly radioactive chemical element (symbol At), one of the halogens, with atomic number 85.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astaxanthin</ns0:orth>
        <ns0:pron>/æstəˈzænθɪn/</ns0:pron>
        <ns0:pron>[æstəˈzɛənθɪn]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astaxantina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A xanthophyll pigment that occurs widely in plants and animals, especially crustaceans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aster</ns0:orth>
        <ns0:pron>/ˈæs.tə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aster</ns0:quote>
          <ns0:quote>áster</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several plants of the genus Aster; one of its flowers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>áster</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A star-shaped structure formed during the mitosis of a cell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asterisk</ns0:orth>
        <ns0:pron>/ˈæst(ə)ˌɹɪks/</ns0:pron>
        <ns0:pron>/ˈæstəɹɪsk/</ns0:pron>
        <ns0:pron>/ˈæstəˌɹɪsk/</ns0:pron>
        <ns0:pron>/ˈæstɹɪsk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asterisco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something resembling or shaped like an asterisk symbol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asterism</ns0:orth>
        <ns0:pron>/ˈæs.təˌɹɪz.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asterismo</ns0:quote>
          <ns0:quote>constelación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) An unofficial constellation (small group of stars that forms a visible pattern).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asterismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rarely used typographical symbol of three asterisks arranged in a triangle, ⁂, used to call attention to a passage or to separate subchapters in a book. Distinct from a dinkus which also uses asterisks to separate.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mineralogy) A star-shaped figure exhibited by some crystals by reflected light (as in a star sapphire) or by transmitted light (as in some mica).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astern</ns0:orth>
        <ns0:pron>/əˈstɜːn/</ns0:pron>
        <ns0:pron>/əˈstɝn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a popa</ns0:quote>
          <ns0:quote>detrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Behind a vessel; having a bearing of 180 degrees from ahead.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astern</ns0:orth>
        <ns0:pron>/əˈstɜːn/</ns0:pron>
        <ns0:pron>/əˈstɝn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacia atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the direction of the stern; backward (motion); to the rear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asteroid</ns0:orth>
        <ns0:pron>/ˈæst(ə)ɹɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asteroide</ns0:quote>
          <ns0:quote>planetoide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A naturally occurring solid object, which is smaller than a planet and a dwarf planet, larger than a meteoroid and not a comet, that orbits a star and often has an irregular shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asteroid belt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinturón de asteroides</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) The main asteroid belt, the region of the orbital plane of the Solar System located between the orbits of Mars and Jupiter which is occupied by numerous minor planets (asteroids) and the dwarf planet Ceres.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asthenosphere</ns0:orth>
        <ns0:pron>/asˈθɛnə(ʊ)sfɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astenosfera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) The zone of the Earth's upper mantle, below the lithosphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asthma</ns0:orth>
        <ns0:pron>/as-/</ns0:pron>
        <ns0:pron>/ɑst̪ʰ(ə)mɑ/</ns0:pron>
        <ns0:pron>/ˈasmə/</ns0:pron>
        <ns0:pron>/ˈasθmə/</ns0:pron>
        <ns0:pron>/ˈaθsmə/</ns0:pron>
        <ns0:pron>/ˈæst.mə/&lt;q:obsolete&gt;&lt;ref:{{R:Jespersen MEGoHP|I|7.736|225}}&gt;</ns0:pron>
        <ns0:pron>/ˈæzmə/</ns0:pron>
        <ns0:pron>/ˈæzðmə/</ns0:pron>
        <ns0:pron>/ˈæðzmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A long-term respiratory condition, in which the airways may unexpectedly and suddenly narrow, often in response to an allergen, cold air, exercise, or emotional stress. Symptoms include wheezing, shortness of breath, chest tightness, and coughing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asthmatic</ns0:orth>
        <ns0:pron>/æsˈmætɪk/</ns0:pron>
        <ns0:pron>/æsˈθmætɪk/</ns0:pron>
        <ns0:pron>/æzˈmætɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asmático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the characteristics of asthma, as in an "asthmatic cough".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asthmatic</ns0:orth>
        <ns0:pron>/æsˈmætɪk/</ns0:pron>
        <ns0:pron>/æsˈθmætɪk/</ns0:pron>
        <ns0:pron>/æzˈmætɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asmático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who suffers from asthma.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astigmatism</ns0:orth>
        <ns0:pron>/əˈstɪɡmətɪzm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astigmatismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(optics) A defect of a lens such that light rays coming from a point do not meet at a focal point so that the image is blurred.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(pathology) A disorder of the vision, usually due to a misshapen cornea, such that light does not focus correctly on the retina causing a blurred image.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astonish</ns0:orth>
        <ns0:pron>/əˈstɑnɪʃ/</ns0:pron>
        <ns0:pron>/əˈstɒnɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombrar</ns0:quote>
          <ns0:quote>sorprender</ns0:quote>
          <ns0:quote>pasmar</ns0:quote>
          <ns0:quote>anonadar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To surprise greatly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astonished</ns0:orth>
        <ns0:pron>/-ˈstɑ.nɪ-/</ns0:pron>
        <ns0:pron>/æ- -d/</ns0:pron>
        <ns0:pron>/əˈstɒn.ɪʃt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Amazed; surprised.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astonishing</ns0:orth>
        <ns0:pron>/əˈstɑnɪʃɪŋ/</ns0:pron>
        <ns0:pron>/əˈstɒnɪʃɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombroso</ns0:quote>
          <ns0:quote>pasmoso</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astonishment</ns0:orth>
        <ns0:pron>/əˈstɑːnɪʃmənt/</ns0:pron>
        <ns0:pron>/əˈstɒnɪʃmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sorpresa</ns0:quote>
          <ns0:quote>asombro</ns0:quote>
          <ns0:quote>estupefacción</ns0:quote>
          <ns0:quote>extrañeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The feeling or experience of being astonished; great surprise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astound</ns0:orth>
        <ns0:pron>/əˈstaʊnd/</ns0:pron>
        <ns0:pron>/əˈstæɔnd/</ns0:pron>
        <ns0:pron>/əˈstæʊnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombrar</ns0:quote>
          <ns0:quote>pasmar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To astonish, bewilder or dazzle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astounding</ns0:orth>
        <ns0:pron>/əˈstaʊndɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasmoso</ns0:quote>
          <ns0:quote>asombroso</ns0:quote>
          <ns0:quote>epatante</ns0:quote>
          <ns0:quote>sorprendente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That astounds or astound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astraddle</ns0:orth>
        <ns0:pron>/əˈstɹædəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a horcajadas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a straddling position; astride.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
