        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambulacral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an ambulacrum</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambulance</ns0:orth>
        <ns0:pron>/ˈamb(j)ʊləns/</ns0:pron>
        <ns0:pron>/ˈæm.bjə.ləns/</ns0:pron>
        <ns0:pron>/ˈæm.bjəˌlæns/</ns0:pron>
        <ns0:pron>/ˈæm.bə.ləns/</ns0:pron>
        <ns0:pron>/ˈæm.bəˌlæns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambulancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An emergency vehicle designed for transporting seriously ill or injured people to a hospital. [1854]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambulatory</ns0:orth>
        <ns0:pron>/-bjʊ-/</ns0:pron>
