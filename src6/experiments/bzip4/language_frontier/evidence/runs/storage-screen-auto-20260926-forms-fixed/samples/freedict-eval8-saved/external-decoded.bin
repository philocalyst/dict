        <ns0:pron>/əˈməʊ.nɪ.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amoníaco</ns0:quote>
          <ns0:quote>amoniaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) A gaseous, toxic compound of hydrogen and nitrogen, NH3, with a pungent smell and taste.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammoniac</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amoniacal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to ammonia, or possessing its properties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammonite</ns0:orth>
        <ns0:pron>/ˈæ.məˌnaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amonite</ns0:quote>
          <ns0:quote>amonita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(paleontology) Any of an extinct group of cephalopods of the subclass Ammonoidea; a fossil shell of such an animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammonium</ns0:orth>
        <ns0:pron>/əˈmoʊni.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amonio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic chemistry) The univalent NH4+ cation, derived by the protonation of ammonia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammonium bicarbonate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicarbonato de amonio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) NH4HCO3; a white powder with properties similar to those of ammonium carbonate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammonium bisulfate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bisulfato de amonio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammonium nitrate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nitrato de amonio</ns0:quote>
          <ns0:quote>nitrato amónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) The ammonium salt of nitric acid, NH4NO3; it is used in fertilizers and explosives (notoriously in improvised explosive devices, though its main importance is as an explosive in its own right and in mixtures such as amatol and ANFO).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammunition</ns0:orth>
        <ns0:pron>/ˌæmjuˈnɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>munición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Articles used in charging firearms and ordnance of all kinds; as powder, balls, shot, shells, percussion caps, rockets, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amnesia</ns0:orth>
        <ns0:pron>/æmˈniːz.i.ə/</ns0:pron>
        <ns0:pron>/æmˈniːʒə/</ns0:pron>
        <ns0:pron>/ˌæmˈniʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amnesia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Loss of memory; forgetfulness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amnesic</ns0:orth>
        <ns0:pron>/æmˈniːsɪk/</ns0:pron>
        <ns0:pron>/æmˈniːʒɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amnésico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, affected by, or causing amnesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amnesty</ns0:orth>
        <ns0:pron>/ˈæm.nɪ.sti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amnistía</ns0:quote>
          <ns0:quote>amnestía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An act of the sovereign power granting oblivion, or a general pardon, for a past offense, as to subjects concerned in an insurrection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amnesty</ns0:orth>
        <ns0:pron>/ˈæm.nɪ.sti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amnistiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To grant a pardon (to a group).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amnicolist</ns0:orth>
        <ns0:pron>/æmˈnɪkəlɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>costero</ns0:quote>
          <ns0:quote>costeño</ns0:quote>
          <ns0:quote>riberense</ns0:quote>
          <ns0:quote>ribereño</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amniocentesis</ns0:orth>
        <ns0:pron>/ˌam.nɪ.ə(ʊ).sɛnˈtiːs.ɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amniocentesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A procedure for obtaining amniotic fluid from a pregnant animal, by inserting a hollow needle through the abdominal wall and into the amniotic sac. Used in diagnosing possible genetic defects and/or obstetric complications, or simply to drain excess amniotic fluid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amnion</ns0:orth>
        <ns0:pron>/ˈæm.ni.ɑːn/</ns0:pron>
        <ns0:pron>/ˈæm.nɪ.ɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amnios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The innermost membrane of the fetal membranes of reptiles, birds, and mammals; the sac in which the embryo is suspended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amniotic</ns0:orth>
        <ns0:pron>/æmniˈɑtɪk/</ns0:pron>
        <ns0:pron>/æmniˈɒtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amniótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the amnion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amniotic fluid</ns0:orth>
        <ns0:pron>/ˌæm.niˈɑ.tɪk ˈflu.ɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agua del amnios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) In placental mammals, a fluid contained within the amnion membrane that surrounds a developing embryo or fetus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amniotic sac</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>saco amniótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sac in which the foetus develops in mammals, reptiles, and birds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amoeba</ns0:orth>
        <ns0:pron>/əˈmiːbə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ameba</ns0:quote>
          <ns0:quote>amiba</ns0:quote>
          <ns0:quote>amibo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A member of the genus Amoeba of unicellular protozoa that moves by means of temporary projections called pseudopodia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amoebiasis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amebiasis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) An infectious disease caused by the parasitic protozoan Entamoeba histolytica; amoebic dysentery.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amoebic</ns0:orth>
        <ns0:pron>/əˈmiːbɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amebiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, pathology) Relating to, or caused by an amoeba.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amogus</ns0:orth>
        <ns0:pron>/aˈmɔɡus/</ns0:pron>
        <ns0:pron>/əˈmoʊɡəs/</ns0:pron>
        <ns0:pron>/əˈmɑɡəs/</ns0:pron>
        <ns0:pron>/əˈmɒɡəs/</ns0:pron>
        <ns0:pron>/əˈməʊɡəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amogus</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amok</ns0:orth>
        <ns0:pron>/əˈmɒk/</ns0:pron>
        <ns0:pron>/əˈmʊk/</ns0:pron>
        <ns0:pron>/əˈmʌk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desenfrenado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a frenzy of violence, or on a killing spree; berserk.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>among</ns0:orth>
        <ns0:pron>/əˈmɒŋ/</ns0:pron>
        <ns0:pron>/əˈmʌŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Denotes a mingling or intermixing with distinct or separable objects. (See Usage Note at amidst.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amongst</ns0:orth>
        <ns0:pron>/əˈmʌŋst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Denotes a mingling or intermixing with distinct or separable objects. See usage note at amidst.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amoral</ns0:orth>
        <ns0:pron>/eɪˈmɑɹ.əl/</ns0:pron>
        <ns0:pron>/eɪˈmɒɹ.əl/</ns0:pron>
        <ns0:pron>/eɪˈmɔɹ.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amoral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of acts) Done without consideration for morality or immorality.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of people) Not believing in or caring for morality and immorality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amorous</ns0:orth>
        <ns0:pron>/ˈæ.mə.ɹəs/</ns0:pron>
        <ns0:pron>/ˈæ.mɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concupisciente</ns0:quote>
          <ns0:quote>amoroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Inclined or having a propensity to love, or to sexual enjoyment.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Indicating love or sexual desire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enamorado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Affected with love; in love; enamored.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amorously</ns0:orth>
        <ns0:pron>/ˈæ.mə.ɹəs.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amorosamente</ns0:quote>
          <ns0:quote>cariñosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an amorous or loving manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amorphism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amorfismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An amorphous quality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amorphous</ns0:orth>
        <ns0:pron>/eɪˈmɔ(ɹ)fəs/</ns0:pron>
        <ns0:pron>/əˈmɔ(ɹ)fəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amorfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lacking a definite form or clear shape.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) Being without definite character or nature.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) In the non-crystalline solid state of, or being a non-crystalline counterpart to, a crystalline solid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amortization</ns0:orth>
        <ns0:pron>/əˌmɔɹtəˈzeɪʃən/</ns0:pron>
        <ns0:pron>/əˌmɔːtaɪˈzeɪʃən/</ns0:pron>
        <ns0:pron>/əˌmɔːtəˈzeɪʃən/</ns0:pron>
        <ns0:pron>/ˌæmɚtəˈzeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amortización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The distribution of the cost of an intangible asset, such as an intellectual property right, over the projected useful life of the asset.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amortize</ns0:orth>
        <ns0:pron>/əˈmɔɹtaɪz/</ns0:pron>
        <ns0:pron>/əˈmɔːtaɪz/</ns0:pron>
        <ns0:pron>/ˈæmɚtaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amortizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(real estate, real estate law, transitive) To alienate (property) in mortmain.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(business, finance, transitive) To wipe out (a debt, liability etc.) gradually or in installments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amount</ns0:orth>
        <ns0:pron>/əˈmaʊnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>importe</ns0:quote>
          <ns0:quote>cantidad</ns0:quote>
          <ns0:quote>montante</ns0:quote>
          <ns0:quote>monto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The total, aggregate or sum of material (not applicable to discrete numbers or units or items in standard English).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cantidad</ns0:quote>
          <ns0:quote>cuantía</ns0:quote>
          <ns0:quote>montante</ns0:quote>
          <ns0:quote>monto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A quantity or volume.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amount</ns0:orth>
        <ns0:pron>/əˈmaʊnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascender / sumarse a</ns0:quote>
          <ns0:quote>equivaler</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, followed by to) To total or evaluate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>equivaler a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, followed by to) To be the tantamount to; to reach up to the level of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amoxicillin</ns0:orth>
        <ns0:pron>/əˌmɑk.sɪˈsɪl.ɪn/</ns0:pron>
        <ns0:pron>/əˌmɒk.sɪˈsɪl.ɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amoxicilina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A moderate-spectrum, bacteriolytic beta-lactam antibiotic C16H19N3O5S closely related to ampicillin and with similar properties, but more readily absorbed when taken orally. It is used to treat bacterial infections caused by susceptible microorganisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amp up</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>subir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To amplify; to increase the power, interest, intensity, volume, etc. of (something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ampelographic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ampelográfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to ampelography.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ampelography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ampelografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, oenology) The discipline within botany concerned with the taxonomy of cultivars in the grapevine genus, Vitis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ampere</ns0:orth>
        <ns0:pron>/ˈæmˌpɛər/</ns0:pron>
        <ns0:pron>/ˈæmˌpɪəɹ/</ns0:pron>
        <ns0:pron>/ˌæmˈpɪəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amperio</ns0:quote>
          <ns0:quote>ampere</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A unit of electrical current, the standard base unit in the International System of Units; colloquially amp. Abbreviation: amp, Symbol: A</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ampersand</ns0:orth>
        <ns0:pron>/ˈæm.pə(ɹ).sænd/</ns0:pron>
        <ns0:pron>/ˈæmp.ə(ɹ)ˌzænd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>et</ns0:quote>
          <ns0:quote>y comercial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The symbol "&amp;".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphetamine</ns0:orth>
        <ns0:pron>/æmˈfɛt.ə.miːn/</ns0:pron>
        <ns0:pron>/æmˈfɛt.əm.ɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfetamina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Any mixture of the two amphetamine enantiomers, dextroamphetamine and levoamphetamine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphiarthrosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfiartrosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The type of movable joint in animals in which the surfaces of bones are connected by ligaments or cartilage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphibian</ns0:orth>
        <ns0:pron>/æmˈfɪbɪən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfibio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An animal of the Amphibia; any vertebrate that does not have amniotic eggs, living both on land and in water.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A vehicle which can operate on both land and water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphibious</ns0:orth>
        <ns0:pron>[æmˈfɪbi.əs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfibio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of functioning on land or in water.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Occurring on both land and water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphibious assault ship</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>buque de asalto anfibio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphibole</ns0:orth>
        <ns0:pron>/ˈæm.fɪˌboʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfíbol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) Any of a large group of structurally similar hydrated double silicate minerals, containing various combinations of sodium, calcium, magnesium, iron, and aluminium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphibologia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfibología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) Ambiguity of grammatical structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphictyon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfictión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Ancient Greece) One of the deputies from the confederated states of Ancient Greece to a congress or council. They considered both political and religious matters.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphictyony</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfictionía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A religious foundation or co-operative shared between Greek city states during the classical period, typically to support the temple or cult of a deity shared by the city states. Also used academically to refer to similar arrangements in non-Greek cultures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphipathic</ns0:orth>
        <ns0:pron>/ˌam.fɪˈpaθ.ɪk/</ns0:pron>
        <ns0:pron>/ˌæm.fəˈpæ.θɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfipático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Describing a molecule, such as a detergent, which has both hydrophobic and hydrophilic groups.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphiphilic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfifílico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry, of a molecule) Being a detergent: having both hydrophilic and hydrophobic (or lipophilic) groups.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biochemistry, of a protein, especially an alpha helix) Having one surface consisting of hydrophilic amino acids and the opposite surface consisting of hydrophobic (or lipophilic) ones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphipod</ns0:orth>
        <ns0:pron>/ˈam.fɪ.pɑd/</ns0:pron>
        <ns0:pron>/ˈam.fɪ.pɒd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfípodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any species of the taxonomic order Amphipoda of small, shrimp-like crustaceans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphiprostyle</ns0:orth>
        <ns0:pron>/æmˈfɪpɹəˌstaɪl/</ns0:pron>
        <ns0:pron>/ˌæmfɪˈpɹoʊstaɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfipróstilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture, chiefly, historical, of a, temple, or, edifice) Having columns at either end but not along the sides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphiptere</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfíptero</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphitheatre</ns0:orth>
        <ns0:pron>/ˈæm.fəˌθi.(j)ə.tɚ/</ns0:pron>
        <ns0:pron>/ˈæm.pəˌθi.(j)ə.tɚ/</ns0:pron>
        <ns0:pron>/ˈæmfiˌθiːətə/</ns0:pron>
        <ns0:pron>/ˈæmfɪˌθiːətə/</ns0:pron>
        <ns0:pron>/ˈæmfɪˌθɪətə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfiteatro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An open, outdoor theatre (which may be a theatre in the round, or have a stage with seating on only one side), especially one from the classical period of ancient Greece or Rome, or a modern venue of similar design.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphora</ns0:orth>
        <ns0:pron>/æmˈfɔ(ː)ɹə/</ns0:pron>
        <ns0:pron>/ˈæmfəɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cántaro</ns0:quote>
          <ns0:quote>ánfora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, _, historical) A large vessel, especially a thin-necked clay vat used in ancient Greece and Rome for storing and transporting wine and oil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amphoteric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anfótero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Having the characteristics of both an acid and a base, and capable of reacting as either; amphiprotic. [from 1832]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ample</ns0:orth>
        <ns0:pron>/ˈæm.pəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundante</ns0:quote>
          <ns0:quote>amplio</ns0:quote>
          <ns0:quote>amplo</ns0:quote>
          <ns0:quote>extenso</ns0:quote>
          <ns0:quote>generoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Large; great in size, extent, capacity, or bulk; for example spacious, roomy or widely extended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amplification</ns0:orth>
        <ns0:pron>/ˌæmplɪfɪˈkeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amplificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act, or result of amplifying, enlarging, extending or adding.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(electronics) Gain.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(organic chemistry) A procedure used in the nomenclature of complex organic compounds in which the superatoms of a basic structure (a phane) are replaced by cyclic structures (amplificants).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
