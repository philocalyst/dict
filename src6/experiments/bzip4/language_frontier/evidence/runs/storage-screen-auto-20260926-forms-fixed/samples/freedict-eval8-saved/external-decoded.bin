          <ns0:quote>Golfo de México</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gulf to the south of the United States, to the east and north of Mexico, and to the north of Cuba.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gulf of Naples</ns0:orth>
      </ns0:form>
