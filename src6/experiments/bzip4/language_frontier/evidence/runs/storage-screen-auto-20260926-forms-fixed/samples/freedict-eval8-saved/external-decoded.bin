        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcabucero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, now, historical) A soldier armed with an arquebus. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arracacha</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apio criollo</ns0:quote>
          <ns0:quote>arracacha</ns0:quote>
          <ns0:quote>racacha</ns0:quote>
          <ns0:quote>apio</ns0:quote>
          <ns0:quote>arracache</ns0:quote>
          <ns0:quote>arrecate</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A South American plant grown as a root vegetable, Arracacia xanthorrhiza</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arraign</ns0:orth>
        <ns0:pron>/əˈɹeɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acusar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(with on, (archaic) for) To officially charge someone in a court of law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arraignment</ns0:orth>
        <ns0:pron>/əˈɹeɪnmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acusación</ns0:quote>
          <ns0:quote>orden de comparecencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The formal charging of a defendant with an offense; in many jurisdictions it includes their response in the form of a plea, typically as guilty, not guilty, or no contest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrange</ns0:orth>
        <ns0:pron>/əˈɹeɪnd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arreglar</ns0:quote>
          <ns0:quote>acotejar</ns0:quote>
          <ns0:quote>compaginar</ns0:quote>
          <ns0:quote>ordenar</ns0:quote>
          <ns0:quote>poner en orden</ns0:quote>
          <ns0:quote>sortear</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>organizar</ns0:quote>
          <ns0:quote>disponer</ns0:quote>
          <ns0:quote>establecer</ns0:quote>
          <ns0:quote>montar</ns0:quote>
          <ns0:quote>preparar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To set up; to organize; to put into an orderly sequence or arrangement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>organizar</ns0:quote>
          <ns0:quote>concertar</ns0:quote>
          <ns0:quote>acordar</ns0:quote>
          <ns0:quote>encargarse</ns0:quote>
          <ns0:quote>establecer</ns0:quote>
          <ns0:quote>fijar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, intransitive) To plan; to prepare in advance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arranged</ns0:orth>
        <ns0:pron>/əˈɹeɪnd͡ʒd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acordado</ns0:quote>
          <ns0:quote>arreglado</ns0:quote>
          <ns0:quote>concertado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arranged marriage</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matrimonio arreglado</ns0:quote>
          <ns0:quote>matrimonio concertado</ns0:quote>
          <ns0:quote>connubio acordado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marriage (union of people) planned by someone other than the people who are united by it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrangement</ns0:orth>
        <ns0:pron>/əˈɹeɪnd͡ʒmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arreglo</ns0:quote>
          <ns0:quote>arreglada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of arranging.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disposición</ns0:quote>
