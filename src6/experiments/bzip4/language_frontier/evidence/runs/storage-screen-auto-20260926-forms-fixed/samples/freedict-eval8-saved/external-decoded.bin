      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atraso</ns0:quote>
          <ns0:quote>espera</ns0:quote>
          <ns0:quote>retraso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Act of waiting; delay. [Attested from (1150 to 1350) to the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estadía</ns0:quote>
          <ns0:quote>permanencia</ns0:quote>
          <ns0:quote>casalicio</ns0:quote>
          <ns0:quote>morada</ns0:quote>
          <ns0:quote>residencia</ns0:quote>
          <ns0:quote>vivienda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated, or, legal) Stay or continuance in a place; sojourn. [Attested from (1350 to 1470) to the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>casalicio</ns0:quote>
          <ns0:quote>morada</ns0:quote>
          <ns0:quote>residencia</ns0:quote>
          <ns0:quote>vivienda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(formal) A residence, dwelling or habitation. [First attested from around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
