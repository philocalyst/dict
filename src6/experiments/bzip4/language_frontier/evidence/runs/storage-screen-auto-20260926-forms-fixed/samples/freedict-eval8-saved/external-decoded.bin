        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adjectival</ns0:orth>
        <ns0:pron>/ə(ɖ)ˈdʒɛkʈɪvəl/</ns0:pron>
        <ns0:pron>/ˌæ.dʒɛkˈtaɪ.vəl/</ns0:pron>
        <ns0:pron>/ˌæ.d͡ʒəkˈtaɪ.vəl/</ns0:pron>
