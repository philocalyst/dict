        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>begging the question</ns0:orth>
        <ns0:pron>/-jən/</ns0:pron>
        <ns0:pron>/ˈbɛɡɪŋ ðə ˈkwɛst͡ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>petición de principio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A logical fallacy in which a premise of an argument contains a direct or indirect assumption that the conclusion is true; offering a circular argument; circular reasoning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>begin</ns0:orth>
        <ns0:pron>/biˈɡɪn/</ns0:pron>
        <ns0:pron>/bəˈɡɪn/</ns0:pron>
        <ns0:pron>/bɪˈɡɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comenzar</ns0:quote>
          <ns0:quote>empezar</ns0:quote>
          <ns0:quote>iniciar</ns0:quote>
          <ns0:quote>principiar</ns0:quote>
          <ns0:quote>encentar</ns0:quote>
          <ns0:quote>alborear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ergative) To start, to initiate or take the first step into something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beginner</ns0:orth>
        <ns0:pron>/bəˈɡɪnɚ/</ns0:pron>
        <ns0:pron>/bɪˈɡɪnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principiante</ns0:quote>
          <ns0:quote>bisoño</ns0:quote>
          <ns0:quote>novato</ns0:quote>
          <ns0:quote>novel</ns0:quote>
          <ns0:quote>novicio</ns0:quote>
          <ns0:quote>novillo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>iniciador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who sets something in motion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beginner's luck</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>suerte de principiante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Good luck supposedly enjoyed during a beginner's first attempt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beginning</ns0:orth>
        <ns0:pron>/bɪˈɡɪn.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principio</ns0:quote>
          <ns0:quote>comienzo</ns0:quote>
          <ns0:quote>inicio</ns0:quote>
          <ns0:quote>empezamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The act of doing that which begins anything; commencement of an action, state, or space of time; entrance into being or upon a course; the first act, effort, or state of a succession of acts or states.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inicio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which is begun; a rudiment or element.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comienzo</ns0:quote>
          <ns0:quote>inicio</ns0:quote>
          <ns0:quote>origen</ns0:quote>
          <ns0:quote>empezamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which begins or originates something; the source or first cause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principio</ns0:quote>
          <ns0:quote>introito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The initial portion of some extended thing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>begonia</ns0:orth>
        <ns0:pron>/bəˈɡoʊni.ə/</ns0:pron>
        <ns0:pron>/bəˈɡəʊniː.ə/</ns0:pron>
        <ns0:pron>[bəˈɡoʊn.jə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>begonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any plant of the large genus of Begonia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>begrudging</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malvado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>grudgeful, envious</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beguile</ns0:orth>
        <ns0:pron>/bɪˈɡaɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>engañar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To deceive or delude (using guile).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cautivar</ns0:quote>
          <ns0:quote>encanto engañador</ns0:quote>
          <ns0:quote>encanto oculto</ns0:quote>
          <ns0:quote>encanto secretivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To charm, delight or captivate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beguinage</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beguinaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A walled community of small houses occupied by the Beguines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beguine</ns0:orth>
        <ns0:pron>/beɪˈɡiːn/</ns0:pron>
        <ns0:pron>/bəˈɡiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beguine</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ballroom dance, similar to a slow rumba, originally from French West Indies and popularized abroad largely through the song "Begin the Beguine"; the music for the dance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behave</ns0:orth>
        <ns0:pron>/bi-/</ns0:pron>
        <ns0:pron>/biːˈheɪv/</ns0:pron>
        <ns0:pron>/bə-/</ns0:pron>
        <ns0:pron>/bɪˈheɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportarse</ns0:quote>
          <ns0:quote>comportar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To act, conduct oneself in a specific manner; used with an adverbial of manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportarse</ns0:quote>
          <ns0:quote>portarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To act in a polite or proper way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behavior</ns0:orth>
        <ns0:pron>/bɪˈheɪ.vjə(ɹ)/</ns0:pron>
        <ns0:pron>/bɪˈheɪ.vjɚ/</ns0:pron>
        <ns0:pron>/bɪˈheːvɪjɚ/</ns0:pron>
        <ns0:pron>/bɪˈhæɪ.vjə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportamiento</ns0:quote>
          <ns0:quote>conducta</ns0:quote>
          <ns0:quote>proceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) The way a living creature behaves or acts generally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The way a device or system operates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behavioral</ns0:orth>
        <ns0:pron>/bəˈheɪvjəɹəl/</ns0:pron>
        <ns0:pron>/bəˈhæɪvjəɹəl/</ns0:pron>
        <ns0:pron>/bɪˈheɪvjəɹəl/</ns0:pron>
        <ns0:pron>/bɪˈhæɪvjəɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conductual</ns0:quote>
          <ns0:quote>del comportamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling) Of or relating to behavior.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behavioral crisis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>crisis de comportamiento</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behaviorism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conductismo</ns0:quote>
          <ns0:quote>behaviorismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An approach to psychology focusing on observable behavior which, generally assuming that behavior is determined by the environment and denying any independent significance for mind, largely ignores any pathophysiological processes which may, or may not, underlie subjective, behavioral phenomena.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behavioural science</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ciencia de la conducta</ns0:quote>
          <ns0:quote>ciencia del comportamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The systematic analysis and investigation of human and animal behaviour through controlled and naturalistic observation and disciplined scientific experimentation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behead</ns0:orth>
        <ns0:pron>/bɪˈhɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decapitar</ns0:quote>
          <ns0:quote>descabezar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To deliberately remove the head of; to cut off (someone's) head.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beheading</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decapitación</ns0:quote>
          <ns0:quote>degüello</ns0:quote>
          <ns0:quote>descabezamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instance of a person being beheaded.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behemoth</ns0:orth>
        <ns0:pron>/bəˈhi(ː).məθ/</ns0:pron>
        <ns0:pron>/ˈbiː.əˌməθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>behemot</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Bible) A great and mighty beast which God shows to Job in Job 40:15–24.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>socotroco</ns0:quote>
          <ns0:quote>zocotroco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) Something which has the qualities of great power and might, and monstrous proportions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behest</ns0:orth>
        <ns0:pron>/biˈhest/</ns0:pron>
        <ns0:pron>/biˈhɛst/</ns0:pron>
        <ns0:pron>/bɪˈhest/</ns0:pron>
        <ns0:pron>/bɪˈhɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>orden</ns0:quote>
          <ns0:quote>solicitud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A command, bidding; sometimes also, an authoritative request; now usually in the phrase at the behest of and at one's behest. [from 12th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind</ns0:orth>
        <ns0:pron>/beˈhaɪn/</ns0:pron>
        <ns0:pron>/beˈhoɪn/</ns0:pron>
        <ns0:pron>/beˈhəɪn/</ns0:pron>
        <ns0:pron>/bəˈhaɪnd/</ns0:pron>
        <ns0:pron>/bɪˈhaɪnd/</ns0:pron>
        <ns0:pron>/ˈbiːˌhaɪnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detrás</ns0:quote>
          <ns0:quote>arredro</ns0:quote>
          <ns0:quote>atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At or in the rear or back part of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind</ns0:orth>
        <ns0:pron>/beˈhaɪn/</ns0:pron>
        <ns0:pron>/beˈhoɪn/</ns0:pron>
        <ns0:pron>/beˈhəɪn/</ns0:pron>
        <ns0:pron>/bəˈhaɪnd/</ns0:pron>
        <ns0:pron>/bɪˈhaɪnd/</ns0:pron>
        <ns0:pron>/ˈbiːˌhaɪnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detrás</ns0:quote>
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>después</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At or to the back or far side of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>después</ns0:quote>
          <ns0:quote>detrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>After in physical progress or distance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>After in time.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Less forward or advanced than; after.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind bars</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entre rejas</ns0:quote>
          <ns0:quote>tras las rejas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively, idiomatic) In jail, in prison.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind closed doors</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a puerta cerrada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In private; in one's private life; lacking (normal) public disclosure, in camera.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind every successful man there stands a woman</ns0:orth>
        <ns0:pron>/bə-/</ns0:pron>
        <ns0:pron>/bɪˈhaɪnd ˌɛvɹi səkˈsɛsfl̩ ˈmæn ðɛə ˈstændz ə ˈwʊmən/</ns0:pron>
        <ns0:pron>/bɪˈhaɪnd ˌɛvɹi səkˈsɛsfl̩ ˈmæn ðɛɚ ˈstændz ə ˈwʊmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detrás de un gran hombre hay una gran mujer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A man’s achievements are made possible by the support and work of their wife or female partner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind someone's back</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a espaldas de alguien</ns0:quote>
          <ns0:quote>por la puerta de atrás</ns0:quote>
          <ns0:quote>a escondidas</ns0:quote>
          <ns0:quote>a escondidillas</ns0:quote>
          <ns0:quote>de extranjis</ns0:quote>
          <ns0:quote>de tapadillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Without somebody's knowledge; secretly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind the scenes</ns0:orth>
        <ns0:pron>/bəˈhaɪnd ðə siːnz/</ns0:pron>
        <ns0:pron>/bɪˈhaɪnd ðə siːnz/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entre bastidores</ns0:quote>
          <ns0:quote>detrás del telón</ns0:quote>
          <ns0:quote>tras bambalinas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, figurative) In secret; out of public view.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind the times</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desfasado</ns0:quote>
          <ns0:quote>obsoleto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Out of date; old-fashioned; obsolete; outmoded; outdated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behind time</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrasado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Late, arriving late.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behold</ns0:orth>
        <ns0:pron>/biˈhoʊld/</ns0:pron>
        <ns0:pron>/bɪˈhoʊld/</ns0:pron>
        <ns0:pron>/bɪˈhəʊld/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>he aquí</ns0:quote>
          <ns0:quote>mirad</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>behold</ns0:orth>
        <ns0:pron>/biˈhoʊld/</ns0:pron>
        <ns0:pron>/bɪˈhoʊld/</ns0:pron>
        <ns0:pron>/bɪˈhəʊld/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contemplar</ns0:quote>
          <ns0:quote>observar</ns0:quote>
          <ns0:quote>mirar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To look at or see (someone or something), especially appreciatively; to descry, to look upon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beholden</ns0:orth>
        <ns0:pron>/bɪˈhoʊldən/</ns0:pron>
        <ns0:pron>/bɪˈhəʉldən/</ns0:pron>
        <ns0:pron>/bɪˈhəʊldən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adeudante</ns0:quote>
          <ns0:quote>comprometido</ns0:quote>
          <ns0:quote>encalillado</ns0:quote>
          <ns0:quote>endeudado</ns0:quote>
          <ns0:quote>obligado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually with 'to') Obligated to provide, display, or do something for another; indebted, obliged for a bounden duty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beholder</ns0:orth>
        <ns0:pron>/bɪˈhoʊldɚ/</ns0:pron>
        <ns0:pron>/bɪˈhəʊldə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mirante</ns0:quote>
          <ns0:quote>observador</ns0:quote>
