      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más allá de una duda razonable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A legal standard for deciding the outcome of a criminal charge, requiring evidence that is sufficient to eliminate any doubts that a reasonable person might entertain about whether a claim is true or false.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beyond a shadow of a doubt</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin sombra de duda</ns0:quote>
          <ns0:quote>sin lugar a dudas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) Without any doubt or hesitation at all.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beyond the pale</ns0:orth>
        <ns0:pron>/biˌ(j)ɑnd ðə ˈpeɪl/</ns0:pron>
        <ns0:pron>/bɪˌjɒnd ðə ˈpeɪl/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasar de castaño oscuro</ns0:quote>
          <ns0:quote>al margen de la sociedad</ns0:quote>
          <ns0:quote>clamar al cielo</ns0:quote>
          <ns0:quote>fuera de lugar</ns0:quote>
          <ns0:quote>inaceptable</ns0:quote>
          <ns0:quote>insoportable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Of a person or their behaviour: outside the bounds of what is acceptable, or regarded as good judgment, morality, ethics, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bezant</ns0:orth>
        <ns0:pron>/ˈbɛzənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>besante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) A coin made of gold or silver, minted at Byzantium and used in currency throughout mediaeval Europe.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(heraldiccharge) A roundel or (that is, a golden circle), the heraldic representation of a gold coin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bezoar</ns0:orth>
        <ns0:pron>/ˈbi.zɔɹ/</ns0:pron>
        <ns0:pron>/ˈbiː.zɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bezoar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mass, usually of hair or undigested vegetable matter, found in a human or animal's intestines, similar to a hairball.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bhikkhu</ns0:orth>
        <ns0:pron>/ˈbɪkuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bhikkhu</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A male Buddhist monk or priest; one who follows all Buddhist precepts as a full member of the sangha.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bi</ns0:orth>
        <ns0:pron>/baɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(LGBTQ, slang) Bisexual.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bi-</ns0:orth>
        <ns0:pron>/baɪ-/</ns0:pron>
        <ns0:pron>/bɪ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bi-</ns0:quote>
          <ns0:quote>bis-</ns0:quote>
          <ns0:quote>biz-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Every two; a rate of once every two.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bi-curious</ns0:orth>
        <ns0:pron>/baiˈkjɚ.i.ɪs/</ns0:pron>
        <ns0:pron>/bʌɪˈkjɔː.ɹɪəs/</ns0:pron>
        <ns0:pron>/bʌɪˈkjʊə.ɹɪəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicurioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(LGBT) Interested in having relationships with both men and women, curious about one's potential bisexuality; especially, of heterosexual people, considering a first sexual experience with a member of the same sex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biannual</ns0:orth>
        <ns0:pron>/baɪˈænjuəl/</ns0:pron>
        <ns0:pron>/bʌɪˈanjuːəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bianual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Occurring twice a year; semiannual.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bias</ns0:orth>
        <ns0:pron>/baˈjæs/</ns0:pron>
        <ns0:pron>/ˈbajas/</ns0:pron>
        <ns0:pron>/ˈbaɪəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al bies</ns0:quote>
          <ns0:quote>al sesgo</ns0:quote>
          <ns0:quote>en diagonal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a slanting manner; crosswise; obliquely; diagonally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bias</ns0:orth>
        <ns0:pron>/baˈjæs/</ns0:pron>
        <ns0:pron>/ˈbajas/</ns0:pron>
        <ns0:pron>/ˈbaɪəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sesgo</ns0:quote>
          <ns0:quote>prejuicio</ns0:quote>
          <ns0:quote>predilección</ns0:quote>
          <ns0:quote>inclinación</ns0:quote>
          <ns0:quote>parcialidad</ns0:quote>
          <ns0:quote>predisposición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) Inclination towards something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sesgo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(statistics) The difference between the expectation of the sample estimator and the true population value, which reduces the representativeness of the estimator by systematically distorting it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biased</ns0:orth>
        <ns0:pron>/ˈbaɪəst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>parcial</ns0:quote>
          <ns0:quote>tendencioso</ns0:quote>
          <ns0:quote>sesgado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Exhibiting bias; prejudiced.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en declive</ns0:quote>
          <ns0:quote>inclinado</ns0:quote>
          <ns0:quote>ladeado</ns0:quote>
          <ns0:quote>oblicuo</ns0:quote>
          <ns0:quote>sesgado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Angled at a slant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biatch</ns0:orth>
        <ns0:pron>/ˈbi.ɑt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mujerzuela</ns0:quote>
          <ns0:quote>putilla</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biathlon</ns0:orth>
        <ns0:pron>/-lɒn/</ns0:pron>
        <ns0:pron>/baɪˈæθlən/</ns0:pron>
        <ns0:pron>/baɪˈæθˌlɑn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biatlón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(winter sports, uncountable) Racing combining cross-country skiing and rifle shooting; (countable) a particular instance of such a race.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bib</ns0:orth>
        <ns0:pron>/bɪb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>babero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An item of clothing for people (especially babies) tied around their neck to protect their clothes from getting dirty when eating.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>peto</ns0:quote>
          <ns0:quote>pechera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) A colourful polyester or plastic vest worn over one's clothes, usually to mark one's team during group activities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibimbap</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibimbap</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Korean dish of white rice topped with vegetables, beef, a whole egg, and gochujang (chili pepper paste).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bible</ns0:orth>
        <ns0:pron>/ˈbaɪbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biblia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) A comprehensive manual that describes something, or a publication with a loyal readership.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biblical</ns0:orth>
        <ns0:pron>/ˈbɪblɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bíblico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the Bible.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>In accordance with the teachings of the Bible (according to some interpretation of it).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative) Very great; especially, exceeding previous records in scale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biblically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bíblicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a biblical manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliodiversity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliodiversidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Cultural diversity as applied to the world of writing and publishing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliographic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliográfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to bibliography.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliography</ns0:orth>
        <ns0:pron>/bɪbliˈɒɡɹəfi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A section of a written work containing citations, not quotations, to all the books referred to in the work.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A list of books or documents relevant to a particular subject or author.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The study of the history of books in terms of their classification, printing and publication.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliolatry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliolatra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Specifically, excessive reverence for, or worship of, the Bible or Qur'an, especially as taken literally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliomancy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliomancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Divination by interpreting a passage chosen at random from a book, especially from the Bible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliomaniac</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliómano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is obsessed with owning books, especially valuable ones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliometric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliométrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to bibliometrics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliopegy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliopegia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliophile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliófilo</ns0:quote>
          <ns0:quote>bibliófila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who loves books.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibliophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bibliofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fear or dislike of books.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bibulous</ns0:orth>
        <ns0:pron>/ˈbɪb.jʊ.ləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escabiador</ns0:quote>
          <ns0:quote>escabio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Given to or marked by the consumption of alcoholic drink.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicameral</ns0:orth>
        <ns0:pron>/bʌɪˈkaməɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicameral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Being or having a system with two, often unequal, chambers or compartments; of, signifying, relating to, or being the product of such a two-chambered system.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(government) Of, having, or relating to two separate legislative chambers or houses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicarbonate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicarbonato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) the univalent anion HCO3-; any salt of carbonic acid in which only one of the hydrogen atoms has been replaced. [from 1814]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Sodium bicarbonate used as a mild antacid; bicarbonate of soda.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicephalous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicéfalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) Having two heads.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicephaly</ns0:orth>
        <ns0:pron>/baɪˈsɛfəli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicefalia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition of having two heads.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biceps</ns0:orth>
        <ns0:pron>/ˈbaɪ.sɛps/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bíceps</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Any muscle having two heads.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biceps brachii</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bíceps braquial</ns0:quote>
          <ns0:quote>ñeque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The flexor in the upper arm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biceps femoris</ns0:orth>
        <ns0:pron>/ˈbaɪsɛps ˈfɛmərɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bíceps femoral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The flexor of the knee, a two-headed muscle in the back of the upper leg.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicker</ns0:orth>
        <ns0:pron>/ˈbɪkə/</ns0:pron>
        <ns0:pron>/ˈbɪkɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>discutir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To quarrel in a tiresome, insulting manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bickering</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>riña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Petty quarreling.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicolour</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicolor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Commonwealth spelling) Having two colours</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicorn</ns0:orth>
        <ns0:pron>/ˈbaɪkɔɹn/</ns0:pron>
        <ns0:pron>/ˈbaɪkɔːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicornio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A two-cornered hat, worn by European and American military and naval officers from the 1790s.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biculturalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biculturalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being bicultural.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicuspid</ns0:orth>
        <ns0:pron>/baɪˈkʌspɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicúspide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tooth with two cusps; a premolar tooth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle</ns0:orth>
        <ns0:pron>/baj.sajkɪl/</ns0:pron>
        <ns0:pron>/ˈbaɪsɪk(ə)l/</ns0:pron>
        <ns0:pron>/ˈbʌɪsɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicicleta</ns0:quote>
          <ns0:quote>bici</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A vehicle that has two primary wheels, one behind the other, a steering handle, and a saddle seat or seats and is usually propelled by the action of a rider’s feet upon pedals.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension, sometimes, proscribed) Any similar vehicle powered by human pedaling or steered with a handlebar, regardless of the number of wheels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle bridge</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puente de bicicleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bridge specifically for cyclists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle carrier</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>portabicicletas</ns0:quote>
          <ns0:quote>portabicis</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle helmet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>casco de ciclismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A helmet intended to be worn while riding a bicycle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle kick</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chilena</ns0:quote>
          <ns0:quote>chalaca</ns0:quote>
          <ns0:quote>chilenita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(soccer) A kick in which the kicker leans backwards and kicks the ball back over his head.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle lane</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ciclovía</ns0:quote>
          <ns0:quote>bicisenda</ns0:quote>
          <ns0:quote>carril bici</ns0:quote>
          <ns0:quote>ciclorruta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lane of a roadway designated for use by cyclists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle path</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carril bici</ns0:quote>
          <ns0:quote>ciclovía</ns0:quote>
          <ns0:quote>sendavía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A path, segregated from other traffic, for the use of riders of bicycles</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle pump</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bomba de bicicleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A handheld pump used to inflate the tyres of bicycles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle stand</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparcabicicletas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device to which bicycles may be securely attached while not in use.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle touring</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cicloturismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Touring on a bicycle. (This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicycle tourist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cicloviajera</ns0:quote>
          <ns0:quote>cicloviajero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who travels for fun on a bicycle. (This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bicyclist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biciclista</ns0:quote>
          <ns0:quote>biciusuario</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bid</ns0:orth>
        <ns0:pron>/bɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>licitación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An offer at an auction, or to carry out a piece of work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bid</ns0:orth>
        <ns0:pron>/bɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacer una oferta</ns0:quote>
          <ns0:quote>licitar</ns0:quote>
          <ns0:quote>pujar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To make an offer to pay or accept a certain price.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ofrecer</ns0:quote>
          <ns0:quote>ofertar</ns0:quote>
          <ns0:quote>pujar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To offer as a price; to tender.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bidder</ns0:orth>
        <ns0:pron>/ˈbɪ.dɚ/</ns0:pron>
        <ns0:pron>/ˈbɪd.ə/</ns0:pron>
        <ns0:pron>[ˈbɪ.ɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>postor</ns0:quote>
          <ns0:quote>postora</ns0:quote>
          <ns0:quote>pujador</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bidding</ns0:orth>
        <ns0:pron>/ˈbɪdɪŋ/</ns0:pron>
        <ns0:pron>[ˈbɪɾɪŋ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>licitación</ns0:quote>
          <ns0:quote>puja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of placing a bid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bidding price</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
