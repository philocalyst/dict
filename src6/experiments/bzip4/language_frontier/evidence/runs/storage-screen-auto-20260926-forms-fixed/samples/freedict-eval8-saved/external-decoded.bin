          <ns0:quote>sí</ns0:quote>
          <ns0:quote>sé</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Yes; yea; a word expressing assent, or an affirmative answer to a question.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aye</ns0:orth>
        <ns0:pron>/aɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
