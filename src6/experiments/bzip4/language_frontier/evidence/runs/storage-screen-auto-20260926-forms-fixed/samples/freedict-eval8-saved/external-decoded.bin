          <ns0:quote>República Democrática Alemana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Official name of East Germany (from 1947 through reunification in 1990): a former country in Central Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
