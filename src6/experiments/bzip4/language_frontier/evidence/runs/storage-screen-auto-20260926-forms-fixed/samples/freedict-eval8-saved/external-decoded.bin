    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jewish Bolshevism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Judeo-bolchevismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(derogatory) Soviet Communism (Marxism-Leninism) when viewed by Nazis and right wing politicians, as a Jewish political ideology; Judeo-Bolshevism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
