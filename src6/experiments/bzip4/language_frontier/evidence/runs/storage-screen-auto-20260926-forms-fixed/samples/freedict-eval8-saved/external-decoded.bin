    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Fennoscandia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fenoscandia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pensinula in Northern Europe, comprising, besides the Scandinavian Peninsula, also Finland, the Kola Peninsula and Karelia (and sometimes also including Denmark, although it is not part of the Scandinavian Peninsula).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Escudo báltico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) the Fennoscandian Shield underlying Norway, Sweden, Finland, and Northern Denmark; Baltic Shield.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
