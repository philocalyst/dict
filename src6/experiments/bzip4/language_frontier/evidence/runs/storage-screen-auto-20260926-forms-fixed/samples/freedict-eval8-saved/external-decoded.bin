      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frisón occidental</ns0:quote>
          <ns0:quote>frisio occidental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A language spoken mostly in the province of Friesland, in the north of the Netherlands; one of the Frisian languages (or language varieties).</ns0:def>
        </ns0:sense>
      </ns0:sense>
