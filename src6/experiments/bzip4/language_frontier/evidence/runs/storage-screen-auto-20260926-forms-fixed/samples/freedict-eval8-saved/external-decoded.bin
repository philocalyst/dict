        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entre Escila y Caribdis</ns0:quote>
          <ns0:quote>entre la espada y la pared</ns0:quote>
          <ns0:quote>entre dos fuegos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
