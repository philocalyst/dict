      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antes de que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In advance of the time when.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antes que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Rather or sooner than.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>before</ns0:orth>
        <ns0:pron>/biˈfɔɹ/</ns0:pron>
        <ns0:pron>/bəˈfɔɹ/</ns0:pron>
        <ns0:pron>/bɪˈfo(ː)ɹ/</ns0:pron>
        <ns0:pron>/bɪˈfoə/</ns0:pron>
        <ns0:pron>/bɪˈfɔɹ/</ns0:pron>
        <ns0:pron>/bɪˈfɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antes de</ns0:quote>
          <ns0:quote>antes que</ns0:quote>
          <ns0:quote>denante</ns0:quote>
          <ns0:quote>enante</ns0:quote>
          <ns0:quote>enantes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Earlier than (in time).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ante</ns0:quote>
          <ns0:quote>frente a</ns0:quote>
          <ns0:quote>enfrente de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In front of in space.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In store for, in the future of (someone).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antes de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In front of, according to a formal system of ordering items.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
