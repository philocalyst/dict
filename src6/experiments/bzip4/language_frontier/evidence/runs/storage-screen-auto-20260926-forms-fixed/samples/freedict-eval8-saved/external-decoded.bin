        <ns0:sense>
          <ns0:def>Not composed of cells; not cellular</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acenaphthene</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acenafteno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A hydrocarbon, found in coal tar, derived from naphthalene by the addition of a short aliphatic bridge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
