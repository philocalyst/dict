        <ns0:pron>/iˈvaŋkiv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ivánkiv</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rural settlement, the administrative centre of Ivankiv settlement hromada, Vyshhorod Raion, Kyiv Oblast, Ukraine, founded in 1589.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>raión de Ivánkiv</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A former raion of Kyiv Oblast, Ukraine, established in 1923, expanded by the annexation to it of Chornobyl Raion in 1988, disestablished in July 2020.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
