    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belong</ns0:orth>
        <ns0:pron>/bɪˈlɑŋ/</ns0:pron>
        <ns0:pron>/bɪˈlɒŋ/</ns0:pron>
        <ns0:pron>/bɪˈlɔŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pertenecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(followed by to) To be a part of a group.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of a person) To be accepted in a group.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To have its proper place.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, set theory) (followed by to) To be an element of (a set). The symbol \in means belongs to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
          <ns0:quote>pertenecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, followed by to) To be part of, or the property of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>belonging</ns0:orth>
        <ns0:pron>/bɪˈlɑŋɪŋ/</ns0:pron>
        <ns0:pron>/bɪˈlɒŋɪŋ/</ns0:pron>
