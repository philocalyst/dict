      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awake</ns0:orth>
        <ns0:pron>/əˈweɪk/</ns0:pron>
        <ns0:pron>/əˈweːk/</ns0:pron>
        <ns0:pron>[əˈweːk]</ns0:pron>
        <ns0:pron>[əˈwɛːk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To become conscious after having slept.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To excite or to stir up something latent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertar</ns0:quote>
          <ns0:quote>despertarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause (somebody) to stop sleeping.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awaken</ns0:orth>
        <ns0:pron>/əˈweɪkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to become awake.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, figurative) To cause to become aware.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To stop sleeping; awake.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, figurative) To bring into action (something previously dormant); to stimulate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>awakening</ns0:orth>
        <ns0:pron>/əˈweɪ̯kənɪŋ/</ns0:pron>
