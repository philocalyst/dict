        <ns0:sense>
          <ns0:def>(book of the bible) a book of the Old Testament of Bible, and of the Tanakh</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
