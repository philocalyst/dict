        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christian</ns0:orth>
        <ns0:pron>/ˈkɹɪstiən/</ns0:pron>
        <ns0:pron>/ˈkɹɪst͡ʃən/</ns0:pron>
        <ns0:pron>/ˈkɹɪʃt͡ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cristián</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name found in England since the twelfth century.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name of medieval usage, rare today.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christian name</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nombre de pila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A first name formally given to a child at a Christian baptism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christian year</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>año litúrgico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The annual cycle of liturgical seasons in Christian churches, usually beginning from the Advent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christianity</ns0:orth>
        <ns0:pron>/ˌkɹɪstiˈænɪti/</ns0:pron>
        <ns0:pron>/ˌkɹɪst͡ʃiˈænɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cristianismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Abrahamic religion originating from the community of the followers of Jesus Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
