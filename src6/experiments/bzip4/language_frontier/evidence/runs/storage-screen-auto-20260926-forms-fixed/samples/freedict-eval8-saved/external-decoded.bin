          <ns0:quote>anormi</ns0:quote>
          <ns0:quote>anórmico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
