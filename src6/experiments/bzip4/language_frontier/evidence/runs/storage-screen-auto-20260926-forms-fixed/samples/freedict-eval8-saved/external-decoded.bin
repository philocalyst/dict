    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Demotic Greek</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>demótico</ns0:quote>
          <ns0:quote>griego demótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Modern Greek vernacular language. It became the official Modern Greek in 1976 when Katharevousa was replaced, and was written in polytonic script until 1982, and in monotonic script after 1982.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
