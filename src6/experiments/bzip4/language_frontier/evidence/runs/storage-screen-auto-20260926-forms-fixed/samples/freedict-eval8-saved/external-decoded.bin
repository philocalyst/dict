          <ns0:quote>radio</ns0:quote>
          <ns0:quote>televisión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Radio or television broadcasts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
