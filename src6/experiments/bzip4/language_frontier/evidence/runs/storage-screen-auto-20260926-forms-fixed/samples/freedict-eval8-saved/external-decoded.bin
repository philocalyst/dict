        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) The designated location for receiving checked luggage, such as the baggage carousels at an airport.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baggy</ns0:orth>
        <ns0:pron>/ˈbæɡi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>holgado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of clothing, very loose-fitting, so as to hang away from the body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bagna cauda</ns0:orth>
        <ns0:pron>/ˌbɑːnjə ˈkaʊdə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bagna cauda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hot Piedmontese dip made from salted anchovies, olive oil and garlic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bagpiper</ns0:orth>
        <ns0:pron>/ˈbæɡ.paɪ.pɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gaitero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who plays the bagpipes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bagpipes</ns0:orth>
        <ns0:pron>/ˈbæɡˌpaɪps/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gaita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A musical wind instrument possessing a flexible bag inflated by bellows, a double-reed melody pipe and up to four drone pipes; any aerophone that produces sound using air from a reservoir to vibrate enclosed reeds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baguette</ns0:orth>
        <ns0:pron>/bæˈɡɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baguette</ns0:quote>
          <ns0:quote>baguete</ns0:quote>
          <ns0:quote>barra de pan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A variety of bread that is long and narrow in shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bagworm</ns0:orth>
        <ns0:pron>/ˈbæɡ.wɜː(ɹ)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oruga de saquito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bagworm moth, any member of the family Psychidae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bah</ns0:orth>
        <ns0:pron>/bæ/</ns0:pron>
        <ns0:pron>/bɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bah</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, humorous) Expressing contempt, disgust, or bad temper.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baht</ns0:orth>
        <ns0:pron>/bɑːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baht</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The official currency of Thailand, equal to 100 satang.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baiji</ns0:orth>
        <ns0:pron>/ˈbaɪd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baiji</ns0:quote>
          <ns0:quote>delfín chino de río</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A freshwater dolphin (†Lipotes vexillifer), only found in the Yangtze River, and declared functionally extinct in 2006.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bail</ns0:orth>
        <ns0:pron>/beɪ(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fianza</ns0:quote>
          <ns0:quote>caución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) Security, usually a sum of money, exchanged for the release of an arrested person as a guarantee of that person's appearance for trial.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excarcelación provisional</ns0:quote>
          <ns0:quote>libertad bajo fianza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal, UK) Release from imprisonment on payment of such money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balde</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bucket or scoop used for removing water from a boat etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bail</ns0:orth>
        <ns0:pron>/beɪ(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>largarse</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desencarcelar</ns0:quote>
          <ns0:quote>excarcelar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To secure the release of an arrested person by providing bail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>achicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To set free; to deliver; to release.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bail bond</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fianza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A surety, used to obtain the release of a criminal defendant who has been required to give bail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bail out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pagar la fianza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To secure the release of an arrested person by providing bail money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>achicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, nautical) To remove water from a boat by scooping it out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxiliar financieramente</ns0:quote>
          <ns0:quote>rescatar</ns0:quote>
          <ns0:quote>sacar de un apuro</ns0:quote>
          <ns0:quote>socorrer financieramente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, idiomatic) To rescue, especially financially.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>saltar [del avión]</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, usually with of) To exit an aircraft while in flight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonar</ns0:quote>
          <ns0:quote>retirarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, idiomatic, slang) To leave (or not attend at all) a place or a situation, especially quickly or when the situation has become undesirable; to abandon (something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bailiff</ns0:orth>
        <ns0:pron>/ˈbeɪlɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alguacil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, Norman term) A reeve, (specifically) the chief officer executing the decisions of any English court in the period following the Norman Conquest or executing the decisions of lower courts in the late medieval and early modern period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bailiwick</ns0:orth>
        <ns0:pron>/ˈbeɪ.lɪ.wɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bailía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The district within which a bailie or bailiff has jurisdiction.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person's concern or sphere of operations, their area of skill or authority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bailout</ns0:orth>
        <ns0:pron>/ˈbeɪlˌaʊt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxilio financiero</ns0:quote>
          <ns0:quote>rescate financiero</ns0:quote>
          <ns0:quote>socorro financiero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rescue, especially a financial rescue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>suministro de escapada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(underwater diving) A backup supply of air in scuba diving.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bain-marie</ns0:orth>
        <ns0:pron>/ˌbænməˈriː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baño maría</ns0:quote>
          <ns0:quote>baño de María</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cooking) A large pan containing hot water, into which other smaller pans are set in order to cook food slowly, or to keep food warm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bait</ns0:orth>
        <ns0:pron>/beɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cebo</ns0:quote>
          <ns0:quote>carnada</ns0:quote>
          <ns0:quote>carnaza</ns0:quote>
          <ns0:quote>señuelo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any substance, especially food, used in catching fish, or other animals, by alluring them to a hook, snare, trap, or net.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anzuelo</ns0:quote>
          <ns0:quote>carnada</ns0:quote>
          <ns0:quote>carnaza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anything which allures; something or someone used to lure or entice someone or something into doing something</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bait</ns0:orth>
        <ns0:pron>/beɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cebar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attract with bait; to entice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baize</ns0:orth>
        <ns0:pron>/beɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bayeta</ns0:quote>
          <ns0:quote>tapete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A thick, soft, usually woolen cloth resembling felt; often colored green and used for coverings on card tables, billiard and snooker tables, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bake</ns0:orth>
        <ns0:pron>/beɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hornear</ns0:quote>
          <ns0:quote>enhornar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, or, intransitive, or, ditransitive, with person as subject) To cook (something) in an oven (for someone).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, with baked thing as subject) To be cooked in an oven.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baked</ns0:orth>
        <ns0:pron>/beɪkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colocado</ns0:quote>
          <ns0:quote>fumado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) Inebriated: drunk, high, or stoned.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baked beans</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baked beans</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A food consisting of beans baked or stewed in a usually tomato-based sauce.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baked good</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>masa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, in the plural) An item or class of items with a flour as a main ingredient, prepared by baking.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baker</ns0:orth>
        <ns0:pron>/ˈbeɪ.kə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbeɪ.kɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>panadero</ns0:quote>
          <ns0:quote>panadera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who bakes and sells bread, cakes and similar items.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baker's dozen</ns0:orth>
        <ns0:pron>/ˌbeɪkəz ˈdʌzən/</ns0:pron>
        <ns0:pron>/ˌbeɪkəɹz ˈdʌzən/</ns0:pron>
        <ns0:pron>[- ˈdʌzn̩]</ns0:pron>
