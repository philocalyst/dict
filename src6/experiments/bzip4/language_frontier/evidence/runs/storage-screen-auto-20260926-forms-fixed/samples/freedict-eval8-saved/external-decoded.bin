      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abominar</ns0:quote>
          <ns0:quote>detestar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To feel disgust towards; to loathe or detest thoroughly; to hate in the highest degree, as if with religious dread. [First attested in the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abomination</ns0:orth>
        <ns0:pron>/əˌbɑ.məˈneɪ.ʃən/</ns0:pron>
