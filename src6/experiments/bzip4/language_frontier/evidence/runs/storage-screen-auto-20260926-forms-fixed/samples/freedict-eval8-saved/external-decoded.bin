      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en jarras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of the arms) With a crook or bend; with the hand on the hip and elbow turned outward.</ns0:def>
