      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Bengala Occidental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state in eastern India. Capital: Kolkata (formerly Calcutta).</ns0:def>
        </ns0:sense>
