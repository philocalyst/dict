    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Dionysus</ns0:orth>
        <ns0:pron>/daɪ.əˈnaɪ.səs/</ns0:pron>
