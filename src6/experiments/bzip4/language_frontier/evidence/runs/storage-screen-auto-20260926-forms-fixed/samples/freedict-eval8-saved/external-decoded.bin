      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>japonofilo</ns0:quote>
          <ns0:quote>nipofilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who loves the country, culture, or people of Japan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Japanophilia</ns0:orth>
