        <ns0:orth>averse</ns0:orth>
        <ns0:pron>/əˈvɜː(ɹ)s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>averso</ns0:quote>
          <ns0:quote>opuesto</ns0:quote>
          <ns0:quote>reacio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a repugnance or opposition of mind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>averse</ns0:orth>
        <ns0:pron>/əˈvɜː(ɹ)s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborrecer</ns0:quote>
          <ns0:quote>execrar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aversion</ns0:orth>
        <ns0:pron>/əˈvɜʒən/</ns0:pron>
        <ns0:pron>/əˈvɜːʃən/</ns0:pron>
        <ns0:pron>/əˈvɜːʒən/</ns0:pron>
        <ns0:pron>/əˈvɝʒən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aversión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposition or repugnance of mind; fixed dislike often without any conscious reasoning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aversion therapy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>terapia de aversión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of psychological treatment in which the patient is exposed to a stimulus while simultaneously being subjected to some form of discomfort.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avert</ns0:orth>
        <ns0:pron>/əˈvɜːt/</ns0:pron>
        <ns0:pron>/əˈvɝt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apartar</ns0:quote>
          <ns0:quote>desviar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To turn aside or away.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evitar</ns0:quote>
          <ns0:quote>impedir</ns0:quote>
          <ns0:quote>prevenir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To ward off, or prevent, the occurrence or effects of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avian</ns0:orth>
        <ns0:pron>/ˈeɪvi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviano</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characteristic of or pertaining to birds, or to bird-like or flying creatures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avian influenza</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gripe aviar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Any strain of influenza carried by and primarily affecting birds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aviary</ns0:orth>
        <ns0:pron>/ˈeɪviˌɛəɹi/</ns0:pron>
        <ns0:pron>/ˈeɪvɪəɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviario</ns0:quote>
          <ns0:quote>pajarera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A house, enclosure, large cage, or other place for keeping birds confined; a birdhouse. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aviation</ns0:orth>
