        <ns0:pron>/bɑːld/</ns0:pron>
        <ns0:pron>/bɔld/</ns0:pron>
        <ns0:pron>/bɔːld/</ns0:pron>
        <ns0:pron>/bəʊld/</ns0:pron>
        <ns0:pron>[bɒʊld]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calvo</ns0:quote>
          <ns0:quote>pelón</ns0:quote>
          <ns0:quote>pelado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having little or no hair, fur, or feathers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bald eagle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
