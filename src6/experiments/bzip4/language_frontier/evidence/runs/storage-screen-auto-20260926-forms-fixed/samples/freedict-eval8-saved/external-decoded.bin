    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jack</ns0:orth>
        <ns0:pron>/d͡ʒæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacobo</ns0:quote>
          <ns0:quote>Santiago</ns0:quote>
          <ns0:quote>Diego</ns0:quote>
          <ns0:quote>Jaime</ns0:quote>
          <ns0:quote>Jacob</ns0:quote>
          <ns0:quote>Iago</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name derived from a pet form of the name John. Occasionally a diminutive of other given names such as Jackson, Jacob, Jacqueline or Jonathan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jack Russell terrier</ns0:orth>
      </ns0:form>
