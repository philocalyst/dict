    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ingvaeonic</ns0:orth>
        <ns0:pron>/ˌɪŋ.viˈɑ.nɪk/</ns0:pron>
