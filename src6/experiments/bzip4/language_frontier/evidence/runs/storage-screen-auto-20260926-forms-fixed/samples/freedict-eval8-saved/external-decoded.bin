          <ns0:quote>acetamida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The amide of acetic acid, CH3CONH2.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
