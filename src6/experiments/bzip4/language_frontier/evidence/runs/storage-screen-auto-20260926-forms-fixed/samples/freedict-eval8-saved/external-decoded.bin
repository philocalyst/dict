      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inglés escocés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A variety of the English language that is spoken mostly in Scotland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
