        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pap smear</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frotis vaginal</ns0:quote>
          <ns0:quote>papanicolau</ns0:quote>
          <ns0:quote>prueba de Papanicolau</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(gynaecology) A screening test meant to detect pre-cancerous and cancerous cells by taking a sample (‘smear’) of cells from the cervix.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pap test</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prueba de Papanicolaou</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(gynaecology) A screening test to detect pre-cancerous and cancerous cells by taking a sample ('smear') of cells from the cervix.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
