    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>between</ns0:orth>
        <ns0:pron>/biˈtwin/</ns0:pron>
        <ns0:pron>/bəˈtwin/</ns0:pron>
        <ns0:pron>/bɪˈtwin/</ns0:pron>
        <ns0:pron>/bɪˈtwiːn/</ns0:pron>
        <ns0:pron>[bɪˈtʰwin]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the position or interval that separates (two things), or intermediate in quantity or degree. (See Usage notes below.)</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Shared in confidence.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>In transit from (one to the other, or connecting places).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Combined (by effort or ownership).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>One of (representing a choice).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
