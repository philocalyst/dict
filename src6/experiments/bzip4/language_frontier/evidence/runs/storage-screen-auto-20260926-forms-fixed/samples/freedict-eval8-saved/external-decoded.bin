      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Podolsk</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Moscow Oblast, Russia.</ns0:def>
