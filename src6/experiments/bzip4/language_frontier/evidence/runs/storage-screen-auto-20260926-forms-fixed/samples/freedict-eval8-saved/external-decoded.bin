      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea de bajo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basso continuo</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajo continuo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The continuous realization of harmony throughout a musical piece, usually by a harpsichord and/or cello, typical of the Baroque period. Abbreviation: bc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bassoon</ns0:orth>
        <ns0:pron>/bəˈsun/</ns0:pron>
        <ns0:pron>/bəˈsuːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fagot</ns0:quote>
          <ns0:quote>bajón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A musical instrument in the woodwind family, having a double reed and playing in the tenor and bass ranges.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bassoonist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fagotista</ns0:quote>
          <ns0:quote>fagot</ns0:quote>
          <ns0:quote>bajón</ns0:quote>
          <ns0:quote>bajonista</ns0:quote>
          <ns0:quote>piporro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who plays the bassoon, a musical instrument in the woodwind family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basswood</ns0:orth>
        <ns0:pron>/ˈbæswʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) Any of several trees of the genus Tilia; the lindens, especially Tilia americana, the American basswood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basta</ns0:orth>
        <ns0:pron>/ˈbɑstɑ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary, poetic) (that's) enough; stop!</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bastard</ns0:orth>
        <ns0:pron>/ˈbæs.tæd/</ns0:pron>
        <ns0:pron>/ˈbæs.tɚd/</ns0:pron>
        <ns0:pron>/ˈbɑːs.təd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bastardo</ns0:quote>
          <ns0:quote>bastarda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) A person who was born out of wedlock, and hence often considered an illegitimate descendant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hijo de puta</ns0:quote>
          <ns0:quote>cabrón</ns0:quote>
          <ns0:quote>desgraciado</ns0:quote>
          <ns0:quote>tipejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(vulgar,, _, , _, offensive, or, pejorative) A contemptible, inconsiderate, overly or arrogantly rude or spiteful person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bastardo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A child who does not know its father.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bastard sugar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azúcar sin cristalizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An impure light brown sugar containing molasses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baste</ns0:orth>
        <ns0:pron>/beɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hilvanar</ns0:quote>
          <ns0:quote>embastar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To sew with long or loose stitches, as for temporary use, or in preparation for gathering the fabric.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baster</ns0:orth>
        <ns0:pron>/ˈbeɪstə/</ns0:pron>
        <ns0:pron>/ˈbeɪstɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bombilla</ns0:quote>
          <ns0:quote>cuentagotas</ns0:quote>
          <ns0:quote>gotero</ns0:quote>
          <ns0:quote>inyector</ns0:quote>
          <ns0:quote>jeringa culinaria</ns0:quote>
          <ns0:quote>pera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tool for basting meat with fat or gravy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bastille</ns0:orth>
        <ns0:pron>/bæˈstil/</ns0:pron>
        <ns0:pron>/bæˈstiːl/</ns0:pron>
        <ns0:pron>/bɑː-/</ns0:pron>
        <ns0:pron>/ˈbæstɪl/</ns0:pron>
        <ns0:pron>/ˈbɑː-/</ns0:pron>
        <ns0:pron>[bæˈstɪəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fortaleza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Chiefly in French contexts: a bastion or tower of a castle; also, a fortified tower or other building; or a small citadel or fortress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bastion</ns0:orth>
        <ns0:pron>/ˈbæsti.ən/</ns0:pron>
        <ns0:pron>/ˈbæst͡ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bastión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A projecting part of a rampart or other fortification.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A well-fortified position; a stronghold or citadel.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figuratively) A person, group, or thing, that strongly defends some principle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bat</ns0:orth>
        <ns0:pron>/bæt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>murciélago</ns0:quote>
          <ns0:quote>bate</ns0:quote>
          <ns0:quote>bat</ns0:quote>
          <ns0:quote>batear</ns0:quote>
          <ns0:quote>chinacate</ns0:quote>
          <ns0:quote>fonguear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any flying mammal of the order Chiroptera, usually small and nocturnal, insectivorous or frugivorous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(derogatory) An old woman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>murciélago</ns0:quote>
          <ns0:quote>bate</ns0:quote>
          <ns0:quote>bat</ns0:quote>
          <ns0:quote>chinacate</ns0:quote>
          <ns0:quote>morciguillo</ns0:quote>
          <ns0:quote>murceguillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A club made of wood or aluminium used for striking the ball in sports such as baseball, softball and cricket.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batear</ns0:quote>
          <ns0:quote>fonguear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A turn at hitting the ball with a bat in a game.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bat</ns0:orth>
        <ns0:pron>/bæt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To hit with a bat or (figuratively) as if with a bat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>murciélago</ns0:quote>
          <ns0:quote>bate</ns0:quote>
          <ns0:quote>bat</ns0:quote>
          <ns0:quote>chinacate</ns0:quote>
          <ns0:quote>fonguear</ns0:quote>
          <ns0:quote>morciguillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To take a turn at hitting a ball with a bat in sports like cricket, baseball and softball, as opposed to fielding.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bat an eyelid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inmutarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, chiefly in the negative) To react in any slight way; to respond; to care.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bat one's eyes</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacer ojitos</ns0:quote>
          <ns0:quote>pestañear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To signal or feign by fluttering one's eyelids, as romantic interest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batard</ns0:orth>
        <ns0:pron>/bæˈtɑːd/</ns0:pron>
        <ns0:pron>/bəˈtɑɹd/</ns0:pron>
        <ns0:pron>/ˈbætɑːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batarda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A loaf of bread similar in shape to a baguette, but shorter (15 to 30 cm / 6 to 12 inches in length).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batch</ns0:orth>
        <ns0:pron>/bæt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hornada</ns0:quote>
          <ns0:quote>horneada</ns0:quote>
          <ns0:quote>tanda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quantity of bread or other baked goods baked at one time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lote</ns0:quote>
          <ns0:quote>tanda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) A quantity of anything produced at one operation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>juego</ns0:quote>
          <ns0:quote>lote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group or collection of things of the same kind, such as a batch of letters or the next batch of business.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lote</ns0:quote>
          <ns0:quote>procesamiento por lotes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A set of data to be processed at one time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batch processing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>procesamiento por lotes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) the execution of a series of programs on a computer, called jobs, without manual intervention</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bath</ns0:orth>
        <ns0:pron>/bæθ/</ns0:pron>
        <ns0:pron>/bɐːθ/</ns0:pron>
        <ns0:pron>/bɑːθ/</ns0:pron>
        <ns0:pron>[baθ~bäθ]</ns0:pron>
        <ns0:pron>[bäːt̪]</ns0:pron>
        <ns0:pron>[bäːt̪ʰ]</ns0:pron>
        <ns0:pron>[bæθ~bɛəθ~beəθ]</ns0:pron>
        <ns0:pron>[bɑːθ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bañera</ns0:quote>
          <ns0:quote>baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tub or pool which is used for bathing: bathtub.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baño</ns0:quote>
          <ns0:quote>cuarto de baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A building or area where bathing occurs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of bathing; an instance of this; the taking of a bath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bath</ns0:orth>
        <ns0:pron>/bæθ/</ns0:pron>
        <ns0:pron>/bɐːθ/</ns0:pron>
        <ns0:pron>/bɑːθ/</ns0:pron>
        <ns0:pron>[baθ~bäθ]</ns0:pron>
        <ns0:pron>[bäːt̪]</ns0:pron>
        <ns0:pron>[bäːt̪ʰ]</ns0:pron>
        <ns0:pron>[bæθ~bɛəθ~beəθ]</ns0:pron>
        <ns0:pron>[bɑːθ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bañar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, Commonwealth) To wash a person or animal in a bath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bath salt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sal de baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, in the plural) Any of several inorganic salts sometimes added to bath water.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(slang, psychedelic drug culture) Any of a class of methylenedioxypyrovalerone-based psychoactive recreational drugs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bath towel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>toalla de baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A towel used to dry the body after bathing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathe</ns0:orth>
        <ns0:pron>/beð/</ns0:pron>
        <ns0:pron>/beɪð/</ns0:pron>
        <ns0:pron>/bɑð/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bañar</ns0:quote>
          <ns0:quote>bañarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To clean oneself by immersion in water or using water; to take a bath, have a bath.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To clean a person by immersion in water or using water; to give someone a bath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lavar</ns0:quote>
          <ns0:quote>bañar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To apply water or other liquid to; to suffuse or cover with liquid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bather</ns0:orth>
