        <ns0:pron>/ɑːkiːˈɒptəɹɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archaeopteryx</ns0:quote>
          <ns0:quote>arqueoptérix</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(paleontology) A specimen of the species Archaeopteryx lithographica, being the earliest and most primitive known bird, representing a transition in the evolution of dinosaurs to birds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
