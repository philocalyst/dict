          <ns0:quote>triángulo acutángulo</ns0:quote>
          <ns0:quote>triángulo agudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) A triangle all of the angles of which are acute.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acute-phase protein</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reactante de fase aguda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry, immunology) Any of a class of proteins whose plasma concentrations change in response to inflammation, such as C-reactive protein.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acutely</ns0:orth>
