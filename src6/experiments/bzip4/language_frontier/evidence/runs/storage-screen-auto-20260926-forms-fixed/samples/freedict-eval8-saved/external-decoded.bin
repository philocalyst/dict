          <ns0:quote>Romeo y Julieta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pair of lovers, particularly if they are young, visibly enamored, and come from families or groups that are on opposing sides of a dispute.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
