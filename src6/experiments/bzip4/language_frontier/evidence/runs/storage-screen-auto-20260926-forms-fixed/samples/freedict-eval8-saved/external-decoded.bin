      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any diether of a geminal diol, R2C(OR')2 (where R' is not H).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetaldehyde</ns0:orth>
        <ns0:pron>/ˌæs.ɪˈtæl.dəˌhaɪd/</ns0:pron>
