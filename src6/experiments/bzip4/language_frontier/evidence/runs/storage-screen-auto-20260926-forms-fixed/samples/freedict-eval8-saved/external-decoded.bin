    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Yellow River</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>río Amarillo</ns0:quote>
          <ns0:quote>Huang He</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The chief river of the North China Plain, the second-longest river in China and sixth-longest river system on Earth, historically prone to massive floods which repeatedly drastically changed its course; it passes through Qinghai, Sichuan, Gansu, Shaanxi, Shanxi, Henan and Shandong provinces as well as Ningxia and Inner Mongolia Autonomous Regions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
