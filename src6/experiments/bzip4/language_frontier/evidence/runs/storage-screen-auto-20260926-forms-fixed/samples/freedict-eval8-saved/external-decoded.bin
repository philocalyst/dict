          <ns0:quote>Imperio alemán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former German empire and country that existed between 1871 and 1918. Capital: Berlin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
