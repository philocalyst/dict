        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acalasia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ache</ns0:orth>
        <ns0:pron>/ˈeɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dolor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Continued dull pain, as distinguished from sudden twinges, or spasmodic pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ache</ns0:orth>
        <ns0:pron>/ˈeɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>doler</ns0:quote>
          <ns0:quote>sufrir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, stative) To suffer pain; to be the source of, or be in, pain, especially continued dull pain; to be distressed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ache for</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhelar</ns0:quote>
          <ns0:quote>ansiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To desire or want something, or someone, very much.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achene</ns0:orth>
        <ns0:pron>/əˈkiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aquenio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A small, dry, indehiscent fruit, containing a single seed, as in the buttercup.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achievable</ns0:orth>
        <ns0:pron>/əˈt͡ʃivəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lograble</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being achieved, which either means possible or probable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achieve</ns0:orth>
        <ns0:pron>/əˈt͡ʃiːv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lograr</ns0:quote>
          <ns0:quote>conseguir</ns0:quote>
          <ns0:quote>realizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To carry out successfully; to accomplish. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conseguir</ns0:quote>
          <ns0:quote>lograr</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To obtain, or gain (a desired result, objective etc.), as the result of exertion; to succeed in gaining; to win. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achievement</ns0:orth>
        <ns0:pron>/əˈt͡ʃiːv.mənt/</ns0:pron>
        <ns0:pron>[əˈt͡ʃʰiːv.mɪ̈nt̚]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>logro</ns0:quote>
          <ns0:quote>conquista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of achieving or performing; a successful performance; accomplishment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gesta</ns0:quote>
          <ns0:quote>hazaña</ns0:quote>
          <ns0:quote>hombrada</ns0:quote>
          <ns0:quote>proeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A great or heroic deed or feat; something accomplished by valor or boldness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>logro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(video games) An award for completing a particular task or meeting an objective in a video game.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aching</ns0:orth>
        <ns0:pron>/ˈeɪ.kɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adolorado</ns0:quote>
          <ns0:quote>adolorido</ns0:quote>
          <ns0:quote>doliente</ns0:quote>
          <ns0:quote>dolorido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That aches; continuously painful; that causes pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achondrite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acondrita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy, geology) Any stony meteorite that contains no chondrules.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achondritic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acondrítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) Of or pertaining to achondrites, a type of stony meteorite.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achondroplasia</ns0:orth>
        <ns0:pron>/-ʒ(i)ə/</ns0:pron>
        <ns0:pron>/eɪˌkɒndɹə(ʊ)ˈpleɪziə/</ns0:pron>
        <ns0:pron>/ə-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acondroplasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(teratology) A genetic disorder, the most common form of short limb dwarfism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achoo</ns0:orth>
        <ns0:pron>/ɑːˈt͡ʃuː/</ns0:pron>
        <ns0:pron>/ɑːˈt͡ʃʰuː/</ns0:pron>
        <ns0:pron>/əˈt͡ʃuː/</ns0:pron>
        <ns0:pron>/əˈt͡ʃʰuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>achís</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(onomatopoeia) The sound of a sneeze.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achromatic</ns0:orth>
        <ns0:pron>/ˌeɪ.kɹəˈmæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌæk.ɹəˈmæt.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(optics) Free from color; transmitting light without color-related distortion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Containing components such as achromatic lenses and prisms, designed to prevent color-related distortion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology, of tissue) Uncolored; not absorbing color from a fluid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achromatism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromatismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Achromatopia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>achromotrichia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromotriquia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The absence (or loss) of pigmentation in the hair.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acid</ns0:orth>
        <ns0:pron>/ˈæsɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido</ns0:quote>
          <ns0:quote>agrio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sour, sharp, or biting to the taste; tart; having the taste of vinegar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malhumorado</ns0:quote>
          <ns0:quote>ácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Sour-tempered.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an acid; acidic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acid</ns0:orth>
        <ns0:pron>/ˈæsɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sour substance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chemistry)</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, slang) LSD, lysergic acid diethylamide.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acid mordant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mordiente ácido</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acid rain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lluvia ácida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Rain which is unusually acidic (pH of less than the natural range of 5 to 6); caused mainly by atmospheric pollution with sulphur dioxide, carbon dioxide and nitrogen compounds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acid reflux</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidez gastroesofágica</ns0:quote>
          <ns0:quote>acidez gástrica</ns0:quote>
          <ns0:quote>reflujo ácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Reflux of stomach acid into the esophagus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acid test</ns0:orth>
        <ns0:pron>/ˌæsɪd ˈtɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prueba de fuego</ns0:quote>
          <ns0:quote>prueba del algodón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A rigorous test or appraisal of the quality or worth of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidic</ns0:orth>
        <ns0:pron>/əˈsɪdɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Having a pH less than 7, or being sour, or having the strength to neutralize alkalis, or turning a litmus paper red.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or relating to acid; having the character of an acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidification</ns0:orth>
        <ns0:pron>/əˌsɪdɪfɪˈkeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of making something sour (acidifying), or changing into an acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidify</ns0:orth>
        <ns0:pron>/əˈsɪdɪfaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make something (more) acidic or sour; to convert into an acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidimeter</ns0:orth>
        <ns0:pron>/ˌæsəˈdɪmətə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidímetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) An instrument for ascertaining the strength of acids.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidimetry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidimetría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) The measurement of the strength of acids, especially by a chemical process based on the law of chemical combinations, or the fact that, to produce a complete reaction, a certain definite weight of reagent is required.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidity</ns0:orth>
        <ns0:pron>/əˈsɪdɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality or state of being acid.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Sourness; tartness; sharpness to the taste.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidophile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidófilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An organism that lives and thrives under acidic conditions; a form of extremophile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidophilia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidofilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>affinity for acidic conditions</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acidosis</ns0:orth>
        <ns0:pron>/ˌæs.ɪˈdoʊ.sɪs/</ns0:pron>
        <ns0:pron>/ˌæs.ɪˈdəʉ.sɪs/</ns0:pron>
        <ns0:pron>/ˌæs.ɪˈdəʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) An abnormally increased acidity of the blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acinaces</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acinaces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A short sword or saber.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ackee</ns0:orth>
        <ns0:pron>/əˈkiː/</ns0:pron>
        <ns0:pron>/ˈækiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>akí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tropical evergreen tree, Blighia sapida, related to the lychee and longan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acknowledge</ns0:orth>
        <ns0:pron>/əkˈnɑ.lɪd͡ʒ/</ns0:pron>
        <ns0:pron>/əkˈnɒl.ɪd͡ʒ/</ns0:pron>
        <ns0:pron>[əkˈnɑ.ləd͡ʒ]</ns0:pron>
        <ns0:pron>[əkˈnɒɫ.ɪd͡ʒ]</ns0:pron>
        <ns0:pron>[əɡˈnɑ.ləd͡ʒ]</ns0:pron>
        <ns0:pron>[əɡˈnɒɫ.ɪd͡ʒ]</ns0:pron>
        <ns0:pron>[ɪkˈnɑ.lɪd͡ʒ]</ns0:pron>
        <ns0:pron>[ɪɡˈnɑ.ləd͡ʒ]</ns0:pron>
        <ns0:pron>[ɪɡˈnɑ.lɪd͡ʒ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acatar</ns0:quote>
          <ns0:quote>aceptar</ns0:quote>
          <ns0:quote>admitir</ns0:quote>
          <ns0:quote>reconocer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To admit the knowledge of; to recognize as a fact or truth; to declare one's belief in.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acatar</ns0:quote>
          <ns0:quote>reconocer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To own or recognize in a particular quality, character or relationship; to admit the claims or authority of; to give recognition to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acusar recibo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To own as genuine or valid; to assent to (a legal instrument) to give it validity; to avow or admit in legal form.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acknowledged</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptado</ns0:quote>
          <ns0:quote>admitido</ns0:quote>
          <ns0:quote>reconocido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Generally accepted, recognized or admitted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acknowledgment</ns0:orth>
        <ns0:pron>/əkˈnɑ.lɪd͡ʒ.mənt/</ns0:pron>
        <ns0:pron>/əkˈnɒl.ɪd͡ʒ.mənt/</ns0:pron>
        <ns0:pron>/əɡˈnɑ.lɪd͡ʒ.mənt/</ns0:pron>
        <ns0:pron>/əɡˈnɒl.ɪd͡ʒ.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reconocimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of acknowledging</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aclinic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclínico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) Without inclination or dipping.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acme</ns0:orth>
        <ns0:pron>/ˈæk.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acmé</ns0:quote>
          <ns0:quote>apogeo</ns0:quote>
          <ns0:quote>cúspide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A high point: the highest point of any range, the most developed stage of any process, or the culmination of any field or historical period. [c. 1610]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acne</ns0:orth>
        <ns0:pron>/ˈakne/&lt;a:Indic&gt;</ns0:pron>
        <ns0:pron>/ˈækni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acné</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pattern of blemishes in an area of skin resulting from the skin condition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acne mechanica</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acné mecánico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Acne caused by mechanical irritation of the skin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoelomate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelomado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) Having no coelom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acolyte</ns0:orth>
        <ns0:pron>/ˈæ.kə.laɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acólito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) One who has received the highest of the four minor orders in the Catholic Church, being ordained to carry the wine, water and lights at Mass.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ayudante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An attendant, assistant, or follower.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aconite</ns0:orth>
        <ns0:pron>/ˈæ.kə.naɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acónito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The herb wolfsbane, or monkshood; any plant of the genus Aconitum, all the species of which are poisonous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acorn</ns0:orth>
        <ns0:pron>/ˈeɪ.kɔɹn/</ns0:pron>
        <ns0:pron>/ˈeɪ.kɔːn/</ns0:pron>
        <ns0:pron>/ˈeɪkɚn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bellota</ns0:quote>
          <ns0:quote>lande</ns0:quote>
          <ns0:quote>llande</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) A cone-shaped piece of wood on the point of the spindle above the vane, on the mast-head.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acorn squash</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calabaza bellota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several varieties of a plant, Cucurbita pepo, being a dark green winter squash having yellow to orange flesh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acorn woodpecker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carpintero bellotero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A woodpecker native to the area from the southwestern United States to Colombia, of species Melanerpes formicivorus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acotyledon</ns0:orth>
        <ns0:pron>/ˈeɪ.kɔt.l̩.iːdˌn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acotiledón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A plant that has no cotyledons, as the dodder and all flowerless plants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acotyledonous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acotiledóneo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having no seed lobes, as the dodder; also applied to plants which have no true seeds, as ferns, mosses, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoustic</ns0:orth>
        <ns0:pron>/əˈkuː.stɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acústico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the sense of hearing, the organs of hearing, or the science of sounds.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) Naturally producing or produced by an instrument without electrical amplification or the need thereof.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoustic</ns0:orth>
        <ns0:pron>/əˈkuː.stɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acústica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, in the plural) The properties or qualities of a room or building that determine how sound is transmitted in it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoustic guitar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guitarra acústica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hollow-body guitar of the older variety, in contradistinction to an electric guitar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoustical</ns0:orth>
        <ns0:pron>/əˈkuː.stɪk.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acústico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to hearing or acoustics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoustically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acústicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(manner) In an acoustic manner, or using an acoustic musical instrument.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acoustics</ns0:orth>
        <ns0:pron>/əˈkuː.stɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acústica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The science of sounds, teaching their nature, phenomena and laws.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acqua alta</ns0:orth>
        <ns0:pron>/ˌækwə ˈæltə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acqua alta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A phenomenon that regularly occurs in the city of Venice, Italy, typically during high and spring tide, involving the flooding of the most low-lying areas of Venice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquaint</ns0:orth>
        <ns0:pron>/əˈkweɪnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dar a conocer</ns0:quote>
          <ns0:quote>familiarizar</ns0:quote>
          <ns0:quote>presentar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, followed by with) To furnish or give experimental knowledge of; to make (one) know; to make familiar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>familiarizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To familiarize; to accustom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquaintance</ns0:orth>
        <ns0:pron>/əˈkweɪntəns/</ns0:pron>
        <ns0:pron>/ʌˈkweɪn.təns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amistad</ns0:quote>
          <ns0:quote>conocimiento</ns0:quote>
          <ns0:quote>junta</ns0:quote>
          <ns0:quote>relación</ns0:quote>
          <ns0:quote>trato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A state of being acquainted with a person; originally indicating friendship, intimacy, but now suggesting a slight knowledge less deep than that of friendship; acquaintanceship. [from 12th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conocido</ns0:quote>
          <ns0:quote>conocida</ns0:quote>
          <ns0:quote>amiguete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A person or persons with whom one is acquainted. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquainted</ns0:orth>
        <ns0:pron>/əˈkweɪntɪd/</ns0:pron>
        <ns0:pron>/əˈkwæɪntəd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conocido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often followed by with) Personally known; familiar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquiesce</ns0:orth>
        <ns0:pron>/ˌækwiˈɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aquiescer</ns0:quote>
          <ns0:quote>conformar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, with in or to (or sometimes with)) To rest satisfied, or apparently satisfied, or to rest without opposition and discontent (usually implying previous opposition or discontent); to accept or consent by silence or by omitting to object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consentir</ns0:quote>
          <ns0:quote>aquiescer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To concur upon conviction; to accept tacitly; to assent to; usually, to concur, not heartily but so far as to forbear opposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquiescence</ns0:orth>
        <ns0:pron>/ˌæk.wiːˈɛs.əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aquiescencia</ns0:quote>
          <ns0:quote>consentimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A silent or passive assent or submission, or a submission with apparent consent, distinguished from avowed consent on the one hand, and on the other, from opposition or open discontent; quiet satisfaction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Inaction, passivity, or neglect to take legal action when it is called for in order to assert, preserve, or safeguard a right, and which inaction implies the abandonment of said right.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquiescent</ns0:orth>
        <ns0:pron>/æˈkwi.ɛsn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aquiescente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>willing to acquiesce, accept or agree to something without objection, protest or resistance</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquirable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquirible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being acquired.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquire</ns0:orth>
        <ns0:pron>/əˈkwaɪə/</ns0:pron>
        <ns0:pron>/əˈkwaɪɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquirir</ns0:quote>
          <ns0:quote>obtener</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To gain, usually by one's own exertions; to get as one's own.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquired</ns0:orth>
        <ns0:pron>/əˈkwaɪəd/</ns0:pron>
        <ns0:pron>/əˈkwaɪɹd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquirido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Developed after birth; not congenital.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquired immune deficiency syndrome</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>síndrome de inmunodeficiencia adquirida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) An infectious disease, caused by HIV, that causes the gradual degeneration of the body's immune system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquis communautaire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Acervo comunitario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The full body of European Union law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquisition</ns0:orth>
        <ns0:pron>/ˌæk.wəˈzɪʃ.ən/</ns0:pron>
        <ns0:pron>/ˌæk.wɪˈzɪʃ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquisición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of acquiring.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The thing acquired or gained; a gain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquisitive</ns0:orth>
        <ns0:pron>/əˈkwɪzətɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquisitivo</ns0:quote>
          <ns0:quote>codicioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able or disposed to make acquisitions; acquiring, greedy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquisitor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquirente</ns0:quote>
          <ns0:quote>adquiriente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who acquires.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquit</ns0:orth>
        <ns0:pron>/əˈkwɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolver</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To declare or find innocent or not guilty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolver</ns0:quote>
          <ns0:quote>exculpar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To discharge (for example, a claim or debt); to clear off, to pay off; to fulfil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>exculpar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) to discharge, release, or set free from a burden, duty, liability, or obligation, or from an accusation or charge. [with of or (formerly) from]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acquittal</ns0:orth>
        <ns0:pron>/əˈkwɪ.d(ə)l/</ns0:pron>
        <ns0:pron>/əˈkwɪ.t(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absolución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A legal decision that someone is not guilty with which they have been charged, or the formal dismissal of a charge by some other legal process. [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrasia</ns0:orth>
        <ns0:pron>/-ˈkɹæ-/</ns0:pron>
        <ns0:pron>/əˈkɹeɪ.zi.ə/</ns0:pron>
        <ns0:pron>/əˈkɹeɪ.zɪ.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, rare) Lack of self-control; excess, intemperance; also, irregular or unruly behaviour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acre</ns0:orth>
        <ns0:pron>/ˈeɪ.kə/</ns0:pron>
        <ns0:pron>/ˈeɪ.kɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various similar units of area in other systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acreage</ns0:orth>
        <ns0:pron>/ˈeɪk(ə)ɹɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>superficie medida en acres</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An area of land measured in acres.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrid</ns0:orth>
        <ns0:pron>/ˈæk.ɹɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acre</ns0:quote>
          <ns0:quote>mordaz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) Caustic; bitter; bitterly irritating.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrimonious</ns0:orth>
        <ns0:pron>/-ɹə-/</ns0:pron>
        <ns0:pron>/ˌæk.ɹɪˈmoʊ.ni.əs/</ns0:pron>
        <ns0:pron>/ˌæk.ɹɪˈməʊ.nɪ.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cáustico</ns0:quote>
          <ns0:quote>sarcástico</ns0:quote>
          <ns0:quote>áspero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Angry, acid, and sharp in delivering argumentative replies: bitter, mean-spirited, sharp in language or tone. [from early 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrimoniously</ns0:orth>
        <ns0:pron>/ˌæk.ɹɪˈmoʊ.ni.əsli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enconadamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an acrimonious manner; with acrimony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrimony</ns0:orth>
        <ns0:pron>/ˈækɹɪmoʊni/</ns0:pron>
        <ns0:pron>/ˈækɹɪməni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrimonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sharp and bitter hatred.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acritarch</ns0:orth>
        <ns0:pron>/ˈækɹɪtɑː(ɹ)k/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acritarco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(paleontology, palynology) Any small, non-acid-soluble (i.e. non-carbonate, non-siliceous) organic fossil that cannot be classified.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acroamatic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lectivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(education) Based on lectures or exposition by monologue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrobat</ns0:orth>
        <ns0:pron>/ˈæk.ɹə.bæt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acróbata</ns0:quote>
          <ns0:quote>equilibrista</ns0:quote>
          <ns0:quote>saltimbanqui</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An athlete who performs acts requiring skill, agility and coordination, often as part of a circus performance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrobatic</ns0:orth>
        <ns0:pron>/ˌækɹəˈbætɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrobático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an acrobat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrobatically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrobáticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an acrobatic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrobatics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrobacia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The art of performing acrobatic gymnastic feats.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrocyanosis</ns0:orth>
        <ns0:pron>/ˌæ.kɹoʊˌsaɪ.əˈnoʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrocianosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A persistent blue or cyanotic discoloration of the digits, most commonly occurring in the hands although also occurring in the face and feet as well.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrolect</ns0:orth>
        <ns0:pron>/ˈæk.ɹə.lɛkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrolecto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sociolinguistics) The variety of speech that is considered most suitable for formal occasions (typically using only standard forms).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrolein</ns0:orth>
        <ns0:pron>/əˈkɹoʊliɪn/</ns0:pron>
        <ns0:pron>/əˈkɹəʊliɪn/</ns0:pron>
        <ns0:pron>/ˈækɹəliːn/</ns0:pron>
        <ns0:pron>/ˈækɹəˌlin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acroleína</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A pungent, acrid, poisonous liquid aldehyde, CH2=CH-CH=O, made by the destructive distillation of glycerol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acromegalic</ns0:orth>
        <ns0:pron>/ˌakɹə(ʊ)mɪˈɡalɪk/</ns0:pron>
        <ns0:pron>/ˌækɹoʊmɪˈɡælɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromegálico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Pertaining to or characteristic of acromegaly. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acromegaly</ns0:orth>
        <ns0:pron>/ˌækɹoʊˈmɛɡəli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromegalia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) A chronic disease marked by enlargement of the bones of the extremities, face, and jaw that is caused by over-activity of the pituitary gland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acromial</ns0:orth>
        <ns0:pron>/əˈkɹoʊ.mi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromial</ns0:quote>
          <ns0:quote>acromiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the acromion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acromion</ns0:orth>
        <ns0:pron>/əˈkɹoʊ.mi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acromion</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The outermost point of the shoulder blade.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acronym</ns0:orth>
        <ns0:pron>/ˈæk.ɹə.nɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrónimo</ns0:quote>
          <ns0:quote>sigla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) An abbreviation formed by the initial letters of other words.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acronymization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acronimia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act, process, or result of turning a phrase into an acronym.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acropolis</ns0:orth>
        <ns0:pron>/əˈkɹɒpəlɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrópolis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A promontory (usually fortified with a citadel) forming the hub of many Grecian cities, and around which many were built for defensive purposes before and during the classical period; compare Acropolis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>across</ns0:orth>
        <ns0:pron>/əˈkɹɑs/</ns0:pron>
        <ns0:pron>/əˈkɹɒs/</ns0:pron>
        <ns0:pron>/əˈkɹɔs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a través</ns0:quote>
          <ns0:quote>de través</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From one side to the other.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>across</ns0:orth>
        <ns0:pron>/əˈkɹɑs/</ns0:pron>
        <ns0:pron>/əˈkɹɒs/</ns0:pron>
        <ns0:pron>/əˈkɹɔs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al otro lado de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On the opposite side of (something that lies between two points of interest).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a través de</ns0:quote>
          <ns0:quote>al otro lado de</ns0:quote>
          <ns0:quote>cruzando</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Southern US, AAVE) across from: on the opposite side, relative to something that lies between, from (a point of interest).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a través de</ns0:quote>
          <ns0:quote>atravesado</ns0:quote>
          <ns0:quote>cruzando</ns0:quote>
          <ns0:quote>entre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From one side to the other within (a space being traversed).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>across the board</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>generalizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Pertaining to all categories or things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>across the pond</ns0:orth>
        <ns0:pron>/əˈkɹɑs ðə ˈpɑnd/</ns0:pron>
        <ns0:pron>/əˌkɹɒs ðə ˈpɒnd/</ns0:pron>
        <ns0:pron>/əˌkɹɔs ðə ˈpɑnd/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al otro lado del charco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) On or to the other side of the Atlantic Ocean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrostic</ns0:orth>
        <ns0:pron>/əˈkɹɑstɪk/</ns0:pron>
        <ns0:pron>/əˈkɹɒstɪk/</ns0:pron>
        <ns0:pron>/əˈkɹɔstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acróstico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A poem or other text in which certain letters, often the first in each line, spell out a name or message. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrostical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acróstico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Like an acrostic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrylamide</ns0:orth>
        <ns0:pron>/əˈkɹɪləmaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrilamida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The amide of acrylic acid, CH2=CH.CONH2; used in the manufacture of polyacrylamides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrylate</ns0:orth>
        <ns0:pron>/ˈækɹɪleɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrilato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any salt or ester of acrylic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrylic</ns0:orth>
        <ns0:pron>/əˈkɹɪl.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrílico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Derived from acrylic acid or acrylonitrile.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Containing an acrylic resin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrylic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido acrílico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrylic resin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrílico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of many thermoplastic or thermosetting polymers or copolymers of acrylic acid, methacrylic acid, esters of these acids, or acrylonitrile; used in paint and many plastics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acrylonitrile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrilonitrilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A toxic colourless liquid organic compound, CH2=CH.CN, synthesized from propylene and ammonia; used as a monomer in the production of acrylic resins and synthetic rubber.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>act</ns0:orth>
        <ns0:pron>/æk/</ns0:pron>
        <ns0:pron>/ækt/</ns0:pron>
        <ns0:pron>[akt]</ns0:pron>
        <ns0:pron>[ækt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Something done, a deed.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, drama) A division of a theatrical performance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A display of behaviour.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(law) Ellipsis of act of parliament.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law, countable) A product of a legislative body, a statute.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acto</ns0:quote>
          <ns0:quote>acción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of doing something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hecho</ns0:quote>
          <ns0:quote>acta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A formal or official record of something done.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>act</ns0:orth>
        <ns0:pron>/æk/</ns0:pron>
        <ns0:pron>/ækt/</ns0:pron>
        <ns0:pron>[akt]</ns0:pron>
        <ns0:pron>[ækt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete, transitive) To do (something); to perform.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To behave in a certain manner for an indefinite length of time.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, law) To carry out work as a legal representative in relation to a particular legal matter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuar</ns0:quote>
          <ns0:quote>comportar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, mathematics, construed with on or upon, of an algebraic structure) To possess an action onto (some other structure). Examples include the group action of a group on a set, the action of a ring on a module by scalar multiplication, and the action of a group or algebra on a vector space via a representation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>act of God</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuerza mayor</ns0:quote>
          <ns0:quote>caso fortuito</ns0:quote>
          <ns0:quote>cosa de Dios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) An unforeseen occurrence beyond one's control, such as a natural disaster.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>act on</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuar en base a</ns0:quote>
          <ns0:quote>actuar en contra de</ns0:quote>
          <ns0:quote>reaccionar ante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To act decisively on the basis of information received or deduced.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuar en contra de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To act accordingly to a (usually sublimated) desire or impulse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuar de acuerdo con</ns0:quote>
          <ns0:quote>actuar en contra de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To take action against something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuar en contra de</ns0:quote>
          <ns0:quote>actuar sobre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) To affect something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>act one's age</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comportarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(imperative, originally, US) To behave in a mature manner; to avoid being childish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) Any of the participants, such as the subject or object, in a grammatical clause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actin</ns0:orth>
        <ns0:pron>/ˈæktɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein, uncountable) A globular structural protein that polymerizes in a helical fashion to form an actin filament (or microfilament).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acting</ns0:orth>
        <ns0:pron>/ˈæk.tɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>interino</ns0:quote>
          <ns0:quote>en funciones</ns0:quote>
          <ns0:quote>suplente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Temporarily assuming the duties or authority of another person when they are unable to do their job.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acting</ns0:orth>
        <ns0:pron>/ˈæk.tɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actuación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, drama) The occupation of an actor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinic</ns0:orth>
        <ns0:pron>/ækˈtɪn ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actínico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry, photography) Of or relating to actinism, the range of photochemical effects produced by exposure to electromagnetic radiation, particularly sunlight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinide</ns0:orth>
        <ns0:pron>/ˈæktɪnaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actínido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Any of the 15 radioactive elements of the periodic table from actinium to lawrencium that are positioned under the lanthanides, to which they have similar chemistry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry, physics) That property of electromagnetic radiation that leads to the production of photochemical effects</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinium</ns0:orth>
        <ns0:pron>/ækˈtɪniəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A radioactive, metallic chemical element (symbol: Ac) with an atomic number of 89; found in uranium ores.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinobiology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinobiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of the effects of radiation upon living organisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinolite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinolita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A mineral with monoclinic crystals of the chemical formula Ca2(Mg,Fe)5Si8O22(OH)2, belonging to the amphibole group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinometer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A device used to measure the heating power of electromagnetic radiation, especially that of solar radiation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinometric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinométrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to actinometry</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinomorphic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinomorfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, of a flower) Having its petals arranged in a radially symmetric fashion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actinomycosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actinomicosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) An infectious bacterial disease of cattle and swine, sometimes transmitted to humans, characterized by the formation of painful abscesses in the mouth, lungs, or gastrointestinal tract, caused by Actinomyces israelii, Actinomyces gerencseriae, and Propionibacterium propionicum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action</ns0:orth>
        <ns0:pron>/ˈæk.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Demanding or signifying the start of something, usually a performance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action</ns0:orth>
        <ns0:pron>/ˈæk.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something done, often so as to accomplish a purpose.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A way of motion or functioning.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Fast-paced activity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(military) Combat.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(legal) A charge or other process in a law court (also called lawsuit and actio).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) A way in which each element of some algebraic structure transforms some other structure or set, in a way which respects the structure of the first. Formally, this may be seen as a morphism from the first structure into some structure of endomorphisms of the second; for example, a group action of a group G on a set S can be seen as a group homomorphism from G into the set of bijections on S (which form a group under function composition), while a module M over a ring R can be defined as an abelian group together with a ring homomorphism from R into the ring of group endomorphisms of M (which is also called the action of R on M).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(literature) The event or connected series of events, either real or imaginary, forming the subject of a play, poem, or other composition; the unfolding of the drama of events.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action at a distance</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acción a distancia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action figure</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>figura de acción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A children's toy in the form of a posable plastic figurine of a character, often from a movie, video game, or television program, with moving parts and often capable of some form of spring-loaded movement. It is used to distinguish from dolls, which have acquired the reputation as a girl's toy, whereas action figures are more marketed toward boys.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action movie</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>película de acción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A motion picture whose storyline involves fast-paced activity and conflict, usually including such elements as a heroic protagonist, violent fights, acrobatic stunts, chase scenes, and gunplay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action plan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plan de acción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A planned series of actions, tasks or steps designed to achieve an objective or goal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>action replay</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>repetición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In TV broadcasting, the reshowing of a short segment of action, especially slow-motion sporting action, shortly after it was broadcast live or in real-time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actionable</ns0:orth>
        <ns0:pron>/ˈæk.ʃə.nə.bəl/&lt;a:US&gt;</ns0:pron>
        <ns0:pron>/ˈæk.ʃən.ə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accionable</ns0:quote>
          <ns0:quote>agible</ns0:quote>
          <ns0:quote>ejecutable</ns0:quote>
          <ns0:quote>factible</ns0:quote>
          <ns0:quote>hacedero</ns0:quote>
          <ns0:quote>realizable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be acted on; able to be used as the basis for taking action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>justiciable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Affording grounds for legal action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actions speak louder than words</ns0:orth>
        <ns0:pron>/-d̪an-/</ns0:pron>
        <ns0:pron>/-ðən-/</ns0:pron>
        <ns0:pron>/ˈak.ʃi̯onz spiːk ˈlawɖ.əʳ ˌd̪an wəːʳɖz/</ns0:pron>
        <ns0:pron>/ˈak.ʃənz spik ˈlʌʊ̯d.əɹ ˌðan wʌɹdz/</ns0:pron>
        <ns0:pron>/ˈak.ʃənz spiːk ˈlaʊ̯d.ə ˌðan wɜːdz/&lt;q:contemporary&gt;</ns0:pron>
        <ns0:pron>/ˈæk.ʃənz spik ˈlaʊ̯d.əɹ ˌðæn wɜɹdz/</ns0:pron>
        <ns0:pron>/ˈæk.ʃənz spiːk ˈlaʊ̯d.ə ˌðæn wɜːdz/&lt;q:conservative&gt;</ns0:pron>
        <ns0:pron>/ˈæk.ʃənz spiːk ˈlæɔ̯d.ə ˌðæn wɜːdz/</ns0:pron>
        <ns0:pron>/ˈɛk.ʃənz spiːk ˈlæʊ̯d.a ˌðɛn wøːdz/</ns0:pron>
        <ns0:pron>/ˈɛk.ʃənz spiːk ˈlæʊ̯d.ɐ ˌðɛn wøːdz/</ns0:pron>
        <ns0:pron>/ˈɛk.ʃənz spiːk ˈlæʊ̯d.ə ˌðɛn wøːdz/</ns0:pron>
        <ns0:pron>;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>obras son amores, que no buenas razones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>It is more effective to act directly than to speak of action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el movimiento se demuestra andando</ns0:quote>
          <ns0:quote>por sus frutos los conoceréis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An individual's actions indicate their true sentiments more reliably than their claims do.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activate</ns0:orth>
        <ns0:pron>/ˈæktɪˌveɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put a device, mechanism (alarm etc.) or system into action or motion; to trigger, to actuate, to set off, to enable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activated carbon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carbón activado</ns0:quote>
          <ns0:quote>carbón grafitizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very absorbent form of finely powdered carbon; used in purifying gases, and as an antidote for many poisons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activation</ns0:orth>
        <ns0:pron>/ˌæktəˈveɪʃən/</ns0:pron>
        <ns0:pron>/ˌæktɪˈveɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Making active and effective; bringing into a state of activity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) The process of making a radioisotope by bombarding a stable element with neutrons or protons.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biochemistry) The process by which molecules are made able to react.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activation analysis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análisis por activación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physical chemistry) Any of several similar radiochemical techniques of analysis in which a subatomic particle or gamma ray is captured by a nuclide to form a second stable nuclide which is then measured.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activation function</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>función de activación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computer science) A function that defines the output of a particular node in an artificial neural network on the basis of its inputs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any chemical or agent which regulates one or more genes by increasing the rate of transcription.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>active</ns0:orth>
        <ns0:pron>/ˈæk.tɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the power or quality of acting; causing change; communicating action or motion; acting;—opposed to passive, that receives.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Quick in physical movement; of an agile and vigorous body; nimble.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>In action; actually proceeding; working; in force</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Given to action rather than contemplation; practical; operative</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>active ingredient</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principio activo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmacology) The specific compound in a natural or man-made mixture that is responsible for the mixture's activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>active listening</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escucha activa</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>active transport</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>transporte activo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cytology) Movement of ions or molecules across a cell membrane into a region of higher concentration, assisted by enzymes and requiring energy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>active voice</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>voz activa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar, uncountable) The form in which the subject of a verb carries out some action.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>active volcano</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>volcán activo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(vulcanology, geology) A volcano that has erupted in the last 10,000 years, although not necessarily venting lava or gases now.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actively</ns0:orth>
        <ns0:pron>/ˈæktɪvli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activamente</ns0:quote>
          <ns0:quote>enérgicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an active manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) In the active form; not passive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activism</ns0:orth>
        <ns0:pron>/ˈæk.tɪ.vɪ.zəm/</ns0:pron>
        <ns0:pron>[ˈæk.tɪ.vɪ.zm̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The practice of using action to achieve a result, such as political demonstration or a strike in support of or in opposition to an issue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activist</ns0:orth>
        <ns0:pron>/ˈæk.tɪ.vɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>activista</ns0:quote>
          <ns0:quote>militante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is politically active in the role of a citizen; especially, one who campaigns for change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>activity</ns0:orth>
        <ns0:pron>/ækˈtɪv.ə.ti/</ns0:pron>
        <ns0:pron>/ækˈtɪv.ɪ.ti/</ns0:pron>
        <ns0:pron>/ækˈtɪv.ɪ.tiː/</ns0:pron>
        <ns0:pron>[ækˈtɪv.ə.ɾi]</ns0:pron>
        <ns0:pron>[ækˈtɪv.ɪ.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actividad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The state or quality of being active; activeness.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Something done as an action or a movement.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Something done for pleasure or entertainment, especially one involving movement or an excursion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The property of substances to react with other substances</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actogram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actograma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A graphical representation of the activity of an animal that has been isolated from environmental cues as to the time of day.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actomyosin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actomiosina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein) A protein complex composed of actin and myosin, found in muscle fibres.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actor</ns0:orth>
        <ns0:pron>/ˈak.tə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæk.tɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actor</ns0:quote>
          <ns0:quote>actriz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who acts a part in a theatrical play or (later) in film or television; a dramatic performer. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actress</ns0:orth>
        <ns0:pron>/ˈæk.tɹɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>actriz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, _, rare) A female doer or "actor" (in a general sense). [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actual</ns0:orth>
        <ns0:pron>/ˈaktʃʊwəl/</ns0:pron>
        <ns0:pron>/ˈæktjəl/</ns0:pron>
        <ns0:pron>/ˈæktjʊəl/</ns0:pron>
        <ns0:pron>/ˈæktʃuəl/</ns0:pron>
        <ns0:pron>/ˈæktʃəl/</ns0:pron>
        <ns0:pron>/ˈækʃuəl/</ns0:pron>
        <ns0:pron>/ˈækʃəl/</ns0:pron>
        <ns0:pron>/ˈæt͡ʃəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concreto</ns0:quote>
          <ns0:quote>en sí</ns0:quote>
          <ns0:quote>propio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>real</ns0:quote>
          <ns0:quote>verdadero</ns0:quote>
          <ns0:quote>efectivo</ns0:quote>
          <ns0:quote>existente</ns0:quote>
          <ns0:quote>realmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Existing in reality, not just potentially; really acted or acting; occurring in fact. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>real</ns0:quote>
          <ns0:quote>actual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, rare) in action at the time being; now existing; current. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actuality</ns0:orth>
        <ns0:pron>/ˌækt͡ʃuˈælɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>realidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of existing; existence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actually</ns0:orth>
        <ns0:pron>/ˈat͡ʃ.li/</ns0:pron>
        <ns0:pron>/ˈæk.t͡ʃ(u.)(ə.)li/</ns0:pron>
        <ns0:pron>/ˈæk.t͡ʃə.li/</ns0:pron>
        <ns0:pron>/ˈæk.t͡ʃʊ.ə.li/</ns0:pron>
        <ns0:pron>/ˈæk.ʃ(u.)(ə.)li/</ns0:pron>
        <ns0:pron>/ˈæk.ʃə.li/</ns0:pron>
        <ns0:pron>/ˈæk.ʃʊ.ə.li/</ns0:pron>
        <ns0:pron>/ˈæt͡ʃ.u.li/</ns0:pron>
        <ns0:pron>/ˈæt͡ʃ.ə.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>realmente</ns0:quote>
          <ns0:quote>en realidad</ns0:quote>
          <ns0:quote>de hecho</ns0:quote>
          <ns0:quote>de veras</ns0:quote>
          <ns0:quote>de verdad</ns0:quote>
          <ns0:quote>de vero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(modal) In act or in fact; really; in truth; positively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>actuarial</ns0:orth>
        <ns0:pron>/æk.tjuˈɛəɹ.i.əl/</ns0:pron>
        <ns0:pron>/ækˈt͡ʃuː.ɹiːəl/</ns0:pron>
