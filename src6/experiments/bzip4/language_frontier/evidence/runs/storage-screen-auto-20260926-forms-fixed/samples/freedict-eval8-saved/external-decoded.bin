          <ns0:quote>barba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Facial hair on the chin, cheeks, jaw and neck.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jotera</ns0:quote>
          <ns0:quote>pantalla</ns0:quote>
          <ns0:quote>tapadera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(LGBTQ) A woman who accompanies a gay man, or a man who accompanies a lesbian, in order to give the impression that the person being accompanied is heterosexual.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
