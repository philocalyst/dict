      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from Czech, notably borne by Jan Hus, a Czech religious reformer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hussite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>husita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of the teachings of the Christian reformer Jan Hus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hvidovre</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hvidovre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Denmark.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyacinth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacinto</ns0:quote>
          <ns0:quote>Jacinta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name. One of the less common flower names used since the 19th century.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyacinthus</ns0:orth>
        <ns0:pron>/ˌhaɪəˈsɪnθəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacinto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A Spartan youth loved and accidentally killed by Apollo. The flower hyacinth sprang from his blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyades</ns0:orth>
        <ns0:pron>/ˈhaɪ.ədiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Híades</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) Daughters of the Titan Atlas and sisters of the Pleiades.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) An open cluster of stars in the constellation Taurus, and the nearest visible such cluster to Earth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyblaean Mountains</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Montes Ibleos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mountain range in south-eastern Sicily.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyderabad</ns0:orth>
        <ns0:pron>/ˈhaɪdəɹəbɑːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hyderabad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital and largest city of Telangana, India.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hydra</ns0:orth>
        <ns0:pron>/ˈhaɪ̯dɹə/</ns0:pron>
        <ns0:pron>[ˈhaɪ̯dɹə]</ns0:pron>
        <ns0:pron>[ˈhaɪ̯d͡ʒɹə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hidra de Lerna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A mythological serpent with many heads, slain by Hercules as one of his twelve labours.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hydra</ns0:quote>
          <ns0:quote>Hidra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A spring constellation of the northern sky, said to resemble a serpent. It lies just south of the zodiac and contains the star Alphard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hidra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) One of Pluto's moons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hydrus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hydrus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A winter constellation of the southern sky, said to resemble a small serpent. It lies between the constellations Mensa and Tucana. It is not to be confused with the constellation Hydra.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hygieia</ns0:orth>
        <ns0:pron>/haɪˈd͡ʒiː.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Higía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The goddess and personification of health and healthiness, a daughter of Asclepius and Epione.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyperion</ns0:orth>
        <ns0:pron>/haɪˈpɪəɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hiperión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) A Titan, the son of Gaia and Uranus and the father of Helios, Selene and Eos.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) One of the moons of Saturn.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hypnos</ns0:orth>
        <ns0:pron>/ˈhɪpnoʊs/</ns0:pron>
        <ns0:pron>/ˈhɪpnɒs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hipnos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The god and personification of sleep. The son of Nyx and Erebus, twin brother of Thanatos, husband of Pasithea, and the father of the Oneiroi. His Roman counterpart is Somnus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hyrcania</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hircania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A region in the southeastern Caspian Sea, corresponding to parts of modern-day Iran (specifically Northern Iran) and Turkmenistan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I</ns0:orth>
        <ns0:pron>/aɪ/</ns0:pron>
        <ns0:pron>/aː/</ns0:pron>
        <ns0:pron>/oɪ/</ns0:pron>
        <ns0:pron>/ɐɪ/</ns0:pron>
        <ns0:pron>/əɪ/</ns0:pron>
        <ns0:pron>/ɛɪ/</ns0:pron>
        <ns0:pron>[aj]</ns0:pron>
        <ns0:pron>[aɪ]</ns0:pron>
        <ns0:pron>[aː]</ns0:pron>
        <ns0:pron>[äj]</ns0:pron>
        <ns0:pron>[äɪ]</ns0:pron>
        <ns0:pron>[æj]</ns0:pron>
        <ns0:pron>[ɐɪ]</ns0:pron>
        <ns0:pron>[ɑe̯]</ns0:pron>
        <ns0:pron>[ɑj]</ns0:pron>
        <ns0:pron>[ɑɪ]</ns0:pron>
        <ns0:pron>[əj]</ns0:pron>
        <ns0:pron>[ʌj]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>yo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The speaker or writer, referred to as the grammatical subject, of a sentence.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(nonstandard) The speaker or writer, referred to as the grammatical object, of a sentence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I am English</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy inglesa</ns0:quote>
          <ns0:quote>soy inglés</ns0:quote>
          <ns0:quote>yo soy británica</ns0:quote>
          <ns0:quote>yo soy británico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is from England.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I am HIV positive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy seropositivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is a carrier of the human immunodeficiency virus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I am a doctor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy médico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I am a doctor (a physician, a member of the medical profession)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I am afraid of this</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>miedo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I came, I saw, I conquered</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vine, vi y vencí</ns0:quote>
          <ns0:quote>llegué, vi y vencí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I have gained a total and swift victory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I can't find my ...</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no puedo encontrar mi ...</ns0:quote>
          <ns0:quote>no puedo encontrar mis ...</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Said after losing something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I can't swim</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no sé nadar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates the speaker does not know how to swim.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I could eat a horse</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo más hambre que el perro de un ciego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, hyperbole) I am very hungry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I do</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sí, acepto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A traditional phrase said by each of the prospective spouses during a wedding ceremony in order to accept the marriage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't care</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>me importa un carajo</ns0:quote>
          <ns0:quote>no me importa</ns0:quote>
          <ns0:quote>me da igual</ns0:quote>
          <ns0:quote>me suda el coño</ns0:quote>
          <ns0:quote>me suda la polla</ns0:quote>
          <ns0:quote>me suda los cojones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has no interest or emotional investment in the topic at hand.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chiefly, Southern US) Indicates agreement or polite acceptance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't drive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no conduzco</ns0:quote>
          <ns0:quote>no manejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I don't drive (a car, a vehicle)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't eat fish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no como pescado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker does not eat fish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't eat meat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no como carne</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker does not eat meat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't eat pork</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no como carne de cerdo</ns0:quote>
          <ns0:quote>no como cerdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker does not eat pork.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't have all day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no tengo todo el día</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to say that you want someone to do something faster because you do not have enough time to wait for them to finish</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't know</ns0:orth>
        <ns0:pron>[ɑ̈ɪ̯ (ɾ)oʊ̯̃(ʔ)(t̚) noʊ̯]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo ignoro</ns0:quote>
          <ns0:quote>no lo sé</ns0:quote>
          <ns0:quote>no sé</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used other than figuratively or idiomatically: see I,‎ don't,‎ know.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't know about that</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no sé si es para tanto</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't speak English</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no hablo español</ns0:quote>
          <ns0:quote>no hablo inglés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is unable to speak the English language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't think so</ns0:orth>
        <ns0:pron>/aɪ dəʊnt θɪŋk səʊ/</ns0:pron>
        <ns0:pron>/aː doʊnt θɪŋk soʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creo que no</ns0:quote>
          <ns0:quote>pienso que no</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I think what has been said is untrue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no creo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sarcastic) No, absolutely not (used to refuse or decline something proposed).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't understand</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no comprendo</ns0:quote>
          <ns0:quote>no entiendo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is not understanding the current subject or situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't want it</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no lo quiero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker does not want to take something that is being offered.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't want to buy anything</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no quiero comprar nada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I don't want to buy anything</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I don't want to talk about it</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no quiero hablar de eso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker does not want to discuss a particular topic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I hate you</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo odio</ns0:quote>
          <ns0:quote>los odio</ns0:quote>
          <ns0:quote>os odio</ns0:quote>
          <ns0:quote>te odio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Expression of hatred, or intense disdain or dislike directed at someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have AIDS</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo sida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has acquired immune deficiency syndrome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have a cold</ns0:orth>
        <ns0:pron>/aɪ hæv ə koʊld/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estoy resfriada</ns0:quote>
          <ns0:quote>estoy resfriado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I am suffering from a cold.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have a fever</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo fiebre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has an abnormally high body temperature, which is usually a symptom of a disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have a headache</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>me duele la cabeza</ns0:quote>
          <ns0:quote>tengo dolor de cabeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker's head hurts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have a question</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo una duda</ns0:quote>
          <ns0:quote>tengo una pregunta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker wants to ask a question.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have asthma</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo asma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is afflicted with asthma</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have cancer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo cáncer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is afflicted with some form of cancer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have diabetes</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo diabetes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has diabetes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have high blood pressure</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo la presión alta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has hypertension (high blood pressure).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have low blood pressure</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo la tensión baja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has hypotension (low blood pressure).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have never</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>yo nunca nunca</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I have no money</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no tengo dinero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has no money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I hope I may be shot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ojalá fuese / fuera disparado</ns0:quote>
          <ns0:quote>ojalá me disparasen / dispararan</ns0:quote>
          <ns0:quote>ojalá me disparen</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I hope you're happy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espero que estés feliz</ns0:quote>
          <ns0:quote>ojalá estés feliz</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I kid you not</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no bromeo</ns0:quote>
          <ns0:quote>no es broma</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I know</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo sé</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A response used to indicate that speaker was in agreement with the preceding statement before it was made.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya sé</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An emphatic assertion that one has a solution, an answer, or an idea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I know you are but what am I?</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el burro hablando de orejas</ns0:quote>
          <ns0:quote>el comal le dijo a la olla</ns0:quote>
          <ns0:quote>mira quién habla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetorical question, colloquial, childish) Assertion that an insult made by the party to whom the phrase is directed is actually true of that party, and not of the person using the phrase. Usually considered to be a playground taunt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I like you</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>me agrada</ns0:quote>
          <ns0:quote>me agradas</ns0:quote>
          <ns0:quote>me gusta</ns0:quote>
          <ns0:quote>me gustas</ns0:quote>
          <ns0:quote>te quiero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker likes the interlocutor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I live in Melbourne</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vivo en Melbourne</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Explains that the person lives in Melbourne (example city).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I lost my backpack</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perdí mi mochila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has lost his or her backpack.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I lost my glasses</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>se me perdieron mis gafas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has lost his or her glasses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I lost my handbag</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perdí mi bolso</ns0:quote>
          <ns0:quote>perdí mi cartera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has lost his or her handbag.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I lost my keys</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perdí mis llaves</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) Indicates that the speaker has lost his or her keys.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I lost my wallet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perdí mi billetera</ns0:quote>
          <ns0:quote>perdí mi cartera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker has lost his or her wallet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I love you</ns0:orth>
        <ns0:pron>/aɪ ˈlʊv juː/</ns0:pron>
        <ns0:pron>/aɪ ˈlʌv juː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>te amo</ns0:quote>
          <ns0:quote>los adoro</ns0:quote>
          <ns0:quote>los amo</ns0:quote>
          <ns0:quote>os adoro</ns0:quote>
          <ns0:quote>os amo</ns0:quote>
          <ns0:quote>te adoro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An affirmation of affection or deep caring, especially to a family member.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>te amo</ns0:quote>
          <ns0:quote>te quiero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An affirmation of romantic feeling to a lover or spouse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>me caes bien</ns0:quote>
          <ns0:quote>me gustas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A platonic expression of strong inclination or liking to a friend.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I miss you</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>te echo de menos</ns0:quote>
          <ns0:quote>te extraño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expression of sorrow or sadness about the absence of a family member, close friend, lover or spouse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I must go</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo que irme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I must leave</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I need ...</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>necesito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I need a guide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>necesito un guía</ns0:quote>
          <ns0:quote>necesito una guía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker needs a person to guide him or her.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>necesito una guía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker needs a book or document to guide him or her.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I need to vomit</ns0:orth>
        <ns0:pron>/aɪ nid tu ˈvɑmit/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo que vomitar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(This entry is a translation hub.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I rest my case</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no hay más preguntas, señoría</ns0:quote>
          <ns0:quote>no tengo más preguntas, señoría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) My argument is proven; I conclude my statement.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(idiomatic) The previous encapsulates my view.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I see</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya veo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I spy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>veo veo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(games) A game where players have to guess what one can see, based on the initial letter of the object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I tell a lie</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>miento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, British, idiomatic) I am mistaken; I thought that what I said (or wrote) was true, but I have just realised that it is not.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I think so</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>creo que sí</ns0:quote>
          <ns0:quote>pienso que sí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I believe that is the case, but am not certain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I think, therefore I am</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pienso, luego existo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy) I am able to think, therefore I exist. A philosophical proof of existence based on the fact that someone capable of any form of thought necessarily exists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I told you so</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya te lo dije</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, ironic) Used to remind someone that they were already warned by the speaker or writer that a certain event would happen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I want to go to the toilet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quiero ir al baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker feels the urge to go the toilet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I want to know</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quiero saber</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A request for information.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I was born in ...</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nací en ...</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I was born in ... (year).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>I was born in ... (place name).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I wish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ojalá</ns0:quote>
          <ns0:quote>si</ns0:quote>
          <ns0:quote>si tan siquiera</ns0:quote>
          <ns0:quote>si tan solo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, colloquial) Used to express the speaker's wish that the preceding statement were true</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I wish I may be shot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deseo que fuese / fuera disparado</ns0:quote>
          <ns0:quote>deseo que me disparasen / dispararan</ns0:quote>
          <ns0:quote>deseo que me disparen</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'd like to kiss you</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>me gustaría besarle</ns0:quote>
          <ns0:quote>me gustaría besarte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to ask to kiss a person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'd like to know</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>me gustaría saber</ns0:quote>
          <ns0:quote>quisiera saber</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A polite request for information.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'll call the police</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>llamaré a la policía</ns0:quote>
          <ns0:quote>voy a llamar a la policía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is going to call the police, presumably to counter actions from the interlocutor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'm ... year(s) old</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tengo ... abriles</ns0:quote>
          <ns0:quote>tengo ... años</ns0:quote>
          <ns0:quote>tengo ... años de edad</ns0:quote>
          <ns0:quote>tengo ... primaveras</ns0:quote>
          <ns0:quote>tengo ... tacos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>I was born ... year(s) ago.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'm American</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy estadounidense</ns0:quote>
          <ns0:quote>soy norteamericana</ns0:quote>
          <ns0:quote>soy norteamericano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is American.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'm Hindu</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy hindú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is a follower of Hinduism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>I'm Jewish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy judía</ns0:quote>
          <ns0:quote>soy judío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicates that the speaker is of Jewish ethnic descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
