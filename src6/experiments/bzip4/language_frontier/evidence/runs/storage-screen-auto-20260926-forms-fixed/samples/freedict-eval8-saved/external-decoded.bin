    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beached</ns0:orth>
        <ns0:pron>/biːt͡ʃt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>varado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Stranded and helpless, especially on a beach</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beachhead</ns0:orth>
        <ns0:pron>/ˈbiːt͡ʃhɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cabeza de playa</ns0:quote>
          <ns0:quote>punto de apoyo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) An initial success that ensures the possibility of further advances in a project; a foothold.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beacon</ns0:orth>
        <ns0:pron>/ˈbiːkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almenara</ns0:quote>
          <ns0:quote>baliza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A signal fire to notify of the approach of an enemy, or to give any notice, commonly of warning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almenara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) A signal, buoy, post, or other conspicuous mark erected on an eminence near the shore, or moored in shoal water, as a guide to mariners, particularly to warn vessels of danger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cúspide</ns0:quote>
          <ns0:quote>punto conspicuo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A high hill or other easily distinguishable object near the shore which can serve as guidance for seafarers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bead</ns0:orth>
        <ns0:pron>/biːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenta</ns0:quote>
          <ns0:quote>agallón</ns0:quote>
          <ns0:quote>mullo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Each in a string of small balls making up the rosary or paternoster. [from 14thc.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abalorio</ns0:quote>
          <ns0:quote>cuenta</ns0:quote>
          <ns0:quote>gargantilla</ns0:quote>
          <ns0:quote>mostacilla</ns0:quote>
          <ns0:quote>mullo</ns0:quote>
          <ns0:quote>rocalla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small, round object.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Various small, round solid objects.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small drop of water or other liquid. [from 16thc.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bead tree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agriaz</ns0:quote>
          <ns0:quote>cinamomo</ns0:quote>
          <ns0:quote>canelo</ns0:quote>
          <ns0:quote>paraíso sombrilla</ns0:quote>
          <ns0:quote>piocha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Melia azedarach, a deciduous or semi-evergreen tree with poisonous fruit, native to India, Southeast Asia, and northern Australia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beagle</ns0:orth>
        <ns0:pron>/ˈbiːɡəl/</ns0:pron>
        <ns0:pron>[ˈb̥iːɡəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beagle</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small short-legged smooth-coated scenthound, often tricolored and sometimes used for hunting hares. Its friendly disposition makes it suitable as a family pet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beak</ns0:orth>
        <ns0:pron>/biːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rigid structure projecting from the front of a bird's face, used for pecking, grooming, foraging, carrying items, eating food, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A similar pointed structure forming the nose and mouth of various animals, such as turtles, platypuses, whales, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beaked whale</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zifio</ns0:quote>
          <ns0:quote>zifíido</ns0:quote>
          <ns0:quote>zífido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of at least 20 species of whales in the family Ziphiidae, known to dive to great depths, but not well understood generally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beaker</ns0:orth>
        <ns0:pron>/ˈbiːkə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbiːkɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vaso de precipitación</ns0:quote>
          <ns0:quote>vaso de precipitados</ns0:quote>
          <ns0:quote>matraz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A flat-bottomed, straight-sided, glass vessel, with a lip and often a small spout, used as a laboratory container.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beakhead</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alas de proa</ns0:quote>
          <ns0:quote>espolón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) A protruding part of the foremost section of a sailing ship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beam</ns0:orth>
        <ns0:pron>/biːm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>viga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(structural) Any large piece of timber or iron long in proportion to its thickness, and prepared for use.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(structural) One of the principal horizontal structural members, usually of steel, timber, or concrete, of a building.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>viga</ns0:quote>
          <ns0:quote>jácena</ns0:quote>
          <ns0:quote>travesaño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) One of the transverse members of a ship's frame on which the decks are laid, and acting as part of the support for keeping the sides of the vessel in shape — supported at the sides by knees in wooden ships and by stringers in steel ones; cf. abeam, beam-ends.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>viga</ns0:quote>
          <ns0:quote>jácena</ns0:quote>
          <ns0:quote>manga</ns0:quote>
          <ns0:quote>timón</ns0:quote>
          <ns0:quote>travesaño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) The maximum width of a vessel (note that a vessel with a beam of 15 foot can also be said to be 15 foot abeam).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>timón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(agricultural) The central bar of a plow, to which the handles and colter are secured, and to the end of which are attached the oxen or horses that draw it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>radio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A ray or collection of approximately parallel rays emitted from the sun or other luminous body.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figuratively) A ray; a gleam.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beam compass</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compás de barra</ns0:quote>
          <ns0:quote>compás radial</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beaming</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>radiante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Smilingly happy; showing happy emotion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bean</ns0:orth>
        <ns0:pron>/biːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>judía</ns0:quote>
          <ns0:quote>frijol</ns0:quote>
          <ns0:quote>alubia</ns0:quote>
          <ns0:quote>haba</ns0:quote>
          <ns0:quote>habichuela</ns0:quote>
          <ns0:quote>poroto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any plant of several genera of the taxonomic family Fabaceae that produces large edible seeds or edible seedpods.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vaina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The edible seedpod of such a plant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) The bean-like seed of certain other plants, such as a vanilla bean or (especially) a coffee bean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bean goose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ánsar campestre</ns0:quote>
          <ns0:quote>ganso de las habas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of species Anser fabalis of grey geese, of family Anatidae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bean sprout</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>brotes de soja</ns0:quote>
          <ns0:quote>dientes de dragón</ns0:quote>
          <ns0:quote>frijolitos chinos</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>brote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, in the plural) A sprout of any of several other species of bean</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beanbag</ns0:orth>
        <ns0:pron>/ˈbiːnbæɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puf</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A piece of soft furniture consisting of a leather or vinyl covering stuffed with dry beans or other similar pellets.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bolsa para frejoles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small cloth bag filled with dry beans, used as a toy or for exercising the hands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beaner</ns0:orth>
        <ns0:pron>/ˈbinɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frijolero</ns0:quote>
          <ns0:quote>mejichango</ns0:quote>
          <ns0:quote>panchito</ns0:quote>
          <ns0:quote>saltamuros</ns0:quote>
          <ns0:quote>sudaca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, racial slur, offensive) A Mexican.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(sometimes , _, offensive, slang) A casual term of address, especially used by Mexican Americans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beanie</ns0:orth>
        <ns0:pron>/ˈbiː.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gorro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(headwear) A cap that fits the head closely, usually knitted from wool.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beanpole</ns0:orth>
        <ns0:pron>/ˈbinˌpoʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espigado</ns0:quote>
          <ns0:quote>larguirucho</ns0:quote>
          <ns0:quote>zanquilargo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A tall, thin person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear</ns0:orth>
        <ns0:pron>/beə/</ns0:pron>
        <ns0:pron>/beɹ/</ns0:pron>
        <ns0:pron>/beː/</ns0:pron>
        <ns0:pron>/biə/</ns0:pron>
        <ns0:pron>/bɑɹ/</ns0:pron>
        <ns0:pron>/bɛə/</ns0:pron>
        <ns0:pron>/bɛəɹ/</ns0:pron>
        <ns0:pron>/bɛː(r)/</ns0:pron>
        <ns0:pron>/bɛː/</ns0:pron>
        <ns0:pron>/bɜː(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbiːə(r)/</ns0:pron>
        <ns0:pron>[beː~bɛː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oso</ns0:quote>
          <ns0:quote>úrsido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large, generally omnivorous mammal (a few species are purely carnivorous or herbivorous), having shaggy fur, a very small tail, and flat feet; a member of the family Ursidae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maleante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A rough, unmannerly, uncouth person. [1579]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) An investor who sells commodities, securities, or futures in anticipation of a fall in prices. [1744]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>policía estatal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(CB radio, slang, US) A state policeman (short for Smokey Bear). [1970s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(gay slang) A large, hairy man, especially one who is homosexual. [c. 1970]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear</ns0:orth>
        <ns0:pron>/bɛə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soportar</ns0:quote>
          <ns0:quote>sostener</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give (written or oral testimony or evidence); (figurative) to provide or constitute (evidence or proof), give witness.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To admit or be capable of (a meaning); to suffer or sustain without violence, injury, or change.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To support or sustain; to hold up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soportar</ns0:quote>
          <ns0:quote>aguantar</ns0:quote>
          <ns0:quote>bancar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, _, transitive, _, outside certain set patterns such as 'bear with'; formerly also, _, intransitive) To endure or withstand (hardship, scrutiny, etc.); to tolerate; to be patient (with).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguantar</ns0:quote>
          <ns0:quote>portar</ns0:quote>
          <ns0:quote>soportar</ns0:quote>
          <ns0:quote>llevar</ns0:quote>
          <ns0:quote>acarrear</ns0:quote>
          <ns0:quote>atestiguar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To afford, to be something to someone, to supply with something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear cub</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>osezno</ns0:quote>
          <ns0:quote>esbardo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A young bear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear fruit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dar sus frutas</ns0:quote>
          <ns0:quote>fructificar</ns0:quote>
          <ns0:quote>frutar</ns0:quote>
          <ns0:quote>frutear</ns0:quote>
          <ns0:quote>frutecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom, of an effort, endeavour, etc.) To produce good results; to yield benefits; to succeed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear hug</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abrazazo</ns0:quote>
          <ns0:quote>abrazo de oso</ns0:quote>
          <ns0:quote>abrazo úrsido</ns0:quote>
          <ns0:quote>abrazote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any especially large, tight or enthusiastic hug, usually friendly and especially given by a male.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear in mind</ns0:orth>
        <ns0:pron>/-ˈməi̯nd/</ns0:pron>
