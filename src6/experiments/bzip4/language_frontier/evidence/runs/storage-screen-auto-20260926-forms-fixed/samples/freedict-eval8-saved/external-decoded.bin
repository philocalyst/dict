      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abnegar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To deny (oneself something); to renounce or give up (a right, a power, a claim, a privilege, a convenience). [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rechazar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To relinquish; to surrender; to abjure. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
