    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goth</ns0:orth>
        <ns0:pron>/ɡɑθ/</ns0:pron>
        <ns0:pron>/ɡɒθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>godo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the East Germanic people known for their invasion of the western Roman Empire and subsequent founding of successor states in Italy and Spain during Late Antiquity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
