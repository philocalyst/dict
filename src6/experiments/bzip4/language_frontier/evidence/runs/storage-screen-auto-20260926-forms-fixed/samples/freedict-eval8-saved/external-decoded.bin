    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>L'Hôpital's rule</ns0:orth>
        <ns0:pron>/ˌloʊpiːˈtɑːlz ˈɹuːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>regla de l'Hôpital</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) The rule that the limit of the ratio of two functions equals the limit of the ratio of their derivatives, usable when the former limit is indeterminate and the latter limit exists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
