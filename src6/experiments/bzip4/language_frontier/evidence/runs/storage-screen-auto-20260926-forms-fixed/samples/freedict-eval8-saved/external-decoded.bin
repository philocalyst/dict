          <ns0:quote>vino de misa</ns0:quote>
          <ns0:quote>vino de comunión</ns0:quote>
          <ns0:quote>vino de consagrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A particular type of wine produced for ritual consumption during the Roman Catholic Mass.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
