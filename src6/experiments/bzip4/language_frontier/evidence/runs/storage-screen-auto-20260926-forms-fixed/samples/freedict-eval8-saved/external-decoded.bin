          <ns0:def>Of the Slavs, their culture or the branch of the Indo-European languages associated with them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Slavic studies</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eslavística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(humanities, US) A field of academic study concerned with Slavic areas, Slavic languages, literature, history, and culture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
