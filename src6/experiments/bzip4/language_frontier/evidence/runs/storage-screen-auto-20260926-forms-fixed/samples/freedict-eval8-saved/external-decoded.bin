          <ns0:quote>basquetbolista</ns0:quote>
          <ns0:quote>jugadora de baloncesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(basketball) A person who plays basketball, especially professionally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basking shark</ns0:orth>
      </ns0:form>
