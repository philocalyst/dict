        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Urbano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncommon) A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Urdu</ns0:orth>
        <ns0:pron>/ˈɜːˌduː/</ns0:pron>
        <ns0:pron>/ˈʊəɹduː/</ns0:pron>
