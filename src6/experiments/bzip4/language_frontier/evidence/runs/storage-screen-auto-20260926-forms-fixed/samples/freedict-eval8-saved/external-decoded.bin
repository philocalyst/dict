        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afrancesamiento</ns0:quote>
          <ns0:quote>francofonización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of making French or more French-like, especially in informal contexts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
