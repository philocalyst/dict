          <ns0:quote>lubina</ns0:quote>
          <ns0:quote>róbalo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
