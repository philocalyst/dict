          <ns0:quote>esmeriladora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A grinder, typically with a pair of grinding wheels (one at each end of the motor shaft) that is designed to be permanently mounted on a workbench.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
