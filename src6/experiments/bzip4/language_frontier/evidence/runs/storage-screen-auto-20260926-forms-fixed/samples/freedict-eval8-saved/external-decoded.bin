        <ns0:pron>/ˈækjəˌmɛn/</ns0:pron>
        <ns0:pron>/ˈækjʊmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
