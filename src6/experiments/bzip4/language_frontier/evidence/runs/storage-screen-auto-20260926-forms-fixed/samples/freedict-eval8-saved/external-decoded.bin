        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arrogarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, uncommon) To appropriate or lay claim to something for oneself without right. [from 1530s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arrow</ns0:orth>
        <ns0:pron>/ˈæɹoʊ/</ns0:pron>
        <ns0:pron>/ˈæɹə/</ns0:pron>
        <ns0:pron>/ˈæɹəʊ/</ns0:pron>
        <ns0:pron>/ˈɛ(ə)ɹoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>flecha</ns0:quote>
          <ns0:quote>saeta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A projectile consisting of a shaft, a point and a tail with stabilizing fins that is shot from a bow.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>flecha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sign or symbol used to indicate a direction (e.g.→).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
