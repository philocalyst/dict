        <ns0:pron>/ˈɔːl.səʊ/</ns0:pron>
        <ns0:pron>[ˈɔːɫ.so(ː)]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>también</ns0:quote>
          <ns0:quote>además</ns0:quote>
          <ns0:quote>asimismo</ns0:quote>
          <ns0:quote>ansimesmo</ns0:quote>
