        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Olavo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Arabic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>árabe antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The earliest attested stage of the Arabic language, beginning with the first attestation of personal names in the 9th century BC, and culminating in the codification of Classical Arabic beginning in the 7th century AD.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Catholic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>católico antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to a group of churches that split from the Roman Catholic Church over the dogma of papal infallibility, which they did not agree with.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Church Slavonic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo eslavo eclesiástico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first literary and liturgical Slavic language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old East Slavic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo eslavo oriental</ns0:quote>
          <ns0:quote>antiguo ruso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A Slavic language used from the 10th to the 14th centuries by East Slavs in the state of Kievan Rus and its successors. The ancestor of Belarusian, Russian, Rusyn and Ukrainian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old English</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inglés antiguo</ns0:quote>
          <ns0:quote>anglosajón</ns0:quote>
          <ns0:quote>idioma anglosajón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics, history) The ancestor language of Modern English, also called Anglo-Saxon, spoken in most of Britain from about 400 to 1100.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old English Sheepdog</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo pastor inglés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A herding dog of a particular breed (also used as a pet), with shaggy grey and white fur also covering its face, and a docked tail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old French</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>francés antiguo</ns0:quote>
          <ns0:quote>francés medieval</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The French language as spoken or written from the 9th to the early 14th century.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Galician-Portuguese</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>galaicoportugués</ns0:quote>
          <ns0:quote>gallego medieval</ns0:quote>
          <ns0:quote>gallegoportugués</ns0:quote>
          <ns0:quote>portugués medieval</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A language spoken in western Iberia during the High and Late Middle Ages, the ancestor of modern Portuguese, Galician, and Fala.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old High German</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo alto alemán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The early recorded form of the High German language, spoken from the 8th century to the 11th century.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Irish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>irlandés antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Irish language as attested from the sixth to the tenth centuries C.E., the oldest form of the Goidelic languages for which extensive texts (written in the Latin alphabet) are extant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Italian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>italiano antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The continuum of languages derived from Vulgar Latin spoken in the Italian peninsula between circa 960 and the establishment of the Accademia della Crusca in 1582.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Japanese</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>japonés antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the oldest stage of the Japanese language; spoken through the 8th century and followed by Late Old Japanese</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Korean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coreano antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The earliest stage of the Korean language, written in hanja, which evolved into Middle Korean by the 10th or 13th century, depending on the analysis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Maid</ns0:orth>
        <ns0:pron>/əʊld meɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>culo sucio</ns0:quote>
          <ns0:quote>poto sucio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A children's card game, sometimes played with a special deck, where the object of the game is for each player to find matches for all the cards in his hand, without being stuck with the single unmatchable card.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Norse</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nórdico antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language of Scandinavia until the 14th century, the common ancestor of modern Swedish, Danish, Norwegian, Faroese, and Icelandic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Persian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>persa antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ancestor language of Middle Persian, and via it of New Persian language. Attested in Old Persian cuneiform, in the period 525 B.C.E. – 300 B.C.E.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Prussian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prusiano antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct Baltic language, once spoken by the Old Prussians, the indigenous peoples of the historical region of Prussia (now north-eastern Poland, the Kaliningrad Oblast of Russia and Lithuania).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Slavonic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoeslavo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Proto-Slavic language</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Spanish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>castellano antiguo</ns0:quote>
          <ns0:quote>español medieval</ns0:quote>
          <ns0:quote>castellano medieval</ns0:quote>
          <ns0:quote>español antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Set of West Iberian language varieties spoken on the Iberian Peninsula from the 10th century until roughly the beginning of the 15th century, before a consonantic readjustment gave rise to the evolution of Modern Spanish, differentiating Spanish proper from Ladino and Ḥaketía.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Swedish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sueco antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The medieval form of the Swedish language, markedly different from the modern language in having more complex case and gender systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Testament</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Antiguo Testamento</ns0:quote>
          <ns0:quote>veterotestamentario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion, chiefly, Christianity) The first major part of the Christian Bible, covering events before the coming of Christ, corresponding roughly to the Jewish Tanakh. Usually subdivided into the categories of law, history, poetry (or wisdom books), and prophecy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Tibetan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tibetano antiguo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old Tupi</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tupí antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct Tupian language which was spoken by the native Tupi people of Brazil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Old World</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Viejo Mundo</ns0:quote>
          <ns0:quote>Mundo Antiguo</ns0:quote>
          <ns0:quote>Antiguo Continente</ns0:quote>
          <ns0:quote>Viejo Continente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Eastern Hemisphere, especially Europe, Africa and Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Olenekian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Olenekiense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, paleontology) A subdivision of the Triassic period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Oleshky</ns0:orth>
        <ns0:pron>/ɒˈlɛʃki/</ns0:pron>
        <ns0:pron>/ɔːˈlɛʃki/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Oleshki</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the administrative centre of Oleshky urban hromada, Kherson Raion, Kherson Oblast, Ukraine, founded in 1784 on the site of a much older settlement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Olga</ns0:orth>
        <ns0:pron>/ˈoʊlɡə/</ns0:pron>
        <ns0:pron>/ˈɒlɡə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Olga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transliteration of the Russian female given name О́льга (Ólʹga).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Olivar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Olivar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Chile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Olivenza</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Olivenza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town in Spain, on the Portuguese border and in the region of Extremadura.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Oliver</ns0:orth>
        <ns0:pron>/ˈɑlɪvɚ/</ns0:pron>
        <ns0:pron>/ˈɒlɪvə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Oliverio</ns0:quote>
          <ns0:quote>Oliver</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Olivia</ns0:orth>
        <ns0:pron>/oʊˈlɪvi.ə/</ns0:pron>
        <ns0:pron>/əʊˈlɪvi.ə/</ns0:pron>
        <ns0:pron>/əˈlɪ.vi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Olivia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the county seat of Renville County, Minnesota, United States, named for a female station agent named Olive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Olivier salad</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
