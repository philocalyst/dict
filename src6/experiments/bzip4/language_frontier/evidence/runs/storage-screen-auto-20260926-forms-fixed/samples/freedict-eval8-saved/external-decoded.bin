        </ns0:cit>
        <ns0:sense>
          <ns0:def>The official currency of Singapore.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Singaporean</ns0:orth>
        <ns0:pron>/sɪŋ.(ɡ)əˈpɔː.ɹi.ən/</ns0:pron>
