        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thanksgiving</ns0:orth>
        <ns0:pron>/ˈθæŋksɡɪvɪŋ/</ns0:pron>
        <ns0:pron>/θæŋksˈɡɪvɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día de Acción de Gracias</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Canada, US) The long weekend which includes Thanksgiving Day; Thanksgiving weekend.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thatcherism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>thatcherismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK politics) The political ideology attributed to the governments of British prime minister Margaret Thatcher (1979–1990), characterised by, among other things, a free market economy, privatisation, low taxation, austerity and opposition to unionisation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thatcherite</ns0:orth>
        <ns0:pron>/ˈθæt͡ʃəɹaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>thatcherista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK politics) An advocate of Thatcherism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thaumas</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Taumante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) A sea god, son of Pontus and Gaia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>The Call of South Africa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>La Llamada de Sudáfrica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a former national anthem of South Africa, created during the 1920s and used from the 1930s to the 1990s.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>The Game</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>El Juego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mind game where the objective is to avoid thinking about "The Game", and by thinking about it one loses, and subsequently has to announce one's loss to the world in order to make them lose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>The Hague</ns0:orth>
