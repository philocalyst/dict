      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excitación</ns0:quote>
          <ns0:quote>excitación sexual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sexual arousal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arouse</ns0:orth>
        <ns0:pron>/əˈɹaʊz/</ns0:pron>
        <ns0:pron>/əˈɹæɔz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>provocar</ns0:quote>
          <ns0:quote>concitar</ns0:quote>
          <ns0:quote>incitar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To stimulate or induce (feelings); pique.</ns0:def>
