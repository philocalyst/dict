        <ns0:pron>/ˌeɪ̯.viˈeɪ̯.ʃən/</ns0:pron>
        <ns0:pron>/ˌeɪ̯.viːˈeɪ̯.ʃən/</ns0:pron>
        <ns0:pron>/ˌeː.viːˈeː.ʃon/</ns0:pron>
        <ns0:pron>/ˌæv.i-/</ns0:pron>
        <ns0:pron>/ˌæv.iː-/</ns0:pron>
        <ns0:pron>/ˌæv.iː-/&lt;q:older&gt;</ns0:pron>
        <ns0:pron>/ˌæɪ̯.viːˈæɪ̯.ʃən/</ns0:pron>
        <ns0:pron>/ˌɛv.iː-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviación</ns0:quote>
          <ns0:quote>aeronáutica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The art or science of making and flying aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aviator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviadora</ns0:quote>
          <ns0:quote>aviador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An aircraft pilot, especially a military pilot. The use of the word may imply claims of superior airmanship, as in navy aviator vs. air force pilot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aviculture</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avicultura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The rearing and care of birds (especially poultry)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avid</ns0:orth>
        <ns0:pron>/ˈæv.əd/</ns0:pron>
        <ns0:pron>/ˈæv.ɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ávido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Enthusiastic; keen; eager; showing great interest in something or desire to do something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avidly</ns0:orth>
        <ns0:pron>/ˈævɪdli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ávidamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an avid manner; greedily; eagerly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avitaminosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avitaminosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any disease which is caused by vitamin deficiency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avocado</ns0:orth>
        <ns0:pron>/-æɖo/&lt;q:spelling pronunciation&gt;</ns0:pron>
        <ns0:pron>/ævəˈkɑdoʊ/</ns0:pron>
        <ns0:pron>/ævəˈkɑːdəʊ/</ns0:pron>
        <ns0:pron>/ɑvəˈkɑdoʊ/</ns0:pron>
        <ns0:pron>/əvɵˈkɑɖo/</ns0:pron>
        <ns0:pron>[ævəˈkɑɾoʊ]</ns0:pron>
        <ns0:pron>[ɑvəˈkɑɾoʊ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguacate</ns0:quote>
          <ns0:quote>palta</ns0:quote>
          <ns0:quote>cura</ns0:quote>
          <ns0:quote>palto</ns0:quote>
          <ns0:quote>avocado</ns0:quote>
          <ns0:quote>shunte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The large, usually yellowish-green or black, savory fruit of the avocado tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguacate</ns0:quote>
          <ns0:quote>palto</ns0:quote>
          <ns0:quote>avocado</ns0:quote>
          <ns0:quote>shunte</ns0:quote>
          <ns0:quote>shute</ns0:quote>
          <ns0:quote>xinene</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The avocado tree, Persea americana, of the laurel family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avocation</ns0:orth>
        <ns0:pron>/avə(ʊ)ˈkeɪʃən/</ns0:pron>
        <ns0:pron>/ævoʊˈkeɪʃən/</ns0:pron>
        <ns0:pron>/ævəˈkeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>llamada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) A calling away; a diversion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afición</ns0:quote>
          <ns0:quote>pasatiempo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hobby or recreational or leisure pursuit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avocet</ns0:orth>
        <ns0:pron>/ˈævəsɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avoceta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of four species of wading birds in the genus Recurvirostra, with long, slender recurved bills, long legs, and webbed feet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avoid</ns0:orth>
        <ns0:pron>/əˈvɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evitar</ns0:quote>
          <ns0:quote>esquivar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To try not to meet or communicate with (a person); to shun.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To keep away from; to keep clear of; to stay away from.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To try not to do something or to have something happen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avoid like the plague</ns0:orth>
        <ns0:pron>/əˈvɔɪd laɪk ðə ˈpleɪɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evitar como la peste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(simile) To evade or shun, if at all possible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avoidable</ns0:orth>
        <ns0:pron>/əˈvɔɪdəbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evitable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being vacated; liable to be annulled or made invalid; voidable.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Capable of being avoided, shunned, or escaped.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avoidance</ns0:orth>
        <ns0:pron>/əˈvɔɪdəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evitación</ns0:quote>
          <ns0:quote>abstinencia</ns0:quote>
          <ns0:quote>anulación</ns0:quote>
          <ns0:quote>evasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) The act of becoming vacant, or the state of being vacant, specifically used for the state of a benefice becoming void by the death, deprivation, or resignation of the incumbent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstinencia</ns0:quote>
          <ns0:quote>evasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) The act of quitting a position or benefice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avoidant</ns0:orth>
        <ns0:pron>/əˈvɔɪdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evitador</ns0:quote>
          <ns0:quote>evitante</ns0:quote>
          <ns0:quote>evitativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Exhibiting avoidance; avoiding something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avow</ns0:orth>
        <ns0:pron>/əˈvaʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>admitir</ns0:quote>
          <ns0:quote>confesar</ns0:quote>
          <ns0:quote>reconocer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To declare openly and boldly, as something believed to be right; to own, acknowledge or confess frankly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avowal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reconocimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An open declaration of affirmation or admission of knowledge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>avulsion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avulsión</ns0:quote>
          <ns0:quote>extirpación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, pathology) The loss or separation of a body part, either by surgery or due to trauma.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aw</ns0:orth>
        <ns0:pron>/ɑ/</ns0:pron>
        <ns0:pron>/ɔː/</ns0:pron>
        <ns0:pron>[ɔ̃ː ~ ɒ̃ː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acharita</ns0:quote>
          <ns0:quote>achará</ns0:quote>
          <ns0:quote>bienhaiga</ns0:quote>
          <ns0:quote>chará</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aw shucks</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ay tonto</ns0:quote>
          <ns0:quote>ay vaya</ns0:quote>
          <ns0:quote>ca</ns0:quote>
          <ns0:quote>no es para tanto</ns0:quote>
          <ns0:quote>quia</ns0:quote>
          <ns0:quote>qué ha de ser</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caracho</ns0:quote>
          <ns0:quote>caramba</ns0:quote>
          <ns0:quote>carape</ns0:quote>
          <ns0:quote>caray</ns0:quote>
          <ns0:quote>córcholis</ns0:quote>
          <ns0:quote>recórcholis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to express disappointment, embarrassment or annoyance.</ns0:def>
        </ns0:sense>
