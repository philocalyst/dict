          <ns0:quote>vedado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banner</ns0:orth>
        <ns0:pron>/ˈbænə/</ns0:pron>
        <ns0:pron>/ˈbænɚ/</ns0:pron>
        <ns0:pron>/ˈbæːnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excepcional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Exceptional; very good.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banner</ns0:orth>
        <ns0:pron>/ˈbænə/</ns0:pron>
        <ns0:pron>/ˈbænɚ/</ns0:pron>
        <ns0:pron>/ˈbæːnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bandera</ns0:quote>
          <ns0:quote>estandarte</ns0:quote>
          <ns0:quote>pendón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A flag or standard used by a military commander, monarch or nation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) The military unit under such a flag or standard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pancarta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any large sign, especially when made of soft material or fabric.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A large piece of cloth with a slogan, motto, or emblem carried in a demonstration or other procession or suspended in some conspicuous place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estandarte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension, figurative) A cause or purpose; a campaign or movement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>báner</ns0:quote>
          <ns0:quote>banner</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet, television) A type of advertisement on a web page or on television, usually taking the form of a graphic or animation above or alongside the content.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banner blindness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banner blindness</ns0:quote>
          <ns0:quote>ceguera a banner</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tendency to ignore banner ads and similar-looking banners on websites.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banneton</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banetón</ns0:quote>
          <ns0:quote>cesta de prueba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of basket used to provide structure for breads during proofing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banquet</ns0:orth>
        <ns0:pron>/ˈbæŋkwɪt/</ns0:pron>
        <ns0:pron>/ˈbæŋkɪt/&lt;q:obsolete&gt;&lt;ref:{{R:Jespersen MEGoHP|I|7.34|215}}&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banquete</ns0:quote>
          <ns0:quote>comida festiva</ns0:quote>
          <ns0:quote>convite</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large celebratory meal; a feast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banshee</ns0:orth>
        <ns0:pron>/bænˈʃiː/</ns0:pron>
        <ns0:pron>/ˈbænʃiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banshee</ns0:quote>
          <ns0:quote>llorona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Scotland, Ireland, , folklore) A female spirit, usually taking the form of a woman whose mournful wailing warns of an impending death.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bantamweight</ns0:orth>
        <ns0:pron>/ˈbæntəmˌweɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>peso gallo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(boxing, uncountable) A weight class in boxing and other sports, intermediate between flyweight and featherweight. In boxing it ranges from 112 to 118 pounds (51 to 54 kg).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banter</ns0:orth>
        <ns0:pron>/ˈbæntə/</ns0:pron>
        <ns0:pron>/ˈbæntɚ/</ns0:pron>
        <ns0:pron>[ˈbeːn.tɐ]</ns0:pron>
        <ns0:pron>[ˈbɛən.tɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bromas</ns0:quote>
          <ns0:quote>charla</ns0:quote>
          <ns0:quote>cháchara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sharp, good-humoured, playful, typically spontaneous conversation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banter</ns0:orth>
        <ns0:pron>/ˈbæntə/</ns0:pron>
        <ns0:pron>/ˈbæntɚ/</ns0:pron>
        <ns0:pron>[ˈbeːn.tɐ]</ns0:pron>
        <ns0:pron>[ˈbɛən.tɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bromear</ns0:quote>
          <ns0:quote>charlar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To engage in banter or playful conversation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacilar</ns0:quote>
          <ns0:quote>divertirse</ns0:quote>
          <ns0:quote>vacilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To play or do something amusing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>burlar</ns0:quote>
          <ns0:quote>chacotear</ns0:quote>
          <ns0:quote>tomar el pelo</ns0:quote>
          <ns0:quote>torear</ns0:quote>
          <ns0:quote>vacilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To tease (someone) mildly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banyan</ns0:orth>
        <ns0:pron>/ˈbæn.jæn/</ns0:pron>
        <ns0:pron>/ˈbæn.jən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baniano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tropical Indian fig tree, Ficus benghalensis, that has many aerial roots.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baobab</ns0:orth>
        <ns0:pron>/ˈbaʊbæb/</ns0:pron>
        <ns0:pron>/ˈbeɪoʊˌbæb/</ns0:pron>
        <ns0:pron>/ˈbeɪə(ʊ)bab/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baobab</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tree, Adansonia digitata, native to tropical Africa, having a broad swollen trunk and edible gourd-like hanging fruits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptism</ns0:orth>
        <ns0:pron>/ˈbæptɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bautismo</ns0:quote>
          <ns0:quote>bautizo</ns0:quote>
          <ns0:quote>baptismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A Christian sacrament, by which one is received into a church and sometimes given a name, generally involving the candidate to be anointed with or submerged in water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptism of fire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bautismo de fuego</ns0:quote>
          <ns0:quote>bautismo pírico</ns0:quote>
          <ns0:quote>bautismo vulcanio</ns0:quote>
          <ns0:quote>bautismo ígneo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively, military) The first experience of a severe ordeal, especially a first experience of military combat</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptismal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bautismal</ns0:quote>
          <ns0:quote>baptismal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to baptism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptismal font</ns0:orth>
        <ns0:pron>/bæpˈtɪzməl ˈfɑnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pila bautismal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A large basin used for baptism in or near a church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptist</ns0:orth>
        <ns0:pron>/ˈbæbdəs/</ns0:pron>
        <ns0:pron>/ˈbæbdɪs(t)/</ns0:pron>
        <ns0:pron>/ˈbæbtɪst/</ns0:pron>
        <ns0:pron>/ˈbæptɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bautista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who baptizes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptistry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baptisterio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A designated space within a church, or a separate room or building associated with a church, where a baptismal font is located, and consequently, where the sacrament of Christian baptism (via aspersion or affusion) is performed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptize</ns0:orth>
        <ns0:pron>/ˈbæptaɪz/</ns0:pron>
        <ns0:pron>[bapˈtajz]</ns0:pron>
        <ns0:pron>[ˈbæp.tajz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bautizar</ns0:quote>
          <ns0:quote>baptizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) To perform the sacrament of baptism by sprinkling or pouring water over someone or immersing them in water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baptizer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baptizador</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bar</ns0:orth>
        <ns0:pron>/baː/</ns0:pron>
        <ns0:pron>/bɑɹ/</ns0:pron>
        <ns0:pron>/bɑː/</ns0:pron>
        <ns0:pron>[bɑɹ]</ns0:pron>
        <ns0:pron>[bɑ˞]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra</ns0:quote>
          <ns0:quote>tortor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A solid, more or less rigid object of metal or wood with a uniform cross-section smaller than its length.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, uncountable, metallurgy) A solid metal object with uniform (round, square, hexagonal, octagonal or rectangular) cross-section; in the US its smallest dimension is 1⁄4 inch or greater, a piece of thinner material being called a strip.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pastilla</ns0:quote>
          <ns0:quote>tableta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cuboid piece of any solid commodity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bar</ns0:quote>
          <ns0:quote>taberna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) The sign indicating that the characteristic of a logarithm is negative, conventionally placed above the digit(s) to show that it applies to the characteristic only and not to the mantissa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra</ns0:quote>
          <ns0:quote>bar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The counter of such premises.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>minibar</ns0:quote>
          <ns0:quote>bar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A counter, or simply a cabinet, from which alcoholic drinks are served in a private house or a hotel room.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prohibición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An official order or pronouncement that prohibits some activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogacía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law, metonym, "the Bar", "the bar") Collectively, lawyers or the legal profession; specifically applied to barristers in some countries, but including all lawyers in others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bar</ns0:quote>
          <ns0:quote>barra</ns0:quote>
          <ns0:quote>taberna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A vertical line across a musical staff dividing written music into sections, typically of equal durational value.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography, nautical, hydrology) A ridge or succession of ridges of sand or other substance; especially:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
