    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pisces</ns0:orth>
        <ns0:pron>/ˈpaɪsiːz/</ns0:pron>
        <ns0:pron>/ˈpɪsiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Piscis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zodiac constellations) The Fish, a Greco-Roman constellation of the zodiac named for its presumed resemblance to a pair of fish</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astrology) The zodiac sign for the fish, supposed to be ruled by Neptune or Jupiter and to influence events occurring between February 20 and March 20 (tropical) or, less often, between March 15 and April 14 (sidereal).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
