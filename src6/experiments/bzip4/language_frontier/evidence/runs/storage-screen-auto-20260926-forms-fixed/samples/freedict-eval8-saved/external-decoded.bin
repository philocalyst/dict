          <ns0:quote>canto gregoriano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A style of unaccompanied monophonic singing in the Catholic Church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
