    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beg</ns0:orth>
        <ns0:pron>/beɪɡ/</ns0:pron>
        <ns0:pron>/bɛɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mendigar</ns0:quote>
          <ns0:quote>pordiosear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To request the help of someone, often in the form of money.</ns0:def>
        </ns0:sense>
