        <ns0:pron>/ˌsaɪnəʊˈsɛntɹɪzəm/</ns0:pron>
        <ns0:pron>/ˌsɪ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sinocentrismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The belief, held by the ancient Chinese, that China was literally the centre of the world.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
