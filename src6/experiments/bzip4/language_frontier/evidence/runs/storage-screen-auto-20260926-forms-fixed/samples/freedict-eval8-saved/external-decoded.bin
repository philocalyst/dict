        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar Amarillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marginal sea of the Pacific between mainland China and the Korean Peninsula</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
