          <ns0:quote>cafetucho de internet</ns0:quote>
          <ns0:quote>cafetín de internet</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place where one can use a computer with Internet access for a fee.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
