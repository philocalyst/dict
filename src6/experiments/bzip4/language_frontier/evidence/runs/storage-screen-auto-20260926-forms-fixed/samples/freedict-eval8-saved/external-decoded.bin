      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>T-bone</ns0:quote>
          <ns0:quote>filete T-bone</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large beef steak, containing a T-shaped bone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>T-junction</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>unión en T</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An intersection of routes where one road terminates as it joins a (usually higher priority) road at approximately 90°. In most countries, a give way or stop road sign will be seen at a T-junction.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A similarly shaped section in a pipe, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>T-shirt</ns0:orth>
        <ns0:pron>/ˈtiːʃɚt/</ns0:pron>
        <ns0:pron>/ˈtiːʃɜːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>camiseta</ns0:quote>
          <ns0:quote>polera</ns0:quote>
          <ns0:quote>playera</ns0:quote>
          <ns0:quote>remera</ns0:quote>
          <ns0:quote>T-shirt</ns0:quote>
          <ns0:quote>chema</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(clothing) A lightweight shirt without buttons, usually with short sleeves and no collar. Often made of cotton and frequently bears a picture or slogan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
