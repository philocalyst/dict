        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of Mexico.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sindarin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sindarin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A constructed language, partly inspired by Welsh, spoken by certain elves and others in J. R. R. Tolkien's works.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sindhi</ns0:orth>
        <ns0:pron>/ˈsɪndi/</ns0:pron>
        <ns0:pron>/ˈsɪnd̪ʱi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sindí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Indo-Aryan language spoken in four main dialects in Pakistan and India. There are around 35 million Sindhi speakers in Sindh سنڌ and more than 40 million throughout the world. Sindhi is written with a modified Arabic script that has 52 letters, and in a modified Devanagari script too.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
