        <ns0:sense>
          <ns0:def>A critically endangered salamander found in the elevated lakes of Mexico, Ambystoma mexicanum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
