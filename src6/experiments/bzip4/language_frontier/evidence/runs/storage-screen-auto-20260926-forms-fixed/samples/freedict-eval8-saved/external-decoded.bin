          <ns0:quote>diofántico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) Of or pertaining to Diophantus, the Greek mathematician.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Diophantine equation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
