      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A performance, by an aspiring performer, to demonstrate suitability or talent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oído</ns0:quote>
          <ns0:quote>audición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An act of hearing; being heard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audition</ns0:orth>
        <ns0:pron>/ɑˈdɪʃən/</ns0:pron>
        <ns0:pron>/ɔˈdɪʃən/</ns0:pron>
        <ns0:pron>/ɔːˈdɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audicionar</ns0:quote>
          <ns0:quote>audición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To evaluate one or more performers in through an audition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audicionar</ns0:quote>
          <ns0:quote>audicionarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
