        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>presbiterianismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of Protestant Christianity based on Calvinism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Presidents' Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día del Presidente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A day celebrating George Washington and other presidents, a federal holiday in the United States, celebrated on the third Monday of February (formerly on the 22nd of February).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
