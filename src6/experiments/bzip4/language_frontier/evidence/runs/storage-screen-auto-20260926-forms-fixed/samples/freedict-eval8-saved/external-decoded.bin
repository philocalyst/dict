          <ns0:quote>Árabe hiyazí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Arabic dialect spoken primarily in Jeddah, Mecca, Medina, and Taif in Saudi Arabia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hijra</ns0:orth>
        <ns0:pron>/ˈhɪd͡ʒɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hégira</ns0:quote>
          <ns0:quote>héjira</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The flight of Muhammad and his followers from Mecca to Yathrib (later Medina) in 622 ce, which forms the first year of the Islamic era (ah 1).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
