      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bigamia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of having two (legal or illegal) spouses simultaneously.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigender</ns0:orth>
        <ns0:pron>/baɪˈd͡ʒɛn.də/</ns0:pron>
        <ns0:pron>/baɪˈd͡ʒɛn.dɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bigénero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having two genders simultaneously, most commonly male and female.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bight</ns0:orth>
        <ns0:pron>/baɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corva</ns0:quote>
          <ns0:quote>curva</ns0:quote>
          <ns0:quote>sangradura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A corner, bend, or angle; a hollow</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ensenada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) An area of sea lying between two promontories, larger than a bay, wider than a gulf.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A curve in a rope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigmouthed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bocón</ns0:quote>
          <ns0:quote>bocazas</ns0:quote>
          <ns0:quote>deslenguado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a person) Loud or talkative, especially in an indiscreet manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigorexia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vigorexia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A mental disorder in which the sufferer perceives himself to have inadequate musculature; most common among bodybuilders</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigorexic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vigoréxico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>suffering from bigorexia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigorexic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vigoréxica</ns0:quote>
          <ns0:quote>vigoréxico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a person suffering from bigorexia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigot</ns0:orth>
        <ns0:pron>/ˈbɪɡət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carcunda</ns0:quote>
          <ns0:quote>discriminador</ns0:quote>
          <ns0:quote>facho</ns0:quote>
          <ns0:quote>intolerante</ns0:quote>
          <ns0:quote>racista</ns0:quote>
          <ns0:quote>ultra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is narrow-mindedly devoted to their own ideas and groups, and intolerant of (people of) differing ideas, races, genders, religions, politics, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beato</ns0:quote>
          <ns0:quote>fanático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) One who is overly pious in matters of religion, often hypocritically or else superstitiously so.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigotry</ns0:orth>
        <ns0:pron>/ˈbɪɡ.ə.tɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>discriminación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition or the characteristic quality of a bigot, especially religious, anti-religious or racial intolerant prejudice; opinionatedness; fanaticism; fanatic intolerance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bigwig</ns0:orth>
        <ns0:pron>/ˈbɪɡ.wɪɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pez gordo</ns0:quote>
          <ns0:quote>barón</ns0:quote>
          <ns0:quote>jefazo</ns0:quote>
          <ns0:quote>mandamás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A person of importance in a group or organization.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bijection</ns0:orth>
        <ns0:pron>/baɪˈd͡ʒɛk.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biyección</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set theory) A one-to-one correspondence, a function which is both a surjection and an injection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bijective</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biyectivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, of a function) Associating to each element of the codomain exactly one element of the domain; establishing a perfect (one-to-one) correspondence between the elements of the domain and the codomain; (formally) both injective and surjective.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bike</ns0:orth>
        <ns0:pron>/baɪk/</ns0:pron>
        <ns0:pron>[bɐɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bici</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Clipping of bicycle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>moto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any vehicle sharing some characteristics with a bicycle or motorbike, such as pedal power, a handlebar, or a saddle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bike lock</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>candado de bicicleta</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bike station</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cicloparqueadero</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bike-and-ride</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>depósito de bicicletas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An activity involving the use of a bicycle in conjunction with another type of transportation such as public transit. Typically, bike-and-ride facilities include bicycle storage areas adjacent to transit stops, giving passengers the option of traveling to the stops without the use of a motorized vehicle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biker</ns0:orth>
        <ns0:pron>/ˈbaɪkə/</ns0:pron>
        <ns0:pron>/ˈbaɪkɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>motera</ns0:quote>
          <ns0:quote>motero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person whose lifestyle is centered on motorcycles, sometimes a member of a motorcycle club.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bikini</ns0:orth>
        <ns0:pron>/bɪˈki.ni/</ns0:pron>
        <ns0:pron>/bɪˈkiː.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biquini</ns0:quote>
          <ns0:quote>bikini</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A brief bathing suit worn by men.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bikini bottom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>braga de bikini</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The bottom half of a bikini.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilabial</ns0:orth>
        <ns0:pron>/baɪˈleɪ.bi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilabial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics) Articulated with both lips.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilabial</ns0:orth>
        <ns0:pron>/baɪˈleɪ.bi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilabial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics) A speech sound articulated with both lips.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilateral</ns0:orth>
        <ns0:pron>/baɪˈlætəɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilateral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having two sides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilberry</ns0:orth>
        <ns0:pron>/ˈbɪlb(ə)ɹɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arándano</ns0:quote>
          <ns0:quote>mirtilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Vaccinium myrtillus, the wild European blueberry of the cowberry family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bildungsroman</ns0:orth>
        <ns0:pron>/ˈbɪl.dʊŋz.ɹoʊˌmɑːn/</ns0:pron>
        <ns0:pron>/ˈbɪl.dʊŋzˌɹoʊ.mən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>novela de aprendizaje</ns0:quote>
          <ns0:quote>novela de formación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A novel tracing the spiritual, moral, psychological, or social development and growth of the main character, usually from childhood to maturity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bile</ns0:orth>
        <ns0:pron>/baɪl/</ns0:pron>
        <ns0:pron>/ˈbaɪ.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilis</ns0:quote>
          <ns0:quote>hiel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bitter brownish-yellow or greenish-yellow secretion produced by the liver, stored in the gall bladder, and discharged into the duodenum where it aids the process of digestion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bile duct</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conducto biliar</ns0:quote>
          <ns0:quote>vía biliar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Any of a number of long tube-like structures that carry bile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilge</ns0:orth>
        <ns0:pron>/bɪld͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sentina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) The rounded portion of a ship's hull, forming a transition between the bottom and the sides.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(nautical) The lowest inner part of a ship's hull, where water accumulates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilinear</ns0:orth>
        <ns0:pron>/baɪˈlɪn.i.ə/</ns0:pron>
        <ns0:pron>/baɪˈlɪn.i.ɚ/</ns0:pron>
        <ns0:pron>/bɑɪˈlɪn.i.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilineal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linear algebra, of a function in two variables) Linear (preserving linear combinations) in each variable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilingual</ns0:orth>
        <ns0:pron>/baɪˈlɪŋ.ɡju.əl/</ns0:pron>
        <ns0:pron>/baɪˈlɪŋ.ɡwəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilingüe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the ability to speak two languages fluently.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Spoken or written in two different languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilingual</ns0:orth>
        <ns0:pron>/baɪˈlɪŋ.ɡju.əl/</ns0:pron>
        <ns0:pron>/baɪˈlɪŋ.ɡwəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilingüe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is able to use two languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilingual dictionary</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diccionario bilingüe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A translation dictionary in two languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilingualism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilingüismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition of being bilingual; the ability to speak two languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilious</ns0:orth>
        <ns0:pron>/ˈbɪl.i.əs/</ns0:pron>
        <ns0:pron>/ˈbɪl.jəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biliar</ns0:quote>
          <ns0:quote>biliario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to something containing or consisting of bile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Suffering from real or supposed liver disorder, especially excessive secretions of bile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrabiliario</ns0:quote>
          <ns0:quote>colérico</ns0:quote>
          <ns0:quote>atrabilioso</ns0:quote>
          <ns0:quote>intranquillo</ns0:quote>
          <ns0:quote>iracundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Peevishly ill-humored, irritable or bad tempered; irascible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biliverdin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biliverdina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A green tetrapyrrolic bile pigment, a product of heme catabolism, responsible for the greenish color sometimes seen in bruises.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilk</ns0:orth>
        <ns0:pron>/bɪlk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>engañar</ns0:quote>
          <ns0:quote>defraudar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To do someone out of their due; to deceive or defraud, to cheat (someone).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill</ns0:orth>
        <ns0:pron>/bɪl/</ns0:pron>
        <ns0:pron>[bɪo̯]</ns0:pron>
        <ns0:pron>[bɪɫ]</ns0:pron>
        <ns0:pron>[bɪʊ̯]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>declaración</ns0:quote>
          <ns0:quote>letra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A written list or inventory. (Now obsolete except in specific senses or set phrases; bill of lading, bill of goods, etc.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zootomy) The beak of a bird, especially when small or flattish; sometimes also used with reference to a platypus, turtle, or other animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cartel</ns0:quote>
          <ns0:quote>nota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A document, originally sealed; a formal statement or official memorandum. (Now obsolete except with certain qualifying words; bill of health, bill of sale etc.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>proyecto de ley</ns0:quote>
          <ns0:quote>proposición de ley</ns0:quote>
          <ns0:quote>proyecto legal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A draft of a law, presented to a legislature for enactment; a proposed or projected law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenta</ns0:quote>
          <ns0:quote>factura</ns0:quote>
          <ns0:quote>compto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A written note of goods sold, services rendered, or work done, with the price or charge; an invoice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill</ns0:orth>
        <ns0:pron>/bɪl/</ns0:pron>
        <ns0:pron>[bɪo̯]</ns0:pron>
        <ns0:pron>[bɪɫ]</ns0:pron>
        <ns0:pron>[bɪʊ̯]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cobrar</ns0:quote>
          <ns0:quote>facturar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To charge; to send a bill to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill and coo</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacer arrumacos</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill of exchange</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>letra de cambio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(banking) A document demanding payment from another party, especially used in international trade.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill of fare</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carta</ns0:quote>
          <ns0:quote>menú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(old-fashioned) A written or printed enumeration of the dishes served at a banquet, or of the dishes (with prices listed) that may be ordered at a restaurant, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill of lading</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conocimiento de embarque</ns0:quote>
          <ns0:quote>guía</ns0:quote>
          <ns0:quote>manifiesto de carga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(shipping) A document issued by a carrier (e.g. master of a ship or the ship owner's agent) to a shipper listing a ship's cargo, acknowledging receipt of said cargo, and specifying terms for its delivery.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill of materials</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lista de materiales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(manufacturing, design engineering) A list of materials and components used in a manufactured item.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bill of rights</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>declaración de derechos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A formal statement of the rights of a specified group of people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billboard</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>valla publicitaria</ns0:quote>
          <ns0:quote>cartelera</ns0:quote>
          <ns0:quote>espectacular</ns0:quote>
          <ns0:quote>publicidad exterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very large outdoor sign, generally used for advertising.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(nautical) A piece of thick plank, armed with iron plates, and fixed on the bow or fore-channels of a vessel, for the bill or fluke of the anchor to rest on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billet</ns0:orth>
        <ns0:pron>/ˈbɪlɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuartelar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, of a soldier) To lodge, or be quartered, in a private house.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billhook</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corquete</ns0:quote>
          <ns0:quote>podón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agricultural hand tool often with a curved or hooked end to the blade used for pruning or cutting thick, woody plants.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(often written as bill-hook) A part of the knotting mechanism in a reaper-binder or baler (agricultural machinery).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billiard</ns0:orth>
        <ns0:pron>/ˈbɪl.i.ɑː(ɹ)d/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>numeral</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>billardo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(British, rare) 1015, a thousand billion (long scale) or a million milliard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billiards</ns0:orth>
        <ns0:pron>/ˈbɪl.jɚdz/</ns0:pron>
        <ns0:pron>/ˈbɪlɪədz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>billar</ns0:quote>
          <ns0:quote>chapolín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(games, British) A two-player cue sport played with two cue balls and one red ball, on a snooker sized table.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billing</ns0:orth>
        <ns0:pron>/ˈbɪlɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>facturación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Amounts billed.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The tracking of bills and amounts owed; the department within an institution or business that deals with the tracking of bills and amounts owed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billion</ns0:orth>
        <ns0:pron>/ˈbɪljən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>numeral</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>millardo</ns0:quote>
          <ns0:quote>mil millones</ns0:quote>
          <ns0:quote>billón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated, British &amp; Australian, long scale) A million (times a) million (logic: 1,000,0002): a 1 followed by twelve zeros (1012); a thousand milliard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billionaire</ns0:orth>
        <ns0:pron>/ˌbɪl.i.əˈnɛə(ɹ)/</ns0:pron>
        <ns0:pron>/ˌbɪl.jəˈnɛɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>multimillonario</ns0:quote>
          <ns0:quote>milmillonario</ns0:quote>
          <ns0:quote>billonario</ns0:quote>
          <ns0:quote>millardario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Somebody whose wealth is at least one billion (109) currency units.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billow</ns0:orth>
        <ns0:pron>/ˈbɪloʊ/</ns0:pron>
        <ns0:pron>/ˈbɪləʉ/</ns0:pron>
        <ns0:pron>/ˈbɪləʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ola</ns0:quote>
          <ns0:quote>oleada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large wave, swell, surge, or undulating mass of something, such as water, smoke, fabric or sound</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billow</ns0:orth>
        <ns0:pron>/ˈbɪloʊ/</ns0:pron>
        <ns0:pron>/ˈbɪləʉ/</ns0:pron>
        <ns0:pron>/ˈbɪləʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hincharse</ns0:quote>
          <ns0:quote>inflar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To swell out or bulge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billowy</ns0:orth>
        <ns0:pron>/ˈbɪ.ləʊ.(w)i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>onduloso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Swelling or swollen into large waves; full of billows or surges; resembling billows.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>billy goat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cabrón</ns0:quote>
          <ns0:quote>cabro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(childish) A male goat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bilocation</ns0:orth>
        <ns0:pron>/baɪləʊˈkeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bilocación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Parapsychology) The ability to be, or fact of being, in two places at once.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bimbo</ns0:orth>
        <ns0:pron>/ˈbɪmboʊ/</ns0:pron>
        <ns0:pron>/ˈbɪmbəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mujer florero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(derogatory, slang) A physically attractive person, typically a woman or otherwise feminine in appearance, who lacks intelligence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bimedian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bimediana</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bimester</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bimestre</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bimetallism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bimetalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(economics) The use of a monetary standard based upon two different metals, traditionally gold and silver usually in a fixed ratio of values.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bimonthly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bimestral</ns0:quote>
          <ns0:quote>bimensual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Once every two months; bimestrially.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bin</ns0:orth>
        <ns0:pron>/bɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A box, frame, crib, or enclosed place, used as a storage container.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bote (de basura)</ns0:quote>
          <ns0:quote>caneca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A container for rubbish or waste.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binary</ns0:orth>
        <ns0:pron>/ˈbaɪ.nə.ɹi/</ns0:pron>
        <ns0:pron>/ˈbaɪ.nə.ɹɪ/</ns0:pron>
        <ns0:pron>/ˈbaɪ.nɛɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>binario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Being in one of two mutually exclusive states.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(logic) Concerning logic whose subject matter concerns such states.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(arithmetic, computing) Concerning numbers and calculations using the binary number system.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having two equally important parts; related to something with two parts.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics, programming, computer engineering) Of an operation, function, procedure, or logic gate, taking exactly two operands, arguments, parameters, or inputs; having domain of dimension 2.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing) Of data, consisting coded values (e.g. machine code) not interpretable as plain or ASCII text (e.g. source code).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binary code</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>código binario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A code that uses the binary digits (1 and 0), usually in groups of eight, to represent characters, machine instructions or other data.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binary operator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>operador binario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra, computing) A symbol representing binary operation; an operator taking two operands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binary relation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>relación binaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set theory, order theory, "on" a set A) A subset of the Cartesian product A \times A (the set of ordered pairs (a, b) of elements of A, alternatively written as A^2).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binary star</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estrella binaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A stellar system in which two stars orbit around their center of mass; double star.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binary tree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>árbol binario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, computer science) A data structure in which each node has at most two children, each node but the root has one parent, and there are no cycles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bind</ns0:orth>
        <ns0:pron>/baɪn/</ns0:pron>
        <ns0:pron>/baɪnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atar</ns0:quote>
          <ns0:quote>ligar</ns0:quote>
          <ns0:quote>vincular</ns0:quote>
          <ns0:quote>empastar</ns0:quote>
          <ns0:quote>liar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To tie; to confine by any ligature.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To confine, restrain, or hold by physical force or influence of any kind.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, computer programming) To process one or more object modules into an executable program.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atar</ns0:quote>
          <ns0:quote>ceñir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To tie or fasten tightly together, with a cord, band, ligature, chain, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atar</ns0:quote>
          <ns0:quote>acoplar</ns0:quote>
          <ns0:quote>ligar</ns0:quote>
          <ns0:quote>vincular</ns0:quote>
          <ns0:quote>empastar</ns0:quote>
          <ns0:quote>liar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To couple.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encuadernar</ns0:quote>
          <ns0:quote>engargolar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put together in a cover, as of books.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atar</ns0:quote>
          <ns0:quote>ligar</ns0:quote>
          <ns0:quote>vincular</ns0:quote>
          <ns0:quote>empastar</ns0:quote>
          <ns0:quote>fajarse</ns0:quote>
          <ns0:quote>liar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, , LGBTQ) To wear a binder so as to flatten one's chest to give the appearance of a flat chest, usually done by trans men.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bind hand and foot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atar de pies y manos</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binder</ns0:orth>
        <ns0:pron>/ˈbaɪndə/</ns0:pron>
        <ns0:pron>/ˈbaɪndəɹ/</ns0:pron>
        <ns0:pron>/ˈbaɪndɚ/</ns0:pron>
        <ns0:pron>/ˈbʌɪndəɹ/</ns0:pron>
        <ns0:pron>[ˈbəi̯nd(ə)ɹ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archivador</ns0:quote>
          <ns0:quote>bibliorato</ns0:quote>
          <ns0:quote>carpeta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cover or holder for unbound papers, pages, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aglutinante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something that is used to bind things together, often referring to the mechanism that accomplishes this for a book.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agavilladora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(agriculture) A machine used in harvesting that ties cut stalks of grain into a bundle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binder clip</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pinza sujetapapeles</ns0:quote>
          <ns0:quote>sujetapapeles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A simple device for binding several sheets of paper, leaving the sheets intact; a strip of spring steel bent into the shape of an isosceles triangle with loops at the apex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binding</ns0:orth>
        <ns0:pron>/ˈbaɪndɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vinculante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of an agreement, contract, etc.) Imposing stipulations or requirements that must be honoured.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binding</ns0:orth>
        <ns0:pron>/ˈbaɪndɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lomo</ns0:quote>
          <ns0:quote>unión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The spine of a book where the pages are held together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sewing) A finishing on a seam or hem of a garment.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(programming) The association of a named item with an element of a program.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>unión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) The action or result of making two or more molecules stick together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binding spell</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hechizo vinculante</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bindle</ns0:orth>
        <ns0:pron>/ˈbɪndl/</ns0:pron>
        <ns0:pron>/ˈbɪndəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>linyera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Canada, US, , slang) Any bundle or package; specifically one containing narcotics such as cocaine, heroin, or morphine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bindweed</ns0:orth>
        <ns0:pron>/ˈbaɪndwiːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>convólvulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>black bindweed (Fallopia convolvulus).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binge</ns0:orth>
        <ns0:pron>/bɪnd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracón</ns0:quote>
          <ns0:quote>atragantamiento</ns0:quote>
          <ns0:quote>botellón</ns0:quote>
          <ns0:quote>comilona</ns0:quote>
          <ns0:quote>francachela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A short period of excessive consumption, especially of food, alcohol, narcotics, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracón</ns0:quote>
          <ns0:quote>maratón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) A compressed period of an activity done in excess, such as watching a television show.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binge</ns0:orth>
        <ns0:pron>/bɪnd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracarse</ns0:quote>
          <ns0:quote>atragantar</ns0:quote>
          <ns0:quote>atragantarse</ns0:quote>
          <ns0:quote>ponerse a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, intransitive, often with on) To engage in a short period of excessive consumption, especially of excessive alcohol or media consumption.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binge eating disorder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno por atracón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Recurrent binge eating, but without the purging associated with bulimia nervosa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binge watching</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracón</ns0:quote>
          <ns0:quote>maratón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The viewing of numerous episodes of a television show in one sitting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binge-watch</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maratonear</ns0:quote>
          <ns0:quote>darse un atracón de</ns0:quote>
          <ns0:quote>tragarse</ns0:quote>
          <ns0:quote>ver en maratón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To watch multiple episodes of a television programme in a short period of time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bingeable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maratoneable</ns0:quote>
          <ns0:quote>para ver en maratón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On which one can binge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bingo</ns0:orth>
        <ns0:pron>/ˈbɪŋ.ɡoʊ/</ns0:pron>
        <ns0:pron>/ˈbɪŋ.ɡəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bingo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A game of chance for two or more players, who mark off numbers on a grid as they are announced by the caller; the game is won by the first person to call out "bingo!" or "house!" after crossing off all numbers on the grid or in one line of the grid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bingo wings</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>flacidez bajo los brazos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, derogatory, or, humorous) Fatty, loose flaps of skin hanging from the upper arms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binnacle</ns0:orth>
        <ns0:pron>/ˈbɪnəkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bitácora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) The wooden housing for a ship's compass, with its corrector magnets and illuminating arrangements. The log and other equipment for measuring the ship's speed are also stowed there.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binoculars</ns0:orth>
        <ns0:pron>/bəˈnɒk.jə.lə(ɹ)z/</ns0:pron>
        <ns0:pron>/bɪˈnɒk.jʊ.lə(ɹ)z/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prismáticos</ns0:quote>
          <ns0:quote>binoculares</ns0:quote>
          <ns0:quote>gemelos</ns0:quote>
          <ns0:quote>largavista</ns0:quote>
          <ns0:quote>anteojos prismáticos</ns0:quote>
          <ns0:quote>gemelos prismáticos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hand-held device consisting of a series of lenses and prisms, used to magnify objects so that they can be better seen from a distance, and looked at through both eyes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binomial</ns0:orth>
        <ns0:pron>/baɪˈnoʊ.mi.əl/</ns0:pron>
        <ns0:pron>/baɪˈnəʊ.mi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>binomial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Consisting of two terms, or parts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binomial</ns0:orth>
        <ns0:pron>/baɪˈnoʊ.mi.əl/</ns0:pron>
        <ns0:pron>/baɪˈnəʊ.mi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>binomio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) A polynomial with two terms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binomial nomenclature</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nomenclatura binominal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(taxonomy) The scientific system of naming each species of organism with a Latinized name in two parts; the first is the genus, and is written with an initial capital letter; the second is some specific epithet that distinguishes the species within the genus. By convention, the whole name is typeset in italics. The genus part is often abbreviated to its initial letter e.g. H. sapiens for Homo sapiens</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binomial theorem</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>teorema del binomio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) A formula giving the expansion of a binomial such as ( a + b ) raised to any positive integer power, i.e. ( a + b )^{n} . It's possible to expand the power into a sum of terms of the form ax^{b}y^{c} where the coefficient of each term is a positive integer. For example:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binturong</ns0:orth>
        <ns0:pron>/-t(j)ʊɹ-/</ns0:pron>
        <ns0:pron>/-tju-/</ns0:pron>
        <ns0:pron>/-ɹɑŋ/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ˈbɪn.t(j)ʊəˌɹɒŋ/</ns0:pron>
        <ns0:pron>/ˈbɪn.tuˌɹɔŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manturón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large species of civet, Arctictis binturong, of southern Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>binucleate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>binuclear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) having two nuclei</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bio-</ns0:orth>
        <ns0:pron>/ˈbaɪˌoʊ/</ns0:pron>
        <ns0:pron>/ˈbaɪˌɐʉ/</ns0:pron>
        <ns0:pron>/ˈbaɪˌəʊ/</ns0:pron>
        <ns0:pron>/ˈbɑɪɐʉ/</ns0:pron>
        <ns0:pron>/ˈbɑɪˌəʉ/</ns0:pron>
        <ns0:pron>[ˈbaɪˌoː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bio-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>life</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioaccumulate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioacumular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, of a toxin) To accumulate in a biological system over time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioaccumulation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioacumulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The process by which substances accumulate in the tissues of living organisms; used especially of toxic substances that accumulate via a food chain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioaccumulative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioacumulativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a substance) That tends to accumulate in an organism when the organism's ability to remove it is insufficient.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioaerosol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioaerosol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An aerosol containing biologically active bacteria, spores, viruses, toxins, and other similar material</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioavailability</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodisponibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmacology, nutrition) The amount of drug or nutrient which reaches the site of physiological activity after administration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biobibliography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biobibliografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bibliography that also contains a short biography of the authors</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioboy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chico biológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A cisgender boy or man.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biocatalyst</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biocatalizador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A biochemical catalyst, such as an enzyme (either a protein enzyme or a ribozyme) or a biomolecular condensate that has biocatalytic ability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioceanic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioceánico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biochemical</ns0:orth>
        <ns0:pron>/ˌbaɪəʊˈkɛmɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioquímico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of, or relating to biochemistry</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>characterized by, produced by, or involving chemical processes in living organisms</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biochemiluminescence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioquimioluminiscencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>biochemical luminescence</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biochemist</ns0:orth>
        <ns0:pron>/ˌbʌɪə(ʊ)ˈkɛmɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioquímico</ns0:quote>
          <ns0:quote>bioquímica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A chemist whose speciality is biochemistry</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biochemistry</ns0:orth>
        <ns0:pron>/ˌbaɪəʊˈkɛmɪstɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioquímica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The chemistry of those compounds that occur in living organisms, and the processes that occur in their metabolism and catabolism; the study of such chemistry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The chemical characteristics of a particular living organism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biochronology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biocronología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, biology) The dating of rocks by analysis of their fossil content</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biocide</ns0:orth>
        <ns0:pron>/ˈbaɪoʊsaɪd/</ns0:pron>
        <ns0:pron>/ˈbaɪəʊsaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biocida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any action or substance that can destroy living organisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioclimatic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioclimático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the relationship between living things and climate.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architecture) Focused on providing a comfortable microclimate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biocoenosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biocenosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A community of interacting organisms that form a natural ecological unit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioconcentrate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioconcentrar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodegradability</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodegradabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capacity of a material to decompose over time as a result of biological activity, especially to be broken down by microorganisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodegradable</ns0:orth>
        <ns0:pron>/(ˌ)baɪoʊdəˈɡɹeɪdəbl̩/</ns0:pron>
        <ns0:pron>/(ˌ)baɪədəˈɡɹeɪdəbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodegradable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being decomposed by biological activity, especially by microorganisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodegradation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodegradación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The decomposition of any material by microorganisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodegrade</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodegradar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>to decompose as a result of biological action, especially by microorganisms</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodiesel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodiésel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fuel for diesel engines made from renewable organic raw materials, as opposed to fossil hydrocarbons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodiversity</ns0:orth>
        <ns0:pron>/ˌbaɪoʊdɑɪˈvɚsəti/</ns0:pron>
        <ns0:pron>/ˌbaɪoʊdəˈvɚsəti/</ns0:pron>
        <ns0:pron>/ˌbaɪə(ʊ)daɪˈvɜːsɪti/</ns0:pron>
        <ns0:pron>[-ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biodiversidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecology) The diversity (number and variety of species) of plant and animal life within a region.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodiversity hotspot</ns0:orth>
        <ns0:pron>/ˌbaɪoʊdəˌvɚsəti ˈhɑtˌspɑt/</ns0:pron>
        <ns0:pron>/ˌbaɪə(ʊ)daɪˌvɜːsɪti ˈhɒtˌspɒt/</ns0:pron>
        <ns0:pron>[-ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>punto caliente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecology) A place with a significant level of biodiversity, particularly if the flora and fauna are threatened with loss of their habitat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biodiversity offset</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>compensaciones ambientales</ns0:quote>
          <ns0:quote>compensaciones de biodiversidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(environmental policy) A measurable conservation outcome that has been designed to compensate for negative impacts on biodiversity that cannot be avoided or minimised.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioelectricity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioelectricidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, physics) Any form of electricity generated within an organism, especially by a muscle or nerve.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioethical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to bioethics</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioethics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioética</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ethics) The branch of ethics that studies the implications of biological and biomedical advances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biofilm</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biopelícula</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, medicine) A thin film of mucus created by and containing a colony of bacteria and other microorganisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biofuel</ns0:orth>
        <ns0:pron>/ˈbaɪ.əʊˌfjʊ(.ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biocarburante</ns0:quote>
          <ns0:quote>biocombustible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any fuel that is obtained from a renewable biological resource, especially from biomass.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biofumigation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biofumigación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>fumigation using a biofumigant</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biogas</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biogás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mixture of methane and carbon dioxide, produced by anaerobic digestion of organic waste matter, used as a fuel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biogenesis</ns0:orth>
        <ns0:pron>/-nɪ-/</ns0:pron>
        <ns0:pron>/baɪoʊ-/</ns0:pron>
        <ns0:pron>/baɪə-/</ns0:pron>
        <ns0:pron>/biːoʊ-/</ns0:pron>
        <ns0:pron>/biːə-/</ns0:pron>
        <ns0:pron>/bʌɪə(ʊ)ˈdʒɛnəsɪs/</ns0:pron>
        <ns0:pron>/ˌbaioʊˈd͡ʒɛnəsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biogénesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The principle that living organisms are produced only from other living organisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biogenic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biogénico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biogeocenology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biogeocenologia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biogeographic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biogeográfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to biogeography, the study of the geographical arrangement of plants and animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biogirl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chica biológica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A cisgender girl or woman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biographer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biógrafo</ns0:quote>
          <ns0:quote>biógrafa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The writer of a biography; a professional writer of biographies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biographette</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biografieta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A short biography.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biographical</ns0:orth>
        <ns0:pron>/ˌbaɪ.əˈɡɹæf.ɪ.kəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biográfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of or relating to an account of a person's life</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biography</ns0:orth>
        <ns0:pron>/baɪˈɑɡɹəfi/</ns0:pron>
        <ns0:pron>/baɪˈɒɡɹəfi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person's life story, especially one published.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biohazard</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>riesgo biológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A biological hazard; a source of risk due to some biological factor such as bacteria or human waste.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biohydrogen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biohidrógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>hydrogen produced biologically (mostly by bacteria) as a biofuel</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioindicator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioindicador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any species that acts as a biological indicator of the health of an environment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioinformatics</ns0:orth>
        <ns0:pron>/ˌbaɪoʊˌɪnfɚˈmætɪks/</ns0:pron>
        <ns0:pron>/ˌbaɪəʊˌɪnfəˈmætɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioinformática</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, computer science) A field of science in which biology, computer science, and information technology merge into a single discipline to analyse biological information using computers and statistical techniques.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biological</ns0:orth>
        <ns0:pron>/ˌbaɪ.ə(ʊ)ˈlɒd͡ʒ.ɪ.kəl/</ns0:pron>
        <ns0:pron>/ˌbaɪ.əˈlɑ.d͡ʒɪ.kəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to biology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biológico</ns0:quote>
          <ns0:quote>consanguíneo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Related by consanguinity, especially as to parents and children.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biological immortality</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inmortalidad biológica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The phenomenon in which some organisms such as hydra or jellyfish do not age.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biological warfare</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guerra biológica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The use of any harmful organism (such as a bacterium or virus) as a weapon of war.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biological weapon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arma biológica</ns0:quote>
          <ns0:quote>bioarma</ns0:quote>
          <ns0:quote>arma bacteriológica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A biological pathogen or toxin designed or used for warfare.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biologically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biológicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>With regard to biology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biologist</ns0:orth>
        <ns0:pron>/baɪˈɒləd͡ʒɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biólogo</ns0:quote>
          <ns0:quote>bióloga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A student of biology; one versed in the science of biology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biology</ns0:orth>
        <ns0:pron>/baj(ɵ)ˈlɔdʒi/</ns0:pron>
        <ns0:pron>/baɪˈɑ.lə.d͡ʒi/</ns0:pron>
        <ns0:pron>/baɪˈɒl.ə.d͡ʒɪ/</ns0:pron>
        <ns0:pron>/baɪˌɑl(ə)ˈd͡ʒi/</ns0:pron>
        <ns0:pron>/baˈjɔlədʒi/</ns0:pron>
        <ns0:pron>/ˈbaj(ɵ)lədʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of all life or living matter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioluminescence</ns0:orth>
        <ns0:pron>/ˌbaɪ̯oʊ̯ˌluməˈnɛsəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioluminiscencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, biochemistry) The emission of light by a living organism (such as a firefly).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioluminescent</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioluminescente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, biochemistry) Exhibiting bioluminescence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biomagnetism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biomagnetismo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biomarker</ns0:orth>
        <ns0:pron>/ˈbaɪoʊˌmɑɹkɚ/</ns0:pron>
        <ns0:pron>/ˈbaɪəʊˌmɑːkə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biomarcador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A substance used as an indicator of a biological state, most commonly disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biomass</ns0:orth>
        <ns0:pron>/ˈbaɪoʊˌmæs/</ns0:pron>
        <ns0:pron>/ˈbaɪə(ʊ)mæs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biomasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The total mass of all, or a specified category of, living things within a specific area, habitat, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Organic matter from living things which were recently alive (especially vegetation) used as a fuel or source of energy, especially if cultivated for that purpose; also, fuel produced from such organic matter; biofuel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biome</ns0:orth>
        <ns0:pron>/ˈbaɪ.oʊm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any major regional biological community such as that of forest or desert.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biomedicine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biomedicina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of medicine that studies the effects of environmental stress on organisms (most often in space travel).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biometrics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biometría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The automated measurement of biological data.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The automated recognition or authentication of an individual's identity based on their behavioural and biological characteristics, such as iris appearance, fingerprint, or face shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biometría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The analysis of biological statistics; biostatistics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biomicroscopy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biomicroscopia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The examination of the eye using a slit lamp biomicroscope</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biomolecule</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biomolécula</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) Molecules, such as amino acids, sugars, nucleic acids, proteins, polysaccharides, DNA, and RNA, that occur naturally in living organisms; any such molecule, even if created outside a living thing (as for example in a test tube or bioreactor).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bionic</ns0:orth>
        <ns0:pron>/ˈbɪˌɒn.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Related to bionics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bionics</ns0:orth>
        <ns0:pron>/ˈbaɪˌɒnɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biónica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The design of engineering systems, especially electronic ones, based on that of biological systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biophilia</ns0:orth>
        <ns0:pron>/ˌbaɪəʊˈfɪlɪ.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biofilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The love of or empathy with nature and all living things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biophysical</ns0:orth>
        <ns0:pron>/ˈbaɪəʊˌfɪzɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biofísico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to biophysics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biophysicist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biofísica</ns0:quote>
          <ns0:quote>biofísico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A biologist or physicist whose speciality is biophysics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biophysics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biofísica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The interdisciplinary science that applies theories and methods of the physical sciences to questions of biology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biopic</ns0:orth>
        <ns0:pron>/baɪˈɑ.pɪk/</ns0:pron>
        <ns0:pron>/ˈbaɪ.oʊ.pɪk/</ns0:pron>
        <ns0:pron>/ˈbaɪ.əʊ.pɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biopic</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(film genre) A motion picture based on the life (or lives) of a real, rather than fictional, person (or people).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biopiracy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biopiratería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pejorative) The appropriation of indigenous biomedical knowledge, especially by patenting naturally occurring substances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biopsy</ns0:orth>
        <ns0:pron>/ˈbaɪɑpsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biopsia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The removal and examination of a sample of tissue, cells, or bodily fluid from a living body for diagnostic purposes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biopsy</ns0:orth>
        <ns0:pron>/ˈbaɪɑpsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biopsiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To take a sample (a biopsy) for pathological examination.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioremediation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biorremediación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) The use of biological organisms, usually microorganisms, to remove contaminants, especially from polluted water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioscience</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biociencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several sciences that deal with living organisms</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biosimilar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biosimilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A variant of a biopharmaceutical that is marketed following the expiry of the original patent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biosolarization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biosolarización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fumigation of soil by means of compost and solarization</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biosphere</ns0:orth>
        <ns0:pron>/ˈbaɪəʊˌsfɪə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biosfera</ns0:quote>
          <ns0:quote>biósfera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The part of the Earth and its atmosphere capable of supporting life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biostatistics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioestadística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, mathematics) The application of statistics to the study and analysis of biological and medical data</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biostratigraphic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioestratigráfico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biostratigraphy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioestratigrafía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, geology) The study of the stratigraphic distribution of fossils.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biosynthesis</ns0:orth>
        <ns0:pron>/ˌbaɪoʊˈsɪn.θə.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biosíntesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) The synthesis of organic compounds within a living organism, especially the synthesis of large compounds from small ones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotechnological</ns0:orth>
        <ns0:pron>/ˈbaɪəʊˌtɛk.nə.lɒdʒ.ɪk.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biotecnológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to biotechnology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotechnology</ns0:orth>
        <ns0:pron>/ˈbaɪəʊˌtɛk.nɒl.əʊ.dʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biotecnología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The use of living organisms (especially microorganisms) in industrial, agricultural, medical and other technological applications.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The application of the principles and practices of engineering and technology to the life sciences.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioterrorism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioterrorismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Terrorism that involves biological weapons or other biological agents.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioterrorist</ns0:orth>
        <ns0:pron>/baɪ.oʊˈtɛ.ɹə.ɹɪst/</ns0:pron>
        <ns0:pron>/baɪ.əʊˈtɛ.ɹə.ɹɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioterrorista</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotherapy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioterapia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Any of several unrelated therapies that use natural biological processes, especially those that use parts of the immune system.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) The use of living organisms (such as maggots or leeches) in the control of disease or the healing of wounds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotic</ns0:orth>
        <ns0:pron>/baɪˈɑ.tɪk/</ns0:pron>
        <ns0:pron>/baɪˈɒt.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Of, pertaining to, or produced by life or living organisms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotin</ns0:orth>
        <ns0:pron>/ˈbaɪətɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biotina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(vitamin) A sulfur-containing member of the vitamin B complex, 5-[(3aS,4S,6aR)-2-oxohexahydro-1H-thieno[3,4-d]imidazol-4-yl]pentanoic acid, found in liver, egg yolk, milk, and yeast, essential to the activity of multiple enzyme systems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotite</ns0:orth>
        <ns0:pron>/ˈbaɪəˌtaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biotita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A dark brown mica; it is a mixed aluminosilicate and fluoride of potassium, magnesium and iron.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotope</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biotopo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographical area that has a uniform biological environment and a uniform distribution of plants and animals</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>biotransformation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>biotransformación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) The changes (both chemical and physical) that occur to a substance (especially a drug) by the actions of enzymes within an organism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bioweapon</ns0:orth>
        <ns0:pron>/ˈbaɪ.oʊˌwɛ.pən/</ns0:pron>
        <ns0:pron>/ˈbaɪ.əʊˌwɛ.pən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bioarma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any weapon designed to be used in biological warfare.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
