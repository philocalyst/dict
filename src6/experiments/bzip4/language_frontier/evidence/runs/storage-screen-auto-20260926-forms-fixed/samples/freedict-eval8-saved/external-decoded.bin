        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arresto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The process of arresting a criminal, suspect etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detenido</ns0:quote>
