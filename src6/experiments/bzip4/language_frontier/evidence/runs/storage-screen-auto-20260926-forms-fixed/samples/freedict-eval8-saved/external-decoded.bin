    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>award</ns0:orth>
        <ns0:pron>/əˈwɔɹd/</ns0:pron>
        <ns0:pron>/əˈwɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>laudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A judgment, sentence, or final decision. Specifically: The decision of arbitrators in a case submitted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>premio</ns0:quote>
          <ns0:quote>galardón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A trophy or medal; something that denotes an accomplishment, especially in a competition. A prize or honor based on merit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
