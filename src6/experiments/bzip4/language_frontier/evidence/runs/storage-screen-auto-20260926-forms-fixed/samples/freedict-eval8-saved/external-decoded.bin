        </ns0:cit>
        <ns0:sense>
          <ns0:def>(galaxy) The Milky Way Galaxy, the galaxy in which Earth is located. [from mid 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Vía Láctea</ns0:quote>
          <ns0:quote>Camino de Santiago</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A broad band of diffuse white light, visible in the night sky; our view of the dense portions of the Milky Way Galaxy from inside the galaxy. [from late 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
