        <ns0:pron>/ˈwɪs.tɚ.ʃaɪɚ ˈsɑs/</ns0:pron>
        <ns0:pron>/ˈwɪs.tɚ.ʃaɪɚ ˈsɔs/</ns0:pron>
        <ns0:pron>/ˈwɪs.tɚ.ʃɪɹ ˈsɑs/</ns0:pron>
        <ns0:pron>/ˈwɪs.tɚ.ʃɪɹ ˈsɔs/</ns0:pron>
        <ns0:pron>/ˈwʊs.tɚ.ʃaɪɚ ˈsɑs/</ns0:pron>
        <ns0:pron>/ˈwʊs.tɚ.ʃaɪɚ ˈsɔs/</ns0:pron>
        <ns0:pron>/ˈwʊs.tɚ.ʃɚ ˈsɑs/</ns0:pron>
        <ns0:pron>/ˈwʊs.tɚ.ʃɚ ˈsɔs/</ns0:pron>
        <ns0:pron>/ˈwʊs.tɚ.ʃɪɹ ˈsɑs/</ns0:pron>
        <ns0:pron>/ˈwʊs.tɚ.ʃɪɹ ˈsɔs/</ns0:pron>
        <ns0:pron>/ˈwʊstə(ɹ)ʃə(ɹ) ˈsɔːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salsa Worcestershire</ns0:quote>
          <ns0:quote>salsa inglesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An English condiment made with vinegar, onions, garlic, etc.; a thin piquant sauce used as a table sauce, to flavour casseroles etc. and as an ingredient in Bloody Marys.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Word</ns0:orth>
        <ns0:pron>/weːd/</ns0:pron>
        <ns0:pron>/wøːd/</ns0:pron>
        <ns0:pron>/wəɹd/</ns0:pron>
        <ns0:pron>/wɛːd/</ns0:pron>
        <ns0:pron>/wɜːd/</ns0:pron>
        <ns0:pron>/wɝd/</ns0:pron>
        <ns0:pron>/wʌrd/</ns0:pron>
        <ns0:pron>[wɚ(ɹ)d]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Verbo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Scripture; the Bible.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The creative word of God; Logos.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Word of Wisdom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Palabra de Sabiduría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Mormonism) The health code contained in the Doctrine and Covenants. It specifically prohibits the consumption of alcohol, tobacco, hot drinks (usually interpreted/construed as coffee and/or tea), and excessive amounts of meat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Wordian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wordiense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, paleontology) A subdivision of the Permian period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Bank</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Banco Mundial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of five financial organizations whose purpose is economic development and the elimination of poverty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Exposition</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Exposición Universal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various large international expositions held since the mid 19th century, often called "Expo".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Health Assembly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Asamblea Mundial de la Salud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the forum through which the World Health Organization (WHO) is governed by its member states</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Health Organization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Organización Mundial de la Salud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agency of the United Nations responsible for international public health</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Heritage Site</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Patrimonio de la Humanidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place listed by UNESCO as being of special cultural or physical significance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Trade Center</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>World Trade Center</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World Trade Organization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Organización Mundial del Comercio</ns0:quote>
          <ns0:quote>OMC</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An international organization designed by its founders to supervise and liberalize international trade.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>World War I</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Primera Guerra Mundial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) The war from 1914 to 1918 between the Entente Powers of the British Empire, Russian Empire, France, Italy, the United States and other allied nations, against the Central Powers represented by the German Empire, Austria-Hungary, the Ottoman Empire, and Bulgaria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
