      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astronómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable, astronomy) Of or relating to astronomy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(comparable) Very large; of vast measure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astronomical unit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>unidad astronómica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) 149,597,870,700 metres, the approximate mean distance from the Earth to the Sun (the semi-major axis of Earth's orbit), (symbol AU), used to measure distances in the solar system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astronomically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astronómicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Of or relating to astronomy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(comparable, degree) In the extreme, very (typically very large).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astronomy</ns0:orth>
        <ns0:pron>/asʈro.nɔmi/</ns0:pron>
        <ns0:pron>/æsˈtɹɑn.ə.mi/</ns0:pron>
        <ns0:pron>/əsˈʈrɔnəmi/</ns0:pron>
        <ns0:pron>/əˈstɹɑn.ə.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astronomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of the physical universe beyond the Earth's atmosphere, including the process of mapping locations and properties of the matter and radiation in the universe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astrophotography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astrofotografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy, photography) The photography or imaging of astronomical objects, celestial events or areas of the night sky.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astrophysical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astrofísico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to astrophysics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astrophysicist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astrofísico</ns0:quote>
          <ns0:quote>astrofísica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who studies astrophysics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astrophysics</ns0:orth>
        <ns0:pron>/ˌæs.tɹoʊˈfɪz.ɪks/</ns0:pron>
        <ns0:pron>/ˌæs.tɹəˈfɪz.ɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astrofísica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of astronomy or physics that deals with the physical properties of celestial bodies and with the interaction between matter and radiation in celestial bodies and in the space between them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astrotourism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astroturismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Tourism for the purpose of observing stars, meteors, eclipses, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astrovideography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astrovideografía</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astute</ns0:orth>
        <ns0:pron>/əsˈtjuːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astuto</ns0:quote>
          <ns0:quote>perspicaz</ns0:quote>
          <ns0:quote>sagaz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Quickly and critically discerning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astutely</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astutamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an astute manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>astuteness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>astucia</ns0:quote>
          <ns0:quote>letra menuda</ns0:quote>
          <ns0:quote>sagacidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being astute.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asunder</ns0:orth>
        <ns0:pron>/əˈsʌndə/</ns0:pron>
        <ns0:pron>/əˈsʌndɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en dos</ns0:quote>
          <ns0:quote>en pedazos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, literary) Into separate parts or pieces.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asylee</ns0:orth>
        <ns0:pron>/əsaɪˈli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asilado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A non-citizen of a country who has been granted asylum in that country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asylum</ns0:orth>
        <ns0:pron>/əˈsaɪləm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asilo</ns0:quote>
          <ns0:quote>santuario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place of safety or refuge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manicomio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) A place of protection or restraint for one or more classes of the disadvantaged, especially the mentally ill.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asylum seeker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>solicitante de asilo</ns0:quote>
          <ns0:quote>asilante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who has applied for asylum in a foreign country but has not yet been granted refugee status by that country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymmetric</ns0:orth>
        <ns0:pron>/ˌeɪ.səˈmɛt.ɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asimétrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not symmetric.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymmetric warfare</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guerra asimétrica</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymmetrical</ns0:orth>
        <ns0:pron>/ˌeɪsɪˈmɛtɹɪk(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asimétrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not symmetrical.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymmetrically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asimétricamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an asymmetric manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymmetry</ns0:orth>
        <ns0:pron>/eɪˈsɪmɪtɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asimetría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Absence of symmetry or proportion between the parts of a thing, or a distinction that produces such a lack of symmetry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymptomatic</ns0:orth>
        <ns0:pron>/ˌeɪsɪm(p)təˈmætɪk/</ns0:pron>
        <ns0:pron>/ˌeɪˌsɪm(p)təˈmætɪk/</ns0:pron>
        <ns0:pron>[-ɾɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asintomático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Not exhibiting any symptoms of disease, as for example in a case which is subclinical.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymptote</ns0:orth>
        <ns0:pron>/ˈeɪ̯sɪmtoʊ̯t/</ns0:pron>
        <ns0:pron>/ˈæsɪmptoʊ̯t/</ns0:pron>
        <ns0:pron>/ˈæsɪmtoʊ̯t/</ns0:pron>
        <ns0:pron>/ˈæsɪmtɒt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asíntota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(analysis) A straight line which a curve approaches arbitrarily closely as it goes to infinity. The limit of the curve; its tangent "at infinity".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asymptotic</ns0:orth>
        <ns0:pron>/ˌæsəm(p)ˈtɑtɪk/</ns0:pron>
        <ns0:pron>/ˌæsəm(p)ˈtɔtɪk/</ns0:pron>
        <ns0:pron>/ˌæsɪm(p)ˈtɒtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asintótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) Pertaining to values or properties approached at infinity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asynchronous</ns0:orth>
        <ns0:pron>/eɪˈsɪŋkɹənəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asincrónico</ns0:quote>
          <ns0:quote>asíncrono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not synchronous; occurring at different times.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing, of a request or a message) Allowing the client to continue during processing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asynchronously</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asíncronamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an asynchronous manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asynchrony</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asincronismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being asynchronous, or out of synchronization</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asyndeton</ns0:orth>
        <ns0:pron>/æˈsɪn.də.tən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asíndeton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar, rhetoric) Omission of conjunctions, especially for rhetorical effect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>asystole</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistolia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, cardiology) An absence of a systole; a failure of the heart to contract.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at</ns0:orth>
        <ns0:pron>/æt/</ns0:pron>
        <ns0:pron>/ət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In, near, or in the general vicinity of (a particular place).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
          <ns0:quote>ad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indicating time of occurrence, especially an instant of time, or a period of time relatively short in context or from the speaker’s perspective.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
          <ns0:quote>ante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the direction of; towards; (often implied to be in a hostile or careless manner).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In response or reaction to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Denotes a price.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Indicates a position on a scale or in a series.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at a loss</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a pérdida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(trade) Below the cost or price of purchase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at a loss for words</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corchado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Having nothing to say; not knowing what to say; stunned to the point of being speechless.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at a moment's notice</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin antelación</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at a push</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apurando</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>not later than, at the latest</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at a time</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la vez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a single, continuous period of time.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Simultaneously at each occurrence (of some action).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at all</ns0:orth>
        <ns0:pron>[ætˈoːɫ]</ns0:pron>
        <ns0:pron>[æˈɾɑ̈ɫ]</ns0:pron>
        <ns0:pron>[æˈɾɔɫ]</ns0:pron>
        <ns0:pron>[əˈtʰoːɫ]</ns0:pron>
        <ns0:pron>[əˈɾoːɫ]</ns0:pron>
        <ns0:pron>[əˈɾɑ̈ɫ]</ns0:pron>
        <ns0:pron>[əˈɾɔɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en absoluto</ns0:quote>
          <ns0:quote>algún</ns0:quote>
          <ns0:quote>en lo absoluto</ns0:quote>
          <ns0:quote>en realidad</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at all costs</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cueste lo que cueste</ns0:quote>
          <ns0:quote>a rajatabla</ns0:quote>
          <ns0:quote>a toda costa</ns0:quote>
          <ns0:quote>a cualquier precio</ns0:quote>
          <ns0:quote>a todo trance</ns0:quote>
          <ns0:quote>a ultranza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As an absolute imperative; sparing no effort or expense</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at any given moment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en un momento dado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) at any point of time</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at arm's length</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la mano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At a distance, away from one's body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at bay</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a raya</ns0:quote>
          <ns0:quote>al margen</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set phrase, idiomatic) Unable to come closer; at a distance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at best</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como mucho</ns0:quote>
          <ns0:quote>a lo más</ns0:quote>
          <ns0:quote>a lo sumo</ns0:quote>
          <ns0:quote>en el mejor de los casos</ns0:quote>
          <ns0:quote>como máximo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the most favorable of conditions, especially in a situation that is otherwise negative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at dark</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>durante el anochecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>During nightfall.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at death's door</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a las últimas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) About to die; in a life-threatening state of health.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at each other's throats</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estar de uñas</ns0:quote>
          <ns0:quote>tirarse los trastos a la cabeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In mutual conflict.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at ease</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a gusto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Free of anxiety; not stressed or tense.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at fault</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>culpable</ns0:quote>
          <ns0:quote>en falta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of hunting dogs: unable to find the scent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at first</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al principio</ns0:quote>
          <ns0:quote>al inicio</ns0:quote>
          <ns0:quote>en un principio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Initially; at the start; originally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at first blush</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a primera vista</ns0:quote>
          <ns0:quote>al principio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Upon first impression or consideration; seemingly, apparently, ostensibly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at first glance</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a primera vista</ns0:quote>
          <ns0:quote>a media vista</ns0:quote>
          <ns0:quote>a simple vista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(modal) After only a superficial examination or review.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at gunpoint</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a punta de pistola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Under coercion by someone with a firearm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at hand</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a mano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Within easy reach; nearby.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at home</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en casa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used other than figuratively or idiomatically: see at,‎ home. In one's place of residence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at large</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prófugo</ns0:quote>
          <ns0:quote>suelto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) On the loose; roaming freely; not confined.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al completo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) In full, fully.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en general</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In general; as a whole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at last</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por fin</ns0:quote>
          <ns0:quote>al fin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) After a long time; eventually.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al fin</ns0:quote>
          <ns0:quote>por fin</ns0:quote>
          <ns0:quote>al cabo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In the end; finally; ultimately.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at least</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al menos</ns0:quote>
          <ns0:quote>por lo menos</ns0:quote>
          <ns0:quote>siquiera</ns0:quote>
          <ns0:quote>cuando menos</ns0:quote>
          <ns0:quote>a lo menor</ns0:quote>
          <ns0:quote>como mínimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(focus) At a minimum or lower limit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al menos</ns0:quote>
          <ns0:quote>aun así</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In any event; anyway.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at length</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detalladamente</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extensamente</ns0:quote>
          <ns0:quote>largamente</ns0:quote>
          <ns0:quote>largo rato</ns0:quote>
          <ns0:quote>largo tiempo</ns0:quote>
          <ns0:quote>largo y tendido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>For a long time; extensively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al fin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(formal, _, or, _, dated) At last, finally, eventually.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at loggerheads</ns0:orth>
        <ns0:pron>/æt ˈlɒɡəhɛdz/</ns0:pron>
        <ns0:pron>/æt ˈlɔɡɚˌhɛdz/</ns0:pron>
        <ns0:pron>/ˈlɑ-/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la greña</ns0:quote>
          <ns0:quote>de pique</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Unable to agree; opposing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at most</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>como mucho</ns0:quote>
          <ns0:quote>a lo sumo</ns0:quote>
          <ns0:quote>como máximo</ns0:quote>
          <ns0:quote>no más de</ns0:quote>
          <ns0:quote>a lo mayor</ns0:quote>
          <ns0:quote>a todo tirar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At the most; at a maximum or upper limit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at night</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de noche</ns0:quote>
          <ns0:quote>por la noche</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>During the night.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at odds</ns0:orth>
        <ns0:pron>/ət‿ˈɑdz/</ns0:pron>
        <ns0:pron>/ət‿ˈɒdz/</ns0:pron>
        <ns0:pron>/ət‿ˈɔdz/</ns0:pron>
        <ns0:pron>[əɾ‿ˈɑdz]</ns0:pron>
        <ns0:pron>[əɾ‿ˈɒdz]</ns0:pron>
        <ns0:pron>[əɾ‿ˈɔdz]</ns0:pron>
        <ns0:pron>[əɾ‿ˈɔ̟dz]</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en conflicto</ns0:quote>
          <ns0:quote>en desacuerdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In disagreement; conflicting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at once</ns0:orth>
        <ns0:pron>/ət ˈwʌns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la vez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At the same time; simultaneously; together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en seguida</ns0:quote>
          <ns0:quote>ahora mismo</ns0:quote>
          <ns0:quote>agora</ns0:quote>
          <ns0:quote>altiro</ns0:quote>
          <ns0:quote>en un plis plas</ns0:quote>
          <ns0:quote>en un santiamén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Immediately; now; right away.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at one blast</ns0:orth>
        <ns0:pron>/ət wɒn ˈblɑːst/</ns0:pron>
        <ns0:pron>/ət wʌn ˈblæst/</ns0:pron>
        <ns0:pron>/ət wʌn ˈblɑːst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de un plumazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) At once, at the same moment in time. [from 1379]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at one stroke</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de un plumazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literal) With a single blow, effort, or act.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at one's own risk</ns0:orth>
        <ns0:pron>/ət wʌnz ˈəʊn ɹɪsk/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por su cuenta y riesgo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Taking personal responsibility for any harm that arises from a dangerous activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at random</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al azar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Randomly, haphazardly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at scale</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a gran escala</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On a large scale: involving large amounts or volumes of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at sign</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arroba</ns0:quote>
          <ns0:quote>a comercial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) The symbol @, used in e-mail addresses to separate the user name from the domain name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at sixes and sevens</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hecho un lío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, UK, Irish, Commonwealth) In a state of confusion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(idiomatic, of people or groups) In a state of dispute or disagreement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at stake</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en juego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) At issue, at risk.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at that</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>además</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In addition to what has been said; furthermore; moreover.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the best of times</ns0:orth>
        <ns0:pron>/æt‿ðə ˈbɛst‿əv ˈtaɪmz/</ns0:pron>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en el mejor de los casos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Even under the most favourable conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the drop of a hat</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a las primeras de cambio</ns0:quote>
          <ns0:quote>al instante</ns0:quote>
          <ns0:quote>de buenas a primeras</ns0:quote>
          <ns0:quote>de inmediato</ns0:quote>
          <ns0:quote>en un abrir y cerrar de ojos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, idiom) Without any hesitation; instantly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the end of the day</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al fin y al cabo</ns0:quote>
          <ns0:quote>a fin de cuentas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In summary; ultimately.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the expense of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a costa de</ns0:quote>
          <ns0:quote>a expensas de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) Paid for by an individual or group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a expensas de</ns0:quote>
          <ns0:quote>a costa de</ns0:quote>
          <ns0:quote>a costo de</ns0:quote>
          <ns0:quote>a cuenta de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) In a way as to harm somebody or something; to the detriment of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the feet of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a los pies de</ns0:quote>
          <ns0:quote>afectísimo</ns0:quote>
          <ns0:quote>sacrificado a</ns0:quote>
          <ns0:quote>servicial a</ns0:quote>
          <ns0:quote>subyugado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As being the work or responsibility of; attributed to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a los pies de</ns0:quote>
          <ns0:quote>afectísimo</ns0:quote>
          <ns0:quote>de la escuela de</ns0:quote>
          <ns0:quote>de la filiación de</ns0:quote>
          <ns0:quote>de la sangre de</ns0:quote>
          <ns0:quote>del estirpe de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used other than figuratively or idiomatically: see at,‎ feet,‎ of. Situated near the feet of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the hands of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en manos de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>By the actions of (someone).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the helm</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al timón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical, literally) Steering a vessel.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(idiomatic) In charge of a company or project.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the last minute</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a última hora</ns0:quote>
          <ns0:quote>en el último momento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Very close to a deadline or potential crucial event.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the latest</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a más tardar</ns0:quote>
          <ns0:quote>como muy tarde</ns0:quote>
          <ns0:quote>como máximo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>not later than</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the mercy of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a merced de</ns0:quote>
          <ns0:quote>a la merced de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In the power of; defenceless/defenseless against.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the moment</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por el momento</ns0:quote>
          <ns0:quote>de momento</ns0:quote>
          <ns0:quote>en aqueste momento</ns0:quote>
          <ns0:quote>en el momento</ns0:quote>
          <ns0:quote>en este momento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At this moment; right now.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the ready</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a punto</ns0:quote>
          <ns0:quote>al pie del cañón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Ready; in a state of preparation or waiting; in position or anticipation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the risk of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a riesgo de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Despite the likelihood of (something bad happening).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the same time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al mismo tiempo</ns0:quote>
          <ns0:quote>a la vez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Overlapping or coinciding in duration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the time</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en ese momento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Back then, at the time referred to the specific time period, era, or time frame in the past.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the top of one's lungs</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a pleno pulmón</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at the top of one's voice</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a grito limpio</ns0:quote>
          <ns0:quote>a grito pelado</ns0:quote>
          <ns0:quote>a voz en cuello</ns0:quote>
          <ns0:quote>a voz en grito</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at this point</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a aquestas alturas</ns0:quote>
          <ns0:quote>a estas alturas</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at times</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a veces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) On occasion, sometimes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at war</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en guerra</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at will</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a discreción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) At one's preference; as one sees fit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at work</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en el trabajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used other than figuratively or idiomatically: see at,‎ work. At one's workplace.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de obras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Working, in the process of doing work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at worst</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a lo peor</ns0:quote>
          <ns0:quote>en el peor caso</ns0:quote>
          <ns0:quote>en el peor de los casos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>If the worst possible alternative happens (especially in an otherwise positive situation).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at your service</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a su servicio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(formal) Used as a polite introduction on first meeting another person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>at-grade</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>parejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) Describing a junction or intersection where two or more transport axes cross at the same level (or grade).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ataman</ns0:orth>
        <ns0:pron>/ˈætəmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atamán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A title of Cossack and haidamak leaders of various kinds. The term was also used for the leader of a fisherman artel and of a band of robbers or thieves.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ataraxia</ns0:orth>
        <ns0:pron>/ætəˈɹæksiə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ataraxia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary, Greek, _, philosophy) Tranquility of mind; absence of mental disturbance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atavism</ns0:orth>
        <ns0:pron>/ˈætəˌvɪzəm/</ns0:pron>
        <ns0:pron>[ˈæɾəˌvɪzəm]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atavismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The reappearance of an ancestral characteristic in an organism after several generations of absence; a throwback.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atavistic</ns0:orth>
        <ns0:pron>/æt.əˈvɪs.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atávico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Of the recurrence of a trait reappearing after an absence of one or more generations due to a chance recombination of genes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ataxia</ns0:orth>
        <ns0:pron>/eɪˈtæksɪə/</ns0:pron>
        <ns0:pron>/əˈtæksɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ataxia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physical chemistry, organic chemistry) The condition of a polymer in which the orientation of the subunits is random</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atelectasis</ns0:orth>
        <ns0:pron>/æ.tɪˈlɛk.tə.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atelectasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The collapse of a part of or the whole lung caused by inner factors rather than a pneumothorax.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atelier</ns0:orth>
        <ns0:pron>/-ˌljɛ/</ns0:pron>
        <ns0:pron>/æ.təˈljeɪ/</ns0:pron>
        <ns0:pron>/əˈtɛl.i.eɪ/</ns0:pron>
        <ns0:pron>/əˈtɛl.jeɪ/</ns0:pron>
        <ns0:pron>/əˈtɛlˌjeɪ/</ns0:pron>
        <ns0:pron>/ˈæ.təˌljeɪ/</ns0:pron>
        <ns0:pron>/ˌæ.təlˈjeɪ/</ns0:pron>
        <ns0:pron>[ˌæ.ɾəl-]</ns0:pron>
        <ns0:pron>[ˌæ.ɾɫ̩-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>taller</ns0:quote>
          <ns0:quote>atelier</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atelophobia</ns0:orth>
        <ns0:pron>/əˌtɛləˈfoʊbɪə/</ns0:pron>
        <ns0:pron>/əˌtɛləˈfəʊbɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atelofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fear of imperfection or not being good enough.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atemoya</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anón</ns0:quote>
          <ns0:quote>atemoya</ns0:quote>
          <ns0:quote>chirimorinon</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The tree that bears this fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atemporal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atemporal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Unaffected by time; timeless; permanent or unchanging.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athame</ns0:orth>
        <ns0:pron>/ɑˈθɑ.meɪ/</ns0:pron>
        <ns0:pron>/əˈθeɪmeɪ/</ns0:pron>
        <ns0:pron>/əˈθɑ.meɪ/</ns0:pron>
        <ns0:pron>/əˈθɑːmeɪ/</ns0:pron>
        <ns0:pron>/ˈæ.θəˌmeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>daga</ns0:quote>
          <ns0:quote>átame</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ceremonial pointed knife or dagger, used especially in Wicca and other neopagan traditions and typically having a black handle with magical symbols on it. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athanor</ns0:orth>
        <ns0:pron>/ˈæθənɔɹ/</ns0:pron>
        <ns0:pron>/ˈæθənɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>athanor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A furnace or stove designed and used to maintain uniform heat, primarily used by alchemists. [from late 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atheism</ns0:orth>
        <ns0:pron>/ˈeɪ.θi.ɪ.zəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ateísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(broadly) A lack of belief in deities, or a belief that there is insufficient evidence to believe in a god.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(narrowly) Belief that no deities exist (sometimes including rejection of other religious beliefs).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atheist</ns0:orth>
        <ns0:pron>/ˈeɪθiɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ateo</ns0:quote>
          <ns0:quote>atea</ns0:quote>
          <ns0:quote>ateísta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(broadly) A person who doubts the existence of deities (therefore, an agnostic may be considered an atheist).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(narrowly) A person who is certain that no deities exist or who thinks that the existence of deities can be disproven.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atheistic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ateo</ns0:quote>
          <ns0:quote>ateísta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to atheists or atheism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athenaeum</ns0:orth>
        <ns0:pron>/aθɪˈniːəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ateneo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An association or institution for the advancement of learning, particularly in science or literature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atherectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aterectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) The surgical procedure to remove plaque from an artery.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athermic</ns0:orth>
        <ns0:pron>/ˌeɪˈθɜɹmɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atérmico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>resistant to heat passing through; heat-resistant, heatproof</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atherosclerosis</ns0:orth>
        <ns0:pron>/ˌæθɚoʊskləˈɹoʊsəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ateroesclerosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The clogging or hardening of arteries or blood vessels caused by plaques (accumulations of fatty deposits, usually cholesterol).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atherosclerotic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aterosclerótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or afflicted with atherosclerosis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athleisure</ns0:orth>
        <ns0:pron>/ˌæθˈliː.ʒɚ/</ns0:pron>
        <ns0:pron>/ˌæθˈlɛʒ.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atletocio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(attributive) Clothing that is appropriate for both athletic and leisure pursuits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athlete</ns0:orth>
        <ns0:pron>/ˈæθ.lit/</ns0:pron>
        <ns0:pron>/ˈæθ.liːt/</ns0:pron>
        <ns0:pron>/ˈæθ.ə.liːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atleta</ns0:quote>
          <ns0:quote>deportista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A participant in any of a group of sporting activities including track and field, road running, cross country running and racewalking.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(US, Canada) A person who actively participates in physical sports, especially with great skill; a sportsperson.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atletica</ns0:quote>
          <ns0:quote>atleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An exceptionally physically fit person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athlete's foot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pie de atleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) A fungal infection of the skin of the foot, usually between the toes, caused by pathogen fungi, such as Trichophyton rubrum, Trichophyton interdigitale, syn. Trichophyton mentagrophytes, or Epidermophyton floccosum</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athletic</ns0:orth>
        <ns0:pron>/æθˈlɛt.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atlético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Having to do with athletes.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Physically active.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having a muscular, well developed body, being in shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athletic shoe</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zapatilla deportiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(footwear) A shoe designed for sports or other forms of physical exercise, typically with a soft, rubber sole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athletics</ns0:orth>
        <ns0:pron>/æθˈlɛtɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atletismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports, especially, _, US) Physical activities such as sports and games requiring stamina, fitness and skill.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>athwart</ns0:orth>
        <ns0:pron>/əˈθwɔɹt/</ns0:pron>
        <ns0:pron>/əˈθwɔːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a través</ns0:quote>
          <ns0:quote>de lado a lado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From side to side, often in an oblique manner; across or over.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atlas</ns0:orth>
        <ns0:pron>/ˈætləs/</ns0:pron>
        <ns0:pron>/ˈætlɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atlas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bound collection of maps often including tables, illustrations or other text.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A bound collection of tables, illustrations, etc. on any given subject.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(anatomy) The uppermost vertebra of the cervical spine in the neck in humans and some other animals.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architecture) A figure of a man used as a column.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atlatl</ns0:orth>
        <ns0:pron>/ˈatlat(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estólica</ns0:quote>
          <ns0:quote>lanzadardos</ns0:quote>
          <ns0:quote>propulsor</ns0:quote>
          <ns0:quote>átlatl</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A spearthrower consisting of a wooden stick with a thong or perpendicularly protruding hook on the rear end that grips a grove or socket on the butt of its accompanying spear (or dart), intended to steady the spear immediately prior to throwing, to increase its potential range when thrown, and to increase its force of penetration of the target. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atmo-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atmo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Related to air or vapor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atmosphere</ns0:orth>
        <ns0:pron>/əʈˈmɔsfir/</ns0:pron>
        <ns0:pron>/ˈæt.məsˌfɪə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈætməsˌfɪɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atmósfera</ns0:quote>
          <ns0:quote>ambiente</ns0:quote>
          <ns0:quote>clima</ns0:quote>
          <ns0:quote>aire</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The gases surrounding the Earth or any astronomical body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atmósfera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The air in a particular place.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A unit of measurement for pressure equal to 101325 Pa (symbol: atm), approximately the atmospheric pressure at sea level.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>clima</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) The conditions (such as music, illumination etc.) that can influence the mood felt in an environment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atmospheric</ns0:orth>
        <ns0:pron>/ˌætməsˈfɛɹɪk/</ns0:pron>
        <ns0:pron>/ˌætməsˈfɪ(ə)ɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atmosférico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, produced by, or coming from the atmosphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atmospheric pressure</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>presión atmosférica</ns0:quote>
          <ns0:quote>presión barométrica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, meteorology) The pressure caused by the weight of the atmosphere above an area.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atole</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atol</ns0:quote>
          <ns0:quote>atole</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sweetened thick drink or thin gruel made from cornmeal, served hot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atoll</ns0:orth>
        <ns0:pron>/əˈtɑl/</ns0:pron>
        <ns0:pron>/əˈtɒl/</ns0:pron>
        <ns0:pron>/ˈeɪtɑl/</ns0:pron>
        <ns0:pron>/ˈeɪtɔl/</ns0:pron>
        <ns0:pron>/ˈætoʊl/</ns0:pron>
        <ns0:pron>/ˈætɑl/</ns0:pron>
        <ns0:pron>/ˈætɒl/</ns0:pron>
        <ns0:pron>/ˈætɔl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atolón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of island consisting of a ribbon reef that nearly or entirely surrounds a lagoon and supports, in most cases, one to many islets on the reef platform.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atom</ns0:orth>
        <ns0:pron>/ˈætəm/</ns0:pron>
        <ns0:pron>[ˈæɾm̩]</ns0:pron>
        <ns0:pron>[ˈæɾəm]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>átomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry, physics) The smallest possible amount of matter which still retains its identity as a chemical element, now known to consist of a nucleus surrounded by electrons. [from 16th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(history of science) A hypothetical particle posited by Greek philosophers as an ultimate and indivisible component of matter. [from 15th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(now generally regarded, _, figuratively) The smallest, indivisible constituent part or unit of something. [from 17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) A non-zero member of a partially ordered set that has only zero below it (assuming that the poset has a least element, its "zero"). [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic</ns0:orth>
        <ns0:pron>/əˈtɑː.mɪk/</ns0:pron>
        <ns0:pron>/əˈtɒm.ɪk/</ns0:pron>
        <ns0:pron>/əˈtɔm.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, chemistry) Of or relating to atoms; composed of atoms; monatomic.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Employing or relating to nuclear energy or processes.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Unable to be split or made any smaller.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing, of an operation) Guaranteed to complete either fully or not at all while waiting in a pause, and running synchronously when called by multiple asynchronous threads.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic absorption spectroscopy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espectroscopía de absorción atómica</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic bomb</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bomba atómica</ns0:quote>
          <ns0:quote>bombo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, military) A nuclear weapon that obtains its destructive energy from nuclear fission.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic clock</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reloj atómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extremely accurate reference clock whose operation is based on an atomic process, typically the frequency of electromagnetic radiation associated with a specified energy-level transition in an element such as cesium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic emission spectroscopy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espectroscopía de emisión atómica</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic mass</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>masa atómica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(proscribed) atomic weight; the average mass of atoms of an element.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic nucleus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>núcleo atómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A nucleus of an atom; consisting of protons and neutrons, surrounded by an electron cloud.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic number</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>número atómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, chemistry) The number of protons in an atom. Symbol: Z</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic physics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>física atómica</ns0:quote>
          <ns0:quote>física nuclear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of physics that studies the atomic structure and the interaction between atoms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomic weight</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>peso atómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) Former term for the more specific relative atomic mass.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) A term used to represent the mean relative atomic mass of an element in nature, as distinct from the relative atomic mass of a single isotope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomicity</ns0:orth>
        <ns0:pron>/ˌætəˈmɪsɪti/</ns0:pron>
        <ns0:pron>[-ɾi]</ns0:pron>
        <ns0:pron>[-ɾə-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atomicidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Synonym of valence (“the combining capacity of an atom, functional group, or radical determined by the number of atoms of hydrogen with which it will unite, or the number of electrons that it will gain, lose, or share when it combines with other atoms, etc.”).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atomización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or an instance of atomizing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomize</ns0:orth>
        <ns0:pron>/ˈætəmaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atomizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To separate or reduce into atoms.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To make into a fine spray.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To fragment; to break into small pieces or concepts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomizer</ns0:orth>
        <ns0:pron>/ˈæt.əˌmaɪz.ə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæt.əˌmaɪz.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atomizador</ns0:quote>
          <ns0:quote>pulverizador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument for reducing a liquid to spray or vapor for disinfecting, cooling, medical use or perfume spraying.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atomoxetine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atomoxetina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound, pharmaceutical drug) A nonstimulant drug used for the treatment of attention-deficit hyperactivity disorder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atonal</ns0:orth>
        <ns0:pron>/eɪˈtoʊnəl/</ns0:pron>
        <ns0:pron>/eɪˈtəʊnəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atonal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) Lacking a tonal center or key.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atonality</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atonalidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, music) A style of music that is written without a key.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atone</ns0:orth>
        <ns0:pron>/əˈtoʊn/</ns0:pron>
        <ns0:pron>/əˈtəʊn/</ns0:pron>
        <ns0:pron>[əˈtʰoʊ̯n]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>expiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To make reparation, compensation, amends or satisfaction for an offence, crime, mistake or deficiency. [from 1680s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(proscribed) To absolve (someone else) of wrongdoing, especially by standing as an equivalent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atonement</ns0:orth>
        <ns0:pron>/əˈtoʊnmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desagravio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Making amends to restore a damaged relationship; expiation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>expiación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(theology, often with capitalized initial) The reconciliation of God and mankind through the death of Jesus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atonic</ns0:orth>
        <ns0:pron>/eɪˈtɒnɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>átono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a sound or syllable) unstressed</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atony</ns0:orth>
        <ns0:pron>/ˈæt.ə.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atonía</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atop</ns0:orth>
        <ns0:pron>/əˈtɒp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encima de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On the top of.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>On the top (with of).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atopic</ns0:orth>
        <ns0:pron>/eɪˈtɒpɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atópico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Pertaining to or suffering from atopy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atopy</ns0:orth>
        <ns0:pron>/ˈætəpi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atopia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A hereditary disorder marked by the tendency to develop localized immediate hypersensitivity reactions to allergens such as pollen, food etc and is manifested by hay fever, asthma, or similar allergic conditions; generally considered to be caused by the interaction of environmental and genetic factors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atovaquone</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atovaquona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A naphthalene used to treat pneumocystis pneumonia, toxoplasmosis, and malaria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atresia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atresia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrial</ns0:orth>
        <ns0:pron>/ˈeɪtɹi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrial</ns0:quote>
          <ns0:quote>auricular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an atrium, especially the atrium of the heart.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrial fibrillation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fibrilación auricular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A cardiac arrhythmia (abnormal heart rhythm) that involves the two upper chambers (atria) of the heart.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrioventricular valve</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>válvula auriculoventricular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Either of the two valves in the heart, situated between the atria and the ventricles, that prevent backflow from the ventricles into the atria during systole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrium</ns0:orth>
        <ns0:pron>/ˈeɪ.tɹi.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A central room or space in ancient Roman homes, open to the sky in the middle; a similar space in other buildings.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architecture) A square hall lit by daylight from above, into which rooms open at one or more levels.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology) Any enclosed body cavity or chamber.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aurícula</ns0:quote>
          <ns0:quote>atrio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(palynology) A cavity inside a porate aperture of a pollen grain formed by the separation of the sexine and nexine layers, widening toward the interior of the grain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrocious</ns0:orth>
        <ns0:pron>/əˈtɹoʊʃəs/</ns0:pron>
        <ns0:pron>/əˈtɹəʊʃəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atroz</ns0:quote>
          <ns0:quote>malvado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Frightful, evil, cruel, or monstrous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ofensivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Offensive or heinous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atroz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Very bad; abominable, disgusting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrociously</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrozmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>in an atrocious manner</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrocity</ns0:orth>
        <ns0:pron>/əˈtɹɒsɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrocidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An extremely cruel act; a horrid act of injustice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrophic</ns0:orth>
        <ns0:pron>/eɪˈtɹoʊfɪk/</ns0:pron>
        <ns0:pron>/eɪˈtɹɒfɪk/</ns0:pron>
        <ns0:pron>/əˈtɹɑfɪk/</ns0:pron>
        <ns0:pron>/əˈtɹɒfɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrófico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Of, pertaining to, or arising from atrophy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrophy</ns0:orth>
        <ns0:pron>/ˈæt.ɹə.fi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrofia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A reduction in the functionality of an organ caused by disease, injury or lack of use. [from early 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atrophy</ns0:orth>
        <ns0:pron>/ˈæt.ɹə.fi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrofiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To wither or waste away. [from early 18th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To cause to waste away or become abortive; to starve or weaken.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>atropine</ns0:orth>
        <ns0:pron>/ˈa.tɹə.piːn/</ns0:pron>
        <ns0:pron>/ˈa.tɹəp.ɪn/</ns0:pron>
        <ns0:pron>/ˈæ.tɹəˌpin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atropina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(poison, pharmaceutical drug) An alkaloid extracted from the plant deadly nightshade (Atropa belladonna) and other sources, such as the seeds of the thorn-apple. Though overdoses would be fatal it is used as a drug in medicine for its paralytic effects (e.g. in surgery to relax muscles, in dentistry to dry the mouth, in ophthalmology to dilate the pupils).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attaboy</ns0:orth>
        <ns0:pron>/ˈætəˌbɔɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bien hecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, colloquial) Used to show encouragement or approval to a boy, man, or male animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attach</ns0:orth>
        <ns0:pron>/əˈtæt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adjuntar</ns0:quote>
          <ns0:quote>adosar</ns0:quote>
          <ns0:quote>anejar</ns0:quote>
          <ns0:quote>anexar</ns0:quote>
          <ns0:quote>atachar</ns0:quote>
          <ns0:quote>atachear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To fasten, to join to (literally and figuratively).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attached</ns0:orth>
        <ns0:pron>/əˈtæt͡ʃt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adjunto</ns0:quote>
          <ns0:quote>adosado</ns0:quote>
          <ns0:quote>conectado</ns0:quote>
          <ns0:quote>unido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Connected; joined.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apegado</ns0:quote>
          <ns0:quote>encariñado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fond of (used with to).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>emparejado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a romantic or sexual relationship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attachment</ns0:orth>
        <ns0:pron>/əˈtæt͡ʃmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archivo adjunto</ns0:quote>
          <ns0:quote>adjunto</ns0:quote>
          <ns0:quote>anejo</ns0:quote>
          <ns0:quote>apego</ns0:quote>
          <ns0:quote>adjunción</ns0:quote>
          <ns0:quote>afición</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prensión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of (physically or figuratively) attaching.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atadura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The means by which something is physically attached.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ejecución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Taking a person's property to satisfy a court-ordered debt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attaché</ns0:orth>
        <ns0:pron>/əˈtæʃeɪ/</ns0:pron>
        <ns0:pron>/ˌætæˈʃeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agregado</ns0:quote>
          <ns0:quote>agregada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A diplomatic officer, usually one who plays a specific role.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attack</ns0:orth>
        <ns0:pron>/əˈtæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ataque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An attempt to cause damage, injury to, or death of an opponent or enemy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A time in which one attacks; the offence of a battle.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) The sudden onset of a disease or condition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attack</ns0:orth>
        <ns0:pron>/əˈtæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atacar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To apply violent force to someone or something.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To begin to affect; to act upon injuriously or destructively; to begin to decompose or waste.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(soccer) To move forward in an active attempt to score a point, as opposed to trying not to concede.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attack is the best form of defence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>la mejor defensa es un buen ataque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a battle or dispute, attacking the opposition first is better than waiting for them to attack.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attacker</ns0:orth>
        <ns0:pron>/əˈtækɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresor</ns0:quote>
          <ns0:quote>atacante</ns0:quote>
          <ns0:quote>asaltante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who attacks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>delantero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(soccer) One of the players on a team in football (soccer) in the row nearest to the opposing team's goal, who are therefore principally responsible for scoring goals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attacking midfielder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mediapunta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(soccer) A midfield player who specialises more in attacking duties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attain</ns0:orth>
        <ns0:pron>/əˈteɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conseguir</ns0:quote>
          <ns0:quote>alcanzar</ns0:quote>
          <ns0:quote>lograr</ns0:quote>
          <ns0:quote>granjear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To reach or come to, by progression or motion; to arrive at (a place, time, state, etc.).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attainable</ns0:orth>
        <ns0:pron>/əˈteɪnəbəl/</ns0:pron>
        <ns0:pron>/əˈtæɪnəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asequible</ns0:quote>
          <ns0:quote>alcanzable</ns0:quote>
          <ns0:quote>realizable</ns0:quote>
          <ns0:quote>conseguible</ns0:quote>
          <ns0:quote>lograble</ns0:quote>
          <ns0:quote>obtenible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be accomplished, achieved, or obtained.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attainder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>muerte civil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal, rare) The state a prisoner entered once a death sentence (usually for treason) had been issued; the state of being stripped of all civil rights.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attainment</ns0:orth>
        <ns0:pron>/əˈteɪnmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consecución</ns0:quote>
          <ns0:quote>logro</ns0:quote>
          <ns0:quote>realización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of attaining; the act of arriving at or reaching; the act of obtaining by exertion or effort.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attempt</ns0:orth>
        <ns0:pron>/əˈtɛmpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>intento</ns0:quote>
          <ns0:quote>tentativa</ns0:quote>
          <ns0:quote>ensayo</ns0:quote>
          <ns0:quote>intentona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The action of trying at something. [1530]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atentado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An assault or attack, especially an assassination attempt. [1580]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(criminal law) A substantial but unsuccessful effort (to commit a crime).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attempt</ns0:orth>
        <ns0:pron>/əˈtɛmpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>intentar</ns0:quote>
          <ns0:quote>tratar</ns0:quote>
          <ns0:quote>acometer</ns0:quote>
          <ns0:quote>ver de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) To attack; to make an effort or attack upon; to try to take by force.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attend</ns0:orth>
        <ns0:pron>/əˈtɛnd/</ns0:pron>
        <ns0:pron>[əˈtʰɛnd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistir</ns0:quote>
          <ns0:quote>presenciar</ns0:quote>
          <ns0:quote>acudir</ns0:quote>
          <ns0:quote>concurrir</ns0:quote>
          <ns0:quote>cursar</ns0:quote>
          <ns0:quote>ir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be present at (an event or place) in order to take part in some action or proceedings; also, to regularly go to (an event or place). [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atender</ns0:quote>
          <ns0:quote>ocupar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To give consideration to (someone or something); to heed, to pay attention, to regard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attendance</ns0:orth>
        <ns0:pron>/əˈtɛn.dəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acudimiento</ns0:quote>
          <ns0:quote>asistencia</ns0:quote>
          <ns0:quote>presencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of attending; the state of being present; presence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attendant</ns0:orth>
        <ns0:pron>/əˈtɛndənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concomitante</ns0:quote>
          <ns0:quote>inherente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Going with; associated; concomitant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attendant</ns0:orth>
        <ns0:pron>/əˈtɛndənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistente</ns0:quote>
          <ns0:quote>atendiente</ns0:quote>
          <ns0:quote>guarda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who attends; one who works with or watches over someone or something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attendee</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is in attendance or in the audience of an event.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attending</ns0:orth>
        <ns0:pron>/əˈtɛndɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asistente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That attend or attends; that is or are in attendance; attendant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attention</ns0:orth>
        <ns0:pron>/əˈtɛn.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) Used as a command to bring soldiers to the attention position.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A call for people to be quiet/stop doing what they are presently doing and pay heed to what they are to be told or shown.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attention</ns0:orth>
        <ns0:pron>/əˈtɛn.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Mental focus.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) An action or remark expressing concern for or interest in someone or something, especially romantic interest.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, military) A state of alertness in the standing position.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attention deficit hyperactivity disorder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno por déficit de atención con hiperactividad</ns0:quote>
          <ns0:quote>TDAH</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neurology, pathology, psychiatry, psychology) A developmental disorder in which a person has difficulty to concentrate and a persistent pattern of impulsiveness and inattention, with or without a component of hyperactivity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attentive</ns0:orth>
        <ns0:pron>/əˈtɛntɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atento</ns0:quote>
          <ns0:quote>solícito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Paying attention; noticing, watching, listening, or attending closely.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attentively</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atentamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an attentive manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attentiveness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consideración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being attentive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attenuate</ns0:orth>
        <ns0:pron>/əˈten.jʉˌæɪt/</ns0:pron>
        <ns0:pron>/əˈtɛn.juˌeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atenuar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To reduce in size, force, value, amount, or degree.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To become thin or fine; to grow less.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extenuar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To weaken.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attenuation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atenuación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gradual diminishing of strength.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) A reduction in the level of some property with distance, especially the amplitude of a wave or the strength of a signal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attenuator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atenuador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) Any device that attenuates a signal, but especially an electronic device that reduces the amplitude of a signal</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attest</ns0:orth>
        <ns0:pron>/əˈtɛst/</ns0:pron>
        <ns0:pron>/əˈʈɛsʈ/&lt;a:Indic&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atestiguar</ns0:quote>
          <ns0:quote>avalar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To affirm to be correct, true, or genuine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atestiguar</ns0:quote>
          <ns0:quote>compulsar</ns0:quote>
          <ns0:quote>establecer</ns0:quote>
          <ns0:quote>verificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To certify by signature or oath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attestation</ns0:orth>
        <ns0:pron>/əʈəsˈʈeʃən/</ns0:pron>
        <ns0:pron>/ˌætɛˈsteɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atestación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A thing that serves to bear witness, confirm, or authenticate; validation, verification, documentation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attested</ns0:orth>
        <ns0:pron>/əˈtɛstɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atestiguado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Proven; shown to be true with evidence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attestor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fedatario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who attests.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
