      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>griego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language spoken by people of Greece, particularly, depending on context, Ancient Greek or Modern Greek.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
