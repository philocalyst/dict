      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nazi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Of or pertaining to the Nazi Party specifically, or to Nazism, neo-Nazism, or neo-Nazis more generally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nazi</ns0:orth>
        <ns0:pron>/ˈnætsi/</ns0:pron>
        <ns0:pron>/ˈnæzi/&lt;a:historical&gt;</ns0:pron>
        <ns0:pron>/ˈnɑːtsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nazi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A member of the Nazi Party (the National Socialist German Workers' Party or NSDAP). [1930]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nazi Germany</ns0:orth>
