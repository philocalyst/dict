          <ns0:quote>confirmar</ns0:quote>
          <ns0:quote>corroborar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To corroborate, prove, or confirm; to demonstrate; to provide evidence for.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
