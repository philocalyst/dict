        <ns0:pron>/pænˈd͡ʒiː.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pangea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) A former supercontinent that included all the landmasses of the earth before the Triassic period and that broke up into Laurasia and Gondwana.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pangasinan</ns0:orth>
