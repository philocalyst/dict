        <ns0:orth>Christmas cookie</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>galleta de Navidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sugar cookie, usually cut in festive shapes, that is made and eaten at Christmas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Christmas light</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luz de Navidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mostly, in the plural) One of the electric lights, often arranged in strings, used at Christmas to decorate a Christmas tree, outdoor trees or bushes, a house, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
