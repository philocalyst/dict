          <ns0:quote>melón oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fruit of the plant, which has a soft rind and juicy flesh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
