        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mudéjar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the style of Iberian architecture and decoration of the 12th to 16th centuries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mudéjar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mudéjar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Any of the Moors of Al-Andalus who remained in Christian territory after the Reconquista but were not converted to Christianity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, architecture) A style of Iberian architecture and decoration of the 12th to 16th centuries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
