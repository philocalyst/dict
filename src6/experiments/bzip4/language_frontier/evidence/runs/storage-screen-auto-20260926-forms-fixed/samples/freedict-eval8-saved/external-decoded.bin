        <ns0:pron>/ˌvʌl.kən səˈlut/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>saludo vulcano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gesture of greeting among Star Trek fans, consisting of a raised hand with the palm forward and the thumb extended, and the fingers parted between the middle finger and ring finger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
