        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>toalla de playa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A towel for use at the beach, typically larger than a normal household towel so that a person can use it to lie on the sand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
