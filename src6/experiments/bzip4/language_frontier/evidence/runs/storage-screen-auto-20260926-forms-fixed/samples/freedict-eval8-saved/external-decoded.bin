        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audiomotor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Related to both the perception of sound and the production of movement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
