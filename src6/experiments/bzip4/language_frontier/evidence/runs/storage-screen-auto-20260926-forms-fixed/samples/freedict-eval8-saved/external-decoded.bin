      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Chuvasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A republic and federal subject of Russia, located in Eastern Europe. Capital: Cheboksary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
