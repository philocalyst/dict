        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>monte Erebus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A volcano in Ross Island, Ross Dependency, Antarctica; known for being the southernmost active volcano.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mount Everest</ns0:orth>
        <ns0:pron>/ˌmaʊnt ˈɛv(ə)ɹəst/</ns0:pron>
