      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acetábulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The bony cup of the hip bone which receives the head of the femur.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A vinegar saucer, especially (historical) in ancient Roman contexts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
