        <ns0:pron>/vəˈnɛtoʊ/</ns0:pron>
        <ns0:pron>/ˈvɛnətoʊ/</ns0:pron>
        <ns0:pron>/ˈvɛnɛtoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Véneto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An administrative region of northern Italy, roughly corresponding to the ancient Venetia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venezuela</ns0:orth>
        <ns0:pron>/ˌvɛn.əˈzweɪ.lə/</ns0:pron>
