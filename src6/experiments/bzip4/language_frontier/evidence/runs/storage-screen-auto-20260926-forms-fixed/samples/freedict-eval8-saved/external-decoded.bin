      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eslavismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A linguistic feature of one or more Slavic languages, especially a Slavic idiom or phrasing that appears in a non-Slavic language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
