          <ns0:quote>método socrático</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sod's law</ns0:orth>
        <ns0:pron>/sɒdz lɔ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley de la indefectible mala voluntad de los objectos inanimados</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, UK) The principle that what can go wrong, will go wrong, usually with some observed degree of irony</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
