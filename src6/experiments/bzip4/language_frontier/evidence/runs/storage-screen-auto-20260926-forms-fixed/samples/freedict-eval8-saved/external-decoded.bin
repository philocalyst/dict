          <ns0:quote>International Klein Blue</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(arts) An intense deep blue hue achieved by means of ultramarine pigment and a binder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
