        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baksheesh</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the Middle East or southwest Asia: a bribe or tip.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balaclava</ns0:orth>
        <ns0:pron>/ˌbæl.əˈklɑː.və/</ns0:pron>
        <ns0:pron>/ˌbɑː.ləˈklɑː.və/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
