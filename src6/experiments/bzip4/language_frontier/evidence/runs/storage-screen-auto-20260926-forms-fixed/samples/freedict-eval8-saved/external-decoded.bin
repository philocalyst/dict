      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pidgin chino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, derogatory) Of or resembling English that is influenced by the Chinese language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
