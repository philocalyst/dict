      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>laosiano</ns0:quote>
          <ns0:quote>de Laos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Laos, the Lao people or their Kra-Dai Lao language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lao</ns0:orth>
        <ns0:pron>/laʊ/</ns0:pron>
        <ns0:pron>/ˈlɑːoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>laosiano</ns0:quote>
          <ns0:quote>laosiana</ns0:quote>
          <ns0:quote>lao</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A Tai ethnic group native to Southeast Asia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The official language of Laos that is closely related to Thai.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Laocoön</ns0:orth>
        <ns0:pron>/leɪˈɒkoʊˌɒn/</ns0:pron>
        <ns0:pron>/leɪˈɒkəˌwɒn/</ns0:pron>
        <ns0:pron>/leɪˈɒkɵ.ɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Laocoonte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A Trojan priest of Poseidon (or Apollo, depending on the author), whose rules he had defied (or whom he had otherwise offended), who tried to warn his fellow citizens against the Trojan horse. He was killed for this, along with his two sons, by giant snakes sent by Minerva (or Poseidon, or Apollo).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
