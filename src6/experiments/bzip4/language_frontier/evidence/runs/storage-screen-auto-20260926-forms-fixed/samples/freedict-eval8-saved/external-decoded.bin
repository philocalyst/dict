        <ns0:orth>Cartagenan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cartagenero</ns0:quote>
          <ns0:quote>cartaginés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or inhabitant of the city of Cartagena, Bolívar department, Colombia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Cartesian</ns0:orth>
        <ns0:pron>/kɑɹˈti.ʒən/</ns0:pron>
        <ns0:pron>/kɑːɹ ˈtiːziən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cartesiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or pertaining to, Descartes, his mathematical methods, or his philosophy, especially with regard to its emphasis on logical analysis and its mechanistic interpretation of physical nature.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics, cartography) Of, or pertaining to, co-ordinates based on mutually orthogonal axes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Cartesian coordinate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coordenada cartesiana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The coordinates of a point measured from an origin along a horizontal axis from left to right (the x-axis) and along a vertical axis from bottom to top (the y-axis). This can be extended to three-dimensions by the z-axis perpendicular to the x- and y-axes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Cartesian coordinates</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coordenadas rectangulares</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebraic geometry) The coordinates of a point measured as its perpendicular distance to the right of a vertical axis (the y-axis) and its perpendicular distance above a horizontal axis (the x-axis).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Cartesian plane</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plano cartesiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) A coordinate plane, with an applied Cartesian coordinate system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Cartesian product</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>producto cartesiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set theory, of two sets X and Y) The set of all possible ordered pairs of elements, the being first from X, the second from Y, written X \times Y. Formally, the set \{(x,y)\; |\; x\in X \; \text{and} \; y\in Y\}.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Carthage</ns0:orth>
        <ns0:pron>/ˈkɑɹθɪd͡ʒ/</ns0:pron>
        <ns0:pron>/ˈkɑːθɪdʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cartago</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) An ancient city in North Africa, in modern Tunisia. [16th cent.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
