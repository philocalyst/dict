        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>planes</ns0:quote>
          <ns0:quote>preparativos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, in the plural) Preparations for some undertaking.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuerdo</ns0:quote>
          <ns0:quote>arreglo</ns0:quote>
          <ns0:quote>arreglín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
