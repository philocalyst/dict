        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thelema</ns0:orth>
        <ns0:pron>/θəˈliːmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>telema</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A spiritual and social philosophy developed in the early 1900s, calling each person to act in alignment with his or her True Will (which may or may not be the same as personal wishes) as a basis for spiritual growth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theobald</ns0:orth>
        <ns0:pron>/ˈtɪbəɫd/</ns0:pron>
        <ns0:pron>/ˈθiːoʊbɔɫd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teobaldo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theoderic</ns0:orth>
        <ns0:pron>/θiˈɑd.əɹ.ɪk/</ns0:pron>
        <ns0:pron>/θiːˈɒd.əɹ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teodorico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, equivalent to English grc-koi:Θευδέριχος,Derek.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theodora</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teodora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, most famously borne by two empresses of Byzantium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theodore</ns0:orth>
        <ns0:pron>/ˈθi.əˌdɔɹ/</ns0:pron>
        <ns0:pron>/ˈθiː.əˌdɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teodoro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name; the name of a saint, pope, several emperors, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theophilus</ns0:orth>
        <ns0:pron>/θiːˈɒfɪləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teófilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The addressee of the Gospel of Luke and the Acts of the Apostles.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name; rare in English.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theotokos</ns0:orth>
        <ns0:pron>/ˌθeɪoʊˈtoʊkoʊs/</ns0:pron>
        <ns0:pron>/θiːˈɒtəˌkɒs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Deípara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity, chiefly, _, Orthodoxy) Synonym of Mary, mother of Jesus, in particular reference to her role giving birth to God.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thermidor</ns0:orth>
        <ns0:pron>/ˈθɜːmɪdɔː/</ns0:pron>
        <ns0:pron>/ˈθɝmədɔɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>termidor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The eleventh month of the French Republican Calendar, from July 19 or 20 to August 17 or 18.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thermopylae</ns0:orth>
        <ns0:pron>/θəˈmɒpɪli/</ns0:pron>
        <ns0:pron>/θɚˈmɑpɪli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Termópilas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A narrow pass on the east-central coast of Greece adjacent to the Maliakos Gulf, northwest of Athens. Its name is derived from its hot sulphur springs. It was the site of the Battle of Thermopylae, at which the Spartan King Leonidas stood off, for a time, the Persian armies of Xerxes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theron</ns0:orth>
        <ns0:pron>/ˈθɛəɹən/</ns0:pron>
        <ns0:pron>/ˈθɛɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Terón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Theron of Akragas (died 473 BC), a tyrant of Akragas in Sicily.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theseus</ns0:orth>
        <ns0:pron>/ˈθiːsi.əs/</ns0:pron>
        <ns0:pron>/ˈθiːsjuːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teseo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A legendary Ancient Greek hero most famous for defeating the minotaur in the labyrinth of Crete.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thesprotian</ns0:orth>
        <ns0:pron>/θɛsˈpɹəʊ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tesproto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An inhabitant or a resident of Thesprotia in western Epirus, Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thessalonians</ns0:orth>
        <ns0:pron>/θɛsəˈloʊni.ənz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tesalonicenses</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) Books in the New Testament of the Bible (1 Thessalonians and 2 Thessalonians), epistles to the Christians in ancient Thessaloniki.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thessaloniki</ns0:orth>
        <ns0:pron>/ˌθɛsələˈniːki/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Salónica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
