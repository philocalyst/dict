        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jack Russell terrier</ns0:quote>
          <ns0:quote>terrier Jack Russell</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of small dog, usually brown and white in color, often used by farmers for rodent control.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jack the Ripper</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jack el Destripador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A supposed individual who was an unidentified 19th century serial killer in England, who has become part of folklore.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacky</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacky</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A nickname used instead of the male given name Jack, Jacques (and its cognates) or John.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacmel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacmel</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacob</ns0:orth>
        <ns0:pron>/ˈd͡ʒeɪkəb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacob</ns0:quote>
          <ns0:quote>Santiago</ns0:quote>
          <ns0:quote>Jacobo</ns0:quote>
          <ns0:quote>Diego</ns0:quote>
          <ns0:quote>Yago</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Mormonism) The fifth son of Lehi and one of the younger brothers of Nephi, author of one of the books in the Book of Mormon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santiago</ns0:quote>
          <ns0:quote>Jacobo</ns0:quote>
          <ns0:quote>Diego</ns0:quote>
          <ns0:quote>Yago</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) One of the sons of Isaac and Rebecca, and twin brother of Esau; father of the Israelites (Jews and Samaritans) by 12 sons by 4 consorts, most famously Judah and Joseph who fathered Manasseh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacobean</ns0:orth>
        <ns0:pron>/ˈdʒæk.əˌbi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jacobeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Relating to or characteristic of the reign of James VI and I (of Scotland and England, 1567–1625).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacobian</ns0:orth>
        <ns0:pron>/d͡ʒəˈkoʊ.bi.ən/</ns0:pron>
        <ns0:pron>/jɑːˈkəʊ.bi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jacobiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to specify certain mathematical objects named in honour of C. G. J. Jacobi.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacobian</ns0:orth>
        <ns0:pron>/d͡ʒəˈkoʊ.bi.ən/</ns0:pron>
        <ns0:pron>/jɑːˈkəʊ.bi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matriz jacobiana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(calculus) A Jacobian matrix or its associated operator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>determinante jacobiano</ns0:quote>
          <ns0:quote>jacobiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(calculus) The determinant of such a matrix.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacobite</ns0:orth>
        <ns0:pron>/ˈd͡ʒækəbaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jacobita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A supporter of the restoration of the Stuart kings to the thrones of England and Scotland in the late 17th century. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Christianity, dated) A member of the Syriac Orthodox Church, or historically any miaphysite or monophysite. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jacqueline</ns0:orth>
        <ns0:pron>/ˈdʒækəlɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jacqueline</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Jade Emperor</ns0:orth>
        <ns0:pron>/ˈd͡ʒeɪd ˈɛmpəɹə/</ns0:pron>
        <ns0:pron>/ˈd͡ʒeɪd ˈɛmpəɹɚ/</ns0:pron>
        <ns0:pron>/ˈd͡ʒeɪd ˈɛmpɹə/</ns0:pron>
        <ns0:pron>/ˈd͡ʒeɪd ˈɛmpɹɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Emperador de Jade</ns0:quote>
