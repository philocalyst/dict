        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>socrático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or characteristic of the philosopher Socrates or his philosophical methods and/or views.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
