        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>augmented</ns0:orth>
        <ns0:pron>/ɑɡˈmɛntəd/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ɔɡˈmɛntəd/</ns0:pron>
        <ns0:pron>/ɔːɡˈmɛntɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aumentado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Increased in number, amount or strength.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) Increased by a semitone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>augmented matrix</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matriz aumentada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linear algebra) Matrix obtained by appending the columns of two given matrices, usually for the purpose of performing the same elementary row operations on each of the given matrices.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>augmented reality</ns0:orth>
        <ns0:pron>/ɑɡˌmɛntəd ɹiˈæləti/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ɔɡˌmɛntəd ɹiˈæləti/</ns0:pron>
        <ns0:pron>/ɔːɡˌmɛntɪd ɹiːˈælɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>realidad aumentada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) The merging of a view of the real-world environment upon a digital image in real time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>augur</ns0:orth>
        <ns0:pron>/ˈɑ.ɡɚ/</ns0:pron>
        <ns0:pron>/ˈɔ.ɡɚ/</ns0:pron>
        <ns0:pron>/ˈɔː.ɡə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>augur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A diviner who foretells events by the behaviour of birds or other animals, or by signs derived from celestial phenomena, or unusual occurrences.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>augur</ns0:orth>
        <ns0:pron>/ˈɑ.ɡɚ/</ns0:pron>
        <ns0:pron>/ˈɔ.ɡɚ/</ns0:pron>
        <ns0:pron>/ˈɔː.ɡə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>augurar</ns0:quote>
          <ns0:quote>presagiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To foretell events; to exhibit signs of future events; to indicate a favorable or an unfavorable outcome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>augury</ns0:orth>
        <ns0:pron>/ˈɔː.ɡjʊ.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>augurio</ns0:quote>
          <ns0:quote>agüero</ns0:quote>
          <ns0:quote>presagio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A divination based on the appearance and behaviour of animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>august</ns0:orth>
        <ns0:pron>/ɑˈɡʌst/</ns0:pron>
        <ns0:pron>/ɔˈɡʌst/</ns0:pron>
        <ns0:pron>/ɔːˈɡʌst/</ns0:pron>
        <ns0:pron>/ə-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>augusto</ns0:quote>
          <ns0:quote>majestuoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Awe-inspiring, majestic, noble, venerable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hidalgo</ns0:quote>
          <ns0:quote>noble</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of noble birth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auk</ns0:orth>
        <ns0:pron>/ɑk/</ns0:pron>
        <ns0:pron>/ɔk/</ns0:pron>
        <ns0:pron>/ɔːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several species of Arctic sea birds of the family Alcidae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aulos</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aulós</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aunt</ns0:orth>
        <ns0:pron>/ant/</ns0:pron>
        <ns0:pron>/eɪnt/</ns0:pron>
        <ns0:pron>/ænt/</ns0:pron>
        <ns0:pron>/ɑːnt/</ns0:pron>
        <ns0:pron>/ɔnt/</ns0:pron>
        <ns0:pron>/ʌnt/</ns0:pron>
        <ns0:pron>[ant]</ns0:pron>
        <ns0:pron>[aːnt]</ns0:pron>
        <ns0:pron>[eənt]</ns0:pron>
        <ns0:pron>[änt]</ns0:pron>
        <ns0:pron>[äːnt]</ns0:pron>
        <ns0:pron>[ænt]</ns0:pron>
        <ns0:pron>[ɐːnt]</ns0:pron>
        <ns0:pron>[ɑnt]</ns0:pron>
        <ns0:pron>[ɑːnt]</ns0:pron>
        <ns0:pron>[ɒːnt]</ns0:pron>
        <ns0:pron>[ɛənt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sister or sister-in-law of one’s parent.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(affectionate) A woman of an older generation than oneself, especially a friend of one's parents, by means of fictive kin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aura</ns0:orth>
        <ns0:pron>/ˈoɹ.ə/</ns0:pron>
        <ns0:pron>/ˈoː.ɹə/</ns0:pron>
        <ns0:pron>/ˈɔː.ɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative, with about, of) A distinctive atmosphere or quality surrounding or associated with something or someone. [from 1859]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(also, parapsychology) A supposed emanation from and surrounding a living person or thing, regarded by mystics as consisting of the essence of the individual. [from 1870]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aural</ns0:orth>
        <ns0:pron>/aʊɹəl/</ns0:pron>
        <ns0:pron>/ˈoɹəl/</ns0:pron>
        <ns0:pron>/ˈɑ(ː)ɹəl/</ns0:pron>
        <ns0:pron>/ˈɔɹəl/</ns0:pron>
        <ns0:pron>/ˈɔːɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auditivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the ear.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or pertaining to sound or hearing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aurally</ns0:orth>
        <ns0:pron>/ˈoɹ.ə.li/</ns0:pron>
        <ns0:pron>/ˈɑɹ.ə.li/</ns0:pron>
        <ns0:pron>/ˈɔːɹ.əl.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auditivamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to sound or the ear; via or through the sense of hearing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aureola</ns0:orth>
        <ns0:pron>/ɑˈɹiː.ə.lə/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ɔˈɹiː.ə.lə/</ns0:pron>
        <ns0:pron>/ɔːˈɹiː.ə.lə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aureola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Radiance of luminous cloud that surrounds the figure in a painting of a sacred personage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>áurico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic chemistry) Of or pertaining to trivalent gold.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auricle</ns0:orth>
        <ns0:pron>/ˈɔɹ.ək.əl/</ns0:pron>
        <ns0:pron>/ˈɔː.ɹɪk.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aurícula</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any appendage in the shape of an ear or earlobe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auricular</ns0:orth>
        <ns0:pron>/ɔˈɹɪk.jəl.ɚ/</ns0:pron>
        <ns0:pron>/ɔːˈɹɪk.jʊl.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auricular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, relational) Of or pertaining to the sense of hearing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(art, relational) Pertaining to a style of ornamental decoration, originating in Northern Europe in the first half of the 17th century, that uses softly flowing abstract shapes in relief some of which bear a resemblance to the human ear; commonly used in silverware, picture frames, and architecture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auricular fibrillation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fibrilación auricular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Synonym of atrial fibrillation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auriculo-</ns0:orth>
        <ns0:pron>/ɔˈɹɪk.jəl.oʊ/</ns0:pron>
        <ns0:pron>/ɔːˈɹɪk.jʊl.əʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auriculo-</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auriculoventricular</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auricoventricular</ns0:quote>
          <ns0:quote>auriculoventricular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Relating to the auricles and the ventricles (of the heart).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auriferous</ns0:orth>
        <ns0:pron>/oɹˈɪfəɹəs/</ns0:pron>
        <ns0:pron>/ɑɹˈɪfəɹəs/</ns0:pron>
        <ns0:pron>/ɔːˈɹɪfəɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aurífero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Containing or producing gold; gold-bearing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aurochs</ns0:orth>
        <ns0:pron>/ˈaʊɹɒks/</ns0:pron>
        <ns0:pron>/ˈɔːɹɒks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>uro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct European mammal, Bos primigenius, the ancestor of domestic cattle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aurora</ns0:orth>
        <ns0:pron>/ɔˈɹɔɹ.ə/</ns0:pron>
        <ns0:pron>/ɔːˈɹɔː.ɹə/</ns0:pron>
        <ns0:pron>/əˈɹɔɹ.ə/</ns0:pron>
        <ns0:pron>/əˈɹɔː.ɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aurora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An atmospheric phenomenon created by charged particles from the sun striking the upper atmosphere, creating coloured lights in the sky. It is usually named australis or borealis based on whether it is in the Southern or Northern Hemisphere respectively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auscultate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auscultar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To listen (for example to the heart or lungs) by auscultation; to examine by auscultation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auscultation</ns0:orth>
        <ns0:pron>/ˌɔskəlˈteɪʃən/</ns0:pron>
        <ns0:pron>/ˌɔːskəlˈteɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auscultación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Diagnosis of disorders by listening to the sounds of the internal organs, usually using a stethoscope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auspices</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auspicios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Protection or patronage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auspicious</ns0:orth>
        <ns0:pron>/ɑˈspɪʃ.əs/</ns0:pron>
        <ns0:pron>/ɔˈspɪʃ.əs/</ns0:pron>
        <ns0:pron>/ɔːˈspɪ.ʃəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prometedor</ns0:quote>
          <ns0:quote>propicio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of good omen; indicating future success.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austenite</ns0:orth>
        <ns0:pron>/ˈɑstɪnaɪt/</ns0:pron>
        <ns0:pron>/ˈɒstɪnaɪt/</ns0:pron>
        <ns0:pron>/ˈɔstɪnaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>austenita</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austere</ns0:orth>
        <ns0:pron>/ɑˈstiɹ/</ns0:pron>
        <ns0:pron>/ɒˈstɪə(ɹ)/</ns0:pron>
        <ns0:pron>/ɔˈstiɹ/</ns0:pron>
        <ns0:pron>/ɔːˈstɪə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>severo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Grim or severe in manner or appearance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>austero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Lacking decoration; trivial; not extravagant or gaudy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austerely</ns0:orth>
        <ns0:pron>/ɔˈstiɹli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>austeramente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an austere manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austerity</ns0:orth>
        <ns0:pron>/ɔˈstɛɹɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>austeridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Severity of manners or life; extreme rigor or strictness; harsh discipline.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(economics) A policy of deficit-cutting, which by definition requires lower spending, higher taxes, or both.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austral</ns0:orth>
        <ns0:pron>/ˈɒstɹəl/</ns0:pron>
        <ns0:pron>/ˈɔːstɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>austral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or coming from the south.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austral</ns0:orth>
        <ns0:pron>/ˈɒstɹəl/</ns0:pron>
        <ns0:pron>/ˈɔːstɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>austral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A former currency of Argentina. Its symbol was ₳.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austral blackbird</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quireo</ns0:quote>
          <ns0:quote>tordo patagón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A species of bird, Curaeus curaeus, found in southern South America.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>austral parakeet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cachaña</ns0:quote>
          <ns0:quote>catita</ns0:quote>
          <ns0:quote>cotorra austral</ns0:quote>
          <ns0:quote>cotorra cachaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A species of South American parrot, Enicognathus ferrugineus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>australopith</ns0:orth>
        <ns0:pron>/ˈɒstɹələˌpɪθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>australopiteco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anthropology, paleontology) Any of the hominids of the extinct genus Australopithecus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autarchy</ns0:orth>
        <ns0:pron>/-tɑː-/</ns0:pron>
        <ns0:pron>/ˈɔˌtɑɹki/</ns0:pron>
        <ns0:pron>/ˈɔːtəki/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autarcía</ns0:quote>
          <ns0:quote>autarquía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A condition of absolute power.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autarky</ns0:orth>
        <ns0:pron>/-tɑː-/</ns0:pron>
        <ns0:pron>/ˈɔˌtɑɹki/</ns0:pron>
        <ns0:pron>/ˈɔːtəki/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autarquía</ns0:quote>
          <ns0:quote>autarcía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) (A policy of) national economic self-sufficiency, aimed at ending reliance on foreign imports to sustain a domestic economy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auteur</ns0:orth>
        <ns0:pron>/oʊˈtɝ/</ns0:pron>
        <ns0:pron>/ɔːˈtɜː/</ns0:pron>
        <ns0:pron>/əʊˈtɜː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A creative artist, especially a film director, seen as having a specific, recognisable artistic vision, and who is seen as the single or preeminent ‘author’ of their works.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authentic</ns0:orth>
        <ns0:pron>/ɑˈθɛn.tɪk/</ns0:pron>
        <ns0:pron>/ɒˈθɛn.tɪk/</ns0:pron>
        <ns0:pron>/ɔˈθɛn.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auténtico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of the same origin as claimed; genuine.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Conforming to reality and therefore worthy of trust, reliance, or belief.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authentic cadence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cadencia auténtica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music, chiefly, US) A cadence involving the resolution of the dominant chord (V) to the root chord (I).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authentically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auténticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an authentic manner; genuinely</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authenticate</ns0:orth>
        <ns0:pron>/ɑˈθɛn.tɪ.keɪt/</ns0:pron>
        <ns0:pron>/ɒˈθɛn.tɪ.keɪt/</ns0:pron>
        <ns0:pron>/ɔˈθɛn.tɪ.keɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autenticar</ns0:quote>
          <ns0:quote>autentificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To render authentic; to give authority to, by the proof, attestation, or formalities required by law, or sufficient to entitle to credit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authentication</ns0:orth>
        <ns0:pron>/ɔːˌθɛntɪˈkeɪʃn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autenticación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something which validates or confirms the authenticity of something; or the process of doing so.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authenticity</ns0:orth>
        <ns0:pron>/ɑθənˈtɪsɪti/</ns0:pron>
        <ns0:pron>/ɑθɛnˈtɪsɪti/</ns0:pron>
        <ns0:pron>[ɑθənˈtɪsɪɾi]</ns0:pron>
        <ns0:pron>[ɑθɛnˈtɪsɪɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autenticidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being genuine or not corrupted from the original, of having the same origin (or attribution, commitment, intention, etc.) as claimed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>author</ns0:orth>
        <ns0:pron>/ˈɑ.θɚ/</ns0:pron>
        <ns0:pron>/ˈɒː.təɹ/</ns0:pron>
        <ns0:pron>/ˈɔ.θɚ/</ns0:pron>
        <ns0:pron>/ˈɔː.θə(ɹ)/</ns0:pron>
        <ns0:pron>[ˈoː.θə(ɹ)]</ns0:pron>
        <ns0:pron>[ˈɔ(ː)θ(ə)ɹ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autor</ns0:quote>
          <ns0:quote>autora</ns0:quote>
          <ns0:quote>escritor</ns0:quote>
          <ns0:quote>escritora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The originator or creator of a work, especially of a literary composition; or, one of the creators of a collaborative work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>author</ns0:orth>
        <ns0:pron>/ˈɑ.θɚ/</ns0:pron>
        <ns0:pron>/ˈɒː.təɹ/</ns0:pron>
        <ns0:pron>/ˈɔ.θɚ/</ns0:pron>
        <ns0:pron>/ˈɔː.θə(ɹ)/</ns0:pron>
        <ns0:pron>[ˈoː.θə(ɹ)]</ns0:pron>
        <ns0:pron>[ˈɔ(ː)θ(ə)ɹ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escribir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US, sometimes, proscribed) To create a work as its author.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authoress</ns0:orth>
        <ns0:pron>/ˈɔ.θɚ.ɹɛs/</ns0:pron>
        <ns0:pron>/ˈɔː.θə.ɹɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) A female author.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authorial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoral</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authorial intent</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>intención autoral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The intent of an author as encoded in their work.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authoritarian</ns0:orth>
        <ns0:pron>/ɔˌθɔɹ.əˈtɛɹ.i.ən/</ns0:pron>
        <ns0:pron>/ɔːˌθɒɹ.ɪˈtɛə̯.ɹɪən/</ns0:pron>
        <ns0:pron>/əˌθɔɹ.əˈtɛɹ.i.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoritario</ns0:quote>
          <ns0:quote>mandón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to, or exhibiting strict obedience to an authority; favoring authoritarianism over civic and individual liberties.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Demanding obedience to authority; marked by authoritarianism; dictatorial, tyrannical.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authoritarianism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoritarismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of government in which the governing body has absolute, or almost absolute, control. Typically this control is maintained by force, and little heed is paid to public opinion or the judicial system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authoritative</ns0:orth>
        <ns0:pron>/ɔ-/</ns0:pron>
        <ns0:pron>/ɔːˈθɒɹɪtətɪv/</ns0:pron>
        <ns0:pron>/ɔːˈθɒɹɪtɪv/</ns0:pron>
        <ns0:pron>/əˈθɑɹɪtɪv/</ns0:pron>
        <ns0:pron>/əˈθɑɹɪˌteɪtɪv/</ns0:pron>
        <ns0:pron>/əˈθɔɹɪtɪv/</ns0:pron>
        <ns0:pron>/əˈθɔɹɪˌteɪtɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoritativo</ns0:quote>
          <ns0:quote>oficial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Arising or originating from a figure of authority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autorizado</ns0:quote>
          <ns0:quote>fidedigno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Highly accurate or definitive; treated or worthy of treatment as a scholarly authority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoritario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a commanding style.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authoritatively</ns0:orth>
        <ns0:pron>/ɔˈθɔɹəˌteɪtɪvli/</ns0:pron>
        <ns0:pron>/ɔːˈθɒɹɪtətɪvli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoritativamente</ns0:quote>
          <ns0:quote>con autoridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an authoritative manner; with authority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authority</ns0:orth>
        <ns0:pron>/ɒːˈtɒɹɪti/</ns0:pron>
        <ns0:pron>/ɔːˈθɒɹəti/</ns0:pron>
        <ns0:pron>/ɔːˈθɒɹɪti/</ns0:pron>
        <ns0:pron>/əˈt̪ʰɔɾɪʈi/</ns0:pron>
        <ns0:pron>/əˈθɑɹti/</ns0:pron>
        <ns0:pron>/əˈθɑɹəti/</ns0:pron>
        <ns0:pron>/əˈθɔɹti/</ns0:pron>
        <ns0:pron>/əˈθɔɹəti/</ns0:pron>
        <ns0:pron>/ˈɔt̪ʰɵɾɪʈi/</ns0:pron>
        <ns0:pron>[əˈθɑɹəɾi]</ns0:pron>
        <ns0:pron>[əˈθɔɹəɾi]</ns0:pron>
        <ns0:pron>[əˈθɔɹɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoridad</ns0:quote>
          <ns0:quote>autorización</ns0:quote>
          <ns0:quote>autoridades</ns0:quote>
          <ns0:quote>fuerzas del orden</ns0:quote>
          <ns0:quote>policía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Power or right to make or enforce rules, give orders, or impose obligation; or a position having such power or right.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoridad</ns0:quote>
          <ns0:quote>prestigio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A reliable, definitive source of information on a subject.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Status as a trustworthy source of information, reputation for mastery or expertise; or claim to such status or reputation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authorization</ns0:orth>
        <ns0:pron>/ˌɔːθəɹaɪˈzeɪʃn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autorización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An act of authorizing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The state of being authorized to do something or to be somewhere; formally granted permission.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authorize</ns0:orth>
        <ns0:pron>/ˈɑθəɹaɪz/</ns0:pron>
        <ns0:pron>/ˈɒθəɹaɪz/</ns0:pron>
        <ns0:pron>/ˈɔːθəɹaɪz/</ns0:pron>
        <ns0:pron>/ˈɔθəɹaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autorizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To grant (someone) the permission or power necessary to do (something); to permit; to sanction or consent to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authorized</ns0:orth>
        <ns0:pron>/ˈɑθəɹaɪzd/</ns0:pron>
        <ns0:pron>/ˈɔːθəɹaɪzd/</ns0:pron>
        <ns0:pron>/ˈɔθəɹaɪzd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autorizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Explicitly allowed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>authorship</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autoría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality or state of being an author; the function or dignity of an author.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autism</ns0:orth>
        <ns0:pron>/ˈɑtɪzəm/</ns0:pron>
        <ns0:pron>/ˈɔːtɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(clinical psychology) A pervasive neurological condition that is observable in early childhood and persists throughout the lifespan, characterised by atypical communication patterns (e.g., differences in body language or eye contact), delayed language development, and sensory processing sensitivities.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(clinical psychology, obsolete) A diagnosis involving a pathological tendency to engage in self-centered fantasy thinking, historically considered a symptom of insanity or schizophrenia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autism spectrum disorder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno del espectro autista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology, pathology) A disorder involving any of a range of psychological conditions, all characterized by abnormal social interaction and communication, restricted interests, highly repetitive behaviour, and eccentricity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autist</ns0:orth>
        <ns0:pron>/ˈɔː.tɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An autistic person, a person with autism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autistic</ns0:orth>
        <ns0:pron>/ɑˈtɪs.tɪk/</ns0:pron>
        <ns0:pron>/ɔːˈtɪs.tɪk/</ns0:pron>
      </ns0:form>
