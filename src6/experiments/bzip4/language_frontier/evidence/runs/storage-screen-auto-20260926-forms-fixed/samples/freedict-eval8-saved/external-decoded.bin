      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cañón cuáquero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, chiefly, US, weaponry, historical) A nonfunctional imitation of a gun or an artillery piece, typically made of wood and usually intended to deceive enemy forces into overestimating one's available firepower.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
