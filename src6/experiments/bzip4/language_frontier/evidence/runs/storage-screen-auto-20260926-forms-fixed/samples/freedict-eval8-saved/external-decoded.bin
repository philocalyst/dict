        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra de compás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A vertical line in musical notation used to separate two bars or measures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bar none</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
