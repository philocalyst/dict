          <ns0:quote>Chagatai</ns0:quote>
          <ns0:quote>Chagatay</ns0:quote>
          <ns0:quote>Djagatai</ns0:quote>
          <ns0:quote>Tschagatai</ns0:quote>
        </ns0:cit>
        <ns0:sense>
