    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beneficiary</ns0:orth>
        <ns0:pron>/bɛn.əˈfɪʃ.iˌɚ.i/</ns0:pron>
        <ns0:pron>/ˌbɛn.əˈfɪʃ.əɹ.i/</ns0:pron>
        <ns0:pron>/ˌbɛn.ɪˈfɪʃ.əɹ.i/</ns0:pron>
