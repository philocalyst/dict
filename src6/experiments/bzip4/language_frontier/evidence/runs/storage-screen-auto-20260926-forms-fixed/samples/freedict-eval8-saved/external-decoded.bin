        <ns0:sense>
          <ns0:def>A favorable judgement given in the absence of full evidence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
