        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>juego de pelota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A specific contest or match between teams playing such a game, in particular a baseball game.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball girl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recogepelotas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) A female responsible for getting the balls from off the area of play to the players.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball hog</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chupona</ns0:quote>
          <ns0:quote>chupón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports, idiom, informal) In team sports, a player who keeps the ball to themselves, rather than passing it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball lightning</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rayo globular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A short-lived glowing ball sometimes observed to float in the air and thought to consist of ionized gas associated with thunderstorms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball pit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>piscina de bolas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A play area for children consisting of a pit filled with colourful plastic balls.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball sack</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salveque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The scrotum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ball up</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apelotonar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To crush or form into a ball shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballad</ns0:orth>
        <ns0:pron>/ˈbæləd/</ns0:pron>
        <ns0:pron>/ˈbælɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A kind of narrative poem, adapted for recitation or singing; especially, a sentimental or romantic poem in short stanzas.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A slow romantic song.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballast</ns0:orth>
        <ns0:pron>/ˈbæl.əst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lastre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) Heavy material that is placed in the hold of a ship (or in the gondola of a balloon), to provide stability.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative) Anything that steadies emotion or the mind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balasto</ns0:quote>
          <ns0:quote>balastro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Coarse gravel or similar material laid to form a bed for roads or railroads, or in making concrete; track ballast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balasto</ns0:quote>
          <ns0:quote>balastro</ns0:quote>
          <ns0:quote>balastra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, electricity, electronics) device used for stabilizing current in an electric circuit (e.g. in a tube lamp supply circuit)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballast</ns0:orth>
        <ns0:pron>/ˈbæl.əst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lastrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To stabilize or load a ship with ballast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballerina</ns0:orth>
        <ns0:pron>/ˌbæləɹˈiːnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bailarina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(commonly) A female ballet dancer.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(less common, non-standard) A male ballet dancer; Synonym of ballerino.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballet</ns0:orth>
        <ns0:pron>/bælˈeɪ/</ns0:pron>
        <ns0:pron>/bælˈæɪ/</ns0:pron>
        <ns0:pron>/bɐleː/</ns0:pron>
        <ns0:pron>/bɐlɪː/</ns0:pron>
        <ns0:pron>/bɛlˈæɪ/</ns0:pron>
        <ns0:pron>/ˈbal.eɪ/</ns0:pron>
        <ns0:pron>/ˈbal.ɪ/</ns0:pron>
        <ns0:pron>/ˈbale/</ns0:pron>
        <ns0:pron>/ˈbæl(ˌ)eɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ballet</ns0:quote>
          <ns0:quote>baile</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dances) A classical form of dance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballet flat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bailarina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of women's flat with a very low heel, thin sole, and round toe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balletomane</ns0:orth>
        <ns0:pron>/bæˈlɛt.əˌmeɪn/</ns0:pron>
        <ns0:pron>/bəˈlɛt.əˌmeɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balletómano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ballet enthusiast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballista</ns0:orth>
        <ns0:pron>/bəˈlɪstə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(weaponry, historical) An ancient military engine, in the form of a crossbow, used for hurling large missiles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballistic</ns0:orth>
        <ns0:pron>/bəˈlɪs.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Of or relating to ballistics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballistic gelatin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gel balístico</ns0:quote>
          <ns0:quote>gelatina balística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gelatin formulation designed to resemble muscle tissue and used to gauge the effects of bullet wounds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballistic missile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>misil balístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, rocketry) A missile that is initially guided, but then follows a ballistic (freely falling) trajectory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballistics</ns0:orth>
        <ns0:pron>/bəˈlɪst.ɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The science of objects that predominantly fly under the effects of gravity, momentum and atmospheric drag, and dealing with details of their behaviour at the origin and destination of their flight, as of bullets or missiles or rockets.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballistite</ns0:orth>
        <ns0:pron>/ˈbæl.əˌstaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balistita</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balloon</ns0:orth>
        <ns0:pron>/bəˈlun/</ns0:pron>
        <ns0:pron>/bəˈluːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>globo</ns0:quote>
          <ns0:quote>vejiga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An inflatable buoyant object, often (but not necessarily) round and flexible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>globo</ns0:quote>
          <ns0:quote>bomba</ns0:quote>
          <ns0:quote>chimbomba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Such an object as a child’s toy or party decoration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balloon modelling</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>globoflexia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballot</ns0:orth>
        <ns0:pron>/ˈbælət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balota</ns0:quote>
          <ns0:quote>papeleta de voto</ns0:quote>
          <ns0:quote>boleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(originally) A small ball placed in a container to cast a vote; now, by extension, a piece of paper or card used for this purpose, or some other means used to signify a vote.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>votación</ns0:quote>
          <ns0:quote>elecciones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of voting, especially in secret; a round of voting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>candidatura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US) A list of candidates running for office; a ticket.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballot box</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>urna</ns0:quote>
          <ns0:quote>urna electoral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sealed box with a slit, into which a voter places a completed voting slip.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballot paper</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A voting form; the paper upon which a vote is cast during a ballot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballpark</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aproximado</ns0:quote>
          <ns0:quote>orientativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Approximate; close; on the right order of magnitude.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballpark</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cancha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A field, stadium or park where ball, especially baseball, is played.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>región</ns0:quote>
          <ns0:quote>vecindad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, figuratively) The general vicinity; somewhere close; a broad approximation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballpark</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estimar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, informal) To make a rough estimate of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballpoint pen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bolígrafo</ns0:quote>
          <ns0:quote>boli</ns0:quote>
          <ns0:quote>birome</ns0:quote>
          <ns0:quote>esfero</ns0:quote>
          <ns0:quote>lapicero</ns0:quote>
          <ns0:quote>lápiz pasta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pen, similar in size and shape to a pencil, having an internal chamber filled with a viscous, quick-drying ink that is dispensed at the tip during use by the rolling action of a metal sphere (around 0.7 mm to 1 mm in diameter).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballroom</ns0:orth>
        <ns0:pron>/ˈbɔːlɹuːm/</ns0:pron>
        <ns0:pron>/ˈbɔːlɹʊm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salón de baile</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large room used for dancing and banquets.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balls</ns0:orth>
        <ns0:pron>/baːlz/</ns0:pron>
        <ns0:pron>/bɑlz/</ns0:pron>
        <ns0:pron>/bɔːlz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cojones</ns0:quote>
          <ns0:quote>huevos</ns0:quote>
          <ns0:quote>bolas</ns0:quote>
          <ns0:quote>pelotas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, vulgar, colloquial) Masculinity, particularly strength, courage, and force of will; chutzpah; brazenness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balls-deep</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hasta las pelotas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, vulgar) With the penis fully immersed in an orifice, more often the anus or vagina than the mouth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballsy</ns0:orth>
        <ns0:pron>/ˈbɔlzi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cojonudo</ns0:quote>
          <ns0:quote>corajudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(vulgar, colloquial) Tough and courageous; having balls.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballyhoo</ns0:orth>
