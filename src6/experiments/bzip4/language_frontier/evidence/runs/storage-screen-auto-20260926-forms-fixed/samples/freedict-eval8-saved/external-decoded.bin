        <ns0:pron>/ˈzoʊ.ɑɹ/</ns0:pron>
        <ns0:pron>/ˈzəʊ.ɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Segor</ns0:quote>
          <ns0:quote>Zóar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) One of the Pentapolis, the five ancient cities in the Jordan valley.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zoroaster</ns0:orth>
        <ns0:pron>/ˈzɒɹoʊˌæstəɹ/</ns0:pron>
        <ns0:pron>/ˌzɒɹoʊˈæstəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zoroastro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient Iranian prophet after whom the indigenous Iranian ethnic religion, Zoroastrianism, is named, also venerated in Mithraism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zoroastrian</ns0:orth>
        <ns0:pron>/ˌzoʊɹ.oʊˈæs.tɹi.ən/</ns0:pron>
        <ns0:pron>/ˌzɒɹəʊˈæstɹɪən/</ns0:pron>
        <ns0:pron>/ˌzɔɹ.oʊˈæs.tɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zoroástrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>relating to or characteristic of Zoroastrianism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zoroastrianism</ns0:orth>
        <ns0:pron>/ˌzoʊɹ.oʊˈæs.tɹi.əˌnɪz.əm/</ns0:pron>
        <ns0:pron>/ˌzɒɹəʊˈæstɹɪəˌnɪzəm/</ns0:pron>
        <ns0:pron>/ˌzɔɹ.oʊˈæs.tɹi.əˌnɪz.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zoroastrismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(scholarly) The historical (pre-Islamic) indigenous beliefs and practices of the Iranian peoples.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
