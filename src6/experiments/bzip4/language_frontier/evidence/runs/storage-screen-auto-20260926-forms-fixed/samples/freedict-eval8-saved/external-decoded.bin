      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cualquiera</ns0:quote>
          <ns0:quote>alguien</ns0:quote>
          <ns0:quote>cada hijo de vecino</ns0:quote>
          <ns0:quote>cualquier hijo de vecino</ns0:quote>
          <ns0:quote>quien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
