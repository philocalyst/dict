        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Danzig</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Gdańsk (especially in reference to the times when it was part of a German-speaking state such as Prussia or Germany).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
