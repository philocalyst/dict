          <ns0:quote>golfo de León</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gulf of the Mediterranean Sea, reaching from Catalonia to Toulon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gulf of Mexico</ns0:orth>
