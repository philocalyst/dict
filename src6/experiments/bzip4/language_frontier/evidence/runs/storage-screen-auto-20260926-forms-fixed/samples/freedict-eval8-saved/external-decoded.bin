      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base</ns0:quote>
          <ns0:quote>fundamento</ns0:quote>
          <ns0:quote>basa</ns0:quote>
          <ns0:quote>fuste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A starting point, base or foundation for an argument or hypothesis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base</ns0:quote>
          <ns0:quote>fundamento</ns0:quote>
          <ns0:quote>basa</ns0:quote>
          <ns0:quote>basarse</ns0:quote>
          <ns0:quote>fundamentarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An underlying condition or circumstance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A regular frequency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linear algebra) In a vector space, a linearly independent set of vectors spanning the whole vector space.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
