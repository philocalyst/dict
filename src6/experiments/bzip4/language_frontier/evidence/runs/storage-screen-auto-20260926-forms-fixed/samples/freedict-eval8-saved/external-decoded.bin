        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Moncagua</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Moncagua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town in San Miguel department, El Salvador.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monday</ns0:orth>
        <ns0:pron>/ˈmʌn.deɪ/</ns0:pron>
        <ns0:pron>/ˈmʌn.di/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lunes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The second day of the week in many religious traditions, and the first day of the week in systems using the ISO 8601 norm. It follows Sunday and precedes Tuesday.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongol</ns0:orth>
        <ns0:pron>/ˈmɑŋɡəl/</ns0:pron>
        <ns0:pron>/ˈmɑŋˌɡoʊl/</ns0:pron>
        <ns0:pron>/ˈmɒŋɡəl/</ns0:pron>
        <ns0:pron>/ˈmɔŋˌɡoʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mongólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated, now, derogatory, offensive) A person with Down's syndrome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongol Empire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>imperio mongol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An empire of the Mongols and Turkic peoples which existed in Asia from 1206 to 1368 and became the largest contiguous land empire in human history, stretching from Central Europe east to the Sea of Japan and from Siberia south to the Indian subcontinent and the Middle East.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongolia</ns0:orth>
        <ns0:pron>/mɑŋˈɡoʊli.ə/</ns0:pron>
        <ns0:pron>/mɒŋˈɡəʊli.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mongolia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in East Asia. Capital and largest city: Ulaanbaatar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongolian</ns0:orth>
        <ns0:pron>/mɒŋˈɡoʊliən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mongol</ns0:quote>
          <ns0:quote>mongólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Mongolia or its peoples, languages, or cultures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongolian</ns0:orth>
        <ns0:pron>/mɒŋˈɡoʊliən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mongol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A native or inhabitant of Mongolia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) A group of languages from Mongolia, specifically Khalkha, the official language of Mongolia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person of the mongoloid physical type.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongolian People's Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Popular de Mongolia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) the Mongolian state between 1924 and 1992.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mongolian spot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>callana</ns0:quote>
          <ns0:quote>mancha de los morenos</ns0:quote>
          <ns0:quote>mancha mongólica</ns0:quote>
          <ns0:quote>melanocitosis dérmica congénita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A benign, flat, congenital, usually blue to blue-black birthmark on the lower back with wavy borders and irregular shape, prevalent among East Asians, South-East Asians, Polynesians, Native Americans, East Africans, and the Turkish people. It normally disappears three to five years after birth and almost always by puberty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monica</ns0:orth>
        <ns0:pron>/ˈmo.nɪ.kɑ/</ns0:pron>
        <ns0:pron>/ˈmɑ.nɪ.kə/</ns0:pron>
        <ns0:pron>/ˈmɒn.ɪ.kə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mónica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monoceros</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Monoceros</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A winter constellation of the northern sky, said to resemble a unicorn. It lies amid the Milky Way, just east of the constellation Orion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monophysite</ns0:orth>
        <ns0:pron>/məˈnɒfɪsaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>monofisista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A member of a Christian sect which held that Jesus Christ has one nature, as opposed to the Chalcedonian view that Christ has two natures, both fully man and fully God, and is co-eternal and co-substantial with the Father.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monopoly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Monopoly</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(board games) A board game in which players use play money to buy and trade properties, with the objective of forcing opponents into bankruptcy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monothelete</ns0:orth>
        <ns0:pron>/mɒˈnɒθɪliːt/</ns0:pron>
        <ns0:pron>/məˈnɒθɪliːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>monoteleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity, historical) Someone who believed Christ had two natures (human and divine), but one single will; a Monothelite.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
