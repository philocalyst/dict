      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isla de la Juventud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island and special municipality south of the island of Cuba, across the Gulf of Batabanó.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ismailia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ismailía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in northeastern Egypt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Israel</ns0:orth>
        <ns0:pron>/ˈɪz.ɹaɪ.ɛl/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹeɪ.əl/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹeɪ.ɛl/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹeɪl/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹi.əl/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹɛəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Israel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Biblical) A Biblical region of Western Asia roughly coextensive with the modern State of Israel, known in the Bible as the Land of Israel and considered the ancestral homeland of the Jewish people.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Another name for Jacob, notably after Genesis 32:28 and in later references.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Israeli</ns0:orth>
        <ns0:pron>/ɪzˈɹeɪli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>israelí</ns0:quote>
          <ns0:quote>israelita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Israel or the Israeli people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Israeli</ns0:orth>
        <ns0:pron>/ɪzˈɹeɪli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>israelí</ns0:quote>
          <ns0:quote>israelita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from Israel or of Israeli descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Israelite</ns0:orth>
        <ns0:pron>/ˈɪz.ɹeɪ.əˌlaɪt/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹi.əˌlaɪt/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹɪˌlaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>israelita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare, chiefly, in, _, Protestantism) Of or pertaining to the descendants of the patriarch Jacob.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Israelite</ns0:orth>
        <ns0:pron>/ˈɪz.ɹeɪ.əˌlaɪt/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹi.əˌlaɪt/</ns0:pron>
        <ns0:pron>/ˈɪz.ɹɪˌlaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>israelita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the Twelve Tribes of Israel and a descendant of Jacob.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Issachar</ns0:orth>
        <ns0:pron>/ˈɪ.səˌkɑɹ/</ns0:pron>
        <ns0:pron>/ˈɪ.səˌkɑː(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isacar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical figure) Ninth son of Jacob, by his wife Leah.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Istanbul</ns0:orth>
        <ns0:pron>/ɪstænˈbʊl/</ns0:pron>
        <ns0:pron>/ɪsˈt̪ɑnbʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estambul</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Turkish city, and the largest European city by population, which was the last capital of the Ottoman Empire and the Byzantine Empire (Eastern Roman Empire).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
