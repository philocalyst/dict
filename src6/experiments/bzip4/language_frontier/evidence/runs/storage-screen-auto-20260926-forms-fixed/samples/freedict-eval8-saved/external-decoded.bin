          <ns0:quote>cachachá</ns0:quote>
          <ns0:quote>chivas</ns0:quote>
          <ns0:quote>efectos personales</ns0:quote>
          <ns0:quote>enseres</ns0:quote>
        </ns0:cit>
        <ns0:sense>
