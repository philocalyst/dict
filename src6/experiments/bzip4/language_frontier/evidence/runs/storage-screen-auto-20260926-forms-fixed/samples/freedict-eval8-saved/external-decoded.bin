      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>piquituerto escocés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Loxia scotica, a small passerine bird in the finch family Fringillidae. It is endemic to the Caledonian Forests of Scotland</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
