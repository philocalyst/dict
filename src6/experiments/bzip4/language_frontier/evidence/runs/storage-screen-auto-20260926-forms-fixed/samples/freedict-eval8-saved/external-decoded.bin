        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>birimbao</ns0:quote>
          <ns0:quote>arpa de boca</ns0:quote>
          <ns0:quote>guimbarda</ns0:quote>
          <ns0:quote>torompe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A musical instrument consisting of a flexible metal or bamboo “tongue” attached to a frame. This tongue is placed in the performer's mouth and plucked with the finger to produce a note of constant pitch. Melodies can be created by changing the shape of the mouth and causing different overtones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
