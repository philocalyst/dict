      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aromatizar</ns0:quote>
          <ns0:quote>aromar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make aromatic, fragrant, or spicy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>around</ns0:orth>
        <ns0:pron>/əˈɹaʊnd/</ns0:pron>
        <ns0:pron>/əˈɹuːnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por acá</ns0:quote>
          <ns0:quote>por allí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From place to place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>around</ns0:orth>
        <ns0:pron>/əˈɹaʊnd/</ns0:pron>
        <ns0:pron>/əˈɹuːnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alrededor</ns0:quote>
          <ns0:quote>en contorno a / de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Forming a circle or closed curve containing (something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alrededor de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Following the perimeter of a specified area and returning to the starting point.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Following a path which curves near an object, with the object on the inside of the curve.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a aqueso de</ns0:quote>
          <ns0:quote>a eso de</ns0:quote>
          <ns0:quote>cerca de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Near; in the vicinity of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At or to various places within or throughout.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>around the clock</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>día y noche</ns0:quote>
          <ns0:quote>noche y día</ns0:quote>
          <ns0:quote>sin descanso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(duration, idiomatic) All the time, or seemingly all the time; constantly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
