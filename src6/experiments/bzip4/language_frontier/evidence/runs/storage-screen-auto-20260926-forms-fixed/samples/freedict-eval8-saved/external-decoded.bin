          <ns0:quote>Alemania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in Central Europe, formed in 1949 as West Germany, with its provisional capital Bonn until 1990, when it incorporated East Germany. Official name: Federal Republic of Germany. Capital and largest city: Berlin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
