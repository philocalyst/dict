      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lidia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A historical region and ancient kingdom in western Asia Minor, in modern-day Turkey.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Biblical) A woman converted by St. Paul; presumably named for ancestry or residence in Lydia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lyme disease</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfermedad de Lyme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) Infection by one of three or more subspecies of the bacterium Borrelia burgdorferi, which is transmitted by four species of tick in genus Ixodes. Symptoms include a rash followed by fever, joint pain, and headaches.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
