          <ns0:quote>anormalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an abnormal manner; in a way that deviates from a standard, norm, or average. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
