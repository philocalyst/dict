      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cárpatos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large mountainous system in Central Europe, mainly in Transylvania (Romania) and the Polish (Subcarpathian)-Slovak border region.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
