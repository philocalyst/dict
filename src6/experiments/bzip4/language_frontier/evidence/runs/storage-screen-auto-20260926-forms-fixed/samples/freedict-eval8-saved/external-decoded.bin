      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasamontañas</ns0:quote>
          <ns0:quote>papahígo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of warm headgear covering the neck, head, and often part of the face, with apertures left as necessary, often made out of wool.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
