      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entornadamente</ns0:quote>
          <ns0:quote>entreabiertamente</ns0:quote>
          <ns0:quote>entrecerradamente</ns0:quote>
          <ns0:quote>juntadamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Slightly turned or opened.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ajouré</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>clarado</ns0:quote>
        </ns0:cit>
