        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luke</ns0:orth>
        <ns0:pron>/luːk/</ns0:pron>
        <ns0:pron>/lyk/</ns0:pron>
        <ns0:pron>/lɪu̯k/</ns0:pron>
        <ns0:pron>/lʉk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lucas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Luke the Evangelist, an early Christian credited with the authorship of the Gospel of Luke and the Acts of the Apostles.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biblical) The Gospel of St. Luke, a book of the New Testament of the Bible. Traditionally the third of the four gospels.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An English surname originating as a patronymic, a variant of Luck.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
