    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Donatism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>donatismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) An early Christian belief which maintained that apostate priests were incapable of administering the sacraments, as opposed to the orthodox view that any sacrament administered by a properly ordained priest or bishop is valid, regardless of how sinful he is or if he has converted to another religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
