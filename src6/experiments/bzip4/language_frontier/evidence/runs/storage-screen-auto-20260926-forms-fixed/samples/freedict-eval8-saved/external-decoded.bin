          <ns0:quote>inca</ns0:quote>
          <ns0:quote>Inca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the group of Quechuan peoples of highland Peru who established an empire from northern Ecuador to central Chile before the Spanish conquest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Inca Empire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Imperio incaico</ns0:quote>
          <ns0:quote>Tahuantinsuyo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The pre-Columbian empire spreading over many parts of western South America. It was controlled by the Incas, and had its capital as Cuzco.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Incan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>incaico</ns0:quote>
          <ns0:quote>incásico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Independence Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día de la Independencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A holiday celebrated in the United States commemorating the country's independence from Great Britain, celebrated each year on the 4th of July.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Philippines) A national holiday in the Philippines observed annually on June 12, commemorating the declaration of Philippine independence from Spain in 1898.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(India) A national holiday in India observed annually on August 15, commemorating the nation’s independence from Great Britain in 1947.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>India</ns0:orth>
        <ns0:pron>/ˈɪndi.ə/</ns0:pron>
        <ns0:pron>/ˈɪndiːə/</ns0:pron>
        <ns0:pron>/ˈɪn̪d̪ɪa/</ns0:pron>
        <ns0:pron>/ˈɪɳɖɪa/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>India</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, historical, proscribed, _, in modern use) A region of South Asia, traditionally delimited by the Himalayas and the Indus river; the Indian subcontinent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>India ink</ns0:orth>
        <ns0:pron>/ˈɪn.di.ə ɪŋk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tinta china</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A black ink, made from lampblack, used for printing and artwork.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian</ns0:orth>
        <ns0:pron>/ˈɪn.di.ən/</ns0:pron>
        <ns0:pron>/ˈɪn.dɪ.ən/</ns0:pron>
        <ns0:pron>/ˈɪɳ.ɖɪə̯n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indio</ns0:quote>
          <ns0:quote>hindú</ns0:quote>
          <ns0:quote>indo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to India or its people; or (formerly) of the East Indies. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indio</ns0:quote>
          <ns0:quote>indiano</ns0:quote>
          <ns0:quote>indígena</ns0:quote>
          <ns0:quote>amerindio</ns0:quote>
          <ns0:quote>indoamericano</ns0:quote>
          <ns0:quote>jashte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the indigenous peoples of the Americas. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian</ns0:orth>
        <ns0:pron>/ˈɪn.di.ən/</ns0:pron>
        <ns0:pron>/ˈɪn.dɪ.ən/</ns0:pron>
        <ns0:pron>/ˈɪɳ.ɖɪə̯n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indio</ns0:quote>
          <ns0:quote>india</ns0:quote>
          <ns0:quote>hindú</ns0:quote>
          <ns0:quote>indo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A person from India. [from 13th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indio</ns0:quote>
          <ns0:quote>indiano</ns0:quote>
          <ns0:quote>indígena</ns0:quote>
          <ns0:quote>amerindio</ns0:quote>
          <ns0:quote>indiana</ns0:quote>
          <ns0:quote>amerindia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An American Indian, a member of one of the indigenous peoples of the Americas (generally excluding the Aleut, Inuit, Metis, and Yupik). [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian Ocean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>océano Índico</ns0:quote>
          <ns0:quote>Índico</ns0:quote>
          <ns0:quote>Océano Índico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ocean separating Africa, southern Asia, Australia and Antarctica.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian Orthodox Church</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iglesia ortodoxa india</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Oriental Orthodox church in India branched from the Syriac Orthodox Church of Antioch which follows the Malankara rite, a form of the West Syriac rite.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian aconite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acónito indio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Aconitum ferox, a species of plant from around the Himalayas known for the potentness of its poison.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian black-lored tit</ns0:orth>
      </ns0:form>
