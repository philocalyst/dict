    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mid-Autumn Festival</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fiesta del Medio Otoño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(collective) The East Asian festivals originating, inspired, or co-opted from the Chinese Mid-Autumn Festival.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Midas</ns0:orth>
        <ns0:pron>/ˈmaɪ.dəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Midas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A king who sought and was for a while granted the cherished but subtly dangerous magical power to turn anything he touched into gold.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Ages</ns0:orth>
        <ns0:pron>/ˌmɪdl̩ ˈeɪdʒɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Edad Media</ns0:quote>
          <ns0:quote>medievo</ns0:quote>
          <ns0:quote>medioevo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) The period of primarily European history between the decline of the Western Roman Empire (antiquity) and the early modern period or the Renaissance; the time between c. 500 and 1500 CE.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle America</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>América Media</ns0:quote>
          <ns0:quote>América Medial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographical region comprising Mexico, Central America and the Caribbean</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Chinese</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Chino Medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Chinese language spoken during Southern and Northern Dynasties and the Sui, Tang, and Song dynasties (6th century – 10th century)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Cornish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>córnico medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Celtic language spoken in Cornwall between the 13th and 17th centuries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle East</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Oriente Medio</ns0:quote>
          <ns0:quote>Medio Oriente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geopolitics) The geopolitical region at the intersection of Asia, Africa and Europe, comprising West Asia excluding the South Caucasus and additionally including all of Egypt and all of Turkey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Eastern</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de Medio Oriente</ns0:quote>
          <ns0:quote>de Oriente Medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the Middle East.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle English</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inglés medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ancient or older language of Modern English, spoken in England and parts of Scotland (where it became Lowland Scots) from about 1100 AD to 1500 AD.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Frisian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frisón medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) The language descended from Old Frisian spoken on the North Sea coast of modern Netherlands and Germany from the 16th century until c. 1820.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle High German</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alto alemán medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancestor to the modern (High) German language, spoken from 1050 to about 1500. Some linguists prefer to use 1350 as the end of the Middle High German period, calling the period from 1350 to 1650 Early New High German in a broad sense.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Irish</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>irlandés medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Goidelic language spoken in Ireland, Scotland, and the Isle of Man from the 10th to the 12th century.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Kingdom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Reino del Medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary) China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Imperio medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Egypt from the time of its reunification under Mentuhotep II in the 11th Dynasty (ending the First Intermediate Period) to its disintegration during the 13th Dynasty and the beginning of the Second Intermediate Period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle Persian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>persa medio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ancestor of New Persian spoken from around 300 BC till about 800 AD, evolving from Old Persian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Middle-earth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
