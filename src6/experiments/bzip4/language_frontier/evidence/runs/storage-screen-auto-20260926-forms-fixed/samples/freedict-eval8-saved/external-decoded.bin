        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The daughter of Inachus river god, and a lover of Zeus, turned by the latter into a heifer.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) A moon of Jupiter, known for its volcanic activity, peppered with about 400 active volcanoes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
