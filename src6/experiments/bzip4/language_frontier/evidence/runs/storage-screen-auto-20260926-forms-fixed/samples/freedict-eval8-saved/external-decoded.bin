          <ns0:quote>NN</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(United States) A fictitious name used chiefly in legal documents for an unknown or anonymous, usually male, person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>John Dory</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pez de San Pedro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An edible marine fish (Zeus faber or Zeus ocellata), having long dorsal spines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>John the Baptist</ns0:orth>
      </ns0:form>
