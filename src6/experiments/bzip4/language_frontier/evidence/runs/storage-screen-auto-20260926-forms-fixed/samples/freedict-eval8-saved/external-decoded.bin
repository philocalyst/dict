        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isla de Gotland</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A municipality and county on the island of Gotland, Sweden; the only municipality there, so it, the county and island all have the same area.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
