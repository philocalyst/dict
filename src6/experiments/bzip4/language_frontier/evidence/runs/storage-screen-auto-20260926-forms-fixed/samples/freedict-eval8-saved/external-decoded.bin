      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mitraico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Mithraism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mithraism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mitraísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An astrology-based, middle-platonic mystery religion of the 1st-4th century Roman Empire that claimed to have been founded by Zoroaster, admitted only men, and was especially popular among the Roman military.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
