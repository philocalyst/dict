        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Laos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in Southeast Asia. Official name: Lao People’s Democratic Republic. Capital: Vientiane.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Laotian</ns0:orth>
        <ns0:pron>/leɪˈoʊʃən/</ns0:pron>
        <ns0:pron>/ˈlaʊʃən/</ns0:pron>
