          <ns0:quote>Meseta tibetana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A high altitude plateau north of the Great Himalaya ranges, west of the Szechuan basin, and south of the Taklamakan Desert.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
