          <ns0:quote>bosón de Higgs</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(particle) An elementary particle in the Standard Model, namely a boson with zero spin, that gives mass to other particles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
