        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Urías</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The husband of Bathsheba whom David sent to death.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Urim and Thummim</ns0:orth>
        <ns0:pron>/-ən(d)-/</ns0:pron>
        <ns0:pron>/ˈjəɹ.əm ænd ˌθəm.məm/</ns0:pron>
        <ns0:pron>/ˈuɹ.im/&lt;a:formal&gt;</ns0:pron>
        <ns0:pron>/ˌtʰu.mim/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Urim y Tumim</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Certain sacred objects (whose precise form and nature is unknown) that were worn on the breastplate of the Jewish high priest, as described in the Bible, and used in divination or casting lots. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
