          <ns0:quote>Reino de Inglaterra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A kingdom in western Europe, from the early 900s until the foundation of the United Kingdom of Great Britain on 1 May 1707.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
