    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Casanova</ns0:orth>
        <ns0:pron>/ˌkæsəˈnoʊvə/</ns0:pron>
        <ns0:pron>/ˌkæsəˈnəʊvə/</ns0:pron>
        <ns0:pron>/ˌkæzəˈnoʊvə/</ns0:pron>
        <ns0:pron>/ˌkæzəˈnəʊvə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>casanova</ns0:quote>
          <ns0:quote>galán</ns0:quote>
          <ns0:quote>papi chulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A man considered romantic and gallant, especially one who gives amorous attentions to women.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golfo</ns0:quote>
          <ns0:quote>mujeriego</ns0:quote>
          <ns0:quote>puto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A promiscuous, philandering man.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Casimir</ns0:orth>
