    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mach</ns0:orth>
        <ns0:pron>/maːx/</ns0:pron>
        <ns0:pron>/mæk/</ns0:pron>
        <ns0:pron>/mɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mach</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, uncountable) A ratio of the speed (of an object, etc.) to the speed of sound in the fluid or other medium through which the object travels. Usually used to describe supersonic speeds; always precedes the Mach number.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mach number</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>número Mach</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The ratio of the speed of a body to that of sound in the surrounding medium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
