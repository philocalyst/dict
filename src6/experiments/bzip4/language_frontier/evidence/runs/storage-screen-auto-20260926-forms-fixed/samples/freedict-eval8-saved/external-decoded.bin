        <ns0:pron>/luːˈhænsk/</ns0:pron>
        <ns0:pron>/luːˈhɑːnsk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
