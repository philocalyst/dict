        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, offensive) A member of the Romani people, or one of the sub-groups (Roma, Sinti, Romanichal, etc).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A member of other nomadic peoples, not only of the Romani people; a traveller.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
