      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zorro ártico</ns0:quote>
          <ns0:quote>zorro polar</ns0:quote>
          <ns0:quote>zorro blanco</ns0:quote>
          <ns0:quote>zorro de las nieves</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Vulpes lagopus, a fox of the family Canidae, living in the Arctic regions of North America and Eurasia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arctic hare</ns0:orth>
