      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>celta</ns0:quote>
          <ns0:quote>céltico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the Celts.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(linguistics) Of the languages spoken by Celts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Celtic</ns0:orth>
        <ns0:pron>/ˈkɛltɪk/</ns0:pron>
        <ns0:pron>/ˈsɛltɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>celta</ns0:quote>
          <ns0:quote>céltico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A branch of the Indo-European languages that was spread widely over Western and Central Europe in the pre-Christian era.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Celtic Sea</ns0:orth>
      </ns0:form>
