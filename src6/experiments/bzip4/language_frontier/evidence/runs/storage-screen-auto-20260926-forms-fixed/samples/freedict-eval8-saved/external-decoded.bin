        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>psicología anormal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The academic study of persons whose psychological characteristics deviate from the norm, such as neuroses, psychoses, and other disorders.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
