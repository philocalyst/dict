      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ardent</ns0:orth>
        <ns0:pron>/ˈɑɹdənt/</ns0:pron>
        <ns0:pron>/ˈɑːdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ardiente</ns0:quote>
          <ns0:quote>ferviente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Full of ardor; expressing passion, spirit, or enthusiasm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ardor</ns0:orth>
        <ns0:pron>/ˈɑːdə/</ns0:pron>
        <ns0:pron>/ˈɑːɹdɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fervor</ns0:quote>
          <ns0:quote>ardor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Great warmth of feeling; fervor; passion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Spirit; enthusiasm; passion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ardor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Intense heat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arduity</ns0:orth>
        <ns0:pron>/ɑːˈdjuːɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arduidad</ns0:quote>
          <ns0:quote>dureza</ns0:quote>
          <ns0:quote>rigor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being arduous; steepness, difficulty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arduous</ns0:orth>
        <ns0:pron>/ˈɑɹ.d͡ʒu.əs/</ns0:pron>
        <ns0:pron>/ˈɑː.djuː.əs/</ns0:pron>
        <ns0:pron>/ˈɑː.d͡ʒuː.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arduo</ns0:quote>
          <ns0:quote>dispendioso</ns0:quote>
          <ns0:quote>riguroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Needing or using up much energy; testing powers of endurance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arduo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Difficult or exhausting to traverse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
