          <ns0:quote>espíritu de Saturno</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Venetic</ns0:orth>
        <ns0:pron>/vəˈnɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, _, linguistics) An extinct Indo-European language once spoken by the Veneti people who lived between the Po River delta in northeastern Italy and the southern Alps in Slovenia in antiquity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
