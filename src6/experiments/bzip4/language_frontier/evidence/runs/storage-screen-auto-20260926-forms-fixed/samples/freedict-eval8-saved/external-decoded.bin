        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iglesia ortodoxa griega</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of Eastern Orthodox churches comprising the churches of Constantinople, Antioch, Alexandria, Jerusalem, Cyprus and Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Greek fire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuego griego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A highly flammable substance of unknown composition first used by the Greeks of Constantinople in the 7th century ce to set fire to enemy ships, buildings, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Green's theorem</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>teorema de Green</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(calculus) A generalization of the fundamental theorem of calculus to the two-dimensional plane, which states that given two scalar fields P and Q and a simply connected region R, the area integral of derivatives of the fields equals the line integral of the fields, or</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
