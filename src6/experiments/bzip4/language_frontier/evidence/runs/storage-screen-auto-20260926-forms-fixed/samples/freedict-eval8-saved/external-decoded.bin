      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Kúpiansk</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city, the administrative centre of Kupiansk urban hromada, Kupiansk Raion, Kharkiv Oblast, Ukraine, founded in 1655.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>raión de Kúpiansk</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A povit of, successively, the Voronezh Viceroyalty and then the Voronezh, Sloboda Ukraine and Kharkov Governorates of the Russian Empire, and then of the Kharkiv Governorate of the Ukrainian Soviet Socialist Republic; established in 1779, abolished in 1923.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A raion of Kharkiv Oblast, Ukraine, established in March 1923, subordinate to the okruha of the same name of the Ukrainian Soviet Socialist Republic until June 1930, and considerably enlarged in July 2020.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
