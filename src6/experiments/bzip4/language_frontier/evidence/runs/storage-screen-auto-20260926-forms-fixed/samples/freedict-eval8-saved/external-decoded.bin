        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el fin del mundo tal como lo conocemos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Acronym of the end of the world as we know it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>TERF</ns0:orth>
        <ns0:pron>/tɚf/</ns0:pron>
        <ns0:pron>/tɜːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>TERF</ns0:quote>
          <ns0:quote>terfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(see usage notes) A trans-exclusionary radical feminist; a radical feminist who does not consider trans women to be women, or thinks they should not be included in female spaces or organisations, and who considers trans men to be women; a person whose transphobia is expressed in feminist terms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
