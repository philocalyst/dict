      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion) A revival of religion, or more general attention to religious matters than usual.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertamiento</ns0:quote>
          <ns0:quote>despertar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) Being roused into action or activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertar</ns0:quote>
          <ns0:quote>despertamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of becoming aware of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
