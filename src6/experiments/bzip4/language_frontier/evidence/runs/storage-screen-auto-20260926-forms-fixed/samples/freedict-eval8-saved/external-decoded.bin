      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embalar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To wrap into a bale.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baleen</ns0:orth>
        <ns0:pron>/bəˈliːn/</ns0:pron>
        <ns0:pron>/ˈbeɪliːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barbas de ballena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physiology, uncountable) keratinous material that makes up the plates in the mouth of the baleen whale (Mysticeti), which it uses to trap its food; formerly used in corsetry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baleen whale</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ballena barbada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several large whales, of the parvorder Mysticeti, that have plates of whalebone (baleen) instead of teeth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balefire</ns0:orth>
      </ns0:form>
