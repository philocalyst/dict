        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abúlico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychiatry) Relating to, characterized by, or affected with abulia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abundance</ns0:orth>
        <ns0:pron>/əˈbn̩.dn̩s/</ns0:pron>
        <ns0:pron>/əˈbʌn.dn̩s/</ns0:pron>
        <ns0:pron>/əˈbʌn.dn̩ts/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundancia</ns0:quote>
          <ns0:quote>abastanza</ns0:quote>
          <ns0:quote>abundamiento</ns0:quote>
          <ns0:quote>ares y mares</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large quantity; many. [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An overflowing fullness or ample sufficiency; profusion; copious supply; superfluity; plentifulness. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abundant</ns0:orth>
        <ns0:pron>/əˈbʌn.dənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundante</ns0:quote>
          <ns0:quote>copioso</ns0:quote>
          <ns0:quote>cuantioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fully sufficient; found in copious supply; in great quantity; overflowing. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abundant number</ns0:orth>
        <ns0:pron>/əˈbn̩.dn̩t ˈnʌm.bɚ/</ns0:pron>
        <ns0:pron>/əˈbʌn.dn̩t ˈnʌm.bə/</ns0:pron>
        <ns0:pron>/əˈbʌn.dn̩t ˈnʌm.bɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>número abundante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(number theory) A number that is less than the sum of its proper divisors (all divisors except the number itself).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abundantly</ns0:orth>
        <ns0:pron>/əˈbn̩.dn̩t.li/</ns0:pron>
        <ns0:pron>/əˈbʌn.dn̩t.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundantemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an abundant manner; in a sufficient degree; in large measure. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abuse</ns0:orth>
        <ns0:pron>/əˈbjus/</ns0:pron>
        <ns0:pron>/əˈbjuːs/</ns0:pron>
        <ns0:pron>/əˈbjʉs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abuso</ns0:quote>
          <ns0:quote>abuso sexual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Improper treatment or usage; application to a wrong or bad purpose; an unjust, corrupt or wrongful practice or custom. [from around 1350 to 1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abuso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Physical maltreatment; injury; cruel treatment. [from late 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abuse</ns0:orth>
        <ns0:pron>/əˈbjuz/</ns0:pron>
        <ns0:pron>/əˈbjuːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abusar</ns0:quote>
          <ns0:quote>engañar</ns0:quote>
          <ns0:quote>violar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put to a wrong use; to misapply; to use improperly; to use for a wrong purpose or end; to pervert [from around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>violar</ns0:quote>
          <ns0:quote>abusar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To violate; defile; to rape; (reflexive) to masturbate. [from around 1350 to 1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abuse of discretion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abuso de discreción</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
