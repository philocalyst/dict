        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To prohibit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barra</ns0:quote>
          <ns0:quote>embarrar</ns0:quote>
          <ns0:quote>minibar</ns0:quote>
          <ns0:quote>tortor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To lock or bolt with a bar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bar</ns0:quote>
          <ns0:quote>barra</ns0:quote>
          <ns0:quote>taberna</ns0:quote>
          <ns0:quote>tortor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To imprint or paint with bars, to stripe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
