      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excitar</ns0:quote>
          <ns0:quote>encalabrinar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To sexually stimulate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertar</ns0:quote>
          <ns0:quote>despabilar</ns0:quote>
          <ns0:quote>espabilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To wake from sleep or stupor; to rouse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aroused</ns0:orth>
        <ns0:pron>/əˈɹaʊzd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cachondo</ns0:quote>
          <ns0:quote>caliente</ns0:quote>
          <ns0:quote>embramado</ns0:quote>
          <ns0:quote>excitado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sexually excited; randy, lustful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arpeggio</ns0:orth>
        <ns0:pron>/ɑɹˈpɛ.d͡ʒi.oʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arpegio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The notes of a chord played individually instead of simultaneously, usually moving from lowest to highest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arpeggio</ns0:orth>
        <ns0:pron>/ɑɹˈpɛ.d͡ʒi.oʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arpegiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To play (a chord) as an arpeggio; to play (a piece of music) with arpeggios.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arquebusier</ns0:orth>
      </ns0:form>
