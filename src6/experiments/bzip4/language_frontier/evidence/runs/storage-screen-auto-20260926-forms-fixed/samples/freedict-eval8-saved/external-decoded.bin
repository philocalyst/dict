        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mitraico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of Mithraism.</ns0:def>
        </ns0:sense>
