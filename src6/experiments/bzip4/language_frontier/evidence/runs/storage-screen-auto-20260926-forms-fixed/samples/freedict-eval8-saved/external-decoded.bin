        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Italy: a country in Southern Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Italian brainrot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>brainrot italiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(internet slang) A series of videos where AI-generated animals (or creatures) are mixed with everyday objects to create satire and surrealism. These creatures often are voiced over by a robotic male Italian voice, or have pseudo-Italian names.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
