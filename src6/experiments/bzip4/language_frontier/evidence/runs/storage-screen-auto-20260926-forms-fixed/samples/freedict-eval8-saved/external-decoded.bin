        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>capacitismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Discrimination against people with disabilities in favor of those without. [from late 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ableist</ns0:orth>
        <ns0:pron>/ˈeɪ.bəl.ɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>capacitista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Exhibiting or relating to ableism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ableist</ns0:orth>
