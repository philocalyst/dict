      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pancracio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of two Christian saints, Pancras of Taormina and Pancras of Rome</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pandarus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pándaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) An archer on the side of Troy in the Trojan War who precipitated the war by breaking a truce.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pandora</ns0:orth>
        <ns0:pron>/ˌpænˈdɔɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pandora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The first woman on earth, who had been given a box by the gods and instructed not to open it, but who disobeyed the instructions out of curiosity, releasing all manner of evils into the world.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) 55 Pandora, a main belt asteroid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pandora's box</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caja de Pandora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) A source of unforeseen trouble.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Panenka</ns0:orth>
      </ns0:form>
