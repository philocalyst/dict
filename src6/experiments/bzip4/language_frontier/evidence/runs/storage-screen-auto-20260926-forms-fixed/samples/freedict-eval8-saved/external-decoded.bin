      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>planeta X</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A hypothetical planet in the Solar system, beyond the currently known outermost planet. (The term was applied to Eris for a short while, when Pluto was still considered the ninth planet.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
