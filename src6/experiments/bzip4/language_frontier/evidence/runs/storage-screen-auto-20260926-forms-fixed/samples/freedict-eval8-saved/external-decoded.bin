          <ns0:quote>entornado</ns0:quote>
          <ns0:quote>entreajustado</ns0:quote>
          <ns0:quote>entrecerrado</ns0:quote>
          <ns0:quote>juntado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Slightly turned or opened.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ajar</ns0:orth>
        <ns0:pron>/əˈd͡ʒɑɹ/</ns0:pron>
