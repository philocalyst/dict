        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sinai</ns0:orth>
        <ns0:pron>/ˈsaɪˌnaɪ/</ns0:pron>
        <ns0:pron>/ˈsiˌnaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sinaí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula in eastern Egypt, and the only part of the country located in Asia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A mountain in Sinai Peninsula; the location where Moses is said to have received the Ten Commandments from God.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
