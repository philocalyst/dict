      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>capacitista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who exhibits ableism, or prejudice against the disabled.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ablution</ns0:orth>
        <ns0:pron>/əˈblu.ʃn̩/</ns0:pron>
        <ns0:pron>/əˈbluː.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ablución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of washing or cleansing the body, or some part of it, as a religious rite. [From mid 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Western, _, Christianity) The rinsing of the priest's hand and the sacred vessel following the Communion with, depending on rite, water or a mix of it and wine, which may then be drunk by the priest. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
