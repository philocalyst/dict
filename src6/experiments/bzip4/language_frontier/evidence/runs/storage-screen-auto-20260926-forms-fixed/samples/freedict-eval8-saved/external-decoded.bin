      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rapunzel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A German fairy tale about a girl imprisoned in a tower who lets down her long hair for a rescuer to climb.</ns0:def>
