      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Simón dice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(games) A children's game where players must carry out only those commands that are preceded by the utterance "Simon says".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
