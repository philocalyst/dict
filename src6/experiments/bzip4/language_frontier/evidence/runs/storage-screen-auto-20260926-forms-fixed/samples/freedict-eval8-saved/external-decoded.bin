      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>azimuth</ns0:orth>
        <ns0:pron>/ˈæzɪməθ/</ns0:pron>
      </ns0:form>
