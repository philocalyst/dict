          <ns0:quote>tiburón peregrino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very large shark, Cetorhinus maximus, that feeds at or close to the surface by filtering plankton from the water and is found in all the world's temperate oceans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basophil</ns0:orth>
        <ns0:pron>/ˈbeɪsəfɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basófilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cytology) Any cell that has granules stained by basic stains.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basophilic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basófilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Easily stained with basic dyes, such as haematoxylin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bass</ns0:orth>
        <ns0:pron>/beɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of sound, a voice or an instrument, low in pitch or frequency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
