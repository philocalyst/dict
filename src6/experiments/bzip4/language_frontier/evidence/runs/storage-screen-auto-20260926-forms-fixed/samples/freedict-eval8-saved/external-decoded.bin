          <ns0:quote>príncipe de Gales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A royal title given to the male heir apparent to the reigning monarch of the United Kingdom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
