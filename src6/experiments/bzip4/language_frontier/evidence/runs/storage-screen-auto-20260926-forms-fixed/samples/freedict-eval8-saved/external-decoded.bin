      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alack</ns0:orth>
        <ns0:pron>/əˈlæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ay</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expression of sorrow or mourning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alacrity</ns0:orth>
        <ns0:pron>/əˈlækɹɨti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alacridad</ns0:quote>
          <ns0:quote>esmero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Eagerness; liveliness; enthusiasm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alacridad</ns0:quote>
          <ns0:quote>presteza</ns0:quote>
          <ns0:quote>prontitud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Promptness; speed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alanine</ns0:orth>
        <ns0:pron>/ˈæləniːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alanina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(amino acid, uncountable) A nonessential amino acid 2-aminopropanoic acid found in most animal proteins</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alarm</ns0:orth>
        <ns0:pron>/əˈlɑ(rə)m/</ns0:pron>
        <ns0:pron>/əˈlɑɹm/</ns0:pron>
        <ns0:pron>/əˈlɑːm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alarma</ns0:quote>
          <ns0:quote>rebato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A summons to arms, as on the approach of an enemy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any sound or information intended to give notice of approaching danger; a warning sound to arouse attention; a warning of danger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alarma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sudden surprise with fear or terror excited by apprehension of danger; in the military use, commonly, sudden apprehension of being attacked by surprise.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An instance of an alarm ringing, beeping or clanging, to give a noise signal at a certain time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mechanical device for awaking people, or rousing their attention.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alarm</ns0:orth>
        <ns0:pron>/əˈlɑ(rə)m/</ns0:pron>
        <ns0:pron>/əˈlɑɹm/</ns0:pron>
        <ns0:pron>/əˈlɑːm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tocar a rebato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To call to arms for defense.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tocar a rebato</ns0:quote>
          <ns0:quote>alarmar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give (someone) notice of approaching danger or necessary action; to rouse to vigilance; to put on the alert.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To surprise with apprehension of danger; to fill with anxiety in regard to threatening evil; to excite with sudden fear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alarm clock</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despertador</ns0:quote>
          <ns0:quote>reloj despertador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A clock with an alarm that can be set to sound at a determined time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alarming</ns0:orth>
        <ns0:pron>/əˈlɑɹm.ɪŋ/</ns0:pron>
        <ns0:pron>/əˈlɑːm.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alarmante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing apprehension, fear or alarm; frightening.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alarmism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alarmismo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alarmist</ns0:orth>
        <ns0:pron>/əˈlɑɹmɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alarmista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who causes others to become alarmed without cause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alas</ns0:orth>
        <ns0:pron>/ɘˈlɛs/</ns0:pron>
        <ns0:pron>/əˈlæs/</ns0:pron>
        <ns0:pron>/əˈlɑːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ay</ns0:quote>
          <ns0:quote>aj</ns0:quote>
          <ns0:quote>ax</ns0:quote>
          <ns0:quote>ay de mí</ns0:quote>
          <ns0:quote>ay me</ns0:quote>
          <ns0:quote>aymé</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alatern</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aladierno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ornamental evergreen shrub (Rhamnus alaternus; Italian buckthorn).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alaunt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A domesticated dog of an extinct breed related to the modern bulldog and mastiff, or modern breeds created in imitation of it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alb</ns0:orth>
        <ns0:pron>/ælb/</ns0:pron>
        <ns0:pron>/ɑːlb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity, chiefly, _, Anglicanism, Roman Catholicism) A long, white robe worn by priests and other ministers, underneath most of the other vestments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albatross</ns0:orth>
        <ns0:pron>/ˈæl.bəˌtɹɑs/</ns0:pron>
        <ns0:pron>/ˈæl.bəˌtɹɒs/</ns0:pron>
        <ns0:pron>/ˈæl.bəˌtɹɔs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albatros</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various large seabirds of the family Diomedeidae ranging widely in the Southern Ocean and the North Pacific and having a hooked beak and long narrow wings.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(golf) A double eagle, or three under par on any one hole, except a par 3 hole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albedo</ns0:orth>
        <ns0:pron>/ælˈbi.doʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albedo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, meteorology, astronomy, optics) The fraction of incident light or radiation reflected by a surface or body, commonly expressed as a percentage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albédine</ns0:quote>
          <ns0:quote>albedo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The whitish inner portion of the rind of citrus fruits that is a source of pectin, commonly referred to as the pith.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albeit</ns0:orth>
        <ns0:pron>/ɑlˈbi.ɪt/</ns0:pron>
        <ns0:pron>/ɔlˈbi.ət/</ns0:pron>
        <ns0:pron>/ɔːlˈbiː.ɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aunque</ns0:quote>
          <ns0:quote>si bien</ns0:quote>
          <ns0:quote>aun cuando</ns0:quote>
          <ns0:quote>bien que</ns0:quote>
          <ns0:quote>no obstante</ns0:quote>
          <ns0:quote>pero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Although, despite (it) being.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albertosaurus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albertosaurio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large carnivorous tyrannosaur dinosaur, of genus Albertosaurus, discovered in Alberta, Canada.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albinism</ns0:orth>
        <ns0:pron>/ˈælbəˌnɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albinismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Congenital lack of melanin pigmentation in the skin, eyes, and hair or feathers (or more rarely only in the eyes); the condition of being albino.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albino</ns0:orth>
        <ns0:pron>/alˈbiːnoː/</ns0:pron>
        <ns0:pron>/ælˈbaɪnoʊ/</ns0:pron>
        <ns0:pron>/ælˈbiːnəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Congenitally lacking melanin pigmentation in the skin, eyes, and hair or feathers (or more rarely only in the eyes); born with albinism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albino</ns0:orth>
        <ns0:pron>/alˈbiːnoː/</ns0:pron>
        <ns0:pron>/ælˈbaɪnoʊ/</ns0:pron>
        <ns0:pron>/ælˈbiːnəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albino</ns0:quote>
          <ns0:quote>albina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A person or animal congenitally lacking melanin pigmentation in the skin, eyes, and hair or feathers (or more rarely only in the eyes); one born with albinism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A plagioclase feldspar, the first member of the Albite-Anorthite solid solution series.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>album</ns0:orth>
        <ns0:pron>/ˈælbəm/</ns0:pron>
        <ns0:pron>[ˈaɫb̚m̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>álbum</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A book specially designed to keep photographs, stamps, or autographs.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A phonograph record that is composed of several tracks</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A jacket or cover for such a phonograph record.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A group of audio recordings, on any medium, intended for distribution as a group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albumen</ns0:orth>
        <ns0:pron>/ælˈbjuːmən/</ns0:pron>
        <ns0:pron>/ˈalbjʊmɪn/</ns0:pron>
        <ns0:pron>/ˈælbjʊmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albumen</ns0:quote>
          <ns0:quote>clara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The white part of an egg; being mostly the protein albumin and water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albumin</ns0:orth>
        <ns0:pron>/ælˈbjuː.mən/</ns0:pron>
        <ns0:pron>/ˈalbjʊmɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albúmina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein) Any of a class of monomeric proteins that are soluble in water, and are coagulated by heat; they occur in egg white, milk etc; they function as carrier protein for steroids, fatty acids, and thyroid hormones and play a role in stabilizing extracellular fluid volume.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albuminemia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albuminemia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The (normal) presence of albumin in the blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albuminous</ns0:orth>
        <ns0:pron>/ælˈbjuː.mɪn.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albuminoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to, containing, or having the properties of albumen or albumin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>albuminuria</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albuminuria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The presence of albumin in the urine, often a symptom of renal disease</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcarraza</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcarraza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a jug, pitcher, etc. made of porous earthenware.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcazar</ns0:orth>
        <ns0:pron>/ælˈkɑzɚ/</ns0:pron>
        <ns0:pron>/ˌalkəˈzɑː/</ns0:pron>
        <ns0:pron>/ˌælkəˈzɑɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcázar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any Moorish fortress in Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alchemical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alquímico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(alchemy) Of or pertaining to the medieval chemical science and philosophy of alchemy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alchemist</ns0:orth>
        <ns0:pron>/ˈæl.kə.mɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alquimista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who practices alchemy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alchemy</ns0:orth>
        <ns0:pron>/ˈælkəmi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alquimia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The premodern and early modern study of physical changes, particularly in Europe, Arabia, and China; and chiefly in pursuit of an elixir of immortality, a universal panacea, and/or a philosopher's stone able to transmute base metals into gold, eventually developing into chemistry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The causing of any sort of mysterious sudden transmutation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcogel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohol gel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hand sanitizer in the form of an alcohol gel</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcohol</ns0:orth>
        <ns0:pron>/əlkɵˈhɔl/</ns0:pron>
        <ns0:pron>/ˈalkɵhɔl/</ns0:pron>
        <ns0:pron>/ˈæl.kə.hɑl/</ns0:pron>
        <ns0:pron>/ˈæl.kə.hɒl/</ns0:pron>
        <ns0:pron>/ˈæl.kə.hɔl/</ns0:pron>
        <ns0:pron>/ˈɑl-/</ns0:pron>
        <ns0:pron>/ˈɑl.kə.hɑl/</ns0:pron>
        <ns0:pron>/ˈɑl.kə.hɔl/</ns0:pron>
        <ns0:pron>;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound, countable) Any of a class of organic compounds (such as ethanol) containing a hydroxyl functional group (-OH).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) Beverages containing ethanol, collectively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcohol-free</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin alcohol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Containing no alcohol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholaemia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcoholemia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The presence of alcohol in the bloodstream</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholic</ns0:orth>
        <ns0:pron>/ˌæl.kəˈhɑ.lɪk/</ns0:pron>
        <ns0:pron>/ˌæl.kəˈhɒl.ɪk/</ns0:pron>
        <ns0:pron>/ˌæl.kəˈhɔ.lɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to alcohol.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having more than a trace amount of alcohol in its contents.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholic</ns0:orth>
        <ns0:pron>/ˌæl.kəˈhɑ.lɪk/</ns0:pron>
        <ns0:pron>/ˌæl.kəˈhɒl.ɪk/</ns0:pron>
        <ns0:pron>/ˌæl.kəˈhɔ.lɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohólico</ns0:quote>
          <ns0:quote>escabiador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is addicted to alcohol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohólico</ns0:quote>
          <ns0:quote>alcoholista</ns0:quote>
          <ns0:quote>escabiador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who abuses alcohol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholism</ns0:orth>
        <ns0:pron>/ˈælkə(ˌ)hɔˌlɪzəm/&lt;a:GenAm&gt;&lt;ref:{{R:Dictionary.com}}&lt;&lt;name:DC&gt;&gt; !!! {{R:MWO}}&lt;&lt;name:MWO&gt;&gt; !!! {{R:Collins}}&lt;&lt;name:Collins&gt;&gt; !!! {{R:Macmillan}}&lt;&lt;name:Macm&gt;&gt; !!! &lt;&lt;name:DC&gt;&gt; !!! &lt;&lt;name:Collins&gt;&gt;&gt;</ns0:pron>
        <ns0:pron>/ˈælkəhɒˌlɪzəm/</ns0:pron>
        <ns0:pron>/ˈælkəhɒˌlɪzəm/&lt;a:UK&gt;&lt;ref:&lt;&lt;name:Collins&gt;&gt; !!! &lt;&lt;name:Macm&gt;&gt; !!! {{R:Lexico}} !!! {{R:Cambridge}}&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcoholismo</ns0:quote>
          <ns0:quote>bebedera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A chronic disease caused by compulsive and uncontrollable consumption of alcoholic beverages, leading to addiction and deterioration in health and social functioning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcoholismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Acute alcohol poisoning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcoholizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To convert into alcohol by fermentation, or to increase the concentration of alcohol by rectification</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcohology</ns0:orth>
        <ns0:pron>/ˌælkəˈhɒlədʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sociology) The study of the effects of alcohol; on living organisms, people or social environments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholometer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcoholímetro</ns0:quote>
          <ns0:quote>alcohómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A specialized form of hydrometer used to measure the amount of alcohol in a liquid (such as beer).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcoholometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcoholimetría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The measurement of the concentration of alcohol in a liquid, especially in the blood</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alcove</ns0:orth>
        <ns0:pron>/ˈæl.koʊv/</ns0:pron>
        <ns0:pron>/ˈæl.kəʊv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hornacina</ns0:quote>
          <ns0:quote>hueco</ns0:quote>
          <ns0:quote>nicho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A small recessed area set off from a larger room.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldaric acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido aldárico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sugar acid) Any of a group of polyhydroxy dicarboxylic acids derived from an aldose by oxidation at both terminal carbon atoms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldehyde</ns0:orth>
        <ns0:pron>/ˈæl.dɪ.haɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldehído</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any of a large class of reactive organic compounds (R·CHO) having a carbonyl functional group attached to one hydrocarbon radical and a hydrogen atom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alder</ns0:orth>
        <ns0:pron>/ˈɑldɚ/</ns0:pron>
        <ns0:pron>/ˈɔldɚ/</ns0:pron>
        <ns0:pron>/ˈɔːldə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several trees or shrubs of the genus Alnus, belonging to the birch family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alder buckthorn</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arraclán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A deciduous shrub, Frangula alnus, native to Europe and neighboring areas of Asia and Africa, bearing glossy leaves, flowers in sessile umbels, and inedible red berries that turn black when ripe, and historically used as a laxative and to produce dyes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alderman</ns0:orth>
        <ns0:pron>/ˈoːldəmən/</ns0:pron>
        <ns0:pron>/ˈɑldəɹmən/</ns0:pron>
        <ns0:pron>/ˈɒl-/</ns0:pron>
        <ns0:pron>/ˈɒldəɹmən/</ns0:pron>
        <ns0:pron>/ˈɔldəɹmən/</ns0:pron>
        <ns0:pron>/ˈɔːldəmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concejal</ns0:quote>
          <ns0:quote>regidor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a municipal legislative body in a city or town.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldermanite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldermanita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) An orthorhombic colorless mineral containing aluminum, hydrogen, magnesium, oxygen, and phosphorus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alditol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alditol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of a class of acyclic polyols formally derived from an aldose by reduction of the carbonyl functional group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldolase</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldolasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(enzyme) An enzyme, present in some tissue, that catalyses the conversion of phosphates of fructose to those of glyceraldehyde and dihydroxyacetone</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldonic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the aldonic acids or their derivatives</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldonic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido aldónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sugar acid) Any of a class of polyhydroxy carboxylic acids derived from an aldose by oxidation of the aldehyde functional group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldopentose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldopentosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carbohydrate) A pentose that is also an aldose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry, carbohydrate) Any of a class of monosaccharides having an aldehyde or hemiacetal functional group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aldosterone</ns0:orth>
        <ns0:pron>/ælˈdɑstəˌɹoʊn/</ns0:pron>
        <ns0:pron>/ælˈdɒstəɹəʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aldosterona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(steroid hormone) A mineralocorticoid hormone, secreted by the adrenal cortex, that regulates the balance of sodium and potassium in the body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ale</ns0:orth>
        <ns0:pron>/eɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ale</ns0:quote>
          <ns0:quote>cerveza ale</ns0:quote>
          <ns0:quote>cerveza inglesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A beer produced by so-called warm fermentation and not pressurized.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aleatory</ns0:orth>
        <ns0:pron>/ˈeɪ.lɪ.ə.tɔ.ɹi/</ns0:pron>
        <ns0:pron>/ˈeɪ.lɪ.ə.tə.ɹi/</ns0:pron>
        <ns0:pron>/ˈæ.lɪ.ə.tɔ.ɹi/</ns0:pron>
        <ns0:pron>/ˈæ.lɪ.ə.tə.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aleatorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Depending on the throw of a die; random, arising by chance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alectryomancy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alectomancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of divination in which the diviner observes a bird or birds (preferably a white rooster or cockerel) pecking at grain that the diviner has scattered on the ground.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alembic</ns0:orth>
        <ns0:pron>/əˈlɛm.bɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alambique</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An early chemical apparatus, consisting of two retorts connected by a tube, used to purify substances by distillation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aleph</ns0:orth>
        <ns0:pron>/ˈɑˌlɛf/</ns0:pron>
        <ns0:pron>/ˈɑˌlɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>álef</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first letter of the Proto-Canaanite alphabet, and its descendants in descended Semitic scripts, such as Phoenician 𐤀 (ʾ, ʾaleph), Aramaic 𐡀 (ʾ), Classical Syriac ܐ ('ālaph), Hebrew א (aleph) and Arabic ا (ʾalif).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alert</ns0:orth>
        <ns0:pron>/əˈlɜːt/</ns0:pron>
        <ns0:pron>/əˈlɝt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alerta</ns0:quote>
          <ns0:quote>alerto</ns0:quote>
          <ns0:quote>vigilante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Attentive; awake; on guard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alert</ns0:orth>
        <ns0:pron>/əˈlɜːt/</ns0:pron>
        <ns0:pron>/əˈlɝt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alerta</ns0:quote>
          <ns0:quote>alarma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An alarm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alert</ns0:orth>
        <ns0:pron>/əˈlɜːt/</ns0:pron>
        <ns0:pron>/əˈlɝt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alertar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To give warning to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alertly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con listeza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an alert manner; with alertness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alertness</ns0:orth>
        <ns0:pron>/əˈlɝt.nəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vigilancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being alert or on the alert.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alevin</ns0:orth>
        <ns0:pron>/ˈæl.ə.vən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alevín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Newly hatched fish, especially salmon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alewife</ns0:orth>
        <ns0:pron>/ˈeɪlwʌɪf/</ns0:pron>
        <ns0:pron>/ˈeɪlˌwaɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cervecera</ns0:quote>
          <ns0:quote>tabernera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) A woman who keeps an alehouse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pinchagua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A migrating North American fish, Alosa pseudoharengus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alexandrine</ns0:orth>
        <ns0:pron>/ˌælɪkˈsændriːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alejandrino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(poetry) A line of poetic meter having twelve syllables, usually divided into two or three equal parts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alexandrite</ns0:orth>
        <ns0:pron>/ˌæl.ɪɡˈzæn.dɹaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alejandrita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A form of chrysoberyl that displays a colour change dependent upon the light source, along with strong pleochroism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alexipharmac</ns0:orth>
        <ns0:pron>/əˌlɛksəˈfɑɹmæk/</ns0:pron>
        <ns0:pron>/əˌlɛksɪˈfɑːmæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alexifármaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmacology, chiefly, archaic, or, historical) Of or pertaining to an alexipharmac; also, acting as an alexipharmac by protecting against or warding off the ill effects of a harmful substance, especially a poison or venom; alexipharmic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alexipharmac</ns0:orth>
        <ns0:pron>/əˌlɛksəˈfɑɹmæk/</ns0:pron>
        <ns0:pron>/əˌlɛksɪˈfɑːmæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alexifármaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmacology, chiefly, archaic, or, historical) A medical remedy for protecting the body, or an antidote, against a harmful substance, especially a poison or venom (specifically, that of a snake); an alexipharmic, an antidote.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alexithymia</ns0:orth>
        <ns0:pron>/eɪˌlɛk.səˈθaɪ.mi.ə/</ns0:pron>
        <ns0:pron>/əˌlɛk.sɪˈθaɪ.mi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alexitimia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A deficiency in understanding, processing, or describing emotions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alfalfa</ns0:orth>
        <ns0:pron>/ælˈfælfə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfalfa</ns0:quote>
          <ns0:quote>mielga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A plant, principally of Medicago sativa, grown as a pasture crop.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alfaqui</ns0:orth>
        <ns0:pron>/alfaˈkiː/</ns0:pron>
        <ns0:pron>/alfəˈkiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfaquí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) An Islamic cleric, an expert in Islamic law and jurisprudence, especially in medieval and early modern Spain. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alfiz</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfiz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) In Mozarabic architecture, moulding which encloses the outward side of an arch.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alga</ns0:orth>
        <ns0:pron>/ˈæl.ɡə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any of many aquatic photosynthetic organisms, including the seaweeds, whose size ranges from a single cell to giant kelps and whose biochemistry and forms are very diverse, some being eukaryotic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algal bloom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>proliferación de algas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dense spread of algae on the surface of water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebra</ns0:orth>
        <ns0:pron>/əlˈdʒibra/</ns0:pron>
        <ns0:pron>/ˈæl.dʒɪ.bɹə/</ns0:pron>
        <ns0:pron>/ˈæl.d͡ʒə.bɹə/</ns0:pron>
        <ns0:pron>/ˈæl.d͡ʒɪ.bɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>álgebra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, mathematics) Elementary algebra: A system for representing and manipulating unknown quantities (variables) in equations.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, mathematics, algebra) Any of several objects of study in Algebra</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, medicine, historical, rare) The surgical treatment of a dislocated or fractured bone. Also (countable) : a dislocation or fracture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraic</ns0:orth>
        <ns0:pron>/ˌæl.d͡ʒɪˈbɹeɪ.ɪk/</ns0:pron>
        <ns0:pron>/ˌæl.d͡ʒɪˈbɹæɪ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algebraico</ns0:quote>
          <ns0:quote>algébrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to, algebra.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraic analysis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análisis algebraico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebraic geometry, algebraic topology) The study of systems of linear partial differential equations, using techniques from sheaf theory and complex analysis to examine functions and certain generalisations of functions (such as hyperfunctions and microfunctions).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraic equation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ecuación algebraica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) A mathematical equation in which one or both sides is an algebraic expression, such as 2x + 7y = 3.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraic function</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>función algebraica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebraic geometry) Informally, any function expressible using (only) the operations of addition, subtraction, multiplication, division and raising to a rational power; more precisely, any continuous function definable as the root of some polynomial equation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraic geometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>geometría algebraica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) A branch of mathematics that studies algebraic varieties (solution sets of polynomial equations) and their generalisations, using techniques from both algebra (chiefly commutative algebra) and geometry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraic integer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>número entero algebraico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra, number theory) A real or complex number (more generally, an element of a number field) which is a root of a monic polynomial whose coefficients are integers; equivalently, an algebraic number whose minimal polynomial (lowest-degree polynomial of which it is a root and whose leading coefficient is 1) has integer coefficients.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraically</ns0:orth>
        <ns0:pron>/ˌæl.d͡ʒɪˈbɹeɪ.ɪ.kə.li/</ns0:pron>
        <ns0:pron>/ˌæl.d͡ʒɪˈbɹeɪ.ɪk.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algebraicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Using algebra.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraically closed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algebraicamente cerrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra, field theory, of a field) Which contains as an element every root of every nonconstant univariate polynomial definable over it (i.e., over said field).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algebraist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algebrista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mathematician who specializes in algebra.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algesia</ns0:orth>
        <ns0:pron>/-sɪə/</ns0:pron>
        <ns0:pron>/ælˈdʒiːzɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algesía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) sensitivity to pain</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algid</ns0:orth>
        <ns0:pron>/ˈæl.d͡ʒɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>álgido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Cold, chilly; used of low body temperature, especially in connection with certain diseases such as malaria and cholera.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algidity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algidez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The state of being algid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alginate</ns0:orth>
        <ns0:pron>/ˈæl.dʒɪ.neɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alginato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) Any salt or ester of alginic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algolagnia</ns0:orth>
        <ns0:pron>/alɡə(ʊ)ˈlaɡnɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algolagnia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A physical condition that causes a person to gain sexual pleasure by suffering pain, particularly to erogenous zones.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algologist</ns0:orth>
        <ns0:pron>/ælˈɡɒlədʒɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algólogo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who studies algology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algología</ns0:quote>
          <ns0:quote>ficología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of botany dealing with algae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algometer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument for measuring pain-inducing stimuli, and the sensitivity to such stimuli.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algometría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The scientific measurement of responses to pain stimuli.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algophilia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algofilia</ns0:quote>
          <ns0:quote>masoquismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>pleasure from experiencing pain, especially sexually.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algorithm</ns0:orth>
        <ns0:pron>/əlɡɵˈrɪd̪ʱm̩/</ns0:pron>
        <ns0:pron>/əlˈɡɔrɪd̪ʱm̩/</ns0:pron>
        <ns0:pron>/ˈælɡəɹɪðm̩/</ns0:pron>
        <ns0:pron>[ˈæɫɡəɹɪðm̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algoritmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A collection of ordered steps that solve a mathematical problem. A precise step-by-step plan for a computational procedure that possibly begins with an input value and yields an output value in a finite number of steps.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(loosely) A flowchart illustrating a decision-making process for human users, especially health care professionals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algorithmic</ns0:orth>
        <ns0:pron>/ˌælɡəˈɹɪðmɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algorítmico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, computing) Of, relating to, or being an algorithm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>algorithmization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algoritmización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of algorithmizing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alias</ns0:orth>
        <ns0:pron>/ˈeɪ.li.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>seudónimo</ns0:quote>
          <ns0:quote>alias</ns0:quote>
          <ns0:quote>sobrenombre</ns0:quote>
          <ns0:quote>apodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Another name; especially, an assumed name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alias</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) An abbreviation that replaces a string of commands and thereby reduces typing when performing routine actions or tasks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alibi</ns0:orth>
        <ns0:pron>/ˈæl.ə.baɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coartada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The plea or mode of defense under which a person on trial for a crime proves or attempts to prove being in another place when the alleged act was committed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excusa</ns0:quote>
          <ns0:quote>coartada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, proscribed) An excuse, especially one used to avoid responsibility or blame.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alien</ns0:orth>
        <ns0:pron>/ˈeɪ.li.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alienígena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not belonging to the same country, land, or government, or to the citizens or subjects thereof; foreign.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ajeno</ns0:quote>
          <ns0:quote>alienígeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Very unfamiliar, strange, or removed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alienígena</ns0:quote>
          <ns0:quote>extraterrestre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to extraterrestrial life; typical of an extraterrestrial creature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alien</ns0:orth>
        <ns0:pron>/ˈeɪ.li.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desconocido</ns0:quote>
          <ns0:quote>advena</ns0:quote>
          <ns0:quote>desconocida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person, animal, plant, or other thing which is from outside the family, group, organization, or territory under consideration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extranjero</ns0:quote>
          <ns0:quote>extranjera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, derogatory) A mischievous or suspicious foreigner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extraterrestre</ns0:quote>
          <ns0:quote>alienígena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any life form of extraterrestrial or extradimensional origin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alienate</ns0:orth>
        <ns0:pron>/ˈeɪ.li.ə.neɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enajenar</ns0:quote>
          <ns0:quote>alienar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To convey or transfer to another, as title, property, or right; to part voluntarily with ownership of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alienar</ns0:quote>
          <ns0:quote>enajenar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To cause one to feel unable to relate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alienated</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alienado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Isolated; excluded; estranged.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alienation</ns0:orth>
        <ns0:pron>/ˌeɪli.əˈneɪʃən/</ns0:pron>
        <ns0:pron>/ˌeɪljəˈneɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alienación</ns0:quote>
          <ns0:quote>enajenación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being alienated.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Emotional isolation or dissociation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Marxism) The estrangement of people from aspects of their human nature as a consequence of the division of labour and living in a society of stratified social classes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enajenación</ns0:quote>
          <ns0:quote>alienación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(property law) The transfer of property to another person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alight</ns0:orth>
        <ns0:pron>/əˈlaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apearse</ns0:quote>
          <ns0:quote>bajarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Often followed by from or off: to get off an animal which one has been riding; to dismount; to descend or exit from a vehicle; hence, to complete one's journey; to stop.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aterrizar</ns0:quote>
          <ns0:quote>posarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(also, figuratively) Often followed by at, on, or upon: of something aloft: to descend and settle; to land, to lodge, to rest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>align</ns0:orth>
        <ns0:pron>/æˈlaɪn/</ns0:pron>
        <ns0:pron>/əˈlaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alinear</ns0:quote>
          <ns0:quote>adherirse</ns0:quote>
          <ns0:quote>alinearse</ns0:quote>
          <ns0:quote>ingresar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To adjust to a line; to range or form in line; to bring into line.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adherirse</ns0:quote>
          <ns0:quote>alinearse</ns0:quote>
          <ns0:quote>ingresar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, reflexive) To identify (oneself) with, match, or support the behaviour, thoughts, etc. of another person, organization, or country.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, computing) To store (data) in a way that is consistent with the memory architecture, i.e. by beginning each item at an offset equal to some multiple of the word size.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alinear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, bioinformatics) To organize a linear arrangement of DNA, RNA, or protein sequences which have regions of similarity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alignment</ns0:orth>
        <ns0:pron>/əˈlaɪn.mənt/</ns0:pron>
        <ns0:pron>/əˈlɑen.mənt/</ns0:pron>
        <ns0:pron>[əˈlɑe̯n.mənt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alineación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An arrangement of items in a line.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alineamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of adjusting a mechanism such that its parts are aligned; the condition of having its parts so adjusted.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(bioinformatics) A way of arranging DNA, RNA or protein sequences in order to identify regions of similarity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aligot</ns0:orth>
        <ns0:pron>/æ.li.ɡoʊ/</ns0:pron>
        <ns0:pron>/ɑ.li.ɡoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aligot</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dish traditionally made in the south of Auvergne from melted Tomme cheese blended into mashed potatoes, often with garlic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alike</ns0:orth>
        <ns0:pron>/əˈlaɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>semejante</ns0:quote>
          <ns0:quote>parecido</ns0:quote>
          <ns0:quote>igual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having resemblance or similitude; similar; without difference.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alike</ns0:orth>
        <ns0:pron>/əˈlaɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>igualmente</ns0:quote>
          <ns0:quote>de la misma manera</ns0:quote>
          <ns0:quote>por igual</ns0:quote>
          <ns0:quote>similarmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the same manner, form, or degree; in common; equally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alim</ns0:orth>
        <ns0:pron>/ˈɑːlɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ulema</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An educated scholar of Islamic law; a member of the ulema class</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alimentary</ns0:orth>
        <ns0:pron>/ˌælɪˈmɛnt(ə)ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alimentario</ns0:quote>
          <ns0:quote>alimenticio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to food, nutrition or digestion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alimony</ns0:orth>
        <ns0:pron>/ˈæl.ə.moʊ.ni/</ns0:pron>
        <ns0:pron>/ˈæl.ɪ.mə.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pensión alimenticia</ns0:quote>
          <ns0:quote>alimentos</ns0:quote>
          <ns0:quote>manutención</ns0:quote>
          <ns0:quote>mantención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal, sometimes, pejorative) A court-mandated allowance made to a former spouse by a divorced or legally separated person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aliphatic</ns0:orth>
        <ns0:pron>/ælɪˈfætɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alifático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Of a class of organic compounds in which the carbon atoms are arranged in an open chain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aliquot</ns0:orth>
        <ns0:pron>/ˈæl.ɪ.kwɑt/</ns0:pron>
        <ns0:pron>/ˈæl.ɪ.kwɒt/</ns0:pron>
        <ns0:pron>/ˈæl.ɪ.kwɔt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alícuota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Contained in the whole an integral number of times, a factor or divisor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aliquot</ns0:orth>
        <ns0:pron>/ˈæl.ɪ.kwɑt/</ns0:pron>
        <ns0:pron>/ˈæl.ɪ.kwɒt/</ns0:pron>
        <ns0:pron>/ˈæl.ɪ.kwɔt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alícuota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry, biotechnology, broadly) A portion of a total amount (of some substance or a sample or specimen thereof, usually a solution or suspension).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aliturgical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alitúrgico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a day in the Christian calendar) On which the Eucharist is not offered.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alive</ns0:orth>
        <ns0:pron>/əˈlaɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vivo</ns0:quote>
          <ns0:quote>viviente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having life; living; not dead.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alive and kicking</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vivito y coleando</ns0:quote>
          <ns0:quote>vivo y coleando</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Healthy; vital; in good health, particularly in opposition to unfavorable circumstances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aliyah</ns0:orth>
        <ns0:pron>/əliːˈjɑː/</ns0:pron>
        <ns0:pron>/əˈliːjə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliyá</ns0:quote>
          <ns0:quote>aliá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) One of the major waves of immigration of Jews to Israel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aljamiado</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aljamiado</ns0:quote>
          <ns0:quote>aljamía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Text of non-Semitic languages, especially European languages, written in Arabic letters.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkali</ns0:orth>
        <ns0:pron>/-laj/</ns0:pron>
        <ns0:pron>/əlkəˈli/</ns0:pron>
        <ns0:pron>/ˈalkəli/</ns0:pron>
        <ns0:pron>/ˈæl.kəˌlaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>álcali</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) One of a class of caustic bases, such as soda, soda ash, caustic soda, potash, ammonia, and lithia, whose distinguishing characteristics are dissolving in alcohol and water, uniting with oils and fats to form soap, neutralizing and forming salts with acids, turning to brown several vegetable yellows, and changing reddened litmus to blue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkalimeter</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcalímetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device used to measure alkalinity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkalimetry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcalimetría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of determining the strength of an alkali.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkaline</ns0:orth>
        <ns0:pron>/ˈæl.kə.laɪn/</ns0:pron>
        <ns0:pron>/ˈæl.kəl.aɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcalino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to an alkali, one of a class of caustic bases.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chemistry) Having a pH greater than 7.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkaline earth metal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>metal alcalinotérreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic chemistry) Any of the elements of group II of the periodic table; they are low-density metals that react readily with water to form strongly basic hydroxides, and with many acids to form salts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkaline glaze</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vidriado alcalino</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkalinity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcalinidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) The state of being, or the degree to which a thing is, alkaline.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkalinize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcalinizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To convert, or be converted, to an alkali</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkaloid</ns0:orth>
        <ns0:pron>/ˈæl.kə.lɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcaloide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of many organic (often heterocyclic) bases that occur in nature and often have medicinal properties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkalosis</ns0:orth>
        <ns0:pron>/æl.kəˈləʊ̯sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcalosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abnormally increased alkalinity in the blood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkane</ns0:orth>
        <ns0:pron>/ˈæl.keɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any acyclic saturated hydrocarbon (methane, ethane, etc.).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkanet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>orcaneta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Alkanna tinctoria, a plant whose root is used as a red dye.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The dyeing matter extracted from the roots of the plant with water or oil, used for cotton especially but also silk and wool, giving a deep red colour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkene</ns0:orth>
        <ns0:pron>/ælˈkʰin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alqueno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) An unsaturated, aliphatic hydrocarbon with one or more carbon–carbon double bonds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkoxide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcóxido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any organic compound derived from an alcohol by replacement of a hydrogen atom with a metal or other cationic species</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkyl</ns0:orth>
        <ns0:pron>/ˈælkaɪl/</ns0:pron>
        <ns0:pron>/ˈælkɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alquilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of a series of univalent radicals of the general formula CnH2n+1 derived from aliphatic hydrocarbons. In other words, an alkane minus one hydrogen atom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alkyne</ns0:orth>
        <ns0:pron>/ælˈkʰaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alquino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A hydrocarbon containing at least one carbon–carbon triple bond.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all</ns0:orth>
        <ns0:pron>/aːl/</ns0:pron>
        <ns0:pron>/oːl/</ns0:pron>
        <ns0:pron>/u(ɫ)/</ns0:pron>
        <ns0:pron>/ɑl/</ns0:pron>
        <ns0:pron>/ɒl/</ns0:pron>
        <ns0:pron>/ɔl/</ns0:pron>
        <ns0:pron>/ɔːl/</ns0:pron>
        <ns0:pron>[oːɫ]</ns0:pron>
        <ns0:pron>[ɑɫ]</ns0:pron>
        <ns0:pron>[ɒɫ]</ns0:pron>
        <ns0:pron>[ɔɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intensifier, sometimes, _, childish) Wholly; entirely; completely; totally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all</ns0:orth>
        <ns0:pron>/aːl/</ns0:pron>
        <ns0:pron>/oːl/</ns0:pron>
        <ns0:pron>/u(ɫ)/</ns0:pron>
        <ns0:pron>/ɑl/</ns0:pron>
        <ns0:pron>/ɒl/</ns0:pron>
        <ns0:pron>/ɔl/</ns0:pron>
        <ns0:pron>/ɔːl/</ns0:pron>
        <ns0:pron>[oːɫ]</ns0:pron>
        <ns0:pron>[ɑɫ]</ns0:pron>
        <ns0:pron>[ɒɫ]</ns0:pron>
        <ns0:pron>[ɔɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>determiner</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todos</ns0:quote>
          <ns0:quote>todas</ns0:quote>
          <ns0:quote>todo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Every individual or anything of the given class, with no exceptions (the noun or noun phrase denoting the class must be plural or uncountable).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo</ns0:quote>
          <ns0:quote>toda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Throughout the whole of (a stated period of time; generally used with units of a day or longer).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all</ns0:orth>
        <ns0:pron>/aːl/</ns0:pron>
        <ns0:pron>/oːl/</ns0:pron>
        <ns0:pron>/u(ɫ)/</ns0:pron>
        <ns0:pron>/ɑl/</ns0:pron>
        <ns0:pron>/ɒl/</ns0:pron>
        <ns0:pron>/ɔl/</ns0:pron>
        <ns0:pron>/ɔːl/</ns0:pron>
        <ns0:pron>[oːɫ]</ns0:pron>
        <ns0:pron>[ɑɫ]</ns0:pron>
        <ns0:pron>[ɒɫ]</ns0:pron>
        <ns0:pron>[ɔɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(with a possessive pronoun) Everything that one is capable of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all along</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desde el inicio</ns0:quote>
          <ns0:quote>todo el tiempo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(duration, idiomatic) For the entire time; always.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all and sundry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>los cuatro vientos</ns0:quote>
          <ns0:quote>propios y extraños</ns0:quote>
          <ns0:quote>todo el mundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(collectively) All; everyone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all bark and no bite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>irse la fuerza por la boca</ns0:quote>
          <ns0:quote>ladra pero no muerde</ns0:quote>
          <ns0:quote>mucho ruido y pocas nueces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Full of big talk but lacking action, power, or substance; pretentious.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perro ladrador, poco mordedor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Often making cutting remarks, but having a gentle personality underneath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all but</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>casi</ns0:quote>
          <ns0:quote>casi por</ns0:quote>
          <ns0:quote>casi por completo</ns0:quote>
          <ns0:quote>prácticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Very nearly; everything short of. Most often precedes a verb or adjective.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all caps</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mayúsculas sostenidas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(typography) Text or a font in which all letters are capitalised.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all cats are grey in the dark</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de noche todos los gatos son pardos</ns0:quote>
          <ns0:quote>a la luz de la vela, no hay mujer fea</ns0:quote>
          <ns0:quote>en tiempos de guerra cualquier agujero es trinchera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK, sometimes, _, vulgar, _, &amp;, _) Sex is enjoyable regardless of the physical attractiveness or social station of one's partner.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncommon) Under some circumstances, individual distinctions are not relevant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo el día</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>For the period of an entire day, or at least during all the daytime of a day.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all ears</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo oídos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Listening intently; fully focused.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escucho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Awaiting an explanation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all good</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo bien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Is everything alright? You ok? You fine with that?</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all hands on deck</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todos manos a la obra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) An order, on board ship, for all seamen of all watches to muster on deck immediately; normally shortened to "All hands"</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all hell breaks loose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>se arma la gorda</ns0:quote>
          <ns0:quote>todo se fue al demonio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) The situation becomes chaotic or characterized by conflict or rage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all in</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>completamente comprometido</ns0:quote>
          <ns0:quote>sumamente involucrado</ns0:quote>
          <ns0:quote>totalmente entregado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Totally committed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all in a day's work</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gajes del empleo</ns0:quote>
          <ns0:quote>gajes del oficio</ns0:quote>
          <ns0:quote>pan nuestro de cada día</ns0:quote>
          <ns0:quote>todo en un jornal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A nonchalant dismissal of a significant accomplishment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all in good time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la corta o a la larga, el tiempo todo lo alcanza</ns0:quote>
          <ns0:quote>todo a su tiempo</ns0:quote>
          <ns0:quote>todo se andará</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(as a set phrase) One should be patient.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all kidding aside</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bromas aparte</ns0:quote>
          <ns0:quote>en serio</ns0:quote>
          <ns0:quote>fuera de joda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(speech act, idiomatic) Used to attempt to state a serious point in a jocular conversation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all of a sudden</ns0:orth>
        <ns0:pron>/ˌɔl əv ə ˈsʌdən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de golpe</ns0:quote>
          <ns0:quote>de repente</ns0:quote>
          <ns0:quote>al primer envite</ns0:quote>
          <ns0:quote>de buenas a primeras</ns0:quote>
          <ns0:quote>de golpe y porrazo</ns0:quote>
          <ns0:quote>de pronto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set phrase, colloquial) Suddenly, quickly, without warning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all one word</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>junto</ns0:quote>
          <ns0:quote>todo junto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>written in a single word.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a todo pasto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) With maximum effort.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all over bar the shouting</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>visto para sentencia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all over the place</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a diestra y siniestra</ns0:quote>
          <ns0:quote>a diestro y siniestro</ns0:quote>
          <ns0:quote>por doquier</ns0:quote>
          <ns0:quote>por doquiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) In multiple directions or locations, often haphazardly; everywhere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desconcentrado</ns0:quote>
          <ns0:quote>desenfocado</ns0:quote>
          <ns0:quote>desperdigado</ns0:quote>
          <ns0:quote>perdido</ns0:quote>
          <ns0:quote>perdis</ns0:quote>
          <ns0:quote>por doquier</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Inconsistent; lacking a clear pattern; with a large amount of variation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all right</ns0:orth>
        <ns0:pron>/ˌɑlˈɹaɪt/</ns0:pron>
        <ns0:pron>/ˌɔlˈɹaɪt/</ns0:pron>
        <ns0:pron>/ˌɔːlˈɹaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In good health, unharmed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all right</ns0:orth>
        <ns0:pron>/ˌɑlˈɹaɪt/</ns0:pron>
        <ns0:pron>/ˌɔlˈɹaɪt/</ns0:pron>
        <ns0:pron>/ˌɔːlˈɹaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de acuerdo</ns0:quote>
          <ns0:quote>okey</ns0:quote>
          <ns0:quote>vale</ns0:quote>
          <ns0:quote>'tá</ns0:quote>
          <ns0:quote>dale</ns0:quote>
          <ns0:quote>listo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to affirm, indicate agreement, or consent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to fill space or pauses.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Used as a general lead-in or beginning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all rights reserved</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todos los derechos reservados</ns0:quote>
          <ns0:quote>reservados todos los derechos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, legal) The copyright holder of a creative work reserves all copyright-related rights, typically including the right to publish the work, to make derivative works of it, to distribute it, to make profit from it, to license a number of these rights to other people, and to forbid these uses by any unauthorized people, thus being entitled to take legal action against infringement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all roads lead to Rome</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todos los caminos llevan a Roma</ns0:quote>
          <ns0:quote>todos los caminos conducen a Roma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Different paths can take one to the same goal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all talk and no action</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mucho hablar y poco hacer</ns0:quote>
          <ns0:quote>mucho lerele y poco larala</ns0:quote>
          <ns0:quote>mucho ruido y pocas nueces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Speaking, promising, or boasting much, but doing little; overpromising, but underdelivering.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all that glitters is not gold</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no es oro todo lo que reluce</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Things that appear valuable or worthwhile might not actually be so; things that appear nice might not be as good as they appear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all the more</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>muchísimo más</ns0:quote>
          <ns0:quote>más, si cabe</ns0:quote>
          <ns0:quote>máxime</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Even more; notably, but even more notably in light of additional information, either preceding or following the statement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all the rage</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>último grito</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all the tea in China</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo el oro en el mundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, hyperbole) Something very valuable or priceless.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all the time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo el tiempo</ns0:quote>
          <ns0:quote>en todo momento</ns0:quote>
          <ns0:quote>todo el rato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set phrase, duration) Always; constantly; for the complete duration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a cada rato</ns0:quote>
          <ns0:quote>a cada segundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(set phrase, frequency) Very often; frequently.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all things being equal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en igualdad de circunstancias</ns0:quote>
          <ns0:quote>permaneciendo invariables los demás datos</ns0:quote>
          <ns0:quote>si todo sigue igual</ns0:quote>
          <ns0:quote>siempre que las demás condiciones no varíen</ns0:quote>
          <ns0:quote>siendo todo lo demás igual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without considering or being affected by external factors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all things considered</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bien mirado</ns0:quote>
          <ns0:quote>considerando / considerándolo todo</ns0:quote>
          <ns0:quote>en definitiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Generally speaking; in terms of the big picture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all told</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo dicho</ns0:quote>
          <ns0:quote>todos contados</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all's fair in love and war</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en la guerra y en el amor todo vale</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Unpleasant behavior is acceptable during love and conflict.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all's well that ends well</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bien está lo que bien acaba</ns0:quote>
          <ns0:quote>a buen fin no hay mal principio</ns0:quote>
          <ns0:quote>a buen fin no hay mal tiempo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A happy ending makes up for everything that has happened before.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-clear</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fin de la alerta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sign or signal indicating that a hindrance or danger is clear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-embracing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>omniabarcador</ns0:quote>
          <ns0:quote>omniabarcante</ns0:quote>
          <ns0:quote>omnicomprensivo</ns0:quote>
          <ns0:quote>omnienglobante</ns0:quote>
          <ns0:quote>omnímodo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-encompassing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>omniabarcador</ns0:quote>
          <ns0:quote>omniabarcante</ns0:quote>
          <ns0:quote>omnicomprensivo</ns0:quote>
          <ns0:quote>omnienglobante</ns0:quote>
          <ns0:quote>omnímodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Including everything; universal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-or-nothing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todo o nada</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de órdago</ns0:quote>
          <ns0:quote>sin cuartel</ns0:quote>
          <ns0:quote>total</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Using every available means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comprensivo</ns0:quote>
          <ns0:quote>holístico</ns0:quote>
          <ns0:quote>íntegro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Covering all aspects without exception.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a rompe y raja</ns0:quote>
          <ns0:quote>a toda leche</ns0:quote>
          <ns0:quote>a todo meter</ns0:quote>
          <ns0:quote>a todo trapo</ns0:quote>
          <ns0:quote>a todo tren</ns0:quote>
          <ns0:quote>a todo vapor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Alternative form of all out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-purpose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plurivalente</ns0:quote>
          <ns0:quote>polivalente</ns0:quote>
          <ns0:quote>todopropósito</ns0:quote>
          <ns0:quote>universal</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-rounder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>multitalento</ns0:quote>
          <ns0:quote>persona plurivalente</ns0:quote>
          <ns0:quote>persona polifacética</ns0:quote>
          <ns0:quote>persona polivalente</ns0:quote>
          <ns0:quote>persona versátil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, British) A versatile person, able to do many things well; used especially in reference to being good at various sports. [from 1875]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(cricket) A player who is skilled in both batting and bowling.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-terrain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>todoterreno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Suited to various types of terrain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vitalicio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-wheel drive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tracción a todas las ruedas</ns0:quote>
          <ns0:quote>tracción de todas las siendo motrices</ns0:quote>
          <ns0:quote>tracción en todas las ruedas</ns0:quote>
          <ns0:quote>tracción integral</ns0:quote>
          <ns0:quote>tracción total</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wheeled vehicle with a drivetrain that allows all wheels to receive torque from the engine simultaneously, particularly where power is directed to the wheels with the best contact with the ground.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>all-you-can-eat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>libre</ns0:quote>
          <ns0:quote>tenedor libre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literally) Offering unlimited food to a diner at a restaurant for a fixed price for as long as the diner continues to eat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allantoid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alantoideo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, chiefly, mycology) Sausage-shaped; especially with reference to fungal spores that are long with rounded ends. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allantoin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alantoína</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A diureide of glyoxylic acid, used in various pharmaceutical and cosmetic products; or a derivative of this compound</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allative</ns0:orth>
        <ns0:pron>/ˈælətɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alativo</ns0:quote>
          <ns0:quote>adlativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) The allative case, or a word in that case.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allative case</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caso alativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammatical case) A case used to indicate movement onto, or to the adjacency of something. In English, this is usually expressed by the prepositions to or onto, as in "to the house," "onto the house." Languages that use the allative case include Basque, Dyirbal, Estonian, Finnish, Hungarian, and Lithuanian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allay</ns0:orth>
        <ns0:pron>/əˈleɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calmar</ns0:quote>
          <ns0:quote>aquietar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make quiet or put at rest; to pacify or appease; to quell; to calm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliviar</ns0:quote>
          <ns0:quote>mitigar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To alleviate; to abate; to mitigate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegation</ns0:orth>
        <ns0:pron>/ˌæl.əˈɡeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæl.ɪˈɡeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæl.ɪˈɡæɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegación</ns0:quote>
          <ns0:quote>acusación</ns0:quote>
          <ns0:quote>alegato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An assertion, especially an accusation, not necessarily based on facts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allege</ns0:orth>
        <ns0:pron>/əˈlɛd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete, transitive) To state under oath, to plead.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To adduce (something) as a reason, excuse, support etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegar</ns0:quote>
          <ns0:quote>afirmar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make a claim as justification or proof; to make an assertion without proof.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alleged</ns0:orth>
        <ns0:pron>/əˈlɛdʒd/</ns0:pron>
        <ns0:pron>/əˈlɛdʒɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>supuesto</ns0:quote>
          <ns0:quote>alegado</ns0:quote>
          <ns0:quote>asertado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Asserted but not proved.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>supuesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Supposed but doubtful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegedly</ns0:orth>
        <ns0:pron>/əˈlɛdʒ.ɪd.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>supuestamente</ns0:quote>
          <ns0:quote>alegadamente</ns0:quote>
          <ns0:quote>dizque</ns0:quote>
          <ns0:quote>presuntamente</ns0:quote>
          <ns0:quote>pretendidamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>According to someone's allegation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegiance</ns0:orth>
        <ns0:pron>/əˈliː.d͡ʒəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lealtad</ns0:quote>
          <ns0:quote>fidelidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Loyalty to some cause, nation or ruler.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegorical</ns0:orth>
        <ns0:pron>/ˌæl.ɪˈɡɔɹ.ɪ.kəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegórico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of, relating to, or containing allegory</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegorically</ns0:orth>
        <ns0:pron>/æl.əˈɡɒɹ.ɪk.(ə.)li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegóricamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an allegorical manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegory</ns0:orth>
        <ns0:pron>/ˈæləˌɡɔɹi/</ns0:pron>
        <ns0:pron>/ˈælɪɡəɹi/</ns0:pron>
        <ns0:pron>/ˈælɪɡɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegoría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, rhetoric) The use of symbols which may be interpreted to reveal a hidden, broader message, usually a moral or political one, about real-world issues and occurrences; also, the interpretation of such symbols.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A picture, story, or other form of communication in which one or more characters, events, or places are used to reveal a hidden, broader message about real-world issues and occurrences.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allegro</ns0:orth>
        <ns0:pron>/əˈleɪɡɹoʊ/</ns0:pron>
        <ns0:pron>/əˈlɛɡɹoʊ/&lt;a:US&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alegro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A tempo mark directing that a passage is to be played in a quick, lively tempo, faster than allegretto but slower than presto.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allele</ns0:orth>
        <ns0:pron>/əˈliːl/</ns0:pron>
        <ns0:pron>/ˈæl.iːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alelo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetics) One of a number of alternative forms of the same gene occupying a given position, or locus, on a chromosome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allelic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alélico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to alleles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alleluia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aleluya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A liturgical form of hallelujah.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allene</ns0:orth>
        <ns0:pron>/ˈæliːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aleno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of a class of hydrocarbons having two double bonds from one carbon atom to two others - R2C=C=CR2; especially the parent compound CH2=C=CH2 (propadiene).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any derivative of such hydrocarbons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allergen</ns0:orth>
        <ns0:pron>/ˈælə(ɹ)ˌd͡ʒɛn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alérgeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A substance which causes an allergic reaction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allergic</ns0:orth>
        <ns0:pron>/aˈlɜ(r)dʒɪk/</ns0:pron>
        <ns0:pron>/əˈlɜː.dʒɪk/</ns0:pron>
        <ns0:pron>/əˈlɝ.d͡ʒɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alérgico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to allergy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having an allergy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative, humorous) Highly averse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allergic rhinitis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rinitis alérgica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology, immunology) A group of symptoms similar to those of a cold such as runny nose and sore throat, caused by an allergic reaction to an allergen such as dust, plant pollens or animal dander.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allergology</ns0:orth>
        <ns0:pron>/ˌæ.ləɹˈd͡ʒɑ.le.d͡ʒi/</ns0:pron>
        <ns0:pron>/ˌæ.ləɹˈɡɑ.le.d͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alergología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The study of the causes and treatment of allergies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allergy</ns0:orth>
        <ns0:pron>/əˈlɜ(ɾ)dʒi/</ns0:pron>
        <ns0:pron>/ˈæl.əɹ.d͡ʒi/</ns0:pron>
        <ns0:pron>[ˈæl.ə.dʒi]</ns0:pron>
        <ns0:pron>[ˈæl.ɚ.d͡ʒi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alergia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, immunology, broadly) A disorder of the immune system causing adverse reactions to substances (allergens) not harmful to most and marked by the body's production of histamines and associated with atopy, anaphylaxis, and asthma; any condition of hypersensitivity to a substance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine, immunology, strictly) Specifically, hypersensitivity of class I in the modern classification thereof: the immunoglobulin E–mediated type.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(informal, figuratively) An antipathy, as toward a person or activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alleviate</ns0:orth>
        <ns0:pron>/əˈli.vi.eɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliviar</ns0:quote>
          <ns0:quote>mitigar</ns0:quote>
          <ns0:quote>paliar</ns0:quote>
          <ns0:quote>aleviar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To reduce or lessen the severity of a pain or difficulty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alleviation</ns0:orth>
        <ns0:pron>/əˌliːviˈeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliviamiento</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alley</ns0:orth>
        <ns0:pron>/ˈæl.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calleja</ns0:quote>
          <ns0:quote>callejón</ns0:quote>
          <ns0:quote>callejuela</ns0:quote>
          <ns0:quote>callejo</ns0:quote>
          <ns0:quote>callizo</ns0:quote>
          <ns0:quote>esquinita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A narrow street or passageway, especially one through the middle of a block giving access to the rear of lots of buildings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alliance</ns0:orth>
        <ns0:pron>/əˈlaɪ.əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alianza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The state of being allied.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A union or connection of interests between families, states, parties, etc., especially between families by marriage and states by compact, treaty, or league.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Any union resembling that of families or states; union by relationship in qualities; affinity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(with the definite article) The persons or parties allied.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allicin</ns0:orth>
        <ns0:pron>/ˈælɪsən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alicina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) An organic compound, diallyl thiosulfinate, obtained from garlic, with a variety of medicinal and antibacterial properties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allied</ns0:orth>
        <ns0:pron>/əˈlaɪd/</ns0:pron>
        <ns0:pron>/ˈæl.aɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Joined as allies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alligator</ns0:orth>
        <ns0:pron>/ˈæl.ɪ.ɡeɪ.tə/</ns0:pron>
        <ns0:pron>/ˈæl.ɪ.ɡeɪ.tɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aligátor</ns0:quote>
          <ns0:quote>caimán</ns0:quote>
          <ns0:quote>aligator</ns0:quote>
          <ns0:quote>lagarto</ns0:quote>
          <ns0:quote>yacaré</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Either of two species of large amphibious reptile, Alligator mississippiensis or Alligator sinensis, in the genus Alligator within order Crocodilia, which have sharp teeth and very strong jaws and are native to the Americas and China, respectively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alliteration</ns0:orth>
        <ns0:pron>/əˌlɪtəˈɹeɪʃən/</ns0:pron>
        <ns0:pron>[əˌlɪɾəˈɹeɪʃən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliteración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The repetition of consonant sounds or letters at the beginning of two or more words immediately succeeding each other, or at short intervals; such repetition specifically involving stressed syllables.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allo-</ns0:orth>
        <ns0:pron>/æloʊ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Isomeric; especially, of amino acids having two chiral centres, the second diastereoisomer to be discovered or synthesized.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Different, distinct, or other with respect to the root.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allocatable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ubicable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) Able to be allocated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allocate</ns0:orth>
        <ns0:pron>/əlɵˈkeʈ/</ns0:pron>
        <ns0:pron>/ˈæl.ə.keɪt/</ns0:pron>
        <ns0:pron>/ˈæl.ə.kæɪt/</ns0:pron>
        <ns0:pron>/ˈæl.əˌkeɪt/</ns0:pron>
        <ns0:pron>/ˈɛl.ə.kæɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asignar</ns0:quote>
          <ns0:quote>adjudicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To set aside for a purpose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allocation</ns0:orth>
        <ns0:pron>/əlɵˈkeʃən/</ns0:pron>
        <ns0:pron>/ˌæl.əˈkeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæl.əˈkæɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌɛl.əˈkæɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asignación</ns0:quote>
          <ns0:quote>adjudicación</ns0:quote>
          <ns0:quote>distribución</ns0:quote>
          <ns0:quote>reparto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process or procedure for allocating things, especially money or other resources.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allochthonous</ns0:orth>
        <ns0:pron>/əˈlɒk.θə.nəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alóctono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Originating in a place other than where it is found.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geology) Buried or found in a place remote from the site of formation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allodial</ns0:orth>
        <ns0:pron>/əˈloʊ.di.əl/</ns0:pron>
        <ns0:pron>/əˈləʊ.di.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alodial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, historical) Pertaining to land owned by someone absolutely, without any feudal obligations; held without acknowledgement of any superior; allodial title. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allodium</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alodio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated, or, historical) Freehold land or property; land held in allodial tenure, or one's title to such land.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allogamy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alogamia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The fertilization of an ovum from one individual with the spermatozoa of another; cross-fertilization</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allograph</ns0:orth>
        <ns0:pron>/ˈæləɡɹæf/</ns0:pron>
        <ns0:pron>/ˈæləɡɹɑːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alógrafo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A variant form of a letter (or other grapheme).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allohistorical</ns0:orth>
        <ns0:pron>/alə(ʊ)ˌhɪˈstɒɹɪkəl/</ns0:pron>
        <ns0:pron>/æloʊ-/</ns0:pron>
        <ns0:pron>/æləˌhɪˈstɔːɹɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alohistórico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(narratology) Relating to alternate history, either as a discipline or genre, or as a specific counterfactual sequence of events.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allomorph</ns0:orth>
        <ns0:pron>/ˈæl.oʊ.mɔɹf/</ns0:pron>
        <ns0:pron>/ˈæl.ə.mɔɹf/</ns0:pron>
        <ns0:pron>/ˈæl.ə.mɔːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alomorfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) Any of the different phonological representations of a morpheme.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allomorphic</ns0:orth>
        <ns0:pron>/ˌæləˈmɔɹfɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alomórfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to allomorphism or to allomorphs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allopatric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alopátrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Not living in the same territory; geographically isolated and thus unable to crossbreed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allophone</ns0:orth>
        <ns0:pron>/ˈaləˌfəʊn/</ns0:pron>
        <ns0:pron>/ˈæləˌfoʊn/</ns0:pron>
        <ns0:pron>/ˈæləˌfəʉn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alófono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which is of a language other than that spoken by the majority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allophone</ns0:orth>
        <ns0:pron>/ˈaləˌfəʊn/</ns0:pron>
        <ns0:pron>/ˈæləˌfoʊn/</ns0:pron>
        <ns0:pron>/ˈæləˌfəʉn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alófono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonology) Any of two or more alternative pronunciations for a phoneme.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alófona</ns0:quote>
          <ns0:quote>alófono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person whose mother tongue is one other than that spoken by the majority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allophonic</ns0:orth>
        <ns0:pron>/ˌal.əˈfɒn.ɪk/</ns0:pron>
        <ns0:pron>/ˌæl.əˈfɑ.nɪk/</ns0:pron>
        <ns0:pron>/ˌæl.əˈfɔn.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alofónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an allophone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allosaurus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alosaurio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allose</ns0:orth>
        <ns0:pron>/ˈæləʊz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) An epimer of glucose found in some African shrubs</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allot</ns0:orth>
        <ns0:pron>/əˈlɑt/</ns0:pron>
        <ns0:pron>/əˈlɒt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>distribuir</ns0:quote>
          <ns0:quote>repartir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To distribute or apportion by (or as if by) lot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adjudicar</ns0:quote>
          <ns0:quote>asignar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To assign or designate as a task or for a purpose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allotment</ns0:orth>
        <ns0:pron>/əˈlɔt.mɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asignación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of allotting.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(legal) The allowance of a specific amount of money or other credit of a particular thing to a particular person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asignación</ns0:quote>
          <ns0:quote>reparto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something allotted; a share, part, or portion granted or distributed</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>huerto</ns0:quote>
          <ns0:quote>huerto urbano</ns0:quote>
          <ns0:quote>parcela de cultivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(British) A plot of land rented from the council for growing fruit and vegetables.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allotrope</ns0:orth>
        <ns0:pron>/ˈæ.lə.tɹəʊp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alótropo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Any form of an element that has a distinctly different molecular structure to another form of the same element, with different physical properties and often different chemical properties. [from 1847]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allotropic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alotrópico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Describing a form of an element that exhibits allotropy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allotropy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alotropía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) A property, exhibited by some elements, of existing in multiple forms with different atomic structures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allow</ns0:orth>
        <ns0:pron>/əˈlaʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>permitir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, catenative) To permit, to give permission to.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To not bar or obstruct.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>permitir</ns0:quote>
          <ns0:quote>dejar</ns0:quote>
          <ns0:quote>conceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To acknowledge, accept the truth of; to concede; to accede to an opinion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To praise; to approve of; hence, to sanction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allowance</ns0:orth>
        <ns0:pron>/əˈlaʊəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asignación</ns0:quote>
          <ns0:quote>mesada</ns0:quote>
          <ns0:quote>pitanza</ns0:quote>
          <ns0:quote>propina</ns0:quote>
          <ns0:quote>viático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An amount, portion, or share that is allotted or granted; a sum granted as a reimbursement, a bounty, or as appropriate for any purpose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>paga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Abatement; deduction; the taking into account of mitigating circumstances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allowed</ns0:orth>
        <ns0:pron>/əˈlaʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>permitido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Permitted, authorized. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alloy</ns0:orth>
        <ns0:pron>/əˈlɔɪ/</ns0:pron>
        <ns0:pron>/ˈæ.lɔɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aleación</ns0:quote>
          <ns0:quote>liga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A metal that is a combination of two or more elements, at least one of which is a metal, a base metal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allspice</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pimienta de Jamaica</ns0:quote>
          <ns0:quote>malagueta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A spice; the dried and ground unripe fruit of Pimenta dioica, thought to combine the flavours of several spices, such as cinnamon, nutmeg and cloves.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allude</ns0:orth>
        <ns0:pron>/əˈljuːd/</ns0:pron>
        <ns0:pron>/əˈlud/</ns0:pron>
        <ns0:pron>/əˈluːd/</ns0:pron>
        <ns0:pron>/əˈlʉːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aludir</ns0:quote>
          <ns0:quote>referirse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To refer to something indirectly or by suggestion; to invoke it by implication rather than mention.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
