        <ns0:sense>
          <ns0:def>The dialects of the English language spoken in the Caribbean islands, and most countries on the Caribbean coasts of Central America, and South America, including Belize and Guyana.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
