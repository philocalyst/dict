      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Polinesia Francesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An archipelago and overseas territory of France in Oceania. Official name: Territory of French Polynesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
