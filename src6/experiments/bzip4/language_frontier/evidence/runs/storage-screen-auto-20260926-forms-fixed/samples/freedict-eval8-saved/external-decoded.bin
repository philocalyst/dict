    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Englishman</ns0:orth>
        <ns0:pron>/ˈɪŋ.lɪʃ.mən/</ns0:pron>
