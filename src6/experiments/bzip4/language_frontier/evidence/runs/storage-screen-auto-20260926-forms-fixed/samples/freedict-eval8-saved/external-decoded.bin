        <ns0:pron>/ˈɡlæstənbəɹi/</ns0:pron>
        <ns0:pron>/ˈɡlæstənbɹi/</ns0:pron>
        <ns0:pron>/ˈɡlɑːstənbəɹi/</ns0:pron>
        <ns0:pron>/ˈɡlɑːstənbɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Glastonbury</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town and civil parish with a town council in Somerset, England, previously in Mendip district (OS grid ref ST5039).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Glendale</ns0:orth>
        <ns0:pron>/ˈɡlɛndeɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Glendale</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in the San Fernando Valley, Los Angeles County, California.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A village on the Isle of Skye, Highland council area, Scotland, the eponym of all other settlements of the same name (OS grid ref NG1749).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gliwice</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gliwice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in southern Poland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Global Positioning System</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sistema de posicionamiento global</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cartography) A system which enables a mobile receiver to determine its precise location based on signals received from a constellation of US military satellites.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Global South</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sur global</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geopolitics) A region predominantly composed of the developing countries of Africa, Latin America, and Asia excluding Japan and South Korea, regarded as half of a socioeconomic and political divide opposite to the Global North.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Glorious Revolution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>la Gloriosa</ns0:quote>
          <ns0:quote>la Septembrina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, Spanish history) The 1888 revolution that resulted in the deposition of Queen Isabella II of Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gnostic</ns0:orth>
        <ns0:pron>/ˈnɑstɪk/</ns0:pron>
        <ns0:pron>/ˈnɒstɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gnóstico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to Gnosticism</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gnosticism</ns0:orth>
        <ns0:pron>/ˈnɑstəsɪzəm/</ns0:pron>
        <ns0:pron>/ˈnɒstɪsɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gnosticismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wide variety of Jewish and early Christian sects having an interest in gnosis, or divine knowledge, and generally holding the belief that there is a god greater than the Demiurge, or the creator of the world.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goa</ns0:orth>
        <ns0:pron>/ˈɡoʊə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Goa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state in western India. Capital: Panaji.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gobelin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gobelino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mainly French and Flemish type of tapestry having richly coloured pictorial designs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gobi</ns0:orth>
        <ns0:pron>/ˈɡoʊ.bi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gobi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large desert in Asia, spanning the countries of Mongolia and China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God</ns0:orth>
        <ns0:pron>/ɡɑ(d)/</ns0:pron>
        <ns0:pron>/ɡɑd/</ns0:pron>
        <ns0:pron>/ɡɒd/</ns0:pron>
        <ns0:pron>/ɡɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A being such as a monotheistic God: a single divine creator and ruler of the universe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God</ns0:orth>
        <ns0:pron>/ɡɑ(d)/</ns0:pron>
        <ns0:pron>/ɡɑd/</ns0:pron>
        <ns0:pron>/ɡɒd/</ns0:pron>
        <ns0:pron>/ɡɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The single male deity of various bitheistic or duotheistic religions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God Emperor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Emperador-Dios</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God bless you</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>¡que Dios te bendiga!</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>May God bless you; said as a short prayer, benediction, or valediction for the recipient; usually religiously; sometimes nonliterally but rhetorically or culturally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jesús</ns0:quote>
          <ns0:quote>salud</ns0:quote>
          <ns0:quote>gesúndeit</ns0:quote>
          <ns0:quote>santinos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Said to somebody who has sneezed, as a rhetorical response; .</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God forbid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios me libre</ns0:quote>
          <ns0:quote>Dios no lo quiera</ns0:quote>
          <ns0:quote>¡Dios no lo quiera!</ns0:quote>
          <ns0:quote>¡Dios nos libre!</ns0:quote>
          <ns0:quote>¡Que Dios lo impida!</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, subjunctive) indicating that the occurrence of something is very undesirable</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God helps those who help themselves</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a Dios rogando y con el mazo dando</ns0:quote>
          <ns0:quote>ayúdate que Dios te ayudará</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Good fortune or providential aid comes to those who make an effort to accomplish things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God knows</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios sabe</ns0:quote>
          <ns0:quote>sabrá Dios</ns0:quote>
          <ns0:quote>sólo Dios sabe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>It is only known to God; it is unknown to people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God object</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>objeto todopoderoso</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God the Father</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios Padre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christian, _, theology) The person (hypostasis) of the Trinity or Godhead corresponding to the God of Abraham and the Jewish scriptures and considered the creator of mankind and Father of Jesus Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God the Holy Ghost</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios Espíritu Santo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christian, _, theology) The person (hypostasis) of the Trinity or Godhead corresponding to divine essence present in the faithful (particularly, inspired prophets) and considered to proceed either (Eastern Orthodoxy) from God the Father alone or (Roman Catholicism) from Him together with God the Son.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God the Son</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dios Hijo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christian, _, theology) The person (hypostasis) of the Trinity or Godhead corresponding to the Word of God, which became flesh—incarnated—in Jesus Christ, the only-begotten Son of God the Father.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God willing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ojalá</ns0:quote>
          <ns0:quote>Dios mediante</ns0:quote>
          <ns0:quote>Dios quiera</ns0:quote>
          <ns0:quote>si Dios lo quiere</ns0:quote>
          <ns0:quote>si Dios quiere</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, as disjunct) Barring unforeseen circumstances, it is hoped that (while generally also indicating acceptance of God's will).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God works in mysterious ways</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>los caminos del Señor son inescrutables</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Commenting that a seemingly unfortunate or unfavourable situation or change may be beneficial later or in the long run.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>God-fearing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>devoto</ns0:quote>
          <ns0:quote>temeroso de Dios</ns0:quote>
          <ns0:quote>pío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(religion) Following the precepts of a religious practice; respecting and revering God and his authority.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goddard</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Godardo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goddess</ns0:orth>
        <ns0:pron>/ˈɡɒdɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The single goddess of various monotheistic religions.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The single goddess of various bitheistic or duotheistic religions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Godfrey</ns0:orth>
        <ns0:pron>/ˈɡɑdfɹi/</ns0:pron>
        <ns0:pron>/ˈɡɒdfɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Godofredo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Godspeed</ns0:orth>
        <ns0:pron>/ˌɡɑdˈspid/</ns0:pron>
        <ns0:pron>/ˌɡɒdˈspiːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vaya con Dios</ns0:quote>
          <ns0:quote>andá con Dios</ns0:quote>
          <ns0:quote>buena suerte</ns0:quote>
          <ns0:quote>ve con Dios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary) Used, especially at a parting, to express the wish that the outcome of a person's actions be positive for them; typically said to someone who is about to start a journey or a daring endeavour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goebbelsian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>goebbeliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Joseph Goebbels (1897–1945) or his way of doing propaganda, German politician associated with Nazi atrocities under Adolf Hitler.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goethe</ns0:orth>
        <ns0:pron>/ˈɡɜːtə/</ns0:pron>
        <ns0:pron>[ˈɡɚɾə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Goethe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from German.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goethean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>goeteano</ns0:quote>
          <ns0:quote>goetheano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Johann Wolfgang Goethe, a German writer and thinker.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gogol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gógol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Russian and Ukrainian surname.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goidelic</ns0:orth>
        <ns0:pron>/ɡɔɪˈdɛlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gaélico</ns0:quote>
          <ns0:quote>goidélico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Division of the Celtic languages including Irish Gaelic, Manx Gaelic and Scottish Gaelic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goiás</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Goiás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of the Center-West Region, Brazil, around the city. Capital: Goiânia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golaghat</ns0:orth>
        <ns0:pron>/ˈɡoʊləˌɡɑːt/</ns0:pron>
        <ns0:pron>/ˌɡoːlɑːˈɡʱɑːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Golaghat</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Assam, India, situated near the Dhansiri River in Upper – Assam, and one of the oldest urban agglomerations, raised to the status of a subdivision way back in 1839, and later elevated to a district in 1987.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golconda</ns0:orth>
        <ns0:pron>/ɡɑlˈkɑndə/</ns0:pron>
        <ns0:pron>/ɡɒlˈkɒndə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Golconda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fortress and ruined city in Telangana, India, historically famous for nearby diamond mining.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gold Coast</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Costa del Oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and local government area in southeastern Queensland, Australia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Fleece</ns0:orth>
        <ns0:pron>/ˈɡoʊl.dən fliːs/</ns0:pron>
        <ns0:pron>/ˈɡəʊl.dən fliːs/</ns0:pron>
        <ns0:pron>[ˈɡɒʊ̯ɫ.dn̩ ˈfliːs]</ns0:pron>
        <ns0:pron>[ˈɡəɫ.dn̩ ˈfliːs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vellocino de oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A magical fleece from a winged ram guarded by the hydra in the tale of Jason and the Argonauts.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A chivalric order founded in 1430 by Duke Philip III of Burgundy. Later awarded in Spain and Habsburg Austria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Gate Bridge</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puente Golden Gate</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A 1.7-mile-long suspension bridge linking Marin County, California, to San Francisco, California.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Horde</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Horda de Oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A medieval Mongol and later Turkicized khanate established in the 13th century and originating as the northwestern sector of the Mongol Empire; at its maximum extent covering large parts of modern Russia as well as modern Ukraine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Horn</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cuerno de Oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A major urban waterway and the primary inlet of the Bosphorus in Istanbul, Turkey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Retriever</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cobrador dorado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A breed of dog, originating in Britain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Triangle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Triángulo de Oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any region of prosperity, influence, etc. bounded by three points.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golden Week</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Semana Dorada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several extended holidays celebrated in China and Japan, usually early in May.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goldilocks</ns0:orth>
        <ns0:pron>/ˈɡəʊldilɒks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ricitos Dorados</ns0:quote>
          <ns0:quote>Ricitos de Oro</ns0:quote>
          <ns0:quote>Ricitos Áureos</ns0:quote>
          <ns0:quote>Ricitos Áuricos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The protagonist of a traditional fairy tale. She is a golden-haired young girl who inquisitively enters the house of three bears and tries their three bowls of porridge, three chairs, and three beds, in each case finding only one that suits her.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goldilocks economy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>economía Ricitos de Oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(economics) A not "too hot" or "too cold" economy, sustaining moderate economic growth and a low inflation allowing for a market-friendly monetary policy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goldilocks planet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>planeta Ricitos de Oro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A planet which orbits in the habitable zone around a star, where temperatures like those on Earth occur, allowing for the possible existence of liquid water and of life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goldonian</ns0:orth>
        <ns0:pron>/ɡoʊlˈ-/</ns0:pron>
        <ns0:pron>/ɡɑlˈ-/</ns0:pron>
        <ns0:pron>/ɡɒlˈdəʊ.ni.ən/</ns0:pron>
        <ns0:pron>/ɡɔlˈdoʊ.ni.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>goldoniano</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golgi apparatus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparato de Golgi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cytology) A network of membranes in the cytoplasm of those animal cells that produce secretions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Golgotha</ns0:orth>
        <ns0:pron>/ɡɒlˈɡɒθə/</ns0:pron>
        <ns0:pron>/ˈɡɒlɡəθə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gólgota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) The hill outside Jerusalem where Jesus was crucified.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Oxbridge slang, obsolete) The rooms of the heads of the colleges. [18th–19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goliath</ns0:orth>
        <ns0:pron>/ɡəˈlaɪəθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Goliat</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) A giant who, according to the Bible, was vanquished in battle with King David.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gomer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gómer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The eldest son of Japheth. Equivalent to the Cimmerians.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gomez's Hamburger</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hamburguesa de Gómez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A young A0III-type star with an apparent magnitude of +14.4 in the constellation Sagittarius at a distance of 250 ±50 parsecs from Earth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gondwana</ns0:orth>
        <ns0:pron>/ɡɑndˈwɑnə/</ns0:pron>
        <ns0:pron>/ɡɒndˈwɑːnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gondwana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) A southern supercontinent, formed before Pangaea between 600 and 530 million years ago, that included most of the landmasses which make up today's continents of the Southern Hemisphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gongorism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gongorismo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Good Friday</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Viernes Santo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The Friday before Easter Sunday, the commemoration of the day on which Christ was crucified.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Good King Henry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zurrón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A goosefoot of species Blitum bonus-henricus (syn. Chenopodium bonus-henricus), native to Britain and much of Europe, cultivated as a vegetable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Good Samaritan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Buen Samaritano</ns0:quote>
          <ns0:quote>buen samaritano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative, idiomatic) A person who helps someone in distress out of their own good nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Good Samaritan law</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley del buen samaritano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A law that exempts from legal liability a person who attempts to give reasonable aid to another person who is injured, ill, or otherwise imperiled.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(legal) A law that requires able persons, without putting themselves at risk, to provide reasonable aid to persons who are injured, ill, or otherwise imperiled.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Good Shepherd</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Buen Pastor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) Jesus Christ</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Goofy</ns0:orth>
      </ns0:form>
