    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bad</ns0:orth>
        <ns0:pron>/baːd/</ns0:pron>
        <ns0:pron>/bæd/</ns0:pron>
        <ns0:pron>/bæːd/</ns0:pron>
