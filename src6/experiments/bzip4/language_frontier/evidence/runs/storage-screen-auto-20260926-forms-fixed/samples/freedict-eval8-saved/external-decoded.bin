        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>decretar</ns0:quote>
          <ns0:quote>fallar</ns0:quote>
          <ns0:quote>laudar</ns0:quote>
          <ns0:quote>sentenciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, legal) To give by sentence or judicial determination; to assign or apportion, after careful regard to the nature of the case.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
