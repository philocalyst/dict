          <ns0:def>(idiomatic) To be able to expect or anticipate; to be about to suffer, generally said of something unpleasant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
