          <ns0:quote>Niño Dios</ns0:quote>
          <ns0:quote>Santo Niño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) the child Jesus</ns0:def>
        </ns0:sense>
