        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>olímpico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Of or relating to Mount Olympus, the highest mountain in Greece; or (Greek mythology) the Greek gods and goddesses who were believed to live there.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical) Of or relating to the ancient Olympic Games held at Olympia; Olympic.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or relating to the modern Olympic Games; Olympic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
