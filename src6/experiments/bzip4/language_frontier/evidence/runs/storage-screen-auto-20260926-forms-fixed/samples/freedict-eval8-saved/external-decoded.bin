        </ns0:cit>
        <ns0:sense>
          <ns0:def>The two main buildings of the World Trade Center, destroyed in the terrorist attacks on 9/11, 2001.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
