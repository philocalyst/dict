        <ns0:pron>/əˈbɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a bordo de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On board of; onto or into a ship, boat, train, plane. [from ca. 1350—1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
