      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reservado</ns0:quote>
          <ns0:quote>alejado</ns0:quote>
          <ns0:quote>apartado</ns0:quote>
          <ns0:quote>distante</ns0:quote>
          <ns0:quote>sobrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Reserved and remote; either physically or emotionally distant; standoffish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aloof</ns0:orth>
        <ns0:pron>/əˈluːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apartado</ns0:quote>
          <ns0:quote>distante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At or from a distance, but within view, or at a small distance; apart; away.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indiferente</ns0:quote>
          <ns0:quote>sin compasión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without sympathy; unfavorably.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aloofness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reserva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being aloof.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alopecia</ns0:orth>
        <ns0:pron>/æloʊˈpiː.si.ə/</ns0:pron>
        <ns0:pron>/æloʊˈpiː.ʃ(i)ə/</ns0:pron>
        <ns0:pron>/ˌæl.əʊˈpiː.ʃə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alopecia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Deficiency of the hair, which may be caused by failure to grow or loss after growth.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) Loss of hair (especially on the head) or loss of wool or feathers, whether natural or caused by disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aloud</ns0:orth>
        <ns0:pron>/əˈlaʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en voz alta</ns0:quote>
          <ns0:quote>de viva voz</ns0:quote>
          <ns0:quote>en alto</ns0:quote>
          <ns0:quote>públicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>With a loud voice, or great noise; loudly; audibly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpaca</ns0:orth>
        <ns0:pron>/ælˈpækə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alpaca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sheep-like domesticated animal of the Andes, Vicugna pacos, in the camel family, closely related to the llama, guanaco, and vicuña.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A garment made of such wool.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha</ns0:orth>
        <ns0:pron>/əlˈfɑ/</ns0:pron>
        <ns0:pron>/ˈalfɑ/</ns0:pron>
        <ns0:pron>/ˈælfə/</ns0:pron>
        <ns0:pron>/ˈɑlfɑ/</ns0:pron>
        <ns0:pron>[ˈæɫ.fə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of the first letter of the Greek alphabet (Α, α), followed by beta. In the Latin alphabet it is the predecessor to A.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha and omega</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfa y omega</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The first and last; the beginning and end.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha female</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hembra alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology, ethology) The dominant female in a social or group hierarchy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha helix</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hélice alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A secondary structure found in many proteins, in which the amino acids are arranged in a coil, or helix, with almost no free space on the inside and all side chains being pointed towards the outside</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha male</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>macho alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology, ethology) The dominant male in a group of animals.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) A dominant, assertive, protective, oftentimes successful, leadership-type man or male. [from 1990s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha particle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>partícula alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A doubly positively charged nucleus of a helium-4 atom (consisting of two protons and two neutrons), emitted as a consequence of radioactivity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha radiation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>radiación alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The radiation of alpha particles as a result of radioactive decay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha ray</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rayo alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A stream of alpha particles: a single ray of alpha radiation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpha wave</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>onda alfa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neurology) An electrical signal produced by the brain while the subject is relaxed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabet</ns0:orth>
        <ns0:pron>/əlˈfɑ.bɛʈ/</ns0:pron>
        <ns0:pron>/ˈalfɑ.bɛʈ/</ns0:pron>
        <ns0:pron>/ˈæl.fə.bɪt/&lt;q:uncommon&gt;</ns0:pron>
        <ns0:pron>/ˈæl.fəˌbɛt/</ns0:pron>
        <ns0:pron>/ˈɑlfɑ.bɛʈ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabeto</ns0:quote>
          <ns0:quote>abecedario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The set of letters used when writing in a language.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A writing system in which letters represent phonemes. (Contrast e.g. logography, a writing system in which each character represents a word, and syllabary, in which each character represents a syllable.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabet soup</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sopa de letras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of soup that contains noodles in the shape of various alphabetical letters, sometimes also numbers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabetical</ns0:orth>
        <ns0:pron>/ˌæl.fəˈbet.ɪ.kəl/</ns0:pron>
        <ns0:pron>/ˌæl.fəˈbɛt.ɪ.kəl/</ns0:pron>
        <ns0:pron>/ˌælfəˈbɛtɪkəl/</ns0:pron>
        <ns0:pron>[ˌæl.fəˈbeɾ.ɪ.kəl]</ns0:pron>
        <ns0:pron>[ˌælfəˈbɛɾɪkəl]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>According to the sequence of the letters of the alphabet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabetical order</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>orden alfabético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sequence of a collection of items (such as words in a dictionary) arranged in order by position in the alphabet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabetically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabéticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(manner) In an alphabetical manner.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(sequence) Arranged in the order of the alphabet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabetism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabetismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Discrimination on the basis of the first letter of a name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphabetize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabetizar</ns0:quote>
          <ns0:quote>ordenar alfabeticamente</ns0:quote>
          <ns0:quote>poner en orden alfabético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada, transitive) To arrange words or items in order of the first (and then subsequent) letters as they occur in the alphabet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphagram</ns0:orth>
        <ns0:pron>/ˈæl.fəˌɡɹæm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfagrama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The letters of a word, or any other set of letters, arranged in alphabetical order.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphanumeric</ns0:orth>
        <ns0:pron>/ˌæl.fə.n(j)uːˈmɛ.ɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfanumérico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Consisting of, or limited to, letters and/or numbers, especially the characters A to Z (lowercase and uppercase) and 0 to 9.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphasyllabary</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfasilabario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A segmental writing system in which consonant–vowel sequences are written as a unit, and where each unit is based on a consonant letter, and vowel notation is secondary; an abugida.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alphorn</ns0:orth>
        <ns0:pron>/ˈalp.hɔːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trompa de los Alpes</ns0:quote>
          <ns0:quote>alforn</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(musical instruments) A long, curved, wooden horn used by mountain-dwelling herders in the Alps, originally to call cattle but now only as musical instrument in classical and folk tunes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpine</ns0:orth>
        <ns0:pron>/ˈæl.paɪn/</ns0:pron>
        <ns0:pron>/ˈæl.pɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alpino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or inhabiting mountains, especially above the timberline.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpine accentor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acentor alpino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Prunella collaris, a small passerine bird in the family Prunellidae</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alpine chough</ns0:orth>
        <ns0:pron>/ˈalpaɪn ˈtʃʌf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chova piquigualda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A species of bird in the crow family (Corvidae) (Pyrrhocorax graculus), that breeds locally in the highest mountains of southern Europe, the Alps, across central Asia and India.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alprazolam</ns0:orth>
        <ns0:pron>/alˈpɹeɪ.zə.lam/</ns0:pron>
        <ns0:pron>/alˈpɹeɪ.zəʊ.lam/</ns0:pron>
        <ns0:pron>/ælˈpɹæz.əˌlæm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alprazolam</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A drug (trademark Xanax) of the benzodiazepine group (8-chloro-1-methyl-6-phenyl-4H-[1,2,4]triazolo[4,3-a][1,4]benzodiazepine), used in the treatment of anxiety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>already</ns0:orth>
