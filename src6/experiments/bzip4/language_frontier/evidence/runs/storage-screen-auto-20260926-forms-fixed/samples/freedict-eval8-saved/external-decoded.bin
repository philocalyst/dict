    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eris</ns0:orth>
        <ns0:pron>/ˈɛɹɪs/</ns0:pron>
        <ns0:pron>/ˈɪəɹɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eris</ns0:quote>
          <ns0:quote>Érida</ns0:quote>
          <ns0:quote>Éride</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The goddess of discord and strife, whose apple of discord sparked events that eventually led to the Trojan War; equated by Homer with Enyo (goddess of violent war) and identified with the Roman goddess Discordia;(religion, Discordianism) the same figure as principal deity of Discordianism, regarded as the goddess of disorder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eris</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) The celestial body 136199 Eris, the most-massive known dwarf planet in the Solar System and the largest known object in the scattered disk; formerly nicknamed Xena.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
