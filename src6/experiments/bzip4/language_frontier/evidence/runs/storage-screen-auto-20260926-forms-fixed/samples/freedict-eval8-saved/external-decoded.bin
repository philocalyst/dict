      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Caspian</ns0:orth>
        <ns0:pron>/ˈkæspi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caspio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the Caspian Sea or the region around it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Caspian</ns0:orth>
        <ns0:pron>/ˈkæspi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caspio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A member of the ancient people dwelling along the southern and southwestern shores of the Caspian Sea, in the region which was called Caspiane after them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Caspian Sea</ns0:orth>
        <ns0:pron>/ˈkæspi.ən ˈsiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar Caspio</ns0:quote>
          <ns0:quote>Mar Caspio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A landlocked sea (properly a saline lake) between Eastern Europe and Asia, and the Earth’s largest inland body of water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
