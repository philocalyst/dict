        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acarbosa</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acarophobia</ns0:orth>
        <ns0:pron>/ˌækəɹəˈfəʊbi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acarofobia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acarpous</ns0:orth>
        <ns0:pron>/eɪˈkɑɹ.pəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acarpo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Not producing fruit; unfruitful; sterile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acatalepsy</ns0:orth>
        <ns0:pron>/eɪˈkæ.tə.lɛp.si/</ns0:pron>
        <ns0:pron>/əˈkæ.tə.lɛp.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acatalepsia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Incomprehensibility of things; the doctrine held by the ancient skeptic philosophers, that human knowledge never amounts to certainty, but only to probability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acathistus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acatisto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Greek liturgical hymn in honour of Mary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acaulescent</ns0:orth>
        <ns0:pron>/ˌæk.ɔˈlɛs.nt/</ns0:pron>
        <ns0:pron>/ˌæk.ɔˈlɛs.ənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acaule</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Having no stem or caulis, or only a very short one concealed in the ground.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accede</ns0:orth>
        <ns0:pron>/ækˈsiːd/</ns0:pron>
        <ns0:pron>/əkˈsiːd/</ns0:pron>
        <ns0:pron>/əˈsiːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceder</ns0:quote>
          <ns0:quote>consentir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To agree or assent to a proposal or a view; to give way. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceder</ns0:quote>
          <ns0:quote>subir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To come to an office, state or dignity; to attain, assume (a position). [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accelerate</ns0:orth>
        <ns0:pron>/ækˈsɛl.əˌɹeɪt/</ns0:pron>
        <ns0:pron>/əkˈsɛl.əˌɹeɪt/</ns0:pron>
        <ns0:pron>/ɪkˈsɛl.əˌɹeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelerar</ns0:quote>
          <ns0:quote>apresurar</ns0:quote>
          <ns0:quote>embalar</ns0:quote>
          <ns0:quote>embalarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to move faster; to quicken the motion of; to add to the speed of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelerar</ns0:quote>
          <ns0:quote>apresurar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To quicken the natural or ordinary progression or process of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelerar</ns0:quote>
          <ns0:quote>embalarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To become faster; to begin to move more quickly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accelerated ageing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>envejecimiento acelerado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acceleration</ns0:orth>
        <ns0:pron>/ækˌsɛl.əˈɹeɪ.ʃən/</ns0:pron>
        <ns0:pron>/əkˌsɛl.əˈɹeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ɪkˌsɛl.əˈɹeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceleración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The act of accelerating, or the state of being accelerated; increase of motion or action; as opposed to retardation or deceleration.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The amount by which a speed or velocity increases (and so a scalar quantity or a vector quantity).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) The change of velocity with respect to time (can include deceleration or changing direction).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accelerationism</ns0:orth>
        <ns0:pron>/ækˌsɛl.əˈɹeɪ.ʃə.nɪ.zm̩/</ns0:pron>
        <ns0:pron>/əkˌsɛl.əˈɹeɪ.ʃə.nɪ.zm̩/</ns0:pron>
        <ns0:pron>/ɪkˌsɛl.əˈɹeɪ.ʃə.nɪ.zm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceleracionismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The idea that either the prevailing system of capitalism, or certain technosocial processes that historically characterised it, should be expanded and accelerated in order to generate radical social change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accelerator</ns0:orth>
        <ns0:pron>/ækˈsɛl.əˌɹeɪ.tɚ/</ns0:pron>
        <ns0:pron>/əkˈsɛl.əˌɹeɪ.tɚ/</ns0:pron>
        <ns0:pron>/ɪkˈsɛl.əˌɹeɪ.tɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelerador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who, or that which, accelerates.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A device for causing acceleration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelerador</ns0:quote>
          <ns0:quote>chala</ns0:quote>
          <ns0:quote>chancla</ns0:quote>
          <ns0:quote>chancleta</ns0:quote>
          <ns0:quote>chola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(vehicle) A pedal causing the vehicle to accelerate when it is pressed.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) A device that accelerates charged subatomic particles; a particle accelerator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceleradora de semillas</ns0:quote>
          <ns0:quote>aceleradora de startups</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(business) A mentoring program for startup companies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accelerator key</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tecla aceleradora</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accelerometer</ns0:orth>
        <ns0:pron>/ækˌsɛl.əˈɹɑ.mə.tɚ/</ns0:pron>
        <ns0:pron>/ɪkˌsɛl.əˈɹɑ.mə.tɚ/</ns0:pron>
        <ns0:pron>[ækˌsɛl.əˈɹɑ.mə.ɾɚ]</ns0:pron>
        <ns0:pron>[ɪkˌsɛl.əˈɹɑ.mə.ɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acelerómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument for measuring acceleration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accent</ns0:orth>
        <ns0:pron>/-sənt/</ns0:pron>
        <ns0:pron>/-sɛnt/</ns0:pron>
        <ns0:pron>/ˈak.sənt/</ns0:pron>
        <ns0:pron>/ˈæk.sɛnt/</ns0:pron>
        <ns0:pron>/ˈɛk.sent/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acento léxico</ns0:quote>
          <ns0:quote>acentuación</ns0:quote>
          <ns0:quote>dejillo</ns0:quote>
          <ns0:quote>tonada</ns0:quote>
          <ns0:quote>énfasis</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tilde</ns0:quote>
          <ns0:quote>acento gráfico</ns0:quote>
          <ns0:quote>acento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(orthography) A mark or character used in writing, in order to indicate the place of the spoken accent, or to indicate the nature or quality of the vowel marked.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acento</ns0:quote>
          <ns0:quote>cantadito</ns0:quote>
          <ns0:quote>cantito</ns0:quote>
          <ns0:quote>deje</ns0:quote>
          <ns0:quote>dejo</ns0:quote>
          <ns0:quote>tonillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics, sociolinguistics) The distinctive manner of pronouncing a language associated with a particular region, social group, etc., whether of a native speaker or a foreign speaker; the phonetic and phonological aspects of a dialect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A word; a significant tone or sound.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(prosody, poetry) Stress laid on certain syllables of a verse.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) A regularly recurring stress upon the tone to mark the beginning, and, more feebly, the third part of the measure.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) A special emphasis of a tone, even in the weaker part of the measure.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) A mark used to represent this special emphasis.The third and fourth symbols are accents (marks used to represent special emphasis in music).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) The rhythmical accent, which marks phrases and sections of a period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accent</ns0:orth>
        <ns0:pron>/ækˈsɛnt/</ns0:pron>
        <ns0:pron>/ˈæk.sɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acentuar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To mark emphatically; to emphasize; to accentuate; to make prominent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accented</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acentuado</ns0:quote>
          <ns0:quote>con acento</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accentor</ns0:orth>
        <ns0:pron>/əkˈsɛn.tɚ/</ns0:pron>
        <ns0:pron>/əkˈsɛntə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acentor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any bird of the Eurasian genus Prunella, such as the dunnock.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accentuate</ns0:orth>
        <ns0:pron>/ækˈsɛn.t͡ʃuˌeɪt/</ns0:pron>
        <ns0:pron>/əkˈsɛn.t͡ʃu.eɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acentuar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pronounce with an accent or vocal stress.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To bring out distinctly; to make more noticeable or prominent; to emphasize. [from 1865]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To mark with a written accent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accentuation</ns0:orth>
        <ns0:pron>/ˌækˌsɛn.t͡ʃəˈweɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌɪkˌsɛn.t͡ʃəˈweɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acentuación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Act of accentuating; applications of accent.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(ecclesiastical, music) Pitch or modulation of the voice in reciting portions of the liturgy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accept</ns0:orth>
        <ns0:pron>/ækˈsɛpt/</ns0:pron>
        <ns0:pron>/əkˈsɛpt/</ns0:pron>
        <ns0:pron>/əˈsɛp(t)/</ns0:pron>
        <ns0:pron>/ɪkˈsɛpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptar</ns0:quote>
          <ns0:quote>adir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To receive or admit to; to agree to; to assent to; to submit to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accept service</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darse por notificado</ns0:quote>
          <ns0:quote>recibir la notificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) To receive and acknowledge receipt of service of process.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acceptability</ns0:orth>
        <ns0:pron>/ˌækˌsɛp.təˈbɪl.ət.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being acceptable; acceptableness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acceptable</ns0:orth>
        <ns0:pron>/ækˈsɛp.tə.bəl/</ns0:pron>
        <ns0:pron>/əkˈsɛp.tə.bəl/</ns0:pron>
        <ns0:pron>/ɪkˈsɛp.tə.bəl/</ns0:pron>
        <ns0:pron>/ˈæksɛp.tə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptable</ns0:quote>
          <ns0:quote>asumible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Worthy, decent, sure of being accepted or received with at least moderate pleasure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acceptably</ns0:orth>
        <ns0:pron>/ækˈsɛp.tə.bli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptablemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an acceptable manner; in a manner to please or give satisfaction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acceptance</ns0:orth>
        <ns0:pron>/əkˈsɛp.təns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The act of accepting; the receiving of something offered, with acquiescence, approbation, or satisfaction; especially, favourable reception; approval.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(business, finance) An assent and engagement by the person on whom a bill of exchange is drawn, to pay it when due according to the terms of the acceptance; the bill of exchange itself when accepted.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(law) An agreeing to the action, proposals, or terms of another by some act which results in the conclusion of a legally binding contract; the reception or taking of a thing bought as that for which it was bought, or as that agreed to be delivered, or the taking of possession of a thing as owner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accepting</ns0:orth>
        <ns0:pron>/ˌækˈsɛp.tɪŋ/</ns0:pron>
        <ns0:pron>/ˌəkˈsɛp.tɪŋ/</ns0:pron>
        <ns0:pron>/ˌɪkˈsɛp.tɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptador</ns0:quote>
          <ns0:quote>aceptante</ns0:quote>
          <ns0:quote>aceptor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characterized by acceptance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acceptor</ns0:orth>
        <ns0:pron>/ækˈsɛp.tɚ/</ns0:pron>
        <ns0:pron>/əkˈsɛp.tɚ/</ns0:pron>
        <ns0:pron>/əkˈsɛptə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aceptador</ns0:quote>
          <ns0:quote>aceptadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who accepts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>access</ns0:orth>
        <ns0:pron>/ˈæksɛs/</ns0:pron>
        <ns0:pron>/ˈækˌsɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A way or means of approaching or entering; an entrance; a passage.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The act of approaching or entering; an advance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The right or ability of approaching or entering; admittance; admission; accessibility.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, computing) The process of locating data in memory.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, networking) Connection to or communication with a computer program or to the Internet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>access</ns0:orth>
        <ns0:pron>/əkˈsɛs/</ns0:pron>
        <ns0:pron>/ˈæksɛs/</ns0:pron>
        <ns0:pron>/ˈækˌsɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceder</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To gain or obtain access to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acceder</ns0:quote>
          <ns0:quote>accesar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, computing) To have access to (data).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>access code</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>código de acceso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A typically alphanumeric sequence that permits access to a secure service or network.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessibility</ns0:orth>
        <ns0:pron>/əkˌsɛs.əˈbɪl.ə.ti/</ns0:pron>
        <ns0:pron>/əkˌsɛs.əˈbɪl.ɪ.ti/</ns0:pron>
        <ns0:pron>/ˈæksəsɪb(ɪ)lɪʈi/</ns0:pron>
        <ns0:pron>[əkˌsɛs.əˈbɪl.ə.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being accessible, or of admitting approach; receptiveness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessible</ns0:orth>
        <ns0:pron>/əkˈsɛs.ɪ.bəl/</ns0:pron>
        <ns0:pron>/ˈæksəsɪbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesible</ns0:quote>
          <ns0:quote>asequible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Easy of access or approach. [from 1640s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesible</ns0:quote>
          <ns0:quote>abordable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a person) Easy to get along with.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accession</ns0:orth>
        <ns0:pron>/ækˈseʃ.ən/</ns0:pron>
        <ns0:pron>/ækˈsɛʃ.ən/</ns0:pron>
        <ns0:pron>/əˈseʃ.ən/</ns0:pron>
        <ns0:pron>/əˈsɛʃ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascenso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A coming to; the act of acceding and becoming joined.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A mode of acquiring property, by which the owner of a corporeal substance which receives an addition by growth, or by labor, has a right to the part or thing added, or the improvement (provided the thing is not changed into a different species).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessory</ns0:orth>
        <ns0:pron>/ækˈsɛs(ə)ɹi/</ns0:pron>
        <ns0:pron>/əkˈsɛs(ə)ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesorio</ns0:quote>
          <ns0:quote>auxiliar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a secondary, supplementary or subordinate function by accompanying as a subordinate; aiding in a secondary way; being additional; contributing or being contributory. [from 1550s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Assisting a crime without actually participating in committing the crime itself; being connected as an incident or subordinate to a principal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessory</ns0:orth>
        <ns0:pron>/ækˈsɛs(ə)ɹi/</ns0:pron>
        <ns0:pron>/əkˈsɛs(ə)ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesorio</ns0:quote>
          <ns0:quote>complemento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something that belongs to part of another main thing; something additional and subordinate, an attachment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A person who is not present at a crime, but contributes to it as an assistant or instigator. [from 1414]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessory after the fact</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice encubridor</ns0:quote>
          <ns0:quote>encubridor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) An individual who assists someone who has committed a crime so as to protect them from legal prosecution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessory before the fact</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice instigador</ns0:quote>
          <ns0:quote>inductor</ns0:quote>
          <ns0:quote>instigador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) One who commands or counsels an actionable offense, not being present at its commission.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessory fruit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pseudofruto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A fruit which includes tissue not derived from the ovary but from some adjacent tissue, as for instance, a strawberry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accessory mineral</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mineral accesorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) any mineral that is present in small amounts in a rock, but is not considered to be characteristic of the rock</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accident</ns0:orth>
        <ns0:pron>/-dɛnt/</ns0:pron>
        <ns0:pron>/ˈæksədənt/</ns0:pron>
        <ns0:pron>/ˈæksədɪnt/</ns0:pron>
        <ns0:pron>/ˈæksɪdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accidente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unexpected event with negative consequences occurring without the intention of the one suffering the consequences, and (in the strict sense) not directly caused by humans.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transportation) A collision or crash of a vehicle, aircraft, or other form of transportation that causes damage to the transportation involved; and sometimes injury or death to the transportation's occupants or bystanders in close proximity. (but see Usage notes)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accident rate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>siniestralidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Frequency or rate of accidents.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accidental</ns0:orth>
        <ns0:pron>/ˌæk.sɪˈdɛn.tl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accidental</ns0:quote>
          <ns0:quote>casual</ns0:quote>
          <ns0:quote>fortuito</ns0:quote>
          <ns0:quote>imprevisto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Happening by chance, or unexpectedly; taking place not according to the usual course of things; by accident, unintentional. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accidentally</ns0:orth>
        <ns0:pron>/ˌæk.sɪˈdɛnt(ə)li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accidentalmente</ns0:quote>
          <ns0:quote>sin querer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an accidental manner; by chance, unexpectedly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accidentally on purpose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sin querer queriendo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Deliberately, though apparently accidentally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accidie</ns0:orth>
        <ns0:pron>/ˈæk.sə.di/</ns0:pron>
        <ns0:pron>/ˈæk.sɪ.di/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acidia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, literary) Sloth, slothfulness, especially as inducing general listlessness and apathy. [from 13th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acclaim</ns0:orth>
        <ns0:pron>/əˈkleɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclamación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(poetic) An acclamation; a shout of applause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acclaim</ns0:orth>
        <ns0:pron>/əˈkleɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gritar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, transitive) To shout; to call out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclamar</ns0:quote>
          <ns0:quote>aplaudir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, rare) To salute or praise with great approval; to compliment; to applaud; to welcome enthusiastically.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclamar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To declare by acclamations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acclamation</ns0:orth>
        <ns0:pron>/æk.ləˈmeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclamación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A shout of approbation, favor, or assent; eager expression of approval; loud applause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acclimate</ns0:orth>
        <ns0:pron>/əˈklaɪ.mət/</ns0:pron>
        <ns0:pron>/ˈæk.lɪ.meɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclimatar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, chiefly, US) To habituate to a climate not native; to acclimatize.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acclimatization</ns0:orth>
        <ns0:pron>/əˌklaɪ.mə.təˈzeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclimatación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of acclimatizing; the process of inuring to a new climate, or the state of being so inured.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acclimatize</ns0:orth>
        <ns0:pron>/əˈklaɪ.məˌtaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aclimatar</ns0:quote>
          <ns0:quote>aclimatarse</ns0:quote>
          <ns0:quote>aclimatizar</ns0:quote>
          <ns0:quote>aclimatizarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make used to a new climate or one that is different from that which is natural; to inure or habituate to other circumstances; to adapt to the peculiarities of a foreign or strange climate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accolade</ns0:orth>
        <ns0:pron>/ˈæk.əˌleɪd/</ns0:pron>
        <ns0:pron>/ˌæk.əˈlɑd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>elogio</ns0:quote>
          <ns0:quote>espaldarazo</ns0:quote>
          <ns0:quote>loor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expression of approval; praise. [from 1852]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>galardón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A special acknowledgment; an award.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acolada</ns0:quote>
          <ns0:quote>espaldarazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A salutation marking the conferring of knighthood, consisting of an embrace or a kiss, and a slight blow on the shoulders with the flat of a sword.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accommodate</ns0:orth>
        <ns0:pron>/əˈkɑməˌdeɪt/</ns0:pron>
        <ns0:pron>/əˈkɒməˌdeɪt/</ns0:pron>
        <ns0:pron>/əˈkɒməˌdæɪt/</ns0:pron>
        <ns0:pron>/əˈkɔməˌdæɪt/</ns0:pron>
        <ns0:pron>[əˈkʰɑməˌdeɪt]</ns0:pron>
        <ns0:pron>[əˈkʰɒməˌdeɪt]</ns0:pron>
        <ns0:pron>[əˈkʰɔməˌdæɪt]</ns0:pron>
        <ns0:pron>[əˈkʰɔ̟məˌdæɪt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albergar</ns0:quote>
          <ns0:quote>acoger</ns0:quote>
          <ns0:quote>satisfacer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to come to agreement; to bring about harmony; to reconcile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acomodar</ns0:quote>
          <ns0:quote>adaptar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To show the correspondence of; to apply or make suit by analogy; to adapt or fit, as teachings to accidental circumstances, statements to facts, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accommodating</ns0:orth>
        <ns0:pron>/əˈkɒm.əˌdeɪ.tɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acomodadizo</ns0:quote>
          <ns0:quote>acomodaticio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Affording, or disposed to afford, accommodation; obliging; helpful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accommodation</ns0:orth>
        <ns0:pron>/əˌkɑ.məˈdeɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌkɒm.əˈdeɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌkɔm.əˈdæɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hospedaje</ns0:quote>
          <ns0:quote>alojamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, British, usually, a mass noun) Lodging in a dwelling or similar living quarters afforded to travellers in hotels or on cruise ships, or prisoners, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, uncountable) A convenience, a fitting, something satisfying a need.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acomodación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, medical) The adjustment of the eye to a change of the distance from an observed object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acomodación</ns0:quote>
          <ns0:quote>acomodamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable, followed by to) The act of fitting or adapting, or the state of being fitted or adapted; adaptation; adjustment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accompaniment</ns0:orth>
        <ns0:pron>/əˈkʌm.pə.ni.mənt/</ns0:pron>
        <ns0:pron>/əˈkʌmp.ni.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acompañamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A part, usually performed by instruments, that gives support or adds to the background in music, or adds for ornamentation; also, the harmony of a figured bass.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>That which accompanies; something that attends as a circumstance, or which is added to give greater completeness to the principal thing, or by way of ornament, or for the sake of symmetry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accompanist</ns0:orth>
        <ns0:pron>/əˈkʌmp(ə)nɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acompañante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The performer in music who takes the accompanying part.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accompany</ns0:orth>
        <ns0:pron>/əˈkʌm.pə.ni/</ns0:pron>
        <ns0:pron>/əˈkʌmp.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acompañar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To go with or attend as a companion or associate; to keep company with; to go along with.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, music) To perform an accompanying part or parts in a composition.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, music) To perform an accompanying part next to (another instrument or musician).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accomplice</ns0:orth>
        <ns0:pron>/əˈkɑm.pləs/</ns0:pron>
        <ns0:pron>/əˈkɑm.plɪs/</ns0:pron>
        <ns0:pron>/əˈkɒm.plɪs/</ns0:pron>
        <ns0:pron>/əˈkʌm.plɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) An associate in the commission of a crime; a participator in an offense, whether a principal or an accessory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice</ns0:quote>
          <ns0:quote>fautor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) A cooperator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accomplish</ns0:orth>
        <ns0:pron>/əˈkɐm.pləʃ/</ns0:pron>
        <ns0:pron>/əˈkɐm.plɪʃ/</ns0:pron>
        <ns0:pron>/əˈkɑm.plɪʃ/</ns0:pron>
        <ns0:pron>/əˈkɒm.plɪʃ/</ns0:pron>
        <ns0:pron>/əˈkʌm.plɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>completar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To complete, as time or distance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To equip or furnish thoroughly; hence, to complete in acquirements; to render accomplished; to polish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>realizar</ns0:quote>
          <ns0:quote>efectuar</ns0:quote>
          <ns0:quote>lograr</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To execute fully; to fulfill; to complete successfully.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accomplished</ns0:orth>
        <ns0:pron>/əˈkɑm.plɪʃt/</ns0:pron>
        <ns0:pron>/əˈkɒm.plɪʃt/</ns0:pron>
        <ns0:pron>/əˈkʌm.plɪʃt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cumplido</ns0:quote>
          <ns0:quote>logrado</ns0:quote>
          <ns0:quote>realizado</ns0:quote>
          <ns0:quote>consumado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Completed; effected; established.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accomplishment</ns0:orth>
        <ns0:pron>/əˈkɑm.plɪʃ.mənt/</ns0:pron>
        <ns0:pron>/əˈkɒm.plɪʃ.mənt/</ns0:pron>
        <ns0:pron>/əˈkʌm.plɪʃ.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>logro</ns0:quote>
          <ns0:quote>éxito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of accomplishing; completion; fulfilment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>logro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something accomplished; an achievement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accord</ns0:orth>
        <ns0:pron>/əˈkɔɹd/</ns0:pron>
        <ns0:pron>/əˈkɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuerdo</ns0:quote>
          <ns0:quote>convenio</ns0:quote>
          <ns0:quote>iniciativa propia</ns0:quote>
          <ns0:quote>voluntad propia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accord</ns0:orth>
        <ns0:pron>/əˈkɔɹd/</ns0:pron>
        <ns0:pron>/əˈkɔːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acordar</ns0:quote>
          <ns0:quote>conceder</ns0:quote>
          <ns0:quote>concordar</ns0:quote>
          <ns0:quote>conferir</ns0:quote>
          <ns0:quote>otorgar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make to agree or correspond; to suit one thing to another; to adjust.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accordance</ns0:orth>
        <ns0:pron>/əˈkɔɹ.dəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conformidad</ns0:quote>
          <ns0:quote>acordanza</ns0:quote>
          <ns0:quote>acuerdo</ns0:quote>
          <ns0:quote>arreglo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Agreement; harmony; conformity; compliance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>according to</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>según</ns0:quote>
          <ns0:quote>acorde a</ns0:quote>
          <ns0:quote>con arreglo a</ns0:quote>
          <ns0:quote>a tenor de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Based on what is said or stated by; on the authority of; by the order of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acorde a</ns0:quote>
          <ns0:quote>de acuerdo a</ns0:quote>
          <ns0:quote>de acuerdo con</ns0:quote>
          <ns0:quote>según</ns0:quote>
          <ns0:quote>en función de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a manner conforming or corresponding to; in proportion to; in accordance with. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>according to one's understanding</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>según mi entender</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As far as one can understand with the data and knowledge available at the moment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accordingly</ns0:orth>
        <ns0:pron>/əˈkɔɹ.dɪŋ.li/</ns0:pron>
        <ns0:pron>/əˈkɔː(ɹ).dɪŋ.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acordemente</ns0:quote>
          <ns0:quote>como corresponde</ns0:quote>
          <ns0:quote>en consecuencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(manner) Agreeably; correspondingly; suitably</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consecuentemente</ns0:quote>
          <ns0:quote>por consiguiente</ns0:quote>
          <ns0:quote>por lo tanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(conjunctive) In natural sequence; consequently; so.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accordion</ns0:orth>
        <ns0:pron>/əˈkɔ(ɹ).diˌən/</ns0:pron>
        <ns0:pron>/əˈkɔɹ.di.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acordeón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A box-shaped musical instrument played by compressing or expanding its bellows while pressing its buttons or its keys, causing pallets to open, which allow air to flow across strips of brass or steel (reeds).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accordionist</ns0:orth>
        <ns0:pron>/əˈkɔɹd.i.ə.nəst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acordeonista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who plays the accordion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accost</ns0:orth>
        <ns0:pron>/əˈkɑst/</ns0:pron>
        <ns0:pron>/əˈkɒst/</ns0:pron>
        <ns0:pron>/əˈkɔst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acometer</ns0:quote>
          <ns0:quote>embestir</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accoucheur</ns0:orth>
        <ns0:pron>/ˌæ.kuˈʃɜː/</ns0:pron>
        <ns0:pron>/ˌæ.kuˈʃɝ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matrón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A person, especially a man, who delivers a baby (in childbirth).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>account</ns0:orth>
        <ns0:pron>/əˈkaʊnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenta</ns0:quote>
          <ns0:quote>relato</ns0:quote>
          <ns0:quote>descripción</ns0:quote>
          <ns0:quote>exegesis</ns0:quote>
          <ns0:quote>exégesis</ns0:quote>
          <ns0:quote>justificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(accounting) A registry of pecuniary transactions; a written or printed statement of business dealings or debts and credits, and also of other things subjected to a reckoning or review. [from c. 1300]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenta</ns0:quote>
          <ns0:quote>exegesis</ns0:quote>
          <ns0:quote>explicaciones</ns0:quote>
          <ns0:quote>explicación</ns0:quote>
          <ns0:quote>exégesis</ns0:quote>
          <ns0:quote>reporte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A statement in general of reasons, causes, grounds, etc., explanatory of some event; a reason of an action to be done.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Authorization as a specific registered user in accessing a system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cálculo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) A reckoning; computation; calculation; enumeration; a record of some reckoning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>account book</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>libro contable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(accounting) A book in which accounts are kept; ledger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>account for</ns0:orth>
        <ns0:pron>/əˈkaʊnt foɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>representar</ns0:quote>
          <ns0:quote>constituir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To constitute in amount or portion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contabilizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make or render a reckoning of funds, persons, or things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>account to</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>responder a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To answer to; to be responsible to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accountability</ns0:orth>
        <ns0:pron>/əˌkaʊn.təˈbɪl.ə.ti/</ns0:pron>
        <ns0:pron>/əˌkæɔn.təˈbɪl.ə.ti/</ns0:pron>
        <ns0:pron>[əˌkaʊn.təˈbɪl.ə.ɾi]</ns0:pron>
        <ns0:pron>[əˌkæɔn.təˈbɪl.ə.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>culpabilidad</ns0:quote>
          <ns0:quote>culpabilización</ns0:quote>
          <ns0:quote>imputabilidad</ns0:quote>
          <ns0:quote>responsabilidad</ns0:quote>
          <ns0:quote>responsabilización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being accountable; liability to be called on to render an account or give an explanation; liability to be held responsible or answerable for something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>competencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) The obligation imposed by law or regulation on an officer or other person for keeping an accurate record of property, documents, or funds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accountable</ns0:orth>
        <ns0:pron>/əˈkaʊntəbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>responsable</ns0:quote>
          <ns0:quote>imputable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Obliged, when called upon, to answer (for one’s deeds); answerable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accountably</ns0:orth>
        <ns0:pron>/əˈkaʊn.tə.bli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>responsablemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an accountable manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accountancy</ns0:orth>
        <ns0:pron>/əˈkaʊnt.ən.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, British, NZ, often, _, Philippines, accounting) The function of compiling and providing financial information primarily by reports referred to as financial statements, including bookkeeping, systems design, analysis and interpretation of accounting information.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accountant</ns0:orth>
        <ns0:pron>/əˈkaʊn.tənt/</ns0:pron>
        <ns0:pron>[əˈkæʊn.ʔn̩ʔ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contable</ns0:quote>
          <ns0:quote>contador</ns0:quote>
          <ns0:quote>contadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who renders account; one accountable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contable</ns0:quote>
          <ns0:quote>contador</ns0:quote>
          <ns0:quote>tenedor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A reckoner, or someone who maintains financial matters for a person(s).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contable</ns0:quote>
          <ns0:quote>contador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(accounting) One whose profession includes organizing, maintaining and auditing the records of another. The records are usually, but not always, financial records.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accounting</ns0:orth>
        <ns0:pron>/əˈkaʊn.tɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(business) The development and use of a system for recording and analyzing the financial transactions and financial status of an individual or a business.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accounts payable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuentas a pagar</ns0:quote>
          <ns0:quote>cuentas pendientes de pago</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The total amount of money that is owed by a customer to its suppliers of goods and services and is counted by the customer as a current unpaid debt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accounts receivable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deuda activa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(accounting) The total monetary amount owed to a financial entity due to debts arising from sales on credit or on account.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accredit</ns0:orth>
        <ns0:pron>/əˈkɹɛd.ɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acreditar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put or bring into credit; to invest with credit or authority; to sanction.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To send with letters credential, as an ambassador, envoy, or diplomatic agent; to authorize, as a messenger or delegate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accreditation</ns0:orth>
        <ns0:pron>/əˌkɹed.əˈteɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌkɹɛd.əˈteɪ.ʃən/</ns0:pron>
        <ns0:pron>/əˌkɹɛd.ɪˈteɪ.ʃən/</ns0:pron>
        <ns0:pron>[əˌkɹeɾ.əˈtæɪ.ʃən]</ns0:pron>
        <ns0:pron>[əˌkɹɛɾ.əˈteɪ.ʃən]</ns0:pron>
        <ns0:pron>[əˌkɹɛɾ.ɪˈteɪ.ʃən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acreditación</ns0:quote>
          <ns0:quote>homologación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The giving of credentials.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accretion</ns0:orth>
        <ns0:pron>/əˈkɹiʃən/</ns0:pron>
        <ns0:pron>/əˈkɹiːʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acreción</ns0:quote>
          <ns0:quote>acrecencia</ns0:quote>
          <ns0:quote>aumento</ns0:quote>
          <ns0:quote>crecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, also, figurative) Increase by natural growth, especially the gradual increase of organic bodies by the internal addition of matter; organic growth; also, the amount of such growth. [from early 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrecencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) (Gradual) increase by an external addition of matter; (countable) an instance of this.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrophysics) The formation of planets, stars, and other celestial bodies by the aggregating of matter drawn together by gravity; also, the growth of a celestial body through this process.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concrescenza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The process of separate particles aggregating or coalescing together; concretion; (countable) a thing formed in this manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accretion disk</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disco de acrecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astrophysics) A structure formed by matter falling into a gravitational source such as a galaxy, black hole, or protostar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accrual</ns0:orth>
        <ns0:pron>/əˈkɹuːəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acumulación</ns0:quote>
          <ns0:quote>incremento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An increase; something that accumulates, especially an amount of money that periodically accumulates for a specific purpose</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accrue</ns0:orth>
        <ns0:pron>/əˈkɹu/</ns0:pron>
        <ns0:pron>/əˈkɹuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aumentar</ns0:quote>
          <ns0:quote>acrecentarse</ns0:quote>
          <ns0:quote>acrecer</ns0:quote>
          <ns0:quote>acrecerse</ns0:quote>
          <ns0:quote>acumular</ns0:quote>
          <ns0:quote>aumentarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To increase, to rise</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>devengar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, accounting) To be incurred as a result of the passage of time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acumular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To accumulate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adquirir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, legal) To become an enforceable and permanent right.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accrued</ns0:orth>
        <ns0:pron>/əˈkɹuːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acrecentado</ns0:quote>
          <ns0:quote>acrecido</ns0:quote>
          <ns0:quote>acumulado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having increased through accrual; having risen over time or due to financial transactions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acculturate</ns0:orth>
        <ns0:pron>/əˈkʌl.t͡ʃəˌɹeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aculturar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To change the culture of (a person) by the influence of another culture, especially a more dominant culture.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To cause (a person) to acquire the culture of a society (or of a region, industry, or company), as in the case of children growing up in that culture, immigrants learning that culture, or new hires learning the ropes of a job.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acculturation</ns0:orth>
        <ns0:pron>/əˌkʌl.t͡ʃəˈɹeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aculturación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A process by which the culture of an isolated society changes on contact with a different one.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A process by which a person acquires the culture of the society that they inhabit, starting at birth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
