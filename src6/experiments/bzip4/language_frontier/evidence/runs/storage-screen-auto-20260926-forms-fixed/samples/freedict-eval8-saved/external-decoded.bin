      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>be</ns0:orth>
        <ns0:pron>/bi/</ns0:pron>
        <ns0:pron>/biː/</ns0:pron>
        <ns0:pron>/bɪ/</ns0:pron>
        <ns0:pron>[bi(ː)]</ns0:pron>
        <ns0:pron>[biː]</ns0:pron>
        <ns0:pron>[bɪj]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estar</ns0:quote>
          <ns0:quote>ser</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(formal) Used with to-infinitives of verbs to express intent, obligation, appropriateness, or relative future occurrence.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(often, impersonal, with it as a dummy subject) Used to indicate ambient conditions such as weather, light, noise or air quality.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(in perfect tenses) Elliptical form of "be here", "go to and return from" or similar, also extending to certain other senses of "go".</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ser</ns0:quote>
          <ns0:quote>estar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used with past participles of certain intransitive verbs to form the perfect aspect.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Used to declare the subject and object identical or equivalent.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Used to indicate that the subject has the qualities described by a noun or noun phrase.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Used to indicate that the subject has the qualities described by an adjective or prepositional phrase.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To occur, to take place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ser</ns0:quote>
          <ns0:quote>seer</ns0:quote>
          <ns0:quote>estar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(auxiliary) Used with past participles of verbs to form the passive voice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ser</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to link a subject to a measurement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ser</ns0:quote>
          <ns0:quote>estar</ns0:quote>
          <ns0:quote>tener</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare, and, regional, chiefly, in the past tense) Used to link two noun clauses: a day of the week, recurring date, month, or other specific time (on which the event of the main clause took place) and a period of time indicating how long ago that day was. [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tener</ns0:quote>
          <ns0:quote>estar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(with a cardinal numeral) Used to state the age of a subject in years.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estar</ns0:quote>
          <ns0:quote>ser</ns0:quote>
          <ns0:quote>radicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To occupy a place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ser</ns0:quote>
          <ns0:quote>haber</ns0:quote>
          <ns0:quote>existir</ns0:quote>
          <ns0:quote>seer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, usually, literary) To exist; to have real existence, to be alive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
