      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hitita</ns0:quote>
          <ns0:quote>heteo</ns0:quote>
          <ns0:quote>hetita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person of the Hittite Kingdom, a Bronze Age kingdom of Anatolia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hittite</ns0:orth>
        <ns0:pron>/ˈhɪ.taɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hitita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient Indo-European language of the Anatolian branch, attested from the 16th century BC until the 13th century BC.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hmong</ns0:orth>
        <ns0:pron>/h(ə)ˈmɑŋ/</ns0:pron>
        <ns0:pron>/h(ə)ˈmɒŋ/</ns0:pron>
        <ns0:pron>/h(ə)ˈmɔŋ/</ns0:pron>
        <ns0:pron>/ˈmɑŋ/</ns0:pron>
        <ns0:pron>/ˈmɒŋ/</ns0:pron>
        <ns0:pron>/ˈmɔŋ/</ns0:pron>
        <ns0:pron>/ˈmʌŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hmong</ns0:quote>
          <ns0:quote>miao</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A people who live predominantly in the mountainous regions of China, Vietnam, Laos, and Thailand, and (in diaspora) around the world.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ho Chi Minh City</ns0:orth>
        <ns0:pron>/ˌhəʊ tʃiː ˌmɪn ˈsɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ciudad Ho Chi Minh</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest city of Vietnam.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hobson-Jobson</ns0:orth>
        <ns0:pron>/ˌhɑb.sənˈdʒɑb.sən/</ns0:pron>
        <ns0:pron>/ˌhɒb.sənˈdʒɒb.sən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>traducción mocosuena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics, countable) A word or phrase borrowed by one language from another and modified in pronunciation to fit the set of sounds the borrowing language typically uses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hodgkin's lymphoma</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>linfoma de Hodgkin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease, oncology) A malignant lymphoid neoplasm characterized by the formation of large tumour cells (Reed-Sternberg cells) in the lymph nodes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hogwarts</ns0:orth>
        <ns0:pron>/ˈhɒɡ.wɔːts/</ns0:pron>
        <ns0:pron>/ˈhɒɡ.wəts/</ns0:pron>
        <ns0:pron>/ˈhɔɡ.wɔɹts/</ns0:pron>
        <ns0:pron>/ˈhɔɡ.wɚts/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hogwarts</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hogwarts School of Witchcraft and Wizardry, a school for learning magic in J.K. Rowling's Harry Potter series.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hokkaido</ns0:orth>
        <ns0:pron>/hɑˈkaɪdoʊ/</ns0:pron>
        <ns0:pron>/hɒˈkaɪdəʊ/</ns0:pron>
        <ns0:pron>/həˈkaɪdoʊ/</ns0:pron>
        <ns0:pron>/həˈkaɪdəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hokkaido</ns0:quote>
          <ns0:quote>Hokkaidō</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The second largest island of Japan, capital Sapporo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holi</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>holi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Hindu festival, held in the spring, during which people throw coloured powders at each other during noisy street celebrations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holland</ns0:orth>
        <ns0:pron>/ˈhɑlənd/</ns0:pron>
        <ns0:pron>/ˈhɒlənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Holanda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A traditional region of the Netherlands formed by two modern provinces, North Holland and South Holland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Hollywood</ns0:orth>
        <ns0:pron>/ˈhɑ.li.wʊd/</ns0:pron>
        <ns0:pron>/ˈhɒ.li.wʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Hollywood</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A neighbourhood of Los Angeles, California, known as the center of the American motion picture industry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(metonym) The American motion picture industry, regardless of location.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holmesian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>holmesiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the fictional detective Sherlock Holmes or his investigations, methods, or sayings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holocaust</ns0:orth>
        <ns0:pron>/ˈhɑləkɑst/</ns0:pron>
        <ns0:pron>/ˈhɑləkɔst/</ns0:pron>
        <ns0:pron>/ˈhɒləkɔːst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Holocausto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, broadly) The systematic mass murder (democide) of somewhere between eleven and fourteen million people, namely six million Jews and from five to eight million others (including Romanis, Slavs, homosexuals, and people with physical and mental disabilities), perpetrated by Nazi Germany shortly before and during World War II.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holohoax</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Holocuento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(offensive, used by Holocaust deniers) The Holocaust viewed as an event which is fabricated and did not happen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Communion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eucaristía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Christian sacrament of the Eucharist; (in particular) the reception of the body and blood of Christ (the consecrated bread and wine), which is believed to bring about communion between the recipient and Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Cross</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santa Cruz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The historical cross on which Christ died.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Family</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sagrada Familia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) Jesus and his parents: Jesus Christ, Saint Mary, and Saint Joseph.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Father</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santo Padre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The title of the Pope of the Catholic Church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Grail</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>santo grial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Anything that is highly sought-after but attained only through difficult endeavor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Grail</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santo Grial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Arthurian mythology) An artifact in Arthurian mythology, being the cup used by Christ at the Last Supper and in which some of his blood was caught during the crucifixion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Land</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tierra Santa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Judaism, Christianity, Islam) That part of the Middle East, consisting mostly of Israel and Palestine, in which most Biblical events are set.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Prepuce</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santo Prepucio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several sacred or holy foreskins (Latin sānctum praepūtium) allegedly from the circumcision of the baby Jesus on the eighth day of his life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Roman Empire</ns0:orth>
        <ns0:pron>/ˈhoʊli ˈɹoʊmən ˈɛmpaɪɚ/</ns0:pron>
        <ns0:pron>/ˈhəʊli ˈɹəʊmən ˈɛmpaɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sacro Imperio Romano Germánico</ns0:quote>
          <ns0:quote>Sacro Imperio Romano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former polity and medieval empire forming a loose conglomeration of largely independent mostly Germanic entities in Central Europe from at least 962 C.E. until 1806. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Saturday</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sábado Santo</ns0:quote>
          <ns0:quote>Sábado de Gloria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Saturday immediately after Good Friday and before Easter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy See</ns0:orth>
        <ns0:pron>/ˌhəʊli ˈsiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santa Sede</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The episcopal jurisdiction of the Bishop of Rome, commonly known as the Pope. It is the preeminent see of the Catholic Church. It is also the sovereign entity headed by the Pope which governs the Vatican and represents the Catholic Church in temporal affairs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Spirit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Espíritu Santo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The person (hypostasis) of the Trinity or Godhead corresponding to divine essence present in the faithful (particularly inspired prophets) and considered to proceed either from (Eastern Orthodoxy) God the Father alone or (Roman Catholicism) from Him together with God the Son.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Trinity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Santísima Trinidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The three persons of the Godhead: the Father, Son, and Holy Spirit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Week</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Semana Santa</ns0:quote>
          <ns0:quote>Semana de Turismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The week preceding Easter; each of its days is a holy day.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy Writ</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sagrada Escritura</ns0:quote>
          <ns0:quote>Biblia</ns0:quote>
          <ns0:quote>Sagradas Escrituras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Bible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sagradas Escrituras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sacred writings of the Christian religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Holy of Holies</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sanctasanctórum</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively, by extension) The most sacred place within a sacred building.</ns0:def>
        </ns0:sense>
