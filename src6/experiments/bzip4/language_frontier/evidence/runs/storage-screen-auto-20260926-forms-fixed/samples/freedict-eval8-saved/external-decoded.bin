        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of related dialects of Low German, spoken in northern Germany and parts of the Netherlands, formerly also in Denmark.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
