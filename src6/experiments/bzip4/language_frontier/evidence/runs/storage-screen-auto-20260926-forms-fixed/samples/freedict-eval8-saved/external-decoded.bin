          <ns0:quote>rebasar la creencia</ns0:quote>
          <ns0:quote>resultar totalmente inverosímil</ns0:quote>
          <ns0:quote>sobrepasar el entendimiento</ns0:quote>
          <ns0:quote>sobreponerse a la credibilidad</ns0:quote>
        </ns0:cit>
