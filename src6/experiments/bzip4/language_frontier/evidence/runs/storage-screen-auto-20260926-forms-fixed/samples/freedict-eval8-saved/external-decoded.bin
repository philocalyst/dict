        </ns0:cit>
        <ns0:sense>
          <ns0:def>A census-designated place in Fairbanks North Star Borough, Alaska.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A city and town in Manitowoc County, Wisconsin.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A placename:</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An unincorporated community in Plumas County, California.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Synonym of Mesopotamia.</ns0:def>
