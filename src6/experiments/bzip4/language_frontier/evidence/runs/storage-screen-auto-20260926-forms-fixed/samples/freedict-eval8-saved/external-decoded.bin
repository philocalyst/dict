        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Caribe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A continental region centered on the Caribbean Sea, consisting of those countries located in the sea and in bordering areas of South America and Central America.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
