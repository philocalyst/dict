        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gurja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the dominant ethnic group in Nepal, with a Himalayan diaspora.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A member of this people recruited to serve in their own elite units in the British and Indian armies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gurmukhi</ns0:orth>
