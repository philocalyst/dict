      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autobiógrafo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who writes his or her own life or biography.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
