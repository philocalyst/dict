        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in central Spain, about 11 km southwest of central Madrid</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Legionnaires' disease</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>legionela</ns0:quote>
          <ns0:quote>legionelosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) a form of severe pneumonia caused by legionella (bacteria of the genus Legionella).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
