      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frisbee</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A disk-shaped gliding toy, sold under the brand name Frisbee.</ns0:def>
        </ns0:sense>
      </ns0:sense>
