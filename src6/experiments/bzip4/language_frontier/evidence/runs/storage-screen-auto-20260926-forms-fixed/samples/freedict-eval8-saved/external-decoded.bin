        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Tibetan Buddhism) The second-highest-ranking lama of the Gelug sect of Tibetan Buddhism, after the Dalai Lama.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
