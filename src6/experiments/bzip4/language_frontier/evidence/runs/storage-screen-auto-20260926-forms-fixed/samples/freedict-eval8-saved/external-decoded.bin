          <ns0:quote>punto básico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) One hundredth of one percentage point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bask</ns0:orth>
        <ns0:pron>/bæsk/</ns0:pron>
