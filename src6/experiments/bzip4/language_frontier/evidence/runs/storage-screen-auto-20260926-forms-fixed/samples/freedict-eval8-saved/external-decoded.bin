      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abomaso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology, food) The fourth digestive compartment of the stomach of a cow or other ruminant, after the omasum;the lining of said compartment, considered as a foodstuff.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abominable</ns0:orth>
