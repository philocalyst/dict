    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sixto-Clementine</ns0:orth>
        <ns0:pron>/ˌsɪkstəʊˈklɛməntaɪn/</ns0:pron>
        <ns0:pron>/ˌsɪkstəʊˈklɛməntʌɪn/</ns0:pron>
        <ns0:pron>[ˌsɪkstəʊˈklɛmn̩tʌɪn]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sixtoclementino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or designating the edition or text of the Vulgate (1592, corrected in 1593 and 1598), correcting that of Pope Sixtus V (r. 1585–90), which was revised on the orders of Pope Clement VIII (r. 1592–1605).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sjögren's syndrome</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>síndrome de Sjögren</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An autoimmune disorder in which immune cells attack and destroy the exocrine glands that produce tears and saliva.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Skene's gland</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>glándulas de Skene</ns0:quote>
          <ns0:quote>glándulas parauretrales</ns0:quote>
          <ns0:quote>glándulas uretrales</ns0:quote>
          <ns0:quote>glándulas vestibulares menores</ns0:quote>
          <ns0:quote>próstata femenina</ns0:quote>
          <ns0:quote>punto U</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gland of a group of glands in the vagina that drains into the urethra and is related to pleasure during sexual arousal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
