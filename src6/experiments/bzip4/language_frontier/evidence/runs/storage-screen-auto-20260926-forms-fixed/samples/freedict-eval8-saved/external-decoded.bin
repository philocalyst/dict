          <ns0:quote>debido a</ns0:quote>
          <ns0:quote>por</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>because</ns0:orth>
        <ns0:pron>/biˈkɔz/</ns0:pron>
        <ns0:pron>/biˈkʌz/</ns0:pron>
        <ns0:pron>/biːˈkɔːz/</ns0:pron>
        <ns0:pron>/bəˈkɒz/</ns0:pron>
        <ns0:pron>/bəˈkɔz/</ns0:pron>
        <ns0:pron>/bəˈkɔːz/</ns0:pron>
        <ns0:pron>/bəˈkʌz/</ns0:pron>
        <ns0:pron>/bɪkəz/</ns0:pron>
        <ns0:pron>/bɪˈkeɪz/</ns0:pron>
        <ns0:pron>/bɪˈkɑːz/</ns0:pron>
        <ns0:pron>/bɪˈkɒz/</ns0:pron>
        <ns0:pron>/bɪˈkɔz/</ns0:pron>
        <ns0:pron>/bɪˈkɔːs/</ns0:pron>
        <ns0:pron>/bɪˈkɔːz/</ns0:pron>
        <ns0:pron>/bɪˈkʌz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>porque</ns0:quote>
          <ns0:quote>ya que</ns0:quote>
          <ns0:quote>pues</ns0:quote>
          <ns0:quote>ca</ns0:quote>
          <ns0:quote>por cuanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>By or for the cause that; on this account that; for the reason that.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>por cuanto</ns0:quote>
          <ns0:quote>ya que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As is known, inferred, or determined from the fact that.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>because</ns0:orth>
        <ns0:pron>/biˈkɔz/</ns0:pron>
        <ns0:pron>/biˈkʌz/</ns0:pron>
        <ns0:pron>/biːˈkɔːz/</ns0:pron>
        <ns0:pron>/bəˈkɒz/</ns0:pron>
        <ns0:pron>/bəˈkɔz/</ns0:pron>
        <ns0:pron>/bəˈkɔːz/</ns0:pron>
        <ns0:pron>/bəˈkʌz/</ns0:pron>
        <ns0:pron>/bɪkəz/</ns0:pron>
        <ns0:pron>/bɪˈkeɪz/</ns0:pron>
        <ns0:pron>/bɪˈkɑːz/</ns0:pron>
        <ns0:pron>/bɪˈkɒz/</ns0:pron>
        <ns0:pron>/bɪˈkɔz/</ns0:pron>
        <ns0:pron>/bɪˈkɔːs/</ns0:pron>
        <ns0:pron>/bɪˈkɔːz/</ns0:pron>
        <ns0:pron>/bɪˈkʌz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>porque no</ns0:quote>
          <ns0:quote>porque sí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used alone to refuse to provide a full answer to a question begun with "why", usually taken as an anapodoton of the elided full phrase "Because I said so".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>because of</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a causa de</ns0:quote>
          <ns0:quote>debido a</ns0:quote>
          <ns0:quote>por mor de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On account of; due to, for the purpose of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beckon</ns0:orth>
        <ns0:pron>/ˈbɛkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deseñar</ns0:quote>
          <ns0:quote>hacer ademanes para que se acerque</ns0:quote>
          <ns0:quote>hacer gestos para que venga</ns0:quote>
          <ns0:quote>llamar con señas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To wave or nod to somebody with the intention to make the person come closer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atraer</ns0:quote>
          <ns0:quote>llamar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To seem attractive and inviting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>become</ns0:orth>
        <ns0:pron>/biˈkʌm/</ns0:pron>
        <ns0:pron>/bəˈkʊm/</ns0:pron>
        <ns0:pron>/bəˈkʌm/</ns0:pron>
        <ns0:pron>/bɪˈkʊm/</ns0:pron>
        <ns0:pron>/bɪˈkʌm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quedar bien</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>convertir</ns0:quote>
          <ns0:quote>hacer</ns0:quote>
          <ns0:quote>volver</ns0:quote>
          <ns0:quote>llegar a ser</ns0:quote>
          <ns0:quote>devenir [en]</ns0:quote>
          <ns0:quote>transformarse en</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be proper for; to beseem. [from 13th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>becoming</ns0:orth>
        <ns0:pron>/bəˈkʌm.ɪŋ/</ns0:pron>
        <ns0:pron>/bɪˈkʊm.ɪŋɡ/</ns0:pron>
        <ns0:pron>/bɪˈkʌm.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>devenir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, philosophy) The act or process by which something becomes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>becquerel</ns0:orth>
        <ns0:pron>[bɛkəˈɹɛɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>becquerelio</ns0:quote>
          <ns0:quote>becquerel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the International System of Units, the derived unit of radioactive activity; the activity of a quantity of radioactive material in which one nucleus decays per second. Symbol: Bq</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bed</ns0:orth>
        <ns0:pron>/bed/</ns0:pron>
        <ns0:pron>/bɛd/</ns0:pron>
        <ns0:pron>[beː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cama</ns0:quote>
          <ns0:quote>lecho</ns0:quote>
          <ns0:quote>camastro</ns0:quote>
          <ns0:quote>camucha</ns0:quote>
          <ns0:quote>catre</ns0:quote>
          <ns0:quote>catrera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A piece of furniture, usually flat and soft, on which to rest or sleep.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A shaped piece of timber to hold a cask clear of a ship’s floor; a pallet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batea</ns0:quote>
          <ns0:quote>caja</ns0:quote>
          <ns0:quote>cama</ns0:quote>
          <ns0:quote>paila</ns0:quote>
          <ns0:quote>palangana</ns0:quote>
          <ns0:quote>platón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, Canada, automotive) The platform of a truck, trailer, wagon, railcar, or other vehicle that supports the load to be hauled.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lecho</ns0:quote>
          <ns0:quote>cama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) The bottom of a body of water, such as an ocean, sea, lake, or river. [from later 16thc.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A place, or flat surface or layer, on which something else rests or is laid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bed</ns0:orth>
        <ns0:pron>/bed/</ns0:pron>
        <ns0:pron>/bɛd/</ns0:pron>
        <ns0:pron>[beː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encamarse</ns0:quote>
          <ns0:quote>irse a la cama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To go to bed; to put oneself to sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bed and board</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cama y alojamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place to sleep and eat; bed and breakfast; the services provided by an inn or similar establishment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bed and breakfast</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bed and breakfast</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A private home, guesthouse, small hotel etc. where guests are provided overnight accommodations and served breakfast but usually no other meals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bed of roses</ns0:orth>
        <ns0:pron>/bɛd ʌv ˈɹəʊzəz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>camino de rosas</ns0:quote>
          <ns0:quote>jauja</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedbug</ns0:orth>
        <ns0:pron>/ˈbɛdˌbʌɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chinche</ns0:quote>
          <ns0:quote>chinche de cama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small nocturnal insect pest of humans, of species Cimex lectularius (common bedbug) and Cimex hemipterus (tropical bedbug) that feeds on the blood of humans during sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedclothes</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ropa de cama</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedding</ns0:orth>
        <ns0:pron>/ˈbɛdɪŋ/</ns0:pron>
        <ns0:pron>[ˈbɛɾɪŋ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ropa de cama</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any material used by or provided to animals to lie on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedding plane</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plano de estratificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) The planar surface between adjacent strata</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedevil</ns0:orth>
        <ns0:pron>/biˈdɛvəl/</ns0:pron>
        <ns0:pron>/bɪˈdɛvəl/</ns0:pron>
        <ns0:pron>[bɪˈdɛvəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atormentar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To harass or cause trouble for; to plague.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedhead</ns0:orth>
        <ns0:pron>/ˈbɛd.hɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pelo descuidado</ns0:quote>
          <ns0:quote>pelo desordenado</ns0:quote>
          <ns0:quote>pelo despeinado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(colloquial) The condition of having unkempt hair, generally as a result of having just woken up from sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedlam</ns0:orth>
        <ns0:pron>/ˈbɛdləm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pandemonio</ns0:quote>
          <ns0:quote>caos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place or situation of chaotic uproar, and where confusion prevails.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedouin</ns0:orth>
        <ns0:pron>/ˈbɛd.(ə.)wɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beduino</ns0:quote>
          <ns0:quote>beduina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of nomadic Arab tribes dwelling in the desert.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedpan</ns0:orth>
        <ns0:pron>/ˈbɛdˌpæn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pato</ns0:quote>
          <ns0:quote>chata</ns0:quote>
          <ns0:quote>conejo</ns0:quote>
          <ns0:quote>cuña</ns0:quote>
          <ns0:quote>galanga</ns0:quote>
          <ns0:quote>gallo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pan used for urination and defecation while in bed, now usually for reasons of medical necessity or convenience.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedridden</ns0:orth>
        <ns0:pron>/ˈbɛdɹɪdən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encamado</ns0:quote>
          <ns0:quote>postrado en cama</ns0:quote>
          <ns0:quote>confinado en cama</ns0:quote>
          <ns0:quote>limitado a la cama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Confined to bed because of infirmity or illness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedrock</ns0:orth>
        <ns0:pron>/ˈbɛd.ɹɒk/</ns0:pron>
        <ns0:pron>/ˈbɛdˌɹɑk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>roca madre</ns0:quote>
          <ns0:quote>lecho pétreo</ns0:quote>
          <ns0:quote>material rocoso</ns0:quote>
          <ns0:quote>roca firme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable, geology, mining, engineering, construction) The solid rock found at some depth below the ground surface.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedroom</ns0:orth>
        <ns0:pron>/ˈbɛdɹuːm/</ns0:pron>
        <ns0:pron>/ˈbɛdɹʊm/</ns0:pron>
        <ns0:pron>/ˈbɛdˌɹum/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dormitorio</ns0:quote>
          <ns0:quote>alcoba</ns0:quote>
          <ns0:quote>cuarto</ns0:quote>
          <ns0:quote>habitación</ns0:quote>
          <ns0:quote>pieza</ns0:quote>
          <ns0:quote>recámara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A room in a house, apartment, hotel, or other dwelling where a bed is kept for sleeping.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedroom community</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ciudad dormitorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(urban studies) A suburban, exurban, or urban community that is primarily or exclusively residential, as due to zoning, from which most of the workforce commutes out to earn their livelihood; often a suburb of a nearby metropolis that workers travel to daily.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedsheet</ns0:orth>
        <ns0:pron>/ˈbɛdʃiːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sábana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sheet, a piece of cloth cut and finished as bedlinen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedside manner</ns0:orth>
        <ns0:pron>/ˌbɛdsaɪd ˈmænə/</ns0:pron>
        <ns0:pron>/ˌbɛdˌsaɪd ˈmænɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>circunspección clínica</ns0:quote>
          <ns0:quote>delicadeza nosocomial</ns0:quote>
          <ns0:quote>discreción hospitalaria</ns0:quote>
          <ns0:quote>tacto médico</ns0:quote>
          <ns0:quote>tiento facultativo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedsore</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escara</ns0:quote>
          <ns0:quote>úlcera por presión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, usually, in the plural, dated) A lesion caused by unrelieved pressure to any part of the body, especially portions over bony or cartilaginous areas, such as frequently develops on a person confined to a bed by infirmity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedspread</ns0:orth>
        <ns0:pron>/ˈbɛd.spɹɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cubrecama</ns0:quote>
          <ns0:quote>colcha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The topmost covering of a bed, often functioning as a blanket.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedstead</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bastidor / marco de cama</ns0:quote>
          <ns0:quote>cama (sin colchón)</ns0:quote>
          <ns0:quote>cuja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The framework that supports a bed; the rigid structural components of a bed, excluding the mattress, box spring, etc; bedframe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedtime</ns0:orth>
        <ns0:pron>/ˈbɛdtaɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hora de dormir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The time or hour at which one retires to bed in order to sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedwetter</ns0:orth>
        <ns0:pron>/ˈbɛdwɛtɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mojacamas</ns0:quote>
          <ns0:quote>meona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who (habitually) urinates in their bed (during sleep).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bedwetting</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enuresis nocturna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of urinary incontinence involving involuntary urination while in bed during sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bee</ns0:orth>
        <ns0:pron>/ˈbiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>be</ns0:quote>
          <ns0:quote>be alta</ns0:quote>
          <ns0:quote>be larga</ns0:quote>
          <ns0:quote>be grande</ns0:quote>
          <ns0:quote>be labial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of the Latin-script letter B/b.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abeja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, proscribed) Any stinging flying insect, especially a wasp.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bee fly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bombílido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the flies in the family Bombyliidae, with adults that look like bumblebees and larvae that are parasitic on the eggs or larvae of other insects.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bee hummingbird</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colibrí zunzuncito</ns0:quote>
          <ns0:quote>zunzuncito</ns0:quote>
          <ns0:quote>elfo de las abejas</ns0:quote>
          <ns0:quote>pájaro mosca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A species of hummingbird, Mellisuga helenae, native to Cuba, noted for being the smallest living bird.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bee sting</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>picadura de abeja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hypodermic puncture from a bee, resulting in envenomation and often involving the penetration and lodging of the stinger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bee-eater</ns0:orth>
        <ns0:pron>/ˈbiː iːtəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abejaruco</ns0:quote>
          <ns0:quote>merópido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various brightly-coloured, insectivorous, near-passerine birds in the family Meropidae, especially the European bee-eater, Merops apiaster.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beebread</ns0:orth>
        <ns0:pron>/ˈbiːˌbɹɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pan de abeja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Bee pollen with added honey and bee secretions, made and stored in brood cells by forager bees, and used as food for worker bees and larvae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beech</ns0:orth>
        <ns0:pron>/biːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>haya</ns0:quote>
          <ns0:quote>pellín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tree of the genus Fagus having a smooth, light grey trunk, oval, pointed leaves, and many branches.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beech marten</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>garduña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Martes foina, a marten of Eurasia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beechnut</ns0:orth>
        <ns0:pron>/ˈbiːt͡ʃˌnʌt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hayuco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The small, triangular, edible nut of the beech tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beechwood</ns0:orth>
        <ns0:pron>/ˈbit͡ʃˌwʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hayedo</ns0:quote>
          <ns0:quote>hayal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wood largely populated with beech trees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beef</ns0:orth>
        <ns0:pron>/bif/</ns0:pron>
        <ns0:pron>/biːf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carne de res</ns0:quote>
          <ns0:quote>carne de vaca</ns0:quote>
          <ns0:quote>carne bovina</ns0:quote>
          <ns0:quote>rotí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(in the meat industry, on, _, product packaging) The edible portions of a cow (including those which are not meat).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The meat from cattle or other bovines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animosidad</ns0:quote>
          <ns0:quote>aversión</ns0:quote>
          <ns0:quote>bronca</ns0:quote>
          <ns0:quote>contienda</ns0:quote>
          <ns0:quote>discordia</ns0:quote>
          <ns0:quote>disputa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, uncountable, or, countable, plural beefs) A grudge; dislike (of something or someone); lack of faith or trust (in something or someone); a reason for a dislike or grudge. (often + with)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beefsteak</ns0:orth>
        <ns0:pron>/ˈbiːfˌsteɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bistec</ns0:quote>
          <ns0:quote>bife</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) (A) steak cut from a cattle beast (e.g., cow, steer).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beefy</ns0:orth>
        <ns0:pron>/ˈbiːfi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carnoso</ns0:quote>
          <ns0:quote>carnudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Similar to, or tasting like beef.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cárnico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Containing beef.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beehive</ns0:orth>
        <ns0:pron>/ˈbiːhaɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colmena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Such a home prepared by the bees themselves, in which some species of honey bees live and raise their young.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colmena</ns0:quote>
          <ns0:quote>dujo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A man-made structure in which honey bees are kept so that humans can harvest their honey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beehive</ns0:quote>
          <ns0:quote>colmena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A women's hairstyle, popular in the 1960s, in which long hair is styled into a hive-shaped form on top of the head and usually held in place with lacquer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beekeeper</ns0:orth>
        <ns0:pron>/ˈbiˌkipɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apicultor</ns0:quote>
          <ns0:quote>colmenero</ns0:quote>
          <ns0:quote>abejera</ns0:quote>
          <ns0:quote>abejero</ns0:quote>
          <ns0:quote>apicultora</ns0:quote>
          <ns0:quote>colmenera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who maintains hives and keeps bees, especially for the production of honey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beekeeping</ns0:orth>
        <ns0:pron>/ˈbiːˌkiːpɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apicultura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The practice or profession of keeping and caring for bees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beeline</ns0:orth>
        <ns0:pron>/ˈbiːlaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a vuelo de pájaro</ns0:quote>
          <ns0:quote>derecera</ns0:quote>
          <ns0:quote>derechera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mining, chiefly, historical) A dynamite fuse made with a small quantity of dynamite powder along its length, so that the spark travels quickly and at a specific known rate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>been there, done that</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya fui y volví</ns0:quote>
          <ns0:quote>yo lo hice antes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, ironic) An assertion that the speaker has personal experience or knowledge of a particular place or topic and is not too keen on revisiting or redoing it again.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beep</ns0:orth>
        <ns0:pron>/biːp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pitido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A short, electronically produced tone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer</ns0:orth>
        <ns0:pron>/bia̯(ɾ)/</ns0:pron>
        <ns0:pron>/biə/</ns0:pron>
        <ns0:pron>/biɹ/</ns0:pron>
        <ns0:pron>/biːɾ/</ns0:pron>
        <ns0:pron>/bɛː/</ns0:pron>
        <ns0:pron>/bɪə/</ns0:pron>
        <ns0:pron>/bɪɚ/</ns0:pron>
        <ns0:pron>/bɪɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cerveza</ns0:quote>
          <ns0:quote>birra</ns0:quote>
          <ns0:quote>birria</ns0:quote>
          <ns0:quote>chela</ns0:quote>
          <ns0:quote>sersia / servatina / servantina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) An alcoholic drink fermented from starch material, commonly barley malt; often with hops or some other substance (like gruit) to impart a bitter flavor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cerveza</ns0:quote>
          <ns0:quote>caña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A glass, bottle, or can of any of the above beverages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer and skittles</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no todo el monte es orégano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, UK, idiomatic) Fun times; pleasure and leisure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer belly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barriga cervecera</ns0:quote>
          <ns0:quote>panza chelera</ns0:quote>
          <ns0:quote>lonja</ns0:quote>
          <ns0:quote>pancho</ns0:quote>
          <ns0:quote>panza de birra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A protruding belly caused by excess fat stored in the abdomen and colloquially attributed to the consumption of beer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer bong</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tuberia de barrilete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A funnel used to rapidly drink large quantities of an alcoholic beverage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer can</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lata de cerveza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lightweight metallic can containing beer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer mat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>posavasos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small square, circular or differently shaped cardboard mat, often with an advertisement for a brewery on it, that is used to rest one's glass on, and to protect the surface of a table or a bar in a pub.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beer parlour</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cervecería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Canada, Nigeria) A bar, selling beer, that has tables where customers may congregate socially.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beeswarm</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enjambre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A swarm of bees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beeswax</ns0:orth>
        <ns0:pron>/ˈbiːzwæks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cera de abeja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wax secreted by bees from which they make honeycomb; or, the processed form of this wax used in the manufacture of various goods.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beet</ns0:orth>
        <ns0:pron>/biːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>remolacha</ns0:quote>
          <ns0:quote>betabel</ns0:quote>
          <ns0:quote>betarraga</ns0:quote>
          <ns0:quote>betarrata</ns0:quote>
          <ns0:quote>beterraga</ns0:quote>
          <ns0:quote>beterava</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Beta vulgaris, a plant with a swollen root which is eaten or used to make sugar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beetle</ns0:orth>
        <ns0:pron>/ˈbiːtəl/</ns0:pron>
        <ns0:pron>[ˈbiɾəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escarabajo</ns0:quote>
          <ns0:quote>acatanca</ns0:quote>
          <ns0:quote>catanga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of numerous species of insect in the order Coleoptera characterized by a pair of hard, shell-like front wings which cover and protect a pair of rear wings when at rest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beetroot</ns0:orth>
        <ns0:pron>/ˈbi.t͡ʃɹyʔ/</ns0:pron>
        <ns0:pron>/ˈbit.ɹut/</ns0:pron>
        <ns0:pron>/ˈbiː.tɹʉːt/</ns0:pron>
        <ns0:pron>/ˈbiːt.ɹuːt/</ns0:pron>
        <ns0:pron>[ˈbiː.t͡ʃɹʉːt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>remolacha</ns0:quote>
          <ns0:quote>betarraga</ns0:quote>
          <ns0:quote>beterraga</ns0:quote>
          <ns0:quote>betabel</ns0:quote>
          <ns0:quote>betarrata</ns0:quote>
          <ns0:quote>beterava</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>befall</ns0:orth>
        <ns0:pron>/bɪˈfɑl/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/bɪˈfɔl/</ns0:pron>
        <ns0:pron>/bɪˈfɔːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acaecer a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
