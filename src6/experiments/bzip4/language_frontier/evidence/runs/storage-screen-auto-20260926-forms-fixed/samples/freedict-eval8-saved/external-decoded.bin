        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golfo de Tonkín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gulf at the northwestern portion of the South China Sea, located off the coasts of northern Vietnam (Tonkin) and South China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gummy Bears</ns0:orth>
      </ns0:form>
