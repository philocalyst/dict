        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The leading Apostle in the New Testament: Saint Peter.</ns0:def>
        </ns0:sense>
        <ns0:sense>
