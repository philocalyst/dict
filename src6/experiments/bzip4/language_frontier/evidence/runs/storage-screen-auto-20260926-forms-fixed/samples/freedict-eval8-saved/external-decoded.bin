        <ns0:orth>barfly</ns0:orth>
        <ns0:pron>/bɑɹflaɪ/</ns0:pron>
        <ns0:pron>/bɑːflaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>borracho</ns0:quote>
          <ns0:quote>cierrabares</ns0:quote>
          <ns0:quote>parroquiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, pejorative) A person who spends much time in a bar or similar drinking establishment</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bargain</ns0:orth>
        <ns0:pron>/-ɡɪn/</ns0:pron>
        <ns0:pron>/bɑ(r).ɡen/</ns0:pron>
        <ns0:pron>/bɑ(r).ɡɛjn/</ns0:pron>
        <ns0:pron>/ˈbɑːɡən/</ns0:pron>
        <ns0:pron>/ˈbɑːɹɡən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ganga</ns0:quote>
          <ns0:quote>bicoca</ns0:quote>
          <ns0:quote>chollo</ns0:quote>
          <ns0:quote>momio</ns0:quote>
          <ns0:quote>pichincha</ns0:quote>
          <ns0:quote>trato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agreement between parties concerning the sale of property; or a contract by which one party binds themself to transfer the right to some property for a consideration, and the other party binds themself to receive the property and pay the consideration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ganga</ns0:quote>
          <ns0:quote>bicoca</ns0:quote>
          <ns0:quote>chollo</ns0:quote>
          <ns0:quote>momio</ns0:quote>
          <ns0:quote>pichincha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An item purchased for significantly less than the usual, or recommended, price</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bargain</ns0:orth>
        <ns0:pron>/-ɡɪn/</ns0:pron>
        <ns0:pron>/bɑ(r).ɡen/</ns0:pron>
        <ns0:pron>/bɑ(r).ɡɛjn/</ns0:pron>
        <ns0:pron>/ˈbɑːɡən/</ns0:pron>
        <ns0:pron>/ˈbɑːɹɡən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recatear</ns0:quote>
          <ns0:quote>regatear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To transfer for a consideration; to barter; to trade</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bargaining chip</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ficha negociable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone or something used as a leverage in negotiations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barge</ns0:orth>
        <ns0:pron>/bɑɹd͡ʒ/</ns0:pron>
        <ns0:pron>/bɑːd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barcaza</ns0:quote>
          <ns0:quote>lancha a remolque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(watercraft) A large flat-bottomed towed or self-propelled boat used mainly for river and canal transport of heavy goods or bulk cargo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barge in</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>irrumpir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To intrude; to enter or interrupt suddenly and without invitation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bariatric</ns0:orth>
        <ns0:pron>/ˌbæɹiˈætɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bariátrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Referring to the branch of medicine bariatrics, the treatment of obesity and weight problems.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bariatrics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bariatría</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barista</ns0:orth>
        <ns0:pron>/baˈɹis.ta/</ns0:pron>
        <ns0:pron>/baˈɾis.ta/</ns0:pron>
        <ns0:pron>/bəˈɹis.tə/</ns0:pron>
        <ns0:pron>/bəˈɹiːs.tə/</ns0:pron>
        <ns0:pron>/bəˈɹɪs.tə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who prepares coffee in a coffee shop for customers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barita</ns0:quote>
          <ns0:quote>baritina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A mineral, barium sulphate, with the chemical formula BaSO4.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baritone</ns0:orth>
        <ns0:pron>/ˈbæɹ.ɪ.toʊn/</ns0:pron>
        <ns0:pron>/ˈbæɹ.ɪ.təʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barítono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The male voice between tenor and bass.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The musical range between tenor and bass.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person, instrument, or group that performs in the range between tenor and bass.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baritone saxophone</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>saxofón barítono</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the saxophone family of woodwind instruments that is smaller than the bass saxophone but larger than the tenor saxophone, with a range of D♭2 to A4 or similar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barium</ns0:orth>
        <ns0:pron>/ˈbɛəɹɪəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The chemical element (symbol Ba) with an atomic number of 56. It is a soft, reactive, silvery alkaline earth metal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barium chloride</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cloruro de bario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) The barium salt of hydrochloric acid, BaCl2; it is toxic, and has been used as a rat poison.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bark</ns0:orth>
        <ns0:pron>/bɑɹk/</ns0:pron>
        <ns0:pron>/bɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ladrido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The short, loud, explosive sound uttered by a dog, a fox, and some other animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corteza</ns0:quote>
          <ns0:quote>cáscara</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) The exterior covering of the trunk and branches of a tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bricbarca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(watercraft) A vessel, typically with three (or more) masts, with the foremasts (or fore- and mainmasts) square-rigged, and mizzenmast schooner-rigged.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bark</ns0:orth>
        <ns0:pron>/bɑɹk/</ns0:pron>
        <ns0:pron>/bɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ladrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To make a short, loud, explosive noise with the vocal organs (said of animals, especially dogs).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To make a clamor; to make importunate outcries.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To speak sharply.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>descortezar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To strip the bark from; to peel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bark up the wrong tree</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>errar el tiro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To take the wrong approach to a situation; to follow a false lead; to attempt to solve a problem using mistaken assumptions about its true nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barker</ns0:orth>
        <ns0:pron>/ˈbɑː(ɹ)kɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cascador</ns0:quote>
          <ns0:quote>cascarillero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A person who removes needed or valuable tree bark, as on a cinnamon or cinchona plantation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barking</ns0:orth>
        <ns0:pron>/ˈbɑɹkɪŋ/</ns0:pron>
        <ns0:pron>/ˈbɑːkɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ladradera</ns0:quote>
          <ns0:quote>ladradura</ns0:quote>
          <ns0:quote>ladrería</ns0:quote>
          <ns0:quote>ladrerío</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barking dogs seldom bite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perro que ladra no muerde</ns0:quote>
          <ns0:quote>perro ladrador, poco mordedor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>People who make threats rarely carry them out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barley</ns0:orth>
        <ns0:pron>/ˈbɑɹli/</ns0:pron>
        <ns0:pron>/ˈbɑːli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cebada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cereal of the species Hordeum vulgare, or its grains, often used as food or to make beer and other malted drinks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barn</ns0:orth>
        <ns0:pron>[baɾn]</ns0:pron>
        <ns0:pron>[baːn]</ns0:pron>
        <ns0:pron>[bɐːn]</ns0:pron>
        <ns0:pron>[bɑɹn]</ns0:pron>
        <ns0:pron>[bɑɻn]</ns0:pron>
        <ns0:pron>[bɑːn]</ns0:pron>
        <ns0:pron>[bɒən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hórreo</ns0:quote>
          <ns0:quote>troje</ns0:quote>
          <ns0:quote>alfolí</ns0:quote>
          <ns0:quote>cilla</ns0:quote>
          <ns0:quote>cillero</ns0:quote>
          <ns0:quote>galpón</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barn</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nuclear physics) A unit of surface area equal to 10−28 square metres.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barn owl</ns0:orth>
        <ns0:pron>/ˈbɑɹn ˌaʊəl/</ns0:pron>
        <ns0:pron>/ˈbɑːn ˌaʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lechuza</ns0:quote>
          <ns0:quote>lechuza común</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An owl of the species Tyto alba, often having a white face and commonly found in barns and other farm buildings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barn swallow</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golondrina</ns0:quote>
          <ns0:quote>golondrina común</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hirundo rustica, the most widespread species of swallow in the world; a distinctive passerine bird with blue upperparts, a long, deeply forked tail and curved, pointed wings, is found in Europe, Asia, Africa and the Americas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barnacle</ns0:orth>
        <ns0:pron>/ˈbɑɹnəkl̩/</ns0:pron>
        <ns0:pron>/ˈbɑːnəkl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>percebe</ns0:quote>
          <ns0:quote>balano</ns0:quote>
          <ns0:quote>bálano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marine crustacean of the subclass Cirripedia that attaches itself to submerged surfaces such as tidal rocks or the bottoms of ships.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barnacle goose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barnacla cariblanca</ns0:quote>
          <ns0:quote>barnacla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A black and white species of bird within the family Anatidae from the northern hemisphere, Branta leucopsis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barnstar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cobestrella</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A decorative painted object or image, often in the shape of a five-pointed star but occasionally in a circular wagon-wheel style, used to adorn a barn.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(WMF jargon) An image posted on a wiki user's personal page by another user, as an informal award or form of recognition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baro-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baro-</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barometer</ns0:orth>
        <ns0:pron>/bəˈɹɑ.mə.tɚ/</ns0:pron>
        <ns0:pron>/bəˈɹɒm.ɪ.tə(ɹ)/</ns0:pron>
        <ns0:pron>/bəˈɹɔm.ɪ.tə(ɹ)/</ns0:pron>
        <ns0:pron>[bəˈɹɑ.mə.ɾɚ]</ns0:pron>
        <ns0:pron>[bəˈɹɔm.ɪ.ɾə(ɹ)]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument for measuring atmospheric pressure.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative, by extension) Anything used as a gauge or indicator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barometric</ns0:orth>
        <ns0:pron>/ˌbæɹəˈmɛtɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barométrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to atmospheric pressure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baron</ns0:orth>
        <ns0:pron>/ˈbæɹən/</ns0:pron>
        <ns0:pron>/ˈbɛəɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A baron of beef, a cut made up of a double sirloin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baroness</ns0:orth>
        <ns0:pron>/ˌbæ.ɹəˈnɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baronesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A woman holding a baronial title in her own right; a female ruler of a barony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baronial</ns0:orth>
        <ns0:pron>/bəˈɹəʊnɪəɫ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baronial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Belonging or relating to a baron or barons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barony</ns0:orth>
        <ns0:pron>/ˈbæ.ɹə.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baronía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The domain of a baron or baroness, usually as part of a larger kingdom or empire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barque</ns0:orth>
        <ns0:pron>/bɑɹk/</ns0:pron>
        <ns0:pron>/bɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bricbarca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sailing vessel of three or more masts, with all masts but the sternmost square-rigged, the sternmost being fore-and-aft-rigged</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrack</ns0:orth>
        <ns0:pron>/ˈbeɹ.ək/</ns0:pron>
        <ns0:pron>/ˈbæɹ.ək/</ns0:pron>
        <ns0:pron>/ˈbɛɹ.ək/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barraca</ns0:quote>
          <ns0:quote>cuartel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, chiefly, in the plural) A building for soldiers, especially within a garrison; originally referred to temporary huts, now usually to a permanent structure or set of buildings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barracuda</ns0:orth>
        <ns0:pron>/ˌbæɹəˈkuːdə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barracuda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any large marine fish of the genus Sphyraena that have elongated bodies, a projecting lower jaw, displaying prominent fang-shaped teeth, and are aggressive predators.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrage</ns0:orth>
        <ns0:pron>/bəˈɹɑʒ/</ns0:pron>
        <ns0:pron>/ˈbæɹɑːdʒ/</ns0:pron>
        <ns0:pron>/ˈbæɹɑːʒ/</ns0:pron>
        <ns0:pron>/ˈbæɹɪdʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>presa</ns0:quote>
          <ns0:quote>represa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An artificial obstruction, such as a dam, in a river designed to increase its depth or to divert its flow.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barrera de fuego</ns0:quote>
          <ns0:quote>bombardeo</ns0:quote>
          <ns0:quote>cortina de fuego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) A heavy curtain of artillery fire directed in front of one's own troops to screen and protect them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acribadura</ns0:quote>
          <ns0:quote>aluvión</ns0:quote>
          <ns0:quote>andanada</ns0:quote>
          <ns0:quote>pateadura</ns0:quote>
          <ns0:quote>raudal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) An overwhelming outburst of words, especially of criticism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barramundi</ns0:orth>
        <ns0:pron>/ˌbæɹəˈmʌndi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barramundi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A diadromous fish of species Lates calcarifer, of the Centropomidae family, order Perciformes, widely distributed in the Indo-West Pacific; a popular food fish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrator</ns0:orth>
        <ns0:pron>/ˈbæɹətɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>querulante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is guilty of barratry, vexing others with frequent and often groundless lawsuits; a brangler and pettifogger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barred antshrike</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batará barrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A passerine bird of the antbird family, of species Thamnophilus doliatus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barred warbler</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>curruca sahariana</ns0:quote>
          <ns0:quote>curruca gavilana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sylvia nisoria, an Old World warbler.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrel</ns0:orth>
        <ns0:pron>/ˈbæɹ(ə)l/</ns0:pron>
        <ns0:pron>/ˈbæɹəl/</ns0:pron>
        <ns0:pron>/ˈbæɹəɫ/</ns0:pron>
        <ns0:pron>/ˈbɛɚəl/</ns0:pron>
        <ns0:pron>/ˈbɛɹəl/</ns0:pron>
        <ns0:pron>[ˈbæɹəɫ]</ns0:pron>
        <ns0:pron>[ˈbɛɚəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barril</ns0:quote>
          <ns0:quote>tonel</ns0:quote>
          <ns0:quote>barrica</ns0:quote>
          <ns0:quote>bocoy</ns0:quote>
          <ns0:quote>cuñete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A round (cylindrical) vessel, such as a cask, of greater length than breadth, and bulging in the middle, made of staves bound with hoops, and having flat ends (heads). The word is sometimes applied to a similar cylindrical container made of metal, usually called a drum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caño</ns0:quote>
          <ns0:quote>barril</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Such a cask of a certain size, holding one-eighth of what a tun#Noun holds. (See a diagram comparing cask sizes.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barril</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quantity which constitutes a full barrel: the volume or weight this represents varies by local law and custom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cañón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A metallic tube, as of a gun, from which a projectile is discharged.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrel</ns0:orth>
        <ns0:pron>/ˈbæɹ(ə)l/</ns0:pron>
        <ns0:pron>/ˈbæɹəl/</ns0:pron>
        <ns0:pron>/ˈbæɹəɫ/</ns0:pron>
        <ns0:pron>/ˈbɛɚəl/</ns0:pron>
        <ns0:pron>/ˈbɛɹəl/</ns0:pron>
        <ns0:pron>[ˈbæɹəɫ]</ns0:pron>
        <ns0:pron>[ˈbɛɚəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embarrilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put or to pack in a barrel or barrels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ir disparado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To move quickly or in an uncontrolled manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrel bomb</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bomba de barril</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrel organ</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>organillo</ns0:quote>
          <ns0:quote>organito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A musical instrument in which air from a bellows is admitted to a set of pipes by means of pins inserted into a revolving barrel (typically turned by a crank), originating in France.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrel roll</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tonel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) An aerobatic flying maneuver in which the pilot causes the airplane to complete one loop in the same time that the airplane completes one roll, creating the appearance that the airplane is riding on the inside of a cylinder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vuelta de campana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A movement (usually during a car crash) where a car flips on its roof, then falls back on its wheels after doing at least one full 360° horizontal rotation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrel vault</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bóveda de cañón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A simple roof having a curved, often semicircular cross section; used to span large distances in railway stations, churches, etc. Usually supported on columns.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barren</ns0:orth>
        <ns0:pron>/ˈbæɹən/</ns0:pron>
        <ns0:pron>/ˈbɛəɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estéril</ns0:quote>
          <ns0:quote>infértil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of people and animals, not comparable) Not bearing children, childless; hence also unable to bear children, sterile.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of places) Of poor fertility, infertile; not producing vegetation; desert, waste.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>yermo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Unproductive, fruitless, unprofitable; empty, hollow, vain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>barrette</ns0:orth>
        <ns0:pron>/bəˈɹɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
