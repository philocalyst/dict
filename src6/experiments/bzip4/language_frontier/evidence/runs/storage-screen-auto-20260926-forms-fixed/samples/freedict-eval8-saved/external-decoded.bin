        </ns0:cit>
        <ns0:sense>
          <ns0:def>A region of Saint Petersburg city, Saint Petersburg, Northwest Russia district, European Russia, Russia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Petropavlovsk-Kamchatsky</ns0:orth>
