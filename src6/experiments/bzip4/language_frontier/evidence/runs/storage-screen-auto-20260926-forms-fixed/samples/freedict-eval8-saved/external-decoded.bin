      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alias</ns0:quote>
          <ns0:quote>apodado</ns0:quote>
          <ns0:quote>también conocida como</ns0:quote>
          <ns0:quote>también conocido como</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to introduce an alternative name.</ns0:def>
        </ns0:sense>
