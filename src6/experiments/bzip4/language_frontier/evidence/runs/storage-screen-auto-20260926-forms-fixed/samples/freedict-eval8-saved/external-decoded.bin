      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Teágenes</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Theban</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tebano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Thebes</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thebes</ns0:orth>
        <ns0:pron>/θiːbz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tebas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in central Greece, the capital city of Boeotia and an important political centre in antiquity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An ancient city and archaeological site in Upper Egypt, having functioned as capital city at times during the Middle Kingdom and New Kingdom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Thecla</ns0:orth>
        <ns0:pron>/θiːklə/</ns0:pron>
        <ns0:pron>/θɛklə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tecla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Their Majesties</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sus Majestades</ns0:quote>
        </ns0:cit>
        <ns0:sense>
