        <ns0:pron>/ˈbɑ.ɹɪˌlif/</ns0:pron>
        <ns0:pron>/ˈbɑs.ɹɪˌliːf/</ns0:pron>
        <ns0:pron>/ˈbɑː.ɹɪˌliːf/</ns0:pron>
        <ns0:pron>/ˌbæs.ɹɪˈlif/</ns0:pron>
        <ns0:pron>/ˌbɑ.ɹɪˈlif/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajorrelieve</ns0:quote>
        </ns0:cit>
