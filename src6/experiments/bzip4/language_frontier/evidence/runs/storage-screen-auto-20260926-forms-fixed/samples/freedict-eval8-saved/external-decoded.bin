      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alboroto</ns0:quote>
          <ns0:quote>jaleo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Noisy shouting or uproar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ballyhoo</ns0:orth>
        <ns0:pron>/bæliˈhuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alborotar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To sensationalize or make grand claims.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
