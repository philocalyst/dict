        <ns0:pron>/ˌsɛlt.aɪˈbɪ(ə)ɹ.i.ən/</ns0:pron>
        <ns0:pron>/ˌsɛlt.ɪˈbɪ(ə)ɹ.i.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>celtíbero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a Celtic people living in the Iberian Peninsula, chiefly in what is now north central Spain, before and during the Roman Empire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Celtiberian</ns0:orth>
        <ns0:pron>/ˌkɛlt.aɪˈbɪ(ə)ɹ.i.ən/</ns0:pron>
        <ns0:pron>/ˌkɛlt.ɪˈbɪ(ə)ɹ.i.ən/</ns0:pron>
        <ns0:pron>/ˌsɛlt.aɪˈbɪ(ə)ɹ.i.ən/</ns0:pron>
        <ns0:pron>/ˌsɛlt.ɪˈbɪ(ə)ɹ.i.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>celtíbero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct Indo-European language of the Celtic branch spoken by these people in an area of the Iberian Peninsula lying between the headwaters of the Duero, Tajo, Júcar and Turia rivers and the Ebro river.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
