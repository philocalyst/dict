        <ns0:orth>antigypsyism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiziganismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hostility, prejudice or racism toward Romani people (Gypsies).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihelix</ns0:orth>
        <ns0:pron>/ˌæn.tɪˈhi.lɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihélix</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihemorrhagic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihemorrágico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) That stops or reduces hemorrhage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihero</ns0:orth>
        <ns0:pron>/ˈæn.tiˌhiɹ.oʊ/</ns0:pron>
        <ns0:pron>/ˈæn.tɪˌhɪə.ɹəʊ/</ns0:pron>
        <ns0:pron>/ˈænˌtaɪ.hiɹ.oʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihéroe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literature, RPG) A protagonist who proceeds in an unheroic manner, such as by criminal means, via cowardly actions, or for mercenary goals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiheroine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiheroína</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literature, RPG) A female protagonist who proceeds in an unheroic manner, such as by criminal means, via cowardly actions, or for mercenary goals; a female antihero.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihistamine</ns0:orth>
        <ns0:pron>/ˌæn.taɪˈhɪs.tə.miːn/</ns0:pron>
        <ns0:pron>/ˌæn.tiˈhɪs.tə.miːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihistamínico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A drug or substance that counteracts the effects of a histamine. Commonly used to alleviate the symptoms of hay fever and other allergies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihistaminic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihistamínico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Of or pertaining to antihistamines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihomophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihomofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposition to homophobia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antihydrogen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihidrógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(particle, uncountable) The antimatter equivalent of hydrogen, consisting of an antiproton and a positron (antielectron).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antikidnapping</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antisecuestros</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law enforcement) Preventing or countering kidnapping.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antilaundering</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antilavado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(law enforcement) Countering money laundering.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiliberalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiliberalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) Antiliberal beliefs and practices.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimalarial</ns0:orth>
        <ns0:pron>/-taɪ-/</ns0:pron>
        <ns0:pron>/ˌæn.ti.məˈlɛ.ɹi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.məˈlɛə.ɹi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimalárico</ns0:quote>
          <ns0:quote>antipalúdico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Preventing or counteracting malaria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimalarial</ns0:orth>
        <ns0:pron>/-taɪ-/</ns0:pron>
        <ns0:pron>/ˌæn.ti.məˈlɛ.ɹi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.məˈlɛə.ɹi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimalárico</ns0:quote>
          <ns0:quote>antipalúdico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agent that prevents or counteracts malaria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimatter</ns0:orth>
        <ns0:pron>/ˈæn.tiˌmæt.ɚ/</ns0:pron>
        <ns0:pron>/ˈænˌtaɪˌmæt.ɚ/</ns0:pron>
        <ns0:pron>[ˈæ.niˌmæ.ɾɚ]</ns0:pron>
        <ns0:pron>[ˈæ.ɾ̃iˌmæ.ɾɚ]</ns0:pron>
        <ns0:pron>[ˈæn.tiˌmæ.ɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimateria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) Matter that is composed of the antiparticles of those that constitute normal matter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimeridian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimeridiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) The reference line at 180° longitude, on the opposite side of earth to the prime meridian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimicrobial</ns0:orth>
        <ns0:pron>/ˌæn.ti.maɪˈkɹoʊ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.maɪˈkɹəʊ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.mɑɪˈkɹɐʉ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.mɑɪˈkɹəʉ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌɛn.ti.maɪˈkɹɐʉ.bi.əl/</ns0:pron>
        <ns0:pron>[ˌæn.ti.mʌɪˈkɹoʊ.bi.əl]</ns0:pron>
        <ns0:pron>[ˌɛən.ti.maɪˈkɹoʊ.bi.əl]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimicrobiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Tending to destroy or capable of destroying microbes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimicrobial</ns0:orth>
        <ns0:pron>/ˌæn.ti.maɪˈkɹoʊ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.maɪˈkɹəʊ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.mɑɪˈkɹɐʉ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌæn.ti.mɑɪˈkɹəʉ.bi.əl/</ns0:pron>
        <ns0:pron>/ˌɛn.ti.maɪˈkɹɐʉ.bi.əl/</ns0:pron>
        <ns0:pron>[ˌæn.ti.mʌɪˈkɹoʊ.bi.əl]</ns0:pron>
        <ns0:pron>[ˌɛən.ti.maɪˈkɹoʊ.bi.əl]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimicrobiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agent (drug or other substance) that destroys microbes (i.e., kills off a population of them).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimissile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimisil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) Designed to intercept and destroy another missile in flight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimodern</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimoderno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to modernity or modernization</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimonial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimonial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any drug or medical preparation containing antimony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimonite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimonita</ns0:quote>
          <ns0:quote>estibina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A grey mineral, antimony sulfide (Sb2S3) that is the main source of antimony; stibnite</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antimony</ns0:orth>
        <ns0:pron>/ˈæn.tɪ.mə.niː/</ns0:pron>
        <ns0:pron>/ˈæn.tɪˌmoʊ.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antimonio</ns0:quote>
          <ns0:quote>estibio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A chemical element (symbol Sb, from Latin stibium) with an atomic number of 51: in its stable allotrope, a lustrous gray and very brittle metal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinatalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinatalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy) A philosophical view that deems procreation as immoral.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinatalist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinatalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy, sociology) A supporter of antinatalism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinationalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinacionalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) opposition to nationalism</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antineutrino</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antineutrino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(particle) The antiparticle of the neutrino.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antineutron</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antineutrón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The antiparticle corresponding to a neutron.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anting</ns0:orth>
        <ns0:pron>/ˈæntɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baño de hormigas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ornithology) The practice of some birds of rubbing live ants or occasionally other items into the feathers, possibly as a means of controlling parasites.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinociceptive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analgésico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) That inhibits nociception, the sensation of pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinode</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinodo</ns0:quote>
          <ns0:quote>vientre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A region of maximum amplitude situated between adjacent nodes of a vibrating body, such as a string.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinomian</ns0:orth>
        <ns0:pron>/æntaɪˈnoʊmi.ən/</ns0:pron>
        <ns0:pron>/æntiˈnoʊmi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinomianista</ns0:quote>
          <ns0:quote>antinomiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to antinomianism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinomian</ns0:orth>
        <ns0:pron>/æntaɪˈnoʊmi.ən/</ns0:pron>
        <ns0:pron>/æntiˈnoʊmi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinomiana</ns0:quote>
          <ns0:quote>antinomianista</ns0:quote>
          <ns0:quote>antinomiano</ns0:quote>
          <ns0:quote>antinomista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity, Judaism) One who embraces, encourages, or practices antinomianism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinomianism</ns0:orth>
        <ns0:pron>/æntiˈnoʊmi.ənɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinomianismo</ns0:quote>
          <ns0:quote>antinomismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) The belief or teaching that because only the spiritual "law of faith" (Romans 3:27) is essential for salvation, obedience to any practical or moral law has no role to play, even as a guide to conduct or as a test of the genuineness of faith.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinomy</ns0:orth>
        <ns0:pron>/ænˈtɪn.ə.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinomia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(specifically, epistemology, logic) In the thought of the German philosopher Immanuel Kant (1724–1804): an apparent contradiction between valid conclusions; a paradox.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinuclear</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinuclear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed to the production or use of nuclear weapons, or opposed to the generation of electricity from nuclear power.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antinutrient</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antinutriente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) Any substance that interferes with the absorption or metabolism of a nutrient</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antioxidant</ns0:orth>
        <ns0:pron>/ˌæntiˈɒksɪdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antioxidante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Acting or having agents that act against oxidation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antioxidant</ns0:orth>
        <ns0:pron>/ˌæntiˈɒksɪdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antioxidante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any substance that slows or prevents the oxidation of another chemical.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(nutrition) One of a group of vitamins that act against the effects of free radicals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiparallel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiparalelo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) (of vectors) Parallel but in opposite directions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiparasitic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiparasitario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) That counters infection by parasites</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiparticle</ns0:orth>
        <ns0:pron>/ˈæntiˌpɑ(ɹ)tɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipartícula</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(particle) A subatomic particle corresponding to another particle with the same mass, spin and mean lifetime but with charge, parity, strangeness and other quantum numbers flipped in sign; a particle that has a reversed world line to another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipathize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipatizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To feel or show antipathy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipathy</ns0:orth>
        <ns0:pron>/ænˈtɪpəθi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipatía</ns0:quote>
          <ns0:quote>aversión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Often followed by against, between, for, or to: a (deep) feeling of dislike or repugnance, normally towards a person and less often towards a thing, often without any conscious reasoning; aversion, distaste, hostility; (countable) an instance of this.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiperspirant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antitranspirante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) A substance used to minimize sweating or perspiration, and usually applied to the underarm area.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiphon</ns0:orth>
        <ns0:pron>/ˈæntɪfən/</ns0:pron>
        <ns0:pron>/ˈæntɪˌfɑn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antífona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A devotional chant; a piece of music sung responsively.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiphrasis</ns0:orth>
        <ns0:pron>/ænˈtɪfrəsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antífrasis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) Use of a word or phrase in a sense opposite of its literal meaning, especially for ironic or humorous effect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipode</ns0:orth>
        <ns0:pron>/ˈæn.tɪ.poʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antípoda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something directly opposite or diametrically opposed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipollution</ns0:orth>
        <ns0:pron>/æn.taɪ.pəˈluː.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticontaminación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Reducing or opposing pollution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipope</ns0:orth>
        <ns0:pron>/ˈantɪpəʊp/</ns0:pron>
        <ns0:pron>/ˈæntiˌpoʊp/</ns0:pron>
        <ns0:pron>/ˈænˌtaɪˌpoʊp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipapa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A person who claims or claimed to be the pope, usually as the result of a disputed election or deposition, but is not considered by the Roman Catholic Church to be the real pope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipopular</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipopular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposing the people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiprism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiprisma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A polyhedron composed of two parallel copies of some particular polygon, connected by an alternating band of triangles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiproliferative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiproliferativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Tending to suppress cell growth, especially the growth of malignant cells into surrounding tissue</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiproton</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiprotón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The antiparticle of the proton, having a negative electric charge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipsychotic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipsicótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Preventing or counteracting psychosis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipsychotic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipsicótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) Any of a group of drugs used to treat psychosis or other conditions, chiefly one that acts as an antagonist, partial agonist, or inverse agonist of dopamine receptors in the synapses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipyretic</ns0:orth>
        <ns0:pron>/ˌæntɪpaɪˈɹɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipirético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) That reduces fever.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antipyretic</ns0:orth>
        <ns0:pron>/ˌæntɪpaɪˈɹɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antipirético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A medicine that reduces fever; a febrifuge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiquarian</ns0:orth>
        <ns0:pron>/ˌæn.tɪˈkwɛɹ.i.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticuario</ns0:quote>
          <ns0:quote>antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to antiquaries, or to antiquity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiquarian</ns0:orth>
        <ns0:pron>/ˌæn.tɪˈkwɛɹ.i.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticuaria</ns0:quote>
          <ns0:quote>anticuario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A collector or student of, or expert in, antiquities or antiques.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiquary</ns0:orth>
        <ns0:pron>/ˈæntɪkw(ə)ɹi/</ns0:pron>
        <ns0:pron>/ˈæntɪˌkwɛɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticuario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is knowledgeable of, or who collects antiques (especially one holding an official position); an antiquarian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antiquated</ns0:orth>
