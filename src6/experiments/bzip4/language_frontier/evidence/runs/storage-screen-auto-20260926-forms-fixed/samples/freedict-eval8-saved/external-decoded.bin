      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bayetón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) A coarse, shaggy, woollen cloth for overcoats.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beast</ns0:orth>
        <ns0:pron>/biːst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestia</ns0:quote>
          <ns0:quote>fiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, _, collective) All non-human animals seen as a group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestia</ns0:quote>
          <ns0:quote>animal</ns0:quote>
          <ns0:quote>salvaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who behaves in a violent, antisocial or uncivilized manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) Someone who is particularly impressive, especially athletically or physically.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beast of burden</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestia de carga</ns0:quote>
          <ns0:quote>animal de carga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A draft animal, a pack animal such as a donkey, mule, llama, camel, horse, or ox, that carries or pulls a load for the benefit of a human.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animal adiestrado</ns0:quote>
          <ns0:quote>animal amansado</ns0:quote>
          <ns0:quote>animal domesticado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) Any domesticated animal trained to perform tasks for humans, such as a herding dog or trained falcon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
