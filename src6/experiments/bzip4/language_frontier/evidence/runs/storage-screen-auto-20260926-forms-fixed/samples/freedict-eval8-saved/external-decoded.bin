        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azotemia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The accumulation in the blood of nitrogen-bearing waste products (such as urea) that are usually excreted in the urine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
