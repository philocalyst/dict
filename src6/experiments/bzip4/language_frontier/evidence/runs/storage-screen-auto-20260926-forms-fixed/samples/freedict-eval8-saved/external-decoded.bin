        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Festo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient Minoan city in southern Crete prefecture, in modern Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Phanerozoic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fanerozoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) Of or relating to the Phanerozoic eon</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pharisee</ns0:orth>
        <ns0:pron>/ˈfɛɹɪsi/</ns0:pron>
        <ns0:pron>/ˈfɛɹɪsiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fariseo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A member of an ancient Jewish political party, a social movement, and a school of thought among Jews that flourished during the Second Temple Era (536 B.C.E.–70 C.E.). The movement was ultimately the basis for most contemporary forms of Judaism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pharsalia</ns0:orth>
        <ns0:pron>/ˌfɑːˈseɪli.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Farsalia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An epic poem by the Roman poet Lucan describing Caesar's Civil War.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Phaëthon</ns0:orth>
        <ns0:pron>/ˈfeɪətən/</ns0:pron>
        <ns0:pron>/ˈfeɪəθən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Faetonte</ns0:quote>
          <ns0:quote>Faetón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The son of the sun god Helios who was killed by Zeus while driving his father's chariot uncontrolledly across the sky.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pherecrates</ns0:orth>
        <ns0:pron>/fɪˈɹɛkɹətiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ferécrates</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A celebrated Athenian poet of the Old Comedy, living in the fifth century BCE (born after Crates and Cratinus but before Aristophanes, Eupolis, and Plato Comicus – so between c. 519 and c. 446 BCE), victorious at least thrice at the City Dionysia and the Lenaia in the 440s–430s, and inventor of the Pherecratean metre.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Philadelphia</ns0:orth>
        <ns0:pron>/fɪləˈdɛlfi.ə/</ns0:pron>
        <ns0:pron>[fɪɫəˈdɜɫfi.ə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Filadelfia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A locale in the United States; named for the city in Pennsylvania.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A village in Brandenburg, Germany; named for the city in Pennsylvania.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Philemon</ns0:orth>
        <ns0:pron>/fɪˈliːmɒn/</ns0:pron>
        <ns0:pron>/fɪˈliːmən/</ns0:pron>
        <ns0:pron>/ˈfɪləmən/</ns0:pron>
        <ns0:pron>/ˌfaɪˈliːmɒn/</ns0:pron>
        <ns0:pron>/ˌfaɪˈliːmən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Filemón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The eighteenth book of the New Testament of the Bible, the epistle of Saint Paul to a fellow Christian called Philemon.</ns0:def>
        </ns0:sense>
        <ns0:sense>
