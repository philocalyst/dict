      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dioniso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The god of wine, ivy and grapes, specifically its intoxication and social influence, but also the patron of agriculture and the theater. Also related to the mystery of religion, as in "spiritual intoxication".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
