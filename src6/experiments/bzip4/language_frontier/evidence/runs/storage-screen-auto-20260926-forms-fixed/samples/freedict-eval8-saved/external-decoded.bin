        <ns0:pron>/əˌbɒ.mɪˈneɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abominación</ns0:quote>
          <ns0:quote>maldad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An abominable act; a disgusting vice; a despicable habit. [from ca. 1150–1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abominación</ns0:quote>
          <ns0:quote>aborrecimiento</ns0:quote>
          <ns0:quote>repugnancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The feeling of extreme disgust and hatred [from ca. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aboriginal</ns0:orth>
        <ns0:pron>/əbɵrɪˈdʒɪnəl/</ns0:pron>
