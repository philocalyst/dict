      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jezabel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The Phoenician princess and Queen of Ancient Israel who appears in the Old Testament (1 Kings &amp; 2 Kings), and who incited heresy and lured the Jews away from their God and back to idols.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
