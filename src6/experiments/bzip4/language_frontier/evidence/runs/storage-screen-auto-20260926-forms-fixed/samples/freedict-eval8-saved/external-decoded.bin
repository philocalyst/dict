      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gregoriano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to a person named Gregory, especially any of the popes of that name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gregorian calendar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>calendario gregoriano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The calendar currently used in the western world. It replaced the Julian calendar and was devised to halt the slow drift of the vernal equinox towards earlier in the year.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
