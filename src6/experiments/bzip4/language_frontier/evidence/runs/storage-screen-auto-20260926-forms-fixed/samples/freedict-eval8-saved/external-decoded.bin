        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a mucha hambre, no hay pan duro</ns0:quote>
          <ns0:quote>menos da una piedra</ns0:quote>
          <ns0:quote>pobre</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>begging</ns0:orth>
        <ns0:pron>/ˈbɛɡɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deprecación</ns0:quote>
          <ns0:quote>ruego</ns0:quote>
          <ns0:quote>súplica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
