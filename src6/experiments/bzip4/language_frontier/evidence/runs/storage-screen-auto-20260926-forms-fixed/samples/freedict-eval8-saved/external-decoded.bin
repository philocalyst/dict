        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International Monetary Fund</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Fondo Monetario Internacional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The international organization entrusted with overseeing the global financial system by monitoring foreign exchange rates and balance of payments, as well as offering technical and financial assistance when requested.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International Phonetic Alphabet</ns0:orth>
        <ns0:pron>/ˌɪntəˈnæʃ(ə)nəl fəˈnɛtɪk ˈælfəˌbɛt/</ns0:pron>
        <ns0:pron>/ˌɪntɚˈnæʃ(ə)n(ə)l fəˈnɛtɪk ˈælfəˌbɛt/</ns0:pron>
        <ns0:pron>[ˌɪntəˈnæʃ(ə)nəɫ fəˈnɛtɪk ˈæɫfəˌbɛt]</ns0:pron>
        <ns0:pron>[ˌɪntɚˈnæʃ(ə)n(ə)ɫ fəˈnɛtɪk ˈæɫfəˌbɛt]</ns0:pron>
