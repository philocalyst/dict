      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>categórico</ns0:quote>
          <ns0:quote>abroquelarse</ns0:quote>
          <ns0:quote>acérrimo</ns0:quote>
          <ns0:quote>adamantino</ns0:quote>
          <ns0:quote>diamantino</ns0:quote>
          <ns0:quote>firme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(said of people and their conviction) Firm; unshakeable; unyielding; determined.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adamant</ns0:orth>
        <ns0:pron>/ˈæd.ə.mænt/</ns0:pron>
        <ns0:pron>/ˈæd.ə.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adamante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An imaginary rock or mineral of impenetrable hardness; a name given to the diamond and other substances of extreme hardness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adamantane</ns0:orth>
