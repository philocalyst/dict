    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Europeanisation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>europeización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process whereby the people and institutions of the countries of the European Union become more European and less national.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Europeanism</ns0:orth>
        <ns0:pron>/ˌjɝəˈpi.ənɪzəm/</ns0:pron>
