        <ns0:orth>Lucy</ns0:orth>
        <ns0:pron>/ˈluːsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lucía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from Old French derived from place names in Normandy based on a male personal name, from Latin Lucius.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luddite</ns0:orth>
        <ns0:pron>/ˈlʌ.daɪt/</ns0:pron>
        <ns0:pron>[ˈlʌ.ɾaɪt]</ns0:pron>
        <ns0:pron>[ˈlʌ.ɾʌit]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ludista</ns0:quote>
          <ns0:quote>ludita</ns0:quote>
          <ns0:quote>luddita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Any of a group of early-19th-century English textile workers who destroyed machinery because it would harm their livelihood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ludista</ns0:quote>
          <ns0:quote>luddita</ns0:quote>
          <ns0:quote>ludita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension, often, pejorative) Someone who opposes technological change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ludfordian</ns0:orth>
      </ns0:form>
