      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bien</ns0:quote>
          <ns0:quote>vale</ns0:quote>
          <ns0:quote>OK</ns0:quote>
          <ns0:quote>bueno</ns0:quote>
          <ns0:quote>de acuerdo</ns0:quote>
          <ns0:quote>okay</ns0:quote>
