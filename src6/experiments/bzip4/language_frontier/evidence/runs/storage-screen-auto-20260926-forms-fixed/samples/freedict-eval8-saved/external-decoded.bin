        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ascender</ns0:quote>
          <ns0:quote>promocionar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To raise (someone) in rank or office; to prefer, to promote. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avanzar</ns0:quote>
          <ns0:quote>anticipar</ns0:quote>
          <ns0:quote>progresar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make (something) happen at an earlier time or date; to bring forward, to hasten. [form 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advance directive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>voluntades anticipadas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medical law) A legal document outlining a person's end-of-life medical and healthcare wishes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advance payment</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelanto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The part of a contractually due sum that is paid or received in advance for a good, service or social security payment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advanced</ns0:orth>
        <ns0:pron>/ədˈvænst/</ns0:pron>
        <ns0:pron>/ədˈvɑːnst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avanzado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At or close to the state of the art. (Can we add an example for this sense? )</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avanzado</ns0:quote>
          <ns0:quote>provecto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a late stage of development or education; having greatly progressed beyond an initial stage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advancement</ns0:orth>
        <ns0:pron>/ædˈvæns.mənt/</ns0:pron>
        <ns0:pron>/ædˈvɑːns.mənt/</ns0:pron>
        <ns0:pron>/ədˈvæns.mənt/</ns0:pron>
        <ns0:pron>/ədˈvɑːns.mənt/</ns0:pron>
        <ns0:pron>[ædˈvɛəns.mənt]</ns0:pron>
        <ns0:pron>[ədˈvɛəns.mənt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>progreso</ns0:quote>
          <ns0:quote>ascenso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being advanced</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avance de herencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Property given, usually by a parent to a child, in advance of a future distribution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advantage</ns0:orth>
        <ns0:pron>/ədˈvæn.(t)ɪd͡ʒ/</ns0:pron>
        <ns0:pron>/ədˈvɑːn.tɪd͡ʒ/</ns0:pron>
        <ns0:pron>/əɖˈvɑɳˌʈedʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventaja</ns0:quote>
          <ns0:quote>ventaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Any condition, circumstance, opportunity or means, particularly favorable or chance to success, or to any desired end.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventaja</ns0:quote>
          <ns0:quote>provecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Superiority; mastery; — used with of to specify its nature or with over to specify the other party.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(tennis) The score where one player wins a point after deuce but needs the next to carry the game.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventaja</ns0:quote>
          <ns0:quote>provecho</ns0:quote>
          <ns0:quote>baza</ns0:quote>
          <ns0:quote>beneficio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, uncountable) Superiority of state, or that which gives it; benefit; gain; profit</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advantageous</ns0:orth>
        <ns0:pron>/ədˈvɑɳˌʈedʒ(ɪ)jəs/</ns0:pron>
        <ns0:pron>/ˌædvənˈteɪd͡ʒ(i)əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventajoso</ns0:quote>
          <ns0:quote>provechoso</ns0:quote>
          <ns0:quote>proficuo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Being of advantage, beneficial.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advantageously</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ventajosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a manner which provides an advantage; in an advantageous manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advection</ns0:orth>
        <ns0:pron>/ædˈvɛkʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>advección</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(meteorology, earth science, physical chemistry) The horizontal movement of a body of atmosphere (or other fluid) along with a concurrent transport of its temperature, humidity etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advent</ns0:orth>
        <ns0:pron>/ˈæd.vənt/</ns0:pron>
        <ns0:pron>/ˈæd.vɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>advenimiento</ns0:quote>
          <ns0:quote>venida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To arrive or begin, especially at the first coming or appearance of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adventitious</ns0:orth>
        <ns0:pron>/ˌæd.vənˈtɪʃ.əs/</ns0:pron>
        <ns0:pron>/ˌæd.vɛnˈtɪʃ.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adventicio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adventure</ns0:orth>
        <ns0:pron>/ædˈvɛnt͡ʃɚ/</ns0:pron>
        <ns0:pron>/ədˈvɛnt͡ʃə/</ns0:pron>
        <ns0:pron>/ədˈvɛnt͡ʃɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aventura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A remarkable occurrence; a striking event.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A daring feat; a bold undertaking, in which dangers are likely to be encountered, and the issue is staked upon unforeseen events; the encountering of risks.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A mercantile or speculative enterprise of hazard; a venture; a shipment by a merchant on his own account.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete) That which happens by chance; hazard; hap.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adventure</ns0:orth>
        <ns0:pron>/ædˈvɛnt͡ʃɚ/</ns0:pron>
        <ns0:pron>/ədˈvɛnt͡ʃə/</ns0:pron>
        <ns0:pron>/ədˈvɛnt͡ʃɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aventura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, transitive) To venture upon; to run the risk of; to dare.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adventurer</ns0:orth>
        <ns0:pron>/ædˈvɛn.t͡ʃɚ.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aventurero</ns0:quote>
          <ns0:quote>aventurera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who enjoys adventures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adventurism</ns0:orth>
        <ns0:pron>/ədˈvɛn(t)ʃəɹɪz(ə)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aventurismo</ns0:quote>
          <ns0:quote>aventurerismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics) The taking of excessive risks by a government in their political, economic or foreign affairs. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adventurous</ns0:orth>
        <ns0:pron>/ædˈvɛn.t͡ʃɚ.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aventurero</ns0:quote>
          <ns0:quote>intrépido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a, person) Inclined to adventure; willing to take risks; prone to embark on hazardous enterprises; daring.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arriesgado</ns0:quote>
          <ns0:quote>aventurado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of an, act or product) Full of risks; risky; liable to be in danger; requiring courage; rash.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverb</ns0:orth>
        <ns0:pron>/əɖˈvɜ(r)b/</ns0:pron>
        <ns0:pron>/ˈæd.vɜːb/</ns0:pron>
        <ns0:pron>/ˈæd.vɝb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverbio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A word that modifies a verb, adjective, other adverbs, or various other types of words, phrases, or clauses.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(programming) In the Raku programming language, a named parameter that modifies the behavior of a routine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverbial</ns0:orth>
        <ns0:pron>/ædˈvɝbi.əl/</ns0:pron>
        <ns0:pron>/ədˈvɜːbi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverbial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) Of or relating to an adverb.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverbial participle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gerundio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A participle that modifies a verb in the same sentence and is equivalent to an adverbial clause in English. Adverbial participles may denote time, condition, cause, concession, manner, means, purpose, or attendant circumstance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverbial phrase</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>locución adverbial</ns0:quote>
          <ns0:quote>frase adverbial</ns0:quote>
          <ns0:quote>sintagma adverbial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A phrase that collectively modifies a verb, adjective, another adverb, or a prepositional phrase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverbialization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverbialización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A process of rendering adverbial, of adverbializing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverbialize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverbializar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling, transitive) To use as or change into an adverb.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverbially</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverbialmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>As, or in the manner of, an adverb.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adversarial</ns0:orth>
        <ns0:pron>/ˌæd.vəˈseː.ɹi.əl/</ns0:pron>
        <ns0:pron>/ˌæd.vəˈsɛə.ɹi.əl/</ns0:pron>
        <ns0:pron>/ˌæd.vɚˈsɛɚ.i.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characteristic of, or in the manner of, an adversary; combative, hostile, opposed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adversary</ns0:orth>
        <ns0:pron>/ædˈvɜː.sə.ɹi/</ns0:pron>
        <ns0:pron>/ədˈvɜː.sə.ɹi/</ns0:pron>
        <ns0:pron>/ˈæd.və.s(ə)ɹi/</ns0:pron>
        <ns0:pron>/ˈæd.və.sɛɹi/</ns0:pron>
        <ns0:pron>/ˈæd.vəɹˌsɛɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adversario</ns0:quote>
          <ns0:quote>adversaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An opponent or rival.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adversative</ns0:orth>
        <ns0:pron>/æd-/</ns0:pron>
        <ns0:pron>/ədˈvɝsəˌtɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adversativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) Expressing opposition or difference.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverse</ns0:orth>
        <ns0:pron>/ədˈvɜ(ɹ)s/</ns0:pron>
        <ns0:pron>/ˈæd.və(ɹ)s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverso</ns0:quote>
          <ns0:quote>contrario</ns0:quote>
          <ns0:quote>desfavorable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Unfavorable; antagonistic in purpose or effect; hostile; actively opposing one's interests or wishes; contrary to one's welfare; acting against; working in an opposing direction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>opuesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Opposed; contrary; opposing one's interests or desire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adverso</ns0:quote>
          <ns0:quote>desfavorable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Opposite; confronting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adverse possession</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>usucapión</ns0:quote>
          <ns0:quote>prescripción adquisitiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A means of acquiring title to another's real property without compensation by occupying the property in a manner that has under common law the requirements of being actual, open and notorious, exclusive, hostile, under cover of claim or right, and continuous for a certain number of years.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adversely</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adversamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an adverse manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adversity</ns0:orth>
        <ns0:pron>/ædˈvɜː.sɪ.ti/</ns0:pron>
        <ns0:pron>/ædˈvɝ.sɪ.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adversidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The state of adverse conditions; state of misfortune or calamity.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) An event that is adverse; calamity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advertise</ns0:orth>
        <ns0:pron>/ˈadvə(ɹ)taɪz/</ns0:pron>
        <ns0:pron>/ˈædvɚtaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anunciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give (especially public) notice of (something); to announce publicly. [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacer publicidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To provide information about a person or goods and services to influence others. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>publicitar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To provide public information about (a product, service etc.) in order to attract public awareness and increase sales. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advertisement</ns0:orth>
        <ns0:pron>/advaˈʈajsmenʈ/</ns0:pron>
        <ns0:pron>/ədˈvøːtəsmənt/</ns0:pron>
        <ns0:pron>/ədˈvɜːtɪsmənt/</ns0:pron>
        <ns0:pron>/ədˈvɝtɪzmənt/</ns0:pron>
        <ns0:pron>/ʔɐd.vəɹˈtaɪs.mɛnt/</ns0:pron>
        <ns0:pron>/ʔɐdˈvəɹ.tis.mɛnt/</ns0:pron>
        <ns0:pron>/ˈædvəˌtaɪzmənt/</ns0:pron>
        <ns0:pron>/ˈædvəˌtɪzmənt/</ns0:pron>
        <ns0:pron>/ˈædvɚˌtaɪzmənt/</ns0:pron>
        <ns0:pron>/ˈɛdvəˌtaɪzmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuncio</ns0:quote>
          <ns0:quote>publicidad</ns0:quote>
          <ns0:quote>reclamo</ns0:quote>
          <ns0:quote>aviso</ns0:quote>
          <ns0:quote>propaganda</ns0:quote>
          <ns0:quote>spot</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(marketing) A commercial solicitation designed to sell some commodity, service or similar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advertiser</ns0:orth>
        <ns0:pron>/ˈædvɚˌtaɪzɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anunciante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who advertises.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advertising</ns0:orth>
        <ns0:pron>/ˈædvəˌtaɪzɪŋ/</ns0:pron>
        <ns0:pron>/ˈædvɚˌtaɪzɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>publicidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The industry or profession made up of such communications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advertising mail</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>correo directo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(post) Mail that is directly sent to recipients to advertise goods and services.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advertorial</ns0:orth>
        <ns0:pron>/ˈæd.vɜːˌtɔːɹ.i.əl/</ns0:pron>
        <ns0:pron>/ˌædvɚˈtɔɹi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>infomercial</ns0:quote>
          <ns0:quote>publirreportaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An advertisement written in the form of an objective editorial, presented in a printed publication, and usually designed to look like a legitimate and independent news article.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advice</ns0:orth>
        <ns0:pron>/ədˈvaɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consejo</ns0:quote>
          <ns0:quote>asesoramiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) An opinion offered to guide behavior in an effort to be helpful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aviso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, commonly in plural) Information or news given; intelligence</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advice columnist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>doctora corazón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who regularly writes for the advice column of a newspaper.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advisability</ns0:orth>
        <ns0:pron>/ædˌvaɪz.əˈbɪl.ə.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conveniencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality of being advisable or prudent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advisable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aconsejable</ns0:quote>
          <ns0:quote>recomendable</ns0:quote>
          <ns0:quote>conveniente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a course of action) Worthy of being recommended; desirable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advise</ns0:orth>
        <ns0:pron>/ədˈvaɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aconsejar</ns0:quote>
          <ns0:quote>asesorar</ns0:quote>
          <ns0:quote>notificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give advice to; to offer an opinion to, as worthy or expedient to be followed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>notificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To formally give information or notice to; to inform or counsel. [with of ‘what is communicated’]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advisor</ns0:orth>
        <ns0:pron>/ædˈvaɪ.zə(ɹ)/</ns0:pron>
        <ns0:pron>/ædˈvaɪ.zɚ/</ns0:pron>
        <ns0:pron>/ædˈvɑɪ.zə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asesor</ns0:quote>
          <ns0:quote>consejero</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advisory</ns0:orth>
        <ns0:pron>/ædˈvaɪz(ə)ɹi/</ns0:pron>
        <ns0:pron>/ədˈvaɪzəɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>consultivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to give advice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advisory</ns0:orth>
        <ns0:pron>/ædˈvaɪz(ə)ɹi/</ns0:pron>
        <ns0:pron>/ədˈvaɪzəɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alerta</ns0:quote>
          <ns0:quote>aviso</ns0:quote>
          <ns0:quote>informe</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advisory opinion</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>opinión asesora</ns0:quote>
          <ns0:quote>opinión consultiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) An opinion issued by a court that does not have the effect of resolving a specific legal case, but merely advises on the constitutionality or interpretation of a law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advocacy</ns0:orth>
        <ns0:pron>/ædˈvokəsi/</ns0:pron>
        <ns0:pron>/ædˈvoʊkəsi/</ns0:pron>
        <ns0:pron>/əɖˈvɔ~o.kəsi/</ns0:pron>
        <ns0:pron>/ˈæd.və.kə.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogacía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The profession of an advocate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>promoción</ns0:quote>
          <ns0:quote>abogamiento</ns0:quote>
          <ns0:quote>advocación</ns0:quote>
          <ns0:quote>apoyo</ns0:quote>
          <ns0:quote>defensa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of arguing in favour of, or supporting someone or something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advocacy group</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grupo de interés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of people, always allied and sometimes also formally organised, who use various forms of advocacy to influence public opinion and policy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advocate</ns0:orth>
        <ns0:pron>/əɖvɵˈkeʈ/</ns0:pron>
        <ns0:pron>/ˈæd.və.keɪt/</ns0:pron>
        <ns0:pron>/ˈæd.və.kət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone whose job is to speak for someone's case in a court of law; a counsel. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogado</ns0:quote>
          <ns0:quote>abogada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anyone who argues the case of another; an intercessor. [from 14th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogador</ns0:quote>
          <ns0:quote>advocante</ns0:quote>
          <ns0:quote>defensor</ns0:quote>
          <ns0:quote>portavoz</ns0:quote>
          <ns0:quote>representante</ns0:quote>
          <ns0:quote>vocero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who speaks in support of something, or someone; proponent [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>advocate</ns0:orth>
        <ns0:pron>/əɖvɵˈkeʈ/</ns0:pron>
        <ns0:pron>/ˈæd.və.keɪt/</ns0:pron>
        <ns0:pron>/ˈæd.və.kət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogar</ns0:quote>
          <ns0:quote>advocar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To encourage support for something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>advocar</ns0:quote>
          <ns0:quote>recomendar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Scots law, in higher courts) To call a case before itself for decision.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adware</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adware</ns0:quote>
          <ns0:quote>programa publicitario</ns0:quote>
          <ns0:quote>software publicitario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A software application that includes advertisements, which are displayed while the software is running. Developers use adware as a source of income and to keep the costs of the software down (usually making it free). Some adware programs can include spyware.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adynamia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adinamia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Lack or loss of strength, usually due to a disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adynaton</ns0:orth>
        <ns0:pron>/-t(ə)n/</ns0:pron>
        <ns0:pron>/ædəˈnɑtn̩/</ns0:pron>
        <ns0:pron>/ædɪˈnɑːtɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adynaton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) A form of hyperbole that uses exaggeration so magnified as to express impossibility; an instance of such hyperbole.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adytum</ns0:orth>
        <ns0:pron>/ˈadətəm/</ns0:pron>
        <ns0:pron>/ˈadɪtəm/</ns0:pron>
        <ns0:pron>[-ɾəm]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>áditon</ns0:quote>
          <ns0:quote>ádyton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Ancient Greece, religion) The innermost sanctuary or shrine in a temple, from where oracles were given.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adze</ns0:orth>
        <ns0:pron>/ædz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azuela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cutting tool that has a curved blade set at a right angle to the handle and is used in shaping wood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aedile</ns0:orth>
        <ns0:pron>/ˈiːdaɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>edil</ns0:quote>
          <ns0:quote>regidor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, Ancient Rome) An elected official who was responsible for the maintenance of public buildings, regulation of festivals, supervision of markets and the supply of grain and water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aegipan</ns0:orth>
        <ns0:pron>/ˈiːdʒɪpan/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>egipán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A goat-like creature resembling a satyr, sometimes portrayed as having a fish's tail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aegis</ns0:orth>
        <ns0:pron>/ˈiːd͡ʒɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>égida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology, Roman mythology) A mythological shield associated with the Greek deities Zeus and Athena (and their Roman counterparts Jupiter and Minerva) shown as a short cloak made of goatskin worn on the shoulders, more as an emblem of power and protection than a military shield. The aegis of Athena or Minerva is usually shown with a border of snakes and with the head of Medusa in the center. [from early 17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figuratively) Usually as under the aegis: guidance, protection; endorsement, sponsorship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeolian</ns0:orth>
        <ns0:pron>/eɪˈoʊ.li.ən/</ns0:pron>
        <ns0:pron>/iˈoʊ.li.ən/</ns0:pron>
        <ns0:pron>/iˈoʊl.jən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of, or relating to the wind.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geology) carried, deposited or eroded by the wind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerate</ns0:orth>
        <ns0:pron>/ɛːˈɹeɪt/</ns0:pron>
        <ns0:pron>/ˈɛːɹeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>airear</ns0:quote>
          <ns0:quote>aerar</ns0:quote>
          <ns0:quote>gasear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To supply with oxygen or air.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeration</ns0:orth>
        <ns0:pron>/ɛːˈɹeɪʃ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeración</ns0:quote>
          <ns0:quote>aireación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>By extension, a process in which other gases (such as carbon dioxide or nitrogen or argon) are circulated through or mixed with a substance (usually liquid), sometimes with the consequence of increasing the transfer of air into the same liquid at the surface due to the induced circulation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerial</ns0:orth>
        <ns0:pron>/eɪˈɛəɹɪəl/</ns0:pron>
        <ns0:pron>/eɪˈɪəɹɪəl/</ns0:pron>
        <ns0:pron>/ˈɛəɹiəl/</ns0:pron>
        <ns0:pron>/ˈɛəɹɪəl/</ns0:pron>
        <ns0:pron>/ˈɛɹiəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aéreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Living or taking place in the air. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerial</ns0:orth>
        <ns0:pron>/eɪˈɛəɹɪəl/</ns0:pron>
        <ns0:pron>/eɪˈɪəɹɪəl/</ns0:pron>
        <ns0:pron>/ˈɛəɹiəl/</ns0:pron>
        <ns0:pron>/ˈɛəɹɪəl/</ns0:pron>
        <ns0:pron>/ˈɛɹiəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, _, UK) A rod, wire, or other structure for receiving or transmitting radio, television signals etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerial photography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fotografía aérea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The activity or technique of photographing the earth's surface from an aircraft, rocket, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerial yoga</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeroyoga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of yoga in which the body is supported by a hammock slung from the ceiling</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeriferous</ns0:orth>
        <ns0:pron>/ɛːˈɹɪfəɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerífero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a tube etc) That conveys air</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aero-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aero-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>air or aircraft</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerobe</ns0:orth>
        <ns0:pron>/ˈɛˌroʊb/</ns0:pron>
        <ns0:pron>/ˈɛː.rəʊb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerobio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any organism (but especially a bacterium) that can tolerate the presence of oxygen, or that needs oxygen to survive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerobic</ns0:orth>
        <ns0:pron>/əˈɹoʊ.bɪk/</ns0:pron>
        <ns0:pron>/ɛəˈɹoʊ.bɪk/</ns0:pron>
        <ns0:pron>/ɛəˈɹəʊ.bɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeróbico</ns0:quote>
          <ns0:quote>aerobio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Living or occurring only in the presence of oxygen e.g. aerobic bacteria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeróbico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to aerobics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerobically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeróbicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an aerobic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerobics</ns0:orth>
        <ns0:pron>/əˈɹoʊbɪks/</ns0:pron>
        <ns0:pron>/əˈɹəʊbɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerobic</ns0:quote>
          <ns0:quote>aeróbic</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of exercise, designed to enhance one's cardiovascular fitness, normally performed to music. [1968]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerobiology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerobiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The study of the dispersion of airborne biological materials, as pollen, spores, microorganisms, or viruses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerobiosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerobiosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Any form of life that is sustained by the presence of air (or oxygen)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerodrome</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeródromo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An airfield:</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerodynamic</ns0:orth>
        <ns0:pron>/ˌɛɹ.oʊ.daɪˈnæ.mɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerodinámico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to the science of aerodynamics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerodynamical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerodinámico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Synonym of aerodynamic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerodynamics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerodinámica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The science of the dynamics of bodies moving relative to gases, especially the interaction of moving objects with the atmosphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerodynamism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerodinamismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The condition of having an aerodynamic shape</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerodyne</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerodino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) A heavier-than-air aircraft, deriving its lift from motion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerogel</ns0:orth>
        <ns0:pron>/ˈɛɹ.oʊ.d͡ʒɛl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerogel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A porous, ultralight solid-state substance, similar to gel, in which the liquid component is replaced with gas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerogram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerograma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A thin piece of foldable and gummed paper for writing a letter and serving as its own envelope for transit via airmail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A branch of surrealist art in which a three-dimensional object is used as a stencil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerology</ns0:orth>
        <ns0:pron>/ɛəˈɹɑ.lə.d͡ʒi/</ns0:pron>
        <ns0:pron>/ɛɚˈɑ.lə.d͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of meteorology involving the observation of the atmosphere by means of balloons, kites, rockets, drones, airplanes, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeromancy</ns0:orth>
        <ns0:pron>/ˈeə.ɹə.mæn.si/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeromancia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Divination by use of atmospheric conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerometer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument used to measure the mass and density of gases.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerometría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) The science of measuring the air, including air pressure, density, quality, direction and condensation; pneumatics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeromodeller</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeromodelista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A maker of model aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeromodelling</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeromodelismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The building and flying of model aircraft</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeronaut</ns0:orth>
        <ns0:pron>/ˈɛəɹəˌnɔːt/</ns0:pron>
        <ns0:pron>/ˈɛɹəˌnɑt/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ˈɛɹəˌnɔt/&lt;a:US&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeronauta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who travels through the air in an airship or balloon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeronautic</ns0:orth>
        <ns0:pron>/ˌɛəɹəˈnɔːtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeronáutico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having to do with aerial navigation</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeronautical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeronáutico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the scientific study of flight</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeronautics</ns0:orth>
        <ns0:pron>/ˌɛə.ɹəʊˈnɔː.tɪks/</ns0:pron>
        <ns0:pron>/ˌɛɚ.oʊˈnɑ.tɪks/</ns0:pron>
        <ns0:pron>/ˌɛɚ.oʊˈnɔ.tɪks/</ns0:pron>
        <ns0:pron>[ˌɛɚ.oʊˈnɑ.ɾɪks]</ns0:pron>
        <ns0:pron>[ˌɛɚ.oʊˈnɔ.ɾɪks]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeronáutica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The design, construction, mathematics and mechanics of aircraft and other flying objects</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerophobic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerófobo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a fear of flying in aircraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerophone</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerófono</ns0:quote>
          <ns0:quote>instrumento de viento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any musical instrument which produces sound primarily by causing a body of air to vibrate, without the use of strings or membranes, and without the vibration of the instrument itself adding considerably to the sound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeroponic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeropónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or grown using aeroponics</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeroscope</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeroscopio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device used to collect dust particles, spores etc from the air for subsequent analysis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerosol</ns0:orth>
        <ns0:pron>/ˈɛə.ɹəˌsɒl/</ns0:pron>
        <ns0:pron>/ˈɛɚ.əˌsɑl/</ns0:pron>
        <ns0:pron>/ˈɛɚ.əˌsɔl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerosol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mixture of fine solid particles or liquid droplets suspended in a gaseous medium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerosol can</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lata de aerosol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A canister whose pressurized contents may be released as an aerosol when a button is pressed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerospace</ns0:orth>
        <ns0:pron>/ˈeː.ɹɐʉˌspæɪs/</ns0:pron>
        <ns0:pron>/ˈeː.ɹəʉˌspæɪs/</ns0:pron>
        <ns0:pron>/ˈɛɹ.oʊˌspeɪs/</ns0:pron>
        <ns0:pron>[ˈeɪ.əɹ-]</ns0:pron>
        <ns0:pron>[ˈɛə̯.ɹəʊˌspeɪs]</ns0:pron>
        <ns0:pron>[ˈɛː.ɹowˌspejs]</ns0:pron>
        <ns0:pron>[ˈɛː.ɹowˌspeːs]</ns0:pron>
        <ns0:pron>[ˈɛː.ɹəʊˌspɛjs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeroespacial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to the science, technology and industry associated with aircraft, missiles, satellites and spacecraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerospace</ns0:orth>
        <ns0:pron>/ˈeː.ɹɐʉˌspæɪs/</ns0:pron>
        <ns0:pron>/ˈeː.ɹəʉˌspæɪs/</ns0:pron>
        <ns0:pron>/ˈɛɹ.oʊˌspeɪs/</ns0:pron>
        <ns0:pron>[ˈeɪ.əɹ-]</ns0:pron>
        <ns0:pron>[ˈɛə̯.ɹəʊˌspeɪs]</ns0:pron>
        <ns0:pron>[ˈɛː.ɹowˌspejs]</ns0:pron>
        <ns0:pron>[ˈɛː.ɹowˌspeːs]</ns0:pron>
        <ns0:pron>[ˈɛː.ɹəʊˌspɛjs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeroespacio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The atmosphere of the Earth and the region of space around it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerospatial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aeroespacial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to aerospace.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerostat</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerostato</ns0:quote>
          <ns0:quote>aeróstato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An aircraft, such as a dirigible or balloon, that derives its lift from buoyancy rather than from wings or rotors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerostatics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerostática</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) the study of gases in equilibrium and of balloons or aircraft in varying atmospheric conditions</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerothermal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerotérmico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aerotrain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aerotrén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A train that is supported on a cushion of air, in the manner of a hovercraft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aesthete</ns0:orth>
        <ns0:pron>/ˈiːs.θiːt/</ns0:pron>
        <ns0:pron>/ˈɛs.θiːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esteta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often, derogatory) Someone who cultivates an unusually high sensitivity to beauty, as in art or nature, often in a manner perceived to prioritize beauty over other qualities such as virtue and utility.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aesthetic</ns0:orth>
        <ns0:pron>/-tɛtɪk/</ns0:pron>
        <ns0:pron>/iːsˈθɛ.tɪk/</ns0:pron>
        <ns0:pron>/æsˈθɛ.tɪk/</ns0:pron>
        <ns0:pron>/əsˈθɛ.tɪk/</ns0:pron>
        <ns0:pron>/ɛsˈθɛ.tɪk/</ns0:pron>
        <ns0:pron>/ɪsˈθɛ.tɪk/</ns0:pron>
        <ns0:pron>/ɪsˈθɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Concerned with beauty, artistic effect, or appearance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(rarely, proscribed) Beautiful or appealing to one's sense of beauty or art.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aesthetically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estéticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an aesthetic manner; with a pleasing sensory effect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aestheticism</ns0:orth>
        <ns0:pron>/ˌæsˈθɛ.tɪˌsɪ.zəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esteticismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A doctrine which holds aesthetics or beauty as the highest ideal or most basic standard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aesthetics</ns0:orth>
        <ns0:pron>/ɛsˈtɛt.ɪks/</ns0:pron>
        <ns0:pron>/ɛsˈθɛt.ɪks/</ns0:pron>
        <ns0:pron>/ˈest̪ʰəʈɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estética</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study or philosophy of beauty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aestivation</ns0:orth>
        <ns0:pron>/ˌiːstɪˈveɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estivación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A state of inactivity and metabolic depression during summer: the summer version of hibernation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aetiology</ns0:orth>
        <ns0:pron>/i.tiˈɑ.lə.d͡ʒi/</ns0:pron>
        <ns0:pron>/iː.tɪˈɒ.lə.dʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>etiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, uncountable) The study or investigation of the causes of disease; a scientific explanation for the origin of a disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aetiopathogenesis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>etiopatogenia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The cause and subsequent development of an abnormal condition or of a disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aeviternity</ns0:orth>
        <ns0:pron>/ˌivəˈtɝnəti/</ns0:pron>
        <ns0:pron>/ˌiːvɪˈtɜːnɪti/</ns0:pron>
        <ns0:pron>[-ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eviternidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Scholastic, _, philosophy) Synonym of aevum (“the temporal mode of existence between time and eternity, said to be experienced by angels, saints, and celestial bodies (which medieval astronomy believed to be unchanging)”).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afar</ns0:orth>
        <ns0:pron>/əˈfɑɹ/</ns0:pron>
        <ns0:pron>/əˈfɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a lo lejos</ns0:quote>
          <ns0:quote>lejos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At, to, or from a great distance; far away.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afebrile</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afebril</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having no fever, without a fever.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affability</ns0:orth>
        <ns0:pron>/ˌæfəˈbɪlɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state or quality of being affable, friendly, or approachable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affable</ns0:orth>
        <ns0:pron>/ˈæf.ə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Receiving others kindly and conversing with them in a free and friendly manner; friendly, courteous, sociable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amable</ns0:quote>
          <ns0:quote>tranquilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Mild; benign.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affair</ns0:orth>
        <ns0:pron>/əˈfeə/</ns0:pron>
        <ns0:pron>/əˈfeɹ/</ns0:pron>
        <ns0:pron>/əˈfeː/</ns0:pron>
        <ns0:pron>/əˈfiə/</ns0:pron>
        <ns0:pron>/əˈfɛə/</ns0:pron>
        <ns0:pron>/əˈfɛɚ/</ns0:pron>
        <ns0:pron>/əˈfɛɹ/</ns0:pron>
        <ns0:pron>/əˈfɜː(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>negocio</ns0:quote>
          <ns0:quote>asunto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(often in the plural) Something which is done or is to be done; business of any kind, commercial, professional, or public.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asunto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any proceeding or action which it is wished to refer to or characterize vaguely.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A material object (vaguely designated).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asunto</ns0:quote>
          <ns0:quote>aventura</ns0:quote>
          <ns0:quote>affaire</ns0:quote>
          <ns0:quote>amorío</ns0:quote>
          <ns0:quote>devaneo</ns0:quote>
          <ns0:quote>escarceo amoroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person with whom someone has an adulterous relationship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>partes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, now, rare) The (male or female) genitals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affect</ns0:orth>
        <ns0:pron>/əˈfɛkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To influence or alter.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, pathology) Of an illness or condition, to infect or harm (a part of the body).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fingir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make a show of; to put on a pretense of; to feign; to assume. To make a false display of. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectar</ns0:quote>
          <ns0:quote>conmover</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To move to emotion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affectable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be affected.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affectation</ns0:orth>
        <ns0:pron>/ˌæf.ɛkˈteɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An attempt to assume or exhibit what is not natural or real; false display; artificial show. [from 1548]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affected</ns0:orth>
        <ns0:pron>/əˈfɛktɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amanerado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Influenced or changed by something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectado</ns0:quote>
          <ns0:quote>amanerado</ns0:quote>
          <ns0:quote>aquejado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resulting from a mostly negative physical effect or transformation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affecting</ns0:orth>
        <ns0:pron>/əˈfɛktɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conmovedor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Producing or causing strong feelings and emotions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affection</ns0:orth>
        <ns0:pron>/əˈfɛk.t͡ʃən/</ns0:pron>
        <ns0:pron>/əˈfɛk.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apego</ns0:quote>
          <ns0:quote>cariño</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afecto</ns0:quote>
          <ns0:quote>afección</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of affecting or acting upon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affectionate</ns0:orth>
        <ns0:pron>/əˈfɛkʃənət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectuoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a person) Having affection or warm regard; loving; fond.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectuoso</ns0:quote>
          <ns0:quote>cariñoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of an action, etc.) Characterised by or proceeding from affection; indicating love; tender.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affectionately</ns0:orth>
        <ns0:pron>/əˈfɛkʃənətli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectuosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an affectionate manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affective</ns0:orth>
        <ns0:pron>/əˈfɛktɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afectivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to, resulting from, or influenced by the emotions.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Emotional; emotionally charged; affecting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afferent</ns0:orth>
        <ns0:pron>/ˈæ.fə.ɹənt/</ns0:pron>
        <ns0:pron>/ˈæ.fɜː.ənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aferente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Carrying towards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affidavit</ns0:orth>
        <ns0:pron>/-ævɪt/</ns0:pron>
        <ns0:pron>/ˌæfɪˈdeɪvɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>affidávit</ns0:quote>
          <ns0:quote>afidávit</ns0:quote>
          <ns0:quote>declaración jurada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) A signed document wherein an affiant makes a sworn statement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affiliate</ns0:orth>
        <ns0:pron>/əˈfɪl.i.eɪt/</ns0:pron>
        <ns0:pron>/əˈfɪl.i.ət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afiliada</ns0:quote>
          <ns0:quote>afiliado</ns0:quote>
          <ns0:quote>filial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone or something, especially, a television station, that is associated with a larger, related organization, such as a television network; a member of a group of associated things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affiliate</ns0:orth>
        <ns0:pron>/əˈfɪl.i.eɪt/</ns0:pron>
        <ns0:pron>/əˈfɪl.i.ət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afiliar</ns0:quote>
          <ns0:quote>asociar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, followed by "to" or "with") To attach (to) or unite (with); to receive into a society as a member, and initiate into its mysteries, plans, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affiliation</ns0:orth>
        <ns0:pron>/əˌfɪliˈeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afiliación</ns0:quote>
          <ns0:quote>filiación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The relationship resulting from affiliating one thing with another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affine transformation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>transformación afín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry, linear algebra) A geometric transformation that preserves lines and parallelism, but in general not lengths or angles; (more formally) an automorphism of an affine space: a mapping of an affine space onto itself that preserves both the dimension of any affine subspace and the ratio of the lengths of any pair of parallel line segments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affinity</ns0:orth>
        <ns0:pron>/əˈfɪnɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afinidad</ns0:quote>
          <ns0:quote>apegamiento</ns0:quote>
          <ns0:quote>inhesión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A natural attraction or feeling of kinship to a person or thing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afinidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A family relationship through marriage of a relative (e.g. sister-in-law), as opposed to consanguinity (e.g. sister).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any passionate love for something.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chemistry) An attractive force between atoms, or groups of atoms, that contributes towards their forming bonds.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) The attraction between an antibody and an antigen</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirm</ns0:orth>
        <ns0:pron>/əˈfɜːm/</ns0:pron>
        <ns0:pron>/əˈfɝm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To agree, verify or concur; to answer positively.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To assert positively; to tell with confidence; to aver; to maintain as true.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To make firm; to confirm, or ratify; especially (legal) to assert or confirm, as a judgment, decree, or order, brought before an appellate court for review.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirmation</ns0:orth>
        <ns0:pron>/æfɝˈmeɪʃn/</ns0:pron>
        <ns0:pron>/əfə(r)ˈmeʃən/</ns0:pron>
        <ns0:pron>/ˈafəmeʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which is affirmed; a declaration that something is true.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirmative</ns0:orth>
        <ns0:pron>/əˈfɜːmətɪv/</ns0:pron>
        <ns0:pron>/əˈfɝməɾɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>pertaining to truth; asserting that something is; affirming</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>positivo</ns0:quote>
          <ns0:quote>afirmativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) positive; not negative</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirmative</ns0:orth>
        <ns0:pron>/əˈfɜːmətɪv/</ns0:pron>
        <ns0:pron>/əˈfɝməɾɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmativa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Yes; an answer that shows agreement or acceptance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) An answer that shows agreement or acceptance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirmative action</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>discriminación positiva</ns0:quote>
          <ns0:quote>acción afirmativa</ns0:quote>
          <ns0:quote>acción positiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A set of policies or programs providing advantages for people of a group who are seen to have traditionally been the target of discrimination.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirmative sentence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frase afirmativa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A sentence that affirms (rather than negates) a proposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affirmatively</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afirmativamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an affirming manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affix</ns0:orth>
        <ns0:pron>/əˈfɪks/</ns0:pron>
        <ns0:pron>/ˈæf.ɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afijo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistic morphology) A bound morpheme added to a word’s stem, such as a prefix or suffix.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(now, uncommon) That which is affixed; an appendage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affix</ns0:orth>
        <ns0:pron>/əˈfɪks/</ns0:pron>
        <ns0:pron>/ˈæf.ɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fijar</ns0:quote>
          <ns0:quote>afijar</ns0:quote>
          <ns0:quote>pegar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afflatus</ns0:orth>
        <ns0:pron>/-ɾəs/</ns0:pron>
        <ns0:pron>/əˈfleɪtəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aflato</ns0:quote>
          <ns0:quote>inspiración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sudden rush of creative impulse or inspiration, often attributed to divine influence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afflict</ns0:orth>
        <ns0:pron>/əˈflɪkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acorar</ns0:quote>
          <ns0:quote>afligir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) To strike or cast down; to overthrow; to result.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afflicted</ns0:orth>
        <ns0:pron>/əˈflɪktɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aquejado</ns0:quote>
          <ns0:quote>atribulado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Suffering from an affliction, or suffering from pain, distress or disability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affliction</ns0:orth>
        <ns0:pron>/əˈflɪk.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aflicción</ns0:quote>
          <ns0:quote>quebranto</ns0:quote>
          <ns0:quote>tribulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of pain, suffering, distress or agony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afflictive</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aflictivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That causes physical or mental pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affluence</ns0:orth>
        <ns0:pron>/ˈæf.lu.əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundancia</ns0:quote>
          <ns0:quote>afluencia</ns0:quote>
          <ns0:quote>prosperidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abundance of wealth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affluent</ns0:orth>
        <ns0:pron>/æˈfluːənt/</ns0:pron>
        <ns0:pron>/əˈfluːənt/</ns0:pron>
        <ns0:pron>/əˈflʊwəɳʈ/</ns0:pron>
        <ns0:pron>/ˈaflʊwəɳʈ/</ns0:pron>
        <ns0:pron>/ˈæf.lu.ənt/</ns0:pron>
        <ns0:pron>/ˈæfluːənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abundante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Abundant; copious; plenteous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acomodado</ns0:quote>
          <ns0:quote>rico</ns0:quote>
          <ns0:quote>acaudalado</ns0:quote>
          <ns0:quote>adinerado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) Abounding in goods or riches; having a moderate level of material wealth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afluente</ns0:quote>
          <ns0:quote>afluyente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) Tributary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affluent</ns0:orth>
        <ns0:pron>/æˈfluːənt/</ns0:pron>
        <ns0:pron>/əˈfluːənt/</ns0:pron>
        <ns0:pron>/əˈflʊwəɳʈ/</ns0:pron>
        <ns0:pron>/ˈaflʊwəɳʈ/</ns0:pron>
        <ns0:pron>/ˈæf.lu.ənt/</ns0:pron>
        <ns0:pron>/ˈæfluːənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ricachón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Somebody who is wealthy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afford</ns0:orth>
        <ns0:pron>/əˈfo(r)ɖ/</ns0:pron>
        <ns0:pron>/əˈfo(ː)ɹd/</ns0:pron>
        <ns0:pron>/əˈfoəd/</ns0:pron>
        <ns0:pron>/əˈfoɹd/</ns0:pron>
        <ns0:pron>/əˈfɔːd/</ns0:pron>
        <ns0:pron>/əˈfɜ(r)ɖ/</ns0:pron>
        <ns0:pron>[əˈfo̞ɹd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asequir</ns0:quote>
          <ns0:quote>costear</ns0:quote>
          <ns0:quote>exequir</ns0:quote>
          <ns0:quote>permitirse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To incur, stand, or bear without serious detriment, as an act which might under other circumstances be injurious; (usually, after an expression of ability, as could, able, difficult) to be able or rich enough; to spare.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affordability</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asequibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The extent or degree to which something is affordable, as measured by its cost relative to the amount that the purchaser is able to pay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affordable</ns0:orth>
        <ns0:pron>/əˈfɔɹ.də.bəl/</ns0:pron>
        <ns0:pron>/əˈfɔː(ɹ).də.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asequible</ns0:quote>
          <ns0:quote>económico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be afforded; inexpensive or reasonably priced.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affordance</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ofrecimiento</ns0:quote>
          <ns0:quote>asequiencia</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>affordant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asequiente</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>afforest</ns0:orth>
        <ns0:pron>/əˈfɒɹɪst/</ns0:pron>
        <ns0:pron>/əˈfɔɹɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arborizar</ns0:quote>
          <ns0:quote>forestar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make into forest</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
