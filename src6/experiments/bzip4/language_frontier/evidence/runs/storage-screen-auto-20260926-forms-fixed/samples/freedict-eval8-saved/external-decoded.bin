        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god, in the singular) The goddess of luck/fortune; counterpart of the Roman Fortuna.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
