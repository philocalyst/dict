      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Paracas</ns0:quote>
          <ns0:quote>bahía de Paracas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bay of Pisco Province, Ica Region, Peru, on the Pacific Ocean; in full, Paracas Bay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Paracas</ns0:quote>
          <ns0:quote>distrito de Paracas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A district of Pisco, Ica, Peru; in full, Paracas District.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Paracas</ns0:quote>
          <ns0:quote>península de Paracas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula in Pisco Province, Ica Region, Peru in the Pacific Ocean; in full, Paracas Peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Paracas</ns0:quote>
          <ns0:quote>cultura Paracas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ellipsis of Paracas culture or Paracas civilization, a 1st-millennium BCE pre-Nazca cultural civilization in Peru famous for geoglyphs on hillsides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
