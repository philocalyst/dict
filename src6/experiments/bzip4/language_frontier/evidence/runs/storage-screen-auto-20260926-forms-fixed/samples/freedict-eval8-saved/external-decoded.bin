      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lutero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Martin Luther, German monk and theologian whose teaching inspired the Reformation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lutheran</ns0:orth>
        <ns0:pron>/ˈluːθəɹ(ə)n/</ns0:pron>
        <ns0:pron>/ˈluːθɹ(ə)n/</ns0:pron>
        <ns0:pron>/ˈluθəɹən/</ns0:pron>
        <ns0:pron>/ˈluθɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luterano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) Of or pertaining to the theology of Martin Luther (1483–1546) or his followers, or the Lutheran church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lutheran</ns0:orth>
        <ns0:pron>/ˈluːθəɹ(ə)n/</ns0:pron>
        <ns0:pron>/ˈluːθɹ(ə)n/</ns0:pron>
        <ns0:pron>/ˈluθəɹən/</ns0:pron>
        <ns0:pron>/ˈluθɹən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luterano</ns0:quote>
          <ns0:quote>luterana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A member of any of the Christian churches which identify with the theology of Martin Luther.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lutheranism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luteranismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Christian denomination based on the beliefs and doctrines developed by Martin Luther and his immediate followers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luwian</ns0:orth>
