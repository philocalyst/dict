        <ns0:pron>/ˈd͡ʒeɪfɛð/</ns0:pron>
        <ns0:pron>/ˈd͡ʒeɪfɛθ/</ns0:pron>
        <ns0:pron>/ˈd͡ʒeɪfɪθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jafet</ns0:quote>
          <ns0:quote>Japhet</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The third son of Noah, brother to Shem and Ham, who received a blessing from God with Shem, considered to be the ancestor of the Japhetic people(s) (associated approx. with Indo-Europeans and Turks).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
