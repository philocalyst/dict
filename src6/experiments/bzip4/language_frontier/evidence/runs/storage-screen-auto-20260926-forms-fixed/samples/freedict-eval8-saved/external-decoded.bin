        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carbonero carigualdo indio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Machlolophus aplonotus, a small bird of the tit family Paridae</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian elephant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>elefante indio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A subspecies of the Asian elephant, Elephas maximus indicus, distributed across India, Nepal, Bangladesh, Bhutan, Myanmar, Thailand, the Malay Peninsula, Laos, southern China, Cambodia, Vietnam, and formerly Pakistan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
