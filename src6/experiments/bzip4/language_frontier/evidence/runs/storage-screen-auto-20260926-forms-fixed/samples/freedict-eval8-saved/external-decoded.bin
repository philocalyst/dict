      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acotación</ns0:quote>
          <ns0:quote>cota</ns0:quote>
          <ns0:quote>marca topográfica</ns0:quote>
          <ns0:quote>punto de referencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surveyor's mark made on some stationary object and shown on a map; used as a reference point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bend</ns0:orth>
        <ns0:pron>/bɛnd/</ns0:pron>
        <ns0:pron>/bɪnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>curva</ns0:quote>
          <ns0:quote>recodo</ns0:quote>
          <ns0:quote>doblegadura</ns0:quote>
          <ns0:quote>doblegamiento</ns0:quote>
          <ns0:quote>quingo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A curve.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(heraldiccharge) One of the honourable ordinaries formed by two diagonal lines drawn from the dexter chief to the sinister base; it generally occupies a fifth part of the shield if uncharged, but if charged one third.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bend</ns0:orth>
        <ns0:pron>/bɛnd/</ns0:pron>
        <ns0:pron>/bɪnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>doblarse</ns0:quote>
          <ns0:quote>pandear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To become curved.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arquearse</ns0:quote>
          <ns0:quote>enarcarse</ns0:quote>
          <ns0:quote>inclinarse</ns0:quote>
          <ns0:quote>prosternarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To bow in prayer, or in token of submission.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>someter</ns0:quote>
          <ns0:quote>doblegar</ns0:quote>
          <ns0:quote>someterse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To force to submit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>curvar</ns0:quote>
          <ns0:quote>doblar</ns0:quote>
          <ns0:quote>doblarse</ns0:quote>
          <ns0:quote>encorvar</ns0:quote>
          <ns0:quote>arquear</ns0:quote>
          <ns0:quote>doblegar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, nautical) To tie, as in securing a line to a cleat; to shackle a chain to an anchor; make fast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bend down</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agacharse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To bend one's legs while upright to get to a lower position.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
