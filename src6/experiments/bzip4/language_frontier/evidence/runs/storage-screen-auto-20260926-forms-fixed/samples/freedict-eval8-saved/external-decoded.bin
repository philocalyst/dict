    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>OK</ns0:orth>
        <ns0:pron>/əˈkeɪ/</ns0:pron>
        <ns0:pron>/ˌoʊˈkeɪ/</ns0:pron>
        <ns0:pron>/ˌəʊˈkeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de acuerdo</ns0:quote>
          <ns0:quote>okey</ns0:quote>
          <ns0:quote>aprobación</ns0:quote>
          <ns0:quote>sí</ns0:quote>
          <ns0:quote>visto bueno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
