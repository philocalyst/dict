        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cociente de aspecto</ns0:quote>
          <ns0:quote>ratio de aspecto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ratio of an object's longest dimension to its next-longest dimension.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspectual</ns0:orth>
