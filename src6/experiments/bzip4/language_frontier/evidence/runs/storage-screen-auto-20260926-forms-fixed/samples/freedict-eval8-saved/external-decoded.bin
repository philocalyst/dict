      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>All right, acceptable, permitted.</ns0:def>
        </ns0:sense>
        <ns0:sense>
