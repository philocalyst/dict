        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Dakota del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state in the Upper Midwest region of the United States. Capital: Pierre. Largest city: Sioux Falls.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
