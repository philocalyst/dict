        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Romance language spoken in east-central France, western Switzerland, and northwestern Italy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Francoism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
