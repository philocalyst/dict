        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspergilloma</ns0:orth>
        <ns0:pron>/ˌæspəɹd͡ʒɪˈloʊmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspergiloma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A clump of fungus in a body cavity such as the lung, usually associated with the Aspergillus species.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspergillosis</ns0:orth>
        <ns0:pron>/ˌæspəɹd͡ʒɪˈloʊsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspergilosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various infections by fungi of the genus Aspergillus that cause granulomatous lesions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspergillum</ns0:orth>
        <ns0:pron>/ˌas.pəɹˈd͡ʒɪl.əm/</ns0:pron>
        <ns0:pron>/ˌas.pəˈd͡ʒɪl.əm/</ns0:pron>
        <ns0:pron>/ˌæs.pəɹˈd͡ʒɪl.əm/</ns0:pron>
        <ns0:pron>/ˌæs.pəˈd͡ʒɪl.əm/</ns0:pron>
        <ns0:pron>/ˌæs.pɜʳˈd͡ʒil.um/</ns0:pron>
        <ns0:pron>/ˌɛs.pɐˈd͡ʒəl.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aspersorio</ns0:quote>
          <ns0:quote>hisopo</ns0:quote>
        </ns0:cit>
