        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sofonías</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A book of the Old Testament and the Hebrew Tanakh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zephyr</ns0:orth>
        <ns0:pron>/ˈzɛfə/</ns0:pron>
        <ns0:pron>/ˈzɛfɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Céfiro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The god of the West Wind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zephyrus</ns0:orth>
        <ns0:pron>/ˈzɛfɪɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Céfiro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The Ancient Greek god of the west wind, supposed to be the gentlest of the winds and the messenger of spring. His parents are Eos/Aurora and Astraeus, and his brothers are Boreas, Notus and Eurus, (the Anemoi), and the Astra Planeta. His wife is Chloris and their son is Karpos. His Roman counterpart is Favonius.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zeppelin</ns0:orth>
        <ns0:pron>/ˈzɛ.pə.lɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zepelín</ns0:quote>
          <ns0:quote>dirigible</ns0:quote>
          <ns0:quote>cepelín</ns0:quote>
          <ns0:quote>zépelin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) A type of large dirigible rigid airship of the early 20th century, built by the German Luftschiffbau Zeppelin and designed to carry passengers or bombs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zerubbabel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zorobabel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) a governor of the Persian Province of Judah, who led the first group of Jews returned from the Babylonian Captivity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zeus</ns0:orth>
        <ns0:pron>/zjuːs/</ns0:pron>
        <ns0:pron>/zus/</ns0:pron>
        <ns0:pron>/zɪu̯s/</ns0:pron>
        <ns0:pron>/zʉs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zeus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) Supreme ruler of all Greek gods, husband to Hera.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zhukov</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zhúkov</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transliteration of the Russian surname Жу́ков (Žúkov).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zika virus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>virus del Zika</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A particular flavivirus, causing mild illness and linked with birth defects in humans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zilpah</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zilpa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) Handmaid of Leah and mother of Gad and Asher.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zimbabwe</ns0:orth>
