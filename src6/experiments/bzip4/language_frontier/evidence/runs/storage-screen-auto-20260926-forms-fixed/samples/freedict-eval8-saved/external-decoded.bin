        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acumulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(accounting) The continuous growth of capital by retention of interest or savings.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(finance) The action of investors buying an asset from other investors when the price of the asset is low.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
