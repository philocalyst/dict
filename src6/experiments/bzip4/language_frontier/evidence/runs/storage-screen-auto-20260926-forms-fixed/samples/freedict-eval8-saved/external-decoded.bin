        <ns0:pron>/ˌməʊnə ˈliːzə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gioconda</ns0:quote>
          <ns0:quote>Mona Lisa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(with definite article) A portrait painting by Leonardo da Vinci, widely considered to be the most famous painting in history.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Monaco</ns0:orth>
        <ns0:pron>/mɒˈnɑː.kəʊ/</ns0:pron>
        <ns0:pron>/ˈmɑ.nə.koʊ/</ns0:pron>
        <ns0:pron>/ˈmɒ.nə.kəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mónaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city-state in Western Europe. Official name: Principality of Monaco.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
