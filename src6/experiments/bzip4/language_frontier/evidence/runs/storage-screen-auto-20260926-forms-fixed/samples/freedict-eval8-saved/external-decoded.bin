          <ns0:quote>pordiosero</ns0:quote>
          <ns0:quote>mendiga</ns0:quote>
          <ns0:quote>limosnero</ns0:quote>
          <ns0:quote>mendicante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who begs.</ns0:def>
