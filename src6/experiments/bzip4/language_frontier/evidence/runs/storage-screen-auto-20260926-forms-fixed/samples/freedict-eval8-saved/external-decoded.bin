    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Exodus</ns0:orth>
        <ns0:pron>/ˈɛksədəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Éxodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) The departure of the Hebrew slaves from Egypt under the leadership of Moses.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(book of the bible) The second of the Books of Moses in the Old Testament of the Bible, the second book in the Torah describing the Exodus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Extremadura</ns0:orth>
        <ns0:pron>/ˌɛkstɹəməˈdʊəɹə/</ns0:pron>
