    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Soviet</ns0:orth>
        <ns0:pron>/ˈsoʊvi.ət/</ns0:pron>
        <ns0:pron>/ˈsoʊvi.ɛt/</ns0:pron>
