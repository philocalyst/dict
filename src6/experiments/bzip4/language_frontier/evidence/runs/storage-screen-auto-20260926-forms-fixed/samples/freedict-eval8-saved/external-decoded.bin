          <ns0:quote>Troya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) An ancient city in what is now northwestern Turkey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Trucial States</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estados de la Tregua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Former name of Trucial Oman: A collection of former protectorates (since the 1820 General Maritime Treaty) of the United Kingdom, comprising most of the small Arab coastal states (then sheikhdoms) located along the Persian Gulf. The precursor of the United Arab Emirates (UAE).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
