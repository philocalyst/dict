          <ns0:quote>pigargo americano</ns0:quote>
          <ns0:quote>pigargo cabeciblanco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Haliaeetus leucocephalus, a species of eagle native to North America and notable for the white plumage on its head.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
