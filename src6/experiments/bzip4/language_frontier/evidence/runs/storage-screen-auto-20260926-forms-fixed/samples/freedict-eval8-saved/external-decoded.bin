      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acerbidad</ns0:quote>
          <ns0:quote>amargura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sourness of taste, with bitterness and astringency, like that of unripe fruit.</ns0:def>
        </ns0:sense>
        <ns0:sense>
