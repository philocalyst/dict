      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>síndrome de Ménière</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A disorder of the inner ear, caused by lymphatic channel dilation and characterized by episodes of dizziness and tinnitus and progressive hearing loss, usually in one ear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
