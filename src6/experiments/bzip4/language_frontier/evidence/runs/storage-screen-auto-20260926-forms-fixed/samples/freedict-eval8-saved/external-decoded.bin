        <ns0:pron>/bəˈləʊni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mortadela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of sausage; bologna.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chorrada</ns0:quote>
          <ns0:quote>chuminada</ns0:quote>
          <ns0:quote>farfolla</ns0:quote>
          <ns0:quote>inventos</ns0:quote>
          <ns0:quote>tonterías</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, chiefly, US, slang) Nonsense.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balsam</ns0:orth>
        <ns0:pron>/ˈbɑl.səm/</ns0:pron>
        <ns0:pron>/ˈbɔl.səm/</ns0:pron>
        <ns0:pron>/ˈbɔːl.səm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bálsamo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, UK) A sweet-smelling oil or resin derived from various plants.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chiefly, UK) A soothing ointment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balsamina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A flowering plant of the genus Impatiens.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balun</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balun</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An electronic device for connecting a balanced transmission line to an unbalanced one.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baluster</ns0:orth>
        <ns0:pron>/ˈbaləstə/</ns0:pron>
        <ns0:pron>/ˈbæləstɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balaustre</ns0:quote>
          <ns0:quote>balaústre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A short column used in a group to support a rail, as commonly found on the side of a stairway or around a balcony; a banister.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balustrade</ns0:orth>
        <ns0:pron>/ˈbæl.ə.stɹeɪd/</ns0:pron>
        <ns0:pron>/ˌbæl.əˈstɹeɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balaustrada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A row of balusters topped by a rail, serving as an open parapet, as along the edge of a balcony, terrace, bridge, staircase, or the eaves of a building.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bamboo</ns0:orth>
        <ns0:pron>/bæmˈbu/</ns0:pron>
        <ns0:pron>/ˈbambu/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bambú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The wood of the bamboo plant as a material for building, furniture, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(slang) A didgeridoo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bamboozle</ns0:orth>
        <ns0:pron>/bæmˈbu.zl̩/</ns0:pron>
        <ns0:pron>/bæmˈbuː.zl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embabucar</ns0:quote>
          <ns0:quote>embaucar</ns0:quote>
          <ns0:quote>engañar</ns0:quote>
          <ns0:quote>mecer</ns0:quote>
          <ns0:quote>timar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, informal) To con, defraud, trick, to make a fool of, to humbug or impose on someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ban</ns0:orth>
        <ns0:pron>/bæn/</ns0:pron>
        <ns0:pron>/bæːn/</ns0:pron>
        <ns0:pron>[beən]</ns0:pron>
        <ns0:pron>[bɛən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prohibición</ns0:quote>
          <ns0:quote>baneo</ns0:quote>
          <ns0:quote>vedamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A prohibition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ban</ns0:orth>
        <ns0:pron>/bæn/</ns0:pron>
        <ns0:pron>/bæːn/</ns0:pron>
        <ns0:pron>[beən]</ns0:pron>
        <ns0:pron>[bɛən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prohibir</ns0:quote>
          <ns0:quote>banear</ns0:quote>
          <ns0:quote>vedar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To prohibit; to interdict; to proscribe; to forbid or block from participation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banal</ns0:orth>
        <ns0:pron>/bəˈnæl/</ns0:pron>
        <ns0:pron>/bəˈnɑːl/</ns0:pron>
        <ns0:pron>/ˈbeɪnəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Common in a boring way, to the point of being predictable; containing nothing new or fresh.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncommon, historical) Relating to a type of feudal jurisdiction or service.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banality</ns0:orth>
        <ns0:pron>/beɪˈnælɪti/</ns0:pron>
        <ns0:pron>/bəˈnælɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banalidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality of being banal.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) Something which is banal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banalize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banalizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make banal or commonplace.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banally</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a banal, trite or boring manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banana</ns0:orth>
        <ns0:pron>/bəˈnæ.nə/</ns0:pron>
        <ns0:pron>/bəˈnɑ.nɑ/</ns0:pron>
        <ns0:pron>/bəˈnɑː.nə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plátano</ns0:quote>
          <ns0:quote>banana</ns0:quote>
          <ns0:quote>banano</ns0:quote>
          <ns0:quote>cambur</ns0:quote>
          <ns0:quote>guineo</ns0:quote>
          <ns0:quote>fongo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(North America, UK, Ireland) In particular, the sweet, yellow fruit of the Cavendish banana cultivar, which may be eaten raw, as distinct from e.g. a plantain for cooking.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An elongated curved tropical fruit of a banana plant, which grows in bunches and has a creamy flesh and a smooth skin. [from 1597]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bananero</ns0:quote>
          <ns0:quote>banano</ns0:quote>
          <ns0:quote>plátano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The tropical tree-like plant which bears clusters of bananas, a plant of the genus Musa (but sometimes also including plants from Ensete), which has large, elongated leaves. [from 1697]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banana bread</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pan de plátano / banana / guineo</ns0:quote>
          <ns0:quote>queque bananero / platanero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of bread or cake made with mashed bananas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banana peel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cáscara de banana</ns0:quote>
          <ns0:quote>cáscara de plátano</ns0:quote>
          <ns0:quote>cáscara bananera</ns0:quote>
          <ns0:quote>cáscara platanera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Canadian, US, Philippines) The several outermost layers of a banana, especially once removed from the rest of the banana, which may be slippery if stepped on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banana pepper</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ají / locote bananero</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banana republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>república bananera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, idiom, pejorative) A small country, especially one in Central America or the West Indies, that is dependent on a single export commodity (traditionally bananas) and that has a corrupt, dictatorial government.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banana split</ns0:orth>
        <ns0:pron>/bəˈnæ.nə splɪt/</ns0:pron>
        <ns0:pron>/bəˈnɑː.nə splɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banana split</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dessert or sundae containing a banana cut in half lengthwise (split), ice cream and various toppings which may include sauces, nuts or fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bananaquit</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>platanero</ns0:quote>
          <ns0:quote>reinita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A nectar-feeding bird, Coereba flaveola, thought to be related to the Darwin's finches and the grassquits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>band</ns0:orth>
        <ns0:pron>/bænd/</ns0:pron>
        <ns0:pron>[beənd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinta</ns0:quote>
          <ns0:quote>franja</ns0:quote>
          <ns0:quote>banda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strip of material wrapped around things to hold them together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banda</ns0:quote>
          <ns0:quote>grupo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of musicians who perform together as an ensemble; sometimes, such a group working for a professional recording artist.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A continuous tablet, stripe, or series of ornaments, as of carved foliage, of colour, or of brickwork.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physics) A part of the electromagnetic spectrum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of people loosely united for a common purpose, such as a band of thieves.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pasmo</ns0:quote>
          <ns0:quote>banda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A group of energy levels in a solid state material.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>band-aid</ns0:orth>
        <ns0:pron>/ˈbændeɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tirita</ns0:quote>
          <ns0:quote>esparadrapo</ns0:quote>
          <ns0:quote>apósito</ns0:quote>
          <ns0:quote>curita</ns0:quote>
          <ns0:quote>leuco</ns0:quote>
          <ns0:quote>parche curita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Australia, North America, Philippines) An adhesive bandage, a small piece of fabric or plastic that may be stuck to the skin in order to temporarily cover a small wound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>paños calientes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Australia, Canada, US, Philippines, informal) A temporary or makeshift solution to a problem, created ad hoc and often with a lack of foresight. [from 1968]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>band-tailed antshrike</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batará Guayanés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a passerine bird of the antbird family, Sakesphorus melanothorax.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandage</ns0:orth>
        <ns0:pron>/baɳɖ.edʒ/</ns0:pron>
        <ns0:pron>/ˈbændɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venda</ns0:quote>
          <ns0:quote>vendaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strip of gauze or similar material used to protect or support a wound or injury.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandage</ns0:orth>
        <ns0:pron>/baɳɖ.edʒ/</ns0:pron>
        <ns0:pron>/ˈbændɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vendar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To apply a bandage to something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandana</ns0:orth>
        <ns0:pron>/bænˈdæn.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fular</ns0:quote>
          <ns0:quote>paliacate</ns0:quote>
          <ns0:quote>pañoleta</ns0:quote>
          <ns0:quote>pañuelo</ns0:quote>
          <ns0:quote>toquilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large kerchief, usually colourful and used either as headgear or as a handkerchief, neckerchief, bikini, or sweatband.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banderilla</ns0:orth>
        <ns0:pron>/ˌbæn.dəˈɹiː.jə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banderilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(bullfighting) A decorated barbed stick used in bullfighting to stick into the bulls' shoulders.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banderillero</ns0:orth>
        <ns0:pron>/ˌbændəɹiːˈjeəɹəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banderillero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(bullfighting) A member of the cuadrilla who uses banderillas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandicoot</ns0:orth>
        <ns0:pron>/ˈbændiˌkut/</ns0:pron>
        <ns0:pron>/ˈbændɪˌkuːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bandicut</ns0:quote>
          <ns0:quote>peramélido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various small marsupials of Australia and New Guinea, some with distinctive long snouts, of the family Peramelidae.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A bandicoot rat; any of the genera Bandicota and Nesokia of rat-like rodents of southeast Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandit</ns0:orth>
        <ns0:pron>/ˈbændɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bandido</ns0:quote>
          <ns0:quote>bandida</ns0:quote>
          <ns0:quote>bandolero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who robs others in a lawless area, especially as part of a group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bandido</ns0:quote>
          <ns0:quote>bandolero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An outlaw.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandolier</ns0:orth>
        <ns0:pron>/ˌbændəˈlɪə/</ns0:pron>
        <ns0:pron>/ˌbændəˈlɪɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canana</ns0:quote>
          <ns0:quote>bandolera</ns0:quote>
          <ns0:quote>charpa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ammunition belt, worn over the shoulder, having loops or pockets for cartridges.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandoneon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bandoneón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small Latin American accordion played with buttons which is frequently used in tango ensembles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandsaw</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sierra de cinta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A powered saw whose blade is a continuous band of metal with teeth along one edge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandstand</ns0:orth>
        <ns0:pron>/ˈbænd.stænd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>templete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small, open-air platform or enclosure for bands to play on, usually roofed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandurria</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bandurria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(string instruments) A plectrum-plucked stringed instrument with a flat-backed pear-shaped body, with twelve strings in six courses in its most common modern form, originating in Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandwagon</ns0:orth>
        <ns0:pron>/ˈbændˌwæɡ.ən/</ns0:pron>
        <ns0:pron>/ˈbɛndˌwɛɡ.ən/</ns0:pron>
        <ns0:pron>[ˈbɛəndˌwæɡ.ən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tren del mame</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A current movement that attracts wide support. [from 1880]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandwidth</ns0:orth>
        <ns0:pron>/ˈbændwɪdθ/</ns0:pron>
        <ns0:pron>/ˈbændwɪtθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancho de banda</ns0:quote>
          <ns0:quote>anchor de banda</ns0:quote>
          <ns0:quote>anchura de banda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a signal) The width of the smallest frequency band within which the signal can fit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancho de banda</ns0:quote>
          <ns0:quote>grosor de banda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(networking, informal) The rate of data flow in digital networks typically measured in bits per second; the bitrate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandy</ns0:orth>
        <ns0:pron>/ˈbændi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cambiar</ns0:quote>
          <ns0:quote>intercambiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give and receive reciprocally; to exchange.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bandy around</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esparcir</ns0:quote>
          <ns0:quote>lanzar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bane</ns0:orth>
        <ns0:pron>/beɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desgracia</ns0:quote>
          <ns0:quote>maldición</ns0:quote>
          <ns0:quote>perdición</ns0:quote>
          <ns0:quote>quebranto</ns0:quote>
          <ns0:quote>ruina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A cause of misery or ruin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bane</ns0:orth>
        <ns0:pron>/beɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arruinar</ns0:quote>
          <ns0:quote>maldecir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) To cause (someone) misery or ruin; to socially or spiritually injure (someone).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bang</ns0:orth>
        <ns0:pron>/baŋ/</ns0:pron>
        <ns0:pron>/bæn/</ns0:pron>
        <ns0:pron>/bæŋ(ɡ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pum</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sudden percussive sound, such as made by the firing of a gun, slamming of a door, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bang</ns0:orth>
        <ns0:pron>/baŋ/</ns0:pron>
        <ns0:pron>/bæn/</ns0:pron>
        <ns0:pron>/bæŋ(ɡ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estallido</ns0:quote>
          <ns0:quote>estruendo</ns0:quote>
          <ns0:quote>chupinazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sudden percussive noise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golpe</ns0:quote>
          <ns0:quote>percusión</ns0:quote>
          <ns0:quote>zarpazo</ns0:quote>
          <ns0:quote>zumbido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strike upon an object causing such a noise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detonación</ns0:quote>
          <ns0:quote>explosión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An explosion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>signo de exclamación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US) The symbol !, known as an exclamation point.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) A factorial, in mathematics, because the factorial of n is often written as n!</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bang out</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chapucear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, idiomatic) To do (something) quickly, in a slipshod, or unprofessional manner, especially performing or composing music or a piece of writing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bang snap</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chasquibum</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pyrotechnics) A type of very small firework consisting of a small amount of gravel or coarse sand impregnated with a minute amount of silver fulminate and wrapped in a twisted piece of thin paper, which detonates harmlessly when struck, crushed, or ignited.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banger</ns0:orth>
        <ns0:pron>/ˈbæŋ.ə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carcacha</ns0:quote>
          <ns0:quote>tiesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(automotive, slang) An old, worn-out car. From a stereotypical one backfiring, making banging noises.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rolona</ns0:quote>
          <ns0:quote>temazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music, slang) A powerfully energetic and/or very good song, especially in hip-hop and dance music.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golazo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(soccer) A spectacular goal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bangers and mash</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>salchichas con puré</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(British, NZ, informal) A meal of sausages and mashed potato, usually with onions and gravy added.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bangle</ns0:orth>
        <ns0:pron>/ˈbæŋ.ɡəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>brazalete</ns0:quote>
          <ns0:quote>pulsera</ns0:quote>
          <ns0:quote>esclava</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rigid bracelet or anklet, especially one with no clasp.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bangs</ns0:orth>
        <ns0:pron>/bæŋ(ɡ)z/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>flequillo</ns0:quote>
          <ns0:quote>fleco</ns0:quote>
          <ns0:quote>capul</ns0:quote>
          <ns0:quote>cerquillo</ns0:quote>
          <ns0:quote>chasquilla</ns0:quote>
          <ns0:quote>china</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, _, US, Philippines) Hair hanging over the forehead.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banish</ns0:orth>
        <ns0:pron>/ˈbænɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desterrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To send (someone) away and forbid them from returning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banishment</ns0:orth>
        <ns0:pron>/ˈbænɪʃmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>exilio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of banishing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The state of being banished, exile.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banister</ns0:orth>
        <ns0:pron>/ˈbænɪstɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>barandilla</ns0:quote>
          <ns0:quote>barandal</ns0:quote>
          <ns0:quote>pasamano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The handrail on the side of a staircase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banj</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banj</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Quercus leucotrichophora, a type of oak.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banjo</ns0:orth>
        <ns0:pron>/ˈbæn.dʒəʊ/</ns0:pron>
        <ns0:pron>/ˈbæn.d͡ʒoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banjo</ns0:quote>
          <ns0:quote>banyo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A stringed musical instrument (chordophone), usually with a round body, a membrane-like soundboard and a fretted neck, played by plucking or strumming the strings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank</ns0:orth>
        <ns0:pron>/bæŋk/</ns0:pron>
        <ns0:pron>[beɪŋk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>orilla</ns0:quote>
          <ns0:quote>ribera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(hydrology) An edge of river, lake, or other watercourse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hilera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A row or panel of items stored or grouped together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banco</ns0:quote>
          <ns0:quote>banca</ns0:quote>
          <ns0:quote>sucursal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A branch office of such an institution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banco</ns0:quote>
          <ns0:quote>bajío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical, hydrology) An elevation under the sea; a shallow area of shifting sand, gravel, mud, and so forth</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hilera</ns0:quote>
          <ns0:quote>teclado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A row of keys on a musical keyboard or the equivalent on a typewriter keyboard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banca</ns0:quote>
          <ns0:quote>banco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An underwriter or controller of a card game.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>talud</ns0:quote>
          <ns0:quote>terraplén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) A slope of earth, sand, etc.; an embankment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ladeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(aviation) The incline of an aircraft, especially during a turn.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banco</ns0:quote>
          <ns0:quote>almacén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, mostly, in combination) A safe and guaranteed place of storage for and retrieval of important items or goods.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hucha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A device used to store coins or currency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank</ns0:orth>
        <ns0:pron>/bæŋk/</ns0:pron>
        <ns0:pron>[beɪŋk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tener la cuenta en</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To deal with a bank or financial institution, or for an institution to provide financial services to a client.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ladear</ns0:quote>
          <ns0:quote>ladearse</ns0:quote>
          <ns0:quote>peraltar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, aviation) To roll or incline laterally in order to turn.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ahorrar</ns0:quote>
          <ns0:quote>depositar</ns0:quote>
          <ns0:quote>ingresar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put into a bank.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amontonar</ns0:quote>
          <ns0:quote>apilar</ns0:quote>
          <ns0:quote>juntar</ns0:quote>
          <ns0:quote>recoger</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To form into a bank or heap, to bank up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank account</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuenta bancaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fund, held by a bank in a contractual arrangement between the bank and the owner of the fund, a customer of the bank, into which they can deposit and from which they can withdraw money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank cheque</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cheque bancario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(banking) A cheque which is payable by a bank itself, as opposed to an ordinary cheque payable only out of the funds of a particular customer's account. A bank cheque is normally obtained by a bank customer (by paying its face value), the point is that the person receiving the cheque has the security of knowing it's payable by the bank and thus cannot bounce (not so long as the bank is solvent).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank holiday</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fiesta nacional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK, Ireland) A weekday, often a Monday, on which most businesses are closed, and granted to workers as a national holiday.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank robber</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ladrón de bancos</ns0:quote>
          <ns0:quote>robabancos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who robs or steals from a bank.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank run</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pánico bancario</ns0:quote>
          <ns0:quote>estampida bancaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An event where many depositors of one or more banks withdraw money from their bank accounts within a short time, causing the banks concerned to become unstable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank slip</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recibo bancario</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bank statement</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A communication from a bank to a person holding an account in that bank, usually issued monthly, detailing the value of the holdings in that account and the effects of all transactions occurring with respect to that account.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banked slalom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banked slalom</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banker</ns0:orth>
        <ns0:pron>/ˈbæŋkə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈbæŋkɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banquero</ns0:quote>
          <ns0:quote>banquera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who conducts the business of banking; one who, individually, or as a member of a company, keeps an establishment for the deposit or loan of money, or for traffic in money, bills of exchange, etc.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The dealer in a casino, or one who keeps the bank in a banking game.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banking</ns0:orth>
        <ns0:pron>/ˈbæŋkɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>banca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The occupation of managing or working in a bank.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>banknote</ns0:orth>
        <ns0:pron>/ˈbæŋknəʊt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>billete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A piece of currency made of paper or polymer. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bankroll</ns0:orth>
        <ns0:pron>/ˈbæŋk.ɹoʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>billetaje</ns0:quote>
          <ns0:quote>fajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A roll of banknotes or other paper currency, carried in lieu of a wallet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bankrupt</ns0:orth>
        <ns0:pron>/ˈbæŋ.kɹəpt/</ns0:pron>
        <ns0:pron>/ˈbæŋ.kɹʌpt/</ns0:pron>
        <ns0:pron>/ˈbæŋk.ɹəpt/</ns0:pron>
        <ns0:pron>/ˈbæŋk.ɹʌpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quebrado</ns0:quote>
          <ns0:quote>arruinado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance, of a person, company, etc.) In a condition of bankruptcy; unable to pay outstanding debts or meet financial obligations; specifically, having been legally declared insolvent. [from 1565]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bankruptcy</ns0:orth>
        <ns0:pron>/ˈbæŋ.kɹap(t).si/</ns0:pron>
        <ns0:pron>/ˈbæŋ.kɹɐp(t).si/</ns0:pron>
        <ns0:pron>/ˈbæŋ.kɹʌp(t).si/</ns0:pron>
        <ns0:pron>/ˈbæŋk.ɹʌp(t).si/</ns0:pron>
        <ns0:pron>[ˈbɛːŋk.ɹəp(t).si]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bancarrota</ns0:quote>
          <ns0:quote>quiebra</ns0:quote>
          <ns0:quote>falencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance, law) A legally declared or recognized condition of insolvency of a person or organization.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
