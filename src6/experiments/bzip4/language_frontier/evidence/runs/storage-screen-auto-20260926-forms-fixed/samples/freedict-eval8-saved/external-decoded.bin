    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iacchus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iaco</ns0:quote>
          <ns0:quote>Yaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) A minor deity of some cultic importance, particularly at Athens and Eleusis in connection with the Eleusinian mysteries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iamblichus</ns0:orth>
        <ns0:pron>/aɪˈæmblɪkəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jámblico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Iamblichus (c. 245 – c. 325), a Syrian Neoplatonist philosopher.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ian</ns0:orth>
        <ns0:pron>/ˈaɪ.ən/</ns0:pron>
        <ns0:pron>/ˈiː.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iván</ns0:quote>
          <ns0:quote>Juan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name, equivalent to English John.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iapetus</ns0:orth>
        <ns0:pron>/aɪˈæpɪtəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jápeto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) A Titan, the son of Uranus and Gaia, and father of Atlas, Prometheus, Epimetheus, and Menoetius.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) A moon in Saturnian system, Solar System: The third largest moon of Saturn</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberia</ns0:orth>
        <ns0:pron>/aɪˈbɪə̯.ɹi.ə/</ns0:pron>
        <ns0:pron>/aɪˈbɪə̯ɹ.i.ə/</ns0:pron>
        <ns0:pron>/aɪˈbɪɹ.i.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iberia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula and region of Europe south of the Pyrenees, consisting of Andorra, Spain, Portugal, and Gibraltar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iberia asiática</ns0:quote>
          <ns0:quote>Iberia caucásica</ns0:quote>
          <ns0:quote>Iberia del Este</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) An antique and Byzantine name for the geographic region and ancient Georgian kingdom of Kartli in Eastern Europe, located east of Colchis, corresponding roughly to the eastern parts of present-day Georgia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ibérico</ns0:quote>
          <ns0:quote>ibero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Native to Iberia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ibero</ns0:quote>
          <ns0:quote>íbero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A native of modern-day Iberia (the European peninsula): a person native to Spain, Portugal, Andorra, or Gibraltar,.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ibero</ns0:quote>
          <ns0:quote>ibérico</ns0:quote>
          <ns0:quote>íbero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct language isolate that was spoken in the Iberian peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian Peninsula</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>península ibérica</ns0:quote>
          <ns0:quote>península hespérica</ns0:quote>
          <ns0:quote>península hispánica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula located in the extreme southwest of Europe which includes modern day Spain, Portugal, Andorra and Gibraltar, bordered on the south and east by the Mediterranean Sea, and on the north and west by the Atlantic Ocean, with the Pyrenees forming the northeast edge of the peninsula, connecting it to the rest of Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian lynx</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lince ibérico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An endangered species of lynx, Lynx pardinus, native to the Iberian peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian magpie</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mohíno</ns0:quote>
          <ns0:quote>rabilargo</ns0:quote>
          <ns0:quote>rabúo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bird in the family Corvidae, Cyanopica cooki, that's endemic to the Iberian Peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Iberian wolf</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lobo ibérico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Canis lupus signatus; A subspecies of the grey wolf, living in the Iberian Peninsula, which includes Portugal and Spain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
