      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beso francés</ns0:quote>
          <ns0:quote>beso con lengua</ns0:quote>
          <ns0:quote>morreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or an instance of kissing that involves the use of one's tongue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French kiss</ns0:orth>
        <ns0:pron>/frɛntʃˈkɪs/</ns0:pron>
        <ns0:pron>/frɛnʃˈkɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>morrear</ns0:quote>
          <ns0:quote>agarrar</ns0:quote>
          <ns0:quote>tranzar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To give a French kiss, in its various senses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French leave</ns0:orth>
        <ns0:pron>/fɹɛnt͡ʃ ˈliv/</ns0:pron>
        <ns0:pron>/fɹɛnt͡ʃ ˈliːv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>despedida a la francesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A departure taken quietly and unnoticed, without asking for permission or informing anyone. [from mid 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French onion soup</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sopa de cebolla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A soup made with onions and beef broth or beef stock, traditionally served with croutons and cheese as toppings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French paradox</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>paradoja francesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The observation that the French suffer a relatively low incidence of coronary heart disease, despite having a diet relatively rich in saturated fats.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French toast</ns0:orth>
