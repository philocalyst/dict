      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archiducal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to an archduke or archduchess.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archduchess</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archiduquesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A daughter or granddaughter of the Emperor of Austria-Hungary, or the wife of a son or grandson of the Emperor of Austria-Hungary</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
