      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Segorbe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A municipality in the province of Castellón, Spain; famous for its semana de Toros – “bull-running week” – held every September.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Segovia</ns0:orth>
