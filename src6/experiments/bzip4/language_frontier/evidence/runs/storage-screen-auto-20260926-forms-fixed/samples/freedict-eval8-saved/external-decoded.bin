      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lea</ns0:quote>
          <ns0:quote>Lía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) The elder daughter of Laban, sister to Rachel, and first wife of Jacob.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Leander</ns0:orth>
        <ns0:pron>/liːˈændə/</ns0:pron>
        <ns0:pron>/liːˈændɚ/</ns0:pron>
