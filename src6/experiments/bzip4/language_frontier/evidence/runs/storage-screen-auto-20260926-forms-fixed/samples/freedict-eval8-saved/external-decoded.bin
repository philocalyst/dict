        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neo-orleanesa</ns0:quote>
          <ns0:quote>neo-orleanés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to New Orleans, Louisiana, United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Orleans</ns0:orth>
        <ns0:pron>/n(j)uː ˈɔɹliːnz/</ns0:pron>
        <ns0:pron>/nuː ˈɔɹlənz/</ns0:pron>
        <ns0:pron>/ˈn(j)uː ɔɹˈliːnz/</ns0:pron>
        <ns0:pron>/ˈnɔɹlənz/</ns0:pron>
        <ns0:pron>/ˈnɔːlənz/</ns0:pron>
        <ns0:pron>/ˌnuː ˈɔɹ.li.ənz/</ns0:pron>
        <ns0:pron>/ˌnuː ˈɔɹ.lɛ.ənz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva Orleans</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest city in Louisiana, United States and the parish seat of Orleans Parish, which is coterminous with the city.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Rome</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva Roma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Synonym of Constantinople (“Byzantium”) (Istanbul)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New South Wales</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva Gales del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of Australia, located in the southeastern part of the continent; a former British colony from 1788 to 1901. Capital: Sydney.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Spain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva España</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former viceroyalty (a type of colony) in North America and Central America that existed from 1521 to 1821. It comprised of Spain's territorial possessions in the New World including the southwestern United States, Mexico, Central America, and the Philippines, established following the Spanish conquest of the Aztec Empire in 1521.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Testament</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nuevo Testamento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(bible, Christianity) The second half of the Christian Bible, which includes the four Gospels, the Book of Acts, the Epistles, and the Book of Revelation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New World</ns0:orth>
        <ns0:pron>/n(j)u wɝld/</ns0:pron>
        <ns0:pron>/njuː wɜːld/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nuevo Mundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or characteristic of the New World.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Year</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>año nuevo</ns0:quote>
          <ns0:quote>Año Nuevo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In particular, January 1 in the Julian and Gregorian calendar (New Year’s Day) and the days following.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Year's Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Año Nuevo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A holiday celebrating the first day of the New Year, celebrated on January 1 in cultures following the Gregorian calendar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Year's Eve</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nochevieja</ns0:quote>
          <ns0:quote>víspera de año nuevo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The holiday occurring on the last day of the year, celebrated on December 31st in cultures following the Gregorian calendar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Year's resolution</ns0:orth>
        <ns0:pron>/ˈn(j)u jɪɹz ˌɹɛzəˈl(j)uʃ(ə)n/</ns0:pron>
        <ns0:pron>/ˈnjuː jɪəz ˌɹɛzəˈluːʃ(ə)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>propósito de Año Nuevo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A vow that one makes on New Year's Eve or New Year's Day for the coming year.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New York</ns0:orth>
        <ns0:pron>/nju ˈjɔɹk/</ns0:pron>
        <ns0:pron>/njuː ˈjɔːk/</ns0:pron>
        <ns0:pron>/nu ˈjɔək/</ns0:pron>
        <ns0:pron>/nu ˈjɔɹk/</ns0:pron>
        <ns0:pron>[nɪ ˈjɔək]</ns0:pron>
        <ns0:pron>[ɲɔək]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva York</ns0:quote>
          <ns0:quote>estado de Nueva York</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest city in the state of New York, and the largest city in the United States, a metropolis extending into neighboring New Jersey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New York City</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva York</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The largest city in the United States, situated in the state of New York at the mouth of the Hudson River on the northeastern Atlantic Coast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New York State</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva York</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Yorker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neoyorkino</ns0:quote>
          <ns0:quote>neoyorquino</ns0:quote>
          <ns0:quote>neoyorkina</ns0:quote>
          <ns0:quote>neoyorquina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native or resident of the state of New York in the United States of America.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A native or resident of New York City.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Yorkian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neoyorquino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or characteristic of, New York.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Zealand</ns0:orth>
        <ns0:pron>/- ˈziː-/</ns0:pron>
        <ns0:pron>/nju ˈziː.lənd/</ns0:pron>
        <ns0:pron>/njʉː ˈzɪələnd/</ns0:pron>
        <ns0:pron>/nu ˈzi.lənd/</ns0:pron>
        <ns0:pron>/ˌnjuː -/</ns0:pron>
        <ns0:pron>/ˌnu -/</ns0:pron>
        <ns0:pron>[-ˈzeə-]</ns0:pron>
        <ns0:pron>[njʉ ˈzɪəɫənd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nueva Zelanda</ns0:quote>
          <ns0:quote>Nueva Zelandia</ns0:quote>
          <ns0:quote>neozelandés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country and archipelago of Oceania, to the east of Australia. Official name: New Zealand. Capital: Wellington.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neozelandés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Realm of New Zealand, including the Cook Islands, Niue, Tokelau and the Ross Dependency.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Zealand dollar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dólar neozelandés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The official currency of New Zealand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Zealand falcon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>halcón de Nueva Zelanda</ns0:quote>
          <ns0:quote>halcón maorí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A species of falcon endemic to New Zealand (Falco novaeseelandiae).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Zealander</ns0:orth>
        <ns0:pron>/ˌnjuː ˈziːləndə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neozelandesa</ns0:quote>
          <ns0:quote>neozelandés</ns0:quote>
          <ns0:quote>neocelandés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from New Zealand or of New Zealand descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Zealandic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neozelandés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare, nonstandard) Of, from, or pertaining to New Zealand</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>New Zealandress</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>neozelandesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare, mostly, obsolete) A female New Zealander.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newari</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nepal bhasa</ns0:quote>
          <ns0:quote>newar de Katmandú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Tibeto-Burman language spoken in Nepal, India and Bhutan by the Newa people, and the only Tibeto-Burman language written in Devanagari script.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newcastle disease</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfermedad de Newcastle</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A highly contagious disease of poultry, caused by the Newcastle disease virus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newfoundland</ns0:orth>
        <ns0:pron>/lænd/</ns0:pron>
        <ns0:pron>/lənd/</ns0:pron>
        <ns0:pron>/ˈn(j)u.fənd.lənd/</ns0:pron>
        <ns0:pron>/ˈnjuː.fənd.lənd/</ns0:pron>
        <ns0:pron>/ˈnjuːˌfaʊnd.lənd/</ns0:pron>
        <ns0:pron>/ˈnu.fənd.lənd/</ns0:pron>
        <ns0:pron>/ˈnuˌfaʊnd.lənd/</ns0:pron>
        <ns0:pron>/ˌn(j)u.fəndˈlænd/</ns0:pron>
        <ns0:pron>/ˌnjuːˈfaʊnd.lənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>terranova</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very large breed of working dog from Newfoundland, with a shaggy, usually black coat, known for its water rescue ability, strength, and gentle disposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newfoundland</ns0:orth>
        <ns0:pron>/lænd/</ns0:pron>
        <ns0:pron>/lənd/</ns0:pron>
        <ns0:pron>/ˈn(j)u.fənd.lənd/</ns0:pron>
        <ns0:pron>/ˈnjuː.fənd.lənd/</ns0:pron>
        <ns0:pron>/ˈnjuːˌfaʊnd.lənd/</ns0:pron>
        <ns0:pron>/ˈnu.fənd.lənd/</ns0:pron>
        <ns0:pron>/ˈnuˌfaʊnd.lənd/</ns0:pron>
        <ns0:pron>/ˌn(j)u.fəndˈlænd/</ns0:pron>
        <ns0:pron>/ˌnjuːˈfaʊnd.lənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Terranova</ns0:quote>
          <ns0:quote>Tierra Nueva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large island off the coast of eastern Canada, which, along with Labrador, has composed the Canadian province of Newfoundland and Labrador since 1949, and the Dominion of Newfoundland, before it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newfoundland and Labrador</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Terranova y Labrador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province in eastern Canada; abbreviation Nfld., Nfld, NL, N.L., N. L., or NF; formerly, Newfoundland (1949–2001). Capital: St. John's.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newfoundlander</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
