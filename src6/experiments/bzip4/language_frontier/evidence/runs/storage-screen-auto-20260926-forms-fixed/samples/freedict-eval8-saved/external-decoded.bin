        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abulia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychiatry) Absence of willpower or decisiveness, especially as a symptom of mental illness. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
