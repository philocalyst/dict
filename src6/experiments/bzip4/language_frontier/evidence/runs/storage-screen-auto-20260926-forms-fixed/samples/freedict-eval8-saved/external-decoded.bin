        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Petrarch</ns0:orth>
        <ns0:pron>/ˈpitɹɑɹk/</ns0:pron>
        <ns0:pron>/ˈpɛtɹɑɹk/</ns0:pron>
        <ns0:pron>/ˈpɛtɹɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Petrarca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Francesco Petrarca (1304–1374), Italian scholar and poet.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Petrarchan</ns0:orth>
        <ns0:pron>/piˈtɹɑɹkən/</ns0:pron>
        <ns0:pron>/pɛˈtɹɑɹkən/</ns0:pron>
        <ns0:pron>/pɪˈtɹɑːkən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>petrarquesco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Francesco Petrarch, a renowned Renaissance Italian humanist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Petrarchan sonnet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soneto italiano</ns0:quote>
          <ns0:quote>soneto petrarquiano</ns0:quote>
          <ns0:quote>soneto petrarquista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(poetry) A sonnet comprising an octave and a closing sestet, following the rhyme scheme of either abba abba cde cde or abba abba cd cd cd or abba abba cce dde or abba abba cdd cee.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Petrarchism</ns0:orth>
