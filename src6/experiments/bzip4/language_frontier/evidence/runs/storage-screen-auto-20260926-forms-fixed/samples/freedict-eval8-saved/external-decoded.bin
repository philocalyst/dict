          <ns0:quote>playa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A horizontal strip of land, usually sandy, adjoining water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beach</ns0:orth>
        <ns0:pron>/bit͡ʃ/</ns0:pron>
        <ns0:pron>/biːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embarrancar</ns0:quote>
          <ns0:quote>encallar</ns0:quote>
          <ns0:quote>varar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To run (something) aground on a beach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beach chair</ns0:orth>
      </ns0:form>
