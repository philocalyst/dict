        <ns0:pron>/ˈpɛntəˌkɔst/</ns0:pron>
        <ns0:pron>/ˈpɛntɪkɒst/</ns0:pron>
        <ns0:pron>[-ɾə-]</ns0:pron>
      </ns0:form>
