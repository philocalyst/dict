      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autobiográfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to a person's life or an account of a person's life, as told by the subject.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autobiography</ns0:orth>
        <ns0:pron>/ˌɔː.tə.baɪˈɒɡ.ɹə.fi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>autobiografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A self-written biography; the story of one's own life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>autoblock</ns0:orth>
      </ns0:form>
