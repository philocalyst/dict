    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pannonia</ns0:orth>
        <ns0:pron>/pəˈnoʊ.ni.ə/</ns0:pron>
        <ns0:pron>/pəˈnəʊ.ni.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Panonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A geographic region and former province of the Roman Empire in central-eastern Europe, existing as a single province from c. 9 AD to 107 AD and as multiple related provinces until 433 AD; located in modern western Hungary, western Slovakia, eastern Austria, northern Croatia, northwestern Serbia, northern Slovenia and northern Bosnia and Herzegovina.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
