      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estatua de la Libertad</ns0:quote>
          <ns0:quote>Estatua Libertadense</ns0:quote>
          <ns0:quote>Estatua Liberteña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very large statue in New York harbor, representing the Roman goddess Libertas, and considered emblematic of the United States and its attractiveness to immigrants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
