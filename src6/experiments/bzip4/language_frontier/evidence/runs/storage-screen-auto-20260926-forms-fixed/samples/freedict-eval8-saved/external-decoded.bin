        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Imperio de Corea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The Korean state from 1897 to 1910.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korean Peninsula</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Península Koreana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula in East Asia, containing the countries of North Korea and South Korea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korean War</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Guerra de Corea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A war fought in the Korean Peninsula from 1950–1953 between the Soviet Union-backed Democratic People's Republic of Korea and the United Nations-backed Republic of Korea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
