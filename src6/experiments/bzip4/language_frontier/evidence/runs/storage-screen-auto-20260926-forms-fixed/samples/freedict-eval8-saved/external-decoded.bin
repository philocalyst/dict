          <ns0:quote>Piscis Austrinus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) An autumn constellation of the northern sky, said to resemble a fish. It contains the star Fomalhaut.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
