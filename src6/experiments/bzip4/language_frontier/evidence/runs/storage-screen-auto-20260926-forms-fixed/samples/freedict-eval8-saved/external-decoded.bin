    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Guy Fawkes Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Noche de Guy Fawkes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UK) November 5, a celebration in England since the 17th century commemorating the failure of the 1605 Gunpowder Plot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Guy Fawkes Night</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Noche de Guy Fawkes</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(British) The revelry on Guy Fawkes Day (the 5th of November) in commemoration of the failure of the Gunpowder Plot of 1605, traditionally including the burning of effigies of the pope, Guy Fawkes, and/or the Devil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
