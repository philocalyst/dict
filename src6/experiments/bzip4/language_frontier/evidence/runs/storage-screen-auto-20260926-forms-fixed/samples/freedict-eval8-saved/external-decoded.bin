          <ns0:quote>servio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The standardized variety of Serbo-Croatian, a South Slavic language, spoken by Serbs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>serbio</ns0:quote>
          <ns0:quote>serbia</ns0:quote>
          <ns0:quote>servio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
