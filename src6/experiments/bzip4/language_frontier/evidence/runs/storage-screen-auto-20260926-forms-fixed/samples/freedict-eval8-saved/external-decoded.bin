      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pliensbachiense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, paleontology) A subdivision of the Jurassic period.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pliny</ns0:orth>
        <ns0:pron>/ˈplɪni/</ns0:pron>
      </ns0:form>
