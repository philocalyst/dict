      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Procopio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Procrustes</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Procusto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) A celebrated legendary highwayman of Attica, who tied his victims upon an iron bed, and, as the case required, either stretched or cut off their legs to adapt them to its length.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Procyon</ns0:orth>
        <ns0:pron>/ˈpɹoʊsiˌɑn/</ns0:pron>
        <ns0:pron>/ˈpɹəʊsiˌɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Procyon</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(star) A star in the constellation Canis Minor; Alpha (α) Canis Minoris. The eighth brightest star in the night sky.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Produnova</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>produnova</ns0:quote>
          <ns0:quote>salto Produnova</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(gymnastics) a vault on the vaulting horse or vaulting table that starts with a front handspring off the gymnastics horse leading to two-and-a-half somersaults in the air, and then landing on their feet. (a three-point landing with the butt and feet is considered a fall)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Produnova</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Produnova</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transliteration of the Russian surname Продунова (Produnova).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Promethean</ns0:orth>
        <ns0:pron>/pɹoʊ-/</ns0:pron>
        <ns0:pron>/pɹəˈmi.θi.ən/</ns0:pron>
        <ns0:pron>/pɹəˈmiː.θɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prometeico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to Prometheus, a demigod in Greek mythology who created mortals from clay and stole fire from Zeus to give to them, for which Zeus punished him by chaining him to a rock and having an eagle feed on his liver which grew back each night; he was later rescued by Heracles.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(rare) Of or pertaining to the promethea silkmoth (Callosamia promethea).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Prometheus</ns0:orth>
        <ns0:pron>/pɹoʊˈmiθi.əs/</ns0:pron>
        <ns0:pron>/pɹəˈmiːθi.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Prometeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The Titan chiefly honored for stealing fire from Zeus in the stalk of a fennel plant and giving it to mortals for their use. The god of fire and craft.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Promised Land</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tierra de promisión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, sometimes, lower case) Any place to which one eagerly seeks to go and which one expects to greatly improve one's situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Promised Land</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tierra Prometida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Judaism, Christianity) The area historically known as Judea, which was promised to the Israelites by God according to oral tradition recorded in the Book of Genesis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Protagoras</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Protágoras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pre-Socratic Greek philosopher, who famously said "man is the measure of all things".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proterozoic</ns0:orth>
        <ns0:pron>/ˌpɹoʊt(ə)ɹoʊˈzoʊɪk/</ns0:pron>
        <ns0:pron>/ˌpɹoʊt(ə)ɹrəˈzoʊɪk/</ns0:pron>
        <ns0:pron>/ˌpɹɒt(ə)ɹəʊˈzəʊɪk/</ns0:pron>
        <ns0:pron>/ˌpɹɒt(ə)ɹəˈzəʊɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Proterozoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) Of or relating to the geologic eon from 2,500 Ma to 541.0±1.0 Ma.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proterozoic</ns0:orth>
        <ns0:pron>/ˌpɹoʊt(ə)ɹoʊˈzoʊɪk/</ns0:pron>
        <ns0:pron>/ˌpɹoʊt(ə)ɹrəˈzoʊɪk/</ns0:pron>
        <ns0:pron>/ˌpɹɒt(ə)ɹəʊˈzəʊɪk/</ns0:pron>
        <ns0:pron>/ˌpɹɒt(ə)ɹəˈzəʊɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Proterozoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) The eon from 2,500 Ma to 541.0±1.0 Ma, the beginning of the Phanerozoic, marked by the build up of oxygen in the atmosphere and the emergence of primitive multicellular life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Protestant</ns0:orth>
        <ns0:pron>/ˈpɹɑtɪstənt/</ns0:pron>
        <ns0:pron>/ˈpɹɒtɪstənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protestante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) Of or pertaining to several denominations of Christianity that separated from the Roman Catholic Church based on theological or political differences during the Reformation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Protestant</ns0:orth>
        <ns0:pron>/ˈpɹɑtɪstənt/</ns0:pron>
        <ns0:pron>/ˈpɹɒtɪstənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protestante</ns0:quote>
          <ns0:quote>salvacuatro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A member of any of several Christian denominations which separated from the Roman Catholic Church based on theological or political differences during the Reformation (or in some cases later).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Protestantism</ns0:orth>
        <ns0:pron>/ˈpɹɑ.tɪs.tən.tɪ.zm̩/</ns0:pron>
        <ns0:pron>/ˈpɹɑ.tɪs.tən.tɪ.zəm/</ns0:pron>
        <ns0:pron>/ˈpɹɒt.ɪs.tən.tɪ.zəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protestantismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Protestant (rather than the Roman Catholic or Orthodox) Christian faith.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proteus</ns0:orth>
        <ns0:pron>/ˈpɹoʊti.əs/</ns0:pron>
        <ns0:pron>/ˈpɹəʊtjuːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Proteo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) A sea god who could change his shape at will.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) The sixth satellite of the planet Neptune.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Altaic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Proto-altaico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The hypothetical prehistoric ancestor of all Altaic languages, the existence of which is now often rejected.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Germanic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protogermánico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hypothetical prehistoric ancestor language of all Germanic languages, including English.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Indo-European</ns0:orth>
        <ns0:pron>/-ˌjɔːɹəˈ-/</ns0:pron>
        <ns0:pron>/ˌpɹoʊ̯toʊ̯ˌɪndoʊ̯ˌjʊɹəˈpi.ən/</ns0:pron>
        <ns0:pron>/ˌpɹəʊ̯təʊ̯ˌɪndə(ʊ̯)ˌjʊə̯ɹəˈpiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoindoeuropeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics, anthropology) Of or pertaining to the Proto-Indo-European language, or the people who spoke it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Indo-European</ns0:orth>
        <ns0:pron>/-ˌjɔːɹəˈ-/</ns0:pron>
        <ns0:pron>/ˌpɹoʊ̯toʊ̯ˌɪndoʊ̯ˌjʊɹəˈpi.ən/</ns0:pron>
        <ns0:pron>/ˌpɹəʊ̯təʊ̯ˌɪndə(ʊ̯)ˌjʊə̯ɹəˈpiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoindoeuropeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anthropology, countable) A person who spoke the Proto-Indo-European language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Indo-European</ns0:orth>
        <ns0:pron>/-ˌjɔːɹəˈ-/</ns0:pron>
        <ns0:pron>/ˌpɹoʊ̯toʊ̯ˌɪndoʊ̯ˌjʊɹəˈpi.ən/</ns0:pron>
        <ns0:pron>/ˌpɹəʊ̯təʊ̯ˌɪndə(ʊ̯)ˌjʊə̯ɹəˈpiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoindoeuropeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics, uncountable) The reconstructed ancestor language or protolanguage of the Indo-European family of languages, which includes most European, Iranian, and Indian languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Italic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoitálico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hypothetical prehistoric Indo-European language, ancestor of all Italic languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Japonic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Protojapónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) The hypothetical ancestral language of both modern Japanese and the Ryukyuan languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Kartvelian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>idioma común kartveliano</ns0:quote>
          <ns0:quote>idioma protokartveliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The reconstructed ancestor of the Kartvelian languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Slavic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoeslavo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) A hypothetical, reconstructed language whence all the Slavic languages later descended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proto-Vietic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protoviético</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proustian</ns0:orth>
        <ns0:pron>/ˈpɹusti.ən/</ns0:pron>
        <ns0:pron>/ˈpɹuːstɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>proustiano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or reminiscent of Marcel Proust (1871–1922), French novelist, or his works.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Provence</ns0:orth>
        <ns0:pron>/pɹəˈvɒns/</ns0:pron>
        <ns0:pron>/pɹəˈvɒ̃s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Provenza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A maritime geographic region and former province of southeastern France bordering Italy; since 2016 included in the administrative region of Provence-Alpes-Côte d'Azur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Provençal</ns0:orth>
        <ns0:pron>/ˌpɹɒvɑːnˈsɑːl/</ns0:pron>
        <ns0:pron>/ˌpɹɒvɒnˈsɑːl/</ns0:pron>
        <ns0:pron>/ˌpɹɒvənˈsɑːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>provenzal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from or relating to Provence, a traditional geographic region roughly corresponding to the modern administrative region of Provence-Alpes-Côte d'Azur, France.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Provençal</ns0:orth>
        <ns0:pron>/ˌpɹɒvɑːnˈsɑːl/</ns0:pron>
        <ns0:pron>/ˌpɹɒvɒnˈsɑːl/</ns0:pron>
        <ns0:pron>/ˌpɹɒvənˈsɑːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>provenzal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(strictly) The Romance Occitan dialect of Provence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proverbs</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Proverbios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A book of the Old Testament of Bible, and of the Tanakh, being a collection of moral maxims.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Providence</ns0:orth>
        <ns0:pron>/ˈpɹɑvɪdəns/</ns0:pron>
        <ns0:pron>/ˈpɹɒvɪdəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Providence</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Providence County, Rhode Island, the state capital and largest city.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Proxima Centauri</ns0:orth>
        <ns0:pron>/ˈpɹɑk.sɪ.mə sɛnˈtaʊ.ɹi/</ns0:pron>
        <ns0:pron>/ˈpɹɑk.sɪ.mə sɛnˈtɔ.ɹi/</ns0:pron>
        <ns0:pron>/ˈpɹɒk.sɪ.mə sɛnˈtaʊə.ɹi/</ns0:pron>
        <ns0:pron>/ˈpɹɒk.sɪ.mə sɛnˈtɔː.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Próxima Centauro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(star) A red dwarf star, part of the Alpha Centauri system and the nearest star to Earth's solar system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Prudhomme</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Perdomo</ns0:quote>
          <ns0:quote>Prudhomme</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Prussia</ns0:orth>
        <ns0:pron>/ˈpɹʊ.ʃɐ/</ns0:pron>
        <ns0:pron>/ˈpɹʌ.ʃə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Prusia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, historical) A geographical area on the Baltic coast of Northeast Europe.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical) A former duchy, kingdom and (after German unification in 1871) a province of Germany, existing in various forms from 1525 to 1947 in parts of modern Germany, Poland and Russia; it originated from the historical region of Prussia and expanded over time through conquest.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A country known for exceptional military professionalism in her region. Historically used for Bulgaria as the "Prussia of the Balkans".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
