      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isla San Pedro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island in the southern Atlantic Ocean, part of the South Georgia and the South Sandwich Islands, United Kingdom, a British-owned territory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Holland</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Holanda Meridional</ns0:quote>
          <ns0:quote>Holanda del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province of the Netherlands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Island</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isla Sur</ns0:quote>
          <ns0:quote>isla Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island, the southern of the two major islands making up New Zealand.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Korea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Corea del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in East Asia, comprising the southern part of the Korean Peninsula. Official name: Republic of Korea. Capital: Seoul.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Korean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>surcoreano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to South Korea or the South Korean people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Korean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>surcoreano</ns0:quote>
          <ns0:quote>surcoreana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A citizen or resident of South Korea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Levantine Arabic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Árabe levantino del sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of Eastern Arabic dialects spoken primarily in Palestine, Jordan and Israel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Ossetia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Osetia del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A disputed geographic region and de-facto independent but largely unrecognized country in the South Caucasus on the border of Europe and Asia, which considers itself an independent state called the Republic of South Ossetia; considered part of Georgia's territory by the Georgian government and the vast majority of the international community. Capital: Tskhinvali.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Pacific</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pacífico Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The southern part of the Pacific Ocean, from the equator to the Antarctic Ocean</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Pole</ns0:orth>
        <ns0:pron>/ˌsaʊθ ˈpoʊl/</ns0:pron>
        <ns0:pron>/ˌsaʊθ ˈpəʊl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>polo Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) The Geographic South Pole or Terrestrial South Pole; the point which south is oriented towards, and therefore the southernmost point on Earth (having a latitude of -90°).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Sea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar del sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A southern region of the Pacific Ocean that surrounds the archipelagoes of Polynesia and Melanesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Sudan</ns0:orth>
        <ns0:pron>/ˌsaʊθ suˈdæn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sudán del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in East Africa. Official name: Republic of South Sudan, formerly the southern part of Sudan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Sudanese</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sursudanés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to the country of South Sudan or the South Sudanese people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Sudanese</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sursudanés</ns0:quote>
          <ns0:quote>sursudanesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from South Sudan or of South Sudanese descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Tyrol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alto Adigio</ns0:quote>
          <ns0:quote>Tirol del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A predominantly German-speaking autonomous province of the Trentino-Alto Adige region in north-east Italy; until 1919 part of Austria, since 1972 under a special autonomy statute. Capital: Bolzano.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Vietnam</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Vietnam del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former country in Southeast Asia that governed southern Vietnam from 1955 to 1975. Official name: Republic of Vietnam.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South West Africa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>África del Sudoeste</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former German colony (before World War I) and later a South African colony (from 1915 to 1990, illegally occupied after 1966 per United Nations stipulations) in Southern Africa; modern Namibia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>South Yemen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Yemen del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former country in West Asia on the Arabian Peninsula, existing from 1967 until 1990. Official name: People's Democratic Republic of Yemen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southeast Asia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sureste Asiático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region of Asia, comprising the territories of Brunei, Cambodia, East Timor, Indonesia, Laos, Malaysia, Myanmar (Burma), the Philippines, Singapore, Thailand, and Vietnam.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Africa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>África austral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region comprising the southern part of Africa; always including South Africa, Namibia, Botswana, Lesotho and Eswatini, and sometimes also Angola, Mozambique, Zambia and Zimbabwe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Bug</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Bug Meridional</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Cone</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cono Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The southern portion of South America, consisting of Argentina, Chile and Uruguay, sometimes southern Brazil, São Paulo state and Paraguay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Cross</ns0:orth>
        <ns0:pron>/ˌsʌðə(ɹ)n ˈkɹɒs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cruz del Sur</ns0:quote>
          <ns0:quote>Crux</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rural locality in Charters Towers Region, northern Queensland.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A town in the Shire of Yilgarn, Western Australia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Europe</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Europa meridional</ns0:quote>
          <ns0:quote>Europa del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sociopolitical region of Europe including such countries as Spain, Portugal, Italy, and Greece.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Hemisphere</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hemisferio sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The hemisphere in Earth to the south of the Equator, containing only about 10% of the total land area on Earth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Min</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>min nan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of local languages of Min Chinese, which can trace their origins to southern Fujian province, China.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Ndebele</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>idioma ndebele del sur</ns0:quote>
          <ns0:quote>ndebele meridional</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Ocean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>océano Antártico</ns0:quote>
          <ns0:quote>océano Austral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The portion of the World Ocean surrounding Antarctica, variously taken as the waters south of the Antarctic Circle, the waters south of 60° S, or the waters bounded by the Antarctic Convergence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern Rhodesia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Rodesia del Sur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former colony of the United Kingdom; a name used to refer to the area now called Zimbabwe, officially introduced in 1901. A self-governing colony of Britain from 1923, its government began to refer to itself simply as Rhodesia in 1964, when Northern Rhodesia became Zambia. The name Zimbabwe was adopted in 1980.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southern belle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>belleza sureña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A beautiful, archetypal (especially upper class) white woman of the Southern United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southerner</ns0:orth>
        <ns0:pron>/ˈsʌðɛnəɹ/</ns0:pron>
        <ns0:pron>/ˈsʌðᵊnə/</ns0:pron>
        <ns0:pron>/ˈsʌðᵊnəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sureña</ns0:quote>
          <ns0:quote>sureño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A resident of the American South, often specifically a white resident of the American South.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Southwest Asia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
