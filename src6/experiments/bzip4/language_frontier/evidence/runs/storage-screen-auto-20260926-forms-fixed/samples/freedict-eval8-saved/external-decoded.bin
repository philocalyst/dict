          <ns0:quote>alborada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music, poetry) A poem or song evoking or greeting the dawn or early morning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alborada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music, specifically) A morning love song, or a song of lovers parting in the morning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
