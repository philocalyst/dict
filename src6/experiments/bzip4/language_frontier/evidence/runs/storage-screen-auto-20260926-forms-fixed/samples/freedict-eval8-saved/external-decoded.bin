        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amonal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An explosive made up of ammonium nitrate, trinitrotoluene, and aluminium powder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ammonia</ns0:orth>
