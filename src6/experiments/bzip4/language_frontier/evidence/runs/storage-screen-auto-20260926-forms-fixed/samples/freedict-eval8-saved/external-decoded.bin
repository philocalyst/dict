        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altered</ns0:orth>
        <ns0:pron>/ˈɑl.tɚd/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚd/</ns0:pron>
        <ns0:pron>/ˈɔːl.təd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alterado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having been changed from an original form.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alterity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alteridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy, anthropology) Otherness; the entity in contrast to which an identity is constructed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternate</ns0:orth>
        <ns0:pron>/ɒlˈtɜː(ɹ).nət/</ns0:pron>
        <ns0:pron>/ɔlʈə(r).neʈ/</ns0:pron>
        <ns0:pron>/ɔːlˈtɜː(ɹ).nət/</ns0:pron>
        <ns0:pron>/ˈɑl.tɚ.neɪt/</ns0:pron>
        <ns0:pron>/ˈɑl.tɚ.nət/</ns0:pron>
        <ns0:pron>/ˈɒl.tə(ɹ)ˌneɪt/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.neɪt/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.nət/</ns0:pron>
        <ns0:pron>/ˈɔːl.tə(ɹ)ˌneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alterno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Happening by turns; one following the other in succession of time or place; first one and then the other (repeatedly).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) Designating the members in a series, which regularly intervene between the members of another series, as the odd or even numbers of the numerals; every other; every second.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternate</ns0:orth>
        <ns0:pron>/ɒlˈtɜː(ɹ).nət/</ns0:pron>
        <ns0:pron>/ɔlʈə(r).neʈ/</ns0:pron>
        <ns0:pron>/ɔːlˈtɜː(ɹ).nət/</ns0:pron>
        <ns0:pron>/ˈɑl.tɚ.neɪt/</ns0:pron>
        <ns0:pron>/ˈɑl.tɚ.nət/</ns0:pron>
        <ns0:pron>/ˈɒl.tə(ɹ)ˌneɪt/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.neɪt/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.nət/</ns0:pron>
        <ns0:pron>/ˈɔːl.tə(ɹ)ˌneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sustituta</ns0:quote>
          <ns0:quote>sustituto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A substitute; an alternative; one designated to take the place of another, if necessary, in performing some duty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternate</ns0:orth>
        <ns0:pron>/ɒlˈtɜː(ɹ).nət/</ns0:pron>
        <ns0:pron>/ɔlʈə(r).neʈ/</ns0:pron>
        <ns0:pron>/ɔːlˈtɜː(ɹ).nət/</ns0:pron>
        <ns0:pron>/ˈɑl.tɚ.neɪt/</ns0:pron>
        <ns0:pron>/ˈɑl.tɚ.nət/</ns0:pron>
        <ns0:pron>/ˈɒl.tə(ɹ)ˌneɪt/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.neɪt/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.nət/</ns0:pron>
        <ns0:pron>/ˈɔːl.tə(ɹ)ˌneɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To perform by turns, or in succession; to cause to succeed by turns; to interchange regularly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternately</ns0:orth>
        <ns0:pron>/ɔlˈtə(ɹ)nətliː/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚ.nət.li/</ns0:pron>
        <ns0:pron>[ɔːlˈtɜɹnətlɪ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternativamente</ns0:quote>
          <ns0:quote>por turno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In reciprocal succession; succeeding by turns; in alternate order.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternating</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alterno</ns0:quote>
          <ns0:quote>alternante</ns0:quote>
          <ns0:quote>alternativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That alternates.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics, of a series) Having terms that alternate between positive and negative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternating current</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corriente alterna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) An electric current in which the direction of flow of the electrons reverses periodically.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternating series</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>serie alternante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) An infinite series in the form of \sum_{n=0}^\infty (-1)^n a_n or \sum_{n=0}^\infty (-1)^{n+1} a_n, where a_n &gt; 0 for all n.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternating series test</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>criterio de Leibniz</ns0:quote>
          <ns0:quote>criterio de la serie alternante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(math) A test for determining whether an [[alternating series#Noun|alternating series</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternation</ns0:orth>
        <ns0:pron>/ˈɑl.tɚˌneɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˈɒl.tə(ɹ)ˌneɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˈɔl.tɚˌneɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternancia</ns0:quote>
          <ns0:quote>rotación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The reciprocal succession of (normally two) things in time or place; the act of following and being followed by turns; alternate succession, performance, or occurrence</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternation of generations</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternancia de generaciones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) Synonym of metagenesis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative</ns0:orth>
        <ns0:pron>/ɑlˈtɝ.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɒlˈtøː.nə.təv/</ns0:pron>
        <ns0:pron>/ɒlˈtɜː.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɔlˈtɜː.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɔlˈtɝ.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɔːlˈtɜː.nə.tɪv/</ns0:pron>
        <ns0:pron>/əlʈə(r)ˈneʈɪv/</ns0:pron>
        <ns0:pron>/ˈɔlʈə(r) ˈneʈɪv/</ns0:pron>
        <ns0:pron>[ɔ̟lˈtøː.nə.təv]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternativo</ns0:quote>
          <ns0:quote>alternativa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to a choice between two or more possibilities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Other; different from something else.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Not traditional, outside the mainstream, underground.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative</ns0:orth>
        <ns0:pron>/ɑlˈtɝ.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɒlˈtøː.nə.təv/</ns0:pron>
        <ns0:pron>/ɒlˈtɜː.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɔlˈtɜː.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɔlˈtɝ.nə.tɪv/</ns0:pron>
        <ns0:pron>/ɔːlˈtɜː.nə.tɪv/</ns0:pron>
        <ns0:pron>/əlʈə(r)ˈneʈɪv/</ns0:pron>
        <ns0:pron>/ˈɔlʈə(r) ˈneʈɪv/</ns0:pron>
        <ns0:pron>[ɔ̟lˈtøː.nə.təv]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternativa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A situation which allows a mutually exclusive choice between two or more possibilities; a choice between two or more possibilities. [from 17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>One of several mutually exclusive things which can be chosen. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative dispute resolution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternativa de resolución de conflictos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The resolution of a dispute through negotiation, mediation, arbitration, or similar means, as opposed to litigation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative fact</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>verdad alterna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, media) Something presented as a fact for reasons of political expediency; a fiction, a falsehood, a lie. [since the late 2010s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative fuel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>combustible alternativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any fuel that is not diesel or petrol (petroleum-based).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative investment fund</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondo de inversión alternativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) collective investment scheme investing in all asset classes and a wide range of financial instruments</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternative medicine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>medicina alternativa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various pseudoscientific medical methods and practices used in place of, or as well as, conventional (scientific) medicine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternatively</ns0:orth>
        <ns0:pron>/ɑlˈtɝ.nə.tɪv.li/</ns0:pron>
        <ns0:pron>/ɒlˈtɜː(ɹ).nə.tɪv.li/</ns0:pron>
        <ns0:pron>/ɔlˈtɝ.nə.tɪv.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en lugar de</ns0:quote>
          <ns0:quote>si no</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>in an alternative way</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alternator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alternador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(electrical engineering) An electric generator which produces alternating current through mechanical means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>althorn</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trombón alto</ns0:quote>
          <ns0:quote>trompa alto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(musical instruments) An alto or tenor saxhorn</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>although</ns0:orth>
        <ns0:pron>/ɑlˈðoʊ/&lt;a:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ɔlˈðoʊ/</ns0:pron>
        <ns0:pron>/ɔːlˈðəʊ/</ns0:pron>
        <ns0:pron>;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aunque</ns0:quote>
          <ns0:quote>si bien</ns0:quote>
          <ns0:quote>a pesar de</ns0:quote>
          <ns0:quote>aun cuando</ns0:quote>
          <ns0:quote>bien que</ns0:quote>
          <ns0:quote>maguer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Though, even though, in spite of or despite the fact that: introducing a clause that expresses a concession.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aunque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>But, except.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altimeter</ns0:orth>
        <ns0:pron>/ælˈtɪm.ɪ.tɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altímetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An apparatus for measuring altitude.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altimetric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altimétrico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altitude</ns0:orth>
        <ns0:pron>/ˈælt.ɪˌtjuːd/</ns0:pron>
        <ns0:pron>/ˈælt.ɪˌtuːd/</ns0:pron>
        <ns0:pron>/ˈælt.ɪˌt͡ʃuːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altitud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The absolute height of a location, usually measured from sea level.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) The angular distance of a heavenly body above our Earth's horizon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altura</ns0:quote>
          <ns0:quote>altitud</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The distance measured perpendicularly from a figure's vertex to the opposite side of the vertex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altitude sickness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mal de montaña</ns0:quote>
          <ns0:quote>puna</ns0:quote>
          <ns0:quote>soroche</ns0:quote>
          <ns0:quote>apunamiento</ns0:quote>
          <ns0:quote>apunarse</ns0:quote>
          <ns0:quote>asorocharse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A pathological condition caused by oxygen deficiency at high altitudes; symptoms include shortness of breath, nausea, and nosebleed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altitudinal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altitudinal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or in relation to altitude</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alto</ns0:orth>
        <ns0:pron>/ˈæl.toʊ/</ns0:pron>
        <ns0:pron>/ˈæl.təʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alto</ns0:quote>
          <ns0:quote>contralto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A musical part or section higher than tenor and lower than soprano, formerly the part that performed a countermelody above the tenor or main melody.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person or musical instrument that performs the alto part.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alto saxophone</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>saxofón alto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the saxophone family of woodwind instruments that is smaller than the tenor saxophone but larger than the soprano saxophone, with a range of D♭3 to A♭5 or similar.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altocumulus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altocúmulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, meteorology) A fleecy cloud formation consisting of large whitish or greyish globular cloudlets with shaded portions, often grouped in flocks or rows. (Abbreviated Ac.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altogether</ns0:orth>
        <ns0:pron>/ɑl.tuˈɡɛð.ɚ/</ns0:pron>
        <ns0:pron>/ɔl.tuˈɡɛð.ɚ/</ns0:pron>
        <ns0:pron>/ɔː.tuːˈɡɛð.ə(ɹ)/</ns0:pron>
        <ns0:pron>/ɔːl.təˈɡɛð.ə/</ns0:pron>
        <ns0:pron>/ɔːl.tʊˈɡɛð.ə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈɑl.təˌɡɛð.ɚ/</ns0:pron>
        <ns0:pron>/ˈɔl.təˌɡɛð.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>completamente</ns0:quote>
          <ns0:quote>por completo</ns0:quote>
          <ns0:quote>totalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Completely, wholly, or without exception.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en general</ns0:quote>
          <ns0:quote>en suma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>On the whole; with everything considered.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altostratus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altostrato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, meteorology) A principal medium-level cloud type in the form of a gray or bluish (never white) sheet or layer of striated, fibrous, or uniform appearance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altrose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altrosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carbohydrate) An aldohexose epimeric with mannose</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altruism</ns0:orth>
        <ns0:pron>/ˈæl.tɹu.ɪz.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altruismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Regard for others, both natural and moral without regard for oneself; devotion to the interests of others; brotherly kindness.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology, sociobiology) Action or behaviour that benefits another or others at some cost to the performer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altruist</ns0:orth>
        <ns0:pron>/ˈæltɹu.ɪst/</ns0:pron>
        <ns0:pron>/ˈɔːltɹu.ɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altruista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person showing altruism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>altruistic</ns0:orth>
        <ns0:pron>/ˌæl.tɹuˈɪs.tɪk/</ns0:pron>
        <ns0:pron>/ˌɑl.tɹuˈɪs.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>altruista</ns0:quote>
          <ns0:quote>altruístico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Regardful of others; beneficent; unselfish</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alum</ns0:orth>
        <ns0:pron>/ˈæl.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alumbre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An astringent salt, usually occurring in the form of pale crystals, much used in the dyeing and tanning trade and in certain medicines, and now understood to be a double sulphate of potassium and aluminium (K2SO4·Al2(SO4)3·24H2O). [from 14th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(inorganic compound) Any similar double sulphate in which either or both of the potassium and aluminium is wholly or partly replaced by other univalent or tervalent cations. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alum</ns0:orth>
        <ns0:pron>/ˈæl.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alumbrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To steep in, or otherwise impregnate with, a solution of alum; to treat with alum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alumina</ns0:orth>
        <ns0:pron>/əˈl(j)uːmɪnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alúmina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Aluminum oxide, especially when used in mining, material sciences or ceramics, a refractory solid compound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aluminita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hydrous aluminium sulfate mineral with formula Al2SO4(OH)4·7(H2O).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminium</ns0:orth>
        <ns0:pron>/əl(j)ʊˈmin(ɪ)jəm/</ns0:pron>
        <ns0:pron>/əˈl(j)umɪn(ɪ)jəm/</ns0:pron>
        <ns0:pron>/əˈluːmɪnəm/</ns0:pron>
        <ns0:pron>/ˌæl.(j)uˈmɪn.i.əm/</ns0:pron>
        <ns0:pron>/ˌæl.(j)uˈmɪn.jəm/</ns0:pron>
        <ns0:pron>/ˌæl.(j)ʊˈmɪn.i.əm/</ns0:pron>
        <ns0:pron>/ˌæl.(j)ʊˈmɪn.jəm/</ns0:pron>
        <ns0:pron>/ˌɛl.(j)ɘˈmɘn.jɘm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aluminio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A light, silvery metal extracted from bauxite, and a chemical element (symbol Al) with an atomic number of 13.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminium bromide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bromuro de aluminio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminium foil</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>papel aluminio</ns0:quote>
          <ns0:quote>papel plata</ns0:quote>
          <ns0:quote>papel albal</ns0:quote>
          <ns0:quote>papel metálico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Australia, Britain, New Zealand) A very thin, pliable, easily torn sheet of aluminium used for cooking, packaging, cosmetics, and insulation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminium oxide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>óxido de aluminio</ns0:quote>
          <ns0:quote>alúmina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) The solid, Al2O3, commonly known as alumina; it occurs as bauxite, sapphire, ruby and other forms; it is used in the manufacture of ceramics</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminosilicate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aluminosilicato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic chemistry) Any of many silicate minerals, such as feldspar and zeolite, in which a proportion of the Si4+ ions are replaced by Al3+, the excess negative charge being balanced by extra sodium, potassium or calcium ions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aluminous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aluminoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) of or pertaining to alumina or alum</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alumna</ns0:orth>
        <ns0:pron>/əˈlʌmnə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alumna</ns0:quote>
          <ns0:quote>estudiante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A female pupil or student (especially of a university or college).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antigua alumna</ns0:quote>
          <ns0:quote>ex alumna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A female graduate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alumnus</ns0:orth>
        <ns0:pron>/əˈlʌmnəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alumno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A male pupil or student.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>egresado</ns0:quote>
          <ns0:quote>exalumno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A male graduate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alunite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alunita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A gray whitish, water-soluble mineral, potassium aluminium sulphate; the natural source of alum, KAl3(SO4)2(OH)6.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alveolar</ns0:orth>
        <ns0:pron>/alˈviː.əl.ə/</ns0:pron>
        <ns0:pron>/ælˈvi.lɚ/</ns0:pron>
        <ns0:pron>/ælˈvi.əl.ɚ/</ns0:pron>
        <ns0:pron>/ˌal.viˈəʊ.lə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alveolar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, relational) Relating to the alveoli (small air sacs) of the lungs.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(anatomy, relational) Relating to the jaw ridge containing the tooth sockets.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(phonetics) Formed with the tongue touching or approaching the inner ridge of the gums of the upper front teeth.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(anatomy, relational) Relating to the glands with secretory cells about a central space.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alveolar ridge</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cresta alveolar</ns0:quote>
          <ns0:quote>alvéolos</ns0:quote>
          <ns0:quote>arco alveolar</ns0:quote>
          <ns0:quote>reborde alveolar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A ridge that forms the borders of the maxilla and the mandible and contains the alveoli of the teeth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alveolectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alveolectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the surgical reshaping of the alveolar ridge to facilitate dental prosthesis</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alveolus</ns0:orth>
        <ns0:pron>/alˈviː.əl.əs/</ns0:pron>
        <ns0:pron>/ælˈvi.əl.əs/</ns0:pron>
        <ns0:pron>/ˌal.viˈəʊ.ləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alveolo</ns0:quote>
          <ns0:quote>alvéolo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) An acinus (saclike cavity) in a gland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alvéolo</ns0:quote>
          <ns0:quote>alveolo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Any of the many tiny air sacs in the lungs in which the bronchioles terminate and where oxygen and carbon dioxide are rapidly exchanged with the pulmonary capillaries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>always</ns0:orth>
        <ns0:pron>/ˈɑl.weɪz/</ns0:pron>
        <ns0:pron>/ˈɑl.wiːz/</ns0:pron>
        <ns0:pron>/ˈɑl.wəz/</ns0:pron>
        <ns0:pron>/ˈɑl.wɪz/</ns0:pron>
        <ns0:pron>/ˈɔl.weɪz/</ns0:pron>
        <ns0:pron>/ˈɔl.wəz/</ns0:pron>
        <ns0:pron>/ˈɔl.wɪz/</ns0:pron>
        <ns0:pron>/ˈɔləs/</ns0:pron>
        <ns0:pron>/ˈɔː.weɪz/</ns0:pron>
        <ns0:pron>/ˈɔːl.weɪz/</ns0:pron>
        <ns0:pron>/ˈɔːl.wɪz/</ns0:pron>
        <ns0:pron>[-wɛs]</ns0:pron>
        <ns0:pron>[-wɪz]</ns0:pron>
        <ns0:pron>[ˈɔː(ɫ)we(ɪ)z]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>siempre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>At all times; throughout all time; since the beginning.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Constantly during a certain period, or regularly at stated intervals (opposed to sometimes or occasionally).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>am I under arrest</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>¿Estoy bajo arresto?</ns0:quote>
          <ns0:quote>¿Estoy detenido?</ns0:quote>
          <ns0:quote>¿Me está arrestando?</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Asked to authority, to ascertain if one is being arrested.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amain</ns0:orth>
        <ns0:pron>/əˈmeɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con todas sus fuerzas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, literary) With all of one's might; mightily; forcefully, violently. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a toda velocidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) At full speed; also, in great haste. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amalgam</ns0:orth>
        <ns0:pron>/əˈmæl.ɡəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amalgama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metallurgy) An alloy containing mercury.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A combination of different things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amalgamate</ns0:orth>
        <ns0:pron>/əˈmælɡəˌmeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amalgamar</ns0:quote>
          <ns0:quote>fusionar</ns0:quote>
          <ns0:quote>unir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, or, intransitive) To merge, to combine, to blend, to join.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amalgamar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make an alloy of a metal and mercury.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, mathematics) To combine (free groups) by identifying respective isomorphic subgroups.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amalgamation</ns0:orth>
        <ns0:pron>/əˌmælɡəˈmeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amalgamación</ns0:quote>
          <ns0:quote>amalgamamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of amalgamating; a mixture, merger or consolidation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The result of amalgamating; a mixture or alloy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(specifically) The production of an alloy of mercury and another metal, especially used in antiquity to extract gold and silver from ores.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amanita</ns0:orth>
        <ns0:pron>/ˌæməˈnaɪtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amanita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of very many agaric mushrooms, of the genus Amanita, most of which are very poisonous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amanuensis</ns0:orth>
        <ns0:pron>/əˌmænjuˈɛnsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amanuense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One employed to take dictation, or copy manuscripts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amaranth</ns0:orth>
        <ns0:pron>/-ɹænt/</ns0:pron>
        <ns0:pron>/ˈæməɹænθ/</ns0:pron>
        <ns0:pron>/ˈæməˌɹænθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amaranto</ns0:quote>
          <ns0:quote>bledo</ns0:quote>
          <ns0:quote>borlón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various herbs of the genus Amaranthus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amaranto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The characteristic purplish-red colour of the flowers or leaves of these plants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amaretto</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amaretto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, countable) A sweet-bitter liqueur originating from Italy (but also produced in Turkey), flavored with almonds and a secret blend-specific mix of some 200 ingredients such as the pits from apricots, peaches, cherries or other stone fruits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amargo</ns0:quote>
          <ns0:quote>amarguillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A light Italian cookie made with almonds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amaryllis</ns0:orth>
        <ns0:pron>/ˌæməˈɹɪlɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amarilis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A belladonna lily (Amaryllis belladonna), native to South Africa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amass</ns0:orth>
        <ns0:pron>/əˈmæs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amasar</ns0:quote>
          <ns0:quote>acumular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To collect into a mass or heap.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amate</ns0:orth>
        <ns0:pron>/əˈmɑteɪ/</ns0:pron>
        <ns0:pron>/əˈmɑːteɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amate</ns0:quote>
          <ns0:quote>papel amate</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Paper produced from the bark of adult Ficus trees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amateur</ns0:orth>
        <ns0:pron>/ˈæ.mə.tə/</ns0:pron>
        <ns0:pron>/ˈæ.mə.tɚ/</ns0:pron>
        <ns0:pron>/ˈæ.mə.t͡ʃɚ/</ns0:pron>
        <ns0:pron>/ˈæ.mə.t͡ʃʊɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amateur</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprendiz</ns0:quote>
          <ns0:quote>inadaptado</ns0:quote>
          <ns0:quote>inexperto</ns0:quote>
          <ns0:quote>novato</ns0:quote>
          <ns0:quote>primerizo</ns0:quote>
          <ns0:quote>principiante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who is unqualified or insufficiently skillful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amateurish</ns0:orth>
        <ns0:pron>/ˈæ.mə.tjʊɚ.ɪʃ/</ns0:pron>
        <ns0:pron>/ˈæ.mə.t͡ʃʊɚ.ɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amateur</ns0:quote>
          <ns0:quote>chapucero</ns0:quote>
          <ns0:quote>inexperto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pejorative) Suggesting or reflecting the efforts of an amateur; not seeming professional or polished.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amateurism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diletantismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Amateur beliefs and practices generally.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The opinion or conviction that sports ought not to be played for money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amatonormative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amatonormativo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amatonormativity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amatonormatividad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neologism) The assumption that all human beings pursue love or romance, especially by means of a monogamous long-term relationship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amatory</ns0:orth>
        <ns0:pron>/ˈæ.məˌtɔː.ɹi/</ns0:pron>
        <ns0:pron>/ˈɑ.mə.tə.ɹi/</ns0:pron>
        <ns0:pron>[ˈæ.məˌtɔɹ.i]</ns0:pron>
        <ns0:pron>[ˈɑː.mə.tə.ɹɪ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>concupisciente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to love, especially sexual love.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amaurosis</ns0:orth>
        <ns0:pron>/ˌæ.mɔˈɹoʊ.səs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amaurosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any form of blindness that is accompanied by no obvious change to the eye; often the result of disease of the optic nerve.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amaxophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amaxofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fear of being in or riding in a vehicle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amaze</ns0:orth>
        <ns0:pron>/əˈmeɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombrar</ns0:quote>
          <ns0:quote>pasmar</ns0:quote>
          <ns0:quote>sorprender</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To fill (someone) with surprise and wonder; to astonish, to astound, to surprise. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amazed</ns0:orth>
        <ns0:pron>/əˈmeɪzd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atónito</ns0:quote>
          <ns0:quote>estupefacto</ns0:quote>
          <ns0:quote>asombrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Astonished or confounded with fear, surprise, or wonder; greatly surprised (often with ensuing adpositions e.g. at, with, or by).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amazement</ns0:orth>
        <ns0:pron>/əˈmeɪz.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombro</ns0:quote>
          <ns0:quote>sorpresa</ns0:quote>
          <ns0:quote>asombramiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The condition of being amazed; a state of overwhelming wonder, as from surprise or sudden fear, horror, or admiration; astonishment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amazing</ns0:orth>
        <ns0:pron>/əˈmeɪzɪŋ/</ns0:pron>
        <ns0:pron>[əˈmeɪ̯zɪŋ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sorprendente</ns0:quote>
          <ns0:quote>asombroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing wonder and amazement; very surprising.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amazingly</ns0:orth>
        <ns0:pron>/əˈmeɪzɪŋli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extraordinariamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an amazing manner; in a way that causes amazement; wonderfully.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>increíblemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Difficult to believe; strange but true.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asombrosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To a wonder-inspiring extent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amazon</ns0:orth>
        <ns0:pron>/-ɒn/</ns0:pron>
        <ns0:pron>/əˈmezɔn/</ns0:pron>
        <ns0:pron>/ˈæm.ə.zɔn/</ns0:pron>
        <ns0:pron>/ˈæm.ə.zən/</ns0:pron>
        <ns0:pron>/ˈæm.əˌzɑn/</ns0:pron>
        <ns0:pron>/ˈæm.əˌzɒn/</ns0:pron>
        <ns0:pron>[ˈɛəm.əˌzɑn]</ns0:pron>
        <ns0:pron>[ˈɛəm.əˌzɒn]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amazona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tall, strong, athletic woman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amazonite</ns0:orth>
        <ns0:pron>/ˈæm.ə.zəˌnaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amazonita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A gem variety of microcline feldspar, varying from bright verdigris green to a bluish green.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amban</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amban</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, _, historical) A Chinese official under the Qing Dynasty, especially the ranking official or provincial governor in a semi-independent territory under Chinese rule.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambassador</ns0:orth>
        <ns0:pron>/æmˈbæs.ə.də(ɹ)/</ns0:pron>
        <ns0:pron>/æmˈbæs.ə.dɚ/</ns0:pron>
        <ns0:pron>/æmˈbæs.əˌdɔɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embajador</ns0:quote>
          <ns0:quote>embajadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A diplomat of the highest rank sent to a foreign court to represent there their sovereign or country. (Sometimes called ambassador-in-residence)</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An official messenger and representative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambassadress</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embajadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) A female ambassador.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esposa de un embajador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The wife of an ambassador.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amber</ns0:orth>
        <ns0:pron>/ˈam.bə/</ns0:pron>
        <ns0:pron>/ˈæm.bɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambarino</ns0:quote>
          <ns0:quote>de color ámbar</ns0:quote>
          <ns0:quote>ámbar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of a brownish yellow colour, like that of most amber.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amber</ns0:orth>
        <ns0:pron>/ˈam.bə/</ns0:pron>
        <ns0:pron>/ˈæm.bɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ámbar</ns0:quote>
          <ns0:quote>cárabe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hard, generally yellow to brown translucent or transparent fossil resin from extinct coniferous trees of the pine genus, used for jewellery, decoration and later dissolved as a binder in varnishes. One variety, blue amber, appears blue rather than yellow under direct sunlight. [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ámbar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A yellow-orange colour.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(British, AU) The intermediate light in a set of three traffic lights, which when illuminated indicates that drivers should stop when safe to do so. See also yellow light.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambergris</ns0:orth>
        <ns0:pron>/ˈæm.bə.ɡɹɪs/</ns0:pron>
        <ns0:pron>/ˈæm.bɚ.ɡɹis/</ns0:pron>
        <ns0:pron>/ˈæm.bɚ.ɡɹɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ámbar gris</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A solid, waxy, flammable substance of a dull grey or blackish color, produced in the intestines of the sperm whale. It is used in perfumes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambiance</ns0:orth>
        <ns0:pron>/ˈæm.bi.əns/</ns0:pron>
        <ns0:pron>/ˈɑm.bi.ɑns/</ns0:pron>
        <ns0:pron>/ˈɒm.bi.ɒns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambientación</ns0:quote>
          <ns0:quote>ambiente</ns0:quote>
          <ns0:quote>atmósfera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A particular mood or atmosphere of an environment or surrounding influence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambidextrous</ns0:orth>
        <ns0:pron>/ˌæm.biˈdɛk.stɹəs/</ns0:pron>
        <ns0:pron>/ˌæm.bɪˈdɛk.stɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambidextro</ns0:quote>
          <ns0:quote>ambidiestro</ns0:quote>
          <ns0:quote>maniego</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having equal or comparable ability in both hands; in particular, able to write well with both hands.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambigram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambigrama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A calligraphic design that may be read as the same word or phrase (or sometimes different words or phrases) when oriented in two different ways, usually when reflected along a vertical or horizontal axis or when rotated through 180 degrees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambiguity</ns0:orth>
        <ns0:pron>/æm.bɪˈɡjuː.ɪ.ti/</ns0:pron>
        <ns0:pron>/ˌæm.bəˈɡjuː.ə.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambigüedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An instance of this state: words or statements that are open to more than one interpretation, explanation or meaning, especially if that meaning cannot be determined from the context.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambiguous</ns0:orth>
        <ns0:pron>/æmˈbɪɡ.ju.əs/</ns0:pron>
        <ns0:pron>/æmˈbɪɡ.jʉ.əs/</ns0:pron>
        <ns0:pron>[ɛəmˈbɪɡ.ju.əs]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Open to multiple interpretations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambiguously</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambiguamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an ambiguous manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambit</ns0:orth>
        <ns0:pron>/ˈæmbɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zona de influencia</ns0:quote>
          <ns0:quote>ámbito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The area or sphere of control and influence of something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ámbito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) The boundary around a building, town, region, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambition</ns0:orth>
        <ns0:pron>/æmˈbɪʃ.ən/</ns0:pron>
        <ns0:pron>/ˈambɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, countable) Eager or inordinate desire for some object that confers distinction, as preferment, honor, superiority, political power, or fame; desire to distinguish one's self from other people.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) An object of an ardent desire.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A desire, as in (sense 1), for another person to achieve these things.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) A personal quality similar to motivation, not necessarily tied to a single goal.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete) The act of going about to solicit or obtain an office, or any other object of desire; canvassing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambitious</ns0:orth>
        <ns0:pron>/æmˈbɪʃ.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambicioso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a person or their character) Having or showing ambition; wanting a lot of power, honor, respect, superiority, or other distinction.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(followed by "of" or the infinitive) Very desirous</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Hard to achieve.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambitiously</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambiciosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an ambitious manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambitransitive</ns0:orth>
        <ns0:pron>/ˌæmbɪˈtɹænzɪtɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambitransitivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a verb) Able to be used transitively or intransitively without requiring morphological change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambivalence</ns0:orth>
        <ns0:pron>/æmˈbɪvələns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambivalencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The coexistence of opposing attitudes or feelings (such as love and hate) towards a person, object or idea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>indecisión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of uncertainty or indecisiveness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambivalent</ns0:orth>
        <ns0:pron>/æmˈbɪv.ə.lənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambivalente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Simultaneously experiencing or expressing opposing or contradictory feelings, beliefs, motivations, or meanings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambivert</ns0:orth>
        <ns0:pron>/-vəːt/</ns0:pron>
        <ns0:pron>/ˈæmbəˌvɚt/</ns0:pron>
        <ns0:pron>/ˈæmbɪvɜːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambivertido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) A person who is neither clearly extroverted nor introverted, but has characteristics of each.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amble</ns0:orth>
        <ns0:pron>/ˈæm.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambular</ns0:quote>
          <ns0:quote>deambular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unhurried leisurely walk or stroll.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amble</ns0:orth>
        <ns0:pron>/ˈæm.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambular</ns0:quote>
          <ns0:quote>deambular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To stroll or walk slowly and leisurely.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amblyope</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambliope</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person afflicted with amblyopia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amblyopia</ns0:orth>
        <ns0:pron>/æmblɪˈəʊpɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambliopía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Dimness or blurring of the eyesight due to a fault in transmission of signals to the brain from an otherwise healthy eye.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amblyopic</ns0:orth>
        <ns0:pron>/æm.bliː.oʊ.pɪk/</ns0:pron>
        <ns0:pron>/æm.bliː.ɒ.pɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambliope</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of, relating to, or suffering from amblyopia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambo</ns0:orth>
        <ns0:pron>/ˈæm.bəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A raised platform in an early Christian church, as well as in the Eastern Orthodox, Oriental Orthodox, and Eastern Catholic churches.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Roman Catholicism) A stationary podium used for readings and homilies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambrosia</ns0:orth>
        <ns0:pron>/æmˈbɹoʊʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ambrosía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any fungus of a number of species that insects such as ambrosia beetles carry as symbionts, "farming" them on poor-quality food such as wood, where they grow, providing food for the insect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ambulacral</ns0:orth>
      </ns0:form>
