      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>as bajo la manga</ns0:quote>
          <ns0:quote>as en la manga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiom) A surprise advantage of which others are not aware.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
