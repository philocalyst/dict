        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Príamo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek mythology) The king of Troy during the Iliad</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Priapus</ns0:orth>
        <ns0:pron>/pɹaɪˈeɪpəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Príapo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The son of Aphrodite and Dionysus, god of procreation, and guardian of gardens and vineyards; personification of the phallus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pride</ns0:orth>
        <ns0:pron>/pɹaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Orgullo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A festival or other event, usually involving a march or parade and organized annually within a city, to celebrate the experiences and identities of LGBTQ people and to promote their interests and rights. [from late 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pride Month</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mes del orgullo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) The month of June, declared for LGBT pride in commemoration of the Stonewall riots of June 1969.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
