          <ns0:quote>de nuevo</ns0:quote>
          <ns0:quote>otra vez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anew; again; once more.</ns0:def>
        </ns0:sense>
