        <ns0:sense>
          <ns0:def>(uncommon) An improvement or amelioration.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(legal) An improvement to a property that adds to its value.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
