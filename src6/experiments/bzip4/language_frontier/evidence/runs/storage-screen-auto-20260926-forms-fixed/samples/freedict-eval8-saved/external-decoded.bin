        <ns0:pron>/d͡ʒiˈpi.es/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>GPS</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cartography) Initialism of global positioning system (“satellite navigation system”).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>GPS receiver</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>GPS</ns0:quote>
          <ns0:quote>navegador GPS</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An audiovisual device, fitted to a civilian road vehicle, that uses the military Global Positioning System (U.S. Navstar system) as an aid to navigation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) A device that uses any global positioning system satellite network.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
