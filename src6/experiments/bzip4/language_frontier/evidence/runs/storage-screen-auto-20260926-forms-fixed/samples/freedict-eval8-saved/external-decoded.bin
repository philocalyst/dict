        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espectroscopía de absorción</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absorption spectrum</ns0:orth>
        <ns0:pron>/æbˈsɔɹp.ʃn̩ ˈspɜk.tɹəm/</ns0:pron>
        <ns0:pron>/æbˈzɔɹp.ʃn̩ ˈspɜk.tɹəm/</ns0:pron>
        <ns0:pron>/əbˈsɔɹp.ʃn̩ ˈspɜk.tɹəm/</ns0:pron>
        <ns0:pron>/əbˈzɔɹp.ʃn̩ ˈspɜk.tɹəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espectro de absorción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The characteristic pattern of dark lines or bands that occurs when electromagnetic radiation is passed through an absorbing medium into a spectroscope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstain</ns0:orth>
        <ns0:pron>/æbˈsteɪn/</ns0:pron>
        <ns0:pron>/əbˈsteɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstenerse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) Refrain from (something or doing something); keep from doing, especially an indulgence. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>retener</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) Hinder; keep back; withhold. [Attested from the early 16th century until the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstainer</ns0:orth>
        <ns0:pron>/æbˈsteɪ.nɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstemio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who abstains; especially, one who abstains from something, such as the use of alcohol or drugs, or one who abstains for religious reasons; one who practices self-denial. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstemious</ns0:orth>
        <ns0:pron>/æbˈsti.mi.əs/</ns0:pron>
        <ns0:pron>/æbˈstiː.mɪ.əs/</ns0:pron>
        <ns0:pron>/əb-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstemio</ns0:quote>
          <ns0:quote>sobrio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Refraining from freely consuming food or strong drink; sparing in diet; abstinent, temperate. [From early 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstemio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sparingly used; used with temperance or moderation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Marked by, or spent in, abstinence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstention</ns0:orth>
        <ns0:pron>/æbˈstɛn.t͡ʃn̩/</ns0:pron>
        <ns0:pron>/æbˈstɛn.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈstɛn.t͡ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈstɛn.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) The act of restraining oneself. [Attested from the early 16th century until the med 17th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of abstaining or refraining (from). [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstentionist</ns0:orth>
        <ns0:pron>/æbˈstɛn.t͡ʃn̩.ɪst/</ns0:pron>
        <ns0:pron>/æbˈstɛn.ʃn̩.ɪst/</ns0:pron>
        <ns0:pron>/əbˈstɛn.t͡ʃn̩.ɪst/</ns0:pron>
        <ns0:pron>/əbˈstɛn.ʃn̩.ɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstencionista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A practitioner or advocate of not getting involved politically. [First attested in the late 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstergent</ns0:orth>
        <ns0:pron>/æbˈstɝ.d͡ʒn̩t/</ns0:pron>
        <ns0:pron>/əbˈstɜː(ɹ)d͡ʒn̩t/</ns0:pron>
        <ns0:pron>/əbˈstɝ.d͡ʒn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstergente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A substance used to cleanse; a detergent. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstersion</ns0:orth>
        <ns0:pron>/æbˈstɜː.ʒn̩/</ns0:pron>
        <ns0:pron>/æbˈstɝ.ʃn̩/</ns0:pron>
        <ns0:pron>/æbˈstɝ.ʒn̩/</ns0:pron>
        <ns0:pron>/əbˈstɝ.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈstɝ.ʒn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstersión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) Act of wiping clean; a cleansing; a purging. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstersive</ns0:orth>
        <ns0:pron>/æbˈstɝ.sɪv/</ns0:pron>
        <ns0:pron>/əbˈstɜː(ɹ).sɪv/</ns0:pron>
        <ns0:pron>/əbˈstɝ.sɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstersivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Cleansing; purging; abstergent. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstinence</ns0:orth>
        <ns0:pron>/ˈæb.stɪ.nəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstinencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Specifically, the practice of abstaining from intoxicating/alcoholic beverages; total abstinence; teetotalism). [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Specifically, the practice of abstaining from sexual intercourse, either permanently or until marriage. [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstinencia</ns0:quote>
          <ns0:quote>vigilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or practice of abstaining, refraining from indulging a desire or appetite. [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vigilia</ns0:quote>
          <ns0:quote>abstinencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The practice of self-denial; self-restraint; forebearance from anything. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstinent</ns0:orth>
        <ns0:pron>/ˈæb.stə.nn̩t/</ns0:pron>
        <ns0:pron>/ˈæb.stɪ.nn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstinente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Refraining from indulgence, especially from the indulgence of appetite. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract</ns0:orth>
        <ns0:pron>/əbˈstɹækt/</ns0:pron>
        <ns0:pron>/ˈæbˌstɹækt/</ns0:pron>
        <ns0:pron>/ˌæbˈstɹækt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstracto</ns0:quote>
          <ns0:quote>extraído</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Derived; extracted. [Attested from around 1350 to 1470 until the late 15th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, rare) Drawn away; removed from; apart from; separate. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Apart from practice or reality; vague; theoretical; impersonal; not applied.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(arts, often, capitalized) Free from representational qualities, in particular the non-representational styles of the 20th century. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstracto</ns0:quote>
          <ns0:quote>complicado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Difficult to understand; abstruse; hard to conceptualize. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>distraído</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) Absent-minded. [First attested in the early 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract</ns0:orth>
        <ns0:pron>/əbˈstɹækt/</ns0:pron>
        <ns0:pron>/ˈæbˌstɹækt/</ns0:pron>
        <ns0:pron>/ˌæbˈstɹækt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>resumen</ns0:quote>
          <ns0:quote>extracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abridgement or summary of a longer publication. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstracción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abstraction; an abstract term; that which is abstract. [First attested in the mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arte abstracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(arts) An abstract work of art. [First attested in the early 20th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(real estate) A summary title of the key points detailing a tract of land, for ownership; abstract of title.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract</ns0:orth>
        <ns0:pron>/əbˈstɹækt/</ns0:pron>
        <ns0:pron>/ˈæbˌstɹækt/</ns0:pron>
        <ns0:pron>/ˌæbˈstɹækt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstraer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To consider abstractly; to contemplate separately or by itself; to consider theoretically; to look at as a general quality. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstraer</ns0:quote>
          <ns0:quote>extraer</ns0:quote>
          <ns0:quote>retirar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To separate; to disengage. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstraerse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, reflexive, literally, figuratively) To withdraw oneself; to retire. [First attested in the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>destilar</ns0:quote>
          <ns0:quote>abstraer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To conceptualize an ideal subgroup by means of the generalization of an attribute, as follows: by apprehending an attribute inherent to one individual, then separating that attribute and contemplating it by itself, then conceiving of that attribute as a general quality, then despecifying that conceived quality with respect to several or many individuals, and by then ideating a group composed of those individuals perceived to possess said quality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extraer</ns0:quote>
          <ns0:quote>quitar</ns0:quote>
          <ns0:quote>retirar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, euphemistic) To steal; to take away; to remove without permission. [First attested in the late 15th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>resumir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To summarize; to abridge; to epitomize. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract algebra</ns0:orth>
        <ns0:pron>/ˈæbˌstɹækt ˈæl.d͡ʒə.bɹə/</ns0:pron>
        <ns0:pron>/ˈæbˌstɹækt ˈæl.d͡ʒɪ.bɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>álgebra abstracta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) The branch of mathematics concerned with algebraic structures, such as groups, rings, and fields.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract noun</ns0:orth>
        <ns0:pron>/ˈæbˌstɹækt naʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nombre abstracto</ns0:quote>
          <ns0:quote>sustantivo abstracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A noun that denotes an idea, emotion, feeling, quality, generalization, representation or other abstract or intangible concept, as opposed to a concrete item, or a physical object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract number</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>número abstracto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A number used without application to things, e.g. 6, 8, 10; but when applied to anything, e.g. 6 feet, 10 men, it becomes concrete.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstract of title</ns0:orth>
        <ns0:pron>/æbˈstɹækt/</ns0:pron>
        <ns0:pron>/ɑv/</ns0:pron>
        <ns0:pron>/ɒv/</ns0:pron>
        <ns0:pron>/əv/</ns0:pron>
        <ns0:pron>/ʌv/</ns0:pron>
        <ns0:pron>/ˈtaɪ.tl̩/</ns0:pron>
        <ns0:pron>/ˈæbˌstɹækt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>resumen de título</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal, real estate) An epitome of the evidences of ownership; the condensed history of title to a particular parcel of real estate, with encumbrances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstracted</ns0:orth>
        <ns0:pron>/æbˈstɹæk.tɪd/</ns0:pron>
        <ns0:pron>/əbˈstɹæk.tɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstraído</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Separated or disconnected; withdrawn; removed; apart. [First attested in the mid 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Inattentive to surrounding objects; absent in mind; meditative. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstraction</ns0:orth>
        <ns0:pron>/æbˈstɹæk.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈstɹæk.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstracción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of focusing on one characteristic of an object rather than the object as a whole group of characteristics; the act of separating said qualities from the object or ideas. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of comparing commonality between distinct objects and organizing using those similarities; the act of generalizing characteristics; the product of said generalization. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstractionism</ns0:orth>
        <ns0:pron>/æbˈstɹæk.ʃn̩ˌɪz.m̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstraccionismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The creation, principles, or ideals of abstractions, in particular art. [First attested in the mid 20th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstractionist</ns0:orth>
        <ns0:pron>/æbˈstɹæk.ʃən.əst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstraccionista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(art) Someone who supports or creates abstract art.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstractly</ns0:orth>
        <ns0:pron>/æbˈstɹækt.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstractamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an abstract way or manner</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abstruse</ns0:orth>
        <ns0:pron>/æb-/</ns0:pron>
        <ns0:pron>/əbˈstɹus/</ns0:pron>
        <ns0:pron>/əbˈstɹuːs/</ns0:pron>
        <ns0:pron>/əbˈstɹʉs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abstruso</ns0:quote>
          <ns0:quote>conceptuoso</ns0:quote>
          <ns0:quote>obscuro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Difficult to comprehend or understand; obscure. [from mid 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absurd</ns0:orth>
        <ns0:pron>/æbˈsɚd/</ns0:pron>
        <ns0:pron>/æbˈzɚd/</ns0:pron>
        <ns0:pron>/əbˈsɚd/</ns0:pron>
        <ns0:pron>/əbˈsɜːd/</ns0:pron>
        <ns0:pron>/əbˈzɚd/</ns0:pron>
        <ns0:pron>/əbˈzɜːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absurdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Contrary to reason or propriety; obviously and flatly opposed to manifest truth; inconsistent with the plain dictates of common sense; logically contradictory; nonsensical; ridiculous; silly. [from mid-16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absurd</ns0:orth>
