    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Maccabee</ns0:orth>
        <ns0:pron>/ˈmæ.kəˌbi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>macabeo</ns0:quote>
          <ns0:quote>Macabeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) A member of the Maccabees (a liberation movement in Israel who established Jewish independence in the Land of Israel in the second and first centuries BC).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
