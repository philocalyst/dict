      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lamarckism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lamarckismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(evolutionary theory, historical) The theory that structural variations, characteristic of species and genera, are produced in animals and plants by the direct influence of physical environments, and especially, in the case of animals, by effort, or by use or disuse of certain organs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
