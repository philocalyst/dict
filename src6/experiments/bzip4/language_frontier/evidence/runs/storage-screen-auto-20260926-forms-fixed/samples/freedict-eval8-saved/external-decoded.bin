        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city of Zambia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lusatia</ns0:orth>
        <ns0:pron>/luˈseɪʃə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lusacia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A traditionally Slavic-speaking cultural region in Central Europe, in modern Germany, Poland and the Czech Republic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Lusitania</ns0:orth>
        <ns0:pron>/lu.sɪˈteɪ.ni.ə/</ns0:pron>
        <ns0:pron>/luː.sɪˈteɪ.nɪə/</ns0:pron>
