        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>below</ns0:orth>
        <ns0:pron>/bɪˈloʊ/</ns0:pron>
        <ns0:pron>/bɪˈləʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajo</ns0:quote>
          <ns0:quote>so</ns0:quote>
          <ns0:quote>sota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
