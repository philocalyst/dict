      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhesión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A close physical union of two objects.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adherent</ns0:orth>
        <ns0:pron>/ædˈ(h)ɪə.ɹənt/</ns0:pron>
        <ns0:pron>/ædˈ(h)ɪɹ.ənt/</ns0:pron>
        <ns0:pron>/əd-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhesivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Adhesive, sticking to something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adherente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the quality of clinging or sticking fast to something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adherent</ns0:orth>
        <ns0:pron>/ædˈ(h)ɪə.ɹənt/</ns0:pron>
        <ns0:pron>/ædˈ(h)ɪɹ.ənt/</ns0:pron>
        <ns0:pron>/əd-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adherente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who has membership in some group, association or religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhesion</ns0:orth>
        <ns0:pron>/ˌædˈhiː.ʒən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhesión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ability of a substance to stick to an unlike substance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biochemistry) The binding of a cell to a surface or substrate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhesive</ns0:orth>
        <ns0:pron>/ædˈhi.sɪv/</ns0:pron>
        <ns0:pron>/ədˈhi.sɪv/</ns0:pron>
        <ns0:pron>/ədˈhiː.səv/</ns0:pron>
        <ns0:pron>/ədˈhiː.sɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhesivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sticky; tenacious, as glutinous substances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhesive</ns0:orth>
        <ns0:pron>/ædˈhi.sɪv/</ns0:pron>
        <ns0:pron>/ədˈhi.sɪv/</ns0:pron>
        <ns0:pron>/ədˈhiː.səv/</ns0:pron>
        <ns0:pron>/ədˈhiː.sɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhesivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>a substance, such as glue, that provides or promotes adhesion</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhesive capsulitis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>capsulitis adhesiva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A disorder in which the shoulder capsule, the connective tissue surrounding the glenohumeral joint of the shoulder, becomes inflamed and stiff, greatly restricting motion and causing chronic pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhesive tape</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinta adhesiva</ns0:quote>
          <ns0:quote>celo</ns0:quote>
          <ns0:quote>fixo</ns0:quote>
          <ns0:quote>cinta Scotch</ns0:quote>
          <ns0:quote>cinta escocesa</ns0:quote>
          <ns0:quote>cinta pegante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, medical) Surgical tape, such tape made specifically for medical purposes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhocracy</ns0:orth>
        <ns0:pron>/ædˈhɑkɹəsi/</ns0:pron>
        <ns0:pron>/ədˈhɒkɹəsi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhocracia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(business, organizational theory) An organizational system designed to be flexible and responsive to the needs of the moment rather than excessively bureaucratic. [from 1964.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adiabatic</ns0:orth>
        <ns0:pron>/ˌeɪ.daɪ.əˈbæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌeɪ.dɪəˈbæt.ɪk/</ns0:pron>
        <ns0:pron>/ˌæd.ɪəˈbæt.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adiabático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, thermodynamics, of a process) Without gain or loss of heat (and thus with no change in entropy, in the quasistatic approximation).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adieu</ns0:orth>
        <ns0:pron>/əˈd(j)ɪu̯/</ns0:pron>
        <ns0:pron>/əˈd(j)ʌu̯/</ns0:pron>
        <ns0:pron>/əˈdju/</ns0:pron>
        <ns0:pron>/əˈdjuː/</ns0:pron>
        <ns0:pron>/əˈdjɜː/</ns0:pron>
        <ns0:pron>/əˈdu/</ns0:pron>
        <ns0:pron>[əˈd(j)ɛʊ̯]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adiós</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A farewell, a goodbye; especially a fond farewell, or a lasting or permanent farewell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adimensional</ns0:orth>
