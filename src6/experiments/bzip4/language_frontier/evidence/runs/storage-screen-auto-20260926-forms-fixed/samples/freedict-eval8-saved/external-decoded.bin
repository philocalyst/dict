        <ns0:pron>/ˌæk.n̩ˈθeɪ.ʃəs/</ns0:pron>
        <ns0:pron>/ˌæk.ænˈθeɪ.ʃəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acantáceo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) : Of, pertaining to, or resembling, a member of the Acanthaceae family.[First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Armed with prickles, as a plant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
