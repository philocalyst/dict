        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amputar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To surgically remove a part of the body, especially a limb. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
