        </ns0:cit>
        <ns0:sense>
          <ns0:def>(fiction) The main setting of J. R. R. Tolkien's Lord of the Rings and other works.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
