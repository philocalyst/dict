        <ns0:pron>/ˈpoʊ.kə.mɑn/&lt;q:common and sometimes used officially&gt;</ns0:pron>
        <ns0:pron>/ˈpoʊkiˌmɑn/&lt;a:proscribed&gt;</ns0:pron>
        <ns0:pron>/ˈpoːkɪmɔn/</ns0:pron>
        <ns0:pron>/ˈpœʊkɨmɒn/</ns0:pron>
        <ns0:pron>/ˈpɐʉkəmɒn/</ns0:pron>
        <ns0:pron>/ˈpəʉkəmɔn/</ns0:pron>
        <ns0:pron>/ˈpəʊkəmɒn/</ns0:pron>
