      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eslavo</ns0:quote>
          <ns0:quote>eslava</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of any of the peoples of Europe who speak the Slavic languages.</ns0:def>
