      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Internacional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A general left-wing anthem for solidarity and emancipation of the working class, dating back to the 19th century.</ns0:def>
        </ns0:sense>
