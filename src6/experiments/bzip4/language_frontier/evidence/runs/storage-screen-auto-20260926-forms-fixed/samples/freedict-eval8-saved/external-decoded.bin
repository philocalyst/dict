      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alfabeto Fonético Internacional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(phonetics, phonology) A standardized set of symbols for representing the sounds of human speech.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International System of Units</ns0:orth>
      </ns0:form>
