    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Taoism</ns0:orth>
        <ns0:pron>/ˈtaʊ̯.ɪzm̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>taoísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Chinese mystical philosophy traditionally founded by Lao-tzu in the 6th century B.C.E. that teaches conformity to the tao by unassertive action and simplicity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>taoismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A religion developed from Taoist philosophy and folk and Buddhist religion and concerned with obtaining long life and good fortune often by magical means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
