      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ivan</ns0:orth>
        <ns0:pron>/ɪˈvɑːn/</ns0:pron>
        <ns0:pron>/ˈaɪ.vən/</ns0:pron>
        <ns0:pron>/ˈivɑːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iván</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transliteration of the Russian male given name Ива́н (Iván).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A transliteration of the Belarusian male given name Іва́н (Iván).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A transliteration of the Ukrainian male given name Іва́н (Iván)</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A transliteration of the Macedonian male given name Иван (Ivan).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ivankiv</ns0:orth>
