        <ns0:pron>/ˈɔ.tə-/</ns0:pron>
        <ns0:pron>/ˈɔː.tə-/</ns0:pron>
        <ns0:pron>[ˈɑɾə-]</ns0:pron>
        <ns0:pron>[ˈɔɾə-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auto-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Reflexive, regarding or to oneself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auto-reply</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respuesta automática</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(email, computing, uncountable) A feature in e-mail software that sends automatic replies, used for instance when the recipient of a message is on holiday.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(email, computing, countable) A message sent by this means.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
