      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amenorrea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Absence of menstrual discharge.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>americano</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>americano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A drink made of espresso coffee diluted with hot water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>americium</ns0:orth>
        <ns0:pron>/ˌæməˈɹɪsiəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>americio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The chemical element (symbol Am) with an atomic number of 95.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amethyst</ns0:orth>
        <ns0:pron>/ˈæm.ə.θɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amatista</ns0:quote>
          <ns0:quote>ametista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transparent purple to violet variety of quartz with traces of manganese, used as a gemstone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amatista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A purple colour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ametrine</ns0:orth>
        <ns0:pron>/ˈæmətɹiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ametrino</ns0:quote>
          <ns0:quote>bolivianita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A naturally occurring variety of quartz, with zones of purple and yellow or orange.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ametropia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ametropía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, ophthalmology) Any of several disorders of the eye (spherical or cylindrical) resulting from faulty refractive ability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amiability</ns0:orth>
        <ns0:pron>/eɪ.mi.ʌˈbɪl.ə.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afabilidad</ns0:quote>
          <ns0:quote>amabilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Friendliness, especially easy approachability owing to a cheerful and pleasant disposition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amiable</ns0:orth>
        <ns0:pron>/ˈeɪ.mi.ə.bəl/</ns0:pron>
        <ns0:pron>/ˈæ.mi.ə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afable</ns0:quote>
          <ns0:quote>amable</ns0:quote>
          <ns0:quote>vergón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Friendly; kind; sweet; gracious</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of a pleasant and likeable nature; kind-hearted; easy to like</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amiably</ns0:orth>
        <ns0:pron>/ˈeɪ.mɪə.blɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amablemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an amiable manner; in a friendly or pleasant manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amianthus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amianto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of asbestos with long, soft, thin fibers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amicable</ns0:orth>
        <ns0:pron>/ˈæ.mɪ.kə.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amistoso</ns0:quote>
          <ns0:quote>amigable</ns0:quote>
          <ns0:quote>cordial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Showing friendliness or goodwill.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amicable number</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>números amigos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(number theory) One of a pair of numbers having the property that the sum of the divisors of each, excluding itself, is equal to the other number.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amice</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hood, or cape with a hood, made of or lined with grey fur, formerly worn by the clergy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amid</ns0:orth>
        <ns0:pron>/əˈmɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en medio de</ns0:quote>
          <ns0:quote>entre</ns0:quote>
          <ns0:quote>envuelto</ns0:quote>
          <ns0:quote>rodeado por</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amide</ns0:orth>
        <ns0:pron>/ˈeɪ.maɪd/</ns0:pron>
        <ns0:pron>/ˈæ.maɪd/</ns0:pron>
        <ns0:pron>/ˈæ.mɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any derivative of an oxoacid in which the hydroxyl group has been replaced with an amino or substituted amino group; especially such derivatives of a carboxylic acid, the carboxamides or acid amides</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(inorganic chemistry) Any ionic derivative of ammonia in which a hydrogen atom has been replaced with a metal cation (R-NH- or R2N-)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amidine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amidina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any of several classes of organic compound, formally derived from oxoacids by replacement of the hydroxy group with an amino group, and the oxo group with =NR.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amidst</ns0:orth>
        <ns0:pron>/aˈmɪdst/</ns0:pron>
        <ns0:pron>/əˈmɪtst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en medio de</ns0:quote>
          <ns0:quote>en pleno</ns0:quote>
          <ns0:quote>entre</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amine</ns0:orth>
        <ns0:pron>/əˈmiːn/</ns0:pron>
        <ns0:pron>/ˈeɪ.miːn/</ns0:pron>
        <ns0:pron>/ˈæ.miːn/</ns0:pron>
        <ns0:pron>/ˈæ.mɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic chemistry) A functional group formally derived from ammonia by replacing one, two or three hydrogen atoms with hydrocarbon or other radicals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any organic compound containing an amine functional group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amino</ns0:orth>
        <ns0:pron>/əˈmaɪnəʊ/</ns0:pron>
        <ns0:pron>/əˈminoʊ/</ns0:pron>
        <ns0:pron>/əˈmiːnəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Relating to an amine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amino</ns0:orth>
        <ns0:pron>/əˈmaɪnəʊ/</ns0:pron>
        <ns0:pron>/əˈminoʊ/</ns0:pron>
        <ns0:pron>/əˈmiːnəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) The amine functional group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amino acid</ns0:orth>
        <ns0:pron>/əˈminoʊ ˈæsɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aminoácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(amino acid) Any organic compound containing both an amino and a carboxylic acid functional group.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(amino acid) Any of the twenty naturally occurring α-amino acids (having the amino, and carboxylic acid groups on the same carbon atom), and a variety of side chains, that combine, via peptide bonds, to form proteins.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aminoaciduria</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aminoaciduria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The presence of amino acids in the urine (which is always true in small amounts); and usually, more specifically, an excess (hyperaminoaciduria).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aminoacyl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aminoacil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of class of organic radicals, formed by the removal of a hydroxyl group from an amino acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aminobenzoate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aminobenzoato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any salt or ester of aminobenzoic acid</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aminobenzoic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido aminobenzoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carboxylic acid) Any benzoic acid with an amino group, such as anthranilic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aminogram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aminograma</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aminophylline</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aminofilina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A bronchodilator comprising theophylline and ethylenediamine in a 2:1 ratio.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amiodarone</ns0:orth>
        <ns0:pron>/əˈmi.əd.əˌɹoʊn/</ns0:pron>
