          <ns0:quote>manzanilla de Castilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An annual plant, Matricaria recutita, of the aster family, which is the type of camomile most used for tea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
