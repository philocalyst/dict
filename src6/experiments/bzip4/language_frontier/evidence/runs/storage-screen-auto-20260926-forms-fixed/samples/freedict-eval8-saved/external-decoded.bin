      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Indo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A major river in China, India and Pakistan, rising in Tibet and flowing into the Arabian Sea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Indus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A constellation of the southern sky between Grus and Pavo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Industrial Revolution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Revolución Industrial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The major technological, socioeconomic and cultural change in the late 18th and early 19th century resulting from the replacement of an economy based on manual labour to one dominated by industry and machine manufacture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Information Age</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>era de la información</ns0:quote>
          <ns0:quote>era informática</ns0:quote>
          <ns0:quote>era digital</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The current era, characterised by the increasing importance and availability of information (especially by means of computers), as opposed to previous eras (such as the Industrial Age) in which most endeavours related to some physical process or product.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
