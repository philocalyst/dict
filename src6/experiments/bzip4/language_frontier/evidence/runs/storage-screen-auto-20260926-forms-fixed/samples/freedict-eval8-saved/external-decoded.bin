        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cantárida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A supposed aphrodisiac extracted from the beetle Lytta vesicatoria; cantharidin, the active ingredient, a vesicant used as a defence by L. vesicatoria and other blister beetles.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The beetle Lytta vesicatoria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spanish influenza</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gripe española</ns0:quote>
          <ns0:quote>gripe de 18</ns0:quote>
          <ns0:quote>gripe de 1918</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A form of influenza that spread to nearly every part of the world in a pandemic between 1918 and 1920, killing from 20 to 100 million people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spanish omelette</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tortilla</ns0:quote>
          <ns0:quote>tortilla de papas</ns0:quote>
          <ns0:quote>tortilla de patatas</ns0:quote>
          <ns0:quote>tortilla española</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A molded omelette made with the addition of fried potatoes and often onions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spanish-speaking</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hispanohablante</ns0:quote>
          <ns0:quote>hispanoparlante</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spanishness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>españolismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality or state of being Spanish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sparta</ns0:orth>
        <ns0:pron>/ˈspɑː(ɹ)tə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Esparta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient city-state in southern Greece, noted for its strict military training.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spartacus</ns0:orth>
        <ns0:pron>/ˈspɑːtəkəs/</ns0:pron>
        <ns0:pron>/ˈspɑːɹtəkəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Espartaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Thracian name, notably borne by a gladiator who was one of the slave leaders in a major slave uprising against the Roman Republic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spartan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espartano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to Sparta or its citizens.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spartan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espartano</ns0:quote>
          <ns0:quote>espartana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A citizen of Sparta; a native or inhabitant of Sparta.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Special Region of Yogyakarta</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Región especial de Yogyakarta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An autonomous region of Indonesia. Capital: Yogyakarta.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sphinx</ns0:orth>
        <ns0:pron>/ˈsfɪŋks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Esfinge</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient, large statue in Egypt, with the face of a man and the body of a lion, lying near the Great Pyramids.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Greek mythology) One of the many offspring of Typhon and Echidna, a winged lion-like creature with a woman's face, who committed suicide out of frustration after Oedipus managed to solve her riddles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spidey sense</ns0:orth>
        <ns0:pron>/ˈspaɪdi ˌsɛn(t)s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sentido arácnido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(humorous) An intuitive feeling, usually of something being dangerous or risky; (more generally) instinct, intuition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spiritism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espiritismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A philosophical doctrine, established in France in the mid nineteenth century, postulating that humans are essentially immortal spirits that temporarily inhabit physical bodies, and may have influence on the physical world.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sprachgefühl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>intuición lingüística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The instinctive or intuitive grasp of the natural idiom of a language. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Spratly Islands</ns0:orth>
        <ns0:pron>/ˌspɾat.lɪ ˈʔaɪ̯.lɐnds/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islas Spratly</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of islands, atolls, reefs, and cays in the South China Sea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sri Jayawardenepura Kotte</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sri Jayawardenapura Kotte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The administrative capital of Sri Lanka, located next to the executive and judicial capital of Colombo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sri Lanka</ns0:orth>
        <ns0:pron>/sɹ/</ns0:pron>
        <ns0:pron>/sɹiˈlæŋkə/</ns0:pron>
        <ns0:pron>/sɹiˈlɑːŋkə/</ns0:pron>
        <ns0:pron>/ʃɹ/</ns0:pron>
        <ns0:pron>/ʃɹiˈlɑːŋkə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sri Lanka</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island and country in South Asia, off the coast of India. Official name: Democratic Socialist Republic of Sri Lanka. Capital: Colombo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sri Lankan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esrilanqués</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to Sri Lanka or to the Sri Lankan people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Sri Lankan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esrilanqués</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from Sri Lanka or of Sri Lankan descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Srinagar</ns0:orth>
        <ns0:pron>/sɹiˈnʌɡɚ/</ns0:pron>
        <ns0:pron>/ʃɹiˈnɑɡɚ/</ns0:pron>
        <ns0:pron>/ˈʃɹi.nəˌɡɑɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Srinagar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and district, the summer capital of Jammu and Kashmir, India. It is situated in the Kashmir valley on the banks of the river Jhelum and famous for its gardens.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>S.</ns0:quote>
          <ns0:quote>Sta.</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Abbreviation of Saint.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St George's Channel</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canal de San Jorge</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The channel connecting the Irish Sea to the north and the Atlantic Ocean to the southwest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. Elmo's fire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuego de San Telmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An electrical discharge, or corona, seen around pointed objects, caused by ionization of the atmosphere during storms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. George's Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día de San Jorge</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The saint's day of Saint George, the patron saint of England, celebrated on April 23rd.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. George's mushroom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>perro chico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An edible mushroom found in Europe, Calocybe gambosa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. John's</ns0:orth>
        <ns0:pron>/ˈseɪnt ˈd͡ʒɑnz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>San Juan</ns0:quote>
          <ns0:quote>San Juan de Terranova</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital and largest city of Newfoundland and Labrador, Canada.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. John's wort</ns0:orth>
        <ns0:pron>/seɪnt ˈd͡ʒɑnz wɝt/</ns0:pron>
        <ns0:pron>/sən(t) ˈd͡ʒɒnz wɜːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hipérico</ns0:quote>
          <ns0:quote>hierba de San Juan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several plants, of the genus Hypericum, especially Hypericum perforatum, that have yellow flowers and traditionally ward off evil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. Petersburg</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>San Petersburgo</ns0:quote>
          <ns0:quote>St. Petersburg</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city in Pinellas County, Florida, United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry><ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>St. Stephen's Day</ns0:orth>
        <ns0:pron>/sənt ˈstiːvənz deɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día de San Esteban</ns0:quote>
          <ns0:quote>Fiesta de San Esteban</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A Christian holiday commemorating Saint Stephen the protomartyr (first Christian martyr; died 34 C.E.), falling immediately after Christmas Day (on December 26 in the Western Church and on December 27 in the Eastern Orthodox Church).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stakhanovism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estajanovismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A system instituted in communist countries to encourage increased productivity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stakhanovite</ns0:orth>
        <ns0:pron>/stəˈkɑːnəvaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estajanovista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to a Stakhanovite; heroically hard-working.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stakhanovite</ns0:orth>
        <ns0:pron>/stəˈkɑːnəvaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estajanovista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) An extremely productive or hard-working worker, especially in the former USSR, who may earn special rewards; a workaholic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stalin</ns0:orth>
        <ns0:pron>/ˈstɑː.lɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Stalin</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A surname from Russian; usually referring to the Georgian revolutionary and General Secretary of the Central Committee of the CPSU Joseph Stalin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stalingrad</ns0:orth>
        <ns0:pron>/ˈstɑːlɪnɡræd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Stalingrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Former name of Volgograd: a city, the administrative center of Volgograd Oblast, Russia, and site of a famous World War II battle; used from 1925–1961.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stalinism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estalinismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Communist philosophies espoused by Soviet leader Joseph Stalin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stalinist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estalinista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or resembling the Soviet Union under the leadership of Joseph Stalin; Stalin-era.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stalinist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estalinista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who accepts the philosophy of Stalinism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Standard Model</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>modelo estándar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(particle physics) A theory about the electromagnetic, weak, and strong nuclear interactions that mediate the dynamics of the known subatomic particles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Stanislaus</ns0:orth>
        <ns0:pron>/ˈstænɪslɔːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estanislao</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A surname from the Slavic languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Star Trek</ns0:orth>
        <ns0:pron>[ˈstɑɹ trĕk]</ns0:pron>
        <ns0:pron>[ˈstɑ˞ tɹɛk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Star Trek</ns0:quote>
          <ns0:quote>Viaje a las estrellas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A popular sci-fi media franchise set in the future, primarily focusing on the adventures of the personnel of a space navy of an interstellar political federation of which Earth is a charter member.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Star Wars</ns0:orth>
        <ns0:pron>[ˈstɑɹ ˈwɔɹz]</ns0:pron>
        <ns0:pron>[ˈstɑː(ɹ) ˈwɔː(ɹ)z]</ns0:pron>
        <ns0:pron>[ˈstɑ˞ ˈwɔɹz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>La Guerra de las galaxias</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An American epic space opera franchise centered on a film series created by George Lucas in a setting where futuristic technology co-exists with a semi-sentient form of magic/religion called the Force.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iniciativa de la Defensa Estratégica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, military) The United States Strategic Defense Initiative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Star of Bethlehem</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estrella de Belén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Biblical) The bright star in the Gospel of Matthew that lead the "wise men from the East" to travel to Bethlehem.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Star of David</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estrella de David</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Judaism) A symbol of Jewish identity and Judaism, having the shape of a hexagram, the compound of two equilateral triangles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
