      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rinoceronte indio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rhinoceros of species Rhinoceros unicornis, in the family Rhinocerotidae.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian summer</ns0:orth>
        <ns0:pron>/ˈɪn.di.ən ˈsʌ.mɚ/</ns0:pron>
        <ns0:pron>/ˈɪn.dɪ.ən ˈsʌ.mə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>veranillo de San Juan</ns0:quote>
          <ns0:quote>veranillo de San Martín</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>veranillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(possibly offensive) A stretch of sunny and warm, often hazy, days during late autumn. [from late 18th c., popularized in the early 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indian sunburn</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enchilada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) The prank of grabbing a victim's forearm in both hands and twisting the skin in opposite directions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Indiana</ns0:orth>
        <ns0:pron>/ˌɪndiˈænə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
