        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) A person's finest clothing, especially the clothes one reserves to wear to church on Sunday.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
