      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Negros Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province of the Negros Island Region, Visayas, Philippines. Capital and largest city: Dumaguete.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nehemiah</ns0:orth>
        <ns0:pron>/ˌniː(h)əˈmaɪə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Nehemías</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sixteenth book of the Old Testament of the Bible, and a book of the Tanakh.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name of biblical origin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Nejapa</ns0:orth>
      </ns0:form>
