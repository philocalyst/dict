      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pangasinán</ns0:quote>
          <ns0:quote>pangasinense</ns0:quote>
          <ns0:quote>pangasinán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A language of the Malayo-Polynesian branch of the Austronesian family of languages; it is one of the major languages of the Philippines and the primary language in the province of Pangasinan, as well as northern Tarlac.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
