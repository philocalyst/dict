        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A long-acting calcium channel blocker used as an anti-hypertensive and in the treatment of angina</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
