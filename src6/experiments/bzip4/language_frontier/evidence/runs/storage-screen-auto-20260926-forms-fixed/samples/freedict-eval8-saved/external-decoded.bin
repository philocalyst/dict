      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aromatización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(petrochemistry) The conversion of aliphatic components of petroleum into aromatic compounds as part of the refining process.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
