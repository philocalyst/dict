      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fiera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A carnivorous animal that hunts for its food, especially one that preys on vertebrates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
