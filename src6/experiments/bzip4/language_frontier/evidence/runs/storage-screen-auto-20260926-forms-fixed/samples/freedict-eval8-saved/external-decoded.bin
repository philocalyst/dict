      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adamantano</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adamantine</ns0:orth>
        <ns0:pron>/ˌæd.əˈmæn.taɪn/</ns0:pron>
        <ns0:pron>/ˌæd.əˈmæn.tin/</ns0:pron>
        <ns0:pron>/ˌæd.əˈmæn.tɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adamantino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Made of adamant, or having the qualities of adamant; incapable of being broken, dissolved, or penetrated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adamantly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a machamartillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an immovable or inflexible manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adapt</ns0:orth>
        <ns0:pron>/əˈdæpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Adapted; fit; suited; suitable; apt.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adapt</ns0:orth>
        <ns0:pron>/əˈdæpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptar</ns0:quote>
          <ns0:quote>adaptarse</ns0:quote>
          <ns0:quote>ajustar</ns0:quote>
          <ns0:quote>ceñirse</ns0:quote>
          <ns0:quote>circunscribirse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make suitable; to make to correspond; to fit or suit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To fit by alteration; to modify or remodel for a different purpose; to adjust.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To make by altering or fitting something else; to produce by change of form or character.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptarse</ns0:quote>
          <ns0:quote>ceñirse</ns0:quote>
          <ns0:quote>circunscribirse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To make oneself comfortable to a new thing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adaptability</ns0:orth>
        <ns0:pron>/ədæptəˈbɪlɪti/</ns0:pron>
        <ns0:pron>/əˌdæptəˈbɪləti/</ns0:pron>
        <ns0:pron>[əˌdæp.təˈbɪl.ə.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptabilidad</ns0:quote>
          <ns0:quote>flexibilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being adaptable; a quality that renders adaptable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adaptable</ns0:orth>
        <ns0:pron>/əˈdæptəbəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptable</ns0:quote>
          <ns0:quote>acomodadizo</ns0:quote>
          <ns0:quote>acomodaticio</ns0:quote>
          <ns0:quote>amoldable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of adapting or of being adapted.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adaptation</ns0:orth>
        <ns0:pron>/əˈɖapˌʈeʃən/</ns0:pron>
        <ns0:pron>/ˌædæpˈteɪʃən/</ns0:pron>
        <ns0:pron>/ˌædəpˈteɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The process of adapting something or becoming adapted to a situation; adjustment, modification.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) A change that is made or undergone to suit a condition or environment.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, evolutionary theory) An instance of an organism undergoing change, or the structure or behavior that is changed.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable) The process of adapting an artistic work from a different medium.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, authorship) An artistic work that has been adapted from a different medium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adapter</ns0:orth>
        <ns0:pron>/əˈdæptə(ɹ)/</ns0:pron>
        <ns0:pron>/əˈdæptəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who adapts a thing, e.g. a play.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Specifically, an AC adapter: a device that reduces voltage and converts AC to DC to allow a battery-powered device to use mains power.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Specifically, a device that allows one format of plug to be used with a different format of socket.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Specifically, a device that permits two or more plugs to be used at a single electrical power point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adaptive</ns0:orth>
        <ns0:pron>/əˈdæp.tɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, characterized by or showing adaptation; making or made fit or suitable.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(psychology) Of a trait: that helps an individual to function well in society.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of being adapted or of adapting; susceptible of or undergoing accordant change.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adaptogen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adaptógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(alternative medicine) Any natural herbal substance, such as ginseng, that is purported to assist the body to adapt to stress, and to exert a normalizing effect upon body functions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adblocker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bloqueador de anuncios</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet) A piece of software that removes advertising elements from a web page.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>add</ns0:orth>
        <ns0:pron>/æd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>añadir</ns0:quote>
          <ns0:quote>allegar</ns0:quote>
          <ns0:quote>apostillar</ns0:quote>
          <ns0:quote>añidir</ns0:quote>
          <ns0:quote>poner</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To join or unite (e.g. one thing to another, or as several particulars) so as to increase the number, augment the quantity, or enlarge the magnitude, or so as to form into one aggregate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>añadir</ns0:quote>
          <ns0:quote>allegar</ns0:quote>
          <ns0:quote>añidir</ns0:quote>
          <ns0:quote>poner</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To intensify; to augment; to increase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sumar</ns0:quote>
          <ns0:quote>adicionar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, mathematics) To perform the arithmetical operation of addition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>add fuel to the fire</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>echar leña al fuego</ns0:quote>
          <ns0:quote>añadir lumbre al fuego</ns0:quote>
          <ns0:quote>dar pábulo</ns0:quote>
          <ns0:quote>echar gasolina al fuego</ns0:quote>
          <ns0:quote>ya escampa y llovían guijarros</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To worsen a conflict between people; to inflame an already tense situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>add insult to injury</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>echar leña al fuego</ns0:quote>
          <ns0:quote>para añadir insulto a la injuria</ns0:quote>
          <ns0:quote>para añidir afrenta a la lesión</ns0:quote>
          <ns0:quote>para colmo de males</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To further a loss with mockery or indignity; to worsen an already unfavorable situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>add-on</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>extensión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computer hardware, software) A software extension or hardware peripheral that provides additional functions or customization for a core application or system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addedly</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>también</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In addition; additionally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addend</ns0:orth>
        <ns0:pron>/ˈæd.ɛnd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sumando</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) Addendum, any one of two or more numbers or other terms that are to be added together.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addendum</ns0:orth>
        <ns0:pron>/əˈden.dəm/</ns0:pron>
        <ns0:pron>/əˈdɛn.dəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something to be added; especially text added as an appendix or supplement to a document.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adder</ns0:orth>
        <ns0:pron>/ˈædɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sumador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who or something which performs arithmetic addition; a machine for adding numbers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>culebra</ns0:quote>
          <ns0:quote>serpiente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hog-nosed snake, of genus Heterodon of harmless colubrid snakes found in North America</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>víbora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A common European adder (Vipera berus).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A northern copperhead (Agkistrodon contortrix mokasen), a venomous viper found in the eastern United States</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addict</ns0:orth>
        <ns0:pron>/əˈdɪkt/</ns0:pron>
        <ns0:pron>/ˈæd.ɪkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adicto</ns0:quote>
          <ns0:quote>viciado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is addicted, especially to a harmful drug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addict</ns0:orth>
        <ns0:pron>/əˈdɪkt/</ns0:pron>
        <ns0:pron>/ˈæd.ɪkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>viciar</ns0:quote>
          <ns0:quote>causar adicción en</ns0:quote>
          <ns0:quote>viciarse</ns0:quote>
          <ns0:quote>volver adicto</ns0:quote>
          <ns0:quote>volverse adicto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make (someone) become devoted to a given thing or activity; to cause to be addicted. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addicted</ns0:orth>
        <ns0:pron>/əˈdɪktɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adicto</ns0:quote>
          <ns0:quote>dependiente</ns0:quote>
          <ns0:quote>enganchado</ns0:quote>
          <ns0:quote>viciado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a biochemical addiction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addiction</ns0:orth>
        <ns0:pron>/əˈdɪkˌʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adicción</ns0:quote>
          <ns0:quote>dependencia</ns0:quote>
          <ns0:quote>vicio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being addicted; devotion; inclination.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adicción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A habit or practice that damages, jeopardizes or shortens one's life but when ceased causes trauma.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addictive</ns0:orth>
        <ns0:pron>/əˈdɪktɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adictivo</ns0:quote>
          <ns0:quote>enviciador</ns0:quote>
          <ns0:quote>que crea adicción</ns0:quote>
          <ns0:quote>que crea dependencia</ns0:quote>
          <ns0:quote>que produce dependencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing or tending to cause addiction; habit-forming.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addictively</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adictivamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an addictive manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addition</ns0:orth>
        <ns0:pron>/əˈdɪʃ.ən/</ns0:pron>
        <ns0:pron>[əˈdɪʃ.n̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adición</ns0:quote>
          <ns0:quote>añadido</ns0:quote>
          <ns0:quote>añadidura</ns0:quote>
          <ns0:quote>aditamento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The act of adding anything.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Anything that is added.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adición</ns0:quote>
          <ns0:quote>suma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, arithmetic) The arithmetic operation of adding.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>additional</ns0:orth>
        <ns0:pron>/əˈdɪʃənəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adicional</ns0:quote>
          <ns0:quote>de más</ns0:quote>
          <ns0:quote>extra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Supplemental or added to something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>additionally</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adicionalmente</ns0:quote>
          <ns0:quote>además</ns0:quote>
          <ns0:quote>yapado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>By way of addition; in addition to; also.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>additive</ns0:orth>
        <ns0:pron>/əɖɪˈʈɪv/</ns0:pron>
        <ns0:pron>/ˈaɖɪʈɪv/</ns0:pron>
        <ns0:pron>/ˈæd.ə.tɪv/</ns0:pron>
        <ns0:pron>/ˈæd.ɪ.tɪv/</ns0:pron>
        <ns0:pron>[ˈæɾ.ə.tɪv]</ns0:pron>
        <ns0:pron>[ˈæɾ.ə.ɾɪv]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aditivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A substance added to another substance or product to produce specific properties in the combined substance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>additive group</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grupo aditivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) Any of certain algebraic objects (ring, field or vector space, etc., whose definition includes a commutative operation called addition) regarded as a group under addition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addle</ns0:orth>
        <ns0:pron>/ˈæ.dəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>confundir</ns0:quote>
          <ns0:quote>enturbiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make or become addled; to muddle or confuse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>address</ns0:orth>
        <ns0:pron>/əˈdɹɛs/</ns0:pron>
        <ns0:pron>/ˈædɹɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dirección</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A number identifying a specific storage location in computer memory. [from 1940s]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(networking, Internet) A string of characters identifying a node or range of nodes on a network (especially the Internet), such as an e-mail address, IP address or URL. [from 1960s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dirección</ns0:quote>
          <ns0:quote>domicilio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A description of the location of a property, usually with at least a street name and number, name of a town, and now also a postal code; such a description as superscribed for direction on an envelope or letter. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>address</ns0:orth>
        <ns0:pron>/əˈdɹɛs/</ns0:pron>
        <ns0:pron>/ˈædɹɛs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abordar</ns0:quote>
          <ns0:quote>emprender</ns0:quote>
          <ns0:quote>enfrentar</ns0:quote>
          <ns0:quote>sacar a colación</ns0:quote>
          <ns0:quote>tratar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dirigir</ns0:quote>
          <ns0:quote>dirigirse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To direct speech to; to make a communication to, whether spoken or written; to apply to by words, as by a speech, petition, etc., to speak to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dirigir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To direct in writing, as a letter; to superscribe, or to direct and transmit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dirigir</ns0:quote>
          <ns0:quote>preparar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To address oneself to; to prepare oneself for; to apply oneself to; to direct one's speech, discourse or efforts to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>address book</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>directorio</ns0:quote>
          <ns0:quote>agenda de direcciones</ns0:quote>
          <ns0:quote>libreta de direcciones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small book for keeping other people's addresses and phone numbers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agenda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A computerized storage area for contact information such as e-mail addresses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>addressee</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>destinatario</ns0:quote>
          <ns0:quote>consignatario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The person or organization to which something, such as a letter or message, is addressed or sent, for whom the item is intended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adduction</ns0:orth>
        <ns0:pron>/əˈdʌk.ʃn̩/</ns0:pron>
        <ns0:pron>/ˈeɪˈdiː.dʌk.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aducción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of adducing or bringing forward.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(anatomy) The action by which the parts of the body are drawn towards its axis</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adductor</ns0:orth>
        <ns0:pron>/əˈdʌktɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aductor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A muscle which draws a limb or part of the body toward the middle line of the body, or closes extended parts of the body—opposed to abductor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adelantado</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelantado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A title bestowed by the king on certain nobles in the 15th-17th centuries, who granted them governorship of a province or charged them with conquering a foreign territory</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adelita</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A female soldier during the Mexican revolution</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adelomorphous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelomorfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Having a form that is not clearly defined, especially as applied to the principal cells in the pepsin glands of the stomach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adelphopoiesis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adelfopoiesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history, Christianity) A ceremony where males are unionised with one another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The removal of all or part of the adenoid glands by surgery.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenine</ns0:orth>
        <ns0:pron>/ˈæ.dəˌniːn/</ns0:pron>
        <ns0:pron>/ˈæ.dɪˌnɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry, genetics) A base, C5H5N5, found in certain glands and tissues, which pairs with thymine in DNA and uracil in RNA.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenitis</ns0:orth>
        <ns0:pron>/ædəˈnaɪtɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenitis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(symptom, pathology) Glandular inflammation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adeno-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adeno-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>gland</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenocarcinoma</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenocarcinoma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(oncology) Any of several forms of carcinoma that originate in glandular tissue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenohypophysial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenohipofisario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to the adenohypophysis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenohypophysis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenohipófisis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The anterior lobe of the pituitary gland, producing and secreting several peptide hormones that regulate many physiological processes including stress, growth, and reproduction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenoid</ns0:orth>
        <ns0:pron>/ˈad.ɪn.ɔɪd/</ns0:pron>
        <ns0:pron>/ˈæd.əˌnɔɪd/</ns0:pron>
        <ns0:pron>/ˈædˌnɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenoide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(symptom) an abnormally enlarged mass of lymphatic tissue at the back of the pharynx, often obstructing the nasal and ear passages and hindering speaking and breathing in young children.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenoidectomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenoidectomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) Surgical removal of the adenoids, or of adenoid growths in the nasopharynx; commonly performed along with tonsillectomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenoma</ns0:orth>
        <ns0:pron>/ædəˈnoʊmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenoma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A benign tumour of the epithelium arising from or resembling a gland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenomyosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenomiosis</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenosine</ns0:orth>
        <ns0:pron>/əˈdinəˌsin/</ns0:pron>
        <ns0:pron>/əˈdɛnə(ʊ)siːn/</ns0:pron>
        <ns0:pron>/əˈdɛnəsən/</ns0:pron>
        <ns0:pron>/əˈdɛnəˌsin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenosina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry, genetics, organic compound) A nucleoside derived from adenine and ribose, found in striated muscle tissue. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenosine triphosphate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenosín trifosfato</ns0:quote>
          <ns0:quote>trifosfato de adenosina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry, neurotransmitter) A nucleotide that is used as a source of energy in cellular reactions, in the synthesis of nucleic acids, and as a neurotransmitter recognized by purinergic receptors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenyl</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) The univalent radical derived from adenine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenylate cyclase</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenilato ciclasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) An enzyme which cyclizes adenosine triphosphate (ATP) into cyclic adenosine monophosphate (cyclic AMP, cAMP), having key regulatory roles in essentially all cells.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adenylation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adenilación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) Any reaction or process that forms an adenylate but especially such a posttranslational modification to a protein.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adept</ns0:orth>
        <ns0:pron>/ædˈɛpt/</ns0:pron>
        <ns0:pron>/əˈdɛpt/</ns0:pron>
        <ns0:pron>/ˈæd.ɛpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hábil</ns0:quote>
          <ns0:quote>experto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Well skilled; completely versed; thoroughly proficient</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adept</ns0:orth>
        <ns0:pron>/ædˈɛpt/</ns0:pron>
        <ns0:pron>/əˈdɛpt/</ns0:pron>
        <ns0:pron>/ˈæd.ɛpt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>experta</ns0:quote>
          <ns0:quote>experto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One fully skilled or well versed in anything; a proficient</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adequacy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cantidad suficiente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being sufficient, adequate or able to meet the needs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adequate</ns0:orth>
        <ns0:pron>/əɖɪˈkweʈ/</ns0:pron>
        <ns0:pron>/ˈæ.də.kɪt/</ns0:pron>
        <ns0:pron>/ˈæd.ə.kwɪt/</ns0:pron>
        <ns0:pron>/ˈæd.ɪ.kwət/</ns0:pron>
        <ns0:pron>/ˈæd.ɪˌkweɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adecuado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Equal to or fulfilling some requirement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adequately</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adecuadamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an adequate manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adermatoglyphia</ns0:orth>
        <ns0:pron>/eɪˌdɜː.mə.təʊˈɡlɪ.fɪ.ə/</ns0:pron>
        <ns0:pron>/eɪˌdɝ.mə.təˈɡlɪ.fi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adermatoglifia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The rare congenital absence of epidermal ridges (fingerprints and toeprints).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The autosomally dominant genetic disorder which causes this condition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adessive case</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caso adesivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) A noun case used to indicate adjacent location. In English, this is usually expressed by the prepositions "near", "at", or "by". Languages that use the adessive case include Finnish, Hungarian, Estonian, Lezgi and Lithuanian.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhan</ns0:orth>
        <ns0:pron>/ɑːˈðɑːn/</ns0:pron>
        <ns0:pron>/əˈðɑːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adhan</ns0:quote>
          <ns0:quote>llamada a la oración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Islam) The call to prayer, which consisted originally of simply four takbirs followed by the statement (أَشْهَدُ أَنْ) لَا إِلٰهَ إِلَّا ٱلله.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adhere</ns0:orth>
        <ns0:pron>/ædˈhɪə/</ns0:pron>
        <ns0:pron>/ædˈhɪɹ/</ns0:pron>
        <ns0:pron>/əɖˈhir/</ns0:pron>
        <ns0:pron>/əˈd̪ʱir/&lt;q:spelling pronunciation&gt;</ns0:pron>
        <ns0:pron>/əˈɖʱir/</ns0:pron>
        <ns0:pron>/ɛdˈhiə/</ns0:pron>
        <ns0:pron>/ɛdˈhiːə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adherirse</ns0:quote>
          <ns0:quote>pegarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To stick fast or cleave, as a glutinous substance does; to become joined or united.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adherir</ns0:quote>
          <ns0:quote>cumplir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, figurative) To be consistent or coherent; to be in accordance; to agree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>adherence</ns0:orth>
        <ns0:pron>/ədˈhɪə.ɹəns/</ns0:pron>
        <ns0:pron>/ədˈhɪɹ.əns/</ns0:pron>
