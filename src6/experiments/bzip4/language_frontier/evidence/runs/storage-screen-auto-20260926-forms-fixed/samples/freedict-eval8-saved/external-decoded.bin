        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rematar</ns0:quote>
          <ns0:quote>subastar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To sell at an auction; to auction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audacious</ns0:orth>
        <ns0:pron>/ɑˈdeɪʃəs/</ns0:pron>
        <ns0:pron>/ɔˈdeɪʃəs/</ns0:pron>
        <ns0:pron>/ɔːˈdeɪʃəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audaz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Showing willingness to take bold risks; recklessly daring.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>insolente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Impudent, insolent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audacity</ns0:orth>
        <ns0:pron>/ɑˈdæ.sɪ.ti/</ns0:pron>
        <ns0:pron>/ɔˈdæ.sɪ.ti/</ns0:pron>
        <ns0:pron>/ɔːˈdæ.sɪ.ti/</ns0:pron>
        <ns0:pron>[ɑˈdæ.sɪ.ɾi]</ns0:pron>
        <ns0:pron>[ɔˈdæ.sɪ.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audacia</ns0:quote>
          <ns0:quote>desfachatez</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Insolent boldness, especially when imprudent or unconventional.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audacia</ns0:quote>
          <ns0:quote>demasía</ns0:quote>
          <ns0:quote>osadía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fearlessness, intrepidity or daring, especially with confident disregard for personal safety, conventional thought, or other restrictions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audiation</ns0:orth>
        <ns0:pron>/ɔːdɪˈeɪʃən/</ns0:pron>
        <ns0:pron>/ˌɔdiˈeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audiación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The comprehension and internal realization of music by an individual in the absence of any physical sound. [from 1970s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audible</ns0:orth>
        <ns0:pron>/ˈoːdɪbəl/</ns0:pron>
        <ns0:pron>/ˈɑdɪbəl/</ns0:pron>
        <ns0:pron>/ˈɒdɪbəl/</ns0:pron>
        <ns0:pron>/ˈɔdɪbəl/</ns0:pron>
        <ns0:pron>/ˈɔːdɪbəl/</ns0:pron>
        <ns0:pron>[ˈoː.ɾɪ.bəl]</ns0:pron>
        <ns0:pron>[ˈɑ.ɾɪ.bəl]</ns0:pron>
        <ns0:pron>[ˈɒ.ɾɪ.bəl]</ns0:pron>
        <ns0:pron>[ˈɔ.ɾɪ.bəl]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audible</ns0:quote>
          <ns0:quote>oíble</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be heard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audience</ns0:orth>
        <ns0:pron>/ˈɑ.di.əns/</ns0:pron>
        <ns0:pron>/ˈɔ.di.əns/</ns0:pron>
        <ns0:pron>/ˈɔː.di.əns/</ns0:pron>
        <ns0:pron>/ˈɔːdɪəns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>público</ns0:quote>
          <ns0:quote>audiencia</ns0:quote>
          <ns0:quote>grada</ns0:quote>
          <ns0:quote>graderío</ns0:quote>
          <ns0:quote>platea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A group of people within hearing; specifically, a large gathering of people listening to or watching a performance, speech, etc. [from 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audiencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A formal meeting with a state or religious dignitary. [from 16th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A following. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>público</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The readership of a book or other written publication. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audience hall</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sala de audiencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A room in which a ruler or religious official holds audience (i.e. a formal meeting with a dignitary).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audimeter</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>audímetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(television, telecommunications) Electronic device that, installed in a sample of households, automatically records the television channel and consumption of the family or its individual members.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>audio</ns0:orth>
