      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>llamativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To catch the attention of. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
