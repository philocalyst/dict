          <ns0:quote>aspartame</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) An artificial sweetener, the methyl ester of a dipeptide formed from aspartic acid and phenylalanine, used in many processed foods and beverages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aspartate</ns0:orth>
