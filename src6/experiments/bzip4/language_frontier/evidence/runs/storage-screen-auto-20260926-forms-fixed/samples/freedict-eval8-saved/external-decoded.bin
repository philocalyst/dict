      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>interlingua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A constructed interlanguage based on Romance languages, English, German, Russian and Latin, developed by the International Auxiliary Language Association, and first published in 1951.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International Court of Justice</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Corte Internacional de Justicia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(UN) A judicial body of the United Nations, established in 1945 to decide disputes brought by nations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International Date Line</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea internacional de cambio de fecha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An imaginary line on the Earth's surface at 180° longitude, mostly through the Pacific Ocean, to the east of which the calendar date is one day earlier than to the west.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>International Day of the Girl Child</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día Internacional de la Niña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A holiday celebrated on October 11 that aims to raise awareness of the challenges and issues faced by girls around the world</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
