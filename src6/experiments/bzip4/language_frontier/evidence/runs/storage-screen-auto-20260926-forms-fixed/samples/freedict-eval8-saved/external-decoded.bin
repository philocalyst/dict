        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or related to the Ingush people.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of or related to the Ingush language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
