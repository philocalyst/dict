        <ns0:pron>/bɛəd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malo</ns0:quote>
          <ns0:quote>defectuoso</ns0:quote>
          <ns0:quote>desagradable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Bold, daring, and tough.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(semantic change, amelioration, contranymic) Good, superlative, excellent, cool.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(US) Overly promiscuous, licentious.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(originally, _, AAVE, of a woman) Very attractive; hot, sexy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malo</ns0:quote>
          <ns0:quote>defectuoso</ns0:quote>
          <ns0:quote>desagradable</ns0:quote>
          <ns0:quote>inapropiado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet slang, sarcastic) Used without a copula to mock people who oppose something without having any real understanding of it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>malo</ns0:quote>
          <ns0:quote>desagradable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly in "bad boy", "bad girl", and similar phrases) Attractive due to (one's) rebellious nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
