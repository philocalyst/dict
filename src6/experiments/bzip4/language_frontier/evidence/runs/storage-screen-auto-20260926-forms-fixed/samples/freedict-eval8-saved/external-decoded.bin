      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acostumbrado</ns0:quote>
          <ns0:quote>sólito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Familiar with something through repeated experience; adapted to existing conditions. (of a person)</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acostumbrado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Familiar through use; usual; customary. (of a thing, condition, activity, etc.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ace</ns0:orth>
        <ns0:pron>/eɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>as</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(card games) A playing card showing a single pip, typically the highest or lowest ranking card in a game.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(dice) A die face marked with a single dot, typically representing the number one.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A military aircraft pilot who is credited with shooting down many enemy aircraft, typically five or more.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ace</ns0:quote>
          <ns0:quote>as</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(tennis, volleyball) A serve won without the opponent hitting the ball.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lanzador experto</ns0:quote>
          <ns0:quote>pitcher experto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, baseball) The best pitcher on the team.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>es</ns0:quote>
          <ns0:quote>as</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, _, attributive) An expert at something; a maverick, genius; a person of supreme talent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
