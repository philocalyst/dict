      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alta Austria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A state of Austria, with its capital in Linz.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Upper Egypt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alto Egipto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Egyptology) The part of Ancient Egypt south of Memphis, so named because the Nile flows south to north.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
