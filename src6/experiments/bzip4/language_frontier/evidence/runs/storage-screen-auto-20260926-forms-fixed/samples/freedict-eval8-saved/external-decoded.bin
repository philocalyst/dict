      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arromántico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That feels little or no romantic attraction to others and/or romantic desire. [from 21st c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aromantic</ns0:orth>
        <ns0:pron>/ˌeɪ.ɹəʊˈmæn.tɪk/</ns0:pron>
        <ns0:pron>/ˌæ.ɹəʊˈmæn.tɪk/</ns0:pron>
        <ns0:pron>/ˌɛ(ə)ɹ.əʊˈmæn.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arromántica</ns0:quote>
          <ns0:quote>arromántico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who does not experience romantic attraction to others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
