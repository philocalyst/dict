    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>TEOTWAWKI</ns0:orth>
        <ns0:pron>[ti.ɑt.wɑk.i]</ns0:pron>
      </ns0:form>
