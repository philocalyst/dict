        <ns0:pron>/əˈlɚ/</ns0:pron>
        <ns0:pron>/əˈlʉːɹ/</ns0:pron>
        <ns0:pron>/əˈlʊə/</ns0:pron>
        <ns0:pron>/əˈlʊɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliciente</ns0:quote>
          <ns0:quote>atractivo</ns0:quote>
          <ns0:quote>encanto</ns0:quote>
          <ns0:quote>fascinación</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allure</ns0:orth>
        <ns0:pron>/əˈljʊə/</ns0:pron>
        <ns0:pron>/əˈluːɹ/</ns0:pron>
        <ns0:pron>/əˈlɔː/</ns0:pron>
        <ns0:pron>/əˈlɚ/</ns0:pron>
        <ns0:pron>/əˈlʉːɹ/</ns0:pron>
        <ns0:pron>/əˈlʊə/</ns0:pron>
        <ns0:pron>/əˈlʊɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atraer</ns0:quote>
          <ns0:quote>cautivar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To entice; to attract.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alluring</ns0:orth>
        <ns0:pron>/əˈlɔːɹɪŋ/</ns0:pron>
        <ns0:pron>/əˈlɝɪŋ/</ns0:pron>
        <ns0:pron>/əˈlʊəɹɪŋ/</ns0:pron>
        <ns0:pron>/əˈlʊɹɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>encantador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>having to power to allure</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allusion</ns0:orth>
        <ns0:pron>/əˈlu.ʒən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alusión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An indirect reference; a hint; a reference to something supposed to be known, but not explicitly mentioned.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allusive</ns0:orth>
        <ns0:pron>/əˈljuː.sɪv/</ns0:pron>
        <ns0:pron>/əˈluː.sɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alusivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>that contains or makes use of allusions (indirect references or hints)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alluvial</ns0:orth>
        <ns0:pron>/əˈluː.vi.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aluvial</ns0:quote>
          <ns0:quote>aluvional</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the soil deposited by a stream.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alluvial fan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abanico aluvial</ns0:quote>
          <ns0:quote>cono de deyección</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cone-shaped heap of alluvium deposited by a river.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alluvial plain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>llanura aluvial</ns0:quote>
          <ns0:quote>llanura de inundación</ns0:quote>
          <ns0:quote>vega</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) A plain formed by the deposition of sediment from the periodic flooding of a river.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alluvium</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aluvión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>soil, clay, silt or gravel deposited by flowing water, as it slows, in a river bed, delta, estuary or flood plain</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ally</ns0:orth>
        <ns0:pron>/əˈlaɪ/</ns0:pron>
        <ns0:pron>/ˈæl.aɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliado</ns0:quote>
          <ns0:quote>aliada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person, group, state, etc., which is associated or united by treaty with another for a common (especially military or political) purpose; a confederate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ally</ns0:orth>
        <ns0:pron>/əˈlaɪ/</ns0:pron>
        <ns0:pron>/ˈæl.aɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alianzar</ns0:quote>
          <ns0:quote>aliar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Chiefly followed by to or with: to connect or form a relation to (someone or something) by similarity in features or nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alianzarse</ns0:quote>
          <ns0:quote>aliarse</ns0:quote>
          <ns0:quote>coaligarse</ns0:quote>
          <ns0:quote>coligarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(reflexive) To join or unite (oneself or itself) against, with, etc., someone or something else.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aliar</ns0:quote>
          <ns0:quote>alianzar</ns0:quote>
          <ns0:quote>unir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To unite or form a connection between (people or things), as between families by marriage, or between states by confederacy, league, or treaty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alianzarse</ns0:quote>
          <ns0:quote>aliarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) Chiefly followed by with: to enter into an alliance or unite for a common aim.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allyl</ns0:orth>
        <ns0:pron>/ˈælaɪl/</ns0:pron>
        <ns0:pron>/ˈælɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry, especially in combination) The univalent radical, CH2=CH-CH2-, existing especially in oils of garlic and mustard.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allyl alcohol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohol alílico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>allylic</ns0:orth>
        <ns0:pron>/əˈlɪlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alílico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Containing an allyl group, an alkene hydrocarbon group with the formula H2C=CH-CH2-</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>alma mater</ns0:orth>
        <ns0:pron>/ˌælmə ˈmeɪtə(ɹ)/</ns0:pron>
        <ns0:pron>/ˌælmə ˈmɑːtə(ɹ)/</ns0:pron>
        <ns0:pron>/ˌɑːlmə ˈmɑːtə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alma mater</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A school, college, or university which a person has graduated from or attended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>almagra</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almagra</ns0:quote>
          <ns0:quote>almagre</ns0:quote>
          <ns0:quote>almazarrón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>ruddle (red ochre found in Spain)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>almanac</ns0:orth>
        <ns0:pron>[ˈæl-]</ns0:pron>
        <ns0:pron>[ˈɑl.mə.næk]</ns0:pron>
        <ns0:pron>[ˈɒl-]</ns0:pron>
        <ns0:pron>[ˈɔl.mə.næk]</ns0:pron>
        <ns0:pron>[ˈɔːl.mə.næk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almanaque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy, navigation) A book or table listing nautical, astronomical, astrological or other events for the year; sometimes, but not essentially, containing historical and statistical information.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
