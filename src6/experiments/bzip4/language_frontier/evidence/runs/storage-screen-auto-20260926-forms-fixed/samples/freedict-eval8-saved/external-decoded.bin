        <ns0:pron>/ˈbɛltʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eructar</ns0:quote>
          <ns0:quote>regoldar</ns0:quote>
        </ns0:cit>
