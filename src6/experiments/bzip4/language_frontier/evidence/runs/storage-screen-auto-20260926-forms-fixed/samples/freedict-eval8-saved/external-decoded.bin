        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chucoto</ns0:quote>
          <ns0:quote>chucota</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person belonging to the Chukchi nation native to the Chukotka peninsula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Chukchi</ns0:orth>
        <ns0:pron>/ˈt͡ʃukt͡ʃiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chucoto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A Paleosiberian language spoken by Chukchi people in the easternmost extremity of Siberia, mainly in Chukotka Autonomous Okrug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
