        <ns0:pron>/ˈwɪndəʊz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Windows</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(operating systems, trademark) Microsoft Windows, an operating system with a WIMP graphical user interface that dominates the personal computer market.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Windy City</ns0:orth>
      </ns0:form>
