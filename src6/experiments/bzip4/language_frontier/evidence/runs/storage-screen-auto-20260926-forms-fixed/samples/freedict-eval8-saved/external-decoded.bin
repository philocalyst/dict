          <ns0:quote>dormido</ns0:quote>
          <ns0:quote>jato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a state of sleep; also, broadly, resting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dormido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) Inattentive.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of a body part) Having a numb or prickling sensation accompanied by a degree of unresponsiveness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
