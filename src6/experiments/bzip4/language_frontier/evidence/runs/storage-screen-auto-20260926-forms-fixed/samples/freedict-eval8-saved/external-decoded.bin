        <ns0:pron>/ˈɔ.bɚn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>castaño</ns0:quote>
          <ns0:quote>castaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dark reddish-brown colour, often used to describe hair colour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auction</ns0:orth>
        <ns0:pron>/ˈɑkʃən/</ns0:pron>
        <ns0:pron>/ˈɔkʃən/</ns0:pron>
        <ns0:pron>/ˈɔːkʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>subasta</ns0:quote>
          <ns0:quote>almoneda</ns0:quote>
          <ns0:quote>licitación</ns0:quote>
          <ns0:quote>remate</ns0:quote>
          <ns0:quote>aucción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A public event where goods or property are sold to the highest bidder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auction</ns0:orth>
        <ns0:pron>/ˈɑkʃən/</ns0:pron>
        <ns0:pron>/ˈɔkʃən/</ns0:pron>
        <ns0:pron>/ˈɔːkʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
