      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Monte Everest</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mountain in the Himalayas, on the border of Solukhumbu district, Koshi, Nepal and Tingri County, Shigatse, Tibet Autonomous Region, China; the world's highest mountain above sea level. [from 1856]</ns0:def>
        </ns0:sense>
      </ns0:sense>
