          <ns0:quote>arqui-</ns0:quote>
          <ns0:quote>arzo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archiepiscopal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arzobispal</ns0:quote>
          <ns0:quote>arquiepiscopal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to an archbishop or an archbishopric.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archimandrite</ns0:orth>
