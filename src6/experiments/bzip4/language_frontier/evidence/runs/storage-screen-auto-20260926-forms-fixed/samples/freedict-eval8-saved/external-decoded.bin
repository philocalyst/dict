        <ns0:pron>/æ.səˈɹəʊ.lə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acerola</ns0:quote>
          <ns0:quote>semeruco</ns0:quote>
          <ns0:quote>cerecita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
