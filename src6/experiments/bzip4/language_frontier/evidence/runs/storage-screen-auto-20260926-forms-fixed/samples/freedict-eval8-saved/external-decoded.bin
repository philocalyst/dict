          <ns0:quote>perdiguero alemán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A hunting dog of a breed developed in Germany around 1890, having a sturdy build and a brown coat with occasional white markings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
