      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lusitania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient Roman province, roughly corresponding to modern Portugal.</ns0:def>
        </ns0:sense>
