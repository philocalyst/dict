        </ns0:cit>
        <ns0:sense>
          <ns0:def>An affirmative vote; one who votes in the affirmative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
