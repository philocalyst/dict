        <ns0:pron>/əˈsaɪ.iː/</ns0:pron>
        <ns0:pron>/ˌæ.saɪˈiː/</ns0:pron>
        <ns0:pron>/ˌæs.aɪˈi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asaí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several South American palms, of the genus Euterpe, having a dark purple drupe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asaí</ns0:quote>
          <ns0:quote>azaí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>acai berry, the fruit of these trees, harvested for its juice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acalycine</ns0:orth>
        <ns0:pron>/ˌeɪˈkeɪ.lə.saɪn/</ns0:pron>
        <ns0:pron>/ˌeɪˈkæ.lə.saɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acalicino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Without a calyx, or outer floral envelope.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
