        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>azol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any of a class of five-membered unsaturated heterocycles having three carbon atoms, one nitrogen atom and two double bonds</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
