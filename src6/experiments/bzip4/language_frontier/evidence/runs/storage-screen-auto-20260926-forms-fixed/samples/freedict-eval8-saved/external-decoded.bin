        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asignación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of assigning; the allocation of a job or a set of tasks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
