      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inundado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Washed by the waves or tide (of a rock or strip of shore, or of an anchor, etc., when flush with the surface of the water, so that the waves break over it); covered with water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
