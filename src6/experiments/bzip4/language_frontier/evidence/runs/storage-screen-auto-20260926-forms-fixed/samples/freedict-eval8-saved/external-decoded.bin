          <ns0:quote>Pastunistán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The geographic region historically inhabited by the indigenous Pashtun people of modern-day Afghanistan and Pakistan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
