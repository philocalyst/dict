        <ns0:pron>/ˌɛmpjʊˈtæɪʃən/</ns0:pron>
        <ns0:pron>[ˌɛəmpjʊˈteɪʃən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amputación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>surgical removal of all or part of a limb, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amputee</ns0:orth>
        <ns0:pron>/ampjʊˈtiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amputado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who has had one or more limbs removed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amulet</ns0:orth>
        <ns0:pron>/ˈæm.jə.lɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amuleto</ns0:quote>
          <ns0:quote>talismán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A religious article, protective charm, or ornament, usually bearing cultural or magical symbols, worn for protection against ill will, negative influences, or evil spirits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amurca</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alpechín</ns0:quote>
          <ns0:quote>amurca</ns0:quote>
          <ns0:quote>jámila</ns0:quote>
          <ns0:quote>morga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The sediment in olive oil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amuse</ns0:orth>
        <ns0:pron>/əˈmjuːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>entretener</ns0:quote>
          <ns0:quote>distraer</ns0:quote>
          <ns0:quote>embebecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To entertain or occupy (someone or something) in a pleasant manner; to stir (someone) with pleasing emotions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>divertir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause laughter or amusement; to be funny.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amusement</ns0:orth>
        <ns0:pron>/əˈmjuzmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>divertimento</ns0:quote>
          <ns0:quote>divertimiento</ns0:quote>
          <ns0:quote>embebecimiento</ns0:quote>
          <ns0:quote>esparcimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Entertainment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>diversión</ns0:quote>
          <ns0:quote>divertimento</ns0:quote>
          <ns0:quote>divertimiento</ns0:quote>
          <ns0:quote>embebecimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An activity that is entertaining or amusing, such as dancing, gunning, or fishing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amusement arcade</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcade</ns0:quote>
          <ns0:quote>sala de juegos</ns0:quote>
          <ns0:quote>salón de maquinitas</ns0:quote>
          <ns0:quote>salón de máquinas lúdicas</ns0:quote>
          <ns0:quote>salón recreativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A leisure establishment, freely open to the public, containing a variety of coin-operated devices, some of which are for amusement only, while others may offer the possibility of winning small prizes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amusement park</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>parque de atracciones</ns0:quote>
          <ns0:quote>parque de diversiones</ns0:quote>
          <ns0:quote>parque de entretención</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A commercially-operated collection of rides, games and other entertainment attractions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amusement ride</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracción</ns0:quote>
          <ns0:quote>atracción de feria</ns0:quote>
          <ns0:quote>atracción mecánica</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amusing</ns0:orth>
        <ns0:pron>/əˈmjuːzɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>divertido</ns0:quote>
          <ns0:quote>entretenido</ns0:quote>
          <ns0:quote>ameno</ns0:quote>
          <ns0:quote>desopilante</ns0:quote>
          <ns0:quote>divirtiente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Entertaining.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gracioso</ns0:quote>
          <ns0:quote>desopilante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Funny, hilarious.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amygdala</ns0:orth>
        <ns0:pron>/əˈmɪɡ.də.lə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amígdala</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neuroanatomy) Each one of the two regions of the brain, located as a pair in the medial temporal lobe, believed to play a key role in processing emotions, such as fear and pleasure, in both animals and humans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amygdalin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amigdalina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A glycoside of benzaldehyde and hydrogen cyanide found in bitter almonds, and in the kernels of some other fruit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyl</ns0:orth>
        <ns0:pron>/ˈæ.mɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amílico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to starch</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyl</ns0:orth>
        <ns0:pron>/ˈæ.mɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated, organic compound) Synonym of pentyl.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyl alcohol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alcohol amílico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Any of the isomers of pentanol, C5H11OH; the principal constituent of fusel oil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amylase</ns0:orth>
        <ns0:pron>/ˈæmɪleɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amilasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(enzyme) Any of a class of digestive enzymes, present in saliva and also contributed to the gut by the exocrine pancreas, that break down complex carbohydrates such as starch into simpler sugars such as glucose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyloid</ns0:orth>
        <ns0:pron>/ˈæmɪlɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amiloideo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Containing or resembling starch.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mycology) Applied to a mushroom that turns blue-black upon application of Melzer's reagent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyloid</ns0:orth>
        <ns0:pron>/ˈæmɪlɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amiloide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A waxy compound of protein and polysaccharides that is found deposited in tissues in amyloidosis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyloidosis</ns0:orth>
        <ns0:pron>/æmɪlɔɪˈdəʊsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amiloidosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Any of a group of disorders in which the fibrous protein amyloid is deposited in an organ of the body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amylopectin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amilopectina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carbohydrate) A highly branched, insoluble form of starch (the soluble form being amylose)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyloplast</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amiloplasto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A specialized leucoplast responsible for the storage of amylopectin through the polymerization of glucose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amylose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amilosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carbohydrate) The soluble form of starch (the insoluble form being amylopectin) that is a linear polymer of glucose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyotrophic lateral sclerosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esclerosis lateral amiotrófica</ns0:quote>
          <ns0:quote>ELA</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neurology, pathology) A chronic, progressive disease characterized by degeneration of the central nervous system and the loss of voluntary muscle control.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>amyotrophy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amiotrofia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) atrophy of muscles</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>an</ns0:orth>
        <ns0:pron>/ən/</ns0:pron>
        <ns0:pron>/ˈæn/</ns0:pron>
        <ns0:pron>[ˈan]</ns0:pron>
        <ns0:pron>[ˈeən]</ns0:pron>
        <ns0:pron>[ˈæ(ː)n]</ns0:pron>
        <ns0:pron>[ˈæn]</ns0:pron>
        <ns0:pron>[ˈɛən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>article</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un</ns0:quote>
          <ns0:quote>una</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(all article senses).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>an apple a day keeps the doctor away</ns0:orth>
        <ns0:pron>/əˈn‿æpəl‿ə ˈdeɪ ˈkips ðə ˈdɑktɚ əˈweɪ/</ns0:pron>
        <ns0:pron>/əˈn‿æpəl‿ə ˈdeɪ ˈkiːps ðə ˈdɒktəɹ‿əˈweɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>una manzana al día mantiene al médico en la lejanía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Apples are healthy and stave off illnesses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>an arm and a leg</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ojo de la cara</ns0:quote>
          <ns0:quote>riñón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, hyperbole) Usually used after the verb cost, but also often charge, pay, and spend: a very high price for an item or service; an exorbitant price</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>an eye for an eye, a tooth for a tooth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ojo por ojo, diente por diente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) compensation for injury caused by a person, in the form of inflicting of an identical injury on that person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabasine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anabasina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pyridine alkaloid similar to nicotine, found in Nicotiana glauca (tree tobacco), a close relative of the common tobacco plant, formerly used as an insecticide.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabasis</ns0:orth>
        <ns0:pron>/əˈnæbəsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anábasis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A military march up-country, especially that of Cyrus the Younger into Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabiosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anabiosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A state of suspended animation, especially during extreme drought; the act of recovering from this state.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabolic</ns0:orth>
        <ns0:pron>/ˌænəˈbɑlɪk/</ns0:pron>
        <ns0:pron>/ˌænəˈbɒlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anabólico</ns0:quote>
          <ns0:quote>anabolizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to anabolism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabolic</ns0:orth>
        <ns0:pron>/ˌænəˈbɑlɪk/</ns0:pron>
        <ns0:pron>/ˌænəˈbɒlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anabólico</ns0:quote>
          <ns0:quote>anabolizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An anabolic steroid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabolic steroid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esteroide anabolizante</ns0:quote>
          <ns0:quote>esteroide anabólico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(steroid hormone) A class of steroid hormones that promote growth of tissue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anabolism</ns0:orth>
        <ns0:pron>/əˈnæ.bəˌlɪ.zəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anabolismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The constructive metabolism of the body, as distinguished from catabolism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anachronism</ns0:orth>
        <ns0:pron>/əˈnæ.kɹə.nɪ.z(ə)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacronismo</ns0:quote>
          <ns0:quote>anacronía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A chronological mistake; the erroneous dating of an event, circumstance, or object. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A person or thing which seems to belong to a different time or period of time. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anachronistic</ns0:orth>
        <ns0:pron>/əˌnæk.ɹəˈnɪs.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacrónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Erroneous in date; containing an anachronism; in a wrong time; not applicable to or not appropriate for the time.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of a person) Having opinions from the past; preferring things or values of the past; behind the times; overly conservative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anachronistically</ns0:orth>
        <ns0:pron>/əˌnækɹəˈnɪstɪkli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacrónicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an anachronistic manner; in the manner of an anachronism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anacoluthon</ns0:orth>
        <ns0:pron>/ænəkəˈluːθɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacoluto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) Intentional use of such a structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaconda</ns0:orth>
        <ns0:pron>/ˌænəˈkɒndə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anaconda</ns0:quote>
          <ns0:quote>yacumama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Any large nonvenomous snake of the genus Eunectes, found mainly in northern South America. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anacreontic</ns0:orth>
        <ns0:pron>/əˌnakɹɪˈɒntɪk/</ns0:pron>
        <ns0:pron>/əˌnækɹiˈɑntɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacreóntico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(prosody) Pertaining to the style of the Greek poet Anacreon, who wrote of wine and love; (specifically) designating a metre based on an anaclastic ionic dimeter. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anacreontic</ns0:orth>
        <ns0:pron>/əˌnakɹɪˈɒntɪk/</ns0:pron>
        <ns0:pron>/əˌnækɹiˈɑntɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacreóntica</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anacrusis</ns0:orth>
        <ns0:pron>/anəˈkɹuːsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacrusa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(prosody) An unstressed syllable at the start of a verse.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) An unstressed note or notes before the first strong beat (or downbeat) of a phrase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anacusis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacusia</ns0:quote>
          <ns0:quote>cofosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Total deafness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anadiplosis</ns0:orth>
        <ns0:pron>/ˌænədəˈploʊsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anadiplosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figure of speech) A figure of speech in which a word or phrase used at the end of a clause or expression is repeated near the beginning of the next clause or expression.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anadromous</ns0:orth>
        <ns0:pron>/əˈnad.ɹə.məs/</ns0:pron>
        <ns0:pron>/əˈnæd.ɹə.məs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anádromo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a migratory fish) That lives in the sea and breeds in fresh water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaerobic</ns0:orth>
        <ns0:pron>/ˌænəˈɹoʊbɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anaeróbico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Without oxygen; especially of an environment or organism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaglyph</ns0:orth>
        <ns0:pron>/ˈæn.əˌɡlɪf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anaglifo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A matched pair of images designed to produce a three-dimensional effect when viewed using spectacles that have usually one red and one bluish-green lens, corresponding to the colors of the pairs of images.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaglyphic</ns0:orth>
        <ns0:pron>/ˌæn.əˈɡlɪf.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anaglífico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to anaglyphs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anagogic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anagógico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or employing an anagoge</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anagram</ns0:orth>
        <ns0:pron>/ˈæ.nə.ɡɹæm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anagrama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of words) A word or phrase that is created by rearranging the letters of another word or phrase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anal</ns0:orth>
        <ns0:pron>/ˈeɪ.nəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Of, related to, intended for or involving the anus. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(psychoanalysis) Of the stage in psychosexual development when the child's interest is alleged to be concentrated on the anal region. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fastidioso</ns0:quote>
          <ns0:quote>meticuloso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology, also vulgar informal) Of a person, compulsive and stubborn, obsessed with neatness and accuracy (usually in an egosyntonic way), supposedly from not having progressed beyond the anal stage. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anal beads</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuentas anales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sex toy consisting of several small balls attached together in series which are one by one inserted into and removed from the rectum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anal fin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aleta anal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ichthyology) A fin located on the underside of a fish behind the anus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anal fissure</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fisura anal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) A break or tear in the skin of the anal canal, resulting in bleeding and occasionally pain on defecation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anal sex</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sexo anal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sexual activity involving stimulation of a sexual partner's anus or rectum, especially by penetration with a penis or other object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analepsis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analepsis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of flashback in which earlier parts of a narrative are related to others that have already been narrated</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analgesia</ns0:orth>
        <ns0:pron>/ˌæn.əlˈd͡ʒiː.zi.ə/</ns0:pron>
        <ns0:pron>/ˌæn.əlˈd͡ʒiː.ʒi.ə/</ns0:pron>
        <ns0:pron>/ˌæn.əlˈd͡ʒiː.ʒə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analgesia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A process of temporarily reducing the ability to feel pain; the provision of this service.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analgesic</ns0:orth>
        <ns0:pron>/ˌæn.l̩ˈd͡ʒiː.sɪk/</ns0:pron>
        <ns0:pron>/ˌæn.l̩ˈd͡ʒiː.zɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analgésico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Of or relating to analgesia; anodyne.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analgesic</ns0:orth>
        <ns0:pron>/ˌæn.l̩ˈd͡ʒiː.sɪk/</ns0:pron>
        <ns0:pron>/ˌæn.l̩ˈd͡ʒiː.zɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analgésico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmacology) Any medicine, such as aspirin, that reduces pain, especially without inducing a loss of other sensation. (Contrast anesthetic.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anally</ns0:orth>
        <ns0:pron>/ˈeɪnəli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Involving the anus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analog</ns0:orth>
        <ns0:pron>/ənəˈlɔɡ/</ns0:pron>
        <ns0:pron>/ˈa.nə.lɔɡ/</ns0:pron>
        <ns0:pron>/ˈæn.ə.lɒɡ/</ns0:pron>
        <ns0:pron>/ˈæn.ə.lɔɡ/</ns0:pron>
        <ns0:pron>/ˈæn.əˌlɑɡ/</ns0:pron>
        <ns0:pron>/ˈæn.əˌlɔɡ/</ns0:pron>
        <ns0:pron>[ˈɛən.əˌlɑɡ]</ns0:pron>
        <ns0:pron>[ˈɛən.əˌlɔɡ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analógico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a device or system) In which the value of a data item (such as time) is represented by a continuous(ly) variable physical quantity that can be measured (such as the shadow of a sundial).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analog</ns0:orth>
        <ns0:pron>/ənəˈlɔɡ/</ns0:pron>
        <ns0:pron>/ˈa.nə.lɔɡ/</ns0:pron>
        <ns0:pron>/ˈæn.ə.lɒɡ/</ns0:pron>
        <ns0:pron>/ˈæn.ə.lɔɡ/</ns0:pron>
        <ns0:pron>/ˈæn.əˌlɑɡ/</ns0:pron>
        <ns0:pron>/ˈæn.əˌlɔɡ/</ns0:pron>
        <ns0:pron>[ˈɛən.əˌlɑɡ]</ns0:pron>
        <ns0:pron>[ˈɛən.əˌlɔɡ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análogo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) A structural derivative of a parent compound that differs from it by only one or a few atoms or substituent groups; (usually, especially) such a molecule that retains most of the same chemical properties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analog clock</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reloj analógico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(retronym) A clock that displays the time using hands that move mechanically around its face.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analogical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analógico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, based on, or composed of an analogy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analogically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análogamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an analogical manner; in the manner of an analogy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analogous</ns0:orth>
        <ns0:pron>/əˈnæl.ə.ɡəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análogo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having analogy, the status of an analogue; corresponding to something else; bearing some resemblance or similar proportion (often followed by "to".)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analogously</ns0:orth>
        <ns0:pron>/əˈnæl.ə.ɡəs.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análogamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an analogous manner; in a manner which evokes analogy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analogue watch</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reloj analógico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A watch (wristwatch or pocket watch) whose watch face displays time by means of a dial and hands (a traditional clock face).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analogy</ns0:orth>
        <ns0:pron>/əˈnæləd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analogía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A relationship of resemblance or equivalence between two situations, people, or objects, especially when used as a basis for explanation or extrapolation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analphabet</ns0:orth>
        <ns0:pron>/ænˈælfəbɛt/</ns0:pron>
        <ns0:pron>/ˌæˈnælfəbɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analfabeto</ns0:quote>
          <ns0:quote>analfabeta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who does not know the letters of the alphabet; a partly or wholly illiterate person. [from mid 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analysis</ns0:orth>
        <ns0:pron>/æˈnɑ.lə.sɪs/</ns0:pron>
        <ns0:pron>/əˈnæl.ə.sɪs/</ns0:pron>
        <ns0:pron>/əˈnæl.ɪ.sɪs/</ns0:pron>
        <ns0:pron>/əˈnɛl.ə.səs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>análisis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) Decomposition into components in order to study (a complex thing, concept, theory, etc.).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) The result of such a process.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(uncountable, mathematics) A broad field of study in modern mathematics (often mentioned alongside algebra) which developed out of the calculus, concerned with the behavior of functions, sequences, series, limits, metric spaces, measures and more.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, logic) Proof by deduction from known truths.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable, analytical chemistry, physical chemistry) The process of breaking down a substance into its constituent parts, or the result of this process.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analyst</ns0:orth>
        <ns0:pron>/ˈænəlɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who analyzes.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A mathematician who studies real analysis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A financial analyst; a business analyst.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>psicoanalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychiatry) A practitioner of psychoanalysis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytic</ns0:orth>
        <ns0:pron>/əˈnalɪʈɪk/</ns0:pron>
        <ns0:pron>/ˌænəˈlɪtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analítico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to any form of analysis, or to analytics.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Of, or relating to division into elements or principles.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytic geometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>geometría analítica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The subbranch of geometry that investigates geometrical figures via the mathematical properties of their representations in a coordinate system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytic philosophy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>filosofía analítica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(philosophy) An analytical tradition focused on identifying and addressing philosophical problems through structured understanding of logical and language analysis techniques, originating in the early 20th century in Britain and Europe and later gaining prominence in the United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytical chemistry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>química analítica</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytical engine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>máquina analítica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A mechanical general-purpose computer, designed by Charles Babbage but never built.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytically</ns0:orth>
        <ns0:pron>/ˌæn.əˈlɪt.ɪ.kli/</ns0:pron>
        <ns0:pron>/ˌæn.əˈlɪt.ɪ.kə.li/</ns0:pron>
        <ns0:pron>[ˌæn.əˈlɪɾ.ɪ.kli]</ns0:pron>
        <ns0:pron>[ˌɛən.əˈlɪɾ.ɪ.kli]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analíticamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an analytical manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analytics</ns0:orth>
        <ns0:pron>/ənəˈlɪʈɪks/</ns0:pron>
        <ns0:pron>/əˈnalɪʈɪks/</ns0:pron>
        <ns0:pron>/ˈanəlɪʈɪks/</ns0:pron>
        <ns0:pron>/ˌæn.əˈlɪt.ɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analítica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Discovery, interpretation, and communication of meaningful patterns in data.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>analyze</ns0:orth>
        <ns0:pron>/ənəˈlajz/</ns0:pron>
        <ns0:pron>/ˈæn.lɑez/</ns0:pron>
        <ns0:pron>/ˈæn.ə.laɪz/</ns0:pron>
        <ns0:pron>/ˈæn.ə.lɑez/</ns0:pron>
        <ns0:pron>/ˈæn.əˌlaɪz/</ns0:pron>
        <ns0:pron>/ˈɛn.ə.laɪz/</ns0:pron>
        <ns0:pron>[ˈanələi̯z]</ns0:pron>
        <ns0:pron>[ˈæ(ː)nəˌlaɪz]</ns0:pron>
        <ns0:pron>[ˈɑnələi̯z]</ns0:pron>
        <ns0:pron>[ˈɛn.ə.lɑe̯z]</ns0:pron>
        <ns0:pron>[ˈɛən.əˌlaɪz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>analizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To examine in such a manner as to ascertain the elements or nature of the thing examined; as, to analyze a fossil substance, to analyze a sentence or a word, or to analyze an action to ascertain its morality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anamnesis</ns0:orth>
        <ns0:pron>/ˌænæmˈniːsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anamnesia</ns0:quote>
          <ns0:quote>anamnesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ability to recall past events; recollection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anamorph</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anamorfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The asexual reproductive form in the life cycle of any fungus of the phyla Ascomycota and Basidiomycota.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anamorphic</ns0:orth>
        <ns0:pron>/ˌænəˈmɔɹfɪk/</ns0:pron>
        <ns0:pron>/ˌænəˈmɔːfɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anamórfico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Producing various optically distorted images.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anamorphosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anamorfosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A distorted image of an object that may be viewed correctly from a specific angle or with a specific mirror.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anapest</ns0:orth>
        <ns0:pron>/ˈæ.nə.piːst/</ns0:pron>
        <ns0:pron>/ˈæ.nə.pɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anapesto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(prosody) In quantitative meter, a metrical foot consisting of three syllables, two short, then one long.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anapestic</ns0:orth>
        <ns0:pron>/ˌæ.nəˈpiː.stɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anapéstico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of, or relating to, or composed of an anapest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphase</ns0:orth>
        <ns0:pron>/ˈænəˌfeɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anafase</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cytology) The stage of mitosis and meiosis during which the chromosomes separate, the chromatid moving to opposite poles of the cell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphora</ns0:orth>
        <ns0:pron>/ænəˈfɔɹə/</ns0:pron>
        <ns0:pron>/ənˈæfəɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anáfora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figure of speech) The repetition of a phrase at the beginning of phrases, sentences, or verses, used for emphasis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(linguistics) An expression that refers to a preceding expression.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphoresis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anaforesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The movement of electrically charged particles towards an anode.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphoric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anafórico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, or relating to, an anaphora.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphrodisia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anafrodisia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Lack of desire for sex.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphylactic shock</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>choque anafiláctico</ns0:quote>
          <ns0:quote>shock anafiláctico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A severe and rapid systemic allergic reaction to an allergen, constricting the trachea and causing generalized vasodilation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaphylaxis</ns0:orth>
        <ns0:pron>/ˌænəfɪˈlæksɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anafilaxia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Extreme sensitivity to a substance such as a foreign protein or drug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anaplasia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anaplasia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) A reversion of differentiation in cells that is characteristic of malignancy in tumours.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarchic</ns0:orth>
        <ns0:pron>/ænˈɑɹ.kɪk/</ns0:pron>
        <ns0:pron>/ænˈɑː.kɪk/</ns0:pron>
        <ns0:pron>/əˈnɑɹ.kɪk/</ns0:pron>
        <ns0:pron>/əˈnɑː.kɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anárquico</ns0:quote>
          <ns0:quote>ácrata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to, supporting, or likely to cause anarchy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarchically</ns0:orth>
        <ns0:pron>/ˌan.əˈkɪ.kəl.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anárquicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an anarchic manner; in the manner of anarchy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarchism</ns0:orth>
        <ns0:pron>/ˈanəkɪz(ə)m/</ns0:pron>
        <ns0:pron>/ˈænəɹˌkɪzəm/</ns0:pron>
        <ns0:pron>/ˈæˌnɑɹˌkɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarquismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) A political and philosophical belief that proposes the establishment of a stateless society as well as the abolition of authority and hierarchy in most or all forms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarchist</ns0:orth>
        <ns0:pron>/ˈæn.ɑɹ.kɪst/</ns0:pron>
        <ns0:pron>/ˈæn.ə.kɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarquista</ns0:quote>
          <ns0:quote>ácrata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who believes in or advocates the absence of hierarchy and authority in most forms (compare anarchism), especially one who works toward the realization of such.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarco-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Anarchy; anarchism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-capitalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcocapitalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) A political and economic philosophy that advocates the elimination of the state and other coercive institutions in favour of individual self-ownership, voluntary society, and free market.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-capitalist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcocapitalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) Of, pertaining to, or advocating anarcho-capitalism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-capitalist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcocapitalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) A proponent of anarcho-capitalism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-communist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcocomunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) Of, supporting, relating to, or advocating anarcho-communism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-communist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcocomunista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) A person who advocates anarcho-communism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-punk</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcopunk</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to a subculture with elements of punk and anarchist politics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarcho-syndicalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarcosindicalismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A branch or field of anarchism that focuses on the abolition of capitalism through the organization of revolutionary worker syndicates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarchy</ns0:orth>
        <ns0:pron>/ˈæ.nɑɹ.ki/</ns0:pron>
        <ns0:pron>/ˈæ.nə.ki/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarquía</ns0:quote>
          <ns0:quote>acracia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A chaotic and confusing absence of any form of political authority or government.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anarchy of production</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anarquía de la producción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Marxism, politics) According to Marxist theory, the chaotic and volatile nature of all commodity production based on private property, as opposed to planned economies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anastatic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anastático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to anastasis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anastomosis</ns0:orth>
        <ns0:pron>/ənæstəˈməʊsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anastomosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An interconnection between any two channels, passages or vessels.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(surgery) The surgical creation of a connecting passage between blood vessels, bowels or other channels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anastomotic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anastomótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to anastomosis</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anastrophe</ns0:orth>
        <ns0:pron>/əˈnæstɹəfi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anástrofe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rhetoric) Unusual word order, often involving an inversion of the usual pattern of the sentence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anastylosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anastilosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaeology) The reassembly of ruined monuments or other artifacts from remaining fragments in an archeologically responsible way (with use of modern materials when needed).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatase</ns0:orth>
        <ns0:pron>/ˈænəˌteɪs/&lt;ref:&lt;&lt;name:MWO&gt;&gt;&gt;</ns0:pron>
        <ns0:pron>/ˈænəˌteɪz/&lt;ref:&lt;&lt;name:MWO&gt;&gt; !!! &lt;&lt;name:Collins&gt;&gt;&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A blue or brown mineral, a form of titanium dioxide, used as a pigment. [from 1802]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anathema</ns0:orth>
        <ns0:pron>/əˈnæθəmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatema</ns0:quote>
          <ns0:quote>excomunión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecclesiastical, historical) A ban or curse pronounced with religious solemnity by ecclesiastical authority, often accompanied by excommunication; something denounced as accursed. [from early 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anathematize</ns0:orth>
        <ns0:pron>/əˈnæ.θə.mə.taɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatematizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause to be, or to declare as, an anathema or evil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatomical</ns0:orth>
        <ns0:pron>/æ.nəˈtɑ.mɪ.kəl/</ns0:pron>
        <ns0:pron>/æ.nəˈtɒ.mɪ.kəl/</ns0:pron>
        <ns0:pron>/æ.nəˈtɔ.mɪ.kəl/</ns0:pron>
        <ns0:pron>/ɐ.nɐ.tɔ.mɪk.ɐl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to anatomy or dissection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatomical snuffbox</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tabaquera anatómica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A triangular deepening on the radial, dorsal aspect of the hand, bounded by extensor pollicis longus and extensor pollicis brevis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatomically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatómicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the anatomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatomopathological</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatomopatológico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatomopathologist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatomopatóloga</ns0:quote>
          <ns0:quote>anatomopatólogo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anatomy</ns0:orth>
        <ns0:pron>/ɐ.nɐ.tɔ.mi/</ns0:pron>
        <ns0:pron>/əˈnæt.ə.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anatomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The art of studying the different parts of any organized body, to discover their situation, structure, and economy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancestor</ns0:orth>
        <ns0:pron>/ˈæn.sɛs.tə/</ns0:pron>
        <ns0:pron>/ˈæn.sɛs.tɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antepasado</ns0:quote>
          <ns0:quote>ancestro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One from whom a person is descended, whether on the father's or mother's side, at any distance of time; a progenitor; a forefather; a forebear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancestral</ns0:orth>
        <ns0:pron>/ænˈsɛs.təɹ.əl/</ns0:pron>
        <ns0:pron>/ænˈsɛs.tɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancestral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, derived from, or possessed by, an ancestor or ancestors</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancestry</ns0:orth>
        <ns0:pron>/ˈæn.sɛs.tɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abolengo</ns0:quote>
          <ns0:quote>ascendencia</ns0:quote>
          <ns0:quote>linaje</ns0:quote>
          <ns0:quote>alcurnia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Birth to a noble or high-ranking family, or to someone of honorable descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abolengo</ns0:quote>
          <ns0:quote>ancestría</ns0:quote>
          <ns0:quote>ascendencia</ns0:quote>
          <ns0:quote>prosapia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A series of ancestors; the people from whom one is descended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchor</ns0:orth>
        <ns0:pron>/ˈæŋ.kə/</ns0:pron>
        <ns0:pron>/ˈæŋ.kɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancla</ns0:quote>
          <ns0:quote>áncora</ns0:quote>
          <ns0:quote>anclote</ns0:quote>
          <ns0:quote>jierro</ns0:quote>
          <ns0:quote>rezón</ns0:quote>
          <ns0:quote>rizón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) A tool used to moor a vessel to the bottom of a sea or river to resist movement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>presentador</ns0:quote>
          <ns0:quote>ancla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(television) An anchorman or anchorwoman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchor</ns0:orth>
        <ns0:pron>/ˈæŋ.kə/</ns0:pron>
        <ns0:pron>/ˈæŋ.kɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anclar</ns0:quote>
          <ns0:quote>fondear</ns0:quote>
          <ns0:quote>ancorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To connect an object, especially a ship or a boat, to a fixed point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoyar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To provide emotional stability for a person in distress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchor point</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>punto de anclaje</ns0:quote>
          <ns0:quote>punto de ancoraje</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchorage</ns0:orth>
        <ns0:pron>/ˈæŋkəɹɪd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondeadero</ns0:quote>
          <ns0:quote>anclaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) A fee charged for anchoring.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of anchoring, or the condition of lying at anchor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchored</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fondeado</ns0:quote>
          <ns0:quote>surto</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchorite</ns0:orth>
        <ns0:pron>/ˈæŋ.kə(ˌ)ɹaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anacoreta</ns0:quote>
          <ns0:quote>eremita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who lives in isolation or seclusion, especially for religious reasons; hermit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchorwoman</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conductora</ns0:quote>
          <ns0:quote>presentadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A female anchorperson.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchoveta</ns0:orth>
        <ns0:pron>/ˌantʃəʊˈvɛtə/</ns0:pron>
        <ns0:pron>/ˌænt͡ʃoʊˈvɛtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anchoveta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An anchovy of species Engraulis ringens, from the southern Pacific.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anchovy</ns0:orth>
        <ns0:pron>/ænˈt͡ʃəʊ.vi/</ns0:pron>
        <ns0:pron>/ˈæn.t͡ʃə.vi/</ns0:pron>
        <ns0:pron>/ˈæn.t͡ʃəʊ.vi/</ns0:pron>
        <ns0:pron>/ˈænt͡ʃoʊ.vi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anchoa</ns0:quote>
          <ns0:quote>boquerón</ns0:quote>
          <ns0:quote>bocarte</ns0:quote>
          <ns0:quote>aladroque</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any small saltwater fish of the Engraulidae family, consisting of 160 species in sixteen genera, those of the genus Engraulis being widely sold as food.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancien régime</ns0:orth>
        <ns0:pron>/ɑn.sjɛn ɹeɪˈʒim/</ns0:pron>
        <ns0:pron>[ɑ̃siæ̃ ʁeʒim]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo régimen</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pejorative, political) A system of government long since supplanted by another, particularly a state of feudalism with an absolute monarchy supported by the doctrine of divine right with the explicit consent of an established church.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancient</ns0:orth>
        <ns0:pron>/ˈeɪn.t͡ʃənt/</ns0:pron>
        <ns0:pron>/ˈeɪn.ʃənt/</ns0:pron>
        <ns0:pron>/ˈeɪŋk.ʃənt/</ns0:pron>
        <ns0:pron>/ˈæn.t͡ʃənt/</ns0:pron>
        <ns0:pron>/ˈæn.ʃənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo</ns0:quote>
          <ns0:quote>milenario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having lasted from a remote period; having been of long duration; of great age, very old.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Existent or occurring in time long past, usually in remote ages; belonging to or associated with antiquity; old, as opposed to modern.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancient grain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grano ancestrale</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A grain or pseudocereal purported to be minimally changed by selective breeding over recent millennia (often used in plural and in the context of marketing)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancient history</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Antigüedad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A period of history generally seen as occurring before the Middle Ages, that is, before the fall of the Roman Empire. Includes Ancient Egypt, Ancient Greece and Ancient Rome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agua pasada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) That which happened a long time ago and not worth discussing any more.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anciently</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antaño</ns0:quote>
          <ns0:quote>antiguamente</ns0:quote>
          <ns0:quote>de antaño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the manner of very long ago. As the ancients did.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancients</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiguo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The people of classical antiquity, especially such writers and philosophers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancillary</ns0:orth>
        <ns0:pron>/ænˈsɪl.ə.ɹi/</ns0:pron>
        <ns0:pron>/ænˈsɪl.ə.ɹiː/</ns0:pron>
        <ns0:pron>/ˈæn.səˌlɛɹ.i/</ns0:pron>
        <ns0:pron>[ɛːnˈsɪl.ə.ɹi]</ns0:pron>
        <ns0:pron>[ˈɛn.səˌlɛɹ.i]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancilar</ns0:quote>
          <ns0:quote>ancilario</ns0:quote>
          <ns0:quote>auxiliar</ns0:quote>
          <ns0:quote>secundario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Subordinate; secondary; auxiliary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ancillary</ns0:orth>
        <ns0:pron>/ænˈsɪl.ə.ɹi/</ns0:pron>
        <ns0:pron>/ænˈsɪl.ə.ɹiː/</ns0:pron>
        <ns0:pron>/ˈæn.səˌlɛɹ.i/</ns0:pron>
        <ns0:pron>[ɛːnˈsɪl.ə.ɹi]</ns0:pron>
        <ns0:pron>[ˈɛn.səˌlɛɹ.i]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>accesorio</ns0:quote>
          <ns0:quote>apoyo</ns0:quote>
          <ns0:quote>auxiliar</ns0:quote>
          <ns0:quote>ayudante</ns0:quote>
          <ns0:quote>criado</ns0:quote>
          <ns0:quote>subordinada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something that serves an ancillary function, such as an easel for a painter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>auxiliar</ns0:quote>
          <ns0:quote>ayudante</ns0:quote>
          <ns0:quote>criado</ns0:quote>
          <ns0:quote>subordinada</ns0:quote>
          <ns0:quote>subordinado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) An auxiliary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anconeus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ancóneo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(muscle) A muscle of the elbow and forearm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and</ns0:orth>
        <ns0:pron>/and/</ns0:pron>
        <ns0:pron>/n̩/</ns0:pron>
        <ns0:pron>/n̩d/</ns0:pron>
        <ns0:pron>/æn/</ns0:pron>
        <ns0:pron>/ænd/</ns0:pron>
        <ns0:pron>/ænt/</ns0:pron>
        <ns0:pron>/ən/</ns0:pron>
        <ns0:pron>/ənd/</ns0:pron>
        <ns0:pron>/ɛn/</ns0:pron>
        <ns0:pron>/ɛnd/</ns0:pron>
        <ns0:pron>[and]</ns0:pron>
        <ns0:pron>[eənd]</ns0:pron>
        <ns0:pron>[æ(ː)nd]</ns0:pron>
        <ns0:pron>[ænd]</ns0:pron>
        <ns0:pron>[ɛənd]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y</ns0:quote>
          <ns0:quote>e</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, colloquial, or, literary) Used to connect more than two elements together in a chain, sometimes to stress the number of elements.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y</ns0:quote>
          <ns0:quote>e</ns0:quote>
          <ns0:quote>et</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used to connect certain numbers: connecting units when they precede tens (now dated); connecting shillings to pence in a monetary quantity (now historical); connecting tens and units to hundreds, thousands etc. (now often omitted in US); to connect fractions to wholes. [from 10th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and a partridge in a pear tree</ns0:orth>
        <ns0:pron>/ænd ə ˈpɑɹtɹɪd͡ʒ ən ə ˌpɛɚ ˈtɹi/</ns0:pron>
        <ns0:pron>/ænd ə ˈpɑːtɹɪd͡ʒ ɪn ə ˌpɛə ˈtɹiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y la abuela</ns0:quote>
          <ns0:quote>y pare usted de contar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(humorous) Used at the end of a list of items to emphasize its length. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and how</ns0:orth>
        <ns0:pron>/ˈænd ˈhaʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>¡y cómo!</ns0:quote>
          <ns0:quote>¡y tanto!</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Used to strongly confirm the preceding utterance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and so forth</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y así sucesivamente</ns0:quote>
          <ns0:quote>y cosas semejantes</ns0:quote>
          <ns0:quote>y eso</ns0:quote>
          <ns0:quote>y tal</ns0:quote>
          <ns0:quote>y todo eso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Indicates that a list continues in a similar manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and then some</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y me quedo corto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, colloquial) Used to confirm preceding utterance, while implying that what was said or asked is an understatement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and whatnot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y demás</ns0:quote>
          <ns0:quote>y tal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) And so on; et cetera</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>and/or</ns0:orth>
        <ns0:pron>/ˈændɔː(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>conjunction</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>y/o</ns0:quote>
          <ns0:quote>y/u</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Joins two alternatives to mean either or both; indicates that inclusive or is meant where or alone might be taken to mean exclusive or.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andalusite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andalucita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) An aluminium nesosilicate mineral, Al2SiO5, which can be cut into a gem and displays strong pleochroism, shifting between red, green, and yellow.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andesine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andesina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) Sodium calcium aluminum silicate, (Na_xCa_xAlSi_3O_8), a plagioclase feldspar, the third member of the albite-anorthite solid solution series. Found in fine-grained andesite lavas; crystals are rarely seen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andiron</ns0:orth>
        <ns0:pron>/ˈændaɪə(ɹ)n/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>morillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, in plural) A utensil for supporting wood when burning in a fireplace, one being placed on each side</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andragogy</ns0:orth>
        <ns0:pron>/ˈan.dɹə.ɡɒ.dʒi/</ns0:pron>
        <ns0:pron>/ˈan.dɹə.ɡɒ.ɡi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andragogía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The methods or techniques used to teach adults; adult education. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andrewsarchus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andrewsarchus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct mammal, of genus †Andrewsarchus, from the Eocene epoch.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andro-</ns0:orth>
        <ns0:pron>/ændɹoʊ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andro-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>man, male</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androcentric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androcéntrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or exhibiting androcentrism; focused on males.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androcentrism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androcentrismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ideological focus on males, and issues affecting them, possibly to the detriment of non-males.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androcide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androcidio</ns0:quote>
          <ns0:quote>hombricidio</ns0:quote>
          <ns0:quote>machicidio</ns0:quote>
          <ns0:quote>masculicidio</ns0:quote>
          <ns0:quote>masculinicidio</ns0:quote>
          <ns0:quote>varonicidio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androecium</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androceo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The set of a flower's stamens.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androgen</ns0:orth>
        <ns0:pron>/ˈændrəd͡ʒən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andrógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(steroid hormone) Any natural or synthetic compound, usually a steroid hormone, that stimulates or controls the development and maintenance of masculine characteristics in vertebrates. A male sex hormone such as testosterone or anabolic steroids.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androgenic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androgénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(steroid) Of, relating to, or being an androgen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androgenism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androgenismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The presence of androgens in the body</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androgyne</ns0:orth>
        <ns0:pron>/ˈæn.dɹə.d͡ʒaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andrógino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is androgynous. [from mid-16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androgynous</ns0:orth>
        <ns0:pron>/ænˈdɹɑd͡ʒ.ən.əs/</ns0:pron>
        <ns0:pron>/ænˈdɹɒd͡ʒ.ɪn.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andrógino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to a feature or characteristic that is not definitively of either sex.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Possessing qualities of both sexes.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computer hardware) Of a connector or docking port, able to connect to another connector or port of the same type, rather than being restricted to connecting to solely male or solely female connectors or ports.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androgyny</ns0:orth>
        <ns0:pron>/ænˈdɹɑd͡ʒəni/</ns0:pron>
        <ns0:pron>/ænˈdɹɒdʒəni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androginia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hermaphroditism.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The state of having traits of both male and female genders. [from the mid 19th century]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The state of appearing to be neither feminine nor masculine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>android</ns0:orth>
        <ns0:pron>/ˈænˌdɹɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A robot that is designed to look and act like a human being (not necessarily a male one).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andrologist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andrólogo</ns0:quote>
          <ns0:quote>andróloga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A person who studies andrology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>andrology</ns0:orth>
        <ns0:pron>/ænˈdɹɒləd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>andrología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The branch of medicine concerned with male diseases, especially those affecting the male reproductive system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androphilia</ns0:orth>
        <ns0:pron>/ˌæn.dɹoʊˈfɪ.li.ə/</ns0:pron>
        <ns0:pron>/ˌæn.dɹəʊˈfɪ.li.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androfilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A love of or sexual attraction to men or masculinity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androphobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androfobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fear of or aversion to men or boys.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>androstenedione</ns0:orth>
        <ns0:pron>/ˌan.dɹɒ.stiːnˈdʌɪ.əʊn/</ns0:pron>
        <ns0:pron>/ˌæn.dɹəˌstinˈdaɪˌoʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>androstediona</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anecdata</ns0:orth>
        <ns0:pron>/-ɾə/</ns0:pron>
        <ns0:pron>/ˈænikdætə/</ns0:pron>
        <ns0:pron>/ˈænɪkdeɪtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>evidencia anecdotal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, humorous, or, pejorative) Anecdotal evidence. [from 1980s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anecdotal</ns0:orth>
        <ns0:pron>[ˌænɪkˈdoʊ̯tɫ̩]</ns0:pron>
        <ns0:pron>[ˌænɪkˈdoʊ̯ɾɫ̩]</ns0:pron>
        <ns0:pron>[ˌænɪkˈdɐʉ̯tɫ̩]</ns0:pron>
        <ns0:pron>[ˌænɪkˈdəʉ̯tɫ̩]</ns0:pron>
        <ns0:pron>[ˌænɪkˈdəʊ̯tɫ̩]</ns0:pron>
        <ns0:pron>[ˌɛənɪkˈdoʊ̯tɫ̩]</ns0:pron>
        <ns0:pron>[ˌɛənɪkˈdoʊ̯ɾɫ̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anecdótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of the nature of or relating to an anecdote.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anecdotal evidence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pruebas anecdóticas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A limited selection of examples which support or refute an argument, but which are not supported by scientific or statistical analysis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anecdote</ns0:orth>
        <ns0:pron>/əˈnɛk.ɖoʈ/</ns0:pron>
        <ns0:pron>/ˈæn.ɪkˌdoʊt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anécdota</ns0:quote>
          <ns0:quote>chascarrillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An account which supports an argument, but which is not supported by scientific or statistical analysis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A previously untold secret account of an incident.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anechoic</ns0:orth>
        <ns0:pron>/ˌæn.ɛˈkoʊ.ɪk/</ns0:pron>
        <ns0:pron>/ˌæn.ɛˈkəʊ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anecoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(acoustics) Lacking echoes; particularly, designed to absorb sound.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemia</ns0:orth>
        <ns0:pron>/əˈnimi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anemia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling, uncountable, pathology) A medical condition in which the capacity of the blood to transport oxygen to the tissues is reduced, either because of too few red blood cells, or because of too little hemoglobin, resulting in pallor and fatigue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemic</ns0:orth>
        <ns0:pron>/əˈniː.mɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anémico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or suffering from anemia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemo-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anemo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>wind</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemometer</ns0:orth>
        <ns0:pron>/ænɪˈmɑmətɚ/</ns0:pron>
        <ns0:pron>/ænɪˈmɒmətə/</ns0:pron>
        <ns0:pron>/ænɪˈmɒmɪtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anemómetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(meteorology) An instrument for measuring and recording the speed of the wind, a windmeter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemometric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anemométrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to anemometry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemone</ns0:orth>
        <ns0:pron>/əˈmɛn.ə.mi/</ns0:pron>
        <ns0:pron>/əˈnɛm.ə.ni/</ns0:pron>
        <ns0:pron>/əˈnɛn.ə.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anémona</ns0:quote>
          <ns0:quote>anemona</ns0:quote>
          <ns0:quote>anemone</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any plant of the genus Anemone, of the Ranunculaceae (or buttercup) family, such as the windflower.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anemoscope</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anemoscopio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument that shows the direction of the wind; a wind vane or weathercock. Formerly, it used to apply to a device consisting of a vane above, connected to the inside of a building with a dial or index to show the wind direction, but today there are many varieties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anencephaly</ns0:orth>
        <ns0:pron>/ænɪnˈsɛfəlɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anencefalia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lethal birth defect in which most of the brain and parts of the skull are missing; absence of the encephalon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthesia</ns0:orth>
        <ns0:pron>/ənəˈt̪ʰeʒɪjɑ/</ns0:pron>
        <ns0:pron>/ənəˈt̪ʰiʒɪjɑ/</ns0:pron>
        <ns0:pron>/ˌæn.əsˈti.ʒə/</ns0:pron>
        <ns0:pron>/ˌæn.əsˈθi.ʒə/</ns0:pron>
        <ns0:pron>/ˌæn.əsˈθiːz.i.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestesia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, American spelling, Canadian spelling) An artificial method of preventing sensation, used to eliminate pain without causing loss of vital functions, by the administration of one or more agents which block pain impulses before transmitted to the brain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthesiologist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestesiólogo</ns0:quote>
          <ns0:quote>anestesióloga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling, Canadian spelling) A physician who specializes in anesthesiology and administers anesthesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthesiology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestesiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling, Canadian spelling) The science of administering anesthetics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthetic</ns0:orth>
        <ns0:pron>/ˌænəsˈtɛtɪk/</ns0:pron>
        <ns0:pron>/ˌænəsˈθɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestésico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing anesthesia; reducing pain sensitivity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthetic</ns0:orth>
        <ns0:pron>/ˌænəsˈtɛtɪk/</ns0:pron>
        <ns0:pron>/ˌænəsˈθɛtɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestésico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling, medicine) A substance administered to reduce the perception of pain or to induce numbness for surgery and may render the recipient unconscious.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthetist</ns0:orth>
        <ns0:pron>/əˈniːsθ.ə.tɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestesista</ns0:quote>
          <ns0:quote>anestesiador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(American spelling, Canadian spelling, medicine) One who gives an anesthetic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthetization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestesia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The administration of anesthesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anesthetize</ns0:orth>
        <ns0:pron>/æˈniːs.θə.taɪz/</ns0:pron>
        <ns0:pron>/əˈniːs.θə.taɪz/</ns0:pron>
        <ns0:pron>/əˈnɛs.θə.taɪz/</ns0:pron>
        <ns0:pron>/əˈnɛs.θɪ.taɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestesiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To administer anesthesia to: to render unfeeling or unconscious through the use of narcotic substances, usually either alcohol or pharmaceutical drugs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anestrus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anestro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology) In female placental mammals—excluding humans and great apes—a phase of the estrous cycle during which the sexual cycle rests.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anethole</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anetol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) A particular aromatic compound found in anise.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aneuploid</ns0:orth>
        <ns0:pron>/ˈænjəplɔjd/</ns0:pron>
        <ns0:pron>/ˈænjʊplɔɪ̯d/</ns0:pron>
        <ns0:pron>/ˈæ̞njyplɔjd/</ns0:pron>
        <ns0:pron>/ˈæ̞njəplɔjd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aneuploide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetics) Having a number of chromosomes that is not a multiple of the haploid number.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aneuploidy</ns0:orth>
        <ns0:pron>/ˈænjəplɔjdi/</ns0:pron>
        <ns0:pron>/ˈænjʊplɔɪ̯di/</ns0:pron>
        <ns0:pron>/ˈæ̞njyplɔjdi/</ns0:pron>
        <ns0:pron>/ˈæ̞njəplɔjdi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aneuploidía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(genetics) The condition of being aneuploid; the state of possessing a chromosome number that is not an exact multiple of the haploid number of the organism in question.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aneurysm</ns0:orth>
        <ns0:pron>/ˈan.jʊɹ.ɪz.əm/</ns0:pron>
        <ns0:pron>/ˈæn.jəɹ.ɪz.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aneurisma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) An abnormal blood-filled swelling of an artery or vein, resulting from a localized weakness in the wall of the vessel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aneurysmatic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aneurismático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Describing a blood vessel that has an aneurysm; aneurysmal</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anew</ns0:orth>
        <ns0:pron>/əˈnjuː/</ns0:pron>
        <ns0:pron>/əˈnu/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de nuevo</ns0:quote>
          <ns0:quote>nuevamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary, poetic, _, or, _, formal, especially) Again, once more; afresh, in a new way, newly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angel</ns0:orth>
        <ns0:pron>/ˈeɪn.d͡ʒəl/</ns0:pron>
        <ns0:pron>/ˈeɪn.d͡ʒɛl/</ns0:pron>
        <ns0:pron>/ˈæn.d͡ʒəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ángel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An incorporeal and holy or semidivine messenger from a deity or other divine entity, traditionally depicted as a youthful, winged figure in flowing robes.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(Abrahamic, _, religion) One of the lowest order of such beings, below virtues.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figuratively) A person having qualities traditionally attributed to angels.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Someone who is kind or selfless.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(theater) The person who funds a show.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angel hair</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cabello de ángel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A type of pasta, thinner than spaghetti or vermicelli.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angel of death</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ángel de la muerte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A personification of death in fiction, art, mythology, or religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angel shark</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angelote</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the unusual genus Squatina of sharks with flattened bodies and broad pectoral fins resembling skates or rays. There are approximately 16 known species, which are the only members of their taxonomic genus, family and order. They occur worldwide in temperate and tropical seas.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angelic</ns0:orth>
        <ns0:pron>/ænˈd͡ʒɛlɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angélico</ns0:quote>
          <ns0:quote>angelical</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Belonging to, or proceeding from, angels; resembling, characteristic of, or partaking of the nature of, an angel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angelica</ns0:orth>
        <ns0:pron>/ænˈd͡ʒɛlɪkə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angélica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tall plant, with hollow stems, genus Angelica, especially garden angelica (Angelica archangelica).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angelology</ns0:orth>
        <ns0:pron>/eɪnd͡ʒəˈlɒləd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angelología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of angels. Angels have been grouped into nine categories or “choirs,” from lowest to highest: angel, virtue, archangel, power, principality, dominion, throne, cherub, and seraph.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angels dancing on the head of a pin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el sexo de los ángeles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metaphor) The subject of arcane intellectual speculation—used as an example of a subject of enquiry in which the pursuit is of no value.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anger</ns0:orth>
        <ns0:pron>/ˈæŋɡə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæŋɡɚ/</ns0:pron>
        <ns0:pron>[ˈeɪŋɡɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ira</ns0:quote>
          <ns0:quote>enojo</ns0:quote>
          <ns0:quote>cólera</ns0:quote>
          <ns0:quote>rabia</ns0:quote>
          <ns0:quote>enfado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strong and unpleasant feeling of displeasure, hostility, or antagonism towards someone or something, usually combined with an urge to yell, say curse words, and/or physically harm or cause damage or destruction to things or attack or assault living beings, often stemming from perceived provocation, hurt, threat, insults, or unfair or unjust treatment, or a situation not going the way one had desired or planned.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anger</ns0:orth>
        <ns0:pron>/ˈæŋɡə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæŋɡɚ/</ns0:pron>
        <ns0:pron>[ˈeɪŋɡɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enojar</ns0:quote>
          <ns0:quote>enfadar</ns0:quote>
          <ns0:quote>enconar</ns0:quote>
          <ns0:quote>enviscar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To cause such a feeling of antagonism in.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>empurrarse</ns0:quote>
          <ns0:quote>enconarse</ns0:quote>
          <ns0:quote>enfadarse</ns0:quote>
          <ns0:quote>enojarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To become angry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiitis</ns0:orth>
        <ns0:pron>/ˌændʒiˈaɪtɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angitis</ns0:quote>
          <ns0:quote>vasculitis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A condition where blood or lymph vessels are inflamed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angina</ns0:orth>
        <ns0:pron>/ænˈd͡ʒaɪ.nə/</ns0:pron>
        <ns0:pron>/ˈæn.d͡ʒɪ.nə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, dated) An inflammatory infection of the throat, especially quinsy; any sore throat, with or without tooth and gum involvement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angina pectoris</ns0:orth>
        <ns0:pron>/ænˈdʒaɪnə ˈpɛktəˌɹɪs/</ns0:pron>
        <ns0:pron>/ˈændʒɪnə ˈpɛktəˌɹɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angina de pecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cardiology, disease) Intermittent crushing chest pain caused by reversible myocardial ischemia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angio-</ns0:orth>
        <ns0:pron>/ˈæn.d͡ʒi.oʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angio-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>vessel#Noun; relating to blood vessels, lymph vessels, or both.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angioedema</ns0:orth>
        <ns0:pron>/ˌænd͡ʒiəʊ.ɪˈdiːmə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angioedema</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Swelling of the lower layers of the skin, often around the mouth, or of the mucosa or submucosa of the mouth or throat, which can appear quickly in response to an allergen or due to other conditions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiofibroma</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiofibroma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A benign neoplasm that affects fibrous tissue.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiogenesis</ns0:orth>
        <ns0:pron>/andʒɪə(ʊ)ˈdʒɛnɪsɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiogénesis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine, zoology) The formation and development of new blood vessels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiogenic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiogenético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to angiogenesis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiogram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiograma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) An X-ray image of the blood vessels gained after the injection of a radiopaque contrast medium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiographic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiográfico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiography</ns0:orth>
        <ns0:pron>/ˌæn.d͡ʒiˈɑ.ɡɹə.fi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A medical imaging technique in which an X-ray image is taken to visualize the inside of blood vessels and organs of the body, with particular interest in the arteries, veins and the heart chambers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of anatomy dealing with blood vessels and lymphatics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angioma</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angioma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A benign tumor made up of small blood vessels or lymph vessels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiopathy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiopatía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Any disease of the blood vessels.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angioplasty</ns0:orth>
        <ns0:pron>/ˈæn.d͡ʒi.əʊ.plæs.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angioplastia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery) The mechanical widening of a narrowed or totally obstructed blood vessel generally caused by atheroma.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiosperm</ns0:orth>
        <ns0:pron>/ˈæn.d͡ʒi.əˌspɝm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiosperma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) Any plant of the clade Angiosperms, characterized by having ovules enclosed in an ovary; a flowering plant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiotensin</ns0:orth>
        <ns0:pron>/ænd͡ʒɪəʊˈtɛnsɪn/</ns0:pron>
        <ns0:pron>/ˌænd͡ʒɪoʊˈtɛnsɪn/</ns0:pron>
        <ns0:pron>[ˌɛənd͡ʒɪoʊˈtɛnsɪn]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiotensina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(hormone) Any of several polypeptides that narrow blood vessels and thus regulate arterial pressure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiotensin converting enzyme</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enzima convertidora de angiotensina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) An enzyme which catalyzes the creation of angiotensin, and is a strong vasoconstrictor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angiotensinogen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angiotensinógeno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) A globulin produced by the liver</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angle</ns0:orth>
        <ns0:pron>/ˈeɪŋ.ɡl̩/</ns0:pron>
        <ns0:pron>/ˈeɪŋ.ɡəl/</ns0:pron>
        <ns0:pron>/ˈæŋ.ɡəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ángulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) A figure formed by two rays which start from a common point (a plane angle) or by three planes that intersect (a solid angle).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(geometry) The measure of such a figure. In the case of a plane angle, this is the ratio (or proportional to the ratio) of the arc length to the radius of a section of a circle cut by the two rays, centered at their common point. In the case of a solid angle, this is the ratio of the surface area to the square of the radius of the section of a sphere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esquina</ns0:quote>
          <ns0:quote>rincón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A corner where two walls intersect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>punto de vista</ns0:quote>
          <ns0:quote>ángulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A viewpoint; a way of looking at something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angle</ns0:orth>
        <ns0:pron>/ˈeɪŋ.ɡl̩/</ns0:pron>
        <ns0:pron>/ˈeɪŋ.ɡəl/</ns0:pron>
        <ns0:pron>/ˈæŋ.ɡəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>buscar</ns0:quote>
          <ns0:quote>tener en la mira</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pescar con caña</ns0:quote>
          <ns0:quote>pescar con anzuelo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To try to catch fish with a hook and line.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angle bisector</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bisectriz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ray that divides an angle into two equal parts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angle bracket</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antilambda</ns0:quote>
          <ns0:quote>corchete angular</ns0:quote>
          <ns0:quote>cuña</ns0:quote>
          <ns0:quote>diple</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(terminology) Either of a pair of symbols, 〈 〉, used to enclose the name of the domain in which a concept and a term is used.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(typography, mathematics) Either of a pair of symbols, ⟨ ⟩, used to enclose text in various technical contexts, and in mathematical formulas to denote an interval, a continuous parameter or an inner product.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angle grinder</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esmeril angular</ns0:quote>
          <ns0:quote>amoladora</ns0:quote>
          <ns0:quote>amoladora angular</ns0:quote>
          <ns0:quote>radial</ns0:quote>
          <ns0:quote>rebarbadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A usually hand-held grinder which uses a pair of internal gears to place the rotational axis of the grinding or cutting wheel perpendicular to that of the driving motor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angle of incidence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ángulo de incidencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(optics, physics) The angle that a straight line, ray of light, etc., meeting a surface, makes with a normal to the surface at the point of meeting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angler</ns0:orth>
        <ns0:pron>/ˈæŋ.ɡlə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈæŋ.ɡlɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pescador</ns0:quote>
          <ns0:quote>pescadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who fishes with a hook and line.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rape común</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An angler fish, Lophius piscatorius.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ulteriorator</ns0:quote>
          <ns0:quote>ulterioratriz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who tries to work an angle; a person who schemes or has an ulterior motive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anglerfish</ns0:orth>
        <ns0:pron>/ˈæŋɡləˌfɪʃ/</ns0:pron>
        <ns0:pron>/ˈæŋɡlɚˌfɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rape</ns0:quote>
          <ns0:quote>pejesapo</ns0:quote>
          <ns0:quote>pescador con caña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any fish of the bony fish order Lophiiformes, which have an outgrowth they wiggle to lure and catch their prey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anglicisation</ns0:orth>
        <ns0:pron>/ˌæŋ.ɡlɪ.saɪˈzeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌæŋ.ɡlɪ.səˈzeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anglicización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process by which something or someone (usually a word) is made more English. Usually applied to language or culture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anglicised</ns0:orth>
        <ns0:pron>/ˈæŋ.lɪ.saɪzd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anglicanizado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Made into a form similar to that used by the English.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angling</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pesca con caña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of fishing, with a rod, line and angle (hook) for recreation or sport.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angora</ns0:orth>
        <ns0:pron>/æŋˈɡɔːɹə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conejo de Angora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rabbit belonging to the Angora rabbit breed, one of the oldest domestic breeds of rabbits in the world, raised chiefly in Europe for its silky and long hair (a subspecies of the European rabbit, Oryctolagus cuniculus).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angrily</ns0:orth>
        <ns0:pron>/ˈæŋ.ɡɹə.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con ira</ns0:quote>
          <ns0:quote>furiosamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an angry manner; under the influence of anger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angry</ns0:orth>
        <ns0:pron>/ˈæŋ.ɡɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enfadado</ns0:quote>
          <ns0:quote>enojado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Displaying or feeling anger.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inflamado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(said about a wound or a rash) Inflamed and painful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angst</ns0:orth>
        <ns0:pron>/æŋ(k)st/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nerviosismo</ns0:quote>
          <ns0:quote>pánico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A feeling of acute but vague anxiety or apprehension often accompanied by depression, especially philosophical anxiety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angstrom</ns0:orth>
        <ns0:pron>/ˈæŋstɹəm/</ns0:pron>
        <ns0:pron>/ˈæŋstɹʌm/</ns0:pron>
        <ns0:pron>/ˈɔŋstɹəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ángstrom</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, metrology) A unit of length equal to 10−10 meters (that is, one ten-billionth of a meter), approximately the size of an atom, and denoted by the symbol Å, used especially to measure the wavelength of electromagnetic radiation or distances between atoms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anguish</ns0:orth>
        <ns0:pron>/ˈæŋ.ɡwɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angustia</ns0:quote>
          <ns0:quote>congoja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Extreme pain, either of body or mind; excruciating distress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anguish</ns0:orth>
        <ns0:pron>/ˈæŋ.ɡwɪʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angustiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To suffer pain.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To cause to suffer pain.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anguished</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acongojado</ns0:quote>
          <ns0:quote>angustiado</ns0:quote>
          <ns0:quote>atribulado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Feeling anguish; experiencing extreme discomfort or discontent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angular</ns0:orth>
        <ns0:pron>/-lɑɹ/</ns0:pron>
        <ns0:pron>/ˈæŋ.ɡju.lɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>angular</ns0:quote>
          <ns0:quote>anguloso</ns0:quote>
          <ns0:quote>esquinado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having an angle or angles; forming an angle or corner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Sharp and stiff in character.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>angular momentum</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>momento angular</ns0:quote>
          <ns0:quote>momento cinético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The vector product that describes the rotary inertia of a system about an axis and is conserved in a closed system. For an isolated rigid body, it is a measure of the extent to which an object will continue to rotate in the absence of an applied torque.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhedonia</ns0:orth>
        <ns0:pron>/ˌan.hɪˈdəʊ.nɪə/</ns0:pron>
        <ns0:pron>/ˌæn.hiˈdoʊ.ni.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhedonia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(symptom, psychiatry) The inability to feel pleasure from activities usually found enjoyable, such as exercise, hobbies, music, sexual activities or social interactions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhelation</ns0:orth>
        <ns0:pron>/ænhɪˈleɪʃn̩/</ns0:pron>
        <ns0:pron>/ˌænhəˈleɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhelación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, pulmonology, archaic) Breathing difficulty, shortness of breath.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhidrosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhidrosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The reduced ability or inability to sweat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhydrase</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhidrasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) An enzyme that catalyzes the removal of water from a material.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhydride</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhídrido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chemistry) Any compound formally derived from another (or from others) by the loss of a water molecule, especially acid anhydrides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhydrite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhidrita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) An evaporite mineral made of anhydrous calcium sulfate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhydrobiosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhidrobiosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of cryptobiosis that occurs in situations of extreme desiccation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anhydrous</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anhidro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having little or no water.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(physical chemistry) Having no water of crystallization.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ani</ns0:orth>
        <ns0:pron>/ˈɑː.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>garrapatero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any bird of the genus Crotophaga in the cuckoo family.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anicca</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>impermanencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Buddhism) Impermanence, the doctrine claiming that all of conditioned existence, without exception, is transient. One of the three marks of existence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aniconism</ns0:orth>
        <ns0:pron>/ænˈaɪkənɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniconismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A prohibition against artists depicting religious figures such as divinities, prophets, or anything that can be worshiped.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anil</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>añil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The indigo shrub; or the indigo dye obtained from the plant.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anile</ns0:orth>
        <ns0:pron>/ˈeɪ.naɪl/</ns0:pron>
        <ns0:pron>/ˈæ.naɪl/</ns0:pron>
        <ns0:pron>/ˈæn.aɪl/&lt;a:RP&gt;&lt;ref:&lt;&lt;name:OED&gt;&gt;&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characteristic of a crone or a feeble old woman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aniline</ns0:orth>
        <ns0:pron>/ˈæ.nɪ.lin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anilina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The simplest aromatic amine, C6H5NH2, synthesized by the reduction of nitrobenzene; it is a colourless oily basic poisonous liquid used in the manufacture of dyes and pharmaceuticals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anilingus</ns0:orth>
        <ns0:pron>/ˌeɪ.nɪˈlɪŋ.ɡəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anilingus</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Performance of oral sex upon the anus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animadversion</ns0:orth>
        <ns0:pron>/ˌænɪmædˈvɜːʒən/</ns0:pron>
        <ns0:pron>/ˌænɪmædˈvɝːʃən/</ns0:pron>
        <ns0:pron>/ˌænɪmædˈvɝːʒən /</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>crítica</ns0:quote>
          <ns0:quote>reprobación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A criticism, a critical remark.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animadvert</ns0:orth>
        <ns0:pron>/ˌænɪmædˈvɜːt/</ns0:pron>
        <ns0:pron>/ˌænɪmædˈvɝt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>censurar</ns0:quote>
          <ns0:quote>criticar</ns0:quote>
          <ns0:quote>enterarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, law, archaic) To turn judicial attention (to); to criticise or punish.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal</ns0:orth>
        <ns0:pron>/əˈnɪ.məl/</ns0:pron>
        <ns0:pron>/ˈæ.nə.məl/</ns0:pron>
        <ns0:pron>/ˈæ.nɪ.məl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to animals.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Raw, base, unhindered by social codes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal</ns0:orth>
        <ns0:pron>/əˈnɪ.məl/</ns0:pron>
        <ns0:pron>/ˈæ.nə.məl/</ns0:pron>
        <ns0:pron>/ˈæ.nɪ.məl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animal</ns0:quote>
          <ns0:quote>bestia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(science) Any member of the kingdom Animalia of multicellular organisms that are usually mobile, whose cells are not encased in a rigid cell wall (distinguishing them from plants and fungi) and which derive energy solely from the consumption of other organisms (further distinguishing them from plants).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A person who behaves wildly; a bestial, brutal, brutish, cruel, or inhuman person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal feed</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pienso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Material, of an animal or most often vegetable origin, prepared (especially industrially) as feed for domestic or farm animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal husbandry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ganadería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The management and care of farm animals by humans for profit, in which genetic qualities and behaviour, considered to be advantageous to humans, are further developed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal kingdom</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reino animal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biology) The regnum Animalia; the set of all animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal liberation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>liberación animal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ethics, social policy) A social movement dedicated to the advancement of the interests and rights of non-human animals, consisting of theorists and activists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal magnetism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mesmerismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mesmerism) A magnetic fluid or ethereal medium said to reside in the bodies of animate beings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal rights</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>derechos de los animales</ns0:quote>
          <ns0:quote>animalista</ns0:quote>
          <ns0:quote>derechos animales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Certain fundamental rights that animals are entitled to, such as the right to be spared undue suffering.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal shelter</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>protectora</ns0:quote>
          <ns0:quote>protectora de animales</ns0:quote>
          <ns0:quote>perrera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An organization that provides temporary homes for stray pet animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>refugio de animales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A facility providing such shelter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal welfare</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bienestar animal</ns0:quote>
          <ns0:quote>bienestar de los animales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The protection of animals' health with appropriate accommodation, nutrition and care.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The safeguarding of animals in a laboratory or similar environment with a code of practice, enforced by legislation or regulation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animal-like</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animalesco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resembling an animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animalcule</ns0:orth>
        <ns0:pron>/ænɪˈmælkjuːl/</ns0:pron>
        <ns0:pron>/ˌænəˈmælˌkjul/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animálculo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(zoology, archaic) A microscopic aquatic animal, including protozoa and rotifers. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animalist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(art) A painter or sculptor whose primary subject is animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animalize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animalizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To represent in the form of an animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animally</ns0:orth>
        <ns0:pron>/ˈanɪməli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animalmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In respect of the physical or "animal" faculties, as opposed to the intellect or spirit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animate</ns0:orth>
        <ns0:pron>/ənɪˈmeʈ/</ns0:pron>
        <ns0:pron>/ˈæn.ə.meɪt/</ns0:pron>
        <ns0:pron>/ˈæn.ə.mət/</ns0:pron>
        <ns0:pron>/ˈæn.ɪ.meɪt/</ns0:pron>
        <ns0:pron>/ˈæn.ɪ.mət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That lives.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Possessing the quality or ability of motion.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) Inflected to agree with an animate noun or pronoun.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animate</ns0:orth>
        <ns0:pron>/ənɪˈmeʈ/</ns0:pron>
        <ns0:pron>/ˈæn.ə.meɪt/</ns0:pron>
        <ns0:pron>/ˈæn.ə.mət/</ns0:pron>
        <ns0:pron>/ˈæn.ɪ.meɪt/</ns0:pron>
        <ns0:pron>/ˈæn.ɪ.mət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To impart motion or the appearance of motion to.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To give spirit or vigour to; to stimulate or enliven; to inspirit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animated</ns0:orth>
        <ns0:pron>/ˈæn.ɪ.meɪ.tɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animado</ns0:quote>
          <ns0:quote>vivaz</ns0:quote>
          <ns0:quote>vivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Endowed with life.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animated cartoon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dibujo animado</ns0:quote>
          <ns0:quote>caricatura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several types of film / movie, the frames of which are drawn by hand in order to give a sense of movement when projected in rapid sequence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animatedly</ns0:orth>
        <ns0:pron>/ˈænɪˌmeɪtɪdli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animadamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an animated manner; with animation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animation</ns0:orth>
        <ns0:pron>/ənɪˈmeʃən/</ns0:pron>
        <ns0:pron>/ˌæn.ɪˈmeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animación</ns0:quote>
          <ns0:quote>vivificación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of animating, or giving life or spirit.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(animation, in the sense of a cartoon) A sequence of still drawings or inanimate objects displayed in rapid succession to create the illusion of movement in motion pictures or computer graphics; the object (film, computer game, etc.) produced</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) conversion from the inanimate to animate grammatical category</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animator</ns0:orth>
        <ns0:pron>/ˈænɪˌmeɪtə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animador</ns0:quote>
          <ns0:quote>animadora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(art) One who creates an animation or cartoon; a cartoonist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animatronic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animatrónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of a robot, etc, that works by animatronics.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anime</ns0:orth>
        <ns0:pron>/ənɪˈme/</ns0:pron>
        <ns0:pron>/ˈæn.ɪ.meɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anime</ns0:quote>
          <ns0:quote>animé</ns0:quote>
          <ns0:quote>ánime</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) An artistic style originating in, and associated with, Japanese animation, and that has also been adopted by a comparatively low number of animated works from other countries.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(countable) An animated work that originated in Japan, regardless of the artistic style.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animistic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to animism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resolute and full of vigor; vehement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>animosity</ns0:orth>
        <ns0:pron>/æn.əˈmɑ.sə.ti/</ns0:pron>
        <ns0:pron>/æn.əˈmɑ.sɪ.ti/</ns0:pron>
        <ns0:pron>/æn.ɪˈmɒs.ɪ.ti/</ns0:pron>
        <ns0:pron>/ənɪˈmɔsɪʈi/</ns0:pron>
        <ns0:pron>[æn.əˈmɑ.sə.ɾi]</ns0:pron>
        <ns0:pron>[æn.əˈmɑ.sɪ.ɾi]</ns0:pron>
        <ns0:pron>[ɛən.əˈmɑ.sə.ɾi]</ns0:pron>
        <ns0:pron>[ɛən.əˈmɑ.sɪ.ɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animosidad</ns0:quote>
          <ns0:quote>animadversión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Violent hatred leading to active opposition; active enmity; energetic dislike.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anion</ns0:orth>
        <ns0:pron>/ˈænˌaɪ.ɑn/</ns0:pron>
        <ns0:pron>/ˈænˌaɪ.ɒn/</ns0:pron>
        <ns0:pron>/ˈænˌaɪ.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A negatively charged ion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anionic</ns0:orth>
        <ns0:pron>/ˌæ.naɪˈɑ.nɪk/</ns0:pron>
        <ns0:pron>/ˌæ.niˈɑ.nɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to an anion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anionicity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anionicidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The quality of being anionic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anise</ns0:orth>
        <ns0:pron>/æˈnis/</ns0:pron>
        <ns0:pron>/əˈnis/</ns0:pron>
        <ns0:pron>/ˈæn.ɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anís</ns0:quote>
          <ns0:quote>matalahúva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An umbelliferous plant (Pimpinella anisum) growing naturally in Egypt, and cultivated in Spain, Malta, etc., for its carminative and aromatic seeds, which are used as a spice. It has a licorice scent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aniseed</ns0:orth>
        <ns0:pron>/ˈæ.nɪ.sid/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anís</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, and, uncountable) The seed-like fruit of the anise, used in baking and in the flavouring of liqueurs such as ouzo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anisette</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anisete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A French alcoholic liqueur flavored with anise</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aniso-</ns0:orth>
        <ns0:pron>/əˌnaɪsə(ʊ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniso-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>unequal; not the same; not the selfsame: forming compounds words; often formed to contrast with similar words in iso-).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anisocoria</ns0:orth>
        <ns0:pron>/-ˈkoʊɹ-/</ns0:pron>
        <ns0:pron>/ænˌaɪsəˈkɔɹ i ə/</ns0:pron>
        <ns0:pron>/ˌænaɪ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anisocoria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) A condition characterized by unequal size of the pupils of the eye.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anisole</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anisol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) The aromatic ether methoxybenzene; it is used in perfumery and in organic synthesis; any derivative of this compound</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anisotropic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anisotrópico</ns0:quote>
          <ns0:quote>anisótropo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics, mathematics) Having properties that differ according to the direction of measurement; exhibiting anisotropy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anisotropically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anisotrópicamente</ns0:quote>
          <ns0:quote>anisótropamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>in an anisotropic manner; in such a way as to depend upon direction</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anisotropy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anisotropía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The property of being directionally dependent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anitism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anitería</ns0:quote>
          <ns0:quote>anitismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indigenous Philippine folk religion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankerite</ns0:orth>
        <ns0:pron>/ˈɑŋkɚˌaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ankerita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) Any of a group of mixed carbonate minerals, principally of calcium with iron, magnesium and manganese.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankh</ns0:orth>
        <ns0:pron>/æŋk/</ns0:pron>
        <ns0:pron>/ɑŋk/</ns0:pron>
        <ns0:pron>/ɑːŋk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anj</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cross shaped like a T with a loop at the top, the Egyptian hieroglyph representing the Egyptian triliteral ꜥnḫ and often used as an amulet or charm for this concept.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankle</ns0:orth>
        <ns0:pron>/ˈæŋ.kəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tobillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The skeletal joint which connects the foot with the leg; the uppermost portion of the foot and lowermost portion of the leg, which contain this skeletal joint.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankle boot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>botín</ns0:quote>
          <ns0:quote>borceguí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(clothing) A boot that rises up to the ankle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankle monitor</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tobillera electrónica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device that individuals under house arrest or parole are often required to wear to track their location.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anklebone</ns0:orth>
        <ns0:pron>/ˈaŋk(ə)lbəʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>taba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The bone of the ankle, forming the lower part of the ankle joint and joining with the tibia and fibula.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anklet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ajorca de tobillo</ns0:quote>
          <ns0:quote>carcax</ns0:quote>
          <ns0:quote>tobillera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A piece of jewelry/jewellery, resembling a bracelet but worn around the ankle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankylosaurus</ns0:orth>
        <ns0:pron>/ˌæŋkəloʊˈsɔːɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anquilosaurio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large herbivorous dinosaur, of genus Ankylosaurus, that lived in the Cretaceous period, noted for its heavy armor and club-like tail.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankylose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anquilosar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, pathology) To cause bony structures to fuse or stiffen as a result of ankylosis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankylosing spondylitis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>espondilitis anquilosante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(disease) A particular arthritis disease that affects usually the joints between vertebrae and the sacroiliac joint.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ankylosis</ns0:orth>
        <ns0:pron>/ˌæn.kɪˈloʊ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anquilosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The growing together of bones to form a single unit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annal</ns0:orth>
        <ns0:pron>/ˈænəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anal</ns0:quote>
          <ns0:quote>añal</ns0:quote>
          <ns0:quote>fasto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The record of a single event or item.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annals</ns0:orth>
        <ns0:pron>/ˈæn.əlz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anales</ns0:quote>
          <ns0:quote>añales</ns0:quote>
          <ns0:quote>fastos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A relation of events in chronological order, each event being recorded under the year in which it happened.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A periodic publication, containing records of discoveries, transactions of societies, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anales</ns0:quote>
          <ns0:quote>añales</ns0:quote>
          <ns0:quote>crónica</ns0:quote>
          <ns0:quote>fastos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Historical records; chronicles; history.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annatto</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>achiote</ns0:quote>
          <ns0:quote>onoto</ns0:quote>
          <ns0:quote>urucú</ns0:quote>
          <ns0:quote>bija</ns0:quote>
          <ns0:quote>caituco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A tropical American evergreen shrub, Bixa orellana; the lipstick tree; the fruit of the tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>achiote</ns0:quote>
          <ns0:quote>bija</ns0:quote>
          <ns0:quote>caituco</ns0:quote>
          <ns0:quote>onoto</ns0:quote>
          <ns0:quote>urucú</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The seed of this tree used as a colouring or in Latin American cooking, containing bixin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>achiote</ns0:quote>
          <ns0:quote>onoto</ns0:quote>
          <ns0:quote>urucú</ns0:quote>
          <ns0:quote>anoto</ns0:quote>
          <ns0:quote>bija</ns0:quote>
          <ns0:quote>caituco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A fugitive orange-red dye obtained from this seed and fruit pulp through maceration and fermentation, used as textile dye and skin dye, containing bixin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anneal</ns0:orth>
        <ns0:pron>/əˈniːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recocer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metallurgy) To subject to great heat and then (often slow) cooling, and sometimes reheating and further cooling, for the purpose of rendering less brittle; to temper; to toughen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annealing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>recocido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The heating of solid metal or glass to high temperatures and cooling it slowly so that its particles arrange into a defined lattice to remove residual stress.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annelid</ns0:orth>
        <ns0:pron>/ˈænələd/</ns0:pron>
        <ns0:pron>/ˈænəlɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anélido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various wormlike animals, of the phylum Annelida, having a segmented body; they include the earthworm and the leech.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annex</ns0:orth>
        <ns0:pron>/əˈnɛks/</ns0:pron>
        <ns0:pron>/ˈænɛks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apéndice</ns0:quote>
          <ns0:quote>extensión</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anexo</ns0:quote>
          <ns0:quote>anejo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An addition, an extension.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anexo</ns0:quote>
          <ns0:quote>anejo</ns0:quote>
          <ns0:quote>pabellón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An addition or extension to a building.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annex</ns0:orth>
        <ns0:pron>/əˈnɛks/</ns0:pron>
        <ns0:pron>/ˈænɛks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anexar</ns0:quote>
          <ns0:quote>anexionar</ns0:quote>
          <ns0:quote>anejar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To add something to another thing, especially territory; to incorporate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annexation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anexión</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Addition or incorporation of something, or territories that have been annexed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annexationism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anexionismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The tendency or policy of annexing (appropriating) additional territories.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annihilate</ns0:orth>
        <ns0:pron>/əˈnaɪ.ə.leɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniquilar</ns0:quote>
          <ns0:quote>anihilar</ns0:quote>
          <ns0:quote>anular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To reduce to nothing, to destroy, to eradicate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annihilation</ns0:orth>
        <ns0:pron>/əˌnaɪ.əˈleɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniquilación</ns0:quote>
          <ns0:quote>anihilación</ns0:quote>
          <ns0:quote>anihilamiento</ns0:quote>
          <ns0:quote>aniquilamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of destroying or otherwise turning into nothing, or nonexistence.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The state of being annihilated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniquilación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) The process of a particle and its corresponding antiparticle combining to produce energy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annihilative</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniquilativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Serving to annihilate; radically destructive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annihilator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anulador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(commutative algebra, of an element (or subset) of an R-module M) That ideal of R whose elements yield zero when multiplied by the given element (or; by the elements of the given subset) of M.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annihilator method</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>método del anulador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(analysis) A procedure used to find a particular solution to certain types of inhomogeneous ordinary differential equations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annis Domini</ns0:orth>
        <ns0:pron>/ˈænɪs ˈdɒmɪnaɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>años después de Cristo</ns0:quote>
          <ns0:quote>después de Cristo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of multiple years, or, of a date range) ; taking place a specified number of years after the assumed birth date of Jesus Christ.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anniversary</ns0:orth>
        <ns0:pron>/ˌænəˈvɝs(ə)ɹi/</ns0:pron>
        <ns0:pron>/ˌænɪˈvɜːs(ə)ɹi/</ns0:pron>
        <ns0:pron>/ˌænɪˈvɝs(ə)ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aniversario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A day that is an exact number of years (to the day) since a given significant event occurred. Often preceded by an ordinal number indicating the number of years.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annotate</ns0:orth>
        <ns0:pron>/ˈanəteɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anotar</ns0:quote>
          <ns0:quote>apostillar</ns0:quote>
          <ns0:quote>acotar</ns0:quote>
          <ns0:quote>enserir</ns0:quote>
          <ns0:quote>glosar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To add annotation to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annotation</ns0:orth>
        <ns0:pron>/ˌænəˈteɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anotación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A critical or explanatory commentary or analysis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(genetics) Information relating to the genetic structure of sequences of bases.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anotación</ns0:quote>
          <ns0:quote>acotación</ns0:quote>
          <ns0:quote>apostilla</ns0:quote>
          <ns0:quote>glosa</ns0:quote>
          <ns0:quote>membrete</ns0:quote>
          <ns0:quote>postilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A comment added to a text.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anotación</ns0:quote>
          <ns0:quote>glose</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of writing such comment or commentary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>announce</ns0:orth>
        <ns0:pron>/əˈnaʊn(t)s/</ns0:pron>
        <ns0:pron>/əˈnaʊns/</ns0:pron>
        <ns0:pron>/ˈæ.naʊns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anunciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give public notice of, especially for the first time; to make known.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>declarar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pronounce; to declare by judicial sentence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>announcement</ns0:orth>
        <ns0:pron>/əˈnaʊns.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anunciamiento</ns0:quote>
          <ns0:quote>anuncio</ns0:quote>
          <ns0:quote>anunciación</ns0:quote>
          <ns0:quote>declaración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An act of announcing, or giving notice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuncio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>That which conveys what is announced.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuncio</ns0:quote>
          <ns0:quote>anunciación</ns0:quote>
          <ns0:quote>anunciamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The content which is announced.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>announcer</ns0:orth>
        <ns0:pron>/əˈnaʊnsə/</ns0:pron>
        <ns0:pron>/əˈnaʊnsɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>locutor</ns0:quote>
          <ns0:quote>anunciador</ns0:quote>
          <ns0:quote>comentarista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who makes announcements.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annoy</ns0:orth>
        <ns0:pron>/əˈnɔɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enojo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literary, archaic) A feeling of discomfort or vexation caused by what one dislikes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annoy</ns0:orth>
        <ns0:pron>/əˈnɔɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>molestar</ns0:quote>
          <ns0:quote>agobiar</ns0:quote>
          <ns0:quote>crispar</ns0:quote>
          <ns0:quote>enchilar</ns0:quote>
          <ns0:quote>jorobar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To disturb or irritate, especially by continued or repeated acts; to bother with unpleasant deeds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>enchilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To do something to upset or anger someone; to be troublesome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annoyance</ns0:orth>
        <ns0:pron>/əˈnɔɪ.əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disgusto</ns0:quote>
          <ns0:quote>irritación</ns0:quote>
          <ns0:quote>molestia</ns0:quote>
          <ns0:quote>lata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) That which annoys.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disgusto</ns0:quote>
          <ns0:quote>fastidio</ns0:quote>
          <ns0:quote>irritación</ns0:quote>
          <ns0:quote>molestia</ns0:quote>
          <ns0:quote>lata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) An act or instance of annoying.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disgusto</ns0:quote>
          <ns0:quote>irritación</ns0:quote>
          <ns0:quote>enojo</ns0:quote>
          <ns0:quote>molestia</ns0:quote>
          <ns0:quote>lata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The psychological state of being annoyed or irritated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annoyed</ns0:orth>
        <ns0:pron>/əˈnɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>irritado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Troubled, irritated by something unwanted or unliked (an annoyance); vexed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annoying</ns0:orth>
        <ns0:pron>/əˈnɔɪ.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>molesto</ns0:quote>
          <ns0:quote>fastidioso</ns0:quote>
          <ns0:quote>cargante</ns0:quote>
          <ns0:quote>chinchoso</ns0:quote>
          <ns0:quote>enfadoso</ns0:quote>
          <ns0:quote>engorroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Causing irritation or annoyance; troublesome; vexatious.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annual</ns0:orth>
        <ns0:pron>/ˈæn.ju.əl/</ns0:pron>
        <ns0:pron>/ˈæn.jəl/</ns0:pron>
        <ns0:pron>/ˈænɪu̯.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anual</ns0:quote>
          <ns0:quote>anuo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, for, or relating to a whole year, often as a recurring cycle; determined or reckoned by the year; accumulating in the course of a year; performed, executed, or completed over the course of a year. See also circannual.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(entomology) Living or lasting just one season or year, as certain insects or insect colonies.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annual</ns0:orth>
        <ns0:pron>/ˈæn.ju.əl/</ns0:pron>
        <ns0:pron>/ˈæn.jəl/</ns0:pron>
        <ns0:pron>/ˈænɪu̯.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An annual publication; a book, periodical, journal, report, comic book, yearbook, etc., which is published serially once a year, which may or may not be in addition to regular weekly or monthly publication.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annually</ns0:orth>
        <ns0:pron>/ˈæn.ju.ə.li/</ns0:pron>
        <ns0:pron>/ˈæn.jʊə.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anualmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Once every year without fail, yearly</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annuity</ns0:orth>
        <ns0:pron>/əˈn(j)uɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anualidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(insurance, pensions) A right to receive amounts of money regularly over a certain fixed period, in perpetuity, or, especially, over the remaining life or lives of one or more beneficiaries.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annul</ns0:orth>
        <ns0:pron>/əˈnɐl/</ns0:pron>
        <ns0:pron>/əˈnʌl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anular</ns0:quote>
          <ns0:quote>invalidar</ns0:quote>
          <ns0:quote>revocar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To formally revoke the validity of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To dissolve (a marital union) on the grounds that it is not valid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annular</ns0:orth>
        <ns0:pron>/ˈænjələ/</ns0:pron>
        <ns0:pron>/ˈænjəlɚ/</ns0:pron>
        <ns0:pron>/ˈænjʊlə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to, or having the form of, a ring; ring-shaped; in the shape of an annulus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annular eclipse</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eclipse anular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) a solar eclipse in which the thin outer disk of the sun can be seen as a ring around the moon</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annulene</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anuleno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any monocyclic hydrocarbon, of general formula CnHn (where n is even), or CnHn+1 (where n is odd).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annulet</ns0:orth>
        <ns0:pron>/ˈæn.jə.lət/</ns0:pron>
        <ns0:pron>/ˈæn.jʊ.lət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>armilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architectural element) A ring-shaped molding at the top of a column.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annulment</ns0:orth>
        <ns0:pron>/əˈnʌl.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An act or instance of annulling.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(legal, Catholicism) A legal (notably judicial) declaration that a marriage is invalid; the procedure leading to it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>annulus</ns0:orth>
        <ns0:pron>/-li/</ns0:pron>
        <ns0:pron>/ˈænjəlaɪ/</ns0:pron>
        <ns0:pron>/ˈænjələs/</ns0:pron>
        <ns0:pron>/ˈænjʊlaɪ/</ns0:pron>
        <ns0:pron>/ˈænjʊləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anillo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A ring- or donut-shaped area, object, or structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corona solar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A ring of light in a celestial body, especially when caused by an annular eclipse (for example, when the Sun and Moon are in line with the Earth, but the Moon does not completely cover the Sun's disc).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anillo</ns0:quote>
          <ns0:quote>corona circular</ns0:quote>
          <ns0:quote>annulus</ns0:quote>
          <ns0:quote>arandela</ns0:quote>
          <ns0:quote>corona solar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A structure surrounding a sporangium (or part of it) which shrinks and causes it to rupture for spore dispersal; specifically, in a fern: a structure around about two-thirds of the sporangium consisting of differentially thick-walled cells which dry and distort the sporangium; and in a moss: a complete ring of cells around the tip of the sporangium which dissolves to cause the tip to detach.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>corona circular</ns0:quote>
          <ns0:quote>annulus</ns0:quote>
          <ns0:quote>arandela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The region in a plane between two concentric circles of different radii.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(topology) Any topological space homeomorphic to the region in a plane between two concentric circles of different radii.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anoa</ns0:orth>
        <ns0:pron>/əˈnoʊə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Either of two related species of small Indonesian water buffalo similar in appearance to deer; Bubalus quarlesi or Bubalus depressicornis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anode</ns0:orth>
        <ns0:pron>/ˈæn.oʊd/</ns0:pron>
        <ns0:pron>/ˈæn.əʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ánodo</ns0:quote>
          <ns0:quote>anodo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(electricity) An electrode, of a cell or other electrically polarized device, through which a positive current of electricity flows inwards (and thus, electrons flow outwards). It can have either a positive or a negative voltage with respect to cathode of the same polarized device (depending on whether the device is a load or a source, respectively).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anodization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anodización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The process of anodizing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anodontia</ns0:orth>
        <ns0:pron>/æn.ə(ʊ)ˈdɒn.tɪ.ə/</ns0:pron>
        <ns0:pron>/ˌæn.əˈdɑn.ʃi.ə/</ns0:pron>
        <ns0:pron>/ˌæn.əˈdɑn.ʃə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anodoncia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dentistry, teratology) The congenital absence of some or all primary or permanent teeth, caused by a rare genetic disorder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anodyne</ns0:orth>
        <ns0:pron>/ˈæn.ə.daɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anodino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Capable of soothing or eliminating pain. [from 16th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) Noncontentious, blandly agreeable, unlikely to cause offence or debate. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>relajante</ns0:quote>
          <ns0:quote>tranquilizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) Soothing or relaxing. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anodyne</ns0:orth>
        <ns0:pron>/ˈæn.ə.daɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tranquilizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A source of relaxation or comfort.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anoint</ns0:orth>
        <ns0:pron>/əˈnɔɪnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ungir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To smear or rub over with oil or an unctuous substance; also, to spread over, as oil.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ungir</ns0:quote>
          <ns0:quote>consagrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To apply oil to or to pour oil upon, etc., as a sacred rite, especially for consecration.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, historical) To mark somebody as an official ruler, especially a king or queen, as a part of a religious ceremony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anointed</ns0:orth>
        <ns0:pron>/əˈnɔɪn.tɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ungido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who has been anointed, especially for religious reasons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anomalous</ns0:orth>
        <ns0:pron>/əˈnɑmələs/</ns0:pron>
        <ns0:pron>/əˈnɒmələs/</ns0:pron>
        <ns0:pron>/əˈnɔmələs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anómalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Deviating from the normal; marked by incongruity or contradiction; aberrant or abnormal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anomalously</ns0:orth>
        <ns0:pron>/əˈnɑmələsli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anómalamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an anomalous manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anomaly</ns0:orth>
        <ns0:pron>/əˈnɑ.mə.li/</ns0:pron>
        <ns0:pron>/əˈnɒm.ə.lɪ/</ns0:pron>
        <ns0:pron>/əˈnɔm.ə.lɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anomalía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A deviation from a rule or from what is regarded as normal; an outlier.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Something or someone that is strange or unusual.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(science) Any event or measurement that is out of the ordinary regardless of whether it is exceptional or not.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) Any of various angular distances.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology) A defect or malformation.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(dated) An irregularity or disproportion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anomer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anómero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any diastereoisomer of a sugar or derivative differing in configuration only at C-1 of an aldose or C-2 of a ketose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anomeric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anomérico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anomie</ns0:orth>
        <ns0:pron>/a.noʊ̯ˈmi/</ns0:pron>
        <ns0:pron>/ˈæn.ə.mi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anomia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Alienation or social instability caused by erosion of standards and values.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anonymity</ns0:orth>
        <ns0:pron>/ænəˈnɪmɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anonimato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality or state of being anonymous (nameless or unidentified). [from 1820]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anonymization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anonimización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of making anonymous, of hiding or disguising identity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anonymize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anonimizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make or render anonymous (especially to remove personally identifying data).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anonymous</ns0:orth>
        <ns0:pron>/əˈnɑ.nə.məs/</ns0:pron>
        <ns0:pron>/əˈnɒn.ə.məs/</ns0:pron>
        <ns0:pron>/əˈnɔn.ə.məs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(not comparable) Lacking a name; not named, for example an animal not assigned to any species .</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(not comparable) Without any name acknowledged of a person responsible.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(not comparable) Of unknown name; whose name is withheld</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(comparable, figurative) Lacking individuality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anonymously</ns0:orth>
        <ns0:pron>/əˈnɒnəməsli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anónimamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an anonymous manner; without a name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>In an anonymous manner; without individuality.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorak</ns0:orth>
        <ns0:pron>/ˈænəɹæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anorak</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A heavy weatherproof jacket with an attached hood; a parka or windcheater.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorectal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anorectal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Of or pertaining to the anus and the rectum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorectic</ns0:orth>
        <ns0:pron>/ænəˈɹɛktɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoréxico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Characterised by a lack of appetite, especially as suffering from anorexia nervosa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorexia</ns0:orth>
        <ns0:pron>/ænəˈɹɛksi.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anorexia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(especially, in, medicine) Loss of appetite, especially as a result of disease.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorexia nervosa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anorexia nerviosa</ns0:quote>
          <ns0:quote>anorexia</ns0:quote>
          <ns0:quote>anorexia mental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An eating disorder characterized by self-starvation due to an irrational fear of gaining weight.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorexic</ns0:orth>
        <ns0:pron>/ænəˈɹɛksɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoréxico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to, or suffering from, anorexia nervosa.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) Thin, skinny, insubstantial.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorexic</ns0:orth>
        <ns0:pron>/ænəˈɹɛksɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoréxico</ns0:quote>
          <ns0:quote>anoréxica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Somebody suffering from anorexia nervosa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorexically</ns0:orth>
        <ns0:pron>/anəˈɹɛksɪk(ə)li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoréxicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to loss of appetite or anorexia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorgasmia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anorgasmia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) Failure to achieve orgasm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorthite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anortita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) A variety of plagioclase feldspar, the calcium endmember of that series.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anorthoclase</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anortoclasa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) Any of a group of feldspars being mixed sodium and potassium aluminosilicates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anosmia</ns0:orth>
        <ns0:pron>/æˈnɑːzmiːə/</ns0:pron>
        <ns0:pron>/æˈnɒzmiə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anosmia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Inability to smell; the inability to perceive odors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anosognosia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anosognosia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The inability of a person to recognize his or her own illness or handicap.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>another</ns0:orth>
        <ns0:pron>/eɪˈnʌð.ɚ/</ns0:pron>
        <ns0:pron>/ænˈʊð.ə/</ns0:pron>
        <ns0:pron>/ænˈʌð.ə/</ns0:pron>
        <ns0:pron>/ænˈʌð.ɚ/</ns0:pron>
        <ns0:pron>/ənəˈd̪ʱɜ(r)/</ns0:pron>
        <ns0:pron>/əˈnʊð.ə/</ns0:pron>
        <ns0:pron>/əˈnʌð.ə/</ns0:pron>
        <ns0:pron>/əˈnʌð.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>determiner</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>otro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One more further, in addition to the quantity by then; a second or additional one, similar in likeness or in effect.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Not the same; different.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any or some other, similar in likeness or in effect, instead.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>another day, another dollar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aquí en la brega</ns0:quote>
          <ns0:quote>sudando la gota gorda</ns0:quote>
          <ns0:quote>un día más un día menos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Life goes on, and it is necessary to work in order to earn money.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anovulation</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anovulación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Lack of ovulation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anoxia</ns0:orth>
        <ns0:pron>/ænˈɑk.si.ə/</ns0:pron>
        <ns0:pron>/ænˈɒk.sɪ.ə/</ns0:pron>
        <ns0:pron>/æˈnɑk-/</ns0:pron>
        <ns0:pron>/æˈnɒk-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoxia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecology, pathology) A condition in which a body tissue or an environment is severely or totally deprived of oxygen; severe hypoxia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anoxic</ns0:orth>
        <ns0:pron>/ˌæˈnɑːk.sɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anóxico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) Suffering from a reduced supply of oxygen.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Lacking oxygen.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anoxybiosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoxibiosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physiology) A biological response triggered by a lack of oxygen in which an organism takes in water and becomes turgid and immobile; possibly a form of cryptobiosis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anoxygenic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anoxigénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biochemistry) That does not involve the production of oxygen</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anserine</ns0:orth>
        <ns0:pron>/ˈansəɹʌɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansarino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to a goose or geese; gooselike. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ansible</ns0:orth>
        <ns0:pron>/ˈæn.sɪ.bəl/</ns0:pron>
        <ns0:pron>/ˈɑːn.sɪ.bəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ansible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(science fiction) A hypothetical device that enables users to communicate instantaneously across great distances; that is, a faster-than-light communication device.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>answer</ns0:orth>
        <ns0:pron>/ˈan.sə/</ns0:pron>
        <ns0:pron>/ˈæn.sə/</ns0:pron>
        <ns0:pron>/ˈæn.sɚ/</ns0:pron>
        <ns0:pron>/ˈɑːn.sə/</ns0:pron>
        <ns0:pron>[ˈeən.sə]</ns0:pron>
        <ns0:pron>[ˈeən.sɚ]</ns0:pron>
        <ns0:pron>[ˈeːnsə ~ ˈɛːnsə]</ns0:pron>
        <ns0:pron>[ˈɐːnsə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respuesta</ns0:quote>
          <ns0:quote>contestación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A response or reply; something said or done in reaction to a statement or question.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(legal) A document filed in response to a complaint, responding to each point raised in the complaint and raising counterpoints.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>respuesta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A solution to a problem.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>answer</ns0:orth>
        <ns0:pron>/ˈan.sə/</ns0:pron>
        <ns0:pron>/ˈæn.sə/</ns0:pron>
        <ns0:pron>/ˈæn.sɚ/</ns0:pron>
        <ns0:pron>/ˈɑːn.sə/</ns0:pron>
        <ns0:pron>[ˈeən.sə]</ns0:pron>
        <ns0:pron>[ˈeən.sɚ]</ns0:pron>
        <ns0:pron>[ˈeːnsə ~ ˈɛːnsə]</ns0:pron>
        <ns0:pron>[ˈɐːnsə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>servir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ambitransitive) To suit a need or purpose satisfactorily.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contestar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To correspond to; to be in harmony with; to be in agreement with.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>responder</ns0:quote>
          <ns0:quote>contestar</ns0:quote>
          <ns0:quote>servir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To be or act in conformity, or by way of accommodation, correspondence, relation, or proportion; to conform; to correspond; to suit; usually with to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>responder</ns0:quote>
          <ns0:quote>contestar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) To be or act as an equivalent to, or as adequate or sufficient for; to serve for; to repay.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>answer key</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>clave de respuestas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An assorted list of solutions to problems or exercises in a test, textbook, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>answerable</ns0:orth>
        <ns0:pron>/ˈæn.səɹ.ə.bl/</ns0:pron>
        <ns0:pron>/ˈɑːnsəɹəb(ə)l/</ns0:pron>
        <ns0:pron>/ˈɑːnsɹəb(ə)l/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>responsable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Required to justify one's actions (to somebody); accountable, responsible.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(rare) Of an argument: capable of being answered or refuted; admitting a satisfactory answer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>answering machine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>contestador automático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(telephony) A device that automatically records voice mail from unanswered telephone calls.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ant</ns0:orth>
        <ns0:pron>/ænt/</ns0:pron>
        <ns0:pron>/ɑːnt/</ns0:pron>
        <ns0:pron>/ɛnt/</ns0:pron>
        <ns0:pron>[eənt]</ns0:pron>
        <ns0:pron>[ɛənt]</ns0:pron>
        <ns0:pron>[ɛːnt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hormiga</ns0:quote>
          <ns0:quote>himenóptero</ns0:quote>
          <ns0:quote>huasho</ns0:quote>
          <ns0:quote>shishi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various insects in the family Formicidae in the order Hymenoptera, typically living in large colonies composed almost entirely of flightless females.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antacid</ns0:orth>
        <ns0:pron>/ænˈtæsɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiácido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An agent that counteracts or neutralizes acidity, especially in the stomach. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antagonism</ns0:orth>
        <ns0:pron>/ænˈtæɡənɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antagonismo</ns0:quote>
          <ns0:quote>hostilidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strong natural dislike or hatred; antipathy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antagonist</ns0:orth>
        <ns0:pron>/ænˈtæɡənɪst/</ns0:pron>
        <ns0:pron>[ɛə̯nˈtæɡənɪst]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antagonista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An opponent or enemy.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>One who antagonizes or stirs.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biochemistry) A chemical that binds to a receptor but does not produce a physiological response, blocking the action of other agonist chemicals, such as endogenous chemical messengers.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(authorship) The main character or force opposing the protagonist in a literary work or drama.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(anatomy) A muscle that acts in opposition to another.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antagonistic</ns0:orth>
        <ns0:pron>/ænˌtæɡ.əˈnɪs.tɪk/</ns0:pron>
        <ns0:pron>[ɛənˌtæɡ.əˈnɪs.tɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antagónico</ns0:quote>
          <ns0:quote>antagonista</ns0:quote>
          <ns0:quote>hostil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Contending or acting against.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antagonize</ns0:orth>
        <ns0:pron>/ænˈtæɡ.ə.naɪz/</ns0:pron>
        <ns0:pron>/ænˈtæɡ.ɪ.naɪz/</ns0:pron>
        <ns0:pron>/ænˈtæɡ.ɪ.nɑez/</ns0:pron>
        <ns0:pron>[ɛənˈtæɡ.ə.naɪz]</ns0:pron>
        <ns0:pron>[ɛənˈtæɡ.ɪ.naɪz]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antagonizar</ns0:quote>
          <ns0:quote>contrariar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To work against; to oppose (especially to incite a reaction).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antaphrodisiac</ns0:orth>
        <ns0:pron>/æntæfɹəˈdiʒɪˌæk/</ns0:pron>
        <ns0:pron>/æntæfɹəˈdɪzɪˌæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anafrodisiaco</ns0:quote>
          <ns0:quote>antiafrodisíaco</ns0:quote>
          <ns0:quote>antierótico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Capable of reducing the sex drive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antaphrodisiac</ns0:orth>
        <ns0:pron>/æntæfɹəˈdiʒɪˌæk/</ns0:pron>
        <ns0:pron>/æntæfɹəˈdɪzɪˌæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anafrodisiaco</ns0:quote>
          <ns0:quote>antiafrodisíaco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A medicinal substance capable of reducing (inhibiting or eliminating) the sex drive/libido.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antbird</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hormiguerito</ns0:quote>
          <ns0:quote>hormiguero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various drab-colored South American birds of the family Thamnophilidae that feed on ants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ante</ns0:orth>
        <ns0:pron>/ˈænti/</ns0:pron>
        <ns0:pron>/ˈɛnti/</ns0:pron>
        <ns0:pron>[ˈɛənti]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luz</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anteater</ns0:orth>
        <ns0:pron>/ˈæntˌitɚ/</ns0:pron>
        <ns0:pron>/ˈæntˌiːtə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oso hormiguero</ns0:quote>
          <ns0:quote>shihui</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several animals of South and Central America, in the suborder Vermilingua, which are noted for eating ants and termites which they catch with their long sticky tongues, including giant anteater and lesser anteater (also known as collared anteater).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antebellum</ns0:orth>
        <ns0:pron>/ˌæn.tiˈbɛl.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prebélico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of the time period prior to a war.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antebrachial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antebraquial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) relating to the forearm</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antecede</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteceder</ns0:quote>
          <ns0:quote>antepasar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antecedent</ns0:orth>
        <ns0:pron>/ˌæntɪˈsiːdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antecedente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Earlier, either in time or in order.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antecedent</ns0:orth>
        <ns0:pron>/ˌæntɪˈsiːdənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antecedente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any thing that precedes another thing, especially the cause of the second thing.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(grammar) A word, phrase or clause referred to by a pronoun or other pro-form.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(logic) The conditional part of a hypothetical proposition, i.e. p \rightarrow q, where p is the antecedent, and q is the consequent.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(math) The first term of a ratio, i.e. the term a in the ratio a:b, the other being the consequent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antecedente</ns0:quote>
          <ns0:quote>ancestro</ns0:quote>
          <ns0:quote>antepasado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancestor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antechamber</ns0:orth>
        <ns0:pron>/ˈæn.tiˌt͡ʃeɪm.bə/</ns0:pron>
        <ns0:pron>/ˈæn.tiˌt͡ʃeɪm.bɚ/</ns0:pron>
        <ns0:pron>/ˈæn.tɪˌt͡ʃeɪm.bə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antecámara</ns0:quote>
          <ns0:quote>antesala</ns0:quote>
          <ns0:quote>recibimiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small room used as an entryway or reception area to a larger room.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antedate</ns0:orth>
        <ns0:pron>/ˈæntiˌdeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antepasar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antedatar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To assign a date to a document or action earlier than the actual date.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antediluvian</ns0:orth>
        <ns0:pron>/-tə-/</ns0:pron>
        <ns0:pron>/ˌæn.ti.dəˈlu.vi.ən/</ns0:pron>
        <ns0:pron>/ˌæn.tə(ˌ)daɪˈlu.vi.ən/</ns0:pron>
        <ns0:pron>/ˌæn.tɪ.dɪˈluː.vɪ.ən/</ns0:pron>
        <ns0:pron>[-ɾi-]</ns0:pron>
        <ns0:pron>[-ɾə-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antediluviano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) Belonging or pertaining to, or existing in, the time prior to the great flood described in Genesis, or (by extension) to a great or destructive flood or deluge described in other mythologies.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) Of animals and plants: long extinct; prehistoric.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antelope</ns0:orth>
        <ns0:pron>/ˈæn.tə.loʊp/</ns0:pron>
        <ns0:pron>/ˈæn.tɪ.loʊp/</ns0:pron>
        <ns0:pron>/ˈæn.tɪ.ləʊp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antílope</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of several African mammals of the family Bovidae distinguished by hollow horns, which, unlike deer, they do not shed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antenatal</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prenatal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Occurring or existing before birth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antenna</ns0:orth>
        <ns0:pron>/ænˈtɛn.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An apparatus to receive or transmit electromagnetic waves and convert respectively to or from an electrical signal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antenuptial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antenupcial</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antepenultimate</ns0:orth>
        <ns0:pron>/ˌæntəpənˈʌltəmət/</ns0:pron>
        <ns0:pron>/ˌæntɪpənˈʌltɪmət/</ns0:pron>
        <ns0:pron>/ˌæntɪpɪnˈʌltɪmət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antepenúltimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Two before the last, i.e., the one immediately before the penultimate, in a series.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anteposition</ns0:orth>
        <ns0:pron>/æntɪpəˈzɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteposición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) The placing of something in front of something else, especially of words in a sentence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterior</ns0:orth>
        <ns0:pron>/anˈtɪə.ɹi.ə/</ns0:pron>
        <ns0:pron>/ænˈtɪɹ.i.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Nearer the forward end, especially in the front of the body; nearer the head or forepart of an animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterior cerebral artery</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arteria cerebral anterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) An artery that arises from the internal carotid artery, forms the anterior portion of the circle of Willis where it is linked to the artery on the opposite side by the anterior communicating artery, and passes on to supply the medial surfaces of the cerebrum.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterior chamber</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cámara anterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, ophthalmology) A space inside the eye between the cornea and the iris, filled with aqueous humour.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterior cruciate ligament</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ligamento cruzado anterior</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterior deltoid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>deltoides anteriores</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(muscle) The largest of the muscles of each of the front shoulder.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anteriority</ns0:orth>
        <ns0:pron>/ænˌtɪəɹiˈɒɹɪti/</ns0:pron>
        <ns0:pron>/ænˌtɪɹiˈɔɹɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anterioridad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being previous or preceding in time or in situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antero-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antero-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, dentistry) anterior; front; forward</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterograde amnesia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amnesia anterógrada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) The inability to remember new information from the period beginning the amnesic episode.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anteroinferior</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteroinferior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Located in front and below.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterolateral</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anterolateral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, medicine) In front of the body, away from the midline.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anteromedial</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteromedial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Located in the front and towards a middle line.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anteroposterior</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteroposterior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) Anterior to posterior; front-to-back.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anterosuperior</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anterosuperior</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) From anterior to superior.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthelmintic</ns0:orth>
        <ns0:pron>/ænθɛlˈmɪntɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihelmíntico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Destructive to parasitic worms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthelmintic</ns0:orth>
        <ns0:pron>/ænθɛlˈmɪntɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antihelmíntico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) A drug for the treatment of worm infestation, either by killing the worms or by causing them to be expelled from the body.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthem</ns0:orth>
        <ns0:pron>/ˈæn.təm/</ns0:pron>
        <ns0:pron>/ˈæn.θəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>himno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A choral or vocal composition, often with a religious or political lyric.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A hymn of praise or loyalty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anther</ns0:orth>
        <ns0:pron>/ˈæn.θə/</ns0:pron>
        <ns0:pron>/ˈæn.θɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The pollen-bearing part of the stamen of a flower.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>antheridium</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteridio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, mycology) An organ producing male gametes called antherozoids, found in some algae, ferns, and bryophytes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthesis</ns0:orth>
        <ns0:pron>/ænˈθisɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>floración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) The event of a flower opening.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthill</ns0:orth>
        <ns0:pron>/ˈænt.hɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hormiguero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cone-shaped structure built from sediment and other available materials by ants or white ants (termites), and beneath which the colony nests.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthocyanin</ns0:orth>
        <ns0:pron>/ˌæn.θoʊˈsaɪ.ə.nɪn/</ns0:pron>
        <ns0:pron>/ˌæn.θəˈsaɪ.ə.nɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antocianina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, organic chemistry) Any of many water-soluble red to violet plant pigments related to the flavonoids (more noticeable in autumn after the chlorophyll decomposes)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthological</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to anthology; consisting of extracts from different authors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthology</ns0:orth>
        <ns0:pron>/ænˈθɑləd͡ʒi/</ns0:pron>
        <ns0:pron>/ænˈθɒlədʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antología</ns0:quote>
          <ns0:quote>florilegio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A collection of literary works, such as poems or short stories, especially a collection from various authors.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthozoan</ns0:orth>
        <ns0:pron>/anθə(ʊ)ˈzəʊən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antozoo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(marine biology) A marine invertebrate of the class Anthozoa, such as a sea anemone or coral.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthracene</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antraceno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A tricyclic aromatic hydrocarbon (an acene containing three fused rings) obtained from coal tar; used in the manufacture of wood preservatives, insecticides and the dye alizarin; it is isomeric with phenanthrene.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthracite</ns0:orth>
        <ns0:pron>/ˈænθɹəˌsaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antracita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A form of carbonized ancient plants; the hardest and cleanest-burning of all the coals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthracosis</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antracosis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pneumology, pathology) A relatively mild pneumoconiosis caused by inhalation of coal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthraquinone</ns0:orth>
        <ns0:pron>/-ˈkwaɪnoʊn/</ns0:pron>
        <ns0:pron>/ˌænθɹəkwɪˈnoʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antraquinona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A tricyclic quinone, derived from anthracene.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthrax</ns0:orth>
        <ns0:pron>/ˈæn.θɹæks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carbunco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) An acute infectious disease of herbivores, especially sheep and cattle, caused by Bacillus anthracis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropic</ns0:orth>
        <ns0:pron>/ænˈθɹɑ.pɪk/</ns0:pron>
        <ns0:pron>/ænˈθɹɒp.ɪk/</ns0:pron>
        <ns0:pron>/ænˈθɹɔp.ɪk/</ns0:pron>
        <ns0:pron>[ɛənˈθɹɑ.pɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antrópico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to mankind or humans, or the period of humanity's existence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ecology) The transformation or adaptation of the environment to meet the needs of humans, or by human activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To transform or adapt the environment either to meet the needs of humans, or by human activity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropo-</ns0:orth>
        <ns0:pron>/ænˈθɹɒpə-/</ns0:pron>
        <ns0:pron>/ˈænθɹəpə-/</ns0:pron>
        <ns0:pron>/ˌænθɹoʊpə-/</ns0:pron>
        <ns0:pron>/ˌænθɹəpoʊ-/</ns0:pron>
        <ns0:pron>/ˌænθɹəpə-/</ns0:pron>
        <ns0:pron>/ˌænθɹəˈpɒ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Forming words related to men or people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropocentric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropocéntrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Placing humans at the center of something, giving preference to humans above all other considerations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropocentrism</ns0:orth>
        <ns0:pron>/ˌæn.θɹə.poʊˈsɛn.tɹɪz.m/&lt;ref:&lt;&lt;name:dict.com&gt;&gt;&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropocentrismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A viewpoint or theory that places human beings at the center of everything, giving preference to human beings above all other considerations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropodermic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropodérmico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropogenic</ns0:orth>
        <ns0:pron>/ˌæn θrə pəˈdʒɛn ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropogénico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having its origin in the influence of human activity on nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropogeography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropogeografía</ns0:quote>
          <ns0:quote>geografía humana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anthropology) The study of the geographical distribution of humankind and the relationship between human beings and their environment</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropography</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropografía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of anthropology that deals with the geographical distribution of the human race in its different divisions, as distinguished by physical character, language, institutions, and customs, in contradistinction to ethnography, which deals historically with the origin and filiation of races and nations.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropoid</ns0:orth>
        <ns0:pron>/ˈænθɹəpɔɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropoide</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having characteristics of a human, usually in terms of shape or appearance.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Having characteristics of an ape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropolatry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropolatría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The worship of a human or humans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropological</ns0:orth>
        <ns0:pron>/æn.θɹə.pəˈlɑd͡ʒikəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to anthropology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropologically</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropológicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a manner which pertains to anthropology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropologist</ns0:orth>
        <ns0:pron>/ˌæn.θɹoʊˈpɑl.ə.d͡ʒɪst/</ns0:pron>
        <ns0:pron>/ˌæn.θɹəˈpɑl.ə.d͡ʒɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropólogo</ns0:quote>
          <ns0:quote>antropóloga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An expert in anthropology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropology</ns0:orth>
        <ns0:pron>/ˌænθɹəˈpɑləd͡ʒi/</ns0:pron>
        <ns0:pron>/ˌænθɹəˈpɒləd͡ʒi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The scientific study of humans, systematically describing the ethnographic, linguistic, archaeological, and evolutionary dimensions of humanity using a holistic methodological framework.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropometric</ns0:orth>
        <ns0:pron>/ˌænθɹəpəˈmetɹɪk/</ns0:pron>
        <ns0:pron>/ˌænθɹəpəˈmɛtɹɪk/</ns0:pron>
        <ns0:pron>[ˌɛənθɹəpəˈmɛtɹɪk]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropométrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>of, or relating to anthropometry</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropometry</ns0:orth>
        <ns0:pron>/ænθɹəˈpɒmɪtɹɪ/</ns0:pron>
        <ns0:pron>/ænθɹəˈpɔmɪtɹɪ/</ns0:pron>
        <ns0:pron>/ˌænθɹəˈpɑmɪtɹɪ/</ns0:pron>
        <ns0:pron>[ˌɛənθɹəˈpɑmɪtɹɪ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropometría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The science of measuring the human body to ascertain the ranges and averages of dimensions of the human form, for various purposes including physical anthropology, epidemiology, the ergonomics of industrial design, and so on.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropomorphic</ns0:orth>
        <ns0:pron>/ˌænθɹəpəˈmɔɹfɪk/</ns0:pron>
        <ns0:pron>/ˌænθɹəʊpəʊˈmɔːfɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropomorfo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having the form of a human.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(of anything non-human) Having attributes or characteristics of a human being.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropomorphism</ns0:orth>
        <ns0:pron>/ˌænθɹəpəˈmɔɹfɪzəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropomorfismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The attribution of human characteristics and behavior to something not human. [from mid-18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropomorphization</ns0:orth>
        <ns0:pron>/-faɪˈzeɪʃən/</ns0:pron>
        <ns0:pron>/ˌænθɹɒpəˌmɔːɹfəˈzeɪʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropomorfización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>attributing human characteristics to something that is nonhuman.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropomorphize</ns0:orth>
        <ns0:pron>/ˌanθɹəpəˈmɔːfʌɪz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropomorfizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To attribute human-like characteristics to (something that is non-human).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthroponym</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropónimo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of a person, especially a surname.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthroposophy</ns0:orth>
        <ns0:pron>/ˌænθɹəˈpɑsəfi/</ns0:pron>
        <ns0:pron>/ˌænθɹəˈpɒsəfi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antroposofía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A philosophy founded in the early 20th century by the esotericist Rudolf Steiner (also capitalized as Anthroposophy), postulating the existence of an objective, intellectually comprehensible spiritual world accessible to direct experience through inner development.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anthropotomy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antropotomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) The anatomy or dissection of the human body; androtomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anti-</ns0:orth>
        <ns0:pron>/ˈæn.ti/</ns0:pron>
        <ns0:pron>/ˈæn.tə/</ns0:pron>
        <ns0:pron>/ˈæn.tɪ/</ns0:pron>
        <ns0:pron>/ˈænˌtaɪ/</ns0:pron>
        <ns0:pron>/ˈænˌti/</ns0:pron>
        <ns0:pron>[ˈɛə̯n.ti]</ns0:pron>
        <ns0:pron>[ˈɛə̯n.tə]</ns0:pron>
        <ns0:pron>[ˈɛə̯nˌtaɪ̯]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anti-</ns0:quote>
          <ns0:quote>contra-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Against, opposed to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anti-Americanism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antiamericanismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The fear or dislike of the people, policies, culture or government of the United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>anti-Catalanism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anticatalanismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hostility or discrimination against Catalans.</ns0:def>
        </ns0:sense>
