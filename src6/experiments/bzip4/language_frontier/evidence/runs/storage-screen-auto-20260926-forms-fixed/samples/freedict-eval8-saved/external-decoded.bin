        <ns0:pron>/ˈmɔɹˌfjus/</ns0:pron>
        <ns0:pron>/ˈmɔː.fjuːs/</ns0:pron>
        <ns0:pron>/ˈmɔː.fɪ.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Morfeo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The god and personification of dreams; according to the Roman poet Ovid, one of the sons of Somnus, the god of sleep.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Morse code</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alfabeto Morse</ns0:quote>
          <ns0:quote>código Morse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(telecommunications) A character code represented by dots and dashes (or short and long pulses), originally used to send messages by telegraph, later by flashes of light or by radio.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
