      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soy evangélica</ns0:quote>
          <ns0:quote>soy evangélico</ns0:quote>
          <ns0:quote>soy protestante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
