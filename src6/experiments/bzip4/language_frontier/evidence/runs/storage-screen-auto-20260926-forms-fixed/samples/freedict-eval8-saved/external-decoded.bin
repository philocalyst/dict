        </ns0:cit>
        <ns0:sense>
          <ns0:def>A company that runs auctions.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>auctionable</ns0:orth>
