        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>liebre ártica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A North-American hare of species Lepus arcticus, that is white, usually year round, found in the Arctic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arctic tern</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>charrán ártico</ns0:quote>
          <ns0:quote>gaviotín ártico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A migratory bird that travels between the Arctic and Antarctic, Sterna paradisaea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
