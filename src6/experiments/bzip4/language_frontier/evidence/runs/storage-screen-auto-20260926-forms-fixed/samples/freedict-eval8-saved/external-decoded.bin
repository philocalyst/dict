    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mennonite</ns0:orth>
        <ns0:pron>/ˈmɛnəˌnaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>menonita</ns0:quote>
          <ns0:quote>menonista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of any of a group of Protestant churches or denominations in the Anabaptist tradition, practicing credobaptism and committed to nonresistance and nonviolence, many of whom may wear plain dress and shun modern technology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
