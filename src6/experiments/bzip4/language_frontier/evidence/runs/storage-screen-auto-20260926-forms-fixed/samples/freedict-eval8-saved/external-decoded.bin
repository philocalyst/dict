          <ns0:quote>acetímetro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An instrument for estimating the amount of acetic acid in vinegar</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acetoacetic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido acetoacético</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carboxylic acid) The ketonic carboxylic acid CH3-CO-CH2-COOH, that is present in the urine of people suffering from starvation or some forms of diabetes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
