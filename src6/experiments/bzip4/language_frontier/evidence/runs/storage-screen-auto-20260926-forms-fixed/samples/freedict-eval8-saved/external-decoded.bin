        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>oso viscoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A kind of gummy candy, a type of confectionery made from gelatine, in the miniature form of a toy bear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Gunpowder Plot</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Conspiración de la pólvora</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(British, historical) A failed conspiracy, in November 1605, to kill the Protestant king James I of England and VI of Scotland, and to blow up the House of Lords using gunpowder, annually commemorated on Guy Fawkes Day.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Guria</ns0:orth>
