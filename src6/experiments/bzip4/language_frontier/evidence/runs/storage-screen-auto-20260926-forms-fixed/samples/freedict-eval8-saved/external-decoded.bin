      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>menchevique</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, chiefly, historical) A member of the gradualist or moderate wing of the Russian Social Democratic Labour Party during the years preceding the Russian Revolution, when they split with the Bolsheviks; or a member of a later independent moderate-Marxist party formed in 1917. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
