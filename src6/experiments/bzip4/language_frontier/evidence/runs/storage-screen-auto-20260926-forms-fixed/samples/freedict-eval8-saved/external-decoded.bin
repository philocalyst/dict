      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborigen</ns0:quote>
          <ns0:quote>indígena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A native inhabitant of a country; a member of the original people. [First attested in the early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abort</ns0:orth>
        <ns0:pron>/əˈbɔɹt/</ns0:pron>
        <ns0:pron>/əˈbɔːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, rare) The product of a miscarriage; an aborted offspring; an abortion. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete) A miscarriage; an untimely birth; an abortion. [Attested from around (1350 to 1470) until the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abort</ns0:orth>
        <ns0:pron>/əˈbɔɹt/</ns0:pron>
        <ns0:pron>/əˈbɔːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, biology) To cause an organism to develop minimally; to cause rudimentary development to happen; to prevent maturation. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aborted</ns0:orth>
        <ns0:pron>/əˈbɔɹtɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Brought forth prematurely.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Checked in normal development at an early stage.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology) Rendered abortive or sterile; undeveloped.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortifacient</ns0:orth>
        <ns0:pron>/əˌbɔɹ.təˈfeɪ.ʃn̩t/</ns0:pron>
        <ns0:pron>/əˌbɔɹ.tɪˈfeɪ.ʃn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical effect) Producing miscarriage. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortifacient</ns0:orth>
        <ns0:pron>/əˌbɔɹ.təˈfeɪ.ʃn̩t/</ns0:pron>
        <ns0:pron>/əˌbɔɹ.tɪˈfeɪ.ʃn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A drug or an agent that induces an abortion. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortion</ns0:orth>
        <ns0:pron>/əˈbɔɹ.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborto</ns0:quote>
          <ns0:quote>abortamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medicine) The expulsion from the womb of a foetus or embryo before it is fully developed, with loss of the foetus.[from 16th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(biology) Arrest of development of any organ, so that it remains an imperfect formation or is absorbed. [from 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborto</ns0:quote>
          <ns0:quote>aborto inducido</ns0:quote>
          <ns0:quote>abortamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An induced abortion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborto</ns0:quote>
          <ns0:quote>engendro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively) A misshapen person or thing; a monstrosity. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortion clinic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abortorio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A clinic where abortions are performed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abortional</ns0:orth>
        <ns0:pron>/əˈbɔɹ.ʃn̩.l̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
