      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>japonofilia</ns0:quote>
          <ns0:quote>nipofilia</ns0:quote>
          <ns0:quote>niponofilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strong interest in the country, culture, or people of Japan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
