          <ns0:quote>tumbona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A special chair designed to provide comfort and protection from sun, wind, rain, and sand on beaches frequented by tourists.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beach towel</ns0:orth>
      </ns0:form>
