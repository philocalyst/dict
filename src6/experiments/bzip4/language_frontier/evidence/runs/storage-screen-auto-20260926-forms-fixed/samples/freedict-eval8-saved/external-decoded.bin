        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar de Chukotka</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marginal sea of the Arctic Ocean, between Chukotka and Alaska.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
