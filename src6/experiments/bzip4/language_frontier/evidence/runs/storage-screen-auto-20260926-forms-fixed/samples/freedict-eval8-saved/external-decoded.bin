        <ns0:pron>/əˈbɑm.nə.bl̩/</ns0:pron>
        <ns0:pron>/əˈbɑm.ə.nə.bl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abominable</ns0:quote>
          <ns0:quote>aborrecible</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Worthy of, or causing, abhorrence, as a thing of evil omen; odious in the utmost degree; very hateful; detestable; loathsome; execrable. [first attested around 1150 to 1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
