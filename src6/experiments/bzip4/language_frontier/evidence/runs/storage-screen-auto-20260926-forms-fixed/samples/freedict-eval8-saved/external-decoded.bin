        <ns0:pron>/ˈɑːkwəˌ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuicultura</ns0:quote>
          <ns0:quote>acuacultura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The cultivation of aquatic produce such as aquatic plants, fish, and other aquatic animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquaculturist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuicultor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(agriculture) A person involved in aquaculture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquamarine</ns0:orth>
        <ns0:pron>/ˌæk.wə.məˈɹiːn/</ns0:pron>
        <ns0:pron>/ˌɑ.kwə.məˈɹiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguamarina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The bluish-green colour of the sea.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A transparent bluish-green, sometimes yellow-green, variety of beryl.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquanaut</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuanauta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An underwater explorer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquapark</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>parque acuático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A water park.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquaplane</ns0:orth>
        <ns0:pron>/ˈækwəpleɪn/</ns0:pron>
        <ns0:pron>/ˈækwəˌpleɪn/</ns0:pron>
        <ns0:pron>/ˌækwəˈpleɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacer aquaplaning</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension, chiefly, Britain, automotive) Of a car or other road vehicle: to lose traction with the road due to the vehicle's tyres sliding on a film of water on the road.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquaplaning</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuaplaneo</ns0:quote>
          <ns0:quote>hidroplaneo</ns0:quote>
          <ns0:quote>aquaplaning</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(automotive, UK) The loss of contact with the road because of surface water; the act of aquaplaning.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquaponics</ns0:orth>
        <ns0:pron>/(ˌ)ækwəˈpɒnɪks/</ns0:pron>
        <ns0:pron>/ˌækwə-/</ns0:pron>
        <ns0:pron>/ˌɑkwəˈpɑnɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuaponía</ns0:quote>
          <ns0:quote>acuiponía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(agriculture) A sustainable food production system that combines traditional aquaculture with hydroponics, with effluent from the water in which fish are reared being used as nutrition for plants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquaporin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuaporina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(protein) Any of a class of proteins that form water-permeable pores in the membrane of biological cells.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquarelle</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuarela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A watercolour (painting)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquariology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuariología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of the fauna and flora of aquaria</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquarist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuarista</ns0:quote>
          <ns0:quote>acuariófila</ns0:quote>
          <ns0:quote>acuariófilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who maintains an aquarium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquarium</ns0:orth>
        <ns0:pron>/-ɛɹiəm/</ns0:pron>
        <ns0:pron>/əˈkwɛɹ.i.jəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuario</ns0:quote>
          <ns0:quote>pecera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tank, often made of glass, for keeping live fish or other aquatic animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuario</ns0:quote>
          <ns0:quote>acuárium</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A public place where live fish and other aquatic animals are exhibited.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquatic</ns0:orth>
        <ns0:pron>/ɘˈkwɔ.tɘk/</ns0:pron>
        <ns0:pron>/əˈkwæ.tɪk/</ns0:pron>
        <ns0:pron>/əˈkwɑ.tɪk/</ns0:pron>
        <ns0:pron>/əˈkwɒ.tɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuático</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to water; living in or near water, taking place in water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquatic warbler</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carricerín cejudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small passerine bird, Acrocephalus paludicola, of the warbler family (Sylviidae)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquatubular</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuatubular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of a boiler: having water-filled heated tubes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aqueduct</ns0:orth>
        <ns0:pron>/ˈæk.wəˌdʌkt/</ns0:pron>
        <ns0:pron>/ˈæk.wɪˌdʌkt/</ns0:pron>
        <ns0:pron>/ˈɑk.wəˌdʌkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acueducto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An artificial channel that is constructed to convey water from one location to another.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A structure carrying water over a river or depression, especially an ancient structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aqueous</ns0:orth>
        <ns0:pron>/ˈa.kwi.əs/</ns0:pron>
        <ns0:pron>/ˈeɪ.kwi.əs/</ns0:pron>
        <ns0:pron>/ˈæ.kwi.əs/</ns0:pron>
        <ns0:pron>/ˈɑ.kwi.əs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physical chemistry) Consisting mostly of water. Often used in the expression "aqueous solution".</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aqueous humour</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>humor acuoso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ophthalmology) The clear, watery fluid that fills the front of the eye between the cornea and the crystalline lens.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquifer</ns0:orth>
        <ns0:pron>/ˈækwɪfə/</ns0:pron>
        <ns0:pron>/ˈækwɪfɝ/</ns0:pron>
        <ns0:pron>/ˈɑkwɪfɝ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuífero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An underground layer of water-bearing porous stone, earth, or gravel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquiferous</ns0:orth>
        <ns0:pron>/æˈkwɪfəɹəs/</ns0:pron>
        <ns0:pron>/əˈkwɪfəɹəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acuífero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) Of or pertaining to an aquifer</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Carrying water</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquiline</ns0:orth>
        <ns0:pron>/ˈæk.wɪˌlaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguileño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or characteristic of eagles; resembling that of an eagle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aquiline nose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nariz aguileña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A nose with a hooked, bent shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ar</ns0:orth>
        <ns0:pron>/ˈaɹ/</ns0:pron>
        <ns0:pron>/ˈäːɹ/</ns0:pron>
        <ns0:pron>/ˈɑɹ/</ns0:pron>
        <ns0:pron>/ˈɑɹə/</ns0:pron>
        <ns0:pron>/ˈɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>erre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of the Latin-script letter R/r.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>araba</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>araba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A horse-drawn carriage once used for transportation in pre-modern Turkey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arabesque</ns0:orth>
        <ns0:pron>/ˌæɹ.əˈbɛsk/</ns0:pron>
        <ns0:pron>/ˌɛɹ.əˈbɛsk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arabesco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(art, architecture, also, attributively) An elaborate design of intertwined floral figures or complex geometrical patterns, mainly used in Islamic art and architecture.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(music) An ornate composition, especially for the piano.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arabinose</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arabinosa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carbohydrate) An aldopentose that occurs most often in polysaccharides such as hemicellulose and pectin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arable</ns0:orth>
        <ns0:pron>/ˈæɹəbl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arable</ns0:quote>
          <ns0:quote>cultivable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(agriculture, of land) Able to be plowed or tilled, capable of growing crops (traditionally contrasted with pasturable lands such as heaths).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(agriculture, NGO, _, jargon, of land) Under cultivation (within any quinquennial period) for the production of crops sown and harvested within the same agricultural year (contrasted with permanently-cropped lands such as orchards).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arachidonate</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>araquidonato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any salt or ester of arachidonic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arachidonic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido araquidónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(fatty acid) A long-chain polyunsaturated fatty acid, having 20 carbon atoms and four double bonds, found in animal fats; it is essential for human nutrition, being a precursor to the production of prostaglandins.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arachnid</ns0:orth>
        <ns0:pron>/əˈɹæknɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arácnido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of the eight-legged creatures, including spiders, mites, and scorpions, of the class Arachnida.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arachnoid mater</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aracnoides</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The middle layer of the meninges; a membrane that protects the brain and spinal cord below the dura mater and above the subarachnoid space and the pia mater.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arachnology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aracnología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of the Arachnida.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arachnophobia</ns0:orth>
        <ns0:pron>/æˌɹæk.nəˈfəʊ.bɪ.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aracnofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abnormal or irrational fear of arachnids, especially spiders.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aragonite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aragonito</ns0:quote>
          <ns0:quote>aragonita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mineral) An evaporite consisting of anhydrous calcium carbonate with the chemical formula CaCO3 and occurring in pearls, shells and nacre; it is dimorphous with calcite.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>araucaria</ns0:orth>
        <ns0:pron>/arɔːˈkɛːri.ə/</ns0:pron>
        <ns0:pron>/rɑˈ-/&lt;aa:cot-caught&gt;</ns0:pron>
        <ns0:pron>/ærɔˈkɛ.ri.ə/</ns0:pron>
        <ns0:pron>/ɛr-/&lt;aa:Mmmm&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>araucaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An individual plant (tree) of the genus Araucaria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbiter</ns0:orth>
        <ns0:pron>/ˈaː.bɪ.tə(ɹ)/</ns0:pron>
        <ns0:pron>/ˈɑɹ.bɪ.tɚ/</ns0:pron>
        <ns0:pron>/ˈɑː.bɪ.tə(ɹ)/</ns0:pron>
        <ns0:pron>[ˈɑɹ.bɪ.ɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>árbitro</ns0:quote>
          <ns0:quote>arbitrador</ns0:quote>
          <ns0:quote>árbitra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person appointed, or chosen, by parties to determine a controversy between them; an arbitrator.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitrage</ns0:orth>
        <ns0:pron>/ˈɑɹ.bɪ.tɹɪd͡ʒ/</ns0:pron>
        <ns0:pron>/ˈɑɹbɪˌtɹɑʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitraje de valores mercantiles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) A market activity in which a security, commodity, currency or other tradable item is bought in one market and sold simultaneously in another, in order to profit from price differences between the markets.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitrager</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitrajista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) One who participates in arbitrage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitral</ns0:orth>
        <ns0:pron>/ˈɑːbɪtɹəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitral</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to arbitration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitrarily</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitrariamente</ns0:quote>
          <ns0:quote>a dedo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an arbitrary manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitrary</ns0:orth>
        <ns0:pron>/ˈɑɹ.bɪˌtɹɛ(ə).ɹi/</ns0:pron>
        <ns0:pron>/ˈɑː.bɪ.tɹi/</ns0:pron>
        <ns0:pron>/ˈɑː.bɪ.tɹə.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitrario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(usually, of a decision) Based on individual discretion or judgment; not based on any objective distinction, perhaps even made at random.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Determined by impulse rather than reason; often connoting heavy-handedness.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) Any, out of all that are possible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitrate</ns0:orth>
        <ns0:pron>/ˈɑːbɪtɹeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To make a judgment (on a dispute) as an arbitrator or arbiter</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitration</ns0:orth>
        <ns0:pron>/ˌɑɹ.bɪˈtɹeɪ.ʃən/</ns0:pron>
        <ns0:pron>/ˌɑː.bɪˈtɹeɪ.ʃən/</ns0:pron>
        <ns0:pron>[ˌɑɹ.bəˈt̠͡ɹ̠eɪ.ʃn̩]</ns0:pron>
        <ns0:pron>[ˌɑː.bəˈt̠͡ɹ̠eɪ.ʃn̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbitraje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act or process of arbitrating.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbitrator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>árbitro</ns0:quote>
          <ns0:quote>árbitra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person to whom the authority to settle or judge a dispute is delegated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbor</ns0:orth>
        <ns0:pron>/ˈaːbə/</ns0:pron>
        <ns0:pron>/ˈɑɹbɚ/</ns0:pron>
        <ns0:pron>/ˈɑːbə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cenador</ns0:quote>
          <ns0:quote>pérgola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A shady sitting place or pergola usually in a park or garden, surrounded by climbing shrubs, vines or other vegetation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arboreal</ns0:orth>
        <ns0:pron>/ɑɹˈbɔɹi.əl/</ns0:pron>
        <ns0:pron>/ɑːˈbɔːɹɪ.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbóreo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, relating to, or resembling a tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arborícola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Living in or among trees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arborescence</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arborescencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A tree-like structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arboretum</ns0:orth>
        <ns0:pron>/ɑː(ɹ)bəˈɹiːtəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arboreto</ns0:quote>
          <ns0:quote>arboretum</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A place where many varieties of tree are grown for research, educational, and ornamental purposes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arboricide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arboricida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any herbicide intended to kill trees or shrubs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arboricidio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncommon) The killing of a tree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arboriculture</ns0:orth>
        <ns0:pron>/ɑːɹˈbɔːɹ.ɪˌkʌl.t͡ʃɚ/</ns0:pron>
        <ns0:pron>/ɑːˈbɒɹ.ɪˌkʌlt͡ʃə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arboricultura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The branch of horticulture concerned with the planting, growth, and maintenance of trees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arboriculturist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arboricultor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who practices arboriculture; a tree surgeon.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arboriform</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arboriforme</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Resembling a tree in shape or appearance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arbutin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arbutina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) A glycoside of hydroquinone, found in bearberry, that is used to treat some diseases of the urinary tract</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arc</ns0:orth>
        <ns0:pron>/ɑɹk/</ns0:pron>
        <ns0:pron>/ɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arco</ns0:quote>
          <ns0:quote>curva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) A continuous part of the circumference of a circle (circular arc) or of another curve. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>curva</ns0:quote>
          <ns0:quote>arco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A curve, in general. [from 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(electrics) A flow of current across an insulating medium; especially a hot, luminous discharge either between two electrodes or as lightning. [from 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arcade</ns0:orth>
        <ns0:pron>/ɑɹˈkeɪd/</ns0:pron>
        <ns0:pron>/ɑːˈkeɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A row of arches.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>galería</ns0:quote>
          <ns0:quote>galería comercial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A covered passage, usually with shops on both sides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arcane</ns0:orth>
        <ns0:pron>/ɑɹˈkeɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcano</ns0:quote>
          <ns0:quote>misterioso</ns0:quote>
          <ns0:quote>secreto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Understood by only a few.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arccosecant</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcocosecante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(trigonometry) function that is the compositional inverse of the cosecant function. Symbol: arccsc</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arccosine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcocoseno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(trigonometry) Any of several single-valued or multivalued functions that are inverses of the cosine function.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arccotangent</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcocotangente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(trigonometry) An inverse of the cotangent function. Symbol: arccot</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arch</ns0:orth>
        <ns0:pron>/ɑɹk/</ns0:pron>
        <ns0:pron>/ɑɹt͡ʃ/</ns0:pron>
        <ns0:pron>/ɑːk/</ns0:pron>
        <ns0:pron>/ɑːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pícaro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Knowing, clever, mischievous.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Principal; primary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arch</ns0:orth>
        <ns0:pron>/ɑɹk/</ns0:pron>
        <ns0:pron>/ɑɹt͡ʃ/</ns0:pron>
        <ns0:pron>/ɑːk/</ns0:pron>
        <ns0:pron>/ɑːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An inverted U shape.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An arch-shaped arrangement of trapezoidal stones, designed to redistribute downward force outward.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(architecture) An architectural element having the shape of an arch</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The curved part of the bottom of a foot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arch</ns0:orth>
        <ns0:pron>/ɑɹk/</ns0:pron>
        <ns0:pron>/ɑɹt͡ʃ/</ns0:pron>
        <ns0:pron>/ɑːk/</ns0:pron>
        <ns0:pron>/ɑːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arquear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To form into an arch shape.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>arch-</ns0:orth>
        <ns0:pron>/ɑ(ɹ)k/</ns0:pron>
        <ns0:pron>/ɑː(ɹ)t͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archi-</ns0:quote>
          <ns0:quote>arzo-</ns0:quote>
          <ns0:quote>arqui-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A title in a hierarchy which indicates a higher degree of rank than its root word.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Leading, foremost, primary, or principal.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(augmentative) Intensely, extremely, or exceptionally.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeastronomy</ns0:orth>
        <ns0:pron>/ˌɑː(ɹ)ki.əsˈtɹɒnəmi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueoastronomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy, archaeology) The historical, especially archeological, study of astronomy; the study of the astronomical systems and methods of ancient cultures often embracing the astrology and cosmology of the past.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeo-</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>ancient, early, primitive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeoastronomer</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueoastrónomo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An astronomer whose speciality is archaeoastronomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeoastronomical</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueoastronómico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) Relating to archaeastronomy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeogenetics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueogenética</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaeology, genetics) The application of population genetics to archaeology</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeolinguistics</ns0:orth>
        <ns0:pron>/ˌɑɹki.ə.lɪŋˈɡwɪs.tɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueolingüística</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of the distant human past using archaeological and linguistic evidence together to reconstruct aspects of past cultures.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeological</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueológico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to the science or research of archaeology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeologist</ns0:orth>
        <ns0:pron>/ˌɑɹ.kiˈɑ.lə.d͡ʒɪst/</ns0:pron>
        <ns0:pron>/ˌɑː.kiˈɒl.ə.d͡ʒɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueólogo</ns0:quote>
          <ns0:quote>arqueóloga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Someone who studies or practises archaeology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeology</ns0:orth>
        <ns0:pron>/ˌɐː.kiˈɒl.ə.d͡ʒi/</ns0:pron>
        <ns0:pron>/ˌɐː.kiˈɔl.ə.d͡ʒi/</ns0:pron>
        <ns0:pron>/ˌɑɹ.kiˈɑ.lə.d͡ʒi/</ns0:pron>
        <ns0:pron>/ˌɑɹ.kiˈɒl.ə.d͡ʒi/</ns0:pron>
        <ns0:pron>/ˌɑː.kiˈɒl.ə.d͡ʒi/</ns0:pron>
        <ns0:pron>[ˌɐː.kiˈɔ̟l.ə.d͡ʒi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The study of the past by excavation and analysis of its material remains.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeomagnetism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueomagnetismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology, physics) The magnetism of the Earth in the geologic past; the study and measurement of this magnetism in order to date a specimen with iron.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeometry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueometría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaeology) The application of techniques and methodologies of the natural sciences to archaeology, mostly for dating, analysis, survey and confirmation of provenance or authenticity.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arquea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A prokaryotic organism; a member of the domain Archaea [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeopathology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueopatología</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeophyte</ns0:orth>
        <ns0:pron>/ɑɹˈki.əˌfaɪt/</ns0:pron>
        <ns0:pron>/ɑːˈkiː.əˌfaɪt/</ns0:pron>
        <ns0:pron>/ˈɑɹ.ki.əˌfaɪt/</ns0:pron>
        <ns0:pron>/ˈɑː.ki.əˌfaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueófito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany) A plant which was introduced to an area by humans (or arrived naturally, but from an area in which it was present as a human introduction) and became naturalized before 1500 C.E. (but especially in prehistoric times).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaeozoology</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arqueozoología</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaeology) The study of relationships between humans and animals over time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaic</ns0:orth>
        <ns0:pron>/ɐːˈkæɪ.ɪk/</ns0:pron>
        <ns0:pron>/ɑ(r).ke.jɪk/</ns0:pron>
        <ns0:pron>/ɑɹˈkeɪ.ɪk/</ns0:pron>
        <ns0:pron>/ɑːˈkeɪ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcaico</ns0:quote>
          <ns0:quote>arcaizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or characterized by antiquity; old-fashioned, quaint, antiquated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaic smile</ns0:orth>
        <ns0:pron>/ɑɹˌkeɪɪk ˈsmaɪl/</ns0:pron>
        <ns0:pron>/ɑːˌkeɪɪk ˈsmaɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sonrisa arcaica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Ancient Greece, art, sculpture, historical) A smiling facial expression commonly found on Greek statues of the Archaic period (circa 700–500 B.C.E.).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archaism</ns0:orth>
        <ns0:pron>/ɑːˈkeɪ.ɪ.zəm/&lt;a:UK&gt;</ns0:pron>
        <ns0:pron>/ˈaː.kæɪ.ɪz.əm/</ns0:pron>
        <ns0:pron>/ˈɑɹ.keɪˌɪz.əm/</ns0:pron>
        <ns0:pron>/ˈɑɹ.kiˌɪz.əm/</ns0:pron>
        <ns0:pron>/ˈɑː.keɪ.ɪz.əm/&lt;a:UK&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcaísmo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An archaic word, style, etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archangel</ns0:orth>
        <ns0:pron>/ɑː(ɹ)ˈkeɪn.d͡ʒəl/</ns0:pron>
        <ns0:pron>/ˈɑː(ɹ).keɪn.d͡ʒəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arcángel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A powerful angel that leads many other angels, but is still loyal to a deity, and often seen as belonging to a particular archangelical rank or order within a greater hierarchy of angels. (Judeo-Christian examples: Gabriel, Michael, Raphael, Uriel).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archbishop</ns0:orth>
