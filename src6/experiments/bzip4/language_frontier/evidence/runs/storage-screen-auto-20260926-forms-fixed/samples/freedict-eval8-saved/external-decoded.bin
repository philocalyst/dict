        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Weser</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river in northwestern Germany, the longest entirely in the country, flowing north from south Lower Saxony into the North Sea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
