      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albornoz</ns0:quote>
          <ns0:quote>bata de baño</ns0:quote>
          <ns0:quote>salida de baño</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A robe usually made of terrycloth intended to be worn when one is still damp from bathing or when there is no immediate need to dress fully.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathroom</ns0:orth>
        <ns0:pron>/ˈbæθɹuːm/</ns0:pron>
        <ns0:pron>/ˈbæθɹʊm/</ns0:pron>
        <ns0:pron>/ˈbæθˌɹum/</ns0:pron>
        <ns0:pron>/ˈbɑːθɹuːm/</ns0:pron>
        <ns0:pron>/ˈbɑːθɹʊm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cuarto de baño</ns0:quote>
          <ns0:quote>baño</ns0:quote>
          <ns0:quote>lavabo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, US, South Africa, Canada, Philippines, Australia, euphemism) A lavatory (area where one washes or bathes): a room containing a toilet and (typically but not necessarily) a bathtub.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathroom break</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asueto para ir al escusado</ns0:quote>
          <ns0:quote>intermisión para ir al lavabo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathtub</ns0:orth>
        <ns0:pron>/ˈbaːtːʊb/</ns0:pron>
        <ns0:pron>/ˈbæθtʊb/</ns0:pron>
        <ns0:pron>/ˈbæθtʌb/</ns0:pron>
        <ns0:pron>/ˈbɑːθtʌb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bañera</ns0:quote>
          <ns0:quote>bañadera</ns0:quote>
          <ns0:quote>tina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A large container for holding water in which a person may bathe (take a bath).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathymetric</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batimétrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, or derived from bathymetry.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathymetry</ns0:orth>
        <ns0:pron>/bəˈθɪm.ə.tɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batimetría</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The measurement of the depths of the seas and oceans.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathyscaphe</ns0:orth>
        <ns0:pron>/ˈbæθɪˌskeɪv/</ns0:pron>
        <ns0:pron>/ˈbæθɪˌskæf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batiscafo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A self-propelled deep-sea diving submersible for exploring the ocean depths, consisting of a crew cabin similar to a bathysphere suspended below a float filled with a buoyant liquid such as petrol.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bathysphere</ns0:orth>
        <ns0:pron>/ˈbæθɪˌsfɪə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batisfera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A spherical steel deep-diving chamber with perspex windows, in which persons are lowered to the depths by a cable to study the oceans and deep-sea life; the precursor to the bathyscaphe</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batik</ns0:orth>
        <ns0:pron>/bəˈtiːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batik</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wax-resist method of dyeing fabric.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batiste</ns0:orth>
        <ns0:pron>/bəˈtiːst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fine cloth made from cotton or linen; cambric.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baton</ns0:orth>
        <ns0:pron>/bəˈtɑn/</ns0:pron>
        <ns0:pron>/ˈbæt(ə)n/</ns0:pron>
        <ns0:pron>/ˈbætɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batuta</ns0:quote>
          <ns0:quote>porra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) A ceremonial staff of a field marshal or a similar high-ranking military office.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batuta</ns0:quote>
          <ns0:quote>porra</ns0:quote>
          <ns0:quote>rolo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) The stick of a conductor in musical performances.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>testigo</ns0:quote>
          <ns0:quote>testimonio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sports) An object transferred by runners in a relay race.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batonnet</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batonnet</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A piece of vegetable cut into the shape of a small stick.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pieces of fabric or fibre used for stuffing; as for batting or insulation</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battalion</ns0:orth>
        <ns0:pron>/bəˈtæliən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batallón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) An army unit having two or more companies, etc. and a headquarters. Traditionally forming part of a regiment.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(US, military) an army unit having two or more companies, etc. and a headquarters; forming part of a brigade.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Any large body of troops.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batten</ns0:orth>
        <ns0:pron>/ˈbæt(ə)n/</ns0:pron>
        <ns0:pron>/ˈbætən/</ns0:pron>
        <ns0:pron>[-ɾən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>listón</ns0:quote>
          <ns0:quote>alfarda</ns0:quote>
          <ns0:quote>barreta</ns0:quote>
          <ns0:quote>ristrel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carpentry, construction) A plank or strip of wood, or several of such strips arranged side by side, used in construction to hold members of a structure together, to provide a fixing point, to strengthen, or to prevent warping.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>filete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) A long, narrow strip, originally of wood but now also of fibreglass, metal, etc., used for various purposes aboard a ship; especially one attached to a mast or spar for protection, one holding down the edge of a tarpaulin covering a hatch to prevent water from entering the hatch, one inserted in a pocket sewn on a sail to keep it flat, or one from which a hammock is suspended.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batten</ns0:orth>
        <ns0:pron>/ˈbæt(ə)n/</ns0:pron>
        <ns0:pron>/ˈbætən/</ns0:pron>
        <ns0:pron>[-ɾən]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aprovecharse</ns0:quote>
          <ns0:quote>medrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) Followed by on: to prosper or thrive, especially at the expense of others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cebar</ns0:quote>
          <ns0:quote>mejorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To become better; to improve in condition; especially of animals, by feeding; to fatten up. [from late 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batten down the hatches</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cerrar las escotillas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) To prepare for trouble.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batter</ns0:orth>
        <ns0:pron>/ˈbætə/</ns0:pron>
        <ns0:pron>/ˈbætɚ/</ns0:pron>
        <ns0:pron>[ˈbæɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batido</ns0:quote>
          <ns0:quote>rebozado</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pendiente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) An incline on the outer face of a built wall.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bateador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(baseball) The player attempting to hit the ball with a bat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>botellón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable, slang) A binge; a heavy drinking session.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batter</ns0:orth>
        <ns0:pron>/ˈbætə/</ns0:pron>
        <ns0:pron>/ˈbætɚ/</ns0:pron>
        <ns0:pron>[ˈbæɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apalear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To hit or strike violently and repeatedly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rebozar</ns0:quote>
          <ns0:quote>apanar</ns0:quote>
          <ns0:quote>empanar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cooking) To coat with batter (the food ingredient).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battered</ns0:orth>
        <ns0:pron>/ˈbætəd/</ns0:pron>
        <ns0:pron>/ˈbætəɹd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>maltrecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Beaten up through a lot of use; in rough condition; weathered.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battering ram</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ariete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A heavy object used for battering down walls and gates or a siege engine that includes such an object.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battery</ns0:orth>
        <ns0:pron>/ˈbaʈ.(ə)ri/</ns0:pron>
        <ns0:pron>/ˈbæt.(ə)ɹi/</ns0:pron>
        <ns0:pron>/ˈbæt.əɹi/</ns0:pron>
        <ns0:pron>/ˈbæt͡ʃɹi/&lt;q:except sense 2&gt;</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pila</ns0:quote>
          <ns0:quote>batería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(electrical, electronics, countable) A device used to power electric devices, consisting of one or more electrically connected electrochemical cells or (archaically) electrostatic cells.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>agresión</ns0:quote>
          <ns0:quote>golpes</ns0:quote>
          <ns0:quote>lesiones</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The infliction of unlawful physical violence on a person, legally distinguished from assault, which involves the threat of impending violence.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batería</ns0:quote>
          <ns0:quote>pila</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, countable) A coordinated group of artillery weapons, with any of various numbers of guns.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>An array of similar things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batería</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(baseball) The catcher and the pitcher together</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battery life</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>duración de la batería</ns0:quote>
          <ns0:quote>autonomía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The time that a battery lasts</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batting</ns0:orth>
        <ns0:pron>/ˈbætɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guata</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sewing) Cotton, wool, silk or synthetic material used to stuff the inside of a mattress, quilt etc.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battle</ns0:orth>
        <ns0:pron>/ˈbætl̩/</ns0:pron>
        <ns0:pron>[bætɫ̩]</ns0:pron>
        <ns0:pron>[ˈbatʰɫ̩]</ns0:pron>
        <ns0:pron>[ˈbæɾɫ̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batalla</ns0:quote>
          <ns0:quote>lucha</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) A general action, fight, or encounter, in which all the divisions of an army are or may be engaged; a combat, an engagement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battle</ns0:orth>
        <ns0:pron>/ˈbætl̩/</ns0:pron>
        <ns0:pron>[bætɫ̩]</ns0:pron>
        <ns0:pron>[ˈbatʰɫ̩]</ns0:pron>
        <ns0:pron>[ˈbæɾɫ̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batallar</ns0:quote>
          <ns0:quote>luchar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To join in battle; to contend in fight</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battle axe</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hacha de armas</ns0:quote>
          <ns0:quote>hacha bélica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An ancient military weapon, an axe designed for combat, including (in, _, heraldiccharge) when borne on arms as a mark of prowess.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battle cry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grito de guerra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military) An exclamation troops yell out when going to war or battle.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battle rope</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>soga batallarosa</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battle-hardened</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguerrido</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battlecruiser</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>crucero de batalla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(military, nautical) A fast warship with thicker armor and heavier guns than a typical cruiser, but with armor, armament, or both still inferior to that of a dreadnought battleship; designed to act as an advanced scout of the battle fleet and to destroy enemy cruisers.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(fiction) A warship of intermediate size and/or capability between a heavy cruiser and a (light) battleship.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battledore</ns0:orth>
        <ns0:pron>/ˈbæ.təl.dɔː/</ns0:pron>
        <ns0:pron>/ˈbæ.tɫ̩.dɔɹ/</ns0:pron>
        <ns0:pron>/ˈbæ.tɫ̩.dɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pala de lavar</ns0:quote>
          <ns0:quote>moza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A wooden paddle-shaped bat or beetle used to wash clothes by beating, stirring, or smoothing them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battlefield</ns0:orth>
        <ns0:pron>/ˈbætəlˌfiːld/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campo de batalla</ns0:quote>
          <ns0:quote>campo batallaroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The area where a land battle is fought, which may not necessarily be a field.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battlefront</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frente de batalla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The region or line along which opposing armies engage in combat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battlement</ns0:orth>
        <ns0:pron>[ˈbætəɫmənt]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>almena</ns0:quote>
          <ns0:quote>almenado</ns0:quote>
          <ns0:quote>almenaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In fortification: an indented parapet, formed by a series of rising members called cops or merlons, separated by openings called crenelles or embrasures, the soldier sheltering himself behind the merlon while he fires through the embrasure or through a loophole in the battlement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battler</ns0:orth>
        <ns0:pron>/ˈbæt.lə(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>batallador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who wages battle against an enemy; a soldier; a general.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>battleship</ns0:orth>
        <ns0:pron>/ˈbætəlˌʃɪp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acorazado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(science fiction, by extension) A starship of comparable role</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(military, nautical, archaic) A ship of the line.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>batty</ns0:orth>
        <ns0:pron>/ˈbæti/</ns0:pron>
        <ns0:pron>[ˈbæɾi]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>loco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang) Mad, crazy, silly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bauble</ns0:orth>
        <ns0:pron>/ˈbɑbəl/</ns0:pron>
        <ns0:pron>/ˈbɔbəl/</ns0:pron>
        <ns0:pron>[ˈbɒbəɫ]</ns0:pron>
        <ns0:pron>[ˈbɔːbəɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baratija</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A cheap showy ornament or piece of jewellery; a gewgaw.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bola de navidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small shiny spherical decoration, commonly put on Christmas trees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bauhinia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bauhinia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of flowering plants of the Bauhinia genus, some of which are known as orchid trees.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bauxite</ns0:orth>
        <ns0:pron>/ˈbaksaɪt/</ns0:pron>
        <ns0:pron>/ˈbɔːksaɪt/</ns0:pron>
        <ns0:pron>/ˈbɔːksʌɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bauxita</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The principal ore of aluminium; a clay-like mineral, being a mixture of hydrated oxides and hydroxides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bavarois</ns0:orth>
        <ns0:pron>/ˌbævə(ɹ)ˈwɑː/</ns0:pron>
        <ns0:pron>/ˌbɑvɚˈwɑ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bavarois</ns0:quote>
          <ns0:quote>bavaroise</ns0:quote>
          <ns0:quote>crema bávara</ns0:quote>
          <ns0:quote>crème bavaroise</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pudding similar to pastry cream but thickened with gelatin or isinglass instead of flour or cornstarch, and flavoured with liqueur.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bawdy</ns0:orth>
        <ns0:pron>/ˈbɑ.di/</ns0:pron>
        <ns0:pron>/ˈbɔ.di/</ns0:pron>
        <ns0:pron>/ˈbɔːdi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guarro</ns0:quote>
          <ns0:quote>lascivo</ns0:quote>
          <ns0:quote>sucio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Obscene; filthy; unchaste. [from 15th Century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bawl</ns0:orth>
        <ns0:pron>/bɑl/</ns0:pron>
        <ns0:pron>/bɔl/</ns0:pron>
        <ns0:pron>[bɔːɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alarido</ns0:quote>
          <ns0:quote>grito</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A loud, intense shouting or wailing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bawl</ns0:orth>
        <ns0:pron>/bɑl/</ns0:pron>
        <ns0:pron>/bɔl/</ns0:pron>
        <ns0:pron>[bɔːɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gritar</ns0:quote>
          <ns0:quote>gritonear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To shout or utter in a loud and intense manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>llantear</ns0:quote>
          <ns0:quote>plañir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To wail; to give out a blaring cry.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To weep profusely.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bay</ns0:orth>
