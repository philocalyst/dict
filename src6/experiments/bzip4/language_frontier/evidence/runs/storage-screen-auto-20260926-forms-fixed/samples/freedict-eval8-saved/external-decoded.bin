      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a popa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) At, near, or towards the stern of a vessel (with the frame of reference within the vessel).</ns0:def>
        </ns0:sense>
