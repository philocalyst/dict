        <ns0:pron>/ɔlˈɹɛdi/</ns0:pron>
        <ns0:pron>/ɔːlˈɹɛdi/</ns0:pron>
        <ns0:pron>/əlˈrɛɖi/</ns0:pron>
        <ns0:pron>/ˈɔlˌrɛɖi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Prior to some specified time, either past, present, or future; by this time; previously.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>So soon.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(US, CA) An intensifier used to emphasize impatience or express exasperation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>also</ns0:orth>
        <ns0:pron>/ˈɑl.soʊ/</ns0:pron>
        <ns0:pron>/ˈɑlt.soʊ/</ns0:pron>
        <ns0:pron>/ˈɔl.soʊ/</ns0:pron>
