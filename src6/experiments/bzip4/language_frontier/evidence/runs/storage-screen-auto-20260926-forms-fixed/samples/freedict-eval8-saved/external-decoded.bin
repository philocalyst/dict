        <ns0:pron>/ˈɹɔːʃɑːk tɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>test de Rorschach</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(psychology) A method of psychological evaluation that uses a person's interpretations of inkblots or similar images to discover information concerning his or her personality, emotional functioning, or unconscious mind.</ns0:def>
        </ns0:sense>
      </ns0:sense>
