        <ns0:orth>abominably</ns0:orth>
        <ns0:pron>/əˈbɑm.nə.bli/</ns0:pron>
        <ns0:pron>/əˈbɑm.ə.nə.bli/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abominablemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an abominable manner; very odiously; detestably. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abominate</ns0:orth>
        <ns0:pron>/əˈbɒm.ə.nət/</ns0:pron>
        <ns0:pron>/əˈbɒm.əˌneɪt/</ns0:pron>
