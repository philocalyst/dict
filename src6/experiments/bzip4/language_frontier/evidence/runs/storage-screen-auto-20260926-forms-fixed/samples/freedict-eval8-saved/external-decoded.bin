        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>boyero de Entlebuch</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dog of a breed traditionally used by herders in the Swiss Alps.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Enyo</ns0:orth>
        <ns0:pron>/ɪˈnaɪoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Enío</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) Goddess of violent war, acting as a counterpart and companion to the war god Ares. Identified with Bellona in Roman mythology.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Enzo</ns0:orth>
        <ns0:pron>/ˈɛnzoʊ/</ns0:pron>
        <ns0:pron>/ˈɛnzəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Enzo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eo</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
