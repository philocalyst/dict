      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Carmelo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mountain range in Israel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Carmela</ns0:quote>
          <ns0:quote>Carmen</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name from the Roman Catholic epithet of Virgin Mary at Mount Carmel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Carmelite</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carmelita</ns0:quote>
          <ns0:quote>carmelitana</ns0:quote>
          <ns0:quote>carmelitano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the Order of the Brothers of Our Lady of Mount Carmel, a Catholic religious order focusing on contemplative prayer and the Virgin Mary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Carnation Revolution</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Revolución de los Claveles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A revolution and military coup by left-leaning military officers that overthrew the colonialist and authoritarian Estado Novo on 25 April 1974 in Lisbon, Portugal, leading to major cultural and political changes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Carniola</ns0:orth>
        <ns0:pron>/kɑɹniˈoʊlə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Carniola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A historical region of the Holy Roman and Austrian empires that comprised parts of what is now Slovenia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
