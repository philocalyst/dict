      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>laosiano</ns0:quote>
          <ns0:quote>de Laos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to the Lao People's Democratic Republic, the Laotian people or the Laotian language.</ns0:def>
        </ns0:sense>
      </ns0:sense>
