        <ns0:pron>/ˈsɪŋəpɔː/</ns0:pron>
        <ns0:pron>/ˈsɪŋɡəpɔː(ɹ)/</ns0:pron>
        <ns0:pron>/ˈsɪŋʌ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Singapur</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island and city-state in Southeast Asia, located off the southernmost tip of the Malay Peninsula; a former British crown colony and state of Malaysia (1963-1965). Official name: Republic of Singapore.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
