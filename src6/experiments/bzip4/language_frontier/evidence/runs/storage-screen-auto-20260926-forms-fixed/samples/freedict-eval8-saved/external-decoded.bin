    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Loch Ness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lago Ness</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A lake in the Great Glen of Scotland, United Kingdom, the second largest in Britain, and with a maximum depth of 226 metres. It is the alleged home of the Loch Ness monster, Nessie.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
