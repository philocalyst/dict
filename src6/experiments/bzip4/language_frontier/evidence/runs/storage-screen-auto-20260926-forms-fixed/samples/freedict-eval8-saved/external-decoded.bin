      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Wolverhampton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A city and metropolitan borough in the West Midlands, England. Historically it was in Staffordshire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Women</ns0:orth>
      </ns0:form>
