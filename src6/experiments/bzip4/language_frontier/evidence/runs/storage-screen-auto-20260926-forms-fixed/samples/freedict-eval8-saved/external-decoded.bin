      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>venda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language of the people of this area.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Vendémiaire</ns0:orth>
        <ns0:pron>/vɛnˌdɛmɪˈɛː/</ns0:pron>
        <ns0:pron>/ˌvɑndəˈmjɛəɹ/</ns0:pron>
        <ns0:pron>/ˌvɑ̃deɪˈmjɛəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>vendimiario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The first month of the French Republican Calendar, starting on the date of the autumnal equinox (September 22, 23 or 24) and ending on October 21, 22 or 23.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
