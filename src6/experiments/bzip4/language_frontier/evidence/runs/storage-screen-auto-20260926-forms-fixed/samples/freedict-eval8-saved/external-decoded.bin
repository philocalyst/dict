      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eos</ns0:orth>
        <ns0:pron>/ˈiɑs/</ns0:pron>
        <ns0:pron>/ˈiːɒs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Greek god) The Greek goddess of the dawn; daughter of Hyperion and Theia, sister of Helios and Selene, wife of Astraeus (god of the dusk), and mother of the four Anemoi ("Winds"), and the five Astra Planeta ("Wandering Stars/Planets"). Her Roman counterpart is Aurora.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ephesian</ns0:orth>
        <ns0:pron>/ɪˈfiːʒən/</ns0:pron>
