      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abolición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abolishing; an annulling; abrogation. [First attested around the early 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(historical, often capitalised, UK, US) The ending of the slave trade or of slavery. [First attested around the early 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
