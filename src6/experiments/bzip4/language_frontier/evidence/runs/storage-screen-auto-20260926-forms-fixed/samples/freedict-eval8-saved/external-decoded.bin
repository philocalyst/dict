    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pyrrhic</ns0:orth>
        <ns0:pron>/ˈpɪɹɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pírrico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Achieved at too great a cost or detriment to have been worthwhile (as a victory, accomplishment, etc).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Pyrrhic victory</ns0:orth>
        <ns0:pron>/ˌpɪɹ.ɪk ˈvɪk.t(ə)ɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>victoria pírrica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A very costly victory, wherein the considerable losses outweigh the gain, so as to render the struggle not worth the cost.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
