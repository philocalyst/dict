        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Lynx</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(constellation) A faint spring constellation of the northern sky. It lies north of the constellation Cancer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
