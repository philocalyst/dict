      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajista</ns0:quote>
          <ns0:quote>osuno</ns0:quote>
          <ns0:quote>pesimista</ns0:quote>
          <ns0:quote>ursino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(stock market, of the price of financial instruments) Characterized by or expecting falling prices.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bearskin</ns0:orth>
        <ns0:pron>/ˈbɛə.skɪn/</ns0:pron>
