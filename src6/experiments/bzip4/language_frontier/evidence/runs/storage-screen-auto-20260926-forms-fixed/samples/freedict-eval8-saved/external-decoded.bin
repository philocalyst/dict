      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aculturar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To familiarize oneself with, and adopt a new culture, especially by an immigrant</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>accumulate</ns0:orth>
        <ns0:pron>/əˈkju.mjəˌleɪt/</ns0:pron>
        <ns0:pron>/əˈkjuːmjʊˌleɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acumular</ns0:quote>
          <ns0:quote>amontonar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To heap up in a mass; to pile up; to collect or bring together (either literally or figuratively), often gradually and without active intent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acumularse</ns0:quote>
          <ns0:quote>acumular</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To gradually grow or increase in quantity or number.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
