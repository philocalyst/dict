      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>UER</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of European Broadcasting Union</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ECB</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>BCE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of w:European Central Bank.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ECG</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ECG</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cardiology) Initialism of electrocardiogram, electrocardiography, or electrocardiograph.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ECHR</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>TEDH</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of w:European Court of Human Rights.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ECLAC</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>CEPAL</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ECOWAS</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>CEDEAO</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Acronym of Economic Community of West African States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EDNOS</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>trastorno de la conducta alimentaria no especificado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Acronym of Eating Disorder Not Otherwise Specified, an eating disorder that does not contain all of the characteristics of major classifications of eating disorders (such as anorexia or bulimia).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EEA</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>EEE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of European Economic Area, the area consisting of the European Union plus Norway, Iceland and Liechtenstein.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EEC</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>CEE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Initialism of w:European Economic Community, forerunner of the European Community (EC) and the European Union (EU).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EEZ</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ZEE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of exclusive economic zone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EFTA</ns0:orth>
        <ns0:pron>/ɛf.tɑː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>AELC</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of w:European Free Trade Association.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ENE</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ENE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Initialism of east-northeast.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ENT</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ORL</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(medical) Initialism of ear, nose and throat.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medical) An otorhinolaryngologist; an ear, nose and throat doctor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EPP</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>PPE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(EU politics) Initialism of w:European People's Party.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ERM</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>MTC</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(EU, finance) Initialism of European Exchange Rate Mechanism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ET</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ET</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Initialism of Eastern Time (-5 hours to GMT).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>EU</ns0:orth>
        <ns0:pron>/ˌiː ˈjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>UE</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(politics, economics) Initialism of European Union.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Early Middle Ages</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alta Edad Media</ns0:quote>
          <ns0:quote>Temprana Edad Media</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(history) The period of the Middle Ages that followed the collapse of the Western Roman Empire, c. 500 to 1000 CE.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Early Modern English</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inglés moderno temprano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The form of the English language written and spoken from the end of the 15th century to the mid-17th century.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Earth</ns0:orth>
        <ns0:pron>/ɜːθ/</ns0:pron>
        <ns0:pron>/ɝθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tierra</ns0:quote>
          <ns0:quote>tierra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The third planet of the Solar System; the world upon which humans live.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Earth Day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Día de la Tierra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(North American countries) April 22; Created in 1970, global day of observance of the need to protect the earth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Earthling</ns0:orth>
        <ns0:pron>/ˈɜːθlɪŋ/</ns0:pron>
        <ns0:pron>/ˈɝθlɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>terrícola</ns0:quote>
          <ns0:quote>terráqueo</ns0:quote>
          <ns0:quote>terrenal</ns0:quote>
          <ns0:quote>terrestre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, science fiction) An inhabitant of Earth, as opposed to one of another planet; specifically, a sentient member of any species native to Earth. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mundano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) A person who is materialistic or worldly; a worldling. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East</ns0:orth>
        <ns0:pron>/iːst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>levante</ns0:quote>
          <ns0:quote>viento de levante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A personification of the wind from the east.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Oriente</ns0:quote>
          <ns0:quote>oriente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Eastern world; the regions, primarily situated in the Eastern Hemisphere, whose culture is derived from Arabia, India, Persia or China.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The Eastern Bloc; the eastern countries of Europe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Africa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>África Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region encompassing the eastern part of Africa, generally stretching from Ethiopia and Eritrea in the north to Mozambique and Zimbabwe in the south.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Anglia</ns0:orth>
        <ns0:pron>/ˌiːst ˈæŋ.ɡli.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Anglia Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The area of eastern England occupied by Norfolk, Suffolk and parts of Cambridgeshire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Asia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Asia Oriental</ns0:quote>
          <ns0:quote>Asia del Este</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region comprising the eastern part of Asia, inclusive of China proper, Japan, North Korea, South Korea, and Taiwan and sometimes inclusive of Mongolia and Tibet and some or all of Southeast Asia and the Philippines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Asian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asiático oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to East Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Asian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asiática oriental</ns0:quote>
          <ns0:quote>asiático oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person from East Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Berlin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Berlín Este</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, Germany) The Soviet sector of Berlin between 1949 and 1990.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East China Sea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar de China Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marginal sea east of China, south of the Korean Peninsula, west of the Ryukyu Islands, and north of Taiwan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Germany</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alemania Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, 1949–1990) A former Communist country of Central Europe, existing between 1949 and 1990. Official name: German Democratic Republic. Capital: East Berlin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Indies</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Indias Orientales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Southeast Asia, especially Island Southeast Asia or Indonesia, but also including India, Indochina, Malaya and the Malay Archipelago, from the Philippines to Indonesia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Jerusalem</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Jerusalén Este</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The portion of Jerusalem controlled by Jordan between 1948 and 1967.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Malaysia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Malasia Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The eastern half of the country of Malaysia on the island of Borneo, consisting of Sarawak, Sabah and Labuan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Midlands</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Midlands Orientales</ns0:quote>
          <ns0:quote>Midlands del Este</ns0:quote>
          <ns0:quote>Tierras Medias Orientales</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An administrative region in the geographical centre of England, consisting of the counties of Derbyshire, Nottinghamshire, Leicestershire, Lincolnshire, Rutland and Northamptonshire.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Pakistan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pakistán Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The eastern part of Bengal before it split from Pakistan, currently the independent state of Bangladesh.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Siberian Sea</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mar de Siberia Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A marginal sea of the Arctic Ocean. This sea is bordering on the Laptev Sea in the West and the Chukchi Sea in the East.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Sussex</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sussex Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A county in south east England bordered by Kent, Surrey, West Sussex and the English Channel.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Timor</ns0:orth>
        <ns0:pron>/iːst tiːmɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Timor Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in Southeast Asia occupying half the island of Timor. Official name: Democratic Republic of Timor-Leste. Capital: Dili.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Timorese</ns0:orth>
        <ns0:pron>/ˈiːst tɪ.məɹ.iːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>timorense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, from, or pertaining to East Timor or the East Timorese people.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>East Timorese</ns0:orth>
        <ns0:pron>/ˈiːst tɪ.məɹ.iːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>timorense</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, in the plural) A person from East Timor or of East Timorese descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter</ns0:orth>
        <ns0:pron>/ˈistəɹ/</ns0:pron>
        <ns0:pron>/ˈiːstə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Pascua</ns0:quote>
          <ns0:quote>pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Christian feast commemorating the resurrection of Jesus Christ. It is celebrated on the first Sunday (and Monday) following the full moon that occurs on or next after the vernal equinox, ranging in most of Western Christianity (such as Protestantism and Roman Catholicism) from March 22 to April 25, and in Eastern Christianity (such as the Coptic Church and Eastern Orthodox Church) from April 4 to May 8.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter Bunny</ns0:orth>
        <ns0:pron>/ˈiːs.tə ˈbʌ.ni/</ns0:pron>
        <ns0:pron>/ˈiːs.tɚ ˈbʌ.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conejo de Pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A symbolic rabbit sometimes depicted delivering Easter eggs to children.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter Island</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isla de Pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island in the South Pacific, belonging to Chile and famous for its moai monuments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter Monday</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lunes de Pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Monday after Easter Sunday; a bank holiday in Britain and a holiday in many other places.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter Sunday</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Domingo de Pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Christianity) A Christian religious moveable holiday commemorating the resurrection of Jesus Christ from the dead.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter egg</ns0:orth>
        <ns0:pron>/ˈiː.stəɹ ˌɛɡ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>huevo de Pascua</ns0:quote>
          <ns0:quote>huevo pascual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A dyed or decorated egg, traditionally associated with Easter and, in the Western European tradition, sometimes hidden for children to find.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>huevo pascual</ns0:quote>
          <ns0:quote>huevo de Pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A chocolate confection in the shape of an egg, sometimes with chocolates or sweets inside.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing, video games) An undocumented function hidden in a program or video game, typically triggered by a particular input sequence or combination of keystrokes. [from 1980s]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>huevo pascual</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) Any image, feature, or other content that is hidden on a video disc or in a movie, trailer, or poster.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Easter egg hunt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>búsqueda de los huevos de Pascua</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A common festive activity held at Easter, where Easter eggs are hidden outdoors or indoors for children to run around and seek (sometimes held as a contest to see who can collect the most eggs).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eastern Europe</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Europa Oriental</ns0:quote>
          <ns0:quote>Europa del Este</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A socio-political geographical area of eastern Europe usually including the European countries to the east of Germany, Austria and Italy, and to the west of the Urals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eastern Orthodox Church</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Iglesia católica apostólica ortodoxa</ns0:quote>
          <ns0:quote>Iglesia ortodoxa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of the major branches of Christianity; it comprises the Greek Orthodox Church, the Russian Orthodox Church and other patriarchates.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eastern Samar</ns0:orth>
        <ns0:pron>/ˌʔis.təɹn ˈsa.mɐɾ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sámar Oriental</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A province of Eastern Visayas, Visayas, Philippines. Capital and largest city: Borongan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eastern Time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hora del este</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Eastern Daylight/Eastern Standard Time</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ebisu</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ebisu</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Synonym of Emishi (“ancient ethnic group of Japan”).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ebola</ns0:orth>
        <ns0:pron>/iˈboʊlə/</ns0:pron>
        <ns0:pron>/ɪˈboʊlə/</ns0:pron>
        <ns0:pron>/ɪˈbəʊlə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ébola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Ebola virus.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Ebola fever.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ebola</ns0:orth>
        <ns0:pron>/iˈboʊlə/</ns0:pron>
        <ns0:pron>/ɪˈboʊlə/</ns0:pron>
        <ns0:pron>/ɪˈbəʊlə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ébola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river in the Democratic Republic of the Congo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ebola virus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>virus Ébola</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any extremely contagious filovirus infection of African origin that causes Ebola fever, spread through contact with bodily fluids or secretions of infected persons and by airborne particles, caused by the viruses in genus Ebolavirus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ebro</ns0:orth>
        <ns0:pron>/ˈeɪbɹəʊ/</ns0:pron>
        <ns0:pron>/ˈɛbɹəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ebro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river in Spain that flows into the Mediterranean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ecbatana</ns0:orth>
        <ns0:pron>/ɛkˈbætənə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ecbatana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) The ancient capital of Media, in modern-day Iran, and subsequently a royal residence of Persian and Parthian kings.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ecclesiastes</ns0:orth>
        <ns0:pron>/əˌkliːziˈæstiːz/</ns0:pron>
        <ns0:pron>/ɪˌkliːziˈæstiːz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Eclesiastés</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(book of the bible) A book in the Old Testament of the Bible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ecclesiastical Latin</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>latín eclesiástico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The Latin language as spoken, written, and used in the Christian church and in church services.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eckankar</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>eckankar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A pantheistic religion founded in 1965 by Paul Twitchell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Eclectic Wicca</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>wicca ecléctica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A branch of Wicca based on individuals inventing their own spiritual practices rather than following tradition or by combining multiple traditions in a syncratic manner</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Ecuador</ns0:orth>
        <ns0:pron>/ˈɛk.wə.dɔɹ/</ns0:pron>
        <ns0:pron>/ˈɛk.wə.dɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Ecuador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in South America. Official name: Republic of Ecuador. Capital: Quito.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
