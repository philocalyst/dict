        <ns0:pron>/ɛəɹ/</ns0:pron>
        <ns0:pron>/ɛɹ/</ns0:pron>
        <ns0:pron>/ɛː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>área</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(rare) An accepted (but deprecated and rarely used) metric unit of area equal to 100 square metres, or a former unit of approximately the same extent. Symbol: a.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
