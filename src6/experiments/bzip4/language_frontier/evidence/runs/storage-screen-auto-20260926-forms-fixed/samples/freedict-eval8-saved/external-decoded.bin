      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>luso-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to Portugal or the Portuguese people, language, or culture.</ns0:def>
        </ns0:sense>
