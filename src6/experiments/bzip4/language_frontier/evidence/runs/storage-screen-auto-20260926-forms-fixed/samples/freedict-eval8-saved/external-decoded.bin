          <ns0:quote>pashtún</ns0:quote>
          <ns0:quote>pastún</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of the Pashtun ethnic group, or of a Pashtun tribe.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A Pashto-speaking person.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
