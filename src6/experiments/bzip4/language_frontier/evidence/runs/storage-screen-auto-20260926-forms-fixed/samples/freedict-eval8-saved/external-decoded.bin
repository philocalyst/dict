      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bacinete</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A light helmet, typically with a high, pointed skull, either open-faced (in early models) or made with a visor (later models).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bascule bridge</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>puente basculante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A movable bridge consisting of one or two opening leaves equipped with balancing and stabilizing counterweights that ease and speed up their operation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>base</ns0:orth>
        <ns0:pron>/beɪs/</ns0:pron>
        <ns0:pron>/beːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) Low in height; short.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Low in place or position.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(obsolete) Of low value or degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rastrero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Morally reprehensible, immoral; cowardly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>base</ns0:orth>
        <ns0:pron>/beɪs/</ns0:pron>
        <ns0:pron>/beːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base</ns0:quote>
          <ns0:quote>orlo</ns0:quote>
          <ns0:quote>plinto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something from which other things extend; a foundation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The starting point of a logical deduction or thought; basis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A site, structure, or both, usually durable and often permanent, for housing military personnel and materiel.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chemistry) Any of a class of generally water-soluble compounds that turn red litmus blue and react with acids to form salts.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(baseball) One of the four places that a runner can stand without being subject to being tagged out when the ball is in play.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(electronics) The name of the controlling terminal of a bipolar transistor (BJT).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(mathematics) A number raised to the power of an exponent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>base</ns0:quote>
          <ns0:quote>sede</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The place where decisions for an organization are made; headquarters.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basamento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) The lowermost part of a column, between the shaft and the pedestal or pavement.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basamento</ns0:quote>
          <ns0:quote>base</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geometry) The lowest side of a triangle or other polygon, or the lowest face of a cone, pyramid or other polyhedron laid flat.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(heraldry) The lowest third of a shield (or field), or an ordinary occupying this space, the champagne. (Compare terrace.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>base</ns0:orth>
        <ns0:pron>/beɪs/</ns0:pron>
        <ns0:pron>/beːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give as its foundation or starting point; to lay the foundation of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>base on</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basar en</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ditransitive) To ground (an opinion, a conclusion, etc) on.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(ditransitive) To derive (a work) from.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baseball</ns0:orth>
        <ns0:pron>/ˈbeɪs.bɑl/</ns0:pron>
        <ns0:pron>/ˈbeɪs.bɔl/</ns0:pron>
        <ns0:pron>/ˈbeɪs.bɔːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>béisbol</ns0:quote>
          <ns0:quote>beisbol</ns0:quote>
          <ns0:quote>bola beisbolística</ns0:quote>
          <ns0:quote>pelota beisbolera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The ball used to play the sport of baseball.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baseball cap</ns0:orth>
        <ns0:pron>/ˈbeɪs.bɑl ˌkæp/</ns0:pron>
        <ns0:pron>/ˈbeɪs.bɔl ˌkæp/</ns0:pron>
        <ns0:pron>/ˈbeɪs.bɔːl ˌkæp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>gorra</ns0:quote>
          <ns0:quote>jockey</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(headwear) A cap with a rounded crown and a curved, stiffened bill at the front.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baseball field</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>campo de béisbol</ns0:quote>
          <ns0:quote>diamante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A playing field on which the game of baseball is played.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baseball mitt</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>guante</ns0:quote>
          <ns0:quote>manopla</ns0:quote>
          <ns0:quote>mascotín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A glove used when playing baseball to protect the hand and enhance catching ability.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baseball player</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beisbolista</ns0:quote>
          <ns0:quote>jugador de béisbol</ns0:quote>
          <ns0:quote>beisbolero</ns0:quote>
          <ns0:quote>pelotera</ns0:quote>
          <ns0:quote>pelotero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who plays baseball, especially professional baseball.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>based</ns0:orth>
        <ns0:pron>/beɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cimentado</ns0:quote>
          <ns0:quote>fundamentado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Founded on; having a basis; often used in combining forms.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(slang, of a person) Not caring what others think about one's personality, style, or behavior; focused on maintaining individuality.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(internet slang, sometimes, humorous) Admirable; praiseworthy, especially if simultaneously unpopular or controversial.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>based</ns0:orth>
        <ns0:pron>/beɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Internet slang, sometimes, humorous) Indicating emphatic approval of a statement or opinion, often a controversial or unpopular one.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>based on</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basado en</ns0:quote>
          <ns0:quote>en función de</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>baseline</ns0:orth>
        <ns0:pron>/ˈbeɪslaɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea basal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A line that is a base for measurement or for construction.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea de base</ns0:quote>
          <ns0:quote>línea referencial</ns0:quote>
          <ns0:quote>punto de referencia</ns0:quote>
          <ns0:quote>punto referencial</ns0:quote>
          <ns0:quote>referencia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A datum used as the basis for calculation or for comparison.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea de fondo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(tennis) The line at the farthest ends of the court indicating the boundary of the area of play.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>línea base</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(engineering) A configuration of software, hardware, or a process that is established and documented as a point of reference.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basemap</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mapa base</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(cartography, GIS) The map used as the basic map. Other data may be overlaid upon a basemap: for example, an aerial imagery basemap on which is overlaid property lines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basement</ns0:orth>
        <ns0:pron>/ˈbeɪsmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>sótano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architecture) A floor of a building below ground level.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zócalo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geology) A mass of igneous or metamorphic rock forming the foundation over which a platform of sedimentary rocks is laid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bash</ns0:orth>
        <ns0:pron>/bæʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>joda</ns0:quote>
          <ns0:quote>juerga</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A large party; a gala event.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bash</ns0:orth>
        <ns0:pron>/bæʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hostiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) To strike heavily.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bash the bishop</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>darle a la zambomba</ns0:quote>
          <ns0:quote>pajearse</ns0:quote>
          <ns0:quote>pelársela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, slang) To masturbate by stimulating one's penis.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bash up</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>golpear</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, informal) To assault someone with the intention of causing physical injury; to beat up.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bashful</ns0:orth>
        <ns0:pron>[ˈbæʃfəɫ]</ns0:pron>
        <ns0:pron>[ˈbæʃfʊɫ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tímido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Shy; not liking to be noticed; socially timid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basic</ns0:orth>
        <ns0:pron>/ˈbeɪsɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>básico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Necessary, essential for life or some process.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Elementary, simple, fundamental, merely functional.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(chemistry) Of or pertaining to a base; having a pH greater than 7.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chapi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Unremarkable or uninteresting; boring; uncool.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basic income</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>renta básica</ns0:quote>
          <ns0:quote>renta mínima</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Ellipsis of guaranteed basic income, a form of social security in which all citizens or residents of a jurisdiction are guaranteed to have an income level at or above the set basic income cut-off level, whereby the government will top-off incomes falling below the line, to reach the limit; those falling above the line would not receive payments.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basic law</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley de bases</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A law or set of laws given to have constitutional powers and effect: a constitution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basically</ns0:orth>
        <ns0:pron>/ˈbeɪ.sɪk.(ə.)li/</ns0:pron>
        <ns0:pron>/ˈbeɪ.sɪk.koʊ.li/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>básicamente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In a fundamental, essential or basic manner.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basidiomycete</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basidiomiceto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mycology) Any fungus of the phylum Basidiomycota, that produces sexual spores on a basidium.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basidium</ns0:orth>
        <ns0:pron>/bəˈsɪdɪəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basidio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mycology) A small structure, shaped like a club, found in the Basidiomycota division of fungi, that bears four spores at the tips of small projections. [from Template:SAFESUBST: c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basil</ns0:orth>
        <ns0:pron>/ˈbeɪ.zəl/</ns0:pron>
        <ns0:pron>/ˈbæz.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>albahaca</ns0:quote>
          <ns0:quote>alhábega</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A plant (Ocimum basilicum).</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The leaves of this plant used as a herb.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basilar</ns0:orth>
        <ns0:pron>/ˈbas.ɪl.ə/</ns0:pron>
        <ns0:pron>/ˈbeɪ.səl.ɚ/</ns0:pron>
        <ns0:pron>/ˈbeɪ.zəl.ɚ/</ns0:pron>
        <ns0:pron>/ˈbæs.əl.ɚ/</ns0:pron>
        <ns0:pron>/ˈbæz.əl.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>basilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy, relational) Of, pertaining to, or located at a base, but especially at the base of the skull or an organ of Corti.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basilar artery</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>arteria basilar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) An unpaired artery that is formed by the union of the two vertebral arteries, runs forward within the skull just under the pons, divides into the two posterior cerebral arteries, and supplies the pons, cerebellum, posterior part of the cerebrum, and the inner ear.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>basilect</ns0:orth>
        <ns0:pron>/ˈbeɪsɪlɛkt/</ns0:pron>
