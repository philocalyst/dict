      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Mandaue</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An independent city in Metro Cebu, Cebu, Philippines.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mandela effect</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>efecto Mandela</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The phenomenon of a large number of persons independently sharing the same false memory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Mani</ns0:orth>
      </ns0:form>
