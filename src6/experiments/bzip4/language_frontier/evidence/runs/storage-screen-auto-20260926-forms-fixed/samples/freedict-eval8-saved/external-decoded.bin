      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ampliamente</ns0:quote>
          <ns0:quote>con creces</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In an ample manner; extensively; thoroughly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ampoule</ns0:orth>
        <ns0:pron>/ˈæm.pjuːl/</ns0:pron>
        <ns0:pron>/ˈæm.puːl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ampolla</ns0:quote>
          <ns0:quote>ámpula</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small hermetically sealed vial, often used to contain a sterile solution suitable for injection.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ampulla of Vater</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ampolla de Vater</ns0:quote>
          <ns0:quote>ampolla hepatopancreática</ns0:quote>
          <ns0:quote>papila de Vater</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A swelling that marks the union of the pancreatic duct and the common bile duct.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
