      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grecismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A word or idiom of the Greek language used in another language, especially for literary effect.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
