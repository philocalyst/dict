    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Isidore</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isidoro</ns0:quote>
          <ns0:quote>Isidro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Isis</ns0:orth>
        <ns0:pron>/ˈaɪ.səs/</ns0:pron>
        <ns0:pron>/ˈaɪ.sɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Isis</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Egyptian god) An ancient Egyptian goddess, the wife of Osiris and mother of Horus, worshiped as the ideal mother and wife and as the matron of nature and magic; also worshiped by (some) Greeks during the Hellenistic period and featured in Greek mythology, and by Romans involved in what was categorized as the Cult of Isis.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(astronomy) 42 Isis, a main belt asteroid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islam</ns0:orth>
        <ns0:pron>/-læm/</ns0:pron>
        <ns0:pron>/ɪsˈlɑːm/</ns0:pron>
        <ns0:pron>/ɪzˈlɑːm/</ns0:pron>
        <ns0:pron>/ˈɪs.lɑːm/</ns0:pron>
        <ns0:pron>/ˈɪz.lɑːm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islam</ns0:quote>
          <ns0:quote>islamismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A monotheistic Abrahamic religion followed by Muslims that is based on the teachings of Muhammad and the Qur'an.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamabad</ns0:orth>
        <ns0:pron>/ɪsˈlɑːməˌbɑːd/</ns0:pron>
        <ns0:pron>/ɪzˈlæməˌbæd/</ns0:pron>
        <ns0:pron>/ɪzˈlɑːməˌbɑːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Islamabad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city of Pakistan, located within the Islamabad Capital Territory.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic</ns0:orth>
        <ns0:pron>/ɪsˈlɑːmɪk/</ns0:pron>
        <ns0:pron>/ɪzˈlæmɪk/</ns0:pron>
        <ns0:pron>/ɪzˈlɑːmɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islámico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of, pertaining to, originating in, characteristic of, or deriving from Muslims or Islam.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic Emirate of Afghanistan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Emirato Islámico de Afganistán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Afghanistan: a country in Central Asia, under Taliban rule in 1996–2001 and since 2021.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic Republic of Afghanistan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Islámica de Afganistán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The former official name of Afghanistan, from 2001 through 2021.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic Republic of Iran</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Islámica de Irán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Iran: a country in West Asia, in the Middle East. [1979]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic Republic of Pakistan</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Islámica del Pakistán</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Pakistan: a country in South Asia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic State</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estado Islámico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Salafist group active in Libya, Nigeria, Iraq and Syria, where it has proclaimed an (unrecognized) state.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The unrecognized state (caliphate) proclaimed by this group.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamic fundamentalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fundamentalismo islámico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A revolutionary movement towards Islamism, with literal and traditional interpretations of their sacred texts. It is often used to describe Muslim groups that advocate the replacement of secular state laws with Islamic law, or Shari'a.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamism</ns0:orth>
        <ns0:pron>/ɪzˈlæmɪz(ə)m/</ns0:pron>
        <ns0:pron>/ɪzˈlɑːmɪz(ə)m/</ns0:pron>
        <ns0:pron>/ˈɪzləmɪz(ə)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) Islamic fundamentalism, especially the forms that promote violence, hostility, and persecution of non-believers. [from 20th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamization</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamización</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Conversion to Islam.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To convert to Islam.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To make someone, or a society, conform to Islamic law.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamologist</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamólogo</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamophobe</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamofóbica</ns0:quote>
          <ns0:quote>islamofóbico</ns0:quote>
          <ns0:quote>islamófoba</ns0:quote>
          <ns0:quote>islamófobo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who fears or hates Islam and Muslims.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamophobia</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamofobia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fear or hatred of Islam or Muslims.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Islamophobic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>islamofóbico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having a fear or hatred of Islam or Muslims.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Isle of Man</ns0:orth>
        <ns0:pron>/ˌaɪl ə(v) ˈmæn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>isla de Man</ns0:quote>
          <ns0:quote>Isla de Man</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island and crown dependency of the United Kingdom in the Irish Sea, part of the British Isles but not of the United Kingdom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Isle of Wight</ns0:orth>
        <ns0:pron>/ˌaɪl ə(v) ˈwaɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>isla de Wight</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An island, county, and unitary authority off the south coast of England, in the English Channel opposite Southampton.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
