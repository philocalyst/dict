          <ns0:quote>tarea</ns0:quote>
          <ns0:quote>encomienda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An assigned task.</ns0:def>
        </ns0:sense>
      </ns0:sense>
