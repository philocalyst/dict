        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abajo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In or to a lower place.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a continuación</ns0:quote>
