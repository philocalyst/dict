        </ns0:cit>
        <ns0:sense>
          <ns0:def>A spicy sauce from Hong Kong, made from roughly chopped dried seafood, chili peppers, onions, and garlic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
