          <ns0:quote>judía azuki</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An annual vine (Vigna angularis), widely grown throughout East Asia and the Himalayas for its small bean.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A bean of this vine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
