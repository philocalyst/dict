      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Alta Normandía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A former administrative region of France; now part of the administrative region of Normandy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
