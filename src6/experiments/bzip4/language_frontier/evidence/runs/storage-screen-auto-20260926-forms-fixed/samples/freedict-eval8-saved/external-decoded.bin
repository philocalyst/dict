      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Francia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country located primarily in Western Europe. Official name: French Republic. Capital and largest city: Paris.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
