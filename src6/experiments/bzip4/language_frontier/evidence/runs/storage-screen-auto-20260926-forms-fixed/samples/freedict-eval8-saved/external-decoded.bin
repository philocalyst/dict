      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atento a</ns0:quote>
          <ns0:quote>en atención a</ns0:quote>
          <ns0:quote>tener en cuenta</ns0:quote>
          <ns0:quote>tener en mente</ns0:quote>
          <ns0:quote>tener presente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, idiomatic) To hold (something) in the memory; to remember; also, to be mindful of or pay attention to (something); to consider; to note.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bear market</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mercado bajista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(finance) A stock market where a majority of investors are selling ("bears"), causing overall stock prices to drop. Often operationally defined as a market value drop of 20% or more on some specific stock market index.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
