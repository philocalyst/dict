      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abusivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) Tending to misuse; practising or containing abuse. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abut</ns0:orth>
        <ns0:pron>/əˈbʊt/</ns0:pron>
        <ns0:pron>/əˈbʌt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bordear</ns0:quote>
          <ns0:quote>colindar</ns0:quote>
          <ns0:quote>limitar</ns0:quote>
          <ns0:quote>lindar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive) To touch by means of a mutual border, edge or end; to border on; to lie adjacent (to); to be contiguous (said of an area of land) [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abutment</ns0:orth>
        <ns0:pron>/əˈbʌt.mn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estribo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(engineering) A construction that supports the ends of a bridge; a structure that anchors the cables on a suspension bridge. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The state of abutting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abutting</ns0:orth>
        <ns0:pron>/əˈbʌt.ɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>colindante</ns0:quote>
          <ns0:quote>lindante</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abysmal</ns0:orth>
        <ns0:pron>/əˈbɪz.məl/</ns0:pron>
        <ns0:pron>[əˈbɪz.ml̩]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abismal</ns0:quote>
          <ns0:quote>insondable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(now, rare) Pertaining to, or resembling an abyss. [First attested in the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atroz</ns0:quote>
          <ns0:quote>desastroso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figurative) Extremely bad; terrible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abyss</ns0:orth>
        <ns0:pron>/æˈbɪs/</ns0:pron>
        <ns0:pron>/əˈbɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Hell; the bottomless pit; primeval chaos; a confined subterranean ocean. [First attested around 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Moral depravity; vast intellectual or moral depth.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abismo</ns0:quote>
          <ns0:quote>sima</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(frequently, figurative) A bottomless or unfathomed depth, gulf, or chasm; hence, any deep, immeasurable; any void space. [First attested in the late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abyssal</ns0:orth>
        <ns0:pron>/əˈbɪs.l̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abisal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(geography) Of or belonging to the ocean depths, especially below 2000 metres (6500 ft): abyssal zone. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abzyme</ns0:orth>
        <ns0:pron>/ˈæb.zaɪm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abzima</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An antibody with catalytic properties.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acacia</ns0:orth>
