      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zarza armeniana</ns0:quote>
          <ns0:quote>zarza himalayana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Rubus armeniacus, a blackberry species native to West Asia</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Himalayas</ns0:orth>
        <ns0:pron>/hɪˈmɑl.ə.jəz/</ns0:pron>
        <ns0:pron>/ɦɪˈmaː.lə.jəz/</ns0:pron>
        <ns0:pron>/ˌhɪm.əˈleɪ.əz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Himalaya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The mountain range in south-central Asia which extends about 2,414 km (1,500 mi) through Kashmir, northern India, southern Tibet, Nepal, Sikkim, Bhutan and Assam; it contains nine of the world’s ten highest peaks, including Mount Everest/Qomolongma.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
