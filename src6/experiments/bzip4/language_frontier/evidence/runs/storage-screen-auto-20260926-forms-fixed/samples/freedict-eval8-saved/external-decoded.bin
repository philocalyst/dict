        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>con los brazos en jarras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Into, in, or of the position where the arms are akimbo.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
