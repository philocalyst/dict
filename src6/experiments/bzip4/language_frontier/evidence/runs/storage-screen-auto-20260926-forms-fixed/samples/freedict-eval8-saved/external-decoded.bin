      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Simón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Name of any of a number of men in the New Testament, notably the original name of Apostle Peter.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A en given name.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A surname originating as a patronymic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Simon says</ns0:orth>
