        <ns0:pron>/ˈnɪʊ̯tən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Villanueva</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A town centre in the city of Surrey, Regional District of Metro Vancouver, British Columbia.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A habitational surname for someone from any of these places.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newton's first law</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley de inercia</ns0:quote>
          <ns0:quote>primera ley del movimiento de Newton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mechanics) The observation that objects in motion tend to stay in motion, and objects at rest tend to stay at rest unless an outside force acts upon them.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newton's second law</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ley fundamental de la dinámica</ns0:quote>
          <ns0:quote>segunda ley del movimiento de Newton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mechanics) Newton's observation that the rate of change of the momentum of a body is directly proportional to, and in the same direction as, the net force acting on it. Often stated as F = ma: F = force, m = mass, a = acceleration.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Newton's third law</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>principio de acción y reacción</ns0:quote>
          <ns0:quote>tercera ley del movimiento de Newton</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mechanics) Newton's observation that to every action (force applied) there is an equal and opposite reaction (equal force applied in the opposite direction).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
