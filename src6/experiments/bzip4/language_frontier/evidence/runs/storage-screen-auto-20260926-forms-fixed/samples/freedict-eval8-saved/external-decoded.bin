        <ns0:pron>/bɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>doblado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Of something that is usually straight) Folded, dented.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bent</ns0:orth>
        <ns0:pron>/bɛnt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>inclinación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An inclination or talent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>predisposición</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A predisposition to act or react in a particular way.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benthic</ns0:orth>
        <ns0:pron>/ˈbɛnθɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bentónico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to the benthos; living on the seafloor, as opposed to floating in the ocean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benthopelagic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bentopelágico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Both benthic and pelagic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benthos</ns0:orth>
        <ns0:pron>/ˈbɛnθɒs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bentos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The flora and fauna at the bottom of a body of water.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzene</ns0:orth>
        <ns0:pron>/ˈbɛnziːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benceno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) An aromatic hydrocarbon of formula C6H6 whose structure consists of a ring of alternate single and double bonds.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzo-</ns0:orth>
        <ns0:pron>/bɛn.zoʊ/</ns0:pron>
        <ns0:pron>/bɛn.zə(ʊ)/</ns0:pron>
        <ns0:pron>/bɛn.zə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzo-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Related to benzene or benzoic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzoate</ns0:orth>
        <ns0:pron>/ˈbɛn.zoʊˌeɪt/</ns0:pron>
        <ns0:pron>/ˈbɛn.zəʊ.eɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzoato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any salt or ester of benzoic acid.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzodiazepine</ns0:orth>
        <ns0:pron>/ˌbɛnzoʊdaɪˈæzɪpiːn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzodiacepina</ns0:quote>
          <ns0:quote>benzodiazepina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound, pharmaceutical drug) Any of a class of psychoactive drugs, structured upon diazepine, used in the treatment of anxiety, insomnia and other related disorders.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzofuran</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzofurano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) Any of a class of bicyclic heterocycles consisting of a benzene ring fused with one of furan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzoic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Pertaining to, or obtained from, benzoin.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(organic chemistry) Derived from benzoic acid or its derivatives.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzoic acid</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ácido benzoico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(carboxylic acid) A white crystalline organic acid, C6H5COOH; the simplest aromatic carboxylic acid; used as a food preservative and in many other industrial applications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzoin</ns0:orth>
        <ns0:pron>/ˈbɛnzɔɪn/</ns0:pron>
        <ns0:pron>/ˈbɛnzəʊɪn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benjuí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A resinous substance, dry and brittle, obtained from Styrax benzoin, a tree of Sumatra, Java, etc., having a fragrant odor, and slightly aromatic taste. It is used in the preparation of benzoic acid, in medicine, and as a perfume. [from 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzol</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzol</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry) An impure benzene (mixed with toluene etc), used in the arts as a solvent, and for various other purposes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzoquinone</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzoquinona</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic compound) Either of the two isomeric forms of the simplest quinone, C6H4O2, or any of their derivatives.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzphetamine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>benzfetamina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) An anti-obesity drug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzyl</ns0:orth>
        <ns0:pron>/ˈbɛnzaɪl/</ns0:pron>
        <ns0:pron>/ˈbɛnzɪl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bencilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(organic chemistry, especially in combination) The univalent radical C6H5-CH2- related to toluene and benzoic acid</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benzylic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bencílico</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bequeath</ns0:orth>
        <ns0:pron>/bɪˈkwiːð/</ns0:pron>
        <ns0:pron>/bɪˈkwiːθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>legar</ns0:quote>
          <ns0:quote>ceder</ns0:quote>
          <ns0:quote>dejar</ns0:quote>
          <ns0:quote>heredar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) To give or leave by will; to give by testament.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>legar</ns0:quote>
          <ns0:quote>conferir</ns0:quote>
          <ns0:quote>pasar</ns0:quote>
          <ns0:quote>transmitir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To hand down; to transmit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>confiar</ns0:quote>
          <ns0:quote>dar</ns0:quote>
          <ns0:quote>otorgar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To give; to offer; to commit.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bequest</ns0:orth>
        <ns0:pron>/bɪˈkwɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>testamento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The transfer of property upon the owner's death according to the will of the deceased.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>herencia</ns0:quote>
          <ns0:quote>heredad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person's inheritance; an amount of property given by will.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berate</ns0:orth>
        <ns0:pron>/bɪˈɹeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reprender</ns0:quote>
          <ns0:quote>reñir</ns0:quote>
          <ns0:quote>amonestar</ns0:quote>
          <ns0:quote>reprehender</ns0:quote>
          <ns0:quote>vituperar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To chide or scold vehemently.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berceuse</ns0:orth>
        <ns0:pron>/bɛɹˈsuz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>canción de cuna</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) A composition that resembles a lullaby, often in 6/8 time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bereave</ns0:orth>
        <ns0:pron>/bɪˈɹiːv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>privar</ns0:quote>
          <ns0:quote>arrebatar</ns0:quote>
          <ns0:quote>despojar</ns0:quote>
          <ns0:quote>desposeer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To take away someone or something that is important or close; deprive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bereavement</ns0:orth>
        <ns0:pron>/bɪˈriːvmənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>duelo</ns0:quote>
          <ns0:quote>luto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The state of being bereaved; deprivation; especially the loss of a relative by death.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bereft</ns0:orth>
        <ns0:pron>/bəˈɹɛft/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afligido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a person) Pained by the loss of someone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>carente</ns0:quote>
          <ns0:quote>despojado</ns0:quote>
          <ns0:quote>desproveído</ns0:quote>
          <ns0:quote>desprovisto</ns0:quote>
          <ns0:quote>falto</ns0:quote>
          <ns0:quote>privado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Deprived of, stripped of, robbed of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beret</ns0:orth>
        <ns0:pron>/bəˈɹeɪ/</ns0:pron>
        <ns0:pron>/ˈbɛɹeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>boina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(headwear) A type of round, brimless cap with a soft top and a headband to secure it to the head; usually culturally associated with France.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beriberi</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beriberi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pathology) An ailment caused by a deficiency of thiamine (vitamin B1), leading to lethargy and organ complications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berkelium</ns0:orth>
        <ns0:pron>/bɜːɹˈkiːliəm/</ns0:pron>
        <ns0:pron>/ˈbɜːɹkliəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>berkelio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A transuranic chemical element (symbol Bk) with an atomic number of 97.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berm</ns0:orth>
        <ns0:pron>/bɜː(ɹ)m/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acotamiento</ns0:quote>
          <ns0:quote>arcén</ns0:quote>
          <ns0:quote>berma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Indiana, Ohio, Pennsylvania, New Zealand) A strip of land between a street and sidewalk.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berry</ns0:orth>
        <ns0:pron>/ˈbɛɹ.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>baya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small succulent fruit, of any one of many varieties.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(botany) A soft fruit which develops from a single ovary and contains seeds not encased in pits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berrypecker</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>picabayas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any of various birds of the genera Melanocharis and Rhamphocharis, native to New Guinea, whose diet is dominated by berries and small fruits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berserk</ns0:orth>
        <ns0:pron>/-ˈsɜːk/</ns0:pron>
        <ns0:pron>/-ˈzɚk/</ns0:pron>
        <ns0:pron>/bəˈsɚk/</ns0:pron>
        <ns0:pron>/bəˈzɜːk/</ns0:pron>
        <ns0:pron>/bɚˈsɚk/</ns0:pron>
        <ns0:pron>/bɜː-/</ns0:pron>
        <ns0:pron>/ˈbɚˌsɚk/</ns0:pron>
        <ns0:pron>/ˈbɜːsɜːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuera de control</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Furiously, injuriously, or maniacally violent or out of control.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berth</ns0:orth>
        <ns0:pron>/beːθ/</ns0:pron>
        <ns0:pron>/bøːθ/</ns0:pron>
        <ns0:pron>/bɛɹθ/</ns0:pron>
        <ns0:pron>/bɛːθ/</ns0:pron>
        <ns0:pron>/bɜɹθ/</ns0:pron>
        <ns0:pron>/bɜːθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>catre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) A place on a vessel to sleep, especially a bed on the side of a cabin.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(by extension) A room in a vessel in which the officers or company mess#Verb 2 and reside; also, a room or other place in a vessel for storage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embarcadero</ns0:quote>
          <ns0:quote>amarradero</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(by extension) A place for a vessel to lie at anchor or to moor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>plaza</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A position or seed in a tournament bracket.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berth</ns0:orth>
        <ns0:pron>/beːθ/</ns0:pron>
        <ns0:pron>/bøːθ/</ns0:pron>
        <ns0:pron>/bɛɹθ/</ns0:pron>
        <ns0:pron>/bɛːθ/</ns0:pron>
        <ns0:pron>/bɜɹθ/</ns0:pron>
        <ns0:pron>/bɜːθ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atracar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) To bring (a ship or other vessel) into a berth (noun sense 1.1); also, to provide a berth for (a vessel).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>berthing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>amarradura</ns0:quote>
          <ns0:quote>embarco</ns0:quote>
          <ns0:quote>embarque</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beryl</ns0:orth>
        <ns0:pron>/ˈbɛɹ.əl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>berilo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, mineral) A mineral of pegmatite deposits, often used as a gemstone (molecular formula Be3Al2Si6O18).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>berilio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) A dull blueish green color.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beryllium</ns0:orth>
        <ns0:pron>/bəˈɹɪl.i.əm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>berilio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The chemical element (symbol Be) with an atomic number of 4; a soft silvery-white low density alkaline earth metal with specialist industrial applications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beryllium oxide</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>óxido de berilio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(inorganic compound) A white, crystalline compound, BeO, used in semiconductors and in specialist ceramic applications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>besague</ns0:orth>
        <ns0:pron>/ˈbɛs.ə.ɡju/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>varaescudo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A plate (as of armor) that protects an otherwise-exposed area, such as the armpit (alternative form of besagew), the elbow, or the hand</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beseech</ns0:orth>
        <ns0:pron>/bɪˈsiːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>implorar</ns0:quote>
          <ns0:quote>rogar</ns0:quote>
          <ns0:quote>suplicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To beg or request for (something).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beset</ns0:orth>
        <ns0:pron>/bɪˈsɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cercar</ns0:quote>
          <ns0:quote>circuir</ns0:quote>
          <ns0:quote>circundar</ns0:quote>
          <ns0:quote>sitiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To surround or hem in.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asediar</ns0:quote>
          <ns0:quote>sitiar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, sometimes, figurative) To attack or assail, especially from all sides.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beside</ns0:orth>
        <ns0:pron>/biˈsaɪd/</ns0:pron>
        <ns0:pron>/bəˈsaɪd/</ns0:pron>
        <ns0:pron>/bɪˈsaɪd/</ns0:pron>
        <ns0:pron>/bɪˈsʌɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al lado de</ns0:quote>
          <ns0:quote>cabe</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Next to; at the side of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beside oneself</ns0:orth>
      </ns0:form>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fuera de sí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Overcome; consumed by an emotion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beside the point</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>no venir a cuento</ns0:quote>
          <ns0:quote>no venir al caso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Irrelevant, moot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>besides</ns0:orth>
        <ns0:pron>/biˈsaɪdz/</ns0:pron>
        <ns0:pron>/bəˈsaɪdz/</ns0:pron>
        <ns0:pron>/bɪˈsaɪdz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>además</ns0:quote>
          <ns0:quote>aparte</ns0:quote>
          <ns0:quote>amén de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(conjunctive) Also; in addition.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>además</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(conjunctive) Used to emphasize an additional point, especially an important or stronger reason; moreover; furthermore.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de lo contrario</ns0:quote>
          <ns0:quote>si no</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Otherwise; else.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>besides</ns0:orth>
        <ns0:pron>/biˈsaɪdz/</ns0:pron>
        <ns0:pron>/bəˈsaɪdz/</ns0:pron>
        <ns0:pron>/bɪˈsaɪdz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aparte de</ns0:quote>
          <ns0:quote>además</ns0:quote>
          <ns0:quote>además de</ns0:quote>
          <ns0:quote>asimismo</ns0:quote>
          <ns0:quote>extra de</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In addition to.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>excepto</ns0:quote>
          <ns0:quote>salvo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Other than; except for; instead of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>besiege</ns0:orth>
        <ns0:pron>/bəˈsiːd͡ʒ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asediar</ns0:quote>
          <ns0:quote>sitiar</ns0:quote>
          <ns0:quote>poner sitio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To beset or surround with armed forces for the purpose of compelling to surrender, to lay siege to, beleaguer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asaeteado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, figuratively) To beleaguer, to vex, to lay siege to, to beset.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>besmirch</ns0:orth>
        <ns0:pron>/bɪˈsmɜːtʃ/</ns0:pron>
        <ns0:pron>/bɪˈsmɝːt͡ʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ensuciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, literary) To make dirty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>manchar</ns0:quote>
          <ns0:quote>empañar</ns0:quote>
          <ns0:quote>enlodar</ns0:quote>
          <ns0:quote>macular</ns0:quote>
          <ns0:quote>mancillar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To tarnish something, especially someone's reputation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>besotted</ns0:orth>
        <ns0:pron>/bɪˈsɒtɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>embelesado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Infatuated.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>borracho</ns0:quote>
          <ns0:quote>ebrio</ns0:quote>
          <ns0:quote>intoxicado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) Intoxicated, drunk.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bespectacled</ns0:orth>
        <ns0:pron>/bɪˈspɛktəkəld/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anteojudo</ns0:quote>
          <ns0:quote>con gafas</ns0:quote>
          <ns0:quote>gafotas</ns0:quote>
          <ns0:quote>gafudo</ns0:quote>
          <ns0:quote>que lleva gafas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Wearing spectacles (glasses).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bespoke</ns0:orth>
        <ns0:pron>/bəˈspoʊk/</ns0:pron>
        <ns0:pron>/bɪˈspəʊk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a medida</ns0:quote>
          <ns0:quote>customizado</ns0:quote>
          <ns0:quote>personalizado</ns0:quote>
          <ns0:quote>tuneado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Made or done in a way adjusted to the needs of a specific person or group (e.g., customer, health care patient, do-it-yourselfer), and thus specialized and, in some cases, unique.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>customizante</ns0:quote>
          <ns0:quote>personalizante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating to someone who makes custom-made products, especially clothing items.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best</ns0:orth>
        <ns0:pron>/ˈbɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Most superior; most favorable.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best</ns0:orth>
        <ns0:pron>/ˈbɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To the most advantage; with the most success, cause, profit, benefit, or propriety.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best</ns0:orth>
        <ns0:pron>/ˈbɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>flor</ns0:quote>
          <ns0:quote>nata</ns0:quote>
          <ns0:quote>élite</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) The person (or persons; or thing or things) that is (are) most excellent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best</ns0:orth>
        <ns0:pron>/ˈbɛst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aventajar</ns0:quote>
          <ns0:quote>derrotar</ns0:quote>
          <ns0:quote>rebasar</ns0:quote>
          <ns0:quote>sobrepasar</ns0:quote>
          <ns0:quote>superar</ns0:quote>
          <ns0:quote>vencer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To beat in a contest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best before date</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>fecha de caducidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A food quality marking which denotes the date until which a food item is guaranteed to be at its best.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best friend</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor amiga</ns0:quote>
          <ns0:quote>mejor amigo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An especially close and trusted friend.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best friend forever</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor amigo por siempre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who is an especially close and trusted friend over a long period of time.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best man</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>padrino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The primary attendant to the groom in a wedding ceremony.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best regards</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atentamente</ns0:quote>
          <ns0:quote>cordialmente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Used as a polite closing of a letter</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best-case scenario</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en el mejor de los casos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Any situation or conclusion which could not be any better; the best possible outcome.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>best-selling</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>superventas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(marketing) Highly popular with consumers purchasing goods within a specific class.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestial</ns0:orth>
        <ns0:pron>/ˈbis.t͡ʃəl/</ns0:pron>
        <ns0:pron>/ˈbɛs.ti.əl/</ns0:pron>
        <ns0:pron>/ˈbɛs.t͡ʃəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animalesco</ns0:quote>
          <ns0:quote>bestial</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(literally, _, and, _, figuratively) Beast-like</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestiality</ns0:orth>
        <ns0:pron>/ˈbistiˌælɪti/</ns0:pron>
        <ns0:pron>/ˈbɛstʃəlˌlɪtɪ/</ns0:pron>
        <ns0:pron>/ˌbist͡ʃiˈælɪti/</ns0:pron>
        <ns0:pron>/ˌbɛst͡ʃiˈælɪti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestialismo</ns0:quote>
          <ns0:quote>bestialidad</ns0:quote>
          <ns0:quote>zoofilia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Sexual activity between a human and another animal species.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestialidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) A status of lower animal.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestialize</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestializar</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestiary</ns0:orth>
        <ns0:pron>/ˈbiːstiˌɛɹi/</ns0:pron>
        <ns0:pron>/ˈbɛstiˌɛɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bestiario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A medieval treatise of various real or imaginary animals.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestir</ns0:orth>
        <ns0:pron>/biˈstɝ/</ns0:pron>
        <ns0:pron>/bəˈstɝ/</ns0:pron>
        <ns0:pron>/bɪˈstɜː/</ns0:pron>
        <ns0:pron>/bɪˈstɝ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To put into brisk or vigorous action; to move with life and vigor.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>animarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(reflexive) To make active; to rouse oneself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestow</ns0:orth>
        <ns0:pron>/bɪˈstoʊ/</ns0:pron>
        <ns0:pron>/bɪˈstəʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>utilizar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To apply or make use of (someone or something); to employ, to use.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conferir</ns0:quote>
          <ns0:quote>acordar</ns0:quote>
          <ns0:quote>conceder</ns0:quote>
          <ns0:quote>depositar</ns0:quote>
          <ns0:quote>estibar</ns0:quote>
          <ns0:quote>guardar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To impart (something) gratuitously; to present (something) to someone or something, especially as a gift or an honour; to confer, to give, to accord; to render.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>alojar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(also, reflexive) To provide (someone or oneself) with accommodation; to find quarters for (someone or oneself); to lodge, to quarter.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestride</ns0:orth>
        <ns0:pron>/bəˈstɹaɪd/</ns0:pron>
        <ns0:pron>/bɪˈstɹaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ahorcajarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be astride something, to stand over or sit on with legs on either side, especially to sit on a horse.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bestseller</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>superventas</ns0:quote>
          <ns0:quote>bestseller</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A book or other product that has sold in large numbers.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bet</ns0:orth>
        <ns0:pron>/ˈbɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apuesta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A wager, an agreement between two parties that a stake (usually money) will be paid by the loser to the winner (the winner being the one who correctly forecast the outcome of an event).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>bet</ns0:orth>
        <ns0:pron>/ˈbɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, ditransitive) To stake or pledge upon the outcome of an event; to wager.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(poker) To place money into the pot in order to require others do the same, usually only used for the first person to place money in the pot on each round.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apostar</ns0:quote>
          <ns0:quote>a que</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To be sure of something; to be able to count on something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beta</ns0:orth>
        <ns0:pron>/ˈbeɪtə/</ns0:pron>
        <ns0:pron>/ˈbeʈɑ/</ns0:pron>
        <ns0:pron>/ˈbiʈɑ/</ns0:pron>
        <ns0:pron>/ˈbiːtə/</ns0:pron>
        <ns0:pron>/ˈbɛtə/</ns0:pron>
        <ns0:pron>[ˈbeɪɾə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(of a person, object or action) Associated with the beta male/female archetype.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beta</ns0:orth>
        <ns0:pron>/ˈbeɪtə/</ns0:pron>
        <ns0:pron>/ˈbeʈɑ/</ns0:pron>
        <ns0:pron>/ˈbiʈɑ/</ns0:pron>
        <ns0:pron>/ˈbiːtə/</ns0:pron>
        <ns0:pron>/ˈbɛtə/</ns0:pron>
        <ns0:pron>[ˈbeɪɾə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The second letter of the Greek alphabet (Β, β), preceded by alpha (Α, α) and followed by gamma, (Γ, γ). In modern Greek it represents the voiced labiodental fricative sound of v found in the English words have and vase.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beta blocker</ns0:orth>
        <ns0:pron>/ˈbeɪ.tə ˈblɔk.ɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>betabloqueante</ns0:quote>
          <ns0:quote>beta bloqueador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A blocking agent, one of a class of drugs used to treat hypertension and control the rate at which the heart beats.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beta wave</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>onda beta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(neurology) An electrical signal produced by the brain while the subject mentally active.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>beta-carotene</ns0:orth>
        <ns0:pron>/biː.təˈka.ɹə.tiːn/</ns0:pron>
        <ns0:pron>/ˌbeɪ.təˈkɛɹ.əˌtin/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>betacaroteno</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betatron</ns0:orth>
        <ns0:pron>/ˈbeɪ.təˌtɹɑn/</ns0:pron>
        <ns0:pron>/ˈbiː.təˌtɹɒn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>betatrón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(physics) A form of cyclotron used to accelerate electrons to high speed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betel</ns0:orth>
        <ns0:pron>/ˈbiːtəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>betel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An evergreen Indian creeping shrub, Piper betle, whose dried leaves are chewed with betel nut: the betel pepper.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The betel palm, Areca catechu, and in particular its seed, the areca nut or betel nut.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A quid (chewing preparation) containing these and other plant materials; paan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betel nut</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nuez de areca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An egg-shaped seed of the betel palm; wrapped in the leaves of the betel pepper and chewed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betel palm</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>areca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An Asiatic palm, Areca catechu, whose seeds are betel nuts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betimes</ns0:orth>
        <ns0:pron>/bəˈtaɪmz/</ns0:pron>
        <ns0:pron>/bɪˈtaɪmz/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>al alba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(dated) In good season or time; early, especially in the morning; seasonably.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betony</ns0:orth>
        <ns0:pron>/ˈbɛtəni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>betónica</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Stachys officinalis (syn. Betonica officinalis, an herb used in traditional European medicine.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betray</ns0:orth>
        <ns0:pron>/bəˈtɹeɪ/</ns0:pron>
        <ns0:pron>/bɪˈtɹeɪ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>traicionar</ns0:quote>
          <ns0:quote>entregar</ns0:quote>
          <ns0:quote>vender</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To deliver into the hands of an enemy by treachery or fraud, in violation of trust; to give up treacherously or faithlessly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>traicionar</ns0:quote>
          <ns0:quote>engañar</ns0:quote>
          <ns0:quote>delatar</ns0:quote>
          <ns0:quote>demostrar</ns0:quote>
          <ns0:quote>mostrar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To prove faithless or treacherous to, as to a trust or one who trusts; to be false to; to deceive.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>delatar</ns0:quote>
          <ns0:quote>traicionar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To violate the confidence of, by disclosing a secret, or that which one is bound in honor not to make known.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>confundir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To mislead; to expose to inconvenience not foreseen; to lead into error or sin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betroth</ns0:orth>
        <ns0:pron>/-ˈtɹɔθ/</ns0:pron>
        <ns0:pron>/-ˈtɹəʊθ/</ns0:pron>
        <ns0:pron>/bəˈtɹoʊð/</ns0:pron>
        <ns0:pron>/bɪˈtɹɐʉð/</ns0:pron>
        <ns0:pron>/bɪˈtɹəʉð/</ns0:pron>
        <ns0:pron>/bɪˈtɹəʊð/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comprometerse en matrimonio</ns0:quote>
          <ns0:quote>desposarse</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comprometer en matrimonio</ns0:quote>
          <ns0:quote>desposar</ns0:quote>
          <ns0:quote>prometer (en matrimonio)</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) Often of a parent or guardian: to promise that (two people) be married to each other; specifically and chiefly, to promise that (a woman) be given in marriage to a man; to affiance.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betrothal</ns0:orth>
        <ns0:pron>/bɪˈtɹoʊ.ðəl/</ns0:pron>
        <ns0:pron>/bɪˈtɹɐʉ.ðəl/</ns0:pron>
        <ns0:pron>/bɪˈtɹəʉ.ðəl/</ns0:pron>
        <ns0:pron>/bɪˈtɹəʊ.ðəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desposamiento</ns0:quote>
          <ns0:quote>desposorio</ns0:quote>
          <ns0:quote>desposorios</ns0:quote>
          <ns0:quote>esponsales</ns0:quote>
          <ns0:quote>palabra de matrimonio</ns0:quote>
          <ns0:quote>promesa de matrimonio</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betrothed</ns0:orth>
        <ns0:pron>/bɪˈtɹəʊðd/</ns0:pron>
        <ns0:pron>/bɪˈtɹəʊθt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>comprometida</ns0:quote>
          <ns0:quote>comprometido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who is betrothed, i.e. a fiancé or fiancée.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betrothed</ns0:orth>
        <ns0:pron>/bɪˈtɹəʊðd/</ns0:pron>
        <ns0:pron>/bɪˈtɹəʊθt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desposado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>past of betroth</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better</ns0:orth>
        <ns0:pron>/ˈbɛt.ə/</ns0:pron>
        <ns0:pron>/ˈbɛt.əɹ/</ns0:pron>
        <ns0:pron>[ˈbeɾ.ɐ]</ns0:pron>
        <ns0:pron>[ˈbeɾ.ə]</ns0:pron>
        <ns0:pron>[ˈbeʔ.ə]</ns0:pron>
        <ns0:pron>[ˈbɛtʰ.ə]</ns0:pron>
        <ns0:pron>[ˈbɛtʰ.ɚ~ˈbɛθ̠.ɚ~ˈbɛt̪.ɚ]</ns0:pron>
        <ns0:pron>[ˈbɛɾ.ɚ]</ns0:pron>
        <ns0:pron>[ˈbɛʔ.ɐ]</ns0:pron>
        <ns0:pron>[ˈbɛʔ.ɚ~ˈbɛʔ.əɾ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Healed or recovered from an injury or illness.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better</ns0:orth>
        <ns0:pron>/ˈbɛt.ə/</ns0:pron>
        <ns0:pron>/ˈbɛt.əɹ/</ns0:pron>
        <ns0:pron>[ˈbeɾ.ɐ]</ns0:pron>
        <ns0:pron>[ˈbeɾ.ə]</ns0:pron>
        <ns0:pron>[ˈbeʔ.ə]</ns0:pron>
        <ns0:pron>[ˈbɛtʰ.ə]</ns0:pron>
        <ns0:pron>[ˈbɛtʰ.ɚ~ˈbɛθ̠.ɚ~ˈbɛt̪.ɚ]</ns0:pron>
        <ns0:pron>[ˈbɛɾ.ɚ]</ns0:pron>
        <ns0:pron>[ˈbɛʔ.ɐ]</ns0:pron>
        <ns0:pron>[ˈbɛʔ.ɚ~ˈbɛʔ.əɾ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor</ns0:quote>
          <ns0:quote>mejores</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>comparative of the adverb well</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better</ns0:orth>
        <ns0:pron>/ˈbɛt.ə/</ns0:pron>
        <ns0:pron>/ˈbɛt.əɹ/</ns0:pron>
        <ns0:pron>[ˈbeɾ.ɐ]</ns0:pron>
        <ns0:pron>[ˈbeɾ.ə]</ns0:pron>
        <ns0:pron>[ˈbeʔ.ə]</ns0:pron>
        <ns0:pron>[ˈbɛtʰ.ə]</ns0:pron>
        <ns0:pron>[ˈbɛtʰ.ɚ~ˈbɛθ̠.ɚ~ˈbɛt̪.ɚ]</ns0:pron>
        <ns0:pron>[ˈbɛɾ.ɚ]</ns0:pron>
        <ns0:pron>[ˈbɛʔ.ɐ]</ns0:pron>
        <ns0:pron>[ˈbɛʔ.ɚ~ˈbɛʔ.əɾ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejorar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give advantage to; to support; to advance the interest of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better half</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>media naranja</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person's spouse or lover, most commonly a man's wife.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better late than never</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más vale tarde que nunca</ns0:quote>
          <ns0:quote>nunca es tarde si la dicha es buena</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>It is better to do something late, than to never do it at all.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better off</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más valdría</ns0:quote>
          <ns0:quote>más valiera</ns0:quote>
          <ns0:quote>más valiese</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better safe than sorry</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más vale prevenir que curar</ns0:quote>
          <ns0:quote>más vale prevenir que lamentarse</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>It is preferable to be cautious in one's choices and actions than to act recklessly and suffer afterwards.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better than nothing</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mejor que nada</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Barely useful; almost worthless or pointless, but nevertheless better than having nothing at all.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better the devil you know than the devil you don't know</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más vale diablo conocido que por conocer</ns0:quote>
          <ns0:quote>más vale malo conocido que bueno por conocer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something bad and familiar is better than something bad and unknown.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>better to light a single candle than to curse the darkness</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>es mejor encender una sola vela que maldecir a la penumbra</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Even in the face of hopelessness and discontent, it is more worthwhile to do some good, however small, in response, than to complain about the situation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>betterment</ns0:orth>
        <ns0:pron>/ˈbɛtəmənt/</ns0:pron>
