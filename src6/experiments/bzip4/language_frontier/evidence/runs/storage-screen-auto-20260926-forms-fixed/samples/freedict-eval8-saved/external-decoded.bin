        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archilaúd</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A fretted and double-necked stringed musical instrument with a large body, double courses in the bass, and two sets of tuning pegs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
