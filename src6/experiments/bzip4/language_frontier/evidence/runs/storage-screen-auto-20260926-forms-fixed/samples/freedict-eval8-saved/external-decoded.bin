        <ns0:pron>/æbˈzɚd/</ns0:pron>
        <ns0:pron>/əbˈsɚd/</ns0:pron>
        <ns0:pron>/əbˈsɜːd/</ns0:pron>
        <ns0:pron>/əbˈzɚd/</ns0:pron>
        <ns0:pron>/əbˈzɜːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absurdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) An absurdity. [early 17th–mid 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absurdism</ns0:orth>
        <ns0:pron>/æbˈsɝdˌɪz.m̩/</ns0:pron>
        <ns0:pron>/æbˈzɝdˌɪz.m̩/</ns0:pron>
        <ns0:pron>/əbˈsɜːdˌɪz.m̩/</ns0:pron>
        <ns0:pron>/əbˈsɝdˌɪz.m̩/</ns0:pron>
        <ns0:pron>/əbˈzɝdˌɪz.m̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absurdismo</ns0:quote>
          <ns0:quote>filosofía del absurdo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, philosophy) A philosophy which holds that the universe is chaotic and irrational and that any attempt to impose order will ultimately fail. [First attested in the mid 20th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absurdity</ns0:orth>
        <ns0:pron>/æbˈsɝd.ɪ.ti/</ns0:pron>
        <ns0:pron>/æbˈzɝd.ɪ.ti/</ns0:pron>
        <ns0:pron>/əbˈsɜːd.ɪ.ti/</ns0:pron>
        <ns0:pron>/əbˈsɝd.ɪ.ti/</ns0:pron>
        <ns0:pron>/əbˈzɝd.ɪ.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absurdo</ns0:quote>
          <ns0:quote>absurdidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) That which is absurd; an absurd action; a logical contradiction. [First attested in the late 15th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>absurdidad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The quality of being absurd or inconsistent with obvious truth, reason, or sound judgment. [First attested in the early 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>absurdly</ns0:orth>
