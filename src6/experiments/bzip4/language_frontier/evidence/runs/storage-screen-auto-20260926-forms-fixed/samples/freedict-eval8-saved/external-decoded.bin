    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Third World</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tercer mundo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical, politics) Those countries not aligned with the west or the east during the Cold War.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(sometimes, pejorative) developing countries, especially that of Africa, Asia and Latin America</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(attributive, pejorative, informal) Any developing country, or a country lacking the perceived internationally respected ideal standards of a society (e.g. sufficient rule of law and internationally respected level of prosperity).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
