        </ns0:cit>
        <ns0:sense>
          <ns0:def>(city) A city, the administrative capital of Luhansk Raion, Luhansk Oblast in the Donbas region, in eastern Ukraine, former administrative capital of the eponymous provonce.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Luhansk People's Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Popular de Lugansk</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Russian-backed, partially-recognized secessionist state proclaimed in Luhansk Oblast, Ukraine, on 27 April 2014. It was later unilaterally annexed by Russia on 30 September 2022.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
