    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>archdeacon</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>archidiácono</ns0:quote>
          <ns0:quote>arcediano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Anglicanism, Eastern Orthodoxy) A senior administrative official in a diocese, just under the bishop, often in charge of an archdeaconry. As a title, it can be filled by either a deacon or priest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
