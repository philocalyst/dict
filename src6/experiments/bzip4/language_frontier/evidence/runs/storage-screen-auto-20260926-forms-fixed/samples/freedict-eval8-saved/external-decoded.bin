          <ns0:def>(transitive) To be or to provide a benefit to.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To receive a benefit (from); to be a beneficiary.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
