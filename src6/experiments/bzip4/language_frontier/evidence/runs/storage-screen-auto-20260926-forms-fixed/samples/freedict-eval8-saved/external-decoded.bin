      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zuni</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zuñi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a Native American Pueblo people, native to the Zuni River valley.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zuni</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zuñi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The language traditionally spoken by members of this tribe.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zuniga</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zuñiga</ns0:quote>
          <ns0:quote>Zúñiga</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zurich</ns0:orth>
        <ns0:pron>/-ɪx/</ns0:pron>
        <ns0:pron>/zʊɹ.ɪk/</ns0:pron>
        <ns0:pron>/ˈzjʊə.ɹɪk/</ns0:pron>
        <ns0:pron>/ˈzɜɹ.ɪk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Zúrich</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The capital city of Zurich canton, Switzerland, on Lake Zurich.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A canton of Switzerland.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zwinglian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zwingliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Relating or referring to Zwingli, his beliefs, or his followers and adherents.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Zwinglian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>zwingliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A follower of Zwingli, who disagreed with Luther in rejecting the doctrine of the presence of Christ in the Eucharist.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a</ns0:orth>
        <ns0:pron>/eɪ/</ns0:pron>
        <ns0:pron>/ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>article</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un</ns0:quote>
          <ns0:quote>una</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unspecified example of (something); the indefinite article. [from before 1150]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a</ns0:orth>
        <ns0:pron>/eɪ/</ns0:pron>
        <ns0:pron>/æ/</ns0:pron>
        <ns0:pron>/æɪ/</ns0:pron>
        <ns0:pron>/ɑː/</ns0:pron>
        <ns0:pron>/ə/</ns0:pron>
        <ns0:pron>[eː]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of the Latin script letter A / a.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a</ns0:orth>
        <ns0:pron>/ɔ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The name of the Cyrillic script letter А / а.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a bad penny always turns up</ns0:orth>
        <ns0:pron>/ə bæd pɛni ɔɫweɪz tɝnz ʌp/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hierba mala nunca muere</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person or thing which is unpleasant, dishonorable, or unwanted tends to appear (or reappear), especially at inopportune times.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a bird in the hand is worth two in the bush</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más vale pájaro en mano que ciento volando</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A sure thing is preferable to the mere chance at something more. [15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a bit much</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>demasiado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal, of undesirable behaviour) More than is reasonable; a bit too much.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a cappella</ns0:orth>
        <ns0:pron>/ˌæ.kæˈpɛl.ə/</ns0:pron>
        <ns0:pron>/ˌæ.kəˈpɛl.ə/</ns0:pron>
        <ns0:pron>/ˌɑ kəˈpɛl.ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a capela</ns0:quote>
          <ns0:quote>a cappella</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(music) In the manner of a choir with no instrumental accompaniment. [from late 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a chain is only as strong as its weakest link</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>una cadena es tan fuerte como su eslabón más débil</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An organization is only as strong or powerful as its weakest person; a group of associates is only as strong as its laziest member.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a closed mouth catches no flies</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en boca cerrada no entran moscas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>It's best not to talk too much.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a closed mouth gathers no feet</ns0:orth>
        <ns0:pron>/ə ˈkloʊzd ˌmaʊθ ˈɡæ.ðɚz noʊ ˈfiːt/</ns0:pron>
        <ns0:pron>/ə ˈkləʊzd ˌmaʊθ ˈɡæ.ðəz nəʊ ˈfiːt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en boca cerrada no entran moscas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(humorous) One who does not speak can be sure of not saying anything embarrassing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a creaking door hangs longest</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>bicho malo nunca muere</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Something annoying or bothersome lasts the longest.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a dime a dozen</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adocenado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(Australia, US, idiomatic) So common as to be practically worthless.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a few</ns0:orth>
        <ns0:pron>/ə ˈfjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>determiner</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>algunos</ns0:quote>
          <ns0:quote>unos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small number of (a set of countable items); more than one but not very many; especially, more than two but not very many (explained in usage note at several).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a few</ns0:orth>
        <ns0:pron>/ə ˈfjuː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pocos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small number of things.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a fortiori</ns0:orth>
        <ns0:pron>/ˈeɪ fɔɹʃˈjɔˑɹaɪ/</ns0:pron>
        <ns0:pron>/ˈɑː fɔːɹtɪˈoʊɹiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a fortiori</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a friend in need is a friend indeed</ns0:orth>
        <ns0:pron>/ə ˌfɹɛnd ən ˈnid ɪz ə ˌfɹɛnd ɪnˈdid/</ns0:pron>
        <ns0:pron>/ə ˌfɹɛnd ɪn ˈniːd ɪz ə ˌfɹɛnd ɪnˈdiːd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>en la mucha necesidad, se conoce al amigo de verdad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>If a friend helps one when one is in need, that person is a true friend.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a good beginning makes a good ending</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo que bien empieza bien acaba</ns0:quote>
          <ns0:quote>quien bien empieza bien acaba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Start off on a good note to reap the benefits at the end.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a journey of a thousand miles begins with a single step</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un viaje de mil millas comienza con un solo paso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Even the longest and most difficult ventures have a starting point.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a la</ns0:orth>
        <ns0:pron>/æ læ/</ns0:pron>
        <ns0:pron>/ɑ lɑ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la</ns0:quote>
          <ns0:quote>a lo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the style or manner of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a la mode</ns0:orth>
        <ns0:pron>/ˌæləˈməʊd/</ns0:pron>
        <ns0:pron>/ˌɑləˈməʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a la moda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Fashionable; in the current style or fashion.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a leopard cannot change its spots</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>genio y figura hasta la sepultura</ns0:quote>
          <ns0:quote>la cabra siempre tira al monte</ns0:quote>
          <ns0:quote>no hay que pedir peras al olmo</ns0:quote>
          <ns0:quote>quien nace lechón muere cochino</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One cannot change one's own nature.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a lie has no legs</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>antes se coge al mentiroso que al cojo</ns0:quote>
          <ns0:quote>la mentira tiene patas cortas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One cannot get away with a lie; the truth will always come out.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a little</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un poco</ns0:quote>
          <ns0:quote>un poquito</ns0:quote>
          <ns0:quote>un pelín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To a small extent or degree.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a little</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un pelín</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A small amount of an uncountable thing.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a little bird told me</ns0:orth>
        <ns0:pron>/ə ˌlɪt(ə)l bɜɹd ˈtoʊld mi/</ns0:pron>
        <ns0:pron>/ə ˌlɪtl̩ bɜːd ˈtəʊld miː/</ns0:pron>
        <ns0:pron>[-ˌlɪɾ(ə)l-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un pajarito me dijo</ns0:quote>
          <ns0:quote>un pajarito me lo contó</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic, chiefly, humorous) I received the information from a source which I am not prepared to disclose.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a lot</ns0:orth>
        <ns0:pron>/ə ˈlɑt/</ns0:pron>
        <ns0:pron>/ə ˈlɒt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>mucho</ns0:quote>
          <ns0:quote>a jierro</ns0:quote>
          <ns0:quote>cosa mala</ns0:quote>
          <ns0:quote>un montón</ns0:quote>
          <ns0:quote>una barbaridad</ns0:quote>
          <ns0:quote>una pechá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Very much; a great deal; to a large extent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>frecuentemente</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) Often; frequently.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a lot</ns0:orth>
        <ns0:pron>/ə ˈlɑt/</ns0:pron>
        <ns0:pron>/ə ˈlɒt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pronoun</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>montón</ns0:quote>
          <ns0:quote>un bonche</ns0:quote>
          <ns0:quote>un raudal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(informal) A large amount.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>asaz</ns0:quote>
          <ns0:quote>bastante</ns0:quote>
          <ns0:quote>mucho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Many things, much.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a man is known by the company he keeps</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>dime con quién andas, y te diré quién eres</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>People are similar in character to their friends.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a new broom sweeps clean</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>escoba nueva barre bien</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(metaphorical) New management will often make radical changes.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a nod is as good as a wink</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a buen entendedor, pocas palabras bastan</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The hint, suggestion etc. can be understood without further explanation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a picture is worth a thousand words</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>una imagen vale más que mil palabras</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A visualisation is a better description than a verbal description.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a posteriori</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a posteriori</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(logic) In a manner that deduces theories from facts.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a priori</ns0:orth>
        <ns0:pron>/ˌeɪ pɹaɪˈɔːɹaɪ/</ns0:pron>
        <ns0:pron>/ˌeɪ pɹaɪˈɔːɹi/</ns0:pron>
        <ns0:pron>/ˌɑː pɹiˈɔːɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a priori</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(logic) In a way based on theoretical deduction rather than empirical observation.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a promise is a promise</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lo prometido es deuda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One must keep one's promises.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a prophet is not without honor save in his own country</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>nadie es profeta en su tierra</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a rolling stone gathers no moss</ns0:orth>
        <ns0:pron>/ə ˈɹol.ɪŋ stoʊn ˈɡæð.əɹz noʊ mɔs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>el que viaja no produce pero sí gasta</ns0:quote>
          <ns0:quote>hombre de muchos oficios pobre seguro</ns0:quote>
          <ns0:quote>piedra movediza nunca moho la cobija</ns0:quote>
          <ns0:quote>piedra que rueda no cría moho</ns0:quote>
          <ns0:quote>piedra que rueda no prende musgo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person who never settles in one place will never be successful.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a spoonful of sugar helps the medicine go down</ns0:orth>
        <ns0:pron>/ə ˈspuːnfəl əv ˈʃʊɡə(ɹ) ˌhɛlps ðə ˈmɛdɪsɪn ɡoʊ ˌdaʊn/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un poquito de azúcar toda purga endulzará</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An otherwise unpleasant situation can be pleasant when a pleasant aspect is deliberately introduced.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a stitch in time saves nine</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>más vale prevenir que curar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A little effort expended sooner to fix a small problem prevents it from becoming a larger problem requiring more effort to fix later.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a stopped clock is right twice a day</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>hasta un reloj parado acierta la hora dos veces al día</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A normally unreliable person or instrument can occasionally provide correct information, even if only by accident.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Someone who repeats the same thing constantly will at some point be correct, if only briefly.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a thing or two</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un rato</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An unspecified amount</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>un rato largo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(meiosis) A considerable amount; a lot.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a watched pot never boils</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>quien espera, desespera</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A process appears to proceed more slowly if one waits for it rather than engaging in other activities.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a wild goose never laid a tame egg</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>proverb</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>de tal palo, tal astilla</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(idiomatic) Most things are inherited and predetermined.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a woman without a man is like a fish without a bicycle</ns0:orth>
        <ns0:pron>/ə ˈwʊmən wɪðˌaʊt ə ˈmæn ɪz laɪk ə ˈfɪʃ wɪðˌaʊt ə ˈbaɪsɪkl̩/</ns0:pron>
        <ns0:pron>/ə ˈwʊmən wɪðˌaʊt ə ˈmæn ɪz laɪk ə ˈfɪʃ wɪðˌaʊt ə ˈbaɪˌsɪkəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>una mujer sin un hombre es como un pez sin bicicleta</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(figuratively, humorous, simile) A woman is capable of living a complete and independent life without a man. [from 1970]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a-</ns0:orth>
        <ns0:pron>/a/</ns0:pron>
        <ns0:pron>/eɪ/</ns0:pron>
        <ns0:pron>/æɪ/</ns0:pron>
        <ns0:pron>/ə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>prefix</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a-</ns0:quote>
          <ns0:quote>an-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not, without, opposite of.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>a.m.</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>AM</ns0:quote>
          <ns0:quote>a. m.</ns0:quote>
          <ns0:quote>de la mañana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(used after the hour) In the 12-hour period from midnight to noon (the first half of the day) when using the 12-hour clock.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aah</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>interjection</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>¡ah!</ns0:quote>
          <ns0:quote>¡ay!</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Indication of amazement or surprise or enthusiasm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aalii</ns0:orth>
        <ns0:pron>/ɑˈliˌi/</ns0:pron>
        <ns0:pron>/ɑːˈliːiː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>chirca</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A bushy small tree, Dodonaea viscosa, native to Hawaii, Australia, Africa, and tropical America, having sticky leaves and dark wood.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aardvark</ns0:orth>
        <ns0:pron>/ˈɑɹd.vɑɹk/</ns0:pron>
        <ns0:pron>/ˈɑːd.vɑːk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cerdo hormiguero</ns0:quote>
          <ns0:quote>oricteropo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The nocturnal, insectivorous, burrowing, mammal Orycteropus afer, of the order Tubulidentata, somewhat resembling a pig, common in some parts of sub-Saharan Africa. [from late 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aardwolf</ns0:orth>
        <ns0:pron>/ˈɑɹdˌwʊlf/</ns0:pron>
        <ns0:pron>/ˈɑːdˌwʊlf/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>lobo de tierra</ns0:quote>
          <ns0:quote>proteles</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A nocturnal, insectivorous mammal, Proteles cristatus, of southern and eastern Africa, related to and resembling the hyena. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ab initio</ns0:orth>
        <ns0:pron>/ˌæb əˈnɪt.i.oʊ/</ns0:pron>
        <ns0:pron>/ˌæb ɪˈnɪʃ.i.oʊ/</ns0:pron>
        <ns0:pron>/ˌɑb əˈnɪt.i.oʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ab initio</ns0:quote>
          <ns0:quote>desde el principio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) From the time when a law, legal right or decree, contract, ownership interest, partnership (etc.) comes into force. [Early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>ab ovo</ns0:orth>
        <ns0:pron>/æˈboʊˌvoʊ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ab ovo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>From the beginning. [from late 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abaca</ns0:orth>
        <ns0:pron>/ˈæb.əˌkɑ/</ns0:pron>
        <ns0:pron>/ˈæb.əˌkɑː/</ns0:pron>
        <ns0:pron>/ˈæb.əˌkə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abacá</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) The fiber of this plant, used in rope, fibers, and cloth. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abacist</ns0:orth>
        <ns0:pron>/əˈbæ.kəst/</ns0:pron>
        <ns0:pron>/əˈbɑ.kəst/</ns0:pron>
        <ns0:pron>/ˈæb.ə.kəst/</ns0:pron>
        <ns0:pron>/ˈæb.ə.səst/</ns0:pron>
        <ns0:pron>/ˈæb.ə.sɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abacista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who uses an abacus in casting accounts; a calculator. [First attested from around (1350 to 1470).]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aback</ns0:orth>
        <ns0:pron>/aˈbak/</ns0:pron>
        <ns0:pron>/əˈbæk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atrás</ns0:quote>
          <ns0:quote>hacia atrás</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic, Geordie) Towards the back or rear; backwards. [First attested prior to 1150.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abaculus</ns0:orth>
        <ns0:pron>/əˈbæk.jə.ləs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abáculo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) A small tile of glass, marble, or other substance, of various colors, used in making ornamental patterns in mosaic pavements; abaciscus.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abacus</ns0:orth>
        <ns0:pron>/əˈbakəs/</ns0:pron>
        <ns0:pron>/ˈæbəkəs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ábaco</ns0:quote>
          <ns0:quote>contador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A device used for performing arithmetical calculations; (rare) a table on which loose counters are placed, or (more commonly) an instrument with beads sliding on rods, or counters in grooves, with one row of beads or counters representing units, the next tens, etc. [from late 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abaft</ns0:orth>
        <ns0:pron>/əˈbæft/</ns0:pron>
        <ns0:pron>/əˈbɑːft/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a popa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) On the aft side; in the stern. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abaft</ns0:orth>
        <ns0:pron>/əˈbæft/</ns0:pron>
        <ns0:pron>/əˈbɑːft/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>preposition</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>a popa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical) Behind; toward the stern relative to some other object or position; aft of. [First attested around the late 15th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abalone</ns0:orth>
        <ns0:pron>/æb.əˈloʊ.ni/</ns0:pron>
        <ns0:pron>/æb.əˈləʊ.ni/</ns0:pron>
        <ns0:pron>/ˈæb.əˌloʊ.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abulón</ns0:quote>
          <ns0:quote>oreja de mar</ns0:quote>
          <ns0:quote>loco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(North America, Australia, Hong Kong, Singapore) An edible univalve mollusc of the genus Haliotis, having a shell lined with mother-of-pearl. [mid 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandon</ns0:orth>
        <ns0:pron>/əˈbæn.dən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desenfreno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A yielding to natural impulses or inhibitions; freedom from artificial constraint, with loss of appreciation of consequences. [Early 19th century.] (Now especially in the phrase with abandon.)</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandon</ns0:orth>
        <ns0:pron>/əˈbæn.dən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>renunciar</ns0:quote>
          <ns0:quote>suspender</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To give up or relinquish control of, to surrender or to give oneself over, or to yield to one's emotions. [First attested from around (1350 to 1470)]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonar</ns0:quote>
          <ns0:quote>renunciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To desist in doing, practicing, following, holding, or adhering to; to turn away from; to permit to lapse; to renounce; to discontinue. [First attested from around (1350 to 1470)]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>renunciar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To leave behind; to desert, as in a ship, a position, or a person, typically in response to overwhelming odds or impending dangers; to forsake, in spite of a duty or responsibility. [First attested in the late 15th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>expulsar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To cast out; to banish; to expel; to reject. [Attested from the mid 16th century until the mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandon hope, all ye who enter here</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>phraseologicalUnit</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonad toda esperanza, aquellos que entréis aquí</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Supposed inscription at the gate of hell.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandon ship</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonar el barco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(nautical, literal) To leave or forsake a ship due to its impending doom.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandonable</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonable</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Able to be abandoned; suitable for abandonment.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandoned</ns0:orth>
        <ns0:pron>/əˈbæn.dənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desenfrenado</ns0:quote>
          <ns0:quote>desinhibido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Having given oneself up to vice; immoral; extremely wicked, or sinning without restraint; irreclaimably wicked. [First attested from 1350 to 1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>No longer maintained by its former owners, residents, or caretakers; forsaken, deserted. [Late 15th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandoner</ns0:orth>
        <ns0:pron>/əˈbændənə/</ns0:pron>
        <ns0:pron>/əˈbændənɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who abandons. [Mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandonment</ns0:orth>
        <ns0:pron>/əˈbæn.dn̩.mn̩t/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandono</ns0:quote>
          <ns0:quote>abandonamiento</ns0:quote>
          <ns0:quote>dejación</ns0:quote>
          <ns0:quote>desamparo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abandoning, or the state of being abandoned; total desertion; relinquishment. [Late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abandonware</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abandonware</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(software, chiefly, _, video games) A software product that is no longer updated or maintained, or whose copyright is no longer defended or which is no longer marketed even by the company who made it.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abapertural</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abapertural</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Not apertural; Away from the aperture.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abase</ns0:orth>
        <ns0:pron>/əˈbeɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>humillar</ns0:quote>
          <ns0:quote>rebajar</ns0:quote>
          <ns0:quote>degradar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To lower, as in condition in life, office, rank, etc., so as to cause pain or hurt feelings; to degrade, to depress, to humble, to humiliate. [from c. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abasement</ns0:orth>
        <ns0:pron>/əˈbeɪs.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abatimiento</ns0:quote>
          <ns0:quote>humillación</ns0:quote>
          <ns0:quote>rebajamiento</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abasing, humbling, or bringing low. [Mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abash</ns0:orth>
        <ns0:pron>/əˈbæʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avergonzar</ns0:quote>
          <ns0:quote>abochornar</ns0:quote>
          <ns0:quote>confundir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make ashamed; to embarrass; to destroy the self-possession of, as by exciting suddenly a consciousness of guilt, mistake, or inferiority; to disconcert; to discomfit. [First attested from around (1150 to 1350).]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abashed</ns0:orth>
        <ns0:pron>/əˈbæʃt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>avergonzado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Embarrassed, disconcerted, or ashamed.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abate</ns0:orth>
        <ns0:pron>/əˈbeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>menguar</ns0:quote>
          <ns0:quote>suprimir</ns0:quote>
        </ns0:cit>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abatir</ns0:quote>
          <ns0:quote>humillar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To bring down (someone) mentally or physically; to lower (someone) in status. [14th–17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>reducir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>To lessen (something) in force or intensity; to moderate. [from 14th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To reduce (something) in amount or size. [from 14th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>To lower in price or value; (law) specifically, of a bequest in a will: to lower in value because the testator's estate is insufficient to satisfy all the bequests in full. [from early 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abatement</ns0:orth>
        <ns0:pron>/əˈbeɪt.mənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>disminución</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abating, or the state of being abated; a lessening, diminution, or reduction; a moderation; removal or putting an end to; the suppression. [First attested from 1340 to 1470.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abattoir</ns0:orth>
        <ns0:pron>/ˈæb.əˌtwɑ/</ns0:pron>
        <ns0:pron>/ˈæb.əˌtwɑɹ/</ns0:pron>
        <ns0:pron>/ˈæb.əˌtwɑː(ɹ)/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>matadero</ns0:quote>
          <ns0:quote>degolladero</ns0:quote>
          <ns0:quote>desolladero</ns0:quote>
          <ns0:quote>rastro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A public slaughterhouse for cattle, sheep, etc. [Early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abaya</ns0:orth>
        <ns0:pron>/əˈbeɪ.jə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abaya</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Synonym of aba.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbatial</ns0:orth>
        <ns0:pron>/aˈbeː.ʃal/</ns0:pron>
        <ns0:pron>/əˈbe.ʃəl/</ns0:pron>
        <ns0:pron>/əˈbeɪ̯.ʃəl/</ns0:pron>
        <ns0:pron>/əˈbæɪ̯.ʃəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abacial</ns0:quote>
          <ns0:quote>abadengo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Belonging to, relating to, or pertaining to an abbey, abbot, or abbess. [late 17th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbess</ns0:orth>
        <ns0:pron>/ˈæb.ɛs/</ns0:pron>
        <ns0:pron>/ˈæb.ɪs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abadesa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A female superior or governess of a nunnery, or convent of nuns, having the same authority over the nuns which the abbots have over the monks. [First attested around 1150 to 1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbey</ns0:orth>
        <ns0:pron>/ˈæb.i/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abadía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A monastery or society of people, secluded from the world and devoted to religion and celibacy, which is headed by an abbot or abbess; also, the monastic building or buildings. [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The church of a monastery. [First attested around 1150 to 1350.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbeystead</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abadía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) The seat of an abbey.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbot</ns0:orth>
        <ns0:pron>/ˈæb.ət/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abad</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The superior or head of an abbey or monastery. [First attested around the early 12th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbreviate</ns0:orth>
        <ns0:pron>/əˈbɹi.vi.eɪt/</ns0:pron>
        <ns0:pron>/əˈbɹiː.vi.eɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviar</ns0:quote>
          <ns0:quote>simplificar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To make shorter; to shorten (in time); to abridge; to shorten by ending sooner than planned. [First attested from around (1350 to 1470).]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbreviated</ns0:orth>
        <ns0:pron>/əˈbɹi.viˌeɪ.tɪd/</ns0:pron>
        <ns0:pron>/əˈbɹiːvieɪtɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviado</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Shortened; made briefer.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Relatively short; shorter than normal, or compared to others.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbreviation</ns0:orth>
        <ns0:pron>/əˌbɹi.viˈeɪ.ʃn̩/</ns0:pron>
        <ns0:pron>/əˌbɹiː.viˈeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviación</ns0:quote>
          <ns0:quote>abreviatura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linguistics) A shortened or contracted form of a word or phrase used to represent the whole, using omission of letters, and sometimes substitution of letters, or duplication of initial letters to signify plurality, including signs such as +, =, @. [Late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abbreviature</ns0:orth>
        <ns0:pron>/əˈbɹi.vi.əˌt͡ʃʊɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abreviatura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abridgment; a compendium; an abstract. [since the late 16th century]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A shortened form of a word or phrase, used in place of the whole; an abbreviation. [since the mid 17th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abc conjecture</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>conjetura abc</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(number theory) Given coprime positive integers a, b and c, such that a + b = c, and d the radical of abc (the product of its distinct prime factors), the conjecture that d is usually not much smaller than c (in other words, that if a and b are divisible by large powers of primes, then c usually is not).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abciximab</ns0:orth>
        <ns0:pron>/æbˈsɪk.sɪˌmæb/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abciximab</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) A powerful anticlotting drug (trademark ReoPro) that inhibits platelet aggregation by binding to a glycoprotein receptor on human platelets and that consists of the Fab fragment from a chimeric monoclonal antibody prepared from humans and mice.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdicate</ns0:orth>
        <ns0:pron>/ˈæb.dɪˌkeɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abdicar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To disclaim and expel from the family, as a father his child; to disown; to disinherit. [mid 16th – early 19th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To reject; to cast off; to discard. [mid 16th – late 17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive) To surrender, renounce or relinquish, as sovereign power; to withdraw definitely from filling or exercising, as a high office, station, dignity; to fail to fulfill responsibility for. [from mid 17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive) To relinquish or renounce a throne, or other high office or dignity; to renounce sovereignty. [First attested in the early 18th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdication</ns0:orth>
        <ns0:pron>/ˌæb.dəˈkeɪ.ʃən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abdicación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of abdicating; the renunciation of a high office, dignity, or trust, by its holder. [First attested in the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdomen</ns0:orth>
        <ns0:pron>/æbˈdoʊ.mən/</ns0:pron>
        <ns0:pron>/æbˈdəʊ.mən/</ns0:pron>
        <ns0:pron>/ˈæb.də.mən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abdomen</ns0:quote>
          <ns0:quote>vientre</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(obsolete) The fat surrounding the belly. [mid 16th c. – late 17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdominal</ns0:orth>
        <ns0:pron>/æbˈdɑm.ə.nl̩/</ns0:pron>
        <ns0:pron>/æbˈdɒm.ə.nl̩/</ns0:pron>
        <ns0:pron>/əbˈdɑm.ə.nl̩/</ns0:pron>
        <ns0:pron>/əbˈdɒm.ə.nl̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abdominal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or pertaining to the abdomen; ventral. [Mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdominal aorta</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aorta abdominal</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdominal cavity</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cavidad abdominal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The hollow portion of the torso within the abdomen, containing the abdominal organs, in mammals below the diaphragm.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdominal wall</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>pared abdominal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The layer of muscles that surrounds the abdominal cavity and contains the abdominal organs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abdominoplasty</ns0:orth>
        <ns0:pron>/æbˈdɑm.ɪ.noʊˌplæs.ti/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abdominoplastia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(surgery, uncountable) The surgical removal of excess flesh from the abdomen, usually for cosmetic reasons.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abduce</ns0:orth>
        <ns0:pron>/æbˈdus/</ns0:pron>
        <ns0:pron>/əbˈdjuːs/</ns0:pron>
        <ns0:pron>/əbˈdjʉs/</ns0:pron>
        <ns0:pron>/əbˈdus/</ns0:pron>
        <ns0:pron>/əbˈd͡ʒuːs/</ns0:pron>
        <ns0:pron>/əbˈd͡ʒʉs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abducir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To draw; to conduct away; to take away; to withdraw; to draw to a different part; to move a limb out away from the center of the body; abduct. [Mid 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abduct</ns0:orth>
        <ns0:pron>/æbˈdʌkt/</ns0:pron>
        <ns0:pron>/əbˈdʌkt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>raptar</ns0:quote>
          <ns0:quote>secuestrar</ns0:quote>
          <ns0:quote>abducir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To take away by force; to carry away (a human being) wrongfully and usually with violence or deception; to kidnap. [Early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abduction</ns0:orth>
        <ns0:pron>/æbˈdək.ʃn̩/</ns0:pron>
        <ns0:pron>/æbˈdʌk.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈdək.ʃn̩/</ns0:pron>
        <ns0:pron>/əbˈdʌk.ʃn̩/</ns0:pron>
        <ns0:pron>/ˈeɪˈbiː.dʌk.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rapto</ns0:quote>
          <ns0:quote>secuestro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Leading away; a carrying away. [from early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abducción</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) The act of abducing or abducting; a drawing apart; the movement which separates a limb or other part from the axis, or middle line, of the body. [from mid-17th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(logic) A syllogism or form of argument in which the major premise is evident, but the minor is only probable. [from late 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>rapto</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) The wrongful, and usually forcible, carrying off of a human being. [from mid-18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abductor</ns0:orth>
        <ns0:pron>/æbˈdʌk.tɚ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>raptor</ns0:quote>
          <ns0:quote>secuestrador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who abducts; a kidnapper. [mid 19th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abductor</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(anatomy) A muscle which serves to draw a part out, or from the median line of the body [early 17th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abecedary</ns0:orth>
        <ns0:pron>/ˌeɪ.biˈsi.də.ɹi/</ns0:pron>
        <ns0:pron>/ˌeɪ.biˈsi.dɚ.i/</ns0:pron>
        <ns0:pron>/ˌeɪ.biːˈsiː.də.ɹi/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abecedario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One that teaches or learns the alphabet or the fundamentals of any subject; abecedarian. [from late 16th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abed</ns0:orth>
        <ns0:pron>/əˈbɛd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adv</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acostado</ns0:quote>
          <ns0:quote>en cama</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(archaic) In bed, or on the bed; confined to bed. [First attested from 1150 to 1350.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abelian</ns0:orth>
        <ns0:pron>/əˈbi.li.ən/</ns0:pron>
        <ns0:pron>/əˈbil.jən/</ns0:pron>
        <ns0:pron>/əˈbiːlɪən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abeliano</ns0:quote>
          <ns0:quote>conmutativo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics) Of an algebraic structure (usually a group or algebra), having a commutative defining operation. [Mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abelian group</ns0:orth>
        <ns0:pron>/əˈbi.li.ən ɡɹup/</ns0:pron>
        <ns0:pron>/əˈbil.jən ɡɹup/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>grupo abeliano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(algebra) A group in which the group operation is commutative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abelmosk</ns0:orth>
        <ns0:pron>/ˈeɪblmɑsk/</ns0:pron>
        <ns0:pron>/ˈeɪblmɒsk/</ns0:pron>
        <ns0:pron>/ˈeɪbəlmɒsk/</ns0:pron>
        <ns0:pron>/ˈeɪbəlˌmɑsk/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abelmosco</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The tropical evergreen shrub Abelmoschus moschatus itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aberrance</ns0:orth>
        <ns0:pron>/æˈbɛɹ.n̩ts/</ns0:pron>
        <ns0:pron>/ˈæ.bɛɹ.n̩s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>State of being aberrant; a wandering from the right way; deviation from truth, rectitude. [Mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aberrant</ns0:orth>
        <ns0:pron>/əˈbeɹ.ənt/</ns0:pron>
        <ns0:pron>/əˈbɛɹ.ənt/</ns0:pron>
        <ns0:pron>/ˈæb.ə.ɹənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberrante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Differing from the norm. [First attested sometime between the mid 16th century and the early 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberrante</ns0:quote>
          <ns0:quote>anormal</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(sometimes, figuratively) Straying from the right way; deviating from morality or truth. [First attested in the mid 18th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>anómalo</ns0:quote>
          <ns0:quote>atípico</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(botany, zoology) Deviating from the ordinary or natural type; exceptional; abnormal. [First attested in the mid 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aberration</ns0:orth>
        <ns0:pron>/ˌæb.əˈɹeɪ.ʃn̩/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberración</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of wandering; deviation from truth, moral rectitude; abnormal; divergence from the straight, correct, proper, normal, or from the natural state. [Late 16th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(optics) The convergence to different foci, by a lens or mirror, of rays of light emanating from one and the same point, or the deviation of such rays from a single focus; a defect in a focusing mechanism that prevents the intended focal point. [Mid 18th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(zoology, botany) Atypical development or structure; deviation from the normal type; an aberrant organ. [Mid 19th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(medicine) A deviation of a tissue, organ or mental functions from what is considered to be within the normal range.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberración</ns0:quote>
          <ns0:quote>alienación</ns0:quote>
          <ns0:quote>locura</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A small periodical change of the apparent positions of the stars and other heavenly bodies, due to the combined effect of the motion of light and the motion of the observer. [Mid 18th century.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A partial alienation of reason. [Early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberración</ns0:quote>
          <ns0:quote>enajenación</ns0:quote>
          <ns0:quote>enfermedad mental</ns0:quote>
          <ns0:quote>perturbación</ns0:quote>
          <ns0:quote>trastorno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A mental disorder, especially one of a minor or temporary character. [Early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>aberration of light</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aberración de la luz</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A phenomenon that produces an apparent motion of celestial objects about their true positions, dependent on the velocity of the observer.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abessive</ns0:orth>
        <ns0:pron>/æˈbɛ.sɪv/</ns0:pron>
        <ns0:pron>/ˈæˌbɛ.sɪv/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abesivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammar) The abessive case, or a word in this case. [19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abessive case</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>caso abesivo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(grammatical case) A grammatical case used to express the lack or absence of something. It has the meaning of the English preposition without or the affix -less.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abet</ns0:orth>
        <ns0:pron>/əˈbɛt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>incitar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive, crime) To incite; to assist or encourage by aid or countenance in crime. [ca. 1350–1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>ayudar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To support, countenance, maintain, uphold, or aid (any good cause, opinion, or action). [late 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abettor</ns0:orth>
        <ns0:pron>/əˈbɛtə/</ns0:pron>
        <ns0:pron>/əˈbɛtɚ/</ns0:pron>
        <ns0:pron>[-ɾɚ]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cómplice</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One that abets an offender; one that incites; instigates; encourages. [First attested from 1350 to 1470.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>A supporter or advocate. [Late 16th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abeyance</ns0:orth>
        <ns0:pron>/əˈbeɪ.əns/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>esperanza</ns0:quote>
          <ns0:quote>expectativa</ns0:quote>
          <ns0:quote>suspenso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(legal) Expectancy; a condition when an ownership of real property is undetermined; lapse in succession of ownership of estate, or title. [Late 16th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>desuso</ns0:quote>
          <ns0:quote>suspensión</ns0:quote>
          <ns0:quote>suspenso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Suspension; temporary suppression; dormant condition. [Mid 17th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abhor</ns0:orth>
        <ns0:pron>/æbˈhɔɹ/</ns0:pron>
        <ns0:pron>/əbˈhɔɹ/</ns0:pron>
        <ns0:pron>/əbˈhɔː/</ns0:pron>
        <ns0:pron>/əbˈɔː/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>detestar</ns0:quote>
          <ns0:quote>abominar</ns0:quote>
          <ns0:quote>aborrecer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To regard (someone or something) as horrifying or detestable; to feel great repugnance toward. [First attested from around (1350 to 1470).]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abhorrence</ns0:orth>
        <ns0:pron>/æbˈhɑɹ.n̩(t)s/</ns0:pron>
        <ns0:pron>/æbˈhɔɹ.n̩(t)s/</ns0:pron>
        <ns0:pron>/əbˈhɒɹ.n̩(t)s/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborrecimiento</ns0:quote>
          <ns0:quote>repugnancia</ns0:quote>
          <ns0:quote>odio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable, countable) Extreme aversion or detestation; the feeling of utter dislike or loathing. [Mid 17th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abhorrent</ns0:orth>
        <ns0:pron>/æbˈ(h)ɒɹ.ənt/</ns0:pron>
        <ns0:pron>/æbˈhɑɹ.ənt/</ns0:pron>
        <ns0:pron>/æbˈhɔɹ.ənt/</ns0:pron>
        <ns0:pron>/əbˈ(h)ɒɹ.ənt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aborrecible</ns0:quote>
          <ns0:quote>aborrible</ns0:quote>
          <ns0:quote>repugnante</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Detestable or repugnant. [Early 19th century.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abide</ns0:orth>
        <ns0:pron>/əˈbaɪd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguantar</ns0:quote>
          <ns0:quote>resistir</ns0:quote>
          <ns0:quote>permanecer</ns0:quote>
          <ns0:quote>durar</ns0:quote>
          <ns0:quote>habitar</ns0:quote>
          <ns0:quote>morar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To endure without yielding; to withstand. [from mid-12th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tolerar</ns0:quote>
          <ns0:quote>habitar</ns0:quote>
          <ns0:quote>morar</ns0:quote>
          <ns0:quote>residir</ns0:quote>
          <ns0:quote>soportar</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To bear patiently. [from late 15th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>afrontar</ns0:quote>
          <ns0:quote>apechugar[se] con</ns0:quote>
          <ns0:quote>habitar</ns0:quote>
          <ns0:quote>morar</ns0:quote>
          <ns0:quote>residir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To pay for; to stand the consequences of. [from late 16th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>habitar</ns0:quote>
          <ns0:quote>morar</ns0:quote>
          <ns0:quote>residir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Used in a phrasal verb: .</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, obsolete) To pause; to delay. [from ca. 1150—1350 to mid-17th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, archaic) To have one's abode. [from ca. 1350—1470]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(intransitive, archaic) To endure; to remain; to last. [from ca. 1350—1470]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To stand ready for; to await for someone; watch for. [from early 12th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, obsolete) To endure or undergo a hard trial or a task; to stand up under. [from ca. 1150—1350 to early 18th c.]</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(transitive, archaic) To await submissively; accept without question; submit to. [from ca. 1350—1470]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>aguardar</ns0:quote>
          <ns0:quote>esperar</ns0:quote>
          <ns0:quote>habitar</ns0:quote>
          <ns0:quote>morar</ns0:quote>
          <ns0:quote>residir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, obsolete) To wait in expectation. [mid-12th–mid-17th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>permanecer</ns0:quote>
          <ns0:quote>quedar</ns0:quote>
          <ns0:quote>habitar</ns0:quote>
          <ns0:quote>morar</ns0:quote>
          <ns0:quote>residir</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(intransitive, archaic, Scotland) To stay; to continue in a place; to remain stable or fixed in some state or condition; to be left. [from ca. 1150—1350]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abide by</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acatar</ns0:quote>
          <ns0:quote>atenerse a</ns0:quote>
          <ns0:quote>someterse a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To accept (a decision or law) and act in accordance with it; to conform to (a decision or law); to acquiesce to (a decision or law).</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>adherirse a</ns0:quote>
          <ns0:quote>observar</ns0:quote>
          <ns0:quote>respaldar</ns0:quote>
          <ns0:quote>someterse a</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(transitive) To remain faithful to (something or someone); to adhere to (an idea or plan).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
