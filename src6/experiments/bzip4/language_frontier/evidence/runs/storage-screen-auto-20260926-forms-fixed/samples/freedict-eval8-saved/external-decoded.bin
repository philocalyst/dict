        <ns0:orth>acetaminophen</ns0:orth>
        <ns0:pron>/əˌsitəˈmɪnəfən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>paracetamol</ns0:quote>
          <ns0:quote>acetaminofén</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(North America) A white crystalline compound used in medicine as an anodyne to relieve pain and reduce fever.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
