        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Sodoma</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical, Quranic) A city in the Middle East which, according to the Bible and Islamic tradition, but not specifically named in the Qur'an, was destroyed by God (along with Gomorrah) for the sins of its inhabitants.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
