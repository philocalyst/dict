          <ns0:quote>autorickshaw</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A motorized rickshaw of South, Southeast and East Asia, often available for hire in the manner of a taxi.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
