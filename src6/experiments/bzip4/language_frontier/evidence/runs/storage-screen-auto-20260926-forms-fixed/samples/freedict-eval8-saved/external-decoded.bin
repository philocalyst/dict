          <ns0:quote>distribución de Laplace</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(statistics) A probability distribution consisting of two exponential distributions, one positive and one negative.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Laplace operator</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>laplaciano</ns0:quote>
          <ns0:quote>operador de Laplace</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(mathematics, physics) A differential operator,denoted ∆ and defined on \mathbb{R}^n as \Delta = \sum_{i=1}^n \frac{\partial^2}{\partial x_i^2}, used in the modeling of wave propagation, heat flow and many other applications.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
