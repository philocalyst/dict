      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abolicionista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(chiefly, historical) In favor of the abolition of slavery. [since the late 18th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>abolitionist</ns0:orth>
        <ns0:pron>/ˌæ.bəˈlɪʃ.n̩.əst/</ns0:pron>
        <ns0:pron>/ˌæ.bəˈlɪʃ.n̩.ɪst/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abolicionista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A person favoring or advocating for the abolition of any particular institution or practice. [since the late 18th century]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
