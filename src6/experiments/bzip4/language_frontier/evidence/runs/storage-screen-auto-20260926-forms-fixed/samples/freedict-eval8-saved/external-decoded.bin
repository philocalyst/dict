    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Triangulum Galaxy</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Galaxia del Triángulo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(galaxy) A relatively nearby spiral galaxy in the Local Group, together with the Milky Way galaxy. It is at a distance of approximately 2.6 million light years from Earth, in the direction of the constellation Triangulum, and is also known as M33 and NGC 598.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
