        <ns0:sense>
          <ns0:def>(mathematics, of an operator) Equal to its own transpose conjugate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
