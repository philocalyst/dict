      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>imberbe</ns0:quote>
          <ns0:quote>lampiño</ns0:quote>
          <ns0:quote>barbilampiño</ns0:quote>
          <ns0:quote>carilampiño</ns0:quote>
          <ns0:quote>desbarbado</ns0:quote>
          <ns0:quote>sin barba</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(ornithology) Lacking a beard (a defined patch of feathers below the beak).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
