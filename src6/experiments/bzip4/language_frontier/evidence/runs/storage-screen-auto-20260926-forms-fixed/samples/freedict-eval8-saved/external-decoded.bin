      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balaj</ns0:quote>
          <ns0:quote>balaje</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A rose-coloured spinel once thought to be a type of ruby.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balboa</ns0:orth>
        <ns0:pron>/bælˈbəʊə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balboa</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The currency of Panama, divided into 100 centésimos</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balconing</ns0:orth>
        <ns0:pron>/bælˈkoʊnɪŋ/</ns0:pron>
        <ns0:pron>/ˈbælkənɪŋ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balconing</ns0:quote>
          <ns0:quote>balconismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The act of jumping between the balconies of two hotel rooms; especially of tourists in Spain.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>The act of jumping from a balcony towards a swimming pool.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>balcony</ns0:orth>
        <ns0:pron>/bælˈkəʊni/</ns0:pron>
        <ns0:pron>/ˈbælkəni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>balcón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(architectural element) An accessible structure extending from a building, especially outside a window.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>palco</ns0:quote>
          <ns0:quote>balcón</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An accessible structure overlooking a stage or the like.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
