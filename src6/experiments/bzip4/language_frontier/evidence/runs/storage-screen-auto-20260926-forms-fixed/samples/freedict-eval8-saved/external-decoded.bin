        <ns0:pron>/ˈhʊməʃ/</ns0:pron>
        <ns0:pron>/ˈxʊməʃ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>jumash</ns0:quote>
        </ns0:cit>
        <ns0:sense>
