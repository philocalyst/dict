      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tigris</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A river in Southwest Asia flowing 1,150 miles east-southeast from the Armenian Highland in Turkey through Iraq. It forms the eastern edge of classical Mesopotamia. It unites with the Euphrates River to form the Shatt al-Arab before flowing into the Persian Gulf.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
