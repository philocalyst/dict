        <ns0:sense>
          <ns0:def>A songbird, Horornis diphone.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Japanese giant hornet</ns0:orth>
