        </ns0:cit>
        <ns0:sense>
          <ns0:def>A peninsula in the northeastern extremity of Asia; Chukchi Peninsula</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>Clipping of Chukotka Autonomous Okrug.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
