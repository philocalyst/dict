      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Normandía</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An administrative region, historical province, and medieval kingdom in northwest France, on the English Channel. The modern region was created in 2016 with the merger of Upper Normandy and Lower Normandy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
