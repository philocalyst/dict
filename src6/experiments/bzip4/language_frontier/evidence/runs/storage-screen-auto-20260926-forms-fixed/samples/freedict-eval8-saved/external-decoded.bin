          <ns0:quote>gurmukhi</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An abugida script, or writing system, designed for writing the Punjabi language used primarily in Punjab, India</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
