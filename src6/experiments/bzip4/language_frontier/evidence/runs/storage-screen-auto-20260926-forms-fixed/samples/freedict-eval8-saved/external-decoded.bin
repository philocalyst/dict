        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Coré</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical character) A biblical character who rebelled against Moses.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korea</ns0:orth>
        <ns0:pron>/koˈɹiːɐ/</ns0:pron>
        <ns0:pron>/kəˈɹi.ə/</ns0:pron>
        <ns0:pron>/kəˈɹiːə/</ns0:pron>
        <ns0:pron>/kɵˈrɪjɑ/</ns0:pron>
        <ns0:pron>[koˈɹiːɐ]</ns0:pron>
        <ns0:pron>[kʰɵˈɹi.ə]</ns0:pron>
        <ns0:pron>[kʰɵˈɹiːə]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Corea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A geographic region consisting of two countries in East Asia, commonly known as South Korea and North Korea; formerly a single country.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korea Strait</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>estrecho de Corea</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A strait between Korea and Japan, connecting the East China Sea with the Sea of Japan.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korean</ns0:orth>
        <ns0:pron>/kəˈɹi.ən/</ns0:pron>
        <ns0:pron>/kəˈɹiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coreano</ns0:quote>
          <ns0:quote>coreana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Of or relating to the Asian Peninsula comprising North Korea and South Korea.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korean</ns0:orth>
        <ns0:pron>/kəˈɹi.ən/</ns0:pron>
        <ns0:pron>/kəˈɹiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coreano</ns0:quote>
          <ns0:quote>coreana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(countable) A native or resident in North Korea or South Korea, or a person of Korean descent.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korean</ns0:orth>
        <ns0:pron>/kəˈɹi.ən/</ns0:pron>
        <ns0:pron>/kəˈɹiːən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>coreano</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(uncountable) Official language of the people residing on the Korean Peninsula, and language of approximately 60 million people, in Asia, North America, and elsewhere.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Korean Empire</ns0:orth>
      </ns0:form>
