        <ns0:sense>
          <ns0:def>A native or inhabitant of Umbria, Italy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Umbrian</ns0:orth>
        <ns0:pron>/ˈʌmbɹi.ən/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>umbro</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An extinct Italic language formerly spoken by the Umbri in the ancient Italian region of Umbria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Umbriel</ns0:orth>
        <ns0:pron>/ˈʌmbriəl/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Umbriel</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A moon of Uranus</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Uncle Sam</ns0:orth>
        <ns0:pron>/ˌəŋ-/</ns0:pron>
        <ns0:pron>/ˌʌŋkl̩ ˈsæm/</ns0:pron>
        <ns0:pron>/ˌʌŋkəl ˈsæm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tío Sam</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(colloquial, originally, US) A personification of the United States federal government or (rare) citizens. [from early 19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unicode</ns0:orth>
        <ns0:pron>/ˈjunɪˌkoʊd/</ns0:pron>
        <ns0:pron>/ˈjuːnɪˌkəʊd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Unicode</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(international standards, computing) A series of character encoding standards intended to support the characters used by a large number of the world’s languages.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Union of South Africa</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Unión Sudafricana</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Former official name of South Africa: a country in Southern Africa; used from 1910 to 1961, when the country was a Commonwealth dominion under nominal British sovereignty.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Union of Soviet Socialist Republics</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Unión de Repúblicas Socialistas Soviéticas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former transcontinental country in Europe and Asia (1922–1991), now split into Russia and 14 other countries; short form Soviet Union; abbreviation USSR.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unitarian</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>unitario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A member of a political movement advocating a unitary state rather than a federal one, especially the Unitarios of nineteenth century Argentina (known as the Unitarian Party in English).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unitarian Universalism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>unitarismo universalista</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A religion which encourages theological liberalism and an individual search for truth and the adherents of which draw on many different theological sources and have a wide range of beliefs and practices.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unitarianism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>unitarismo</ns0:quote>
          <ns0:quote>unitarianismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A Christian theology that God has one part, rather than the three equal parts (Father, Son, and Holy Spirit) posited by Trinitarianism.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Arab Emirates</ns0:orth>
        <ns0:pron>/juˌnaɪ̯tɪd ˌaɹəb ˈɛmɪɹɪ(t)s/</ns0:pron>
        <ns0:pron>/jʊˌnaɪ̯ɾɪ̈d ˌɛɹəb ˈɛmɪɹɪts/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Emiratos Árabes Unidos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country in West Asia in the Middle East. Capital: Abu Dhabi. Largest city: Dubai.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Arab Republic</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Árabe Unida</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Former (1958-61) country in the Middle East composed of the modern states of Egypt and Syria.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Kingdom</ns0:orth>
        <ns0:pron>/juːˌnaɪ.tɪd ˈkɪŋ.dəm/</ns0:pron>
        <ns0:pron>/jəˌnaɪ.tɪd ˈkɪŋ.dəm/</ns0:pron>
        <ns0:pron>/jʊˌnaɪ.tɪd ˈkɪŋ.dəm/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Reino Unido</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A kingdom and country in Northern Europe, comprising the four countries of England, Scotland and Wales on the island of Great Britain, and Northern Ireland on the northeastern portion of the island of Ireland since 1922.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Kingdom of Great Britain</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Reino Unido de Gran Bretaña</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>the Kingdom of Great Britain</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Kingdom of Great Britain and Ireland</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Reino Unido de Gran Bretaña e Irlanda</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) Former official name of the United Kingdom: a country in Northern Europe; in use from 1801–1927 (before being renamed by the Royal and Parliamentary Titles Act 1927 following the creation of the Irish Free State in 1922).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Kingdom of Great Britain and Northern Ireland</ns0:orth>
        <ns0:pron>/jʊˈnaɪtɪd ˈkɪŋdəm əv ˌɡɹeɪt ˈbɹɪtən ən ˌnɔː(ɹ)ðə(ɹ)n ˈaɪə(ɹ)lənd/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Reino Unido de Gran Bretaña e Irlanda del Norte</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of the United Kingdom: a country in Northern Europe. [from 1927]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Mexican States</ns0:orth>
        <ns0:pron>/juˌnaɪtɪ̈d ˈmɛk.sɪ.kən ˈsteɪts/</ns0:pron>
        <ns0:pron>/juːˌnaɪtɨd ˈmɛk.sɪ.kən ˈsteɪts/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estados Unidos Mexicanos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Mexico: a country in North America. [19th c.]</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Nations</ns0:orth>
        <ns0:pron>/juˌnaɪtɪd ˈneɪʃənz/</ns0:pron>
        <ns0:pron>/jʊ-/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Organización de las Naciones Unidas</ns0:quote>
          <ns0:quote>Naciones Unidas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(in the singular) An international coalition, founded in 1945 and headquartered in New York City, that aims to promote global co-operation and maintain international order.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Nations Economic and Social Council</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Consejo Económico y Social de las Naciones Unidas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One of the six principal organs of the United Nations, dedicated to coordinate global economical and social affairs.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United Republic of Tanzania</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>República Unida de Tanzania</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Official name of Tanzania: a country in East Africa.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United States</ns0:orth>
        <ns0:pron>/juˌnaɪtɪ̈d ˈsteɪts/</ns0:pron>
        <ns0:pron>/juːˌnaɪtɨd ˈsteɪts/</ns0:pron>
        <ns0:pron>/jʊˌnaɪtɨd ˈsteɪts/</ns0:pron>
        <ns0:pron>[juˌnaɪ̯ɾɪ̈d ˈsteɪ̯ts]</ns0:pron>
        <ns0:pron>[jɪ̈-]</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estados Unidos</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(in the plural) The collection of individual states of the United States of America.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United States Virgin Islands</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Islas Vírgenes de los Estados Unidos</ns0:quote>
          <ns0:quote>Islas Vírgenes Americanas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An archipelago and dependent territory of the United States, part of the Virgin Islands in the Caribbean. Official name: Virgin Islands of the United States.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>United States of America</ns0:orth>
        <ns0:pron>/juˌnaɪtəd ˌsteɪts əv əˈmɛɹəkə/</ns0:pron>
        <ns0:pron>/juːˌnaɪtɨd ˌsteɪts əv əˈmɛɹɨkə/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Estados Unidos de América</ns0:quote>
          <ns0:quote>Estados Unidos</ns0:quote>
          <ns0:quote>yunaits</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A country located primarily in North America, stretching from the Atlantic to the Pacific Ocean and consisting of fifty states (including Alaska and Hawaii) and the District of Columbia, while asserting sovereignty over several territories. Capital: Washington, D.C.. Largest city: New York City.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Universal Serial Bus</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Conductor Universal en Serie</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) An international standard for interconnecting personal computer devices using simple plugs and sockets and lightweight cables.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Universe</ns0:orth>
        <ns0:pron>/ˈjuːnəˌvɝs/</ns0:pron>
        <ns0:pron>/ˈjuːnɪˌvɜːs/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>universo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Our universe, the sum of everything that exists in the cosmos, including time and space itself.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Universiade</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Universiadas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>an international multi-sport event, organized for university athletes</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unix</ns0:orth>
        <ns0:pron>/ˈjuː.nɪks/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Unix</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, informal) Any of the above plus Unix-like operating systems similar to Unix but not qualifying for use of the UNIX trademark.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unix time</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>tiempo Unix</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing, uncountable) A widely used date and time representation that measures time by the number of nonleap seconds that have elapsed since 00:00:00 UTC on January 1, 1970.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(computing, countable) An individual timestamp using this system.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Uno</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Uno</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A card game similar to crazy eights, played with specially printed cards that have colours instead of suits.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Unruh effect</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>efecto Unruh</ns0:quote>
        </ns0:cit>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
