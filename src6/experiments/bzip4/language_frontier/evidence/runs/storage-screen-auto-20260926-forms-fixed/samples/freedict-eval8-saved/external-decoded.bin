          <ns0:quote>Menú de Inicio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(computing) A menu in some operating systems that is launched by pressing an on-screen button and provides a central launching point for applications and tasks.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
