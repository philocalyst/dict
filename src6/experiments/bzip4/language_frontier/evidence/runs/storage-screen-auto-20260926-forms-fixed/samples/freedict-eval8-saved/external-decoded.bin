      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Tierras Australes y Antárticas Francesas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>A French overseas territory located mostly in the Indian Ocean.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>French disease</ns0:orth>
      </ns0:form>
