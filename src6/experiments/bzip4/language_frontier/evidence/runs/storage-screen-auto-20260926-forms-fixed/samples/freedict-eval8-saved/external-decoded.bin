      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beneficiario</ns0:quote>
          <ns0:quote>beneficiaria</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>One who benefits or receives an advantage.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beneficiario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(especially, trust law) One who benefits from the distribution, especially out of a trust or estate.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benefit</ns0:orth>
        <ns0:pron>/bĕn.ĕf.ɪʈ/</ns0:pron>
        <ns0:pron>/ˈbɛn.ə.fɪt/</ns0:pron>
        <ns0:pron>/ˈbɛn.ɪ.fɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beneficio</ns0:quote>
          <ns0:quote>ventaja</ns0:quote>
          <ns0:quote>baza</ns0:quote>
          <ns0:quote>bienfecho</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An advantage; help or aid from something.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>prestación</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(insurance) A payment made in accordance with an insurance policy or a public assistance scheme.</ns0:def>
        </ns0:sense>
      </ns0:sense>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beneficio</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>An event, such as a theatrical performance, given to raise funds for some cause.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>benefit</ns0:orth>
        <ns0:pron>/bĕn.ĕf.ɪʈ/</ns0:pron>
        <ns0:pron>/ˈbɛn.ə.fɪt/</ns0:pron>
        <ns0:pron>/ˈbɛn.ɪ.fɪt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>v</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>beneficiar</ns0:quote>
        </ns0:cit>
