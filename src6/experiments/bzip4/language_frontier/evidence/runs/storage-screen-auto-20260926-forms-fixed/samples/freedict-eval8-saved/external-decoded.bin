    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Grand Duchy of Finland</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Gran Ducado de Finlandia</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A former duchy in Northern Europe from 1809 to 1917, encompassing the territories of modern-day Finland and Russia.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
