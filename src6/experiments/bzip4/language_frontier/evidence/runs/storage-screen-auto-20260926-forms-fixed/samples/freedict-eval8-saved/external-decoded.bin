      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>regla de Cramer</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(linear algebra) An explicit formula for the solution of a system of linear equations with as many equations as unknowns, valid whenever the system has a unique solution.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
