      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>atto-</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>In the International System of Units and other metric systems of units, multiplying the unit to which it is attached by 10−18 (short scale quintillionth or long scale trillionth).</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attorney</ns0:orth>
        <ns0:pron>/əˈtɜː(ɹ)ni/</ns0:pron>
        <ns0:pron>/ʔɐˈtoɹ.ni/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>abogado</ns0:quote>
          <ns0:quote>abogada</ns0:quote>
          <ns0:quote>mandatario</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US) A lawyer; one who advises or represents others in legal matters as a profession.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attorney general</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>procurador general</ns0:quote>
          <ns0:quote>fiscal general</ns0:quote>
          <ns0:quote>procuradora general</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The chief legal advisor to the government, overseeing legal affairs and ensuring that laws are uniformly and justly applied.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attorney-in-fact</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>apoderado</ns0:quote>
          <ns0:quote>procurador</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(US, legal) An agent of the person giving him/her the power of attorney (for a specific purpose or for general purposes) to act on his or her behalf. The attorney-in-fact’s power and responsibilities depend on the specific powers granted in the power of attorney document.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>attorneyship</ns0:orth>
