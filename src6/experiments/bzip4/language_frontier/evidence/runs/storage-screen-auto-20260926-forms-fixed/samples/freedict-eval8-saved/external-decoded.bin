    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Confucianism</ns0:orth>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>confucianismo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The philosophy and teaching of Confucius, which emphasizes self-cultivation, collective harmony, righteousness and the family structure.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
