      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Paracelso</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>The adopted name of Philippus von Hohenheim, a Swiss thinker of the 16th century known for his pioneering scientific work and his research into the occult and alchemy.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
