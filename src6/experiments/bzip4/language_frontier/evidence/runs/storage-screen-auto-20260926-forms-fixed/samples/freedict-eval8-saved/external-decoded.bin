    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kuiper belt</ns0:orth>
        <ns0:pron>/ˈkaɪ.pə(ɹ).bɛlt/</ns0:pron>
        <ns0:pron>/ˈkaɪ.pɚ.bɛlt/</ns0:pron>
        <ns0:pron>/ˈkʌɪpə bɛlt/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>pn</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>cinturón de Kuiper</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A region of space between thirty and fifty astronomical units from the Sun, roughly confined within a thick band around the ecliptic of the Solar System, and populated by many thousands of trans-Neptunian objects.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>Kuiper belt object</ns0:orth>
        <ns0:pron>/ˈkaɪpəɹ/</ns0:pron>
      </ns0:form>
      <ns0:gramGrp>
        <ns0:pos>n</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>objeto del cinturón de Kuiper</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(astronomy) A trans-Neptunian object (TNO) (a type of minor planet) that has an orbit in the Kuiper belt (between 30-50 AU) with inclinations consistent with the ecliptic.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
