        <ns0:pos>adj</ns0:pos>
      </ns0:gramGrp>
      <ns0:sense>
        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>acerbo</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>Tasting sour or bitter.</ns0:def>
        </ns0:sense>
        <ns0:sense>
          <ns0:def>(figurative) Sharp, harsh, biting.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
      <ns0:form>
        <ns0:orth>acerbity</ns0:orth>
        <ns0:pron>/əˈsɜːbɪti/</ns0:pron>
        <ns0:pron>/əˈsɝbɪti/</ns0:pron>
