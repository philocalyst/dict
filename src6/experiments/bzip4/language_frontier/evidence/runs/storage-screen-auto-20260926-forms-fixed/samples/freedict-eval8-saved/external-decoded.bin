          <ns0:quote>azitromicina</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(pharmaceutical drug) An azalide antibiotic derived from erythromycin.</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
