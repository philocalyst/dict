          <ns0:quote>Cantares</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(biblical) The twenty-second book of the Christian Old Testament and the seventeenth book of the Hebrew Bible.</ns0:def>
        </ns0:sense>
      </ns0:sense>
