        <ns0:cit type="trans" xml:lang="es">
          <ns0:quote>Cannas</ns0:quote>
        </ns0:cit>
        <ns0:sense>
          <ns0:def>(historical) A village in the Apulia region of south east Italy, known as the site of a battle in 216 B.C. in which the Carthaginians under Hannibal defeated the Romans</ns0:def>
        </ns0:sense>
      </ns0:sense>
    </ns0:entry>
    <ns0:entry xmlns:ns0="http://www.tei-c.org/ns/1.0">
